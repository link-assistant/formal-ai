# The shell syntax the rewrite reads and writes (issue #918): the loop and the
# detached-session templates (the session program is the first token of the
# screen template, and a command already in loop form is one the loop template
# brackets), the joiners that make any line a command sequence, and the
# interactive prompt markers a pasted command follows. Each is verbatim shell
# text, so it is a `code` field, where `|` is shell syntax, not a packed list.
map
  name shell_syntax
    entry
      word loop_template
      code "while true; do {command}; done"
    entry
      word screen_template
      code "screen -dmS {session} bash -c {command}"
    entry
      word joiner
      code " && "
    entry
      word joiner
      code " || "
    entry
      word joiner
      code " | "
    entry
      word joiner
      code "; "
    entry
      word prompt_marker
      code "$ "
    entry
      word prompt_marker
      code "# "
    entry
      word prompt_marker
      code "% "
# The concept-lookup query reader (rust/src/concepts.rs and the worker's
# extractConceptQuery, issue #918): the request leads it strips ahead of a
# question, the inverted "who X is" frame and the copulas it refuses as a
# subject, the meaning-question leads and tails, the words that are never the
# interrogated subject, the idiom tails and the articles a term sheds. Every
# list is read in seed order.
cues
  intent concept_lookup
    role request_prefix
    phrase "please tell me,"
    phrase "please tell me"
    phrase "tell me,"
    phrase "tell me"
cues
  intent concept_lookup
    role question_start
    phrase "who "
    phrase "what "
    phrase "what's "
    phrase "who's "
cues
  intent concept_lookup
    role inverted_who_lead
    phrase "who "
cues
  intent concept_lookup
    role inverted_who_tail
    phrase " is"
cues
  intent concept_lookup
    role inverted_who_copula
    phrase "is"
    phrase "was"
    phrase "are"
cues
  intent concept_lookup
    role meaning_prefix
    phrase "what is the meaning of "
    phrase "what's the meaning of "
    phrase "what is meaning of "
    phrase "meaning of "
cues
  intent concept_lookup
    role meaning_suffix
    phrase " mean"
    phrase " means"
    phrase " meaning"
cues
  intent concept_lookup
    role meaning_stem_prefix
    phrase "what does the word "
    phrase "what does "
    phrase "what do "
    phrase "what did "
    phrase "what is the word "
    phrase "what is "
    phrase "what's "
    phrase "what i "
cues
  intent concept_lookup
    role meaning_non_subject
    phrase "it"
    phrase "that"
    phrase "this"
    phrase "word"
    phrase "the word"
    phrase "mean"
    phrase "means"
    phrase "meaning"
    phrase "i"
cues
  intent concept_lookup
    role idiom_suffix
    phrase " mean"
    phrase " stand for"
cues
  intent concept_lookup
    role article
    phrase "the "
    phrase "a "
    phrase "an "
