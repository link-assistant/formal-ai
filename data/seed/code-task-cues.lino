# Issue 1173 R1173-3: the callables a script language provides without a
# definition. The undefined_call claim operand (rust/src/capability_routing/
# claim_operands.rs, js/worker/formal_ai_worker_claim_operands.js) skips a
# call of one of these, so only a call of a function nothing defines is
# reported as a failing run. Each `word` is a verbatim, lowercased identifier.
map
  name script_builtin_callable
    entry
      word print
