# Recognition vocabulary for tasks whose answer has a checkable shape.
#
# The runtime names only the semantic roles below. Surface forms and their open
# slots live here, so adding a language or paraphrase never adds a branch to the
# recognizer. The ellipsis is the lexicon's language-independent slot marker.
meanings
  expectation
    defined-by concept
  expectation_count
    defined-by expectation
    role verifiable_expectation
    role verifiable_expectation_count
    lexeme en "how many … do i have"
    lexeme ru "сколько у меня …"
    lexeme hi "मेरे पास कितने … हैं"
    lexeme zh "我有多少…"
    lexeme es "cuántos … tengo"
  expectation_edited_text
    defined-by expectation
    role verifiable_expectation
    role verifiable_expectation_edited_text
    lexeme en "make this sentence more concise: …"
    lexeme ru "сделай это предложение короче: …"
    lexeme hi "इस वाक्य को अधिक संक्षिप्त बनाओ: …"
    lexeme zh "把这句话改得更简洁：…"
    lexeme es "haz esta frase más concisa: …"
  expectation_unknown_value
    defined-by expectation
    role verifiable_expectation
    role verifiable_expectation_unknown
    lexeme en "find …:"
    lexeme ru "найди …:"
    lexeme hi "… ज्ञात करो:"
    lexeme zh "求 …："
    lexeme es "halla …:"
  expectation_numeric
    defined-by expectation
    role verifiable_expectation
    role verifiable_expectation_numeric
    lexeme en "how many … left" "how many … remain" "how many litres …"
    lexeme ru "сколько … оста" "сколько литров …"
    lexeme hi "कितने … बच" "कितने लीटर …"
    lexeme zh "还剩多少" "多少升"
    lexeme es "cuántos … quedan" "cuántos litros …"
  verifiable_entity_separator
    defined-by relation
    role verifiable_entity_separator
    lexeme en and
    lexeme ru и
    lexeme hi और
    lexeme zh 和
    lexeme es y
  quantity_determiner
    defined-by relation
    role verifiable_quantity_determiner
    lexeme en a an
    lexeme hi एक
    lexeme zh 一
    lexeme es un una
  # The pattern expectation is read only by the data-gated pattern-inference arm
  # (a run of atoms or a grid), never by the generic task reader, so it carries
  # its own role and not the generic verifiable_expectation role.
  expectation_pattern
    defined-by expectation
    role verifiable_expectation_pattern
    lexeme en
      words pattern sequence palindrome symmetry periodic repeat "what comes next" "next number" "next term"
      words "continue the" "continue this"
    lexeme ru закономерность последовательность палиндром
    lexeme hi पैटर्न क्रम पैलिंड्रोम
    lexeme zh 规律 序列 回文
    lexeme es patrón secuencia palíndromo
  pattern_grid_symmetry_separator
    defined-by expectation_pattern
    grounding "src/sequences/inference.rs"
  quantity_flow_increase
    defined-by relation
    role verifiable_quantity_flow_increase
    grounding "https://en.wikipedia.org/wiki/Word_problem_(mathematics_education)"
    lexeme en makes holds receives
      action quantity_before
    lexeme ru печёт баке получает
      action quantity_before
    lexeme hi
      surface
        text बनाती
        action quantity_after
      surface
        text टंकी
        action quantity_before
      surface
        text मिलता
        action quantity_after
    lexeme zh 做 水箱 收到
      action quantity_before
    lexeme es hace contiene recibe
      action quantity_before
  quantity_flow_decrease
    defined-by relation
    role verifiable_quantity_flow_decrease
    grounding "https://en.wikipedia.org/wiki/Word_problem_(mathematics_education)"
    lexeme en
      surface
        text sells
        action quantity_before
      surface
        text gives
        action quantity_before
      surface
        text "poured out"
        action quantity_after
    lexeme ru продаёт отдаёт вылили
      action quantity_before
    lexeme hi बेचती देती "निकाल दिया"
      action quantity_after
    lexeme zh 卖出 送给 倒出
      action quantity_before
    lexeme es vende "le da" vierten
      action quantity_before
  litre_to_millilitre
    defined-by litre
    defined-by millilitre
    role verifiable_unit_conversion
    grounding "https://www.bipm.org/en/measurement-units/si-prefixes"
    lexeme en 1000
  medical_device
    grounded-in Q6554101
    defined-by concept
    lexeme en "medical instrument" "medical instruments"
    lexeme ru "медицинский инструмент" "медицинских инструментов"
    lexeme hi "चिकित्सा उपकरण"
    lexeme zh 医疗器械
    lexeme es "instrumento médico" "instrumentos médicos"
  stethoscope
    grounded-in Q162339
    defined-by medical_device
    lexeme en stethoscope stethoscopes
    lexeme ru стетоскоп
    lexeme hi स्टेथोस्कोप
    lexeme zh 听诊器
    lexeme es estetoscopio
  scalpel
    grounded-in Q207172
    defined-by medical_device
    lexeme en scalpel scalpels
    lexeme ru скальпель скальпеля
    lexeme hi स्कैल्पेल
    lexeme zh 手术刀
    lexeme es bisturí bisturís
  thermometer
    grounded-in Q646
    defined-by medical_device
    lexeme en thermometer thermometers
    lexeme ru термометр
    lexeme hi थर्मामीटर
    lexeme zh 体温计
    lexeme es termómetro
