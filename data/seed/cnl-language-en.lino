# English grammar of the controlled output fragment (issue #1584).
# One description drives three directions: realization, parsing (its exact
# inverse) and validation. Every word list here is project-authored: NSM prime
# exponents follow the published 65-prime table; Basic English words come from
# Ogden's public-domain 850-word list; the STE, Special English and Globish
# lists are small project subsets because their full dictionaries are not
# redistributable here. Frequency tiers are upper rank bounds, not a corpus.
cnl-language en
  keys "bare|indef|def|plural"
  grammar "a|an|the|of|to|that|and|with|is|are|it|if|does|for"
  copula "am|is|are|was|were|be|been|being|isn't|aren't|wasn't|weren't|i'm|you're|we're|they're|it's|he's|she's|that's|there's|who's|what's"
  pronouns "it|they|them|he|she|him|her|this|that|these|those|its|their"
  fillers "um|umm|uh|uhh|hmm|lol|pls|please|hey|so|well|ok|okay|actually|basically|you know|i mean|i guess|i think|just|tell me|quick question|anyway"
  loose "an=a"
  typos "anmal=animal|animl=animal|aninal=animal|cta=cat|catt=cat|dgo=dog|tre=tree|leef=leaf|leafs=leaves|fingr=finger|computr=computer|compter=computer|acount=account|accout=account|pasword=password|passwrd=password|si=is|teh=the|r=are|u=you|wat=what|whats=what is|isnt=is not|doesnt=does not|dont=do not|kinda=kind of|sorta=sort of|plz=please|gotta=must|needa=need a"
  prime "I: i|me"
  prime "YOU: you"
  prime "SOMEONE: someone|person"
  prime "SOMETHING: something|thing|things"
  prime "PEOPLE: people"
  prime "BODY: body"
  prime "KIND: kind|kinds"
  prime "PART: part|parts"
  prime "THIS: this"
  prime "THE SAME: same"
  prime "OTHER: other|else"
  prime "ONE: one"
  prime "TWO: two"
  prime "SOME: some"
  prime "ALL: all"
  prime "MUCH: much|many"
  prime "LITTLE: little|few"
  prime "GOOD: good"
  prime "BAD: bad"
  prime "BIG: big"
  prime "SMALL: small"
  prime "THINK: think"
  prime "KNOW: know|knows"
  prime "WANT: want|wants"
  prime "DON'T WANT: don't"
  prime "FEEL: feel"
  prime "SEE: see"
  prime "HEAR: hear"
  prime "SAY: say|says"
  prime "WORDS: words|word"
  prime "TRUE: true"
  prime "DO: do"
  prime "HAPPEN: happen|happens"
  prime "MOVE: move|moves"
  prime "BE SOMEWHERE: be"
  prime "THERE IS: there"
  prime "BE SOMEONE: is|are"
  prime "MINE: mine"
  prime "LIVE: live|lives|living"
  prime "DIE: die"
  prime "WHEN: when|time"
  prime "NOW: now"
  prime "BEFORE: before"
  prime "AFTER: after"
  prime "A LONG TIME: long"
  prime "A SHORT TIME: short"
  prime "FOR SOME TIME: while"
  prime "MOMENT: moment"
  prime "WHERE: where|place"
  prime "HERE: here"
  prime "ABOVE: above"
  prime "BELOW: below"
  prime "FAR: far"
  prime "NEAR: near"
  prime "SIDE: side"
  prime "INSIDE: inside"
  prime "TOUCH: touch"
  prime "NOT: not|no"
  prime "MAYBE: maybe"
  prime "CAN: can|cannot"
  prime "BECAUSE: because"
  prime "IF: if"
  prime "VERY: very"
  prime "MORE: more"
  prime "LIKE: like|as|way"
  list "ste: yes|no|not|every|each|type|part|must|have|has|need|needs|all|cat|cats|dog|dogs|animal|animals|plant|plants|tree|trees|leaf|leaves|hand|hands|finger|fingers|computer|computers|house|mouse|mice|account|accounts|password|passwords|question|possible|meaning|meanings|answer|with|number|you|want|choose|by|lack|lacks|class|form|belong|false|true"
  list "minimal: yes|no|every|each|must|have|has|need|needs|animal|animals|plant|plants|cat|cats|dog|dogs|house|mouse|mice|tree|trees|leaf|leaves|hand|hands|finger|fingers|computer|computers|account|accounts|password|passwords|everything|question|possible|meaning|meanings|answer|with|number|you|want|choose|by|lack|lacks|class|form|belong|false|true"
  list "basic: yes|no|not|every|kind|part|have|has|necessary|animal|animals|plant|plants|cat|cats|dog|dogs|tree|trees|leaf|leaves|hand|hands|finger|fingers|number|machine|machines|point|pointer|pointers|account|accounts|secret|word|words|i|know|everything|question|possible|sense|senses|give|mind|in|you|small|rat|family|of|the|a"
  list "special: yes|no|not|every|kind|part|must|have|has|need|animal|animals|plant|plants|cat|cats|dog|dogs|tree|trees|leaf|leaves|hand|hands|finger|fingers|computer|computers|account|accounts|password|passwords|i|know|everything|question|possible|meaning|meanings|answer|with|number|you|want|choose|by|lack|lacks|class|form|belong|false|true"
  list "globish: yes|no|not|every|kind|part|must|have|has|need|animal|animals|plant|plants|cat|cats|dog|dogs|tree|trees|leaf|leaves|hand|hands|finger|fingers|computer|computers|house|mouse|mice|account|accounts|password|passwords|i|know|everything|question|possible|meaning|meanings|answer|with|number|you|want|choose|by|lack|lacks|class|form|belong|false|true"
  list "gellish: specialization|part|shall|have|require|requires|not|does|yes|no|cat|dog|animal|plant|tree|leaf|hand|finger|computer|house|mouse|account|password|question|has|possible|meaning|meanings|answer|with|number|you|want|choose|by|lack|lacks|class|form|belong"
  tier "100: the|of|and|a|to|in|is|you|that|it|he|was|for|on|are|as|with|his|they|i|at|be|this|have|from|or|one|had|by|word|but|not|what|all|were|we|when|your|can|said|there|use|an|each|which|she|do|how|their|if|will|up|other|about|out|many|then|them|these|so|some|her|would|make|like|him|into|time|has|look|two|more|write|go|see|number|no|way|could|people|my|than|first|been|call|who|its|now|find|long|down|day|did|get|come|made|may|part|yes|every|thing|things|does"
  tier "200: over|new|sound|take|only|little|work|know|place|year|live|me|back|give|most|very|after|our|just|name|good|sentence|man|think|say|great|where|help|through|much|before|line|right|too|mean|old|any|same|tell|boy|follow|came|want|show|also|around|form|three|small|set|put|end|why|again|turn|here|off|went|well|must|big|even|such|because|turn|ask|men|change|kind|hand|hands|picture|house|need|needs|land|different|home|move|try|kinds|animal|animals|point|mother|world|near|build|self|earth|father|words|parts|living|body|true|everything"
  tier "500: head|stand|own|page|should|country|found|answer|school|grow|study|still|learn|plant|plants|cover|food|sun|four|between|state|keep|eye|never|last|let|thought|city|tree|trees|cross|farm|hard|start|might|story|saw|far|sea|draw|left|late|run|while|press|close|night|real|life|north|book|carry|took|science|eat|room|friend|began|idea|fish|mountain|stop|once|base|hear|horse|cut|sure|watch|color|face|wood|main|open|seem|together|next|white|children|begin|got|walk|example|ease|paper|group|always|music|those|both|mark|often|letter|until|mile|river|car|feet|care|second|enough|plain|girl|usual|young|ready|above|ever|red|list|though|feel|talk|bird|soon|dog|dogs|computer|computers|machine|machines|account|accounts|type|someone|something|happen|happens|moves|feel|die|moment|side|inside|touch|maybe|below|lives|wants|knows|says|person"
  tier "1000: cat|cats|finger|fingers|leaf|leaves|mouse|mice|secret|necessary|class|belong|require|requires|contain|form|each|have|cannot|bad|hear|mine|short"
  tier "5000: password|passwords|pointer|pointers|specialization|shall|omniscient|feline"
  term animal
    forms "animal|an animal|the animal|animals"
    primes "living thing that can move|a living thing that can move|the living thing that can move|living things that can move"
  term plant
    forms "plant|a plant|the plant|plants"
    primes "living thing that cannot move|a living thing that cannot move|the living thing that cannot move|living things that cannot move"
  term cat
    forms "cat|a cat|the cat|cats"
    primes "small living thing that can move and can live where people live|a small living thing that can move and can live where people live|the small living thing that can move and can live where people live|small living things that can move and can live where people live"
  term dog
    forms "dog|a dog|the dog|dogs"
    primes "big living thing that can move and can live where people live|a big living thing that can move and can live where people live|the big living thing that can move and can live where people live|big living things that can move and can live where people live"
  term mouse-animal
    forms "mouse|a mouse|the mouse|mice"
    precise "house mouse|a house mouse|the house mouse|house mice"
    ste "house mouse|a house mouse|the house mouse|house mice"
    basic "small animal of the rat family|a small animal of the rat family|the small animal of the rat family|small animals of the rat family"
    primes "very small living thing that can move|a very small living thing that can move|the very small living thing that can move|very small living things that can move"
  term tree
    forms "tree|a tree|the tree|trees"
    primes "very big living thing that cannot move|a very big living thing that cannot move|the very big living thing that cannot move|very big living things that cannot move"
  term leaf
    forms "leaf|a leaf|the leaf|leaves"
    primes "small part of a living thing that cannot move|a small part of a living thing that cannot move|the small part of a living thing that cannot move|small parts of living things that cannot move"
  term hand
    forms "hand|a hand|the hand|hands"
    primes "part of the body that can touch things|a part of the body that can touch things|the part of the body that can touch things|parts of the body that can touch things"
  term finger
    forms "finger|a finger|the finger|fingers"
    primes "small part of the body that can touch things|a small part of the body that can touch things|the small part of the body that can touch things|small parts of the body that can touch things"
  term computer
    forms "computer|a computer|the computer|computers"
    basic "number machine|a number machine|the number machine|number machines"
    primes "thing that can do many things with words|a thing that can do many things with words|the thing that can do many things with words|things that can do many things with words"
  term mouse-device
    forms "mouse|a mouse|the mouse|mice"
    precise "computer mouse|a computer mouse|the computer mouse|computer mice"
    ste "computer mouse|a computer mouse|the computer mouse|computer mice"
    basic "pointer|a pointer|the pointer|pointers"
    primes "small thing that people move to do something with words|a small thing that people move to do something with words|the small thing that people move to do something with words|small things that people move to do something with words"
  term account
    forms "account|an account|the account|accounts"
    primes "thing with words that is mine|a thing with words that is mine|the thing with words that is mine|things with words that are mine"
  term password
    forms "password|a password|the password|passwords"
    basic "secret word|a secret word|the secret word|secret words"
    primes "words that I know and other people do not know|words that I know and other people do not know|the words that I know and other people do not know|words that I know and other people do not know"
  template "reply plain|ste|ace|gellish|sbvr|eprime|dense|basic statement"
    positive "Yes."
    negative "No."
  template "reply primes statement"
    positive "This is true."
    negative "This is not true."
  template "kind-of plain|basic statement"
    positive "{subject.indef} is a kind of {object.bare}."
    negative "{subject.indef} is not a kind of {object.bare}."
  template "kind-of plain|basic question"
    positive "Is {subject.indef} a kind of {object.bare}?"
    negative "Is {subject.indef} not a kind of {object.bare}?"
  template "kind-of ste statement"
    positive "{subject.indef} is a type of {object.bare}."
    negative "{subject.indef} is not a type of {object.bare}."
  template "kind-of ste question"
    positive "Is {subject.indef} a type of {object.bare}?"
    negative "Is {subject.indef} not a type of {object.bare}?"
  template "kind-of ace statement"
    positive "Every {subject.bare} is {object.indef}."
    negative "No {subject.bare} is {object.indef}."
  template "kind-of ace question"
    positive "Is every {subject.bare} {object.indef}?"
    negative "Is no {subject.bare} {object.indef}?"
  template "kind-of gellish statement"
    positive "{subject.bare} is a specialization of {object.bare}."
    negative "{subject.bare} is not a specialization of {object.bare}."
  template "kind-of gellish question"
    positive "Is {subject.bare} a specialization of {object.bare}?"
    negative "Is {subject.bare} not a specialization of {object.bare}?"
  template "kind-of sbvr statement"
    positive "It is necessary that each {subject.bare} is {object.indef}."
    negative "It is impossible that {subject.indef} is {object.indef}."
  template "kind-of sbvr question"
    positive "Is it necessary that each {subject.bare} is {object.indef}?"
    negative "Is it impossible that {subject.indef} is {object.indef}?"
  template "kind-of eprime statement"
    positive "{subject.plural} belong to the class of {object.plural}."
    negative "{subject.plural} do not belong to the class of {object.plural}."
  template "kind-of eprime question"
    positive "Do {subject.plural} belong to the class of {object.plural}?"
    negative "Do {subject.plural} not belong to the class of {object.plural}?"
  template "kind-of primes statement"
    positive "{subject.indef} is a kind of {object.bare}."
    negative "{subject.indef} is not a kind of {object.bare}."
  template "kind-of primes question"
    positive "Is {subject.indef} a kind of {object.bare}?"
    negative "Is {subject.indef} not a kind of {object.bare}?"
  template "kind-of dense statement"
    positive "{subject.plural} are {object.plural}."
    negative "{subject.plural} are not {object.plural}."
  template "kind-of dense question"
    positive "Are {subject.plural} {object.plural}?"
    negative "Are {subject.plural} not {object.plural}?"
  template "kind-of colloquial question"
    positive "is {subject.indef} {object.indef}"
    positive "is {subject.bare} {object.indef}"
    positive "is {subject.indef} a type of {object.bare}"
    positive "would you say {subject.indef} is {object.indef}"
    negative "is {subject.indef} not {object.indef}"
  template "kind-of colloquial statement"
    positive "{subject.indef} is {object.indef}"
    positive "{subject.indef} counts as {object.indef}"
    positive "{subject.plural} count as {object.plural}"
    negative "{subject.indef} is not {object.indef}"
  template "part-of plain|basic|ste|primes statement"
    positive "{subject.indef} is a part of {object.indef}."
    negative "{subject.indef} is not a part of {object.indef}."
  template "part-of plain|basic|ste|primes question"
    positive "Is {subject.indef} a part of {object.indef}?"
    negative "Is {subject.indef} not a part of {object.indef}?"
  template "part-of ace statement"
    positive "Every {subject.bare} is a part of {object.indef}."
    negative "No {subject.bare} is a part of {object.indef}."
  template "part-of ace question"
    positive "Is every {subject.bare} a part of {object.indef}?"
    negative "Is no {subject.bare} a part of {object.indef}?"
  template "part-of gellish statement"
    positive "{subject.bare} is a part of {object.bare}."
    negative "{subject.bare} is not a part of {object.bare}."
  template "part-of gellish question"
    positive "Is {subject.bare} a part of {object.bare}?"
    negative "Is {subject.bare} not a part of {object.bare}?"
  template "part-of sbvr statement"
    positive "It is necessary that each {subject.bare} is a part of {object.indef}."
    negative "It is impossible that {subject.indef} is a part of {object.indef}."
  template "part-of sbvr question"
    positive "Is it necessary that each {subject.bare} is a part of {object.indef}?"
    negative "Is it impossible that {subject.indef} is a part of {object.indef}?"
  template "part-of eprime statement"
    positive "{subject.plural} form part of {object.plural}."
    negative "{subject.plural} do not form part of {object.plural}."
  template "part-of eprime question"
    positive "Do {subject.plural} form part of {object.plural}?"
    negative "Do {subject.plural} not form part of {object.plural}?"
  template "part-of dense statement"
    positive "{object.plural} have {subject.plural}."
    negative "{object.plural} lack {subject.plural}."
  template "part-of dense question"
    positive "Do {object.plural} have {subject.plural}?"
    negative "Do {object.plural} lack {subject.plural}?"
  template "part-of colloquial question"
    positive "is {subject.indef} part of {object.indef}"
    positive "is {subject.bare} part of {object.bare}"
    positive "does {object.indef} have {subject.indef}"
    positive "does {object.indef} have {subject.plural}"
  template "part-of colloquial statement"
    positive "{subject.indef} is part of {object.indef}"
    positive "{subject.plural} are part of {object.plural}"
  template "must-have plain|ste|eprime statement"
    positive "{subject.indef} must have {object.indef}."
    negative "{subject.indef} does not need {object.indef}."
  template "must-have plain|ste|eprime question"
    positive "Must {subject.indef} have {object.indef}?"
    negative "Does {subject.indef} not need {object.indef}?"
  template "must-have basic statement"
    positive "It is necessary for {subject.indef} to have {object.indef}."
    negative "It is not necessary for {subject.indef} to have {object.indef}."
  template "must-have basic question"
    positive "Is it necessary for {subject.indef} to have {object.indef}?"
    negative "Is it not necessary for {subject.indef} to have {object.indef}?"
  template "must-have ace statement"
    positive "Every {subject.bare} must have {object.indef}."
    negative "It is false that every {subject.bare} must have {object.indef}."
  template "must-have ace question"
    positive "Must every {subject.bare} have {object.indef}?"
    negative "Is it false that every {subject.bare} must have {object.indef}?"
  template "must-have gellish statement"
    positive "{subject.bare} shall have {object.bare}."
    negative "{subject.bare} does not require {object.bare}."
  template "must-have gellish question"
    positive "Shall {subject.bare} have {object.bare}?"
    negative "Does {subject.bare} not require {object.bare}?"
  template "must-have sbvr statement"
    positive "It is obligatory that each {subject.bare} has {object.indef}."
    negative "It is permitted that {subject.indef} has no {object.bare}."
  template "must-have sbvr question"
    positive "Is it obligatory that each {subject.bare} has {object.indef}?"
    negative "Is it permitted that {subject.indef} has no {object.bare}?"
  template "must-have primes statement"
    positive "If something is {subject.indef}, {object.indef} is a part of it."
    negative "Something can be {subject.indef} if {object.indef} is not a part of it."
  template "must-have primes question"
    positive "If something is {subject.indef}, is {object.indef} a part of it?"
    negative "Can something be {subject.indef} if {object.indef} is not a part of it?"
  template "must-have dense statement"
    positive "{subject.plural} require {object.plural}."
    negative "{subject.plural} do not require {object.plural}."
  template "must-have dense question"
    positive "Do {subject.plural} require {object.plural}?"
    negative "Do {subject.plural} not require {object.plural}?"
  template "must-have colloquial question"
    positive "does {subject.indef} need {object.indef}"
    positive "do {subject.plural} need {object.plural}"
    positive "is {object.indef} required for {subject.indef}"
  template "must-have colloquial statement"
    positive "{subject.indef} needs {object.indef}"
    positive "{subject.plural} need {object.plural}"
  template "relation stream question"
    positive "{subject.bare} ... {object.bare}"
    positive "{subject.plural} ... {object.plural}"
    positive "{subject.bare} and {object.bare} ... how"
  template "clarify plain|ste|ace|gellish|sbvr|eprime statement"
    positive "The question has {count.number} possible meanings."
  template "clarify basic statement"
    positive "The question has {count.number} possible senses."
  template "clarify primes statement"
    positive "The words can say {count.number} things."
  template "clarify dense statement"
    positive "The question has {count.number} meanings."
  template "choose plain|ste|ace|gellish|sbvr|eprime request"
    positive "Answer with the number of the meaning that you want."
  template "choose basic request"
    positive "Give the number of the sense you have in mind."
  template "choose primes request"
    positive "I want you to say the one that you want."
  template "choose dense request"
    positive "Choose a meaning by number."
  template "sum task request"
    positive "calculate the sum of {left.number} and {right.number}"
    positive "what is the sum of {left.number} and {right.number}"
    positive "find the sum of {left.number} and {right.number}"
    positive "add {left.number} and {right.number}"
    positive "what is {left.number} plus {right.number}"
    positive "{left.number} plus {right.number}"
    positive "how much is {left.number} plus {right.number}"
    positive "add {left.number} and {right.number} together"
    positive "sum of {left.number} and {right.number}"
    positive "what do you get if you add {left.number} and {right.number}"
    positive "if i have {left.number} apples and get {right.number} more how many apples do i have"
    positive "tom has {left.number} books and buys {right.number} more books how many books does tom have now"
  template "difference task request"
    positive "subtract {right.number} from {left.number}"
    positive "what is {left.number} minus {right.number}"
    positive "{left.number} minus {right.number}"
    positive "what is the difference between {left.number} and {right.number}"
    positive "take {right.number} away from {left.number}"
    positive "if i have {left.number} apples and eat {right.number} how many apples are left"
  template "product task request"
    positive "multiply {left.number} by {right.number}"
    positive "what is {left.number} times {right.number}"
    positive "{left.number} times {right.number}"
    positive "{left.number} multiplied by {right.number}"
    positive "multiply {left.number} and {right.number}"
    positive "what is the product of {left.number} and {right.number}"
    positive "there are {left.number} boxes with {right.number} pens in each box how many pens are there"
  template "reverse-text task request"
    positive "write a function to reverse a string"
    positive "make a function that reverses a string"
    positive "write code that reverses a string"
    positive "i need a function that reverses text"
    positive "reverse a string function"
  template "list-maximum task request"
    positive "write a function to find the largest number in a list"
    positive "write a function that finds the maximum of a list"
    positive "make a function that returns the biggest number in a list"
  template "list-sum task request"
    positive "write a function to add up a list of numbers"
    positive "write a function that returns the sum of a list of numbers"
    positive "make a function that adds all numbers in a list"
  template "factorial task request"
    positive "write a function to compute the factorial of a number"
    positive "write a function for factorial"
    positive "make a function that returns n factorial"
