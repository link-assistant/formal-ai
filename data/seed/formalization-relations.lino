relations
  is_a
    kind taxonomic
    inverse subsumes
    grounding "https://www.w3.org/TR/rdf-schema/#ch_subclassof"
    lexeme en "is a" "is any" "denotes a"
    lexeme ru "это" "является"
    lexeme hi "एक प्रकार है"
    lexeme zh "是一种"
    lexeme es "es un" "es una"
  has_property
    kind attributive
    inverse property_of
    grounding "https://www.w3.org/TR/rdf-schema/#ch_property"
    lexeme en "that has" "in which" "with no"
    lexeme ru "в котором" "с повторяющейся"
    lexeme hi "जिसमें"
    lexeme zh "含有"
    lexeme es "que tiene" "en el que"
  part_of
    kind meronymic
    inverse has_part
    grounding "https://plato.stanford.edu/entries/mereology/"
    lexeme en "part of" "member of"
    lexeme ru "часть"
    lexeme hi "का भाग"
    lexeme zh "的一部分"
    lexeme es "parte de"
  requires
    kind precondition
    inverse required_by
    grounding "https://plato.stanford.edu/entries/necessary-sufficient/"
    lexeme en "requires" "must have"
    lexeme ru "требует"
    lexeme hi "आवश्यक है"
    lexeme zh "需要"
    lexeme es "requiere"
  produces
    kind production
    inverse produced_by
    grounding "https://plato.stanford.edu/entries/causation-metaphysics/"
    lexeme en "produces" "returns"
    lexeme ru "возвращает"
    lexeme hi "देता है"
    lexeme zh "产生"
    lexeme es "devuelve"
  precedes
    kind ordering
    inverse follows
    grounding "https://plato.stanford.edu/entries/time/"
    lexeme en "then" "before"
    lexeme ru "затем" "сначала"
    lexeme hi "फिर" "पहले"
    lexeme zh "然后" "先"
    lexeme es "luego" "antes"
  excludes
    kind exclusion
    inverse excluded_by
    grounding "https://plato.stanford.edu/entries/negation/"
    lexeme en "never" "without"
    lexeme ru "никогда" "без"
    lexeme hi "कभी नहीं" "बिना"
    lexeme zh "从不" "没有"
    lexeme es "nunca" "sin"
  measured_in
    kind measure
    inverse measures
    grounding "https://www.bipm.org/en/measurement-units"
    lexeme en "measured in" "expressed in"
    lexeme ru "измеряется в"
    lexeme hi "में मापा जाता है"
    lexeme zh "计量单位"
    lexeme es "medido en"
determiners
