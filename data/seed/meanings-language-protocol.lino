# The language-protocol records: the Spanish language code, the `full` and
# `partial` support statuses of data/seed/languages.lino, the explicit-gap
# policy and the per-language greeting, identity and gap responses. Each one
# grounds a bare token the protocol files use and names itself in every
# supported language. Moved out of meanings-translation.lino (PR #1188).
meanings
  es
    defined-by human_language
    lexeme en "Spanish language code"
    lexeme ru "код испанского языка"
    lexeme hi "स्पेनिश भाषा कोड"
    lexeme zh 西班牙语语言代码
    lexeme es "código del idioma español"
  full
    defined-by concept
    lexeme en "full language protocol status"
    lexeme ru "полный статус языкового протокола"
    lexeme hi "पूर्ण भाषा प्रोटोकॉल स्थिति"
    lexeme zh 完整语言协议状态
    lexeme es "estado de protocolo de idioma completo"
  partial
    defined-by concept
    lexeme en "partial language protocol status"
    lexeme ru "частичный статус языкового протокола"
    lexeme hi "आंशिक भाषा प्रोटोकॉल स्थिति"
    lexeme zh 部分语言协议状态
    lexeme es "estado de protocolo de idioma parcial"
  explicit_gap
    defined-by concept
    lexeme en "explicit language gap policy"
    lexeme ru "политика явного языкового пробела"
    lexeme hi "स्पष्ट भाषा अंतराल नीति"
    lexeme zh 显式语言缺口策略
    lexeme es "política de carencia de idioma explícita"
  explicit_language_context
    defined-by concept
    lexeme en "explicit language context detection"
    lexeme ru "явное определение языкового контекста"
    lexeme hi "स्पष्ट भाषा संदर्भ पहचान"
    lexeme zh 显式语言上下文检测
    lexeme es "detección explícita del contexto de idioma"
  language_gap
    defined-by concept
    lexeme en "language coverage gap"
    lexeme ru "пробел в языковом покрытии"
    lexeme hi "भाषा कवरेज अंतराल"
    lexeme zh 语言覆盖缺口
    lexeme es "carencia de cobertura de idioma"
  response_greeting_es
    defined-by concept
    lexeme en "Spanish greeting response"
    lexeme ru "испанский ответ на приветствие"
    lexeme hi "स्पेनिश अभिवादन उत्तर"
    lexeme zh 西班牙语问候回答
    lexeme es "respuesta de saludo en español"
  response_identity_es
    defined-by concept
    lexeme en "Spanish identity response"
    lexeme ru "испанский ответ о себе"
    lexeme hi "स्पेनिश पहचान उत्तर"
    lexeme zh 西班牙语身份回答
    lexeme es "respuesta de identidad en español"
  response_language_gap_en
    defined-by concept
    lexeme en "English language gap response"
    lexeme ru "английский ответ о языковом пробеле"
