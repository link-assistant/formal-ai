# Repository-authoring cues split from meanings-coding-tasks.lino so every
# reviewable Links Notation source stays below the repository line bound.
meanings
  git_branch_cue
    defined-by concept
    role git_branch_cue
    precondition "a request names the branch a result is kept on"
    effect "the name that follows the cue is the branch the result is pushed to"
    unit "not applicable"
    example "branch"
    lexeme en branch
    lexeme ru ветке ветка ветку ветки
    lexeme hi शाखा ब्रांच
    lexeme zh 分支
    lexeme es rama
  message
    defined-by concept
    role git_commit_message_lead
    precondition "a commit request quotes the message the commit should carry"
    effect "the first quoted text after the lead becomes the commit subject"
    unit "not applicable"
    example "with the message"
    lexeme en message "commit message"
    lexeme ru сообщением сообщение
    lexeme hi संदेश
    lexeme zh 消息 提交信息
    lexeme es mensaje
  git_commit_request
    defined-by action
    role git_commit_request
    precondition "a request asks for the working tree to be committed"
    effect "the request is answered by staging, committing and pushing the tree"
    unit "not applicable"
    example "commit them"
    lexeme en
      words "commit them" "commit these changes" "commit the changes" "commit your changes" "commit and push"
      words "commit it" "commit all" "commit everything" "commit my changes"
    lexeme ru закоммить закоммитьте "сделай коммит" "зафиксируй изменения" "зафиксируйте изменения"
    lexeme hi "कमिट करें" "कमिट करो" "बदलाव कमिट करें"
    lexeme zh 提交这些更改 提交更改 提交这些修改 提交代码
    lexeme es "haz commit" "haz el commit" "confirma los cambios" "commitea los cambios"
  ci_workflow_request
    defined-by concept
    role ci_workflow_request
    precondition "a work item requires a continuous-integration workflow beside the program"
    effect "the execution recipe carries the workflow as a supporting file"
    unit "not applicable"
    example "github actions workflow"
    lexeme en "github actions workflow" "actions workflow" "ci workflow" "workflow that automatically runs"
    lexeme ru "рабочий процесс github actions" "workflow github actions" "ci workflow" "рабочий процесс ci"
    lexeme hi "github actions वर्कफ़्लो" "सीआई वर्कफ़्लो" "ci वर्कफ़्लो"
    lexeme zh "github actions 工作流" "ci 工作流" 工作流程
    lexeme es "flujo de trabajo de github actions" "workflow de github actions" "flujo de trabajo de ci"
  file_edit_position_after
    defined-by concept
    role file_edit_position_after
    precondition "an additive edit places new text after an anchor line"
    effect "the anchor is replaced by the anchor followed by the new text"
    unit "not applicable"
    example "directly after the line"
    lexeme en "after the line" "directly after" "right after" after
    lexeme ru "после строки" "сразу после" после
    lexeme hi "पंक्ति के बाद" "के बाद"
    lexeme zh 之后 后面 行后
    lexeme es "después de la línea" "justo después de" "después de"
  file_edit_position_before
    defined-by concept
    role file_edit_position_before
    precondition "an additive edit places new text before an anchor line"
    effect "the anchor is replaced by the new text followed by the anchor"
    unit "not applicable"
    example "before the line"
    lexeme en "before the line" "directly before" "right before" before
    lexeme ru "перед строкой" "прямо перед" перед
    lexeme hi "पंक्ति से पहले" "से पहले"
    lexeme zh 之前 前面 行前
    lexeme es "antes de la línea" "justo antes de" "antes de"
  file_edit_position_end
    defined-by concept
    role file_edit_position_end
    precondition "an additive edit places quoted text at the end of a named file"
    effect "the file keeps its content and gains the quoted text as its last line"
    unit "not applicable"
    example "append the line to the file"
    lexeme en append "to the end of" "at the end of" "to the bottom of" "at the bottom of"
    lexeme ru "в конец" "в конце" допиши дописать
    lexeme hi "के अंत में" "अंत में"
    lexeme zh 追加 末尾 结尾
    lexeme es "al final de" "añade al final"
  line
    defined-by concept
    role file_edit_line_lead
    precondition "an additive edit introduces its unquoted text as a line"
    effect "the words after the lead, up to the destination cue before the path, are the line"
    unit "not applicable"
    example "append the line third to notes.txt"
    lexeme en "the line" "a line" line lines
    lexeme ru строку строка строки
    lexeme hi पंक्ति पंक्तियाँ
    lexeme zh 一行 的行
    lexeme es "la línea" línea líneas
  file_text_unit
    defined-by concept
    role file_text_unit
    precondition "a request names a unit of text inside a file: a word, a phrase, an occurrence, the text"
    effect "the request edits inside the file; a destructive file command never reads it as deleting the file"
    unit "not applicable"
    example "delete the word drop from notes.txt"
    lexeme en word words phrase occurrence text
    lexeme ru слово слова фразу вхождение текст
    lexeme hi शब्द वाक्यांश पाठ
    lexeme zh 一词 词语 文字 文本
    lexeme es palabra frase texto
  file_edit_blank_line
    defined-by concept
    role file_edit_blank_line
    precondition "an additive edit names no quoted text, only an empty line, for a named file"
    effect "the file keeps its content and gains one empty line at the named end"
    unit "not applicable"
    example "append an empty line to the file"
    lexeme en "an empty line" "a blank line" "empty line" "blank line"
    lexeme ru "пустую строку" "пустая строка"
    lexeme hi "खाली पंक्ति"
    lexeme zh 空行
    lexeme es "una línea vacía" "línea en blanco"
  file_edit_position_start
    defined-by concept
    role file_edit_position_start
    precondition "an additive edit places quoted text at the start of a named file"
    effect "the file keeps its content and gains the quoted text as its first line"
    unit "not applicable"
    example "prepend the line to the file"
    lexeme en
      words prepend "to the beginning of" "at the beginning of" "to the top of" "at the top of" "at the start of"
      words "to the start of"
    lexeme ru "в начало" "в начале"
    lexeme hi "की शुरुआत में" "शुरुआत में"
    lexeme zh 开头 最前面
    lexeme es "al principio de" "al inicio de"
  output_obligation_verb
    defined-by concept
    role output_obligation_verb
    precondition "a request clause quotes a value the program must emit"
    effect "the clause formalizes into an output-literal obligation (issue #1166)"
    unit "not applicable"
    example "print exactly"
    lexeme en "print" "prints" "write" "writes" "output"
    lexeme ru "выведи" "вывести" "вывод" "напечатай" "напиши" "печатать"
    lexeme hi "छापो" "छाप" "प्रिंट" "आउटपुट" "लिखो"
    lexeme zh "打印" "输出" "打印出"
    lexeme es "imprime" "imprimir" "escribe" "escribir" "salida"
  code_style_obligation
    defined-by concept
    role code_style_obligation
    precondition "a request clause asks for a quality of the written code"
    effect "the clause formalizes into a code-style obligation (issue #1166)"
    unit "not applicable"
    example "add clear comments"
    lexeme en "comment" "comments" "best practice" "best practices" "clean code" "readable"
    lexeme ru "комментар" "лучшие практики" "понятн"
    lexeme hi "टिप्पणी" "सर्वोत्तम अभ्यास"
    lexeme zh "注释" "最佳实践" "可读"
    lexeme es "comentario" "comentarios" "buenas prácticas" "prácticas recomendadas"
  file_naming_obligation
    defined-by concept
    role file_naming_obligation
    precondition "a request clause asks for the name of the file it produces"
    effect "the clause formalizes into a file-naming obligation (issue #1166); a bare filename token is not one"
    unit "not applicable"
    example "a meaningful name like"
    lexeme en "name like" "named" "meaningful name"
    lexeme ru "назови" "название файла" "имя файла" "осмысленное имя"
    lexeme hi "नाम रखो" "सार्थक नाम"
    lexeme zh "命名" "名为" "文件名" "有意义的名字"
    lexeme es "llama al archivo" "llámalo" "nombre del archivo" "nombre significativo"
  ci_badge_obligation
    defined-by concept
    role ci_badge_obligation
    precondition "a request clause asks for a continuous-integration status badge"
    effect "the clause formalizes into a CI-badge obligation (issue #1166)"
    unit "not applicable"
    example "a CI badge"
    lexeme en "badge"
    lexeme ru "значок" "бейдж"
    lexeme hi "प्रतीक"
    lexeme zh "徽章"
    lexeme es "escudo" "insignia"
  numbered_line_noun
    defined-by concept
    role numbered_line_noun
    precondition "a request names a line of a file by its number"
    effect "the number beside the noun is a one-based line number of the named file"
    unit "not applicable"
    example "delete lines 3-5"
    lexeme en "line" "lines"
    lexeme ru "строка" "строку" "строки" "строк" "строке"
    lexeme hi "पंक्ति" "पंक्तियाँ" "पंक्तियों" "लाइन"
    lexeme zh "行"
    lexeme es "línea" "líneas"
  numbered_line_lead
    defined-by concept
    role numbered_line_lead
    precondition "a word stands between a line noun and its number, or before a number the noun follows"
    effect "the number after the lead is still the line number"
    unit "not applicable"
    example "lines from 3 to 5"
    lexeme en "from" "number"
    lexeme ru "с" "со" "номер"
    lexeme hi "संख्या" "क्रमांक"
    lexeme zh "第" "从"
    lexeme es "de" "del" "desde" "la" "las" "número"
  line_range_connector
    defined-by concept
    role line_range_connector
    precondition "two line numbers are joined into one inclusive range"
    effect "the lines from the first number to the second are named"
    unit "not applicable"
    example "lines 3 to 5"
    lexeme en "to" "through" "thru" "until"
    lexeme ru "по" "до"
    lexeme hi "से" "तक"
    lexeme zh "到" "至"
    lexeme es "a" "al" "hasta"
  line_adjacent_above
    defined-by concept
    role line_adjacent_above
    precondition "a removal names the line directly above the line it quotes or numbers"
    effect "that line goes as well"
    unit "not applicable"
    example "delete the line and the line above it"
    lexeme en "above it" "before it" "preceding it" "the line above" "the previous line"
    lexeme ru "над ней" "перед ней" "выше неё" "выше нее" "предыдущую строку"
    lexeme hi "उसके ऊपर" "उससे पहले" "ऊपर वाली"
    lexeme zh "上面的" "上一行" "前一行"
    lexeme es "encima de ella" "antes de ella" "la línea anterior"
  line_adjacent_below
    defined-by concept
    role line_adjacent_below
    precondition "a removal names the line directly below the line it quotes or numbers"
    effect "that line goes as well"
    unit "not applicable"
    example "delete the line and the line below it"
    lexeme en "below it" "after it" "following it" "under it" "the line below" "the next line"
    lexeme ru "под ней" "после неё" "после нее" "ниже неё" "ниже нее" "следующую строку"
    lexeme hi "उसके नीचे" "उसके बाद वाली" "नीचे वाली"
    lexeme zh "下面的" "下一行" "后一行"
    lexeme es "debajo de ella" "después de ella" "la línea siguiente"
  line_move_action
    defined-by concept
    role line_move_action
    precondition "a request moves a quoted line of a file to another place in it"
    effect "the line is taken out of its place and inserted at the start, the end, or beside an anchor line"
    unit "not applicable"
    example "move the line to the top of the file"
    lexeme en "move"
    lexeme ru "перемести" "переместить" "перенеси" "перенести"
    lexeme hi "ले जाओ" "खिसकाओ" "स्थानांतरित करो"
    lexeme zh "移动" "移到" "挪到"
    lexeme es "mueve" "mover" "traslada" "trasladar"
  line_move_follow
    defined-by relation
    role line_move_after_cue
    precondition "a line move states where the moved line ends up as the line it follows"
    effect "the moved line is placed directly after the anchor line (PR #1188 G81)"
    unit "not applicable"
    example "so that it follows the line"
    lexeme en "so that it follows" "so it follows" "comes after"
    lexeme ru "чтобы она шла после" "чтобы она следовала за"
    lexeme hi "ताकि वह उसके बाद आए"
    lexeme zh "使其跟在"
    lexeme es "de modo que siga a" "para que siga a"
  line_move_precede
    defined-by relation
    role line_move_before_cue
    precondition "a line move states where the moved line ends up as the line it precedes"
    effect "the moved line is placed directly before the anchor line (PR #1188 G81)"
    unit "not applicable"
    example "so that it precedes the line"
    lexeme en "so that it precedes" "so it precedes" "comes before"
    lexeme ru "чтобы она шла перед" "чтобы она предшествовала"
    lexeme hi "ताकि वह उससे पहले आए"
    lexeme zh "使其排在"
    lexeme es "de modo que preceda a" "para que preceda a"
  line_swap_action
    defined-by concept
    role line_swap_action
    precondition "a request exchanges two quoted lines of a file"
    effect "each line takes the other's place"
    unit "not applicable"
    example "swap the lines"
    lexeme en "swap" "exchange"
    lexeme ru "поменяй местами" "поменять местами" "переставь местами"
    lexeme hi "अदला-बदली करो" "आपस में बदलो"
    lexeme zh "交换" "互换" "对调"
    lexeme es "intercambia" "intercambiar"
  line_ordinal_first
    defined-by concept
    defined-by one
    role line_ordinal
    precondition "a request names a line of a file by its ordinal"
    effect "the line the ordinal counts to from the start of the file; the number is the one its cardinal meaning spells in digits"
    unit "not applicable"
    example "remove the first line"
    lexeme en "first"
    lexeme ru "первую" "первая" "первой"
    lexeme hi "पहली" "पहला"
    lexeme zh "第一"
    lexeme es "primera" "primer"
  line_ordinal_second
    defined-by concept
    defined-by two
    role line_ordinal
    precondition "a request names a line of a file by its ordinal"
    effect "the line the ordinal counts to from the start of the file"
    unit "not applicable"
    example "delete the second line"
    lexeme en "second"
    lexeme ru "вторую" "вторая" "второй"
    lexeme hi "दूसरी" "दूसरा"
    lexeme zh "第二"
    lexeme es "segunda" "segundo"
  line_ordinal_third
    defined-by concept
    defined-by three
    role line_ordinal
    precondition "a request names a line of a file by its ordinal"
    effect "the line the ordinal counts to from the start of the file"
    unit "not applicable"
    example "delete the third line"
    lexeme en "third"
    lexeme ru "третью" "третья" "третьей"
    lexeme hi "तीसरी" "तीसरा"
    lexeme zh "第三"
    lexeme es "tercera" "tercer"
  line_ordinal_last
    defined-by concept
    defined-by one
    role line_ordinal_last
    precondition "a request names a line of a file by its ordinal counted from the end"
    effect "the line the ordinal counts to from the end of the file"
    unit "not applicable"
    example "remove the last line"
    lexeme en "last"
    lexeme ru "последнюю" "последняя" "последней"
    lexeme hi "आखिरी" "अंतिम"
    lexeme zh "最后一"
    lexeme es "última" "último"
