  workspace_search_hits
    defined-by answer
    role localized_response_template
    precondition "a workspace content search for one identifier or literal found matching lines"
    effect "the answer counts the lines and lists each as file:line with its text"
    unit "not applicable"
    example "Found 2 line(s) mentioning `add` in `.`:"
    grounding "data/seed/multilingual-responses-agentic-tools.lino"
  workspace_search_none
    defined-by answer
    role localized_response_template
    precondition "a workspace content search for one identifier or literal found no matching line"
    effect "the answer names the pattern and the searched scope"
    unit "not applicable"
    example "No line in `.` mentions `sub`."
    grounding "data/seed/multilingual-responses-agentic-tools.lino"
  function_expectation_holds
    defined-by answer
    role localized_response_template
    precondition "a bug report stated what a function should return and running it at the contract samples gave that value"
    effect "no defect is reported and the file is left unchanged"
    unit "not applicable"
    example "No defect found: `add(2, 3)` in `m.mjs` returned `5`, the expected `5`, so `m.mjs` is unchanged."
    grounding "data/seed/multilingual-responses-agentic-tools.lino"
  function_expectation_fails
    defined-by answer
    role localized_response_template
    precondition "a bug report stated what a function should return and running it at the contract samples gave another value"
    effect "the defect is reported as confirmed with both values and the file is left unchanged"
    unit "not applicable"
    example "The defect is confirmed: `add(2, 3)` in `m.mjs` returned `5`, but the request expects `6`."
    grounding "data/seed/multilingual-responses-agentic-tools.lino"
  general_change_existing_file_kept
    defined-by answer
    role localized_response_template
    precondition "a literal-file write whose verb does not name a whole-file write found its target already holding content"
    effect "the file is left unchanged and the refusal names it"
    unit "not applicable"
    example "Left `m.mjs` unchanged: it already has content, and the request does not say to replace the whole file."
    grounding "data/seed/multilingual-responses-agentic-tools.lino"
  module_exports_listed
    defined-by answer
    role localized_response_template
    precondition "a question asked which functions a named module exports and its declarations carry an export marker"
    effect "the answer counts the exported functions and names each"
    unit "not applicable"
    example "`src/m.mjs` exports 2 function(s): `add`, `mul`."
    grounding "data/seed/multilingual-responses-agentic-tools.lino"
  module_exports_none
    defined-by answer
    role localized_response_template
    precondition "a question asked which functions a named module exports and no declaration carries an export marker"
    effect "the answer says the module exports no function"
    unit "not applicable"
    example "`src/m.mjs` exports no function."
    grounding "data/seed/multilingual-responses-agentic-tools.lino"
