  print_renderer laravel
    literal "php_single"
    syntax '<?php\n\nnamespace App\\Console\\Commands;\n\nuse Illuminate\\Console\\Command;\n\nclass HelloWorld extends Command\n{\n    protected $signature = \x27hello:world\x27;\n\n    protected $description = \x27Print a greeting\x27;\n\n    public function handle(): int\n    {\n        $this->line({literal});\n\n        return self::SUCCESS;\n    }\n}'
