# Response intents, fragment templates, rule scopes, cue roles and manual
# packages of the issue #1177 code-task family. Each record defines a slug
# that the code-task seed files reference as a value (intent keys in
# multilingual-responses.lino, scope values in code-review-rules.lino, role
# values and class labels in code-task-cues.lino, package values in
# manual-pages.lino), so the closure audit resolves them as authored
# meanings instead of counting them as unresolved references. No lexeme
# children — these are response shapes and routing vocabulary, not surfaces.
meanings
  code_debugging_defect
    defined-by method
    role action
    precondition "a debugging request names code in which the defect table's shifted-quotient pattern matches the property the function name promises"
    effect "answers with the template that names the defect line, the shift, and both the drop-shift and parenthesized repairs"
    unit "not applicable"
    example "a mean function that subtracts after the division is reported with its parenthesized repair"
    grounding "data/seed/multilingual-responses.lino"
  code_debugging_index_bound
    defined-by method
    role action
    precondition "a debugging request names code whose loop bound lets an index reach a collection's length, and the code indexes that collection"
    effect "answers with the offending line, why the final pass reads out of range, and the bound that stops one position earlier"
    unit "not applicable"
    example "for i in range(len(xs) + 1) with xs[i] in the body is reported with the fix range(len(xs))"
    grounding "data/seed/multilingual-responses-code-tasks.lino"
  code_debugging_condition_assignment
    defined-by method
    role action
    precondition "a debugging request names code whose parenthesized if or while condition holds a lone assignment at its top level"
    effect "answers with the offending line, why an assignment in a condition tests the assigned value, and the comparison that replaces it"
    unit "not applicable"
    example "if (x = 5) is reported with the fix if (x == 5)"
    grounding "data/seed/multilingual-responses-code-tasks.lino"
  assignment_in_condition
    defined-by method
    role action
    precondition "a code line opens a parenthesized condition with a seeded head"
    effect "names the condition heads the code debugger scans for a lone assignment"
    unit "not applicable"
    example "if ( and while ( open the conditions scanned"
    grounding "data/seed/code-task-cues.lino"
  code_debugging_no_defect
    defined-by method
    role action
    precondition "a debugging request names code the defect table scans without a match"
    effect "answers that no recognized defect pattern matched and names the honest next steps a human would take"
    unit "not applicable"
    example "a scanned function whose division carries no top-level shift is reported as unmatched"
    grounding "data/seed/multilingual-responses.lino"
  code_debugging_no_intent
    defined-by method
    role action
    precondition "a debugging request names a function absent from the intent table"
    effect "answers that no promised property was available to check the code against"
    unit "not applicable"
    example "a function whose name promises nothing is scanned without a property to compare"
    grounding "data/seed/multilingual-responses.lino"
  regex_synthesis_pattern
    defined-by method
    role action
    precondition "a regular-expression request states composable class counts, optional groups and separators"
    effect "answers with the anchored pattern, the constraint mapping and the structural verification note"
    unit "not applicable"
    example "five digits optionally followed by a hyphen and four digits composes to an anchored postal pattern"
    grounding "data/seed/multilingual-responses.lino"
  regex_synthesis_broken
    defined-by method
    role action
    precondition "composed constraints failed the structural verification"
    effect "answers that no pattern will be guessed and names the structural problems found"
    unit "not applicable"
    example "a composition with an unclosed repetition is refused with the problem named"
    grounding "data/seed/multilingual-responses.lino"
  regex_synthesis_refusal
    defined-by method
    role action
    precondition "a regular-expression request states no composable constraints"
    effect "answers that no pattern will be guessed and names the composable forms the handler understands"
    unit "not applicable"
    example "a request without class counts is refused rather than guessed"
    grounding "data/seed/multilingual-responses.lino"
  regex_mapping_line
    defined-by method
    role action
    precondition "one composed constraint needs its derivation shown"
    effect "renders the request phrase beside the pattern fragment it produced"
    unit "not applicable"
    example "the five-digit count renders beside its class fragment"
    grounding "data/seed/multilingual-responses.lino"
  regex_role_main
    defined-by method
    role action
    precondition "the first composed constraint needs its role named"
    effect "renders the main-run note appended to its mapping line"
    unit "not applicable"
    example "the leading class count is marked as the main run"
    grounding "data/seed/multilingual-responses.lino"
  regex_role_optional
    defined-by method
    role action
    precondition "a composed constraint sits inside an optional group"
    effect "renders the optional-group note appended to its mapping line"
    unit "not applicable"
    example "the trailing four digits are marked as an optional group"
    grounding "data/seed/multilingual-responses.lino"
  regex_role_required
    defined-by method
    role action
    precondition "a composed constraint after the first is required"
    effect "renders the required-group note appended to its mapping line"
    unit "not applicable"
    example "a second mandatory class count is marked as a required group"
    grounding "data/seed/multilingual-responses.lino"
  regex_note_separator
    defined-by method
    role action
    precondition "a composed constraint follows a named literal separator"
    effect "renders the separator note appended to its mapping line"
    unit "not applicable"
    example "a hyphen between two class counts is named in the mapping"
    grounding "data/seed/multilingual-responses.lino"
  regex_anchor_note_anchored
    defined-by method
    role action
    precondition "the composed pattern was anchored at both ends"
    effect "renders the note that the whole string must match, not a substring"
    unit "not applicable"
    example "an anchored postal pattern states the whole-match requirement"
    grounding "data/seed/multilingual-responses.lino"
  regex_anchor_note_unanchored
    defined-by method
    role action
    precondition "the request asked to match a substring anywhere"
    effect "renders the note that the pattern matches anywhere"
    unit "not applicable"
    example "an unanchored pattern states it matches anywhere"
    grounding "data/seed/multilingual-responses.lino"
  regex_problem_dangling_escape
    defined-by method
    role action
    precondition "a composed pattern ends with a lone backslash"
    effect "names the dangling escape in the structural refusal"
    unit "not applicable"
    example "a trailing backslash escapes nothing and is named"
    grounding "data/seed/multilingual-responses.lino"
  regex_problem_bad_repetition
    defined-by method
    role action
    precondition "a composed repetition carries no count after its opening brace"
    effect "names the missing repetition count in the structural refusal"
    unit "not applicable"
    example "an opening brace with no digits is named"
    grounding "data/seed/multilingual-responses.lino"
  regex_problem_unclosed_repetition
    defined-by method
    role action
    precondition "a composed repetition is not closed"
    effect "names the unclosed repetition in the structural refusal"
    unit "not applicable"
    example "a brace opened and never closed is named"
    grounding "data/seed/multilingual-responses.lino"
  regex_problem_unbalanced_parens
    defined-by method
    role action
    precondition "composed groups do not balance"
    effect "names the unbalanced parentheses in the structural refusal"
    unit "not applicable"
    example "an unclosed group is named"
    grounding "data/seed/multilingual-responses.lino"
  regex_problem_unbalanced_class
    defined-by method
    role action
    precondition "a composed character class is not closed"
    effect "names the unbalanced class brackets in the structural refusal"
    unit "not applicable"
    example "an unclosed bracket pair is named"
    grounding "data/seed/multilingual-responses.lino"
  sql_synthesis_statement
    defined-by method
    role action
    precondition "a query request names a table and states constraints the clause builders cover"
    effect "answers with the composed statement and a clause-by-clause mapping back to the request"
    unit "not applicable"
    example "users older than thirty composes to a filtered select"
    grounding "data/seed/multilingual-responses.lino"
  sql_synthesis_refusal
    defined-by method
    role action
    precondition "a query request names no table"
    effect "answers that no table will be guessed and asks for one by name"
    unit "not applicable"
    example "a request without a table name is refused"
    grounding "data/seed/multilingual-responses.lino"
  shell_command_composed
    defined-by method
    role action
    precondition "a shell request matches a manual page the seed covers and states constraints a composer handles"
    effect "answers with the composed command, its flags quoted from the manual, and the derivation"
    unit "not applicable"
    example "log files larger than a size under a path compose to a find command"
    grounding "data/seed/multilingual-responses.lino"
  shell_command_piped
    defined-by method
    role action
    precondition "a counting shell request composes a covered command and the seed covers the counting pipe stage"
    effect "answers with the composed pipeline, each stage's flags quoted from its manual, and the derivation"
    unit "not applicable"
    example "counting files of an extension under a path composes to a find command piped into wc"
    grounding "data/seed/multilingual-responses.lino"
  shell_compose_refusal
    defined-by method
    role action
    precondition "a shell request matches no manual page the seed covers"
    effect "answers that no command will be guessed and names the covered tools"
    unit "not applicable"
    example "a request for an uncovered tool is refused by name"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_lines
    defined-by method
    role action
    precondition "an explanation request names code in which at least one construct matches the table"
    effect "answers with the line-by-line meanings, the overall name promise and the cost note"
    unit "not applicable"
    example "a mean function is explained line by line with its name promise"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_line
    defined-by method
    role action
    precondition "one matched construct needs its meaning shown"
    effect "renders the code line beside its construct meaning sentence"
    unit "not applicable"
    example "a definition line renders beside its meaning sentence"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_unmatched_line
    defined-by method
    role action
    precondition "one code line matches no construct in the table"
    effect "lists the line as unexplained so no line of the code is silently skipped"
    unit "not applicable"
    example "an unknown statement is listed as left unexplained"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_overall
    defined-by method
    role action
    precondition "the explained function name is in the intent table"
    effect "renders the promised property and its canonical form with the grounding"
    unit "not applicable"
    example "a mean function promise is stated with its canonical form"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_no_overall
    defined-by method
    role action
    precondition "the explained function name is absent from the intent table"
    effect "renders the note that no promised property exists to summarize"
    unit "not applicable"
    example "an unlisted name states it promises nothing"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_no_construct
    defined-by method
    role action
    precondition "an explanation request names code in which no construct matches the table"
    effect "answers that no construct matched and names what the table covers"
    unit "not applicable"
    example "unmatched lines are reported honestly with the table's scope"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_cost_linear
    defined-by method
    role action
    precondition "the explained lines contain a loop over the input"
    effect "renders the note that the work grows linearly with the input"
    unit "not applicable"
    example "a loop states linear work"
    grounding "data/seed/multilingual-responses.lino"
  code_explanation_cost_constant
    defined-by method
    role action
    precondition "the explained lines contain no loop over the input"
    effect "renders the note that no loop appears in these lines"
    unit "not applicable"
    example "straight-line code states no loop appears"
    grounding "data/seed/multilingual-responses.lino"
  code_review_findings
    defined-by method
    role action
    precondition "a review request names code in which at least one rule fires"
    effect "answers with each finding, its severity, advice and upstream source"
    unit "not applicable"
    example "a bare except is reported with its upstream source"
    grounding "data/seed/multilingual-responses.lino"
  code_review_finding
    defined-by method
    role action
    precondition "one rule fired on one line of the reviewed code"
    effect "renders the finding row with severity, line number, advice and source"
    unit "not applicable"
    example "the bare-except row renders with its line number and source"
    grounding "data/seed/multilingual-responses.lino"
  code_review_no_match
    defined-by method
    role action
    precondition "a review request names code in which no rule fires"
    effect "answers that no rule matched and names the honest limits of the rule table"
    unit "not applicable"
    example "code the table finds nothing in is reported as unmatched, not as clean"
    grounding "data/seed/multilingual-responses.lino"
  test_generation_suite
    defined-by method
    role action
    precondition "a test request names a function a known problem shape matches"
    effect "answers with the suite, its derivation rows and the not-executed note"
    unit "not applicable"
    example "a palindrome function yields a suite of named cases with a normalize helper"
    grounding "data/seed/multilingual-responses.lino"
  test_generation_unknown_shape
    defined-by method
    role action
    precondition "the function under test matches no shape and the request states no example"
    effect "refuses to guess expected values and asks for stated examples instead"
    unit "not applicable"
    example "tests for an unknown function with no examples are refused"
    grounding "data/seed/multilingual-responses.lino"
  test_example_relation
    defined-by method
    role relation
    precondition "a test request states an example call followed by its expected value"
    effect "joins the stated call to the value the generated assertion expects"
    unit "not applicable"
    example "square(3) returns 9 becomes assert square(3) == 9"
    grounding "data/seed/code-task-cues.lino"
  regex_synthesis_not_executed
    defined-by method
    role action
    precondition "no example can be derived from the composed constraints"
    effect "says that no match was run and asks for a test on real inputs"
    unit "not applicable"
    example "a pattern with no derivable probe is left unexecuted"
    grounding "data/seed/multilingual-responses.lino"
  regex_synthesis_witness_verified
    defined-by method
    role action
    precondition "the composed pattern accepts and rejects every derived example"
    effect "reports the derived examples the pattern text was matched against"
    unit "not applicable"
    example "a postal pattern is matched against its derived examples"
    grounding "data/seed/multilingual-responses.lino"
  regex_synthesis_witness_failed
    defined-by method
    role action
    precondition "the composed pattern disagrees with an example derived from its constraints"
    effect "reports the disagreeing examples and withholds trust in the pattern"
    unit "not applicable"
    example "a pattern rejecting its own positive example is reported"
    grounding "data/seed/multilingual-responses.lino"
  test_generation_refusal
    defined-by method
    role action
    precondition "a test request names no function under test"
    effect "answers that no suite will be guessed and asks for the function by name"
    unit "not applicable"
    example "a request with no function name is refused"
    grounding "data/seed/multilingual-responses.lino"
  code_refactoring_async
    defined-by method
    role action
    precondition "a refactoring request names a promise chain the parser fully understands"
    effect "answers with the async rewrite that preserves every handler body verbatim"
    unit "not applicable"
    example "a chained fetch rewrites to awaited steps inside a try block"
    grounding "data/seed/multilingual-responses.lino"
  code_refactoring_refusal
    defined-by method
    role action
    precondition "a refactoring request names code that is not a promise chain"
    effect "answers that the one implemented transformation does not apply and names it"
    unit "not applicable"
    example "a request without a chain is refused with the supported transformation named"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_to_yaml
    defined-by method
    role action
    precondition "a conversion request names json text inside the supported subset and yaml as the target"
    effect "answers with the block-style yaml rendering and the round-trip note"
    unit "not applicable"
    example "a nested object renders as block yaml with two-space indent"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_to_json
    defined-by method
    role action
    precondition "a conversion request names yaml text inside the supported subset and json as the target"
    effect "answers with the json rendering and the round-trip note"
    unit "not applicable"
    example "block yaml renders as nested json"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_refusal
    defined-by method
    role action
    precondition "a conversion request cannot be honored inside the subset"
    effect "answers with the refusal that names the reason"
    unit "not applicable"
    example "a broken document is refused with its reason named"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_csv_to_json
    defined-by method
    role action
    precondition "a CSV table with a header row is asked for as JSON"
    effect "renders the rows as JSON objects keyed by the header and states the round-trip check"
    unit "not applicable"
    example "name,age then Ann,30 becomes one object with two string values"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_reason_csv
    defined-by method
    role action
    precondition "the CSV text breaks the header or field-count rules"
    effect "names the CSV subset the conversion reads and refuses to guess"
    unit "not applicable"
    example "a row with a missing field is refused"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_reason_bad_json
    defined-by method
    role action
    precondition "the json text was recognized but failed to parse"
    effect "names the parse failure inside the refusal"
    unit "not applicable"
    example "a trailing comma names the parse failure"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_reason_roundtrip
    defined-by method
    role action
    precondition "the converted text did not re-parse to the input value"
    effect "names the round-trip failure inside the refusal"
    unit "not applicable"
    example "a lossy rendering is refused rather than shown"
    grounding "data/seed/multilingual-responses.lino"
  format_conversion_reason_subset
    defined-by method
    role action
    precondition "the text sits outside the supported yaml subset"
    effect "names the subset limit inside the refusal"
    unit "not applicable"
    example "an anchor is refused as outside the subset"
    grounding "data/seed/multilingual-responses.lino"
  mapping_line
    defined-by method
    role action
    precondition "a derivation needs one request phrase shown beside its emission"
    effect "renders one mapping row with the request phrase and the emitted fragment"
    unit "not applicable"
    example "the older-than phrase renders beside its where clause"
    grounding "data/seed/multilingual-responses.lino"
  flag_line
    defined-by method
    role action
    precondition "a composed command flag needs its manual meaning shown"
    effect "renders one flag beside the meaning its manual page states"
    unit "not applicable"
    example "the size flag renders beside its manual meaning"
    grounding "data/seed/multilingual-responses.lino"
  any_line
    defined-by method
    role action
    precondition "a review rule applies to every line of the code"
    effect "scopes the rule to any line regardless of position"
    unit "not applicable"
    example "a bare except is checked on any line"
    grounding "data/seed/code-review-rules.lino"
  def_line
    defined-by method
    role action
    precondition "a review rule applies to function definition lines"
    effect "scopes the rule to lines that open a function definition"
    unit "not applicable"
    example "a mutable default is checked on the definition line"
    grounding "data/seed/code-review-rules.lino"
  loop_body
    defined-by method
    role action
    precondition "a review rule applies to lines inside loops"
    effect "scopes the rule to the indented bodies of loop headers"
    unit "not applicable"
    example "a string concatenation is checked inside the loop body"
    grounding "data/seed/code-review-rules.lino"
  csv_to_json
    defined-by method
    role action
    precondition "a conversion request names a csv table as the source and json as the target"
    effect "routes the request to the csv-to-json conversion"
    unit "not applicable"
    example "a csv table with a header row is asked for as json"
    grounding "data/seed/code-task-cues.lino"
  to_json
    defined-by method
    role action
    precondition "a conversion request names json as the target format"
    effect "routes the request to the yaml-to-json conversion"
    unit "not applicable"
    example "a yaml document is asked for as json"
    grounding "data/seed/code-task-cues.lino"
  to_yaml
    defined-by method
    role action
    precondition "a conversion request names yaml as the target format"
    effect "routes the request to the json-to-yaml conversion"
    unit "not applicable"
    example "a json document is asked for as yaml"
    grounding "data/seed/code-task-cues.lino"
  coreutils
    defined-by software_artifact
    role action
    precondition "a composed command comes from the gnu core utilities package"
    effect "names the package the manual page belongs to"
    unit "not applicable"
    example "the listing command cites its core-utilities manual page"
    grounding "data/seed/manual-pages.lino"
  findutils
    defined-by software_artifact
    role action
    precondition "a composed command comes from the gnu find utilities package"
    effect "names the package the manual page belongs to"
    unit "not applicable"
    example "the find command cites its find-utilities manual page"
    grounding "data/seed/manual-pages.lino"
  regex_synthesis_execution_verified
    defined-by method
    role action
    precondition "a composed pattern compiled in the browser regex engine and behaved as derived on every example"
    effect "appends the execution evidence: how many positive examples matched and negative examples were rejected"
    unit "not applicable"
    example "the postal pattern matches 12345 and 12345-6789 and rejects 1234"
    grounding "data/seed/multilingual-responses.lino"
  regex_synthesis_execution_failed
    defined-by method
    role action
    precondition "a composed pattern disagreed with an example derived from its own constraints"
    effect "appends the failing examples and withdraws reliance on the pattern"
    unit "not applicable"
    example "a pattern that rejects one of its own positive examples is flagged"
    grounding "data/seed/multilingual-responses.lino"
  code_refactoring_execution_matched
    defined-by method
    role action
    precondition "the promise chain and its async rewrite produced the same call trace in every stubbed scenario"
    effect "appends the scenario count and the matched call trace"
    unit "not applicable"
    example "a fetch-json-render chain traces the same calls before and after the rewrite"
    grounding "data/seed/multilingual-responses.lino"
  code_refactoring_execution_mismatch
    defined-by method
    role action
    precondition "the promise chain and its async rewrite produced different call traces in some scenario"
    effect "appends the differing traces and asks for review"
    unit "not applicable"
    example "a rewrite that drops the catch handler is flagged"
    grounding "data/seed/multilingual-responses.lino"
  code_refactoring_execution_skipped
    defined-by method
    role action
    precondition "the rewritten chain cannot be run safely in the worker"
    effect "appends why the execution check did not run"
    unit "not applicable"
    example "a handler body with a loop is not executed"
    grounding "data/seed/multilingual-responses.lino"
  infinite_loop
    defined-by method
    role action
    precondition "a shell-command rewrite request asks for the command to repeat"
    effect "marks the request as wanting the command wrapped in an endless loop"
    unit "not applicable"
    example "run the cleanup forever in a loop"
    grounding "data/seed/code-task-cues.lino"
  screen_execution
    defined-by method
    role action
    precondition "a shell-command rewrite request that names a screen session asks for the command to run inside it on one line"
    effect "marks the request as wanting the loop started detached as screen -dmS with bash -c"
    unit "not applicable"
    example "execute it in a single line inside screen"
    grounding "data/seed/code-task-cues.lino"
  command_head
    defined-by method
    role action
    precondition "a prompt opens or contains a known command-line program name"
    effect "weighs the prompt as an existing shell command to transform rather than prose"
    unit "not applicable"
    example "rewrite the docker run command as a loop"
    grounding "data/seed/code-task-cues.lino"
  prose_lead
    defined-by method
    role action
    precondition "a prompt opens with a conversational request lead"
    effect "weighs the prompt as prose describing a command rather than a command itself"
    unit "not applicable"
    example "can we make a loop of this command"
    grounding "data/seed/code-task-cues.lino"
  size_qualifier
    defined-by method
    role action
    precondition "a shell-compose request compares file sizes with a larger-than word"
    effect "selects the find size test with a plus threshold"
    unit "not applicable"
    example "find files larger than 10 mb"
    grounding "data/seed/code-task-cues.lino"
  search_object
    defined-by method
    role action
    precondition "a shell-compose request says search for an object"
    effect "lets a search verb select the grep composition when paired with its object"
    unit "not applicable"
    example "search for TODO in the project"
    grounding "data/seed/code-task-cues.lino"
  filler
    defined-by method
    role action
    precondition "a SQL request words a join with connector words around the joined table"
    effect "marks a word the join reading skips when it looks for the joined table or the shared column"
    unit "not applicable"
    example "with, the and table in 'joined with the orders table on user_id'"
    grounding "data/seed/code-task-cues.lino"
  substitute_with
    defined-by method
    role property
    precondition "a substitution request names the text to replace, then a connector word, then its replacement"
    effect "marks the connector between the pattern and the replacement the sed composer reads"
    unit "not applicable"
    example "with in 'replace foo with bar in config.txt'; на in 'замени foo на bar'"
    grounding "data/seed/code-task-cues.lino"
  sed
    defined-by method
    role action
    precondition "a substitution request names a pattern, a replacement and a file"
    effect "composes a literal in-place sed substitution, cited from the GNU sed manual and not executed"
    unit "not applicable"
    example "replace 1.0 with 2.0 in version.txt composes sed -i 's/1\\.0/2.0/g' version.txt"
