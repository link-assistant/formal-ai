coding_discovery_runtime
  template python_import
    text "import {module}"
  template python_return
    text "return {expression}"
  template python_materialize_list
    text "list({items})"
    grounding "https://docs.python.org/3.12/library/functions.html#func-list"
    license "PSF-2.0"
    rediscovery_query "materialize iterable as list"
    fragment_signature "sequence<unknown:0>"
    fragment_result "sequence<unknown:0>"
    supports running_prefix
    supports range_inclusive
  template python_materialize_tuple
    text "tuple({items})"
    grounding "https://docs.python.org/3.12/library/stdtypes.html#tuple"
    license "PSF-2.0"
    rediscovery_query "materialize iterable as tuple"
    fragment_signature "ordered<unknown:0>"
    fragment_result "sequence<unknown:0>"
    supports set_intersection
  template python_test_entrypoint
    text "\nif __name__ == '__main__':\n"
  template python_for_each
    text "for {item} in {items}:\n    {body}"
  template python_doc_probe
    text "print(({expression}).__doc__ or '')"
  template mapping_entry
    text "{key}: {value}"
  template ordering_entry
    text "{literal}: {index}"
  template example_arithmetic_divide
    text "({product}) / {divisor}"
  template oeis_dimension_query
    text "{left} x {right} {object} tilings"
  template oeis_formula_membership
    text "any(({expression}) == {parameter} for source_index in range({start}, 100000) if ({expression}) <= {parameter})"
  template oeis_recurrence_term
    text "({coefficient} * values[-{index}])"
coding_runtime_templates
  template python_ir_function
    text "def {name}({parameters}):\n    return {expression}\n"
  template python_ir_predicate
    text " if {predicate}"
  template python_ir_each
    text "[{body} for {item} in {items}{predicate}]"
  template python_ir_fold
    text "__import__('functools').reduce(lambda {accumulator}, {item}: {body}, {items}, {initial})"
  template python_ir_repeat
    text "[{body} for {counter} in range({from}, {to})]"
  template python_ir_recurrence
    text "(lambda sequence_index: 0 if sequence_index < 0 else (([{base}])[sequence_index] if sequence_index < {base_count} else __import__('functools').reduce(lambda values, _: values + [{transition}], range({base_count}, sequence_index + 1), [{base}])[sequence_index]))({index})"
  template python_ir_recursive_values
    text "(self(self, {next}) for {item} in {items}{predicate})"
  template python_ir_recursive_reduce
    text "(lambda visit: visit(visit, {target}))(lambda self, {state}: {base} if {base_test} else {combined})"
  template python_ir_recursive_shape
    text "state, target, next, and predecessor bindings must be non-empty and aligned"
  template python_ir_recursive_reducer
    text "reducer fragment `{fragment}`"
  template python_ir_recursive_combine
    text "combine fragment `{fragment}`"
  template python_ir_condition
    text "({then} if {test} else {otherwise})"
  template python_ir_emit
    text "(print({value}), {value})[1]"
  template python_ir_missing_fragment
    text "fragment `{fragment}` has no compatible Python realization"
  template rust_ir_filter
    code ".filter(|{item}| {predicate})"
  template rust_ir_fold
    code "({items}).into_iter().fold({initial}, |{accumulator}, {item}| {body})"
  template rust_ir_condition
    text "if {test} {open} {then} {close} else {open} {otherwise} {close}"
  template rust_ir_emit
    text "{open} let value = {value}; println!(""{debug_format}"", value); value {close}"
  template rust_ir_missing_fragment
    text "fragment `{fragment}` is absent"
  template rust_ir_recursive_reduce_gap
    text "well-founded recursive reduction needs an explicit ownership strategy"
  template coding_invalid_cst
    text "candidate did not form a valid {language} CST"
  template fragment_definition_query
    text "definition of {fragment}"
  template ir_parameter_error
    text "Parameter {name}: {detail}"
  template ir_apply_missing
    text "Apply {fragment}: fragment not found"
  template ir_apply_arity
    text "Apply {fragment}: expected {expected} arguments, received {observed}"
  template ir_apply_argument
    text "Apply {fragment} argument {position}: {detail}"
  template ir_each_predicate
    text "Each predicate: {detail}"
  template ir_fold_error
    text "Fold {accumulator}: {detail}"
  template ir_repeat_error
    text "Repeat {counter}: {detail}"
  template ir_recurrence_index
    text "Recurrence index: {detail}"
  template ir_recurrence_base
    text "Recurrence base: {detail}"
  template ir_recurrence_transition
    text "Recurrence transition: {detail}"
  template ir_recursive_arity
    text "RecursiveReduce state, target and next arity differ"
  template ir_recursive_next
    text "RecursiveReduce next state {position}: {detail}"
  template ir_recursive_admissible
    text "RecursiveReduce admissible: {detail}"
  template ir_recursive_base_test
    text "RecursiveReduce base test: {detail}"
  template ir_recursive_local
    text "RecursiveReduce local value: {detail}"
  template ir_recursive_destructure
    text "RecursiveReduce cannot bind {arity} names from {type}"
  template ir_recursive_reducer_missing
    text "RecursiveReduce reducer {fragment}: fragment not found"
  template ir_recursive_reducer_arity
    text "RecursiveReduce reducer {fragment}: expected one argument"
  template ir_recursive_combine_missing
    text "RecursiveReduce combine {fragment}: fragment not found"
  template ir_recursive_combine_arity
    text "RecursiveReduce combine {fragment}: expected two arguments"
  template ir_condition_test
    text "Condition test: {detail}"
  template ir_condition_branches
    text "Condition branches: {detail}"
  template ir_type_mismatch
    text "expected {expected}, observed {observed}"
  template publisher_python_import
    text "import {module}"
  template verifiable_exact_division
    text "{target} // {coefficient}"
  template verifiable_division
    text "{target} / {coefficient}"
  template verifiable_parenthesized_division
    text "({target}) / ({coefficient})"
