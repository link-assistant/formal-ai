# Request frames, semantic facets and renderings for local prompt data.
# A facet connects caller labels to candidate evidence phrases. It never
# supplies an answer label outside the caller's domain.
prompt-data
  cue "classification"
    surface "choose exactly one label"
    surface "choose one label"
    surface "choose a label"
    surface "select one label"
    surface "classify"
    surface "выбери ровно одну метку"
    surface "выбери одну метку"
    surface "выбери метку"
    surface "классифицируй"
    surface "определи тональность"
  cue "sentiment"
    surface "sentiment"
    surface "тональность"
  cue "language"
    surface "what language is"
    surface "which language is"
    surface "what is the language of"
    surface "identify the language"
    surface "detect the language"
    surface "на каком языке"
    surface "определи язык"
    surface "какой это язык"
  cue "records"
    surface "records"
    surface "table"
    surface "given these records"
    surface "given this table"
    surface "записи"
    surface "таблица"
  cue "question"
    surface "question"
    surface "вопрос"
  cue "extraction"
    surface "extract"
    surface "выдели"
    surface "извлеки"
  cue "subject_question"
    surface "who"
    surface "which"
    surface "кто"
    surface "у кого"
    surface "какой"
    surface "какая"
  cue "identity_field"
    surface "name"
    surface "id"
    surface "имя"
    surface "код"
  cue "affirmative"
    surface "yes"
    surface "true"
    surface "да"
  cue "negative"
    surface "no"
    surface "false"
    surface "нет"
  cue "negation"
    surface "not"
    surface "doesn t"
    surface "without"
    surface "не"
    surface "нет"
    surface "без"
  cue "option_join"
    surface "or"
    surface "and"
    surface "или"
    surface "и"
  cue "omit"
    surface "without mentioning"
    surface "без упоминания"
  cue "rewrite"
    surface "rewrite"
    surface "перепиши"
  facet "travel_to_work"
    label "commute"
    label "commuting"
    label "дорога"
    label "проезд"
    term "too far"
    term "far from my home"
    term "each way"
    term "bus ride"
    term "travel to work"
    term "слишком далеко"
    term "далеко от дома"
    term "добираюсь"
    term "в одну сторону"
  facet "compensation"
    label "salary"
    label "pay"
    label "compensation"
    label "зарплата"
    label "оплата"
    term "wages"
    term "underpaid"
    term "hourly rate"
    term "мало платят"
    term "оклад"
    term "ставка"
  facet "working_hours"
    label "schedule"
    label "hours"
    label "график"
    label "расписание"
    term "night shift"
    term "weekend shifts"
    term "start time"
    term "working hours"
    term "ночная смена"
    term "по выходным"
    term "рабочие часы"
  facet "positive"
    label "positive"
    label "положительная"
    term "excellent"
    term "great"
    term "wonderful"
    term "delighted"
    term "love it"
    term "loved it"
    term "love this"
    term "very happy"
    term "отлично"
    term "прекрасно"
    term "понравилось"
    term "в восторге"
    term "очень рад"
    term "очень рада"
  facet "negative"
    label "negative"
    label "отрицательная"
    term "terrible"
    term "awful"
    term "unhappy"
    term "disappointed"
    term "unacceptable"
    term "hate it"
    term "hate this"
    term "hated it"
    term "ужасно"
    term "очень плохо"
    term "не понравилось"
    term "разочарован"
    term "разочарована"
    term "неприемлемо"
  facet "neutral"
    label "neutral"
    label "нейтральная"
  facet "fallback"
    label "other"
    label "unknown"
    label "другое"
    label "неизвестно"
  locale "en"
    evidence "Evidence: «{span}»"
    gap "I could not determine the requested answer from the supplied text."
    missing "No unique value in the supplied text."
    unknown "unknown"
    dictionary "Dictionary matches"
  locale "ru"
    evidence "Основание: «{span}»"
    gap "Не удалось определить ответ по предоставленному тексту."
    missing "В тексте нет однозначного значения."
    unknown "неизвестно"
    dictionary "Словарные совпадения"
    en "Английский"
    ru "Русский"
    es "Испанский"
    hi "Хинди"
    zh "Китайский"
