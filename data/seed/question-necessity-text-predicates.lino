
# Text recognition policy consumed by question_necessity.rs.
question_necessity_text_predicate_1
  record_type "question_necessity_text_predicate"
  name "memory_event"
  operation "prefix"
  value "memory"
question_necessity_text_predicate_2
  record_type "question_necessity_text_predicate"
  name "self_trace_event"
  operation "prefix"
  value "question_necessity:"
question_necessity_text_predicate_3
  record_type "question_necessity_text_predicate"
  name "workspace_evidence"
  operation "contains"
  value "workspace"
question_necessity_text_predicate_4
  record_type "question_necessity_text_predicate"
  name "workspace_evidence"
  operation "contains"
  value "derivation"
question_necessity_text_predicate_5
  record_type "question_necessity_text_predicate"
  name "url"
  operation "prefix"
  value "http://"
question_necessity_text_predicate_6
  record_type "question_necessity_text_predicate"
  name "url"
  operation "prefix"
  value "https://"
question_necessity_text_predicate_7
  record_type "question_necessity_text_predicate"
  name "replayed_question"
  operation "prefix"
  value "your previous question was:"

# Selecting an unresolved referent is a requirement, not an unknown fact.
# Keep the original agent-authored policy intact; extend the composed policy.
referent-requirement-question
  record_type "question_necessity_class"
  class "requirement"
  cue "do you mean"
  cue "вы имеете в виду"
  cue "की बात कर रहे हैं"
  cue "你指的是"
  cue "te refieres"

# Asking for the operation of an unnamed algorithm request or the topic of a
# topicless brainstorm is a requirement: no memory, workspace or source can
# supply what the caller has not chosen yet (`algorithm-operation-required` in
# multilingual-responses-code-tasks.lino, `brainstorming_refusal` in
# multilingual-responses-creative-tasks.lino).
missing-choice-requirement-question
  record_type "question_necessity_class"
  class "requirement"
  cue "what should the algorithm do"
  cue "что должен делать алгоритм"
  cue "एल्गोरिदम को क्या करना चाहिए"
  cue "算法应该完成什么任务"
  cue "qué debe hacer el algoritmo"
  cue "what topic should the ideas or names be about"
  cue "для какой темы нужны идеи или названия"
  cue "आप किस विषय के लिए विचार या नाम चाहते हैं"
  cue "你想为哪个主题构思想法或名称"
  cue "para qué tema quieres ideas o nombres"
