
# Text recognition policy consumed by question_necessity.rs.
question_necessity_text_predicate_1
  record_type "question_necessity_text_predicate"
  name "memory_event"
  operation "prefix"
  value "memory"
question_necessity_text_predicate_2
  record_type "question_necessity_text_predicate"
  name "self_trace_event"
  operation "prefix"
  value "question_necessity:"
question_necessity_text_predicate_3
  record_type "question_necessity_text_predicate"
  name "workspace_evidence"
  operation "contains"
  value "workspace"
question_necessity_text_predicate_4
  record_type "question_necessity_text_predicate"
  name "workspace_evidence"
  operation "contains"
  value "derivation"
question_necessity_text_predicate_5
  record_type "question_necessity_text_predicate"
  name "url"
  operation "prefix"
  value "http://"
question_necessity_text_predicate_6
  record_type "question_necessity_text_predicate"
  name "url"
  operation "prefix"
  value "https://"
question_necessity_text_predicate_7
  record_type "question_necessity_text_predicate"
  name "replayed_question"
  operation "prefix"
  value "your previous question was:"

# Selecting an unresolved referent is a requirement, not an unknown fact.
# Keep the original agent-authored policy intact; extend the composed policy.
referent-requirement-question
  record_type "question_necessity_class"
  class "requirement"
  cue "do you mean"
  cue "вы имеете в виду"
  cue "की बात कर रहे हैं"
  cue "你指的是"
  cue "te refieres"
