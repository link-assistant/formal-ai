    language ru
    text " в формате {label}"
  response response_document_generation_plan_format_hi
    intent document_generation_plan_format
    language hi
    text " ({label} प्रारूप में)"
  response response_document_generation_plan_format_zh
    intent document_generation_plan_format
    language zh
    text "（{label} 格式）"
  response response_document_generation_plan_format_es
    intent document_generation_plan_format
    language es
    text " en formato {label}"
