  tool tool_process_status
    name process.status
    note "Report structured status for the current isolated plan process without exposing host process details."
    mode agent
    inputs ("save_as" "plan_id" "step_id" "precondition" "postcondition")
    outputs ("state" "scope" "sha256")
    isolation isolated-process-view
    permission "tool:computer:process.status"
    localized ru
      name process.status
