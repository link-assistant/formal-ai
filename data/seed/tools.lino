  tool tool_archive_unpack
    name archive.unpack
    note "Unpack a deterministic archive into a confined workspace directory after explicit confirmation."
    mode agent
    inputs ("archive" "destination" "confirmed" "plan_id" "step_id" "precondition" "postcondition")
    outputs ("destination" "entries")
    isolation isolated-workspace
    permission "tool:computer:archive.unpack"
    localized ru
      name archive.unpack
      note "После явного подтверждения распаковывает архив в ограниченный каталог рабочей области."
    localized hi
