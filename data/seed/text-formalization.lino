# Numeric symbols/group widths: Unicode LDML Part3, https://www.unicode.org/reports/tr35/tr35-78/tr35-numbers.html
# Measured2026-10-17 with maintained Intl.NumberFormat/ICU 77.1; space/NBSP/NNBSP accepted as grouping only with declared widths.
# R1188-U18, U19 and U21 — the words the shared text formalizer reads a sentence
# with (js/agentic/crate/text_formalization.mjs, its Rust twin
# rust/src/formalization/text_statements.rs). The code names only the three
# kinds below; every word is data, one record per language.
#
#   anaphor              a pronoun that opens a clause by pointing back at the
#                        subject named before; it is read as that subject.
#   clause-continuation  a conjunction or relative pronoun that opens a clause
#                        which keeps the subject of the clause before it.
#   inflection-ending    an ending the formalizer may remove, or exchange for
#                        another ending of the language, to reach the
#                        dictionary form of an inflected word.
#
# Function words and negation cues are not repeated here. They are the
# translation_stop_word, statement_function_word and statement_negation_cue
# roles of the meaning lexicon.
text-formalization
  defaults
    numeric-decimal "."
    numeric-group ","
    numeric-primary-width "3"
    numeric-secondary-width "3"
  structural-rule target-surface
    reject-fragment "response:"
    reject-fragment "-->"
    reject-fragment "{{"
    reject-fragment "[["
  structural-rule numeric-identity
    resolved-prefix "number:"
    unresolved-prefix "number-unresolved:"
  structural-rule typed-statement-notation
    template "(statement (terms {legacy}) (typed_meaning {typed}))"
  structural-rule answer-compatibility
    missing-reason "missing typed evidence"
  language en
    question-where "where"
    question-how-many "how many"
    question-how-many "how much"
    question-which "which"
    question-which "what"
    question-why "why"
    question-who "who"
    question-when "when"
    question-auxiliary "do"
    question-auxiliary "does"
    question-auxiliary "did"
    question-auxiliary "are"
    question-auxiliary "is"
    question-auxiliary "have"
    question-auxiliary "has"
    question-auxiliary "can"
    question-auxiliary "could"
    question-auxiliary "would"
    question-auxiliary "will"
    addressee "you"
    addressee "your"
    topic-location "located"
    topic-location "location"
    topic-location "live"
    topic-location "reside"
    topic-location "residence"
    topic-experience "experience"
    topic-experience "experienced"
