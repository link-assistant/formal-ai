    answer-yes "i am ready"
    answer-no "no"
    answer-no "not ready"
    answer-no "i am not ready"
    currency-rub "₽"
    currency-rub "rub"
    currency-rub "rubles"
    currency-rub "roubles"
    currency-usd "$"
    currency-usd "usd"
    currency-usd "dollars"
    currency-eur "€"
    currency-eur "eur"
    currency-eur "euros"
    amount-minimum "from"
    amount-minimum "at least"
    amount-maximum "up to"
    amount-maximum "at most"
