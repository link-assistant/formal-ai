# Publisher page references for coding discovery. The runtime acquires page bytes on demand.
coding_documentation_captures
  version "2"
  capture
    language "rust"
    task hello_world
    rediscovery_query "Rust hello world program"
    url "https://doc.rust-lang.org/book/ch01-02-hello-world.html"
    mime "text/html"
  capture
    language "go"
    task hello_world
    rediscovery_query "Go hello world program"
    url "https://go.dev/doc/tutorial/getting-started"
    mime "text/html"
  capture
    language "kotlin"
    task hello_world
    rediscovery_query "how to compile a Kotlin program from the command line"
    url "https://kotlinlang.org/docs/command-line.html"
    mime "text/html"
  capture
    language "kotlin"
    task hello_world
    rediscovery_query "Kotlin hello world program"
    url "https://kotlinlang.org/docs/kotlin-tour-hello-world.html"
    mime "text/html"
  capture
    language "scala"
    task hello_world
    rediscovery_query "Scala hello world program"
    url "https://docs.scala-lang.org/scala3/book/taste-hello-world.html"
    mime "text/html"
  capture
    language "python"
    task hello_world
    rediscovery_query "Python hello world program"
    url "https://wiki.python.org/moin/BeginnersGuide/Programmers/SimpleExamples"
    mime "text/html"
  capture
    language "javascript"
    task hello_world
    rediscovery_query "JavaScript console.log example"
    url "https://raw.githubusercontent.com/mdn/content/main/files/en-us/web/api/console/index.md"
    mime "text/markdown"
  capture
    language "typescript"
    task hello_world
    rediscovery_query "TypeScript hello.ts example"
    url "https://raw.githubusercontent.com/microsoft/TypeScript-Website/v2/packages/documentation/copy/en/handbook-v2/Basics.md"
    mime "text/markdown"
  capture
    language "c"
    task hello_world
    rediscovery_query "C puts example"
    url "https://raw.githubusercontent.com/MicrosoftDocs/cpp-docs/main/docs/c-runtime-library/reference/puts-putws.md"
    mime "text/markdown"
  capture
    language "cpp"
    task hello_world
    rediscovery_query "C++ hello world console program"
    url "https://learn.microsoft.com/en-us/cpp/build/vscpp-step-1-create"
    mime "text/html"
  capture
    language "csharp"
    task hello_world
    rediscovery_query "C# hello world program"
    url "https://learn.microsoft.com/en-us/dotnet/csharp/tour-of-csharp/tutorials/hello-world"
    mime "text/html"
  capture
    language "ruby"
    task hello_world
    rediscovery_query "Ruby hello world program"
    url "https://www.ruby-lang.org/en/examples/hello_world/"
    mime "text/html"
  capture
    language "swift"
    language_name "Swift"
    task hello_world
    rediscovery_query "Swift hello world program"
    url "https://raw.githubusercontent.com/swiftlang/swift-book/main/TSPL.docc/GuidedTour/GuidedTour.md"
    mime "text/markdown"
  capture
    language "java"
    task hello_world
    rediscovery_query "Java hello world application"
    url "https://docs.oracle.com/javase/tutorial/getStarted/cupojava/unix.html"
    mime "text/html"
  capture
    language "php"
    task hello_world
    rediscovery_query "PHP first page tutorial"
    url "https://www.php.net/manual/en/tutorial.firstpage.php"
    mime "text/html"
  capture
    language "lua"
    language_name "Lua"
    task hello_world
    rediscovery_query "Lua hello world program"
    url "https://www.lua.org/pil/1.html"
    mime "text/html"
