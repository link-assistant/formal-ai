      text "Compiling project (Scala 3.9.0, JVM (20))\nCompiled project (Scala 3.9.0, JVM (20))\nHello, World!"
    block
      language "scala"
      text "import scala.io.StdIn.readLine"
    block
      language "scala"
      text "import scala.io.StdIn.readLine\n\nobject helloInteractive {\n\n  def main(args: Array[String]) = {\n    println(""Please enter your name:"")\n    val name = readLine()\n\n    println(""Hello, "" + name + ""!"")\n  }\n\n}"
    block
      language "scala"
      text "import scala.io.StdIn.readLine\n\n@main def helloInteractive() =\n  println(""Please enter your name:"")\n  val name = readLine()\n\n  println(""Hello, "" + name + ""!"")"
    block
      language "bash"
      text "$ scala run helloInteractive.scala\nCompiling project (Scala 3.9.0, JVM (20))\nCompiled project (Scala 3.9.0, JVM (20))\nPlease enter your name:\n▌"
    block
      language "bash"
      text "$ scala run helloInteractive.scala\nCompiling project (Scala 3.9.0, JVM (20))\nCompiled project (Scala 3.9.0, JVM (20))\nPlease enter your name:\nAlvin Alexander\nHello, Alvin Alexander!"
    block
      language "scala"
      text "import scala.io.StdIn.readLine"
