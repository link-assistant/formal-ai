# Response-template intents for the quantity and calendar handlers (issues
# #1176 and #1174). Each record names one `intent` key that
# data/seed/multilingual-responses-quantities.lino carries response records
# for, so the closure audit resolves the key to an authored definition rather
# than an open reference. The shape follows the localized_response_template
# records in meanings-intent.lino; lexeme blocks are deliberately absent
# because these are template identifiers, not conversational vocabulary.
#
# The later records define the response intents of the creative-composition,
# formalization, legality, repair, product-search and TRIZ response files
# (issues #1178, #1186, #836, #1185, #800, #901), plus the two routing intents
# product_search and triz_resolution that product-search-cues.lino and
# triz-principles.lino name, each pointing at the file that uses it.

meanings
  statistics
    defined-by answer
    role localized_response_template
    precondition "a statistics request over an explicit numeric dataset is answered"
    effect "the dataset is echoed with its size and each requested measure is computed and listed"
    unit "not applicable"
    example "The values are 3, 5, 7 (n = 3). mean = 5, median = 5."
    grounding "data/seed/multilingual-responses-quantities.lino"
  unit_conversion_multiply
    defined-by answer
    role localized_response_template
    precondition "a unit conversion is answered whose factor multiplies the source value"
    effect "the converted value is stated with the multiplication that produced it"
    unit "not applicable"
    example "3 km is 3000 m. 3 x 1000 = 3000, because 1 km = 1000 m."
    grounding "data/seed/multilingual-responses-quantities.lino"
  unit_conversion_divide
    defined-by answer
    role localized_response_template
    precondition "a unit conversion is answered whose factor divides the source value"
    effect "the converted value is stated with the division that produced it"
    unit "not applicable"
    example "3000 m is 3 km. 3000 / 1000 = 3, because 1 km = 1000 m."
    grounding "data/seed/multilingual-responses-quantities.lino"
  unit_conversion_formula
    defined-by answer
    role localized_response_template
    precondition "a compound unit conversion is answered through a multi-step formula"
    effect "the converted value is stated with the derivation steps that produced it"
    unit "not applicable"
    example "100 F is 37.8 C. subtract 32, multiply 5/9."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_offset_split_next
    defined-by answer
    role localized_response_template
    precondition "a weekday-offset request forward in time is answered with a non-whole-week day count"
    effect "the resulting weekday is stated with the week-plus-day split of the offset"
    unit "not applicable"
    example "100 days after Monday is Wednesday. 100 days = 14 weeks + 2 days."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_offset_split_previous
    defined-by answer
    role localized_response_template
    precondition "a weekday-offset request backward in time is answered with a non-whole-week day count"
    effect "the resulting weekday is stated with the week-plus-day split of the offset"
    unit "not applicable"
    example "100 days before Monday is Saturday. 100 days = 14 weeks + 2 days."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_offset_exact_next
    defined-by answer
    role localized_response_template
    precondition "a forward weekday-offset request is answered with a whole number of weeks"
    effect "the unchanged weekday is stated with the exact week-to-day equivalence"
    unit "not applicable"
    example "14 weeks after Tuesday is Tuesday. 14 weeks = 98 days exactly."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_offset_exact_previous
    defined-by answer
    role localized_response_template
    precondition "a backward weekday-offset request is answered with a whole number of weeks"
    effect "the unchanged weekday is stated with the exact week-to-day equivalence"
    unit "not applicable"
    example "14 weeks before Tuesday is Tuesday. 14 weeks = 98 days exactly."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_offset_exact_one_next
    defined-by answer
    role localized_response_template
    precondition "a one-week forward weekday-offset request is answered"
    effect "the unchanged weekday is stated with the single-week day equivalence"
    unit "not applicable"
    example "1 week after Friday is Friday. 1 week = 7 days exactly."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_offset_exact_one_previous
    defined-by answer
    role localized_response_template
    precondition "a one-week backward weekday-offset request is answered"
    effect "the unchanged weekday is stated with the single-week day equivalence"
    unit "not applicable"
    example "1 week before Friday is Friday. 1 week = 7 days exactly."
    grounding "data/seed/multilingual-responses-quantities.lino"
  statistics_percentile_derivation
    defined-by answer
    role localized_response_template
    precondition "a percentile of an explicit numeric dataset is computed by linear interpolation between closest ranks"
    effect "the rank 1 + (n - 1) x p / 100 and the interpolation between the two neighbouring sorted values are stated"
    unit "not applicable"
    example "p = 90; rank = 1 + (5 - 1) x 90 / 100 = 4.6; 4 + 0.6 x (5 - 4) = 4.6"
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_month_offset_next
    defined-by answer
    role localized_response_template
    precondition "a month-offset request forward in time from a named month is answered"
    effect "the resulting month is stated with its modulo-12 month-number arithmetic"
    unit "not applicable"
    example "2 months after January is March. January is month 1; 1 + 2 = 3, and 3 is March mod 12."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_month_offset_previous
    defined-by answer
    role localized_response_template
    precondition "a month-offset request backward in time from a named month is answered"
    effect "the resulting month is stated with its modulo-12 month-number arithmetic"
    unit "not applicable"
    example "3 months before February is November. February is month 2; 2 - 3 = -1, and -1 is 11 mod 12."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_month_offset_unresolved_next
    defined-by answer
    role localized_response_template
    precondition "a forward month offset from a weekday is asked, which no fixed day count represents"
    effect "the request is answered with a clarification naming the day span the months can cover and asking for a starting date"
    unit "not applicable"
    example "3 months after Monday has no single weekday answer, because 3 months span 89 to 92 days."
    grounding "data/seed/multilingual-responses-quantities.lino"
  calendar_weekday_month_offset_unresolved_previous
    defined-by answer
    role localized_response_template
    precondition "a backward month offset from a weekday is asked, which no fixed day count represents"
    effect "the request is answered with a clarification naming the day span the months can cover and asking for a starting date"
    unit "not applicable"
    example "3 months before Monday has no single weekday answer, because 3 months span 89 to 92 days."
    grounding "data/seed/multilingual-responses-quantities.lino"
  brainstorming_candidates
    defined-by answer
    role localized_response_template
    precondition "a brainstorming request yields topic words from which candidates were composed"
    effect "the composed name candidates are listed with the stated ranking metric, constraints, and composition rules"
    unit "not applicable"
    example "5 name candidates for the concepts coffee, university: ..."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  brainstorming_refusal
    defined-by answer
    role localized_response_template
    precondition "a brainstorming request leaves no topic words after extraction"
    effect "the request is declined without guessing and the user is asked to name the subject"
    unit "not applicable"
    example "This reads as a brainstorming request, but no topic words survived extraction, so I will not guess."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  creative_writing_poem
    defined-by answer
    role localized_response_template
    precondition "a rhymed poem was composed and passed its line-count, rhyme-scheme, and topic checks"
    effect "the poem is returned with the constraint check that was run on it and the method that composed it"
    unit "not applicable"
    example "a four-line poem about the sea followed by its line, rhyme, and topic checks"
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  creative_writing_unrhymed
    defined-by answer
    role localized_response_template
    precondition "a poem was requested with no rhyme scheme and passed its line-count and topic checks"
    effect "the poem is returned with its constraint check and no rhyme claim"
    unit "not applicable"
    example "an unrhymed three-line poem about autumn with its line and topic checks"
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  creative_writing_gap
    defined-by answer
    role localized_response_template
    precondition "a rhymed poem was requested but the rhyme lexicon could not fill the scheme"
    effect "free verse meeting the other constraints is returned with the rhyme gap stated"
    unit "not applicable"
    example "a free-verse poem with a note that the requested rhyme scheme could not be filled"
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  creative_writing_refusal
    defined-by answer
    role localized_response_template
    precondition "no composition satisfied the stated form constraints"
    effect "no constraint-violating poem is returned and the user is asked to relax a constraint"
    unit "not applicable"
    example "I could not satisfy the stated form constraints (lines: 14, scheme: ABAB, topic: sleep)."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  planning_itinerary
    defined-by answer
    role localized_response_template
    precondition "a trip-planning request names a cached destination and the schedule passed its feasibility check"
    effect "a day-by-day itinerary is returned with each item citing the fact it depends on"
    unit "not applicable"
    example "2-day itinerary for Rome: ..."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  planning_refusal
    defined-by answer
    role localized_response_template
    precondition "a trip-planning request names a destination with no places in the seeded cache"
    effect "no uncited plan is returned and the cached destinations are listed"
    unit "not applicable"
    example "This reads as a planning request, but the destination has no places in the seeded cache."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  planning_infeasible
    defined-by answer
    role localized_response_template
    precondition "a composed schedule failed its own feasibility check"
    effect "the failing schedule is withheld and the failed checks are reported"
    unit "not applicable"
    example "The 5-day schedule for Rome did not pass its own feasibility check."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  advice_guidance
    defined-by answer
    role localized_response_template
    precondition "an advice request names a topic with formalized recommendations in the seeded table"
    effect "evidence-graded recommendations are listed with their citations and stated weighting"
    unit "not applicable"
    example "Evidence-graded guidance for sleep: ..."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  advice_refusal
    defined-by answer
    role localized_response_template
    precondition "an advice request names a topic with no formalized recommendations"
    effect "no uncited advice is returned and the covered topics are named"
    unit "not applicable"
    example "This reads as an advice request, but the topic has no formalized recommendations in the seeded table."
    grounding "data/seed/multilingual-responses-creative-tasks.lino"
  formalization_result
    defined-by answer
    role localized_response_template
    precondition "a natural-language statement was parsed into a quantified formula"
    effect "the rendered formal statement is returned with its honesty note and derivation"
    unit "not applicable"
    example "Formalized statement: forall x (human(x) -> mortal(x))"
    grounding "data/seed/multilingual-responses-formalization.lino"
  formalization_unparsed
    defined-by answer
    role localized_response_template
    precondition "a formalization request contained no parseable quantified clause"
    effect "the parse failure reason is stated with what a formalizable sentence needs"
    unit "not applicable"
    example "no quantified clause could be parsed from it: no quantifier word found."
    grounding "data/seed/multilingual-responses-formalization.lino"
  formalization_deformalized
    defined-by answer
    role localized_response_template
    precondition "a formal statement was read back into natural language"
    effect "the natural-language reading is returned with its round-trip result and honesty note"
    unit "not applicable"
    example "Natural-language reading: every human is mortal."
    grounding "data/seed/multilingual-responses-formalization.lino"
  formalization_honesty
    defined-by answer
    role localized_response_template
    precondition "a formalization or deformalization answer is rendered"
    effect "the answer states that no theorem prover was invoked and what the Lean and Rocq texts are"
    unit "not applicable"
    example "No theorem prover was invoked."
    grounding "data/seed/multilingual-responses-formalization.lino"
  legality_warn
    defined-by answer
    role localized_response_template
    precondition "a request matched a warn-disposition pattern of the seeded legality catalogue"
    effect "an advisory caution names the matched category, its jurisdiction note, and leaves the decision to the user"
    unit "not applicable"
    example "A caution before I continue: this request appears to touch copyright."
    grounding "data/seed/multilingual-responses-legality.lino"
  legality_refuse
    defined-by answer
    role localized_response_template
    precondition "a request matched a refuse-disposition pattern of the narrow prohibited set"
    effect "the request is declined with the matched category and reason, stating it is not legal advice"
    unit "not applicable"
    example "I will not help with this: it falls under a category the seeded catalogue refuses without exception."
    grounding "data/seed/multilingual-responses-legality.lino"
  repair_ladder_exhausted
    defined-by answer
    role localized_response_template
    precondition "the error-driven repair loop reached its rung bound without resolving the failure"
    effect "the loop stops and reports the rungs climbed instead of retrying without a bound"
    unit "not applicable"
    example "The error-driven repair loop climbed rung 3 of at most 3 without resolving the failure."
    grounding "data/seed/multilingual-responses-repair.lino"
  repair_unresolved_need
    defined-by answer
    role localized_response_template
    precondition "the diagnostic search found no fetched source addressing the exact error"
    effect "no candidate fix is retained and the gap is reported as an unresolved need"
    unit "not applicable"
    example "The diagnostic search found no fetched source that addresses this exact error."
    grounding "data/seed/multilingual-responses-repair.lino"
  product_search_result
    defined-by answer
    role localized_response_template
    precondition "a product-search request named a product and a marketplace"
    effect "the composed site-scoped search link is returned with the constraints and buying advice, stated as not fetched"
    unit "not applicable"
    example "Here is the search I composed for a laptop charger on the named marketplace."
    grounding "data/seed/multilingual-responses-product-search.lino"
  triz_resolution_map
    defined-by answer
    role localized_response_template
    precondition "a contradiction or paradox request was recognized by the TRIZ cues"
    effect "the resolution families and benchmark precedents are listed with the link-value note"
    unit "not applicable"
    example "A contradiction is a link with a value, not a wall. Ways through: ..."
    grounding "data/seed/multilingual-responses-triz.lino"
  product_search
    defined-by method
    role action
    precondition "a request asks to find or choose a product to buy"
    effect "routes the request to the product-search handler that composes a site-scoped search"
    unit "not applicable"
    example "find me a laptop charger on the marketplace"
    grounding "data/seed/product-search-cues.lino"
  triz_resolution
    defined-by method
    role action
    precondition "a request states a contradiction, paradox, or trade-off to resolve"
    effect "routes the request to the TRIZ solver that maps it to resolution families"
    unit "not applicable"
    example "how do I resolve the trade-off between strength and weight"
    grounding "data/seed/triz-principles.lino"
