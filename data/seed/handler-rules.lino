handler-rules
  issue 1085
  purpose "Specialized handlers expressed as links: conditions over seed roles and prompt shape, logged steps, and a seeded multilingual response. src/rule_interpreter.rs walks each rule; specialized_handlers() resolves a precedence name to a handler block here when no native function claims it. A policy block holds a value a native handler reads instead of a constant of its own (issue #918); a table block holds the ordered rows a rule value reads by containment or by key (issue #918, the algorithm rule set)."
  handler conversation_control
    rule conversation_preference
      when
        role conversation_preference_avoid forms of cleaned
      value term backticks
      log "conversation_preference:avoid_term" $term
      respond conversation_preference
        fallback exact
      link "response:conversation_preference"
      confidence 1.0
    rule action_correction
      when
        role unauthorized_mutation_correction forms of cleaned
        prior_turn assistant
      log "action_correction:unauthorized_mutation" $prompt
      respond action_correction
      link "response:action_correction"
      confidence 1.0
    rule action-correction-without-action
      when
        role unauthorized_mutation_correction forms of cleaned
      log "action_correction:unauthorized_mutation" $prompt
      log "conversation_control:refusal" "no earlier action"
      respond action_correction
      intent action_correction
      link "response:action_correction"
      confidence 1.0
  handler github_repository_traffic
    rule github_repository_traffic
      when
        role github_repository_platform languages
        role repository_reference languages
        role github_repository_traffic_signal languages
        role github_repository_traffic_question languages
        evidence named_repository
      value repository operand named_repository
      value traffic-ui-docs literal "https://docs.github.com/en/repositories/viewing-activity-and-data-for-your-repository/viewing-traffic-to-a-repository"
      value traffic-api-docs literal "https://docs.github.com/en/rest/metrics/traffic"
      log "github_repository_traffic:platform" github
      log "github_repository_traffic:repository" $repository
      log "github_repository_traffic:access" push-or-write-access-required
      log "github_repository_traffic:window" last-14-days
      log "github_repository_traffic:aggregate" views-uniques-clones-referrers-paths
      log "github_repository_traffic:privacy" no-individual-identity
      log source $traffic-ui-docs
      log source $traffic-api-docs
      respond github_repository_traffic
      link "response:github_repository_traffic"
      confidence 0.92
    rule github_repository_traffic_unnamed
      when
        role github_repository_platform languages
        role repository_reference languages
        role github_repository_traffic_signal languages
        role github_repository_traffic_question languages
      value traffic-ui-docs literal "https://docs.github.com/en/repositories/viewing-activity-and-data-for-your-repository/viewing-traffic-to-a-repository"
      value traffic-api-docs literal "https://docs.github.com/en/rest/metrics/traffic"
      log "github_repository_traffic:platform" github
      log "github_repository_traffic:access" push-or-write-access-required
      log "github_repository_traffic:window" last-14-days
      log "github_repository_traffic:aggregate" views-uniques-clones-referrers-paths
      log "github_repository_traffic:privacy" no-individual-identity
      log source $traffic-ui-docs
      log source $traffic-api-docs
      log "github_repository_traffic:refusal" "no repository named"
      respond github_repository_traffic_unnamed
      intent github_repository_traffic
      link "response:github_repository_traffic"
      confidence 0.92
  handler requirement_listing
    rule requirement_listing
      when
        role requirement_listing_action of command_head
      value requirements transform requirement_list
      log "text_transform" requirement_list
      respond requirement_listing
      intent requirement_listing
      link "response:requirement_listing"
      confidence 0.9
  handler docs_method_explanation
    rule docs_method_explanation
      when
        none
          all
            role-prefix web_search_imperative_lead of trimmed
            role-padded web_medium of trimmed
        role-lead explanation_request_lead of trimmed
        evidence documented_method
      value method operand documented_method
      value project operand documented_method 1
      value docs_url operand documented_method 2
      log "docs_method:request" $prompt
      log "docs_method:project" $project
      log "docs_method:method" $method
      log "docs_method:source_kind" official-docs
      log "docs_method:source" $docs_url
      respond docs_method_explanation
      link "response:docs_method_explanation"
      confidence 0.92
  handler capabilities
    rule capabilities-more-after-search
      when
        role capability_query_more of cleaned
        none
          route-exact assistant_free_time
        history-role web_search_history_signal
      log "capabilities:history" prior-web-search
      respond capabilities_more
      intent capabilities
      link "response:capabilities"
      confidence 1.0
    rule capabilities_more
      when
        role capability_query_more of cleaned
        none
          route-exact assistant_free_time
      respond capabilities_more
      intent capabilities
      link "response:capabilities"
      confidence 1.0
    rule capabilities
      when
        role capability_query of cleaned
        none
          route-exact assistant_free_time
      respond capabilities
      intent capabilities
      link "response:capabilities"
      confidence 1.0
  handler clarification
    rule clarification
      when
        role clarification_request of cleaned
        prior_turn assistant
      respond clarification
      link "response:clarification"
      confidence 0.9
    rule clarification-inflected-stem
      when
        role clarification_request raw
        prior_turn assistant
      respond clarification
      intent clarification
      link "response:clarification"
      confidence 0.9
    rule clarification-without-reply
      when
        any
          role clarification_request of cleaned
          role clarification_request raw
      log "clarification:refusal" "no earlier reply"
      respond clarification
      intent clarification
      link "response:clarification"
      confidence 0.9
  handler punctuation_only_prompt
    rule punctuation_only_prompt
      when
        only-characters ".?!…。？！"
      value prompt trimmed-prompt
      log "clarification:punctuation_only" $trimmed
      respond punctuation_only
      intent clarification
      link "response:clarification"
      confidence 0.8
  handler ill_formed
    rule ill_formed
      when
        substring "teach this fact"
        unbalanced-parentheses
      log error "unbalanced links notation"
      respond-unknown
      intent unknown
      link "response:unknown"
      confidence 0.0
  handler physical_action_question
    rule physical_action_question
      when
        role physical_action_trigger raw
      respond physical_action_question
        fallback ru
      link "response:physical_action_question"
      confidence 1.0
  handler kupi_slona
    rule kupi_slona
      when
        evidence idiom_utterance
      value phrase operand idiom_utterance
      log "kupi_slona:idiom" $phrase
      respond kupi_slona
        fallback ru
      link "response:kupi_slona"
      confidence 1.0
  handler shell_refusal
    rule shell_refusal
      when
        none
          substring "[agent]"
          substring "agent mode"
        any
          substring "run `"
          substring "execute `"
        any
          substring "rm "
          substring sudo
          substring "on my behalf"
      log "policy:chat_bounded_autonomy" $prompt
      respond policy_bounded_autonomy
      intent policy_bounded_autonomy
      link "response:policy:bounded_autonomy"
      confidence 0.5
  handler opinion_question
    rule opinion_question
      when
        any
          prefix "do you think"
          prefix "what do you think"
          prefix "what is your opinion"
          prefix "what's your opinion"
          prefix "in your opinion"
          prefix "do you believe"
          prefix "what do you believe"
          prefix "do you feel"
          prefix "what do you feel"
          prefix "would you say"
          prefix "how do you feel"
          prefix "give me your opinion"
          prefix "share your opinion"
          prefix "share your thoughts"
          prefix "what are your thoughts"
          prefix "как ты думаешь"
          prefix "что ты думаешь"
          prefix "каково твоё мнение"
          prefix "каково твое мнение"
          prefix "你认为"
          prefix "你觉得"
      log "policy:no_opinion" $prompt
      respond opinion_question
      link "response:opinion_question"
      confidence 1.0
  handler agentic_continuation
    rule continuation_cue
      when
        role agentic_continuation_cue whole of cleaned
        prior_turn assistant
      log "agentic_continuation:cue" $prompt
      respond agentic_continuation
      link "response:agentic_continuation"
      confidence 1.0
    rule continuation-cue-without-task
      when
        role agentic_continuation_cue whole of cleaned
      log "agentic_continuation:cue" $prompt
      log "agentic_continuation:refusal" "nothing to resume"
      respond agentic_continuation
      intent continuation_cue
      link "response:agentic_continuation"
      confidence 1.0
  handler conversation_topic
    rule conversation_topic
      when
      value topic role_slot conversation_topic_opener
      log conversation_topic $topic
      respond conversation_topic
      link "response:conversation_topic"
      confidence 0.75
  handler source_refresh
    rule source_refresh
      when
        substring refresh
        any
          substring cache
          substring page
        evidence source_reference
      value target stable_id source
      log source_refresh $target
      respond source_refresh
      link "response:source_refresh"
      confidence 1.0
    rule source-refresh-unnamed
      when
        substring refresh
        any
          substring cache
          substring page
      value target stable_id source
      log source_refresh $target
      log "source_refresh:refusal" "no source named"
      respond source_refresh
      intent source_refresh
      link "response:source_refresh"
      confidence 1.0
  handler source_conflict
    rule source_conflict
      when
        role source_conflict_cue raw of lowercase
        evidence attributed_alternatives
      value first operand attributed_alternatives
      value second operand attributed_alternatives 1
      log "conflict:source_disagreement" "sources disagree on the answer"
      log "conflict:alternative" $first
      log "conflict:alternative" $second
      respond source_conflict
      link "response:source_conflict"
      confidence 0.6
    rule source_conflict_unattributed
      when
        any
          all
            role information_source_noun raw of lowercase
            role source_conflict_cue raw of lowercase
          all
            substring "born in"
            substring " or "
      log "source_conflict:refusal" "no attributed alternatives"
      respond source_conflict_unattributed
      intent source_conflict
      link "response:source_conflict"
      confidence 0.3
  handler execution_failure
    rule execution-failure-agent
      when
        evidence undefined_call
        substring "[agent]"
      value function operand undefined_call
      log "trace:execution_failure" $function
      log "agent_mode:opted_in" $prompt
      log "action_log" $prompt
      respond execution_failure
      intent execution_failure
      link "response:execution_failure"
      confidence 0.4
    rule execution_failure
      when
        evidence undefined_call
      value function operand undefined_call
      log "trace:execution_failure" $function
      respond execution_failure
      link "response:execution_failure"
      confidence 0.4
  handler network_query
    rule network_snapshot
      when
        any
          substring "show me the current network"
          substring "show me the network"
          substring "export the network"
          substring "export network"
      value snapshot network_snapshot
      respond network_snapshot
      link "response:network_snapshot"
      confidence 1.0
    rule concept_introspection
      when
        any
          substring "what do you know about" of lowercase
          substring "introspect" of lowercase
      value concept quoted
      respond concept_introspection
      intent "concept_introspection_{concept}"
      link "response:concept_introspection"
      confidence 1.0
    rule filter_user
      when
        any
          prefix "list facts"
          role personal_facts_listing_request of cleaned
      log "filter:user" "self"
      respond filter_user
      link "response:filter_user"
      confidence 1.0
  handler algorithm
    rule algorithm_sort_with_tests
      when
        operation sort of cleaned
        substring test
      value language table algorithm_language of normalized
      value snippet table algorithm_snippet key language
      value code response "algorithm_sort_code_{snippet}"
      value tests response "algorithm_sort_tests_{snippet}"
      log "execution_status" "unavailable"
      log "execution_environment" "no compile/run sandbox configured for this generated snippet"
      respond algorithm_sort_with_tests
      intent "algorithm_sort_{language}"
      link "response:algorithm"
      confidence 1.0
    rule algorithm_sort
      when
        operation sort of cleaned
      value language table algorithm_language of normalized
      value snippet table algorithm_snippet key language
      value code response "algorithm_sort_code_{snippet}"
      log "execution_status" "unavailable"
      log "execution_environment" "no compile/run sandbox configured for this generated snippet"
      respond algorithm_sort
      intent "algorithm_sort_{language}"
      link "response:algorithm"
      confidence 1.0
    rule algorithm-unnamed-with-tests
      when
        substring algorithm
        substring test
      value language table algorithm_language of normalized
      value snippet table algorithm_snippet key language
      value code response "algorithm_sort_code_{snippet}"
      value tests response "algorithm_sort_tests_{snippet}"
      log "algorithm:refusal" "no operation named"
      log "execution_status" "unavailable"
      log "execution_environment" "no compile/run sandbox configured for this generated snippet"
      respond algorithm_sort_with_tests
      intent "algorithm_sort_{language}"
      link "response:algorithm"
      confidence 1.0
    rule algorithm-unnamed
      when
        substring algorithm
      value language table algorithm_language of normalized
      value snippet table algorithm_snippet key language
      value code response "algorithm_sort_code_{snippet}"
      log "algorithm:refusal" "no operation named"
      log "execution_status" "unavailable"
      log "execution_environment" "no compile/run sandbox configured for this generated snippet"
      respond algorithm_sort
      intent "algorithm_sort_{language}"
      link "response:algorithm"
      confidence 1.0
