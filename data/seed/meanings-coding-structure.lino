  print_stdout
    defined-by output
    role coding_structure
    role output_display_request
    idiom "print({value})"
    fragment_signature "unknown:0"
    fragment_result "unknown:0"
    grounding "https://docs.python.org/3.12/library/functions.html#print"
    lexeme en print prints "print …" "prints …"
    lexeme ru выводит "выводит …" печатает "печатает …"
    lexeme hi प्रिंट "जो … प्रिंट करता है"
    lexeme zh 打印 "打印 … 的"
    lexeme es imprime "imprime …"
    bootstrap true
    rediscovery_query "print a value to standard output"
