  statement_time_preposition
    defined-by time
    defined-by concept
    role statement_time_preposition
    precondition "a sentence of a prompt-supplied text carries a phrase this word opens"
    effect "the phrase is a candidate time slot of the sentence's statement"
    unit "a phrase whose words name a weekday, month, hour or clock suffix is a time"
    example "from Tuesday"
    lexeme en "from" "to" "until" "till" "since" "during" "before" "after"
    lexeme ru "с" "со" "до" "после" "к" "ко"
    lexeme es "desde" "hasta" "durante" "tras"
    lexeme hi "से" "तक" "दौरान" "पहले" "बाद"
    lexeme zh "直到" "自从" "期间" "之前" "之后"
  statement_place_preposition
    defined-by concept
    role statement_place_preposition
    precondition "a sentence of a prompt-supplied text carries a phrase this word opens"
    effect "the phrase is the place slot of the statement unless its words name a time"
    unit "not applicable"
    example "in room 204"
    lexeme en "in" "at" "on" "near" "inside" "outside" "behind" "under" "above" "beside"
    lexeme ru "в" "во" "на" "у" "около" "возле" "под" "над" "за"
    lexeme es "en" "junto" "cerca" "sobre" "bajo" "detrás"
    lexeme hi "में" "पर" "पास" "अंदर" "बाहर" "पीछे" "नीचे" "ऊपर"
    lexeme zh "附近" "后面" "下面" "里面" "上面"
  statement_clock_suffix
    defined-by time
    defined-by calendar_day
    role statement_clock_suffix
    precondition "a phrase of a sentence carries a clock reading"
    effect "the phrase is read as a time slot"
    unit "hour of the day"
    example "at 3 pm"
    lexeme en "am" "pm" "o'clock"
    lexeme ru "утра" "дня" "вечера" "ночи"
    lexeme hi "बजे"
    lexeme es "am" "pm"
    lexeme zh "上午" "下午" "点钟"
