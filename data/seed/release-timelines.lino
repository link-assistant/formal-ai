release_timelines
  query "SELECT ?subject ?film (MIN(?date) AS ?firstRelease) (SAMPLE(COALESCE(?english, ?default)) AS ?title) (SAMPLE(?localized) AS ?localTitle) WHERE { BIND(wd:{subject} AS ?subject) { SELECT DISTINCT ?film WHERE { { wd:{subject} wdt:P527 ?film } UNION { { VALUES ?series { wd:{subject} } } UNION { wd:{subject} wdt:P527 ?series } ?film wdt:P179 ?series . } ?film wdt:P31/wdt:P279* wd:Q11424 ; wdt:P750 ?distributor . FILTER NOT EXISTS { ?film wdt:P449 ?broadcaster } FILTER NOT EXISTS { ?film wdt:P31/wdt:P279* wd:Q24862 } FILTER NOT EXISTS { ?film wdt:P31/wdt:P279* wd:Q914242 } } LIMIT 101 } OPTIONAL { ?film wdt:P577 ?date } OPTIONAL { ?film rdfs:label ?english FILTER(LANG(?english) = 'en') } OPTIONAL { ?film rdfs:label ?default FILTER(LANG(?default) = 'mul') } OPTIONAL { ?film rdfs:label ?localized FILTER(LANG(?localized) = '{language}') } } GROUP BY ?subject ?film ORDER BY ?firstRelease ?film"
  # `Answer wording for every timeline, one block per supported language. The`
  # `placeholders are filled by the renderer: {subject}, {position}, {title},`
  # `{year}, {date}, {source}, {retrieved}.`
  phrasing en
    released-heading "Released {subject} in release order:"
    released-item "{position}. {title} ({year})"
    announced-heading "Announced but not yet released:"
    announced-item "{title} ({date})"
    undated-item "{title} (no announced date)"
    item-separator "; "
    section-end "."
    provenance-note "Source: {source}, snapshot taken {retrieved}."
    stale-note "Source: {source}, snapshot taken {retrieved}; titles released after that date may be missing."
  phrasing ru
    released-heading "Вышедшие {subject} в порядке выхода:"
    released-item "{position}. {title} ({year})"
    announced-heading "Анонсированы, но ещё не вышли:"
    announced-item "{title} ({date})"
    undated-item "{title} (дата выхода не объявлена)"
    item-separator "; "
    section-end "."
    provenance-note "Источник: {source}, снимок данных от {retrieved}."
    stale-note "Источник: {source}, снимок данных от {retrieved}; фильмы, вышедшие после этой даты, могут отсутствовать."
  phrasing hi
    released-heading "{subject} रिलीज़ क्रम में:"
    released-item "{position}. {title} ({year})"
    announced-heading "घोषित, लेकिन अभी रिलीज़ नहीं हुईं:"
    announced-item "{title} ({date})"
    undated-item "{title} (रिलीज़ तिथि घोषित नहीं)"
    item-separator "; "
    section-end "।"
    provenance-note "स्रोत: {source}, {retrieved} का स्नैपशॉट।"
    stale-note "स्रोत: {source}, {retrieved} का स्नैपशॉट; उसके बाद रिलीज़ हुई फ़िल्में इसमें नहीं हो सकतीं।"
  phrasing zh
    released-heading "已上映的{subject}，按上映顺序："
    released-item "{position}. {title} ({year})"
    announced-heading "已公布但尚未上映："
    announced-item "{title} ({date})"
    undated-item "{title} (尚未公布上映日期)"
    item-separator "; "
    section-end "。"
    provenance-note "来源: {source}, 快照日期 {retrieved}。"
    stale-note "来源: {source}, 快照日期 {retrieved}; 该日期之后上映的影片可能缺失。"
  phrasing es
    released-heading "{subject} estrenadas, en orden de estreno:"
    released-item "{position}. {title} ({year})"
    announced-heading "Anunciadas pero aún no estrenadas:"
    announced-item "{title} ({date})"
    undated-item "{title} (sin fecha de estreno anunciada)"
    item-separator "; "
    section-end "."
    provenance-note "Fuente: {source}, instantánea tomada el {retrieved}."
    stale-note "Fuente: {source}, instantánea tomada el {retrieved}; pueden faltar las estrenadas después de esa fecha."
  open-series
    source-label "Wikidata Query Service"
    source-url "https://query-main.wikidata.org/sparql"
    fresh-for-days 180
    request en
      frame "list {subject} films in release order"
      frame "list {subject} movies in release order"
      frame "{subject} films in release order"
      frame "{subject} movies in release order"
      search "{subject} film series"
      subject "{subject} films"
    request ru
      frame "перечисли фильмы про {subject} в порядке выхода"
      frame "назови фильмы о {subject} по порядку выхода"
      frame "фильмы {subject} в порядке выхода"
      search "{subject} серия фильмов"
      subject "фильмы {subject}"
    request hi
      frame "{subject} की फिल्में रिलीज़ क्रम में बताओ"
      frame "{subject} की फ़िल्में रिलीज़ क्रम में"
      search "{subject} फिल्म श्रृंखला"
      subject "{subject} की फ़िल्में"
    request zh
      frame "按上映顺序列出{subject}电影"
      frame "{subject}电影上映顺序"
      search "{subject}电影系列"
      subject "{subject}电影"
    request es
      frame "lista las películas de {subject} en orden de estreno"
      frame "películas de {subject} en orden de estreno"
      search "{subject} saga cinematográfica"
      subject "películas de {subject}"
  timeline spider_man_title_role_films
    subject-qid Q2307877
    source-label "Wikidata Query Service"
    source-url "https://query-main.wikidata.org/sparql"
    fresh-for-days 180
    localized en
      subject "title-role Spider-Man films"
    localized ru
      subject "фильмы, где Человек-паук — главный герой"
    localized hi
      subject "मुख्य भूमिका वाली स्पाइडर-मैन फ़िल्में"
    localized zh
      subject "以蜘蛛人为主角的电影"
    localized es
      subject "películas protagonizadas por Spider-Man"
