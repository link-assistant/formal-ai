release_timelines
  # `Answer wording for every timeline, one block per supported language. The`
  # `placeholders are filled by the renderer: {subject}, {position}, {title},`
  # `{year}, {date}, {source}, {retrieved}.`
  phrasing en
    released-heading "Released {subject} in release order:"
    released-item "{position}. {title} ({year})"
    announced-heading "Announced but not yet released:"
    announced-item "{title} ({date})"
    undated-item "{title} (no announced date)"
    item-separator "; "
    section-end "."
    provenance-note "Source: {source}, snapshot taken {retrieved}."
    stale-note "Source: {source}, snapshot taken {retrieved}; titles released after that date may be missing."
  phrasing ru
    released-heading "Вышедшие {subject} в порядке выхода:"
    released-item "{position}. {title} ({year})"
    announced-heading "Анонсированы, но ещё не вышли:"
    announced-item "{title} ({date})"
    undated-item "{title} (дата выхода не объявлена)"
    item-separator "; "
    section-end "."
    provenance-note "Источник: {source}, снимок данных от {retrieved}."
    stale-note "Источник: {source}, снимок данных от {retrieved}; фильмы, вышедшие после этой даты, могут отсутствовать."
  phrasing hi
    released-heading "{subject} रिलीज़ क्रम में:"
    released-item "{position}. {title} ({year})"
    announced-heading "घोषित, लेकिन अभी रिलीज़ नहीं हुईं:"
    announced-item "{title} ({date})"
    undated-item "{title} (रिलीज़ तिथि घोषित नहीं)"
    item-separator "; "
    section-end "।"
    provenance-note "स्रोत: {source}, {retrieved} का स्नैपशॉट।"
    stale-note "स्रोत: {source}, {retrieved} का स्नैपशॉट; उसके बाद रिलीज़ हुई फ़िल्में इसमें नहीं हो सकतीं।"
  phrasing zh
    released-heading "已上映的{subject}，按上映顺序："
    released-item "{position}. {title} ({year})"
    announced-heading "已公布但尚未上映："
    announced-item "{title} ({date})"
    undated-item "{title} (尚未公布上映日期)"
    item-separator "; "
    section-end "。"
    provenance-note "来源: {source}, 快照日期 {retrieved}。"
    stale-note "来源: {source}, 快照日期 {retrieved}; 该日期之后上映的影片可能缺失。"
  phrasing es
    released-heading "{subject} estrenadas, en orden de estreno:"
    released-item "{position}. {title} ({year})"
    announced-heading "Anunciadas pero aún no estrenadas:"
    announced-item "{title} ({date})"
    undated-item "{title} (sin fecha de estreno anunciada)"
    item-separator "; "
    section-end "."
    provenance-note "Fuente: {source}, instantánea tomada el {retrieved}."
    stale-note "Fuente: {source}, instantánea tomada el {retrieved}; pueden faltar las estrenadas después de esa fecha."
