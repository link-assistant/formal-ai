meanings
  web_fetch
    defined-by method
    role action
    precondition "a request names a concrete web resource to retrieve"
    effect "fetches the named page and grounds the answer in what it returns"
    unit "not applicable"
    example "read the page at the named url and answer from it"
    grounding "data/seed/capability-routing.lino"
  read_file
    defined-by method
    role action
    precondition "a request names a workspace path to read"
    effect "returns the file content at the named path"
    unit "not applicable"
    example "open the named source file and quote the matched line"
    grounding "data/seed/capability-routing.lino"
  write_file
    defined-by method
    role action
    precondition "explicit content is to land at a named workspace path"
    effect "writes the given content to the named path"
    unit "not applicable"
    example "save the drafted note at the named path"
    grounding "data/seed/capability-routing.lino"
  list_dir
    defined-by method
    role action
    precondition "a request asks what a folder holds"
    effect "enumerates the entries of the named directory"
    unit "not applicable"
    example "show the files inside the named folder"
    grounding "data/seed/capability-routing.lino"
  grep
    defined-by method
    role action
    precondition "a symbol or text is searched for across workspace files"
    effect "returns the matching lines with their file locations"
    unit "not applicable"
    example "find where the named function is defined"
    grounding "data/seed/capability-routing.lino"
  calendar_create_event
    defined-by method
    role action
    precondition "an event is placed at a named time"
    effect "records the event on the calendar at that time"
    unit "not applicable"
    example "schedule the meeting at the named hour"
    grounding "data/seed/capability-routing.lino"
  concept_measurement_lookup
    defined-by method
    role action
    precondition "a magnitude question names a concept with a measured property"
    effect "answers with the measured value and its unit"
    unit "measured quantity"
    example "how tall does the named animal grow"
    grounding "data/seed/capability-routing.lino"
  compose_from_sources
    defined-by method
    role action
    precondition "an extended written piece is requested and retrievable sources exist"
    effect "composes the piece from the retrieved sources with citations"
    unit "not applicable"
    example "write the survey from the gathered references"
    grounding "data/seed/capability-routing.lino"
  explain_previous_turn
    defined-by method
    role action
    precondition "the user asks about the assistant preceding answer"
    effect "re-renders the previous turn instead of searching elsewhere"
    unit "not applicable"
    example "explain what you just said in another way"
    grounding "data/seed/capability-routing.lino"
  report_issue
    defined-by method
    role action
    precondition "a defect is named on the assistant own surface"
    effect "records the defect as an issue instead of explaining it away"
    unit "not applicable"
    example "file the bug about the broken reply rendering"
    grounding "data/seed/capability-routing.lino"
  todo
    defined-by method
    role action
    precondition "work is named as a list of tasks to track"
    effect "tracks the tasks as a plan with per-item state"
    unit "not applicable"
    example "keep the drafted plan of work as tracked tasks"
    grounding "data/seed/capability-routing.lino"
  glob
    defined-by method
    role action
    precondition "a wildcard names a set of paths to match"
    effect "returns the workspace paths the pattern matches"
    unit "not applicable"
    example "list the test files matching the starred suffix"
    grounding "data/seed/capability-routing.lino"
  read_many
    defined-by method
    role action
    precondition "a batch of named files is requested together"
    effect "reads every named file in one step"
    unit "not applicable"
    example "open all the named modules at once"
    grounding "data/seed/capability-routing.lino"
  multi_edit
    defined-by method
    role action
    precondition "the same edit is asked across named files"
    effect "applies the edit to every named file"
    unit "not applicable"
    example "rename the symbol across the named files"
    grounding "data/seed/capability-routing.lino"
  subagent
    defined-by method
    role action
    precondition "work is handed to another agent"
    effect "delegates the task and returns its result"
    unit "not applicable"
    example "let another agent run the search and report back"
    grounding "data/seed/capability-routing.lino"
  bare_term
    defined-by concept
    role action
    precondition "a request names a term with no local path, url or quoted scope"
    effect "classifies the object as an unscoped term for routing"
    unit "not applicable"
    example "the request names a library with no file or page"
    grounding "data/seed/capability-routing.lino"
  path_scope
    defined-by concept
    role action
    precondition "a request names a folder to operate within"
    effect "classifies the object as a directory scope for routing"
    unit "not applicable"
    example "everything under the named folder"
    grounding "data/seed/capability-routing.lino"
  quoted_content
    defined-by concept
    role action
    precondition "explicit text is present in the request itself"
    effect "classifies the object as in-request content for routing"
    unit "not applicable"
    example "the request carries the note text in quotes"
    grounding "data/seed/capability-routing.lino"
  time_expression
    defined-by concept
    role action
    precondition "the request names a clock or period reference"
    effect "classifies the object as a time expression for routing"
    unit "not applicable"
    example "the request names the last few hours"
    grounding "data/seed/capability-routing.lino"
  language_name
    defined-by concept
    role action
    precondition "the request names a natural language"
    effect "classifies the object as a language for routing"
    unit "not applicable"
    example "the request names spanish as the reply language"
    grounding "data/seed/capability-routing.lino"
  quantity_question
    defined-by concept
    role action
    precondition "the request asks how much or how many of a property"
    effect "classifies the object as a magnitude interrogative for routing"
    unit "not applicable"
    example "how tall the named tower is"
    grounding "data/seed/capability-routing.lino"
  self_surface
    defined-by concept
    role action
    precondition "the object of the request is the assistant own prior output or surface"
    effect "classifies the object as the assistant own surface for routing"
    unit "not applicable"
    example "the reply you just gave me"
    grounding "data/seed/capability-routing.lino"
  pattern
    defined-by concept
    role action
    precondition "a wildcard or suffix names what to match rather than one path"
    effect "classifies the object as a match pattern for routing"
    unit "not applicable"
    example "every file ending in the test suffix"
    grounding "data/seed/capability-routing.lino"
  path_set
    defined-by concept
    role action
    precondition "several concrete paths are named together"
    effect "classifies the object as a batch of paths for routing"
    unit "not applicable"
    example "these three named modules"
    grounding "data/seed/capability-routing.lino"
  task_list
    defined-by concept
    role action
    precondition "the request names work as a set of tasks"
    effect "classifies the object as tracked tasks for routing"
    unit "not applicable"
    example "the plan with its numbered steps"
    grounding "data/seed/capability-routing.lino"
  delegation
    defined-by concept
    role action
    precondition "the request hands work to another agent"
    effect "classifies the object as delegated work for routing"
    unit "not applicable"
    example "have another agent handle the search"
    grounding "data/seed/capability-routing.lino"
  enumerate
    defined-by action
    role action
    precondition "the act asks for the members of a set"
    effect "selects the enumeration act in the routing decision"
    unit "not applicable"
    example "list what the folder holds"
    grounding "data/seed/capability-routing.lino"
  transform
    defined-by action
    role action
    precondition "the act asks to change an object in place"
    effect "selects the transformation act in the routing decision"
    unit "not applicable"
    example "rewrite the named file with the new text"
    grounding "data/seed/capability-routing.lino"
  compose
    defined-by action
    role action
    precondition "the act asks to produce a new artifact from parts"
    effect "selects the composition act in the routing decision"
    unit "not applicable"
    example "draft the entry at the named time"
    grounding "data/seed/capability-routing.lino"
  demonstrate
    defined-by action
    role action
    precondition "the act asks to be shown an example"
    effect "selects the demonstration act in the routing decision"
    unit "not applicable"
    example "show me the reply in the named language"
    grounding "data/seed/capability-routing.lino"
  ask
    defined-by action
    role action
    precondition "no row covers the request triple"
    effect "asks the user rather than guessing a capability"
    unit "not applicable"
    example "the table default when nothing matches"
    grounding "data/seed/capability-routing.lino"
  workspace
    defined-by concept
    role action
    precondition "the effect of the request lands inside the local project"
    effect "classifies the locus as the workspace for routing"
    unit "not applicable"
    example "the change stays inside this repository"
    grounding "data/seed/capability-routing.lino"
  self
    defined-by concept
    role action
    precondition "the effect of the request lands on the assistant own surface"
    effect "classifies the locus as the assistant surface for routing"
    unit "not applicable"
    example "the defect is in the assistant reply itself"
    grounding "data/seed/capability-routing.lino"
  callable
    defined-by concept
    role action
    precondition "a learned program declares a value it applies as a function"
    effect "marks the value as applicable before the program executes"
    unit "boolean"
    example "the learned rule requires an applicable predicate"
    grounding "src/execution_box/mod.rs"
  default
    defined-by concept
    role action
    precondition "no declared row matches the routing triple"
    effect "names the explicit ask every unmatched triple falls back to"
    unit "not applicable"
    example "the table ends in the explicit default ask"
    grounding "data/seed/capability-routing.lino"
  software_project
    defined-by method
    role action
    precondition "a request asks for a software artifact to be built or a proposal to be approved"
    effect "names the handler whose claim row admits it on an artifact object phrase or an approval"
    unit "not applicable"
    example "make a todo app in rust"
    grounding "data/seed/capability-routing.lino"
  terminal_command
    defined-by method
    role action
    precondition "a request is a shell command or a task with a known shell command"
    effect "names the handler whose claim row admits it only on a command shape or a semantic shell task"
    unit "not applicable"
    example "ls -la"
    grounding "data/seed/capability-routing.lino"
  object_phrase_artifact
    defined-by concept
    role action
    precondition "the verb's object phrase names a software artifact"
    effect "admits the software project handler's claim"
    unit "boolean"
    example "build a calculator app"
    grounding "data/seed/capability-routing.lino"
  approval_of_a_proposal
    defined-by concept
    role action
    precondition "the prompt approves a project the assistant proposed"
    effect "admits the software project handler's claim"
    unit "boolean"
    example "yes, build it"
    grounding "data/seed/capability-routing.lino"
  shell_command_shape
    defined-by concept
    role action
    precondition "the leading token is a command and the rest parses as its arguments"
    effect "admits the terminal command handler's claim"
    unit "boolean"
    example "git status --short"
    grounding "data/seed/capability-routing.lino"
  semantic_shell_task
    defined-by concept
    role action
    precondition "the prompt describes a task a known shell command performs"
    effect "admits the terminal command handler's claim"
    unit "boolean"
    example "list the files in this folder"
    grounding "data/seed/capability-routing.lino"
  repository_subject
    defined-by concept
    role action
    precondition "the prompt names an existing path, a status phrase or a census symbol"
    effect "admits the repository lineage handler's claim"
    unit "boolean"
    example "what does evaluate_calculation do"
    grounding "data/seed/capability-routing.lino"
  page_query_text
    defined-by method
    role action
    precondition "a request asks a question over a page it supplies"
    effect "names the handler whose claim row admits it only on a supplied page"
    unit "not applicable"
    example "what command builds the jar, then the page text on the following lines"
    grounding "data/seed/capability-routing.lino"
  javascript_execution
    defined-by method
    role action
    precondition "a request asks for a supplied program to be run"
    effect "names the handler whose claim row admits it only on an extracted program"
    unit "not applicable"
    example "run this javascript with console.log(1 + 2)"
    grounding "data/seed/capability-routing.lino"
  incompatible_units
    defined-by method
    role action
    precondition "a request asks to convert between units of different physical dimensions"
    effect "names the handler whose claim row admits it only on an incompatible unit pair"
    unit "not applicable"
    example "how many meters are in a kilobyte"
    grounding "data/seed/capability-routing.lino"
  supplied_page
    defined-by concept
    role action
    precondition "the first line is a query and the remaining lines are the page it reads"
    effect "admits the page query handler claim"
    unit "boolean"
    example "what command builds the jar, then the page text"
    grounding "data/seed/capability-routing.lino"
  javascript_program
    defined-by concept
    role action
    precondition "a program can be extracted from the request to run it"
    effect "admits the program execution handler claim"
    unit "boolean"
    example "run this javascript with console.log(1 + 2)"
    grounding "data/seed/capability-routing.lino"
  incompatible_unit_pair
    defined-by concept
    role action
    precondition "two named measurement units belong to different physical dimensions"
    effect "admits the unit incompatibility handler claim"
    unit "boolean"
    example "meters and kilobytes"
    grounding "data/seed/capability-routing.lino"
  fetch_url
    defined-by concept
    role action
    precondition "the request carries a URL operand it asks to retrieve"
    effect "admits the fetch handler claim"
    unit "boolean"
    example "fetch https://example.com"
    grounding "data/seed/capability-routing.lino"
  navigation_url
    defined-by concept
    role action
    precondition "the request carries a URL operand it asks to open"
    effect "admits the navigation handler claim"
    unit "boolean"
    example "navigate to github.com"
    grounding "data/seed/capability-routing.lino"
  calendar_date_signal
    defined-by concept
    role action
    precondition "a date signal is backed by a clock hour, a timezone, a participant or an explicit scheduling act"
    effect "admits the calendar event handler claim"
    unit "boolean"
    example "schedule a meeting with anna tomorrow at 3pm"
    grounding "data/seed/capability-routing.lino"
  code_debugging
    defined-by method
    role action
    precondition "a request asks to find the defect in code it carries"
    effect "names the handler whose claim row admits it only on a code artifact"
    unit "not applicable"
    example "find the bug in def average(xs): return sum(xs) / len(xs)"
    grounding "data/seed/capability-routing.lino"
  code_explanation
    defined-by method
    role action
    precondition "a request asks to explain code it carries"
    effect "names the handler whose claim row admits it only on a code artifact"
    unit "not applicable"
    example "explain this code: print(sum(range(10)))"
    grounding "data/seed/capability-routing.lino"
  code_review
    defined-by method
    role action
    precondition "a request asks to review code it carries"
    effect "names the handler whose claim row admits it only on a code artifact"
    unit "not applicable"
    example "review this code with a fenced block"
    grounding "data/seed/capability-routing.lino"
  summarization_text
    defined-by method
    role action
    precondition "a request asks to summarize text it carries"
    effect "names the handler whose claim row admits it only on supplied text"
    unit "not applicable"
    example "summarize: the text on the following lines"
    grounding "data/seed/capability-routing.lino"
  text_rewrite
    defined-by method
    role action
    precondition "a request asks to rewrite, correct or recast text it carries"
    effect "names the handler whose claim row admits it only on supplied text"
    unit "not applicable"
    example "make this formal: hey can you send me the file"
    grounding "data/seed/capability-routing.lino"
  code_artifact
    defined-by concept
    role action
    precondition "the request carries code: a fenced block, a code-shaped backtick span, a definition keyword or a call after a command colon"
    effect "admits the code debugging, explanation and review handler claims"
    unit "boolean"
    example "explain this code: print(sum(range(10)))"
    grounding "data/seed/capability-routing.lino"
  supplied_text
    defined-by concept
    role action
    precondition "the request carries at least three words of text after a command colon, a line break or inside quotes"
    effect "admits the free-text summary and rewrite handler claims"
    unit "boolean"
    example "summarize: the text that follows"
    grounding "data/seed/capability-routing.lino"
  word_problem
    defined-by method
    role action
    precondition "a request asks a quantity question in prose over numbers it states"
    effect "names the handler whose claim row admits it only on a stated number"
    unit "not applicable"
    example "five boxes cost 3 each, what is the total for 5 boxes"
    grounding "data/seed/capability-routing.lino"
  arithmetic
    defined-by method
    role action
    precondition "a request asks to evaluate an expression it carries"
    effect "names the handler whose claim row admits it only on a calculation expression or a rate-basis currency pair"
    unit "not applicable"
    example "what is 2 + 2"
    grounding "data/seed/capability-routing.lino"
  compound_interest
    defined-by method
    role action
    precondition "a request asks for the final amount of an investment, or converts that amount"
    effect "names the handler whose claim row admits it only on investment terms or a conversion target currency"
    unit "not applicable"
    example "invest 1000 dollars at 8% compounded monthly for 5 years"
    grounding "data/seed/capability-routing.lino"
  number_constraint_reasoning
    defined-by method
    role action
    precondition "a request asks which numbers satisfy the bounds it states"
    effect "names the handler whose claim row admits it only on stated interval bounds"
    unit "not applicable"
    example "a number is greater than 3 and less than 7, which is it"
    grounding "data/seed/capability-routing.lino"
  unit_conversion
    defined-by method
    role action
    precondition "a request asks to convert a stated quantity between two units"
    effect "names the handler whose claim row admits it only on a measured quantity"
    unit "not applicable"
    example "3 km in m"
    grounding "data/seed/capability-routing.lino"
  calendar_reasoning
    defined-by method
    role action
    precondition "a request asks for a day or month reached from a calendar anchor"
    effect "names the handler whose claim row admits it only on a calendar anchor or an event date signal"
    unit "not applicable"
    example "what day comes after monday"
    grounding "data/seed/capability-routing.lino"
  stated_number
    defined-by concept
    role action
    precondition "the request states at least one number the shared numeric reader parses"
    effect "admits the statistics and word problem handler claims"
    unit "boolean"
    example "the mean of 3, 5 and 7"
    grounding "data/seed/capability-routing.lino"
  calculation_expression
    defined-by concept
    role action
    precondition "the calculator reader extracts an expression from the request"
    effect "admits the arithmetic handler claim"
    unit "boolean"
    example "what is 2 + 2"
    grounding "data/seed/capability-routing.lino"
  currency_rate_basis
    defined-by concept
    role action
    precondition "the request names the US dollar exchange rate whose calculation basis it asks"
    effect "admits the arithmetic handler claim for its rate-basis arm"
    unit "boolean"
    example "which usd rate do you use for calculations"
    grounding "data/seed/capability-routing.lino"
  investment_terms
    defined-by concept
    role action
    precondition "the request states a principal, an annual rate, a compounding frequency and a term"
    effect "admits the compound interest handler claim"
    unit "boolean"
    example "1000 dollars at 8% compounded monthly for 5 years"
    grounding "data/seed/capability-routing.lino"
  conversion_target_currency
    defined-by concept
    role action
    precondition "the request names the currency an earlier final amount converts to"
    effect "admits the compound interest follow-up claim"
    unit "boolean"
    example "convert the final amount to eur"
    grounding "data/seed/capability-routing.lino"
  interval_bounds
    defined-by concept
    role action
    precondition "the request states a lower and an upper bound on a hidden number"
    effect "admits the number constraint handler claim"
    unit "boolean"
    example "greater than 3 and less than 7"
    grounding "data/seed/capability-routing.lino"
  measured_quantity
    defined-by concept
    role action
    precondition "the request states a number and names exactly two measurement units"
    effect "admits the unit conversion handler claim"
    unit "boolean"
    example "3 km in m"
    grounding "data/seed/capability-routing.lino"
  calendar_anchor
    defined-by concept
    role action
    precondition "the request names the day it starts from: a weekday, a month, a stated date or today"
    effect "admits the calendar reasoning handler claim"
    unit "boolean"
    example "what day comes after monday"
    grounding "data/seed/capability-routing.lino"
  rml
    defined-by concept
    role action
    precondition "a universal conditional clause is formalized"
    effect "names the relative-meta-logic export target whose rml command renders the clause as Lean"
    unit "not applicable"
    example "rml export lean clause.lino -o clause.lean"
    grounding "data/seed/formal-targets.lino"
