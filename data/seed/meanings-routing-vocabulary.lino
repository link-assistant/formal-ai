    example "who visited konard/formal-ai on GitHub"
    grounding "data/seed/capability-routing.lino"
  formalization_statement
    defined-by concept
    role action
    precondition "the request carries a statement beyond its formalization cue, or a formal clause"
    effect "admits the claim of the formalization handler"
    unit "boolean"
    example "formalize: every human is mortal"
    grounding "data/seed/capability-routing.lino"
  formalization_request
    defined-by concept
    role action
    precondition "a request asks to formalize a statement or deformalize a formal clause"
    effect "the formalization handler renders the statement in the formal targets or reads the clause back"
    unit "boolean"
    example "formalize: every human is mortal"
    grounding "data/seed/capability-routing.lino"
  operand
    defined-by concept
    role action
    precondition "a rule captures the operand a claim-evidence reader extracts from the request"
    effect "the rule answers about the same operand its claim row admits on"
    unit "boolean"
    example "value repository operand named_repository"
    grounding "data/seed/capability-routing.lino"
