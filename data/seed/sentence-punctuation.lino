sentence_punctuation
  script latin
    range "0041-024F"
    range "1E00-1EFF"
    terminator "."
    terminator "!"
    terminator "?"
    opening "¿"
    opening "¡"
    clause_separator ","
    clause_separator ";"
    clause_separator ":"
  script cyrillic
    range "0400-04FF"
    terminator "."
    terminator "!"
    terminator "?"
    clause_separator ","
    clause_separator ";"
    clause_separator ":"
  script devanagari
    range "0900-097F"
    terminator "।"
    terminator "॥"
    terminator "?"
    terminator "."
    clause_separator ","
  script han
    range "4E00-9FFF"
    range "3400-4DBF"
    terminator "。"
    terminator "！"
    terminator "？"
    terminator "；"
    clause_separator "，"
    clause_separator "、"
