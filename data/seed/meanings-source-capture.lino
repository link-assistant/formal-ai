meanings
  source-capture-offline-cache-miss
    role source-capture-offline-cache-miss
    defined-by relation
    precondition "The source fetcher is offline, and neither its cache nor the indexed seed registry supplies a capture for the requested URL."
    effect "Return the typed OfflineCacheMiss refusal for that URL before invoking transport.get; report no cached capture and supply no invented source bytes."
    source "rust/src/source_fetch.rs::CachedSourceClient::fetch and FetchError::OfflineCacheMiss"
    source-sha256 "f3aabba765cd55635965a422736da4fe8d36e366525e2dc3a8ee3ff69a8bcf54"
    response "data/seed/multilingual-responses-concept-lookup.lino::source-capture-offline-cache-miss-en"
    response-sha256 "f4b8d6df7bb9a396e7c6b8bdc8e7164f278172b116e342f748a13a17fbaa3d45"
    source "js/worker/formal_ai_worker_source_fetch.js::sourceWalkFetchCapture offline branch"
    source-sha256 "03216967985f2da944b20b970a11dc25add4de765cae8f73e129d26f128c7c48"
    unit "not applicable"
    example "offline request for a URL absent from cache and the indexed seed registry"
    lexeme en
      words "offline source capture cache miss"
    lexeme ru
      words "отсутствие копии источника в офлайн-кэше"
