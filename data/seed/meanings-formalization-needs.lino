  formalization_grounded_concept
    defined-by output
    role output_display_request
    precondition "A source lookup satisfied a formalization need with licensed captured bytes."
    effect "Name the surface, source URL, digest and license that grounded the concept."
    unit "count"
    example "The concept is grounded by an attributed source digest."
    grounding "src/formalization/needs.rs::satisfy"
