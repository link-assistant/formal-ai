meanings
  formalization_unresolved_need
    defined-by output
    role output_display_request
    precondition "A formalization raised a need that no consulted source grounded."
    effect "Name the surface, its exact source span, its origin, the depth reached and every consulted source outcome; never report the document as covered."
    unit "count"
    example "3 of 7 needs grounded; an unfamiliar term is unresolved at depth 2."
    grounding "src/formalization/concept_links.rs::ConceptGraph::unresolved"
  response_formalization_unresolved_need_en
    defined-by formalization_unresolved_need
    language en
    role output_display_request
    precondition "A formalization has an unresolved need."
    effect "Report the unresolved need and its evidence boundary in English."
    unit "count"
    example "3 of 7 needs grounded; “unfamiliar term” unresolved at depth 2."
    grounding "src/formalization/concept_links.rs::ConceptGraph::unresolved"
  response_formalization_unresolved_need_ru
    defined-by formalization_unresolved_need
    language ru
    role output_display_request
    precondition "A formalization has an unresolved need."
    effect "Report the unresolved need and its evidence boundary in Russian."
    unit "count"
    example "Обоснованы 3 из 7 потребностей; «незнакомый термин» не разрешён на глубине 2."
    grounding "src/formalization/concept_links.rs::ConceptGraph::unresolved"
  response_formalization_unresolved_need_hi
    defined-by formalization_unresolved_need
    language hi
    role output_display_request
    precondition "A formalization has an unresolved need."
