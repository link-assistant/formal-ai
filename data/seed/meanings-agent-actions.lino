    unit "not applicable"
    example "md to Markdown"
    grounding "data/seed/handler-rules.lino"
  document_source_marker
    defined-by method
    role action
    precondition "the source format of a conversion follows a from-style marker"
    effect "reads the surfaces that mark the next format as the source"
    unit "not applicable"
    example "from"
    grounding "data/seed/handler-rules.lino"
  document_target_marker
    defined-by method
    role action
    precondition "the target format of a conversion follows a to-style marker"
    effect "reads the surfaces that mark the next format as the target"
    unit "not applicable"
    example "to"
    grounding "data/seed/handler-rules.lino"
  document_output_fence
    defined-by method
    role action
    precondition "the converted output is fenced with the code language of its target format"
    effect "reads the fence language keyed by the target format, and no fence language when it has none"
    unit "not applicable"
    example "html for HTML"
    grounding "data/seed/handler-rules.lino"
  calendar_weekday_label
    defined-by method
