    precondition "an event request names no subject"
    effect "reads the default event title keyed by language"
    unit "not applicable"
    example "Event"
    grounding "data/seed/handler-rules.lino"
  calendar_schedule_verb
    defined-by method
    role action
    precondition "a date-anchored request asks to put something on the calendar"
    effect "reads the surfaces that ask for scheduling"
    unit "not applicable"
    example "schedule"
