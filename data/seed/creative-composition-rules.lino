  # -------------------------------------------- brainstorm morphology rules
  brainstorm_rule
    kind compound
    note "capitalize both topic words and join them"
  brainstorm_rule
    kind blend
    note "front half of the first topic word fused to the back half of the second"
  brainstorm_rule
    kind suffix
    piece Hub
    piece Lab
    piece Works
    piece House
    piece Corner
    piece Room
    piece Club
    piece Point
    note "capitalize the topic word and append one generic establishment piece"
  brainstorm_rule
    kind definite
    note "the definite article over the two topic words"
  distinctness_metric
    name "pairwise normalized levenshtein ratio"
    floor 0.3
    share_rule "no two returned candidates may share both of their content words"
    statement "candidates are ranked by the stated pairwise normalized levenshtein ratio (floor 0.3, nearest duplicates dropped, first kept) and no two returned candidates share both content words"
  # ---------------------------------------------------- planning knowledge
  plan_constraint
    day_window "09:00-19:00"
    travel_intra_district_minutes 20
    travel_cross_district_minutes 40
    lunch_window "13:00-14:00"
    max_items_per_day 4
    category_spread "no two consecutive items of the same category on one day"
    note "Opening windows and durations come from the supplied observations. They should apply to each requested day. Travel buffers are scheduling assumptions."
  # ------------------------------------------------------ advice knowledge
  advice_evidence_grade
    grade systematic_review
    weight 0.9
    label "strong (systematic review)"
  advice_evidence_grade
    grade authority_guideline
    weight 0.75
    label "strong (authority guideline)"
  advice_evidence_grade
    grade primary_study
    weight 0.6
    label "moderate (individual primary study)"
  advice_evidence_grade
    grade anecdote
    weight 0.3
    label "weak (anecdote)"
