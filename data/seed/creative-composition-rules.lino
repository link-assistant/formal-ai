  # -------------------------------------------------- verse-line skeletons
  poem_line_skeleton
    language en
    rhyme_slot true
    text "the {topic} keeps its counsel by the {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "and all our evenings settle toward the {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "I learned the {topic} the way one learns a {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "no letter reaches farther than the {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "the morning opens like a {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "give the {topic} one more evening, one more {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot false
    text "the {topic} is wide tonight"
  poem_line_skeleton
    language en
    rhyme_slot false
    text "we stood where the {topic} begins"
  poem_line_skeleton
    language ru
    rhyme_slot false
    text "снова вижу {topic}"
  poem_line_skeleton
    language ru
    rhyme_slot false
    text "{topic} остаётся с нами"
  poem_line_skeleton
    language ru
    rhyme_slot false
    text "ветер говорит о {topic}"
  poem_line_skeleton
    language hi
    rhyme_slot false
    text "{topic} के लिए एक पंक्ति"
  poem_line_skeleton
    language hi
    rhyme_slot false
    text "{topic} के नाम पर यह रात"
  poem_line_skeleton
    language hi
    rhyme_slot false
    text "{topic} की ओर देखते हुए"
  poem_line_skeleton
    language zh
    rhyme_slot false
    text "我看见{topic}的时候"
  poem_line_skeleton
    language zh
    rhyme_slot false
    text "{topic}在夜里安静下来"
  poem_line_skeleton
    language zh
    rhyme_slot false
    text "风把{topic}吹向远方"
  poem_line_skeleton
    language es
    rhyme_slot false
    text "otra vez {topic} junto a la ventana"
  poem_line_skeleton
    language es
    rhyme_slot false
    text "todo lo que sé de {topic}"
  poem_line_skeleton
    language es
    rhyme_slot false
    text "la noche guarda {topic}"
