# Creative-composition rules and knowledge (issue #1178, E143).
#
# These records describe forms, constraints, morphology, scheduling and the
# evidence-grade scale. Requests supply cited pronunciation, opening-hour,
# and advice observations for their own subjects.
#
# Read by the handlers in rust/src/solver_handlers/{creative_composition,
# creative_writing}.rs through `crate::seed::seed_files()`.

creative_composition_rules
  # ---------------------------------------------------------------- forms
  writing_form
    form poem
    default_lines 4
    default_scheme abcb
    en poem
    ru стихотворение
    ru стих
    hi कविता
    zh 诗
    es poema
  writing_form
    form haiku
    default_lines 3
    default_scheme none
    syllables "5-7-5"
    en haiku
    ru хокку
    hi हाइकू
    zh 俳句
    es haiku
  writing_form
    form limerick
    default_lines 5
    default_scheme aabba
    en limerick
    ru лимерик
    hi लिमरिक
    zh 打油诗
    es limerick
  writing_form
    form couplet
    default_lines 2
    default_scheme aa
    en couplet
    ru двустишие
    zh 对句
    es pareado
  writing_form
    form sonnet
    default_lines 14
    default_scheme ababcdcdefefgg
    en sonnet
    ru сонет
    hi सॉनेट
    zh 十四行诗
    es soneto
  # ---------------------------------------------------------- request cues
  # Recognition words the handlers test the request against beyond the role
  # lexicon — a stated line count (substring), a stated rhyme scheme literal,
  # a bare rhyme request (falls back to its scheme), the brainstorm length
  # cap, and the exclusion marker whose following tokens name excluded words.
  request_cue
    cue line_count
    word line
    word lines
    word строка
    word строки
    word पंक्ति
    word 行
    word línea
    word líneas
  request_cue
    cue stated_scheme
    word aabb
    word abab
  request_cue
    cue rhyme_request
    scheme aabb
    word rhyming
    word rhyme
  request_cue
    cue short_names
    max_length 12
    word short
  request_cue
    cue exclusion
    word without
