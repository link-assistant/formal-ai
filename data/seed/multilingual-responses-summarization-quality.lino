# Operator prose for the summarization quality protocol (issue #893, parent #710).
#
# `src/summarization/validation/` owns the protocol -- which files are drawn,
# which criteria are scored, and when the ratchet holds. This file owns its
# words -- the published description of every criterion, every sentence the
# ratchet emits when it refuses a run, and the sentences `formal-ai
# summarization` prints. They used to be English literals inside the Rust
# modules, which R379 forbids -- no hardcoded natural language in `src/`.
#
# The `{...}` fields are filled from the measured run. The criterion names
# (`identity_names_path`, `compression`) stay language-neutral, so the committed
# baseline and the report parser never have to read prose.
#
# This is a CI and operator surface, published in English alongside the case
# study in docs/case-studies/issue-893/. Adding a language means adding records
# here, not editing Rust.
multilingual_responses
  response response_summarization_criterion_identity_names_path_en
    intent summarization_criterion_identity_names_path
    language en
    text "The summary names the file it summarizes."
  response response_summarization_criterion_format_declared_en
    intent summarization_criterion_format_declared
    language en
    text "The summary names the detected file format."
  response response_summarization_criterion_size_reported_en
    intent summarization_criterion_size_reported
    language en
    text "The summary reports the file's line and byte counts."
  response response_summarization_criterion_content_retained_en
    intent summarization_criterion_content_retained
    language en
    text "A file with content yields retained content statements in the summary."
  response response_summarization_criterion_content_grounded_en
    intent summarization_criterion_content_grounded
    language en
    text "Every identifier-shaped token in the summary occurs in the file's path or content."
  response response_summarization_criterion_compression_en
    intent summarization_criterion_compression
    language en
    text "The summary is shorter than the file it summarizes."
  response response_summarization_criterion_embedded_grammar_recursion_en
    intent summarization_criterion_embedded_grammar_recursion
    language en
    text "Every Markdown fenced block is recursively formalized and its language is named in the summary."
  response response_summarization_criterion_meta_language_evidence_en
    intent summarization_criterion_meta_language_evidence
    language en
    text "A valid meta-language parse is reported with its label and syntax-link count."
  response response_summarization_criterion_determinism_en
    intent summarization_criterion_determinism
    language en
    text "Summarizing the same file twice returns byte-identical output."
  response response_summarization_criterion_mode_ladder_en
    intent summarization_criterion_mode_ladder
    language en
    text "Short, Standard and Full summaries grow monotonically with the mode ladder."
  response response_summarization_ratchet_nothing_applicable_en
    intent summarization_ratchet_nothing_applicable
    language en
    text "no criterion was applicable: the run validated nothing and cannot be counted as a pass"
  response response_summarization_ratchet_below_minimum_en
    intent summarization_ratchet_below_minimum
    language en
    text "measured quality {measured}% is below the published minimum {minimum}%"
  response response_summarization_ratchet_no_embedded_grammar_en
    intent summarization_ratchet_no_embedded_grammar
    language en
    text "no Markdown embedded grammar block was exercised: the run never reached the recursive case the protocol exists to cover"
  response response_summarization_ratchet_below_committed_en
    intent summarization_ratchet_below_committed
    language en
    text "measured quality {measured}% regressed below the committed ratchet {committed}%"
  response response_summarization_ratchet_violated_en
    intent summarization_ratchet_violated
    language en
    text "summarization quality ratchet violated:"
  response response_summarization_ratchet_committed_suffix_en
    intent summarization_ratchet_committed_suffix
    language en
    text " and a committed ratchet of {committed}% (last recorded run: {recorded}%)"
  response response_summarization_ratchet_holds_en
    intent summarization_ratchet_holds
    language en
    text "summarization quality ratchet holds: {measured}% measured against a {minimum}% minimum{suffix}"
  response response_summarization_report_headline_en
    intent summarization_report_headline
    language en
    text "seed {seed} — {iterations} iteration(s), {passed} of {applicable} criteria passed ({percent}%)"
  response response_summarization_report_grammar_en
    intent summarization_report_grammar
    language en
    text "{stability}; {blocks} Markdown embedded grammar block(s) across {files} file(s)"
  response response_summarization_report_iteration_en
    intent summarization_report_iteration
    language en
    text "  iteration {index}: {percent}%"
  response response_summarization_report_file_en
    intent summarization_report_file
    language en
    text "    {path} [{format}] {percent}% ({passed}/{applicable})"
  response response_summarization_report_failure_en
    intent summarization_report_failure
    language en
    text "      failed {name}: {detail}"
  response response_summarization_cli_criteria_minimum_en
    intent summarization_cli_criteria_minimum
    language en
    text "minimum quality ratchet: {minimum}%"
  response response_summarization_cli_criterion_line_en
    intent summarization_cli_criterion_line
    language en
    text "{name} — {description}"
  response response_summarization_cli_baseline_updated_en
    intent summarization_cli_baseline_updated
    language en
    text "baseline updated: {path}"
  response response_summarization_report_stabilized_en
    intent summarization_report_stabilized
    language en
    text "stabilized before the iteration bound"
  response response_summarization_report_bound_reached_en
    intent summarization_report_bound_reached
    language en
    text "reached the iteration bound without stabilizing"
  response response_summarization_cli_no_readable_files_en
    intent summarization_cli_no_readable_files
    language en
    text "no readable files found under {root}"
  response response_summarization_cli_baseline_write_failed_en
    intent summarization_cli_baseline_write_failed
    language en
    text "failed to write {path}: {error}"
