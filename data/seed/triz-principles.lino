# Cues for the user-facing solver (issue #901) — phrases that mark a prompt
# as a contradiction/invention question. Stemmed fragments (противоречи-,
# изобретател-, paradox, triz) match by substring.
triz_cues
  record_type "triz_intent_cues"
  intent triz_resolution
  phrase противоречи
  phrase парадокс
  phrase triz
  phrase триз
  phrase изобретател
  phrase contradiction
  phrase paradox
  phrase trade-off
  phrase tradeoff
  phrase inventive problem
  phrase engineering challenge
  phrase "contradicción"
  phrase "paradoja"
  phrase "विरोधाभास"
  phrase "अंतर्विरोध"
  phrase "矛盾"
  phrase "悖论"
