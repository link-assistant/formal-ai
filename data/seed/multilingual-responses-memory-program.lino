multilingual_responses
  response response_memory_program_complete_en
    intent memory_program_complete
    language en
    text "Memory program {program} matched {matched} event(s), changed {changed}, and stopped at {halt} after {iterations} iteration(s)."
  response response_memory_program_complete_ru
    intent memory_program_complete
    language ru
    text "Программа памяти {program} сопоставила событий: {matched}, изменила: {changed} и остановилась с результатом {halt} после итераций: {iterations}."
  response response_memory_program_complete_hi
    intent memory_program_complete
    language hi
    text "स्मृति प्रोग्राम {program} ने {matched} घटनाओं का मिलान किया, {changed} को बदला और {iterations} पुनरावृत्तियों के बाद {halt} पर रुका।"
  response response_memory_program_complete_zh
    intent memory_program_complete
    language zh
    text "记忆程序 {program} 匹配了 {matched} 个事件，更改了 {changed} 个，并在 {iterations} 次迭代后以 {halt} 停止。"
  response response_memory_program_match_limit_en
    intent memory_program_match_limit
    language en
    text "Memory program stopped without a partial write: {matched} matches exceed max_matches {max_matches}."
  response response_memory_program_match_limit_ru
    intent memory_program_match_limit
    language ru
    text "Программа памяти остановлена без частичной записи: совпадений {matched}, что превышает max_matches {max_matches}."
  response response_memory_program_match_limit_hi
    intent memory_program_match_limit
    language hi
    text "स्मृति प्रोग्राम आंशिक लेखन के बिना रुक गया: {matched} मिलान max_matches {max_matches} से अधिक हैं।"
  response response_memory_program_match_limit_zh
    intent memory_program_match_limit
    language zh
    text "记忆程序在未进行部分写入的情况下停止：{matched} 个匹配超过 max_matches {max_matches}。"
  response response_memory_program_iteration_limit_en
    intent memory_program_iteration_limit
    language en
    text "Memory program stopped honestly after reaching max_iterations {max_iterations}; it did not claim a fixpoint."
  response response_memory_program_iteration_limit_ru
    intent memory_program_iteration_limit
    language ru
    text "Программа памяти явно остановилась по достижении max_iterations {max_iterations}; достижение неподвижной точки не заявлено."
  response response_memory_program_iteration_limit_hi
    intent memory_program_iteration_limit
    language hi
    text "स्मृति प्रोग्राम max_iterations {max_iterations} पर स्पष्ट रूप से रुक गया; इसने स्थिर बिंदु मिलने का दावा नहीं किया।"
  response response_memory_program_iteration_limit_zh
    intent memory_program_iteration_limit
    language zh
    text "记忆程序在达到 max_iterations {max_iterations} 后明确停止；它没有声称已达到不动点。"
  response response_memory_program_destructive_refused_en
