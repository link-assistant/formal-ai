    text "Разрушающие действия с памятью требуют явного подтверждения человека. Ни одно событие памяти не удалено и не отозвано."
  response response_memory_program_destructive_refused_hi
    intent memory_program_destructive_refused
    language hi
    text "विनाशकारी स्मृति कार्रवाइयों के लिए स्पष्ट मानवीय पुष्टि आवश्यक है। कोई स्मृति घटना मिटाई या वापस नहीं ली गई।"
  response response_memory_program_destructive_refused_zh
    intent memory_program_destructive_refused
    language zh
