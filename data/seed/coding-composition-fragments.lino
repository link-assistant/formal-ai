meanings
  drop_whitespace
    defined-by filter
    role coding_fragment
    idiom "''.join(symbol for symbol in {items} if not symbol.isspace())"
    grounding "https://docs.python.org/3.12/library/stdtypes.html#str.isspace"
    license "PSF-2.0"
    bootstrap true
    rediscovery_query "remove Unicode whitespace characters from text"
    fragment_signature "text"
    fragment_result "text"
  delimiter_depth_delta
    defined-by mapping
    role coding_fragment
    idiom "1 if {symbol} == '(' else -1"
    grounding "https://docs.python.org/3.12/reference/expressions.html#conditional-expressions"
    license "PSF-2.0"
    bootstrap true
    rediscovery_query "map opening and closing delimiters to depth deltas"
    fragment_signature "text"
    fragment_result "integer"
    supports balanced_delimiter_groups
    supports group_max_nesting
  zero_depth_end_offsets
    defined-by filter
    role coding_fragment
    idiom "[index + 1 for index, depth in enumerate({items}) if depth == 0]"
    grounding "https://docs.python.org/3.12/library/functions.html#enumerate"
    license "PSF-2.0"
    bootstrap true
    rediscovery_query "positions after values where accumulated depth returns to zero"
    fragment_signature "sequence<integer>"
    fragment_result "sequence<integer>"
    supports balanced_delimiter_groups
  slice_at_end_offsets
    defined-by mapping
    role coding_fragment
    idiom "[{items}[start:end] for start, end in zip([0] + {ends}[:-1], {ends})]"
    grounding "https://docs.python.org/3.12/library/functions.html#zip"
    license "PSF-2.0"
    bootstrap true
    rediscovery_query "partition a sequence at ordered end offsets"
    fragment_signature (text sequence<integer>)
    fragment_result "sequence<text>"
    supports balanced_delimiter_groups
  add_binary_operator
    defined-by reduction
    role coding_fragment
    idiom "lambda left, right: left + right"
    grounding "https://docs.python.org/3.12/reference/expressions.html#lambda"
    license "PSF-2.0"
    bootstrap true
    rediscovery_query "binary addition lambda operation"
    fragment_result callable
    supports prefix_negative
    supports balanced_delimiter_groups
    supports group_max_nesting
  pair_destructuring_pattern
    defined-by pairwise
    role coding_fragment
    idiom "left, right"
    grounding "https://docs.python.org/3.12/reference/compound_stmts.html#the-for-statement"
    license "PSF-2.0"
    bootstrap true
    rediscovery_query "destructure pair in iteration target"
    fragment_result "pair<unknown:0,unknown:0>"
    supports pairwise_distinct
    supports quantifier_any
