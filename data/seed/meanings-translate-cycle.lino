# Response-intent meanings for the plan 16 translate CLI diagnostics
# (issue #1138). Each slug grounds one multilingual-responses-translate
# intent so the honest closure audit counts it as defined, not owed.
meanings
  translate_needs_from_to
    defined-by answer
    role localized_response_template
    precondition "the translate command ran without both roots"
    effect "the missing root options are requested"
    unit "not applicable"
    example "translate needs --from and --to (or --list to see every direction)"
    lexeme en
      surface
        text "translate needs from and to"
    lexeme ru
      surface
        text "переводу нужны источник и цель"
    lexeme hi
      surface
        text "अनुवाद को स्रोत और लक्ष्य चाहिए"
    lexeme zh
      surface
        text "翻译需要源和目标"
    lexeme es
      surface
        text "traducir necesita origen y destino"
  translate_unknown_from
    defined-by answer
    role localized_response_template
    precondition "the translate command received an unknown source root"
    effect "the accepted source root spellings are listed"
    unit "not applicable"
    example "unknown --from 'rust2': expected one of rust, js, ts, or meta"
    lexeme en
      surface
        text "translate unknown source root"
    lexeme ru
      surface
        text "неизвестный исходный корень перевода"
    lexeme hi
      surface
        text "अनुवाद का अज्ञात स्रोत मूल"
    lexeme zh
      surface
        text "翻译的未知源根"
    lexeme es
      surface
        text "raíz de origen desconocida de traducción"
  translate_unknown_to
    defined-by answer
    role localized_response_template
    precondition "the translate command received an unknown target root"
    effect "the accepted target root spellings are listed"
    unit "not applicable"
