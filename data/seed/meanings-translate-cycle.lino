    lexeme es "informe de etapa de traducción pendiente"
  translate_refused
    defined-by answer
    role localized_response_template
    precondition "a projection seed refuses a construct the target root does not accept"
    effect "the refused constructs are named and nothing is written"
    unit "not applicable"
    example "translate ts → js refused interface_declaration: the projection seed does not carry it, so nothing was written"
    lexeme en "translate refusal report"
    lexeme ru "отчёт об отказе перевода"
    lexeme hi "अनुवाद से इनकार रिपोर्ट"
    lexeme zh "翻译拒绝报告"
    lexeme es "informe de rechazo de traducción"
  translate_wrote_file
    defined-by answer
    role localized_response_template
    precondition "the write mode translated one mapped file and wrote its sibling-root target"
    effect "the written pair and the carried token count are reported"
    unit "not applicable"
    example "wrote ts/greeting.ts from js/greeting.js (57 tokens carried)"
    lexeme en "one translated file written"
    lexeme ru "один переведённый файл записан"
    lexeme hi "एक अनुवादित फ़ाइल लिखी गई"
    lexeme zh "已写入一个翻译文件"
    lexeme es "un archivo traducido escrito"
  translate_wrote
    defined-by answer
    role localized_response_template
    precondition "the write mode translated the whole source tree into the sibling root"
    effect "the file count, carried token total, and target root are reported"
    unit "not applicable"
    example "translated 63 files (12045 tokens carried); wrote the ts tree"
    lexeme en "translated tree written"
    lexeme ru "переведённое дерево записано"
    lexeme hi "अनुवादित ट्री लिखा गया"
    lexeme zh "已写入翻译后的树"
    lexeme es "árbol traducido escrito"
  translate_write_wrong_root
    defined-by answer
    role localized_response_template
    precondition "the write mode received a path the sibling-root mapping does not own"
    effect "the path is refused and the accepted mapping is stated"
    unit "not applicable"
    example "src/app.js: --write maps js/ ↔ ts/ sibling roots; the input must live under the source root"
    lexeme en "write path outside the sibling roots"
    lexeme ru "путь записи вне корней-близнецов"
    lexeme hi "लेखन पथ जुड़वाँ मूलों के बाहर"
    lexeme zh "写入路径在孪生根之外"
    lexeme es "ruta de escritura fuera de las raíces hermanas"
  translate_write_unsupported
    defined-by answer
    role localized_response_template
    precondition "the write mode was asked for a leg whose target is not a committed sibling tree"
    effect "the leg is refused and the only mapped write directions are named"
    unit "not applicable"
    example "writing js → meta is not a tree write this rung maps; only js ↔ ts"
    lexeme en "unsupported write direction"
    lexeme ru "неподдерживаемое направление записи"
    lexeme hi "असमर्थित लेखन दिशा"
    lexeme zh "不支持的写入方向"
    lexeme es "dirección de escritura no admitida"
  translate_write_refused
    defined-by answer
    role localized_response_template
    precondition "a tree or file write met a construct the projection seed refuses"
    effect "every refused file and construct is named and nothing was written"
    unit "not applicable"
    example "nothing was written; refused: js/app.js: interface declaration"
    lexeme en "write refused by the projection seed"
    lexeme ru "запись отклонена правилами проекции"
    lexeme hi "प्रोजेक्शन नियमों ने लेखन से इनकार किया"
    lexeme zh "投影规则拒绝了写入"
    lexeme es "escritura rechazada por las reglas de proyección"
  translate_source_missing
    defined-by answer
    role localized_response_template
    precondition "a source file named for translation is not there to read"
    effect "the missing path is reported without writing anything"
    unit "not applicable"
