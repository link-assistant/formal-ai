  translate_same_roots
    defined-by answer
    role localized_response_template
    precondition "the translate command named the same source and target root"
    effect "the non-direction is refused without invoking a leg"
    unit "not applicable"
    example "rust → rust is not a direction: the roots are the same"
    lexeme en
      surface
        text "translate same roots refusal"
    lexeme ru
      surface
        text "отказ перевода при совпадающих корнях"
    lexeme hi
      surface
        text "समान मूलों पर अनुवाद से इनकार"
    lexeme zh
      surface
        text "相同根时拒绝翻译"
    lexeme es
      surface
        text "rechazo de traducción con raíces iguales"
  translate_pending
    defined-by answer
    role localized_response_template
    precondition "a requested direction is registered but not materialized"
    effect "the plan-16 leaf that owes the leg is named"
    unit "not applicable"
    example "rust → js  pending (plan 16 L5)"
    lexeme en
