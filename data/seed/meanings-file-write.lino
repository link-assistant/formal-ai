  full-es
    role full-es
    example "Muestra el texto completo de src/input.txt."
    defined-by relation
    definition "The complete-content Read form written in Spanish, under file-read-mode-contract."
    precondition "The corresponding full-es form consumes the complete instruction, binds one locally owned source, and satisfies the shared immutable Read requirements."
    effect "Selects the existing full-content producer; actual complete transport and exact returned content require their own receipt. This identity grants no Write or independent operation."
    unit "one source-bound Read form"
    grounding "Authored full-es pattern in meanings-file-write.lino; modePathsForClause in js/agentic/file_read/ownership.mjs; mode_paths_for_clause in rust/src/agentic_coding/file_read/ownership.rs; existing FileReadMode full producer."
    lexeme en "Spanish complete file-content Read form"
    lexeme ru "форма чтения полного содержимого файла для испанского языка"
    lexeme hi "स्पेनिश में पूरी फ़ाइल सामग्री पढ़ने का रूप"
    lexeme zh "西班牙语完整文件内容读取形式"
    lexeme es "forma de lectura del contenido completo de archivo en español"

  line-slice-count
    role line-slice-count
    example "Show the last 2 lines of src/input.txt."
    defined-by relation
    definition "The complete Read form for a positive count of first or last logical lines."
    precondition "The form consumes the complete source-owned instruction; count has one to nine decimal digits and is positive; leading zeros preserve the existing producer domain."
    effect "Selects the first or last requested logical lines through the existing lineSlice producer; it does not grant complete-content fallback, prove transport, or authorize independent effects."
    limitation "Earlier source returned complete content for some unavailable slices. The updated producer refuses with a no-selected-lines response; genuine native verification remains separate from source and JavaScript controls."
    unit "logical lines from one source"
    grounding "Authored line-slice-count pattern under file-read-mode-contract; existing lineSlice in js/agentic/workspace_line_operation.mjs and line_slice in rust/src/agentic_coding/workspace_line_operation.rs; FileReadMode line-slice producer."
    lexeme en "positive count of first or last logical lines Read form"
    lexeme ru "форма чтения первых или последних строк по количеству"
    lexeme hi "गिनती से पहली या आखिरी पंक्तियाँ पढ़ने का रूप"
    lexeme zh "按数量读取最前或最后若干行的形式"
    lexeme es "forma de lectura de primeras o últimas líneas por cantidad"

  line-slice-range
    role line-slice-range
    example "Read lines 2-3 of src/input.txt."
    defined-by relation
    definition "The complete Read form for a inclusive numeric logical-line interval."
    precondition "The form consumes the complete source-owned instruction; both bounds preserve the existing positive one-to-nine-digit domain; ordering and content bounds require separate producer validation."
    effect "Selects the requested inclusive logical-line interval through the existing lineSlice producer; it does not grant complete-content fallback, prove transport, or authorize independent effects."
    limitation "Earlier source returned complete content for some unavailable slices. The updated producer refuses with a no-selected-lines response; genuine native verification remains separate from source and JavaScript controls."
    unit "logical lines from one source"
    grounding "Authored line-slice-range pattern under file-read-mode-contract; existing lineSlice in js/agentic/workspace_line_operation.mjs and line_slice in rust/src/agentic_coding/workspace_line_operation.rs; FileReadMode line-slice producer."
    lexeme en "inclusive numeric logical-line interval Read form"
    lexeme ru "форма чтения включительного диапазона строк"
    lexeme hi "समावेशी पंक्ति अंतराल पढ़ने का रूप"
    lexeme zh "读取包含两端的行区间的形式"
    lexeme es "forma de lectura de intervalo inclusivo de líneas"

  line-slice-ordinal
    role line-slice-ordinal
    example "Show the last line of src/input.txt."
    defined-by relation
    definition "The complete Read form for a named first through fifth or last logical line."
    precondition "The form consumes the complete source-owned instruction; an existing seeded ordinal or last-line role binds the selected line."
    effect "Selects the named logical line through the existing lineSlice producer; it does not grant complete-content fallback, prove transport, or authorize independent effects."
    limitation "Earlier source returned complete content for some unavailable slices. The updated producer refuses with a no-selected-lines response; genuine native verification remains separate from source and JavaScript controls."
    unit "logical lines from one source"
    grounding "Authored line-slice-ordinal pattern under file-read-mode-contract; existing lineSlice in js/agentic/workspace_line_operation.mjs and line_slice in rust/src/agentic_coding/workspace_line_operation.rs; FileReadMode line-slice producer."
    lexeme en "named first through fifth or last logical line Read form"
    lexeme ru "форма чтения строки по порядковому имени"
    lexeme hi "नामित क्रम से पंक्ति पढ़ने का रूप"
    lexeme zh "按序数名称读取一行的形式"
    lexeme es "forma de lectura de línea por ordinal indicado"

  source-owned-read-form
    defined-by relation
    role file-read-mode-contract
    example "Show me what is inside nested/Example.rs at the top."
    precondition "a declared complete form binds one typed local source operand, and prerequisite ownership has already been checked"
    effect "classifies that complete request for the existing Read producer; it does not execute a tool, authorize another clause, or certify positional extraction"
    unit "one complete source request and its bound path"
    source "js/agentic/file_read/ownership.mjs and rust/src/agentic_coding/file_read/ownership.rs; display-inside uses the existing Full mode"
    lexeme en "source-owned read form"
    lexeme ru "форма чтения с привязанным источником"
    lexeme hi "स्रोत से बँधा पठन रूप"
    lexeme zh "绑定源路径的读取形式"
    lexeme es "forma de lectura vinculada a una fuente"
  file-read-line-slice-unavailable
    defined-by response
    role file-read-mode-contract
    example "An unavailable range on a three-line file yields a no-selected-lines response and no file content."
    precondition "the existing LineSlice producer has observed source bytes but its requested selection contains no available lines"
    effect "renders the shared unavailable-slice response with the source path; it never returns the full source as a fallback"
    unit "one unavailable selected interval response"
    source "js/agentic/file_read/audit.mjs keyed message and rust/src/agentic_coding/file_read/audit.rs seed response; line-slice-unavailable.test.mjs retains eight original producer controls"
    lexeme en "requested file line slice unavailable"
    lexeme ru "запрошенный диапазон строк файла недоступен"
    lexeme hi "अनुरोधित फ़ाइल पंक्ति चयन अनुपलब्ध"
    lexeme zh "请求的文件行范围不可用"
    lexeme es "intervalo de líneas solicitado no disponible"
  file-read-mode-joiner
    example "Inspect and read src/input.txt for remaining work."
    defined-by relation
    role file-read-mode-joiner
    precondition "a completely consumed read-mode form joins only its inspection/read operators or its typed source operands"
    effect "binds conjunction spans inside that read operation; never authorizes an unrelated subsequent operation"
    unit "source spans"
    grounding "file_read ownership mode source-list grammar in JavaScript and Rust"
    lexeme en and
    lexeme ru и
    lexeme hi और तथा
    lexeme zh 和 并
    lexeme es y

  file-read-order-contract
    unit "not applicable"
    example "Read src/input.txt before authoring."
    defined-by relation
    role file-read-order-contract
    requires-goal observed-callable-authoring
    precondition "the existing observed callable request classifier binds an actual declared source authoring operation and destination; a full seeded suffix requires these Reads before that authoring, not a condition before Read"
    effect "permits only the prerequisite Read disposition; authoring remains deferred to its own source and Goal contract, with every no-read and independent-action refusal retained"
    grounding "source-owned observedCallableRequest and observed_callable_request plus complete consumed order suffix"
    lexeme en "Read before owned authoring"
    lexeme ru "Чтение до заявленного создания кода"
    lexeme hi "घोषित कोड लेखन से पहले पढ़ना"
    lexeme zh "在已声明的代码编写之前读取"
    lexeme es "Leer antes de escribir código declarado"
    form en
      pattern "^[ \\t]*before[ \\t]+authoring[ \\t]*[.]?$"
    form ru
      pattern "^[ \\t]*до[ \\t]+создания[ \\t]+кода[ \\t]*[.]?$"
    form hi
      pattern "^[ \\t]*कोड[ \\t]+लिखने[ \\t]+से[ \\t]+पहले[ \\t]*[।.]?$"
    form zh
      pattern "^[ \\t]*在编写代码之前[ \\t]*[。.]?$"
    form es
      pattern "^[ \\t]*antes[ \\t]+de[ \\t]+escribir[ \\t]+código[ \\t]*[.]?$"

