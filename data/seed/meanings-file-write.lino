  file-read-mode-contract
    defined-by action
    role file-read-mode-contract
    precondition "a complete seeded form consumes the existing selector or bounded audit operation and its typed source list; every source token is locally owned and unmatched prerequisites or independent goals are refused"
    effect "binds source operands for the existing value, first-line or bounded audit producer; it does not certify transport completion or source contents"
    unit "source spans and producer modes"
    grounding "file_read ownership mode grammar and existing FileReadMode producers in JavaScript and Rust"
    lexeme en "source-owned read mode"
    lexeme ru "режим чтения с владельцем исходника"
    lexeme hi "स्रोत स्वामित्व पठन मोड"
    lexeme zh "源所有权读取模式"
    lexeme es "modo de lectura con propiedad fuente"
    form value
      pattern "^[ \\t]*(?:what[ \\t]+is[ \\t]+the[ \\t]+)?value[ \\t]+of[ \\t]+(?<key>[A-Za-z_][A-Za-z0-9_.-]*)[ \\t]+in[ \\t]+{source}[ \\t]*[?.]?$"
      capture-domain key
        pattern "^[A-Za-z_][A-Za-z0-9_.-]*$"
        precondition "technical captures retain their exact declared case-sensitive byte domain independently from natural-language cue folding"
    form first-line
      pattern "^[ \\t]*(?:{file-read-action-cue})[ \\t]+(?:the[ \\t]+)?first[ \\t]+line[ \\t]+of[ \\t]+{source}[ \\t]*[?.]?$"
    form audit-en
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+(?:{file-read-mode-joiner}[ \\t]+)?{file-read-action-cue}[ \\t]+{sources}(?:[ \\t]*(?:;|,)?[ \\t]*(?:report[ \\t]+concrete[ \\t]+remaining[ \\t]+gaps|for[ \\t]+remaining[ \\t]+work))?[ \\t]*[.]?$"
    form audit-ru
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+{file-read-mode-joiner}[ \\t]+{file-read-action-cue}[ \\t]+{sources},[ \\t]*найди[ \\t]+оставшуюся[ \\t]+работу[.]?$"
    form audit-hi
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+{file-read-mode-joiner}[ \\t]+{sources}[ \\t]+फ़ाइलें[ \\t]+{file-read-action-cue}।?$"
    form audit-zh
      pattern "^{workspace-inspection-action}并{file-read-action-cue}{sources}中的剩余工作。?$"
    form audit-es
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+{file-read-mode-joiner}[ \\t]+{file-read-action-cue}[ \\t]+{sources}[ \\t]+para[ \\t]+encontrar[ \\t]+trabajo[ \\t]+pendiente[.]?$"

  file-read-mode-joiner
    defined-by relation
    role file-read-mode-joiner
    precondition "a completely consumed read-mode form joins only its inspection/read operators or its typed source operands"
    effect "binds conjunction spans inside that read operation; never authorizes an unrelated subsequent operation"
    unit "source spans"
    grounding "file_read ownership mode source-list grammar in JavaScript and Rust"
    lexeme en and
    lexeme ru и
    lexeme hi और तथा
    lexeme zh 和 并
    lexeme es y

  file-read-order-contract
    defined-by relation
    role file-read-order-contract
    requires-goal observed-callable-authoring
    precondition "the existing observed callable request classifier binds an actual declared source authoring operation and destination; a full seeded suffix requires these Reads before that authoring, not a condition before Read"
    effect "permits only the prerequisite Read disposition; authoring remains deferred to its own source and Goal contract, with every no-read and independent-action refusal retained"
    grounding "source-owned observedCallableRequest and observed_callable_request plus complete consumed order suffix"
    lexeme en "Read before owned authoring"
    lexeme ru "Чтение до заявленного создания кода"
    lexeme hi "घोषित कोड लेखन से पहले पढ़ना"
    lexeme zh "在已声明的代码编写之前读取"
    lexeme es "Leer antes de escribir código declarado"
    form en
      pattern "^[ \\t]*before[ \\t]+authoring[ \\t]*[.]?$"
    form ru
      pattern "^[ \\t]*до[ \\t]+создания[ \\t]+кода[ \\t]*[.]?$"
    form hi
      pattern "^[ \\t]*कोड[ \\t]+लिखने[ \\t]+से[ \\t]+पहले[ \\t]*[।.]?$"
    form zh
      pattern "^[ \\t]*在编写代码之前[ \\t]*[。.]?$"
    form es
      pattern "^[ \\t]*antes[ \\t]+de[ \\t]+escribir[ \\t]+código[ \\t]*[.]?$"

