    lexeme en "do not read" "never read" "do not open" "never open" "don't read" "don't open"
    lexeme ru "не читай" "не прочитай" "никогда не прочитай" "никогда не читай" "не открывай"
    lexeme hi "मत पढ़ो" "मत पढ़ें" "मत खोलो" "मत खोलें"
    lexeme zh 不要读取 不要打开 从不读取 从不打开
    lexeme es "no leas" "no abras" "nunca leas" "nunca abras"
  file-read-independent-effect-operation
    example "Read src/input.txt and deploy the application: deployment remains independently unbound."
    defined-by action
    role file-read-independent-effect-operation
    precondition "an unquoted independent external effect operation is declared alongside a file-read plan and has no bound execution or receipt contract"
    effect "refuses premature file-read effects; it does not execute or certify the independent operation"
    unit "source spans"
    grounding "js/agentic/file_read/ownership.mjs sha256 389f06a28610e3e4d1fe7639e3a5cbf90d24efd90824759585589d0f5ecbac28; rust/src/agentic_coding/file_read/ownership.rs sha256 55968e7f6074c26de5ed553aea1c7deea42a4bce21d3313b1dac4a61b5d33669"
