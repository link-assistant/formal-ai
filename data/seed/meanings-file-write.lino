  file_whole_write_action
    # PR #1188 T96 (the backstop behind G13, G17 and T29): the write verbs
    # that name a file's whole new content. A literal-file write whose first
    # write verb is one of these writes the file as asked; any other verb
    # (add, set, record, ...) or none reads the target first, and an existing
    # non-empty file is replaced only with `file_overwrite_consent`.
    defined-by action
    role file_whole_write_action
    precondition "a literal-file change request names a target file"
    effect "only these verbs may write the target before it is read; any other verb reads it first"
    unit "not applicable"
    example "create"
    lexeme en create write save make generate produce store "emit" "new file"
    lexeme ru
      words создай создать создайте напиши напишите запиши записать запишите сохрани сохраните сделай сделайте
      words "новый файл"
    lexeme hi बनाओ बनाएँ लिखो सहेजो "नई फ़ाइल"
    lexeme zh 创建 写 写入 保存 生成 新建
    lexeme es crea crear escribe escribir guarda guardar genera generar "nuevo archivo"
  file_declared_noun
    # PR #1188 CIFIX2: the noun that, written right before a path with the
    # content stated after it (`add file note.txt containing hello`, `new
    # file: notes.txt, contents: hello`), declares the file the request
    # writes. Such a request creates the file whatever its verb, so the
    # literal-file backstop (`file_whole_write_action`) writes it unread; a
    # destination or location cue ahead of the noun (`add 'x' to the file
    # a.txt`) keeps the read-first guard.
    defined-by relation
    role file_declared_noun
    precondition "a literal-file write request names its target right after this noun and states the content after the target"
    effect "the request declares the file it writes, so the target is written without a guard read"
    unit "not applicable"
    example "add file note.txt containing hello"
    lexeme en file
    lexeme ru файл
    lexeme hi फ़ाइल
    lexeme zh 文件
    lexeme es archivo fichero
  file_overwrite_consent
    # Wording that consents to replacing an existing file's whole content.
    defined-by relation
    role file_overwrite_consent
    precondition "a write request targets a file that already has content"
    effect "the existing file may be replaced as a whole instead of being kept"
    unit "not applicable"
    example "overwrite"
    lexeme en
      words "overwrite" "replace the whole file" "replace the file" "replace its contents" "replace the contents"
      words "set the contents of" "set the content of"
    lexeme ru перезапиши "замени весь файл" "замени содержимое" "установи содержимое"
    lexeme hi "पूरी फ़ाइल बदलें" अधिलेखित
    lexeme zh 覆盖 替换整个文件
    lexeme es sobrescribe "reemplaza todo el archivo" "reemplaza el contenido" "pon el contenido de"

  file-read-object-noun
    example "Read the file src/input.txt."
    defined-by concept
    role file-read-object-noun
    precondition "an unquoted file noun immediately follows a source-owned read operation, separated only by seeded function words"
    effect "types the operation object as a file; a negative policy remains mandatory before tool effects and does not grant permission"
    unit "source text spans, UTF-16 in JavaScript and UTF-8 in Rust"
    grounding "js/agentic/file_read/ownership.mjs sha256 389f06a28610e3e4d1fe7639e3a5cbf90d24efd90824759585589d0f5ecbac28; rust/src/agentic_coding/file_read/ownership.rs sha256 55968e7f6074c26de5ed553aea1c7deea42a4bce21d3313b1dac4a61b5d33669"
    lexeme en file files
    lexeme ru файл файла файлы файлов файле
    lexeme hi फ़ाइल फ़ाइलें फाइल फाइलें
    lexeme zh 文件
    lexeme es archivo archivos fichero ficheros
  file-read-negative-operation
    example "Do not read src/private.txt."
    defined-by action
