    lexeme zh 部署 发布
    lexeme es despliega publica

  file-read-mode-contract
    example "Show the first line of src/input.txt."
    defined-by action
    role file-read-mode-contract
    precondition "a complete seeded form consumes the existing full-content, selector or bounded audit operation and its typed source list; every source token is locally owned and unmatched prerequisites or independent goals are refused"
    effect "binds source operands for the existing full-content, value, first-line or bounded audit producer; it does not certify transport completion or source contents"
    unit "source spans and producer modes"
    grounding "file_read ownership mode grammar and existing FileReadMode producers in JavaScript and Rust"
    lexeme en "source-owned read mode"
    lexeme ru "режим чтения с владельцем исходника"
    lexeme hi "स्रोत स्वामित्व पठन मोड"
    lexeme zh "源所有权读取模式"
    lexeme es "modo de lectura con propiedad fuente"
    form display-inside
      pattern "^[ \\t]*{file-read-action-cue}[ \\t]+(?:me[ \\t]+)?what[ \\t]+is[ \\t]+inside[ \\t]+{source}(?:[ \\t]+at[ \\t]+(?:the[ \\t]+)?top)?[ \\t]*[?.]?$"
    form full-en
      pattern "^[ \\t]*{file-read-action-cue}[ \\t]+(?:me[ \\t]+)?(?:the[ \\t]+)?(?:(?:exact|precise|complete|full|verbatim|literal)[ \\t]+)?(?:text|contents?|bytes)[ \\t]+(?:stored[ \\t]+)?(?:in|of|from)[ \\t]+{source}[ \\t]*[?.]?$"
    form full-ru
      pattern "^[ \\t]*{file-read-action-cue}[ \\t]+(?:(?:мне|точный|полный|дословный)[ \\t]+)*(?:текст|содержимое|байты)[ \\t]+(?:из|в|файла)[ \\t]+{source}[ \\t]*[?.]?$"
    form full-hi
      pattern "^[ \\t]*{source}[ \\t]+(?:में|का)[ \\t]+(?:(?:ठीक|पूरा|सटीक)[ \\t]+)?(?:पाठ|सामग्री)[ \\t]+{file-read-action-cue}[ \\t]*[।.]?$"
    form full-zh
      pattern "^{file-read-action-cue}{source}(?:中|的)(?:完整|准确|原始)?(?:文本|内容|字节)[。]?$"
    form full-es
      pattern "^[ \\t]*{file-read-action-cue}[ \\t]+(?:el[ \\t]+)?(?:texto|contenido|bytes)[ \\t]+(?:(?:exacto|completo|literal)[ \\t]+)?(?:almacenado[ \\t]+)?(?:en|de)[ \\t]+{source}[ \\t]*[?.]?$"
    form value
      pattern "^[ \\t]*(?:what[ \\t]+is[ \\t]+the[ \\t]+)?value[ \\t]+of[ \\t]+(?<key>[A-Za-z_][A-Za-z0-9_.-]*)[ \\t]+in[ \\t]+{source}[ \\t]*[?.]?$"
      capture-domain key
        pattern "^[A-Za-z_][A-Za-z0-9_.-]*$"
        precondition "technical captures retain their exact declared case-sensitive byte domain independently from natural-language cue folding"
    form first-line
      pattern "^[ \\t]*(?:{file-read-action-cue})[ \\t]+(?:the[ \\t]+)?first[ \\t]+line[ \\t]+of[ \\t]+{source}[ \\t]*[?.]?$"
    form line-slice-count
      pattern "^[ \\t]*{file-read-action-cue}[ \\t]+(?:the[ \\t]+)?(?:{line-slice-head-cue}|{line-slice-tail-cue})[ \\t]+(?:[1-9][0-9]{0,8}|0[1-9][0-9]{0,7}|00[1-9][0-9]{0,6}|000[1-9][0-9]{0,5}|0000[1-9][0-9]{0,4}|00000[1-9][0-9]{0,3}|000000[1-9][0-9]{0,2}|0000000[1-9][0-9]{0,1}|00000000[1-9][0-9]{0,0})[ \\t]+{numbered-line-noun}[ \\t]+of[ \\t]+{source}[ \\t]*[?.]?$"
    form line-slice-range
      pattern "^[ \\t]*{file-read-action-cue}[ \\t]+(?:the[ \\t]+)?{numbered-line-noun}[ \\t]+(?:[1-9][0-9]{0,8}|0[1-9][0-9]{0,7}|00[1-9][0-9]{0,6}|000[1-9][0-9]{0,5}|0000[1-9][0-9]{0,4}|00000[1-9][0-9]{0,3}|000000[1-9][0-9]{0,2}|0000000[1-9][0-9]{0,1}|00000000[1-9][0-9]{0,0})[ \\t]*(?:-|{line-range-connector})[ \\t]*(?:[1-9][0-9]{0,8}|0[1-9][0-9]{0,7}|00[1-9][0-9]{0,6}|000[1-9][0-9]{0,5}|0000[1-9][0-9]{0,4}|00000[1-9][0-9]{0,3}|000000[1-9][0-9]{0,2}|0000000[1-9][0-9]{0,1}|00000000[1-9][0-9]{0,0})[ \\t]+of[ \\t]+{source}[ \\t]*[?.]?$"
    form line-slice-ordinal
      pattern "^[ \\t]*{file-read-action-cue}[ \\t]+(?:the[ \\t]+)?(?:{line-ordinal}|{line-ordinal-last})[ \\t]+{numbered-line-noun}[ \\t]+of[ \\t]+{source}[ \\t]*[?.]?$"
    form audit-en
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+(?:{file-read-mode-joiner}[ \\t]+)?{file-read-action-cue}[ \\t]+{sources}(?:[ \\t]*(?:;|,)?[ \\t]*(?:report[ \\t]+concrete[ \\t]+remaining[ \\t]+gaps|for[ \\t]+remaining[ \\t]+work))?[ \\t]*[.]?$"
    form audit-ru
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+{file-read-mode-joiner}[ \\t]+{file-read-action-cue}[ \\t]+{sources},[ \\t]*найди[ \\t]+оставшуюся[ \\t]+работу[.]?$"
    form audit-hi
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+{file-read-mode-joiner}[ \\t]+{sources}[ \\t]+फ़ाइलें[ \\t]+{file-read-action-cue}।?$"
    form audit-zh
      pattern "^{workspace-inspection-action}并{file-read-action-cue}{sources}中的剩余工作。?$"
    form audit-es
      pattern "^[ \\t]*{workspace-inspection-action}[ \\t]+{file-read-mode-joiner}[ \\t]+{file-read-action-cue}[ \\t]+{sources}[ \\t]+para[ \\t]+encontrar[ \\t]+trabajo[ \\t]+pendiente[.]?$"

  full-en
    role full-en
    example "Show me the exact text stored in src/input.txt."
    defined-by relation
    definition "The complete-content Read form written in English, under file-read-mode-contract."
    precondition "The corresponding full-en form consumes the complete instruction, binds one locally owned source, and satisfies the shared immutable Read requirements."
    effect "Selects the existing full-content producer; actual complete transport and exact returned content require their own receipt. This identity grants no Write or independent operation."
    unit "one source-bound Read form"
    grounding "Authored full-en pattern in meanings-file-write.lino; modePathsForClause in js/agentic/file_read/ownership.mjs; mode_paths_for_clause in rust/src/agentic_coding/file_read/ownership.rs; existing FileReadMode full producer."
