handler_promotions
  issue 1138
  purpose "Which handlers a prompt hoists ahead of data/seed/handler-precedence.lino. Conditions use the handler-rules grammar and are evaluated by the same interpreter, so a promotion is a seed edit, never a Rust edit."
  promotion conversation_control
    rank 10
    when
      any
        role conversation_preference_avoid forms of cleaned
        role unauthorized_mutation_correction forms of cleaned
    because "conversation preferences and action corrections must bind before ordinary task routing"
  promotion execution_failure
    rank 20
    when
      any
        substring undefined_function of lowercase
        all
          substring undefined of cleaned
          substring function of cleaned
    because "an explicit execution failure must be explained before source text is treated as a new task"
  promotion calendar_create_event
    rank 30
    when
      all
        any
          role calendar_day_reference of padded
          shape digit of trimmed
        any
          role calendar_schedule_action of padded
          role calendar_event of padded
          all
            role calendar_hour_reference of padded
            shape digit of trimmed
          all
            role calendar_date_marker of padded
            any
              role temporal_preposition of padded
              shape time_separator of trimmed
    because "issue 869 and issue 595 — a date signal conjoined with a scheduling act, or an elliptical clock hour that only the calendar handler's entity context can ground"
  promotion program_synthesis
    rank 40
    when
      all
        role program_synthesis_subject of cleaned
        role program_synthesis_domain of cleaned
        role program_synthesis_action of cleaned
    because "issue 710: a structural coding task is resolved before arithmetic and concepts inside its examples"
  promotion web_search
    rank 50
    when
      any
        role web_search_action of cleaned
        all
          role web_search_news_subject of padded
          role web_search_news_recency of padded
        all
          role web_search_records_subject of padded
          role web_search_topic_marker of padded
    because "issue 745: an explicit search act, a news request, or a records request"
  promotion arithmetic
    rank 60
    when
      all
        shape digit of trimmed
        any
          substring + of lowercase
          substring - of lowercase
          substring * of lowercase
          substring / of lowercase
          substring plus of lowercase
          substring minus of lowercase
          substring times of lowercase
          substring divided of lowercase
    because "a digit and an arithmetic operator form an executable arithmetic expression"
  promotion task_decomposition
    rank 70
    when
      any
        all
          role task_atomicity_predicate forms of cleaned
          any
            role decomposable_task_noun forms of cleaned
            role subtask_unit_noun forms of cleaned
        all
          role task_first_step_cue forms of cleaned
          role decomposable_task_noun forms of cleaned
        all
          any
            role task_decomposition_action forms of cleaned
            role task_decomposition_action separated of cleaned
          any
            role decomposable_task_noun forms of cleaned
            role subtask_unit_noun forms of cleaned
        all
          role subtask_enumeration_cue forms of cleaned
          role subtask_unit_noun forms of cleaned
          role decomposable_task_noun forms of cleaned
    because "issue 847: questions about task structure rank before a how-to reading of the same verbs"
  promotion procedural_how_to
    rank 80
    when
      any
        role_prefix procedural_request of cleaned
        all
          role_prefix procedural_request_elided_lead of cleaned
          role procedural_action_verb forms of cleaned
    because "a seeded procedural request with a concrete action reaches procedure discovery"
  promotion proof_request
    rank 90
    when
      any
        role proof_directive of cleaned
        role proof_request_lead of cleaned
    because "an explicit request for proof reaches formal proof handling before opinion routing"
  promotion fact_checking
    rank 100
    when
      role fact_check_current_dialogue_query raw of cleaned
    because "a claim-check request is evaluated against the current dialogue"
  promotion world_state
    rank 110
    when
      cue_set world_state_query of normalized
    because "a remaining-goal question reads the dialogue world model when that mode is enabled; the cue lexicon holds the multilingual remaining-goal leads so this row cannot drift out of sync with recognition"
  promotion installation_conversion
    rank 120
    when
      all
        any
          substring convert of cleaned
          substring transform of cleaned
          substring translate of cleaned
          substring конверт of cleaned
          substring преобраз of cleaned
          substring बदल of cleaned
          substring 转换 of cleaned
        any
          substring readme of cleaned
          substring markdown of cleaned
          substring install of cleaned
          substring deploy of cleaned
          substring установ of cleaned
          substring स्थापना of cleaned
          substring 安装 of cleaned
        any
          substring script of cleaned
          substring shell of cleaned
          substring bash of cleaned
          substring powershell of cleaned
          substring скрипт of cleaned
          substring 脚本 of cleaned
    because "issue 932: guide-to-script conversion wins over generic script and project readings"
  promotion write_script
    rank 130
    when
      all
        role script_authoring_verb of cleaned
        role script_or_code_artifact of cleaned
        none
          role program_genus of cleaned
          role hello_world_reference of cleaned
    because "a script authoring act paired with a script artifact reaches the minimal script route"
  promotion write_program
    rank 140
    when
      all
        role program_request of cleaned
        role program_kind of cleaned
    because "a program request is parameterized from seeded task and language meanings"
  promotion text_manipulation
    rank 150
    when
      any
        substring uppercase of cleaned
        substring lowercase of cleaned
        substring replace of cleaned
        substring append of cleaned
        substring prepend of cleaned
        substring extract of cleaned
        substring deduplicate of cleaned
        substring sort of cleaned
        substring trim of cleaned
        substring normalize of cleaned
        substring reverse of cleaned
    because "text transformations are selected by their operation, while operands remain data"
  promotion software_project
    rank 160
    when
      role software_authoring_action of cleaned
    because "a software authoring action reaches project planning before a generic concept response"
  promotion meta_explanation
    rank 170
    when
      role assistant_mechanism_inquiry raw of cleaned
    because "a question about the assistant mechanism is answered from its architecture trace"
  promotion verifiable_task
    rank 180
    when
      role verifiable_expectation of lowercase
    because "issues 531 and 1138: every seeded checkable expectation outranks generic retrieval; slot-backed paraphrases remain data and are interpreted by the shared rule grammar"
  promotion concept_lookup
    rank 190
    when
      cue_set concept_lookup of normalized
    because "a definition question opens with the pinned concept_lookup lead cues (data/meta/cue-lexicon.lino), so the cue class routes by prefix instead of an exact-route enumeration that cannot cover the open class"
