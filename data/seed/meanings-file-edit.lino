  line_containment
    defined-by relation
    role line_containment_cue
    precondition "a line edit names its quoted text as something a line contains"
    effect "every line that contains the quoted text is meant; without this cue a quoted line is the whole line that equals it"
    unit "not applicable"
    example "delete the lines containing 'x' from f.md"
