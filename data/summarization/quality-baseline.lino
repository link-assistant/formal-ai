summarization_quality_baseline
  record_type "summarization_quality_baseline"
  ratchet_runner "formal-ai summarization validate --append"
  ratchet_policy "the measured percent may never fall below the committed ratchet_percent, which starts at the published 80 percent minimum and may only ever be raised; the recorded percent is what the committed run measured, and raising the floor to it is a deliberate reviewed edit"
  honesty_policy "every number here is measured by running the production summarizer over seeded random repository files; a run that reaches its iteration bound without stabilizing records bound_reached true rather than claiming stability"
  minimum_percent "80"
  ratchet_percent "80"
  seed "563"
  files_per_iteration "2"
  max_iterations "24"
  stability_window "3"
  stability_tolerance_percent "5"
  iterations "3"
  stabilized "true"
  bound_reached "false"
  embedded_grammar_files "2"
  embedded_grammar_blocks "2"
  passed_criteria "53"
  applicable_criteria "53"
  percent "100"
  criterion "identity_names_path"
  criterion "format_declared"
  criterion "size_reported"
  criterion "content_retained"
  criterion "content_grounded"
  criterion "compression"
  criterion "embedded_grammar_recursion"
  criterion "meta_language_evidence"
  criterion "determinism"
  criterion "mode_ladder"
