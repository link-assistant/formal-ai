# Issue #1186 R10 formalization probe set (en). Every prompt names a sentence
# the formal-targets seed never mentions; the expected clause is what the
# quantifier, relative-clause and object grammar derives from its own words.
# Read by rust/tests/unit/web-engine-core/issue_1186_formalization_probe_set.rs and
# rust/tests/web/issue-1186-formalization-probe-set.test.mjs.
formalization_probe_en_01
  record_type "formalization_probe"
  id "en_01"
  language "en"
  shape "universal"
  prompt "Formalize in first-order logic: Every teacher who reads writes"
  expected_quantifier "forall"
  expected_predicates "Teacher|Reads|Writes"
  expected_fol "∀x (Teacher(x) ∧ Reads(x) → Writes(x))"
formalization_probe_en_02
  record_type "formalization_probe"
  id "en_02"
  language "en"
  shape "universal"
  prompt "Formalize in first-order logic: Every dog that barks bites"
  expected_quantifier "forall"
  expected_predicates "Dog|Barks|Bites"
  expected_fol "∀x (Dog(x) ∧ Barks(x) → Bites(x))"
formalization_probe_en_03
  record_type "formalization_probe"
  id "en_03"
  language "en"
  shape "universal"
  prompt "Formalize in first-order logic: Every child who sings and dances smiles"
  expected_quantifier "forall"
  expected_predicates "Child|Sings|Dances|Smiles"
  expected_fol "∀x (Child(x) ∧ Sings(x) ∧ Dances(x) → Smiles(x))"
formalization_probe_en_04
  record_type "formalization_probe"
  id "en_04"
  language "en"
  shape "relation"
  prompt "Formalize in first-order logic: Every farmer who works owns a tractor"
  expected_quantifier "forall"
  expected_predicates "Farmer|Works|Owns"
  expected_fol "∀x (Farmer(x) ∧ Works(x) → Owns(x, tractor))"
