  record_type "formalization_probe"
  id "en_05"
  language "en"
  shape "relation"
  prompt "Formalize in first-order logic: Every nurse who listens helps the patient"
  expected_quantifier "forall"
  expected_predicates "Nurse|Listens|Helps"
  expected_fol "∀x (Nurse(x) ∧ Listens(x) → Helps(x, patient))"
formalization_probe_en_06
  record_type "formalization_probe"
  id "en_06"
  language "en"
  shape "existential"
  prompt "Formalize in first-order logic: Some bird that sings flies"
  expected_quantifier "exists"
  expected_predicates "Bird|Sings|Flies"
  expected_fol "∃x (Bird(x) ∧ Sings(x) ∧ Flies(x))"
formalization_probe_en_07
  record_type "formalization_probe"
  id "en_07"
  language "en"
  shape "relation"
  prompt "Formalize in first-order logic: Some pilot who trains flies a plane"
  expected_quantifier "exists"
  expected_predicates "Pilot|Trains|Flies"
  expected_fol "∃x (Pilot(x) ∧ Trains(x) ∧ Flies(x, plane))"
formalization_probe_en_08
  record_type "formalization_probe"
  id "en_08"
  language "en"
  shape "existential"
  prompt "Formalize in first-order logic: Some robot which beeps moves"
  expected_quantifier "exists"
  expected_predicates "Robot|Beeps|Moves"
  expected_fol "∃x (Robot(x) ∧ Beeps(x) ∧ Moves(x))"
formalization_probe_en_09
  record_type "formalization_probe"
  id "en_09"
  language "en"
  shape "negation"
  prompt "Formalize in first-order logic: No cat that sleeps hunts"
  expected_quantifier "no"
  expected_predicates "Cat|Sleeps|Hunts"
  expected_fol "¬∃x (Cat(x) ∧ Sleeps(x) ∧ Hunts(x))"
