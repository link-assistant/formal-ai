  language "zh"
  shape "relation"
  prompt "形式化：某个训练的飞行员 驾驶 飞机"
  expected_quantifier "exists"
  expected_predicates "飞行员|训练|驾驶"
  expected_fol "∃x (飞行员(x) ∧ 训练(x) ∧ 驾驶(x, 飞机))"
formalization_probe_zh_08
  record_type "formalization_probe"
  id "zh_08"
  language "zh"
  shape "negation"
