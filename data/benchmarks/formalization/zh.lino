  id "zh_05"
  language "zh"
  shape "relation"
  prompt "形式化：每个倾听的医生都帮助 病人"
  expected_quantifier "forall"
  expected_predicates "医生|倾听|帮助"
  expected_fol "∀x (医生(x) ∧ 倾听(x) → 帮助(x, 病人))"
formalization_probe_zh_06
  record_type "formalization_probe"
  id "zh_06"
  language "zh"
  shape "existential"
  prompt "形式化：某个唱歌的鸟 飞翔"
  expected_quantifier "exists"
  expected_predicates "鸟|唱歌|飞翔"
  expected_fol "∃x (鸟(x) ∧ 唱歌(x) ∧ 飞翔(x))"
