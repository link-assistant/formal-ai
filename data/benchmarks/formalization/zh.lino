# Issue #1186 R10 formalization probe set (zh). Every prompt names a sentence
# the formal-targets seed never mentions; the expected clause is what the
# quantifier, relative-clause and object grammar derives from its own words.
# Read by rust/tests/unit/web-engine-core/issue_1186_formalization_probe_set.rs and
# rust/tests/web/issue-1186-formalization-probe-set.test.mjs.
formalization_probe_zh_01
  record_type "formalization_probe"
  id "zh_01"
  language "zh"
  shape "universal"
  prompt "形式化：每个学习的学生都通过考试"
  expected_quantifier "forall"
  expected_predicates "学生|学习|通过考试"
  expected_fol "∀x (学生(x) ∧ 学习(x) → 通过考试(x))"
formalization_probe_zh_02
  record_type "formalization_probe"
  id "zh_02"
  language "zh"
  shape "universal"
  prompt "形式化：每个阅读的老师都写作"
  expected_quantifier "forall"
  expected_predicates "老师|阅读|写作"
  expected_fol "∀x (老师(x) ∧ 阅读(x) → 写作(x))"
formalization_probe_zh_03
  record_type "formalization_probe"
  id "zh_03"
  language "zh"
  shape "universal"
  prompt "形式化：每个唱歌且跳舞的孩子都微笑"
  expected_quantifier "forall"
  expected_predicates "孩子|唱歌|跳舞|微笑"
  expected_fol "∀x (孩子(x) ∧ 唱歌(x) ∧ 跳舞(x) → 微笑(x))"
formalization_probe_zh_04
  record_type "formalization_probe"
  id "zh_04"
  language "zh"
  shape "relation"
  prompt "形式化：每个工作的农民都拥有 拖拉机"
  expected_quantifier "forall"
  expected_predicates "农民|工作|拥有"
  expected_fol "∀x (农民(x) ∧ 工作(x) → 拥有(x, 拖拉机))"
