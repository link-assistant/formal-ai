# Issue #1186 R10 formalization probe set (hi). Every prompt names a sentence
# the formal-targets seed never mentions; the expected clause is what the
# quantifier, relative-clause and object grammar derives from its own words.
# Read by rust/tests/unit/issue_1186_formalization_probe_set.rs and
# rust/tests/web/issue-1186-formalization-probe-set.test.mjs.
formalization_probe_hi_01
  record_type "formalization_probe"
  id "hi_01"
  language "hi"
  shape "universal"
  prompt "औपचारिक बनाओ: हर छात्र जो सीखता है, जीतता है"
  expected_quantifier "forall"
  expected_predicates "छात्र|सीखता|जीतता"
  expected_fol "∀x (छात्र(x) ∧ सीखता(x) → जीतता(x))"
formalization_probe_hi_02
  record_type "formalization_probe"
  id "hi_02"
  language "hi"
  shape "universal"
  prompt "औपचारिक बनाओ: हर शिक्षक जो सुनता है, लिखता है"
  expected_quantifier "forall"
  expected_predicates "शिक्षक|सुनता|लिखता"
  expected_fol "∀x (शिक्षक(x) ∧ सुनता(x) → लिखता(x))"
formalization_probe_hi_03
  record_type "formalization_probe"
  id "hi_03"
  language "hi"
  shape "universal"
  prompt "औपचारिक बनाओ: प्रत्येक बच्चा जो गाता है और नाचता है, मुस्कुराता है"
  expected_quantifier "forall"
  expected_predicates "बच्चा|गाता|नाचता|मुस्कुराता"
  expected_fol "∀x (बच्चा(x) ∧ गाता(x) ∧ नाचता(x) → मुस्कुराता(x))"
formalization_probe_hi_04
  record_type "formalization_probe"
  id "hi_04"
  language "hi"
  shape "relation"
  prompt "औपचारिक बनाओ: हर छात्र जो सीखता है, किताब लिखता है"
  expected_quantifier "forall"
  expected_predicates "छात्र|सीखता|लिखता"
  expected_fol "∀x (छात्र(x) ∧ सीखता(x) → लिखता(x, किताब))"
formalization_probe_hi_05
  record_type "formalization_probe"
  id "hi_05"
  language "hi"
  shape "relation"
  prompt "औपचारिक बनाओ: हर किसान जो जागता है, खेत जोतता है"
  expected_quantifier "forall"
  expected_predicates "किसान|जागता|जोतता"
  expected_fol "∀x (किसान(x) ∧ जागता(x) → जोतता(x, खेत))"
formalization_probe_hi_06
  record_type "formalization_probe"
  id "hi_06"
  language "hi"
  shape "existential"
  prompt "औपचारिक बनाओ: कोई बत्तख जो गाती है, तैरती है"
  expected_quantifier "exists"
  expected_predicates "बत्तख|गाती|तैरती"
  expected_fol "∃x (बत्तख(x) ∧ गाती(x) ∧ तैरती(x))"
