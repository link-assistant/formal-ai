  language "ru"
  shape "relation"
  prompt "Формализуй: Никакой судья, который отдыхает, читает дело"
  expected_quantifier "no"
  expected_predicates "судья|отдыхает|читает"
  expected_fol "¬∃x (судья(x) ∧ отдыхает(x) ∧ читает(x, дело))"
