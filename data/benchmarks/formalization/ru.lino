  record_type "formalization_probe"
  id "ru_06"
  language "ru"
  shape "relation"
  prompt "Формализуй: Некоторый пилот, который учится, водит самолёт"
  expected_quantifier "exists"
  expected_predicates "пилот|учится|водит"
  expected_fol "∃x (пилот(x) ∧ учится(x) ∧ водит(x, самолёт))"
formalization_probe_ru_07
  record_type "formalization_probe"
  id "ru_07"
  language "ru"
  shape "negation"
  prompt "Формализуй: Никакой пёс, который спит, лает"
  expected_quantifier "no"
  expected_predicates "пёс|спит|лает"
  expected_fol "¬∃x (пёс(x) ∧ спит(x) ∧ лает(x))"
