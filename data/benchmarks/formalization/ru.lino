# Issue #1186 R10 formalization probe set (ru). Every prompt names a sentence
# the formal-targets seed never mentions; the expected clause is what the
# quantifier, relative-clause and object grammar derives from its own words.
# Read by rust/tests/unit/web-engine-core/issue_1186_formalization_probe_set.rs and
# rust/tests/web/issue-1186-formalization-probe-set.test.mjs.
formalization_probe_ru_01
  record_type "formalization_probe"
  id "ru_01"
  language "ru"
  shape "relation"
  prompt "Формализуй: Каждый студент, который учится, сдаёт экзамен"
  expected_quantifier "forall"
  expected_predicates "студент|учится|сдаёт"
  expected_fol "∀x (студент(x) ∧ учится(x) → сдаёт(x, экзамен))"
formalization_probe_ru_02
  record_type "formalization_probe"
  id "ru_02"
  language "ru"
  shape "universal"
  prompt "Формализуй: Каждый учитель, который читает, пишет"
  expected_quantifier "forall"
  expected_predicates "учитель|читает|пишет"
  expected_fol "∀x (учитель(x) ∧ читает(x) → пишет(x))"
formalization_probe_ru_03
  record_type "formalization_probe"
  id "ru_03"
  language "ru"
  shape "universal"
  prompt "Формализуй: Каждый ребёнок, который поёт и танцует, улыбается"
  expected_quantifier "forall"
  expected_predicates "ребёнок|поёт|танцует|улыбается"
  expected_fol "∀x (ребёнок(x) ∧ поёт(x) ∧ танцует(x) → улыбается(x))"
formalization_probe_ru_04
  record_type "formalization_probe"
  id "ru_04"
  language "ru"
  shape "relation"
  prompt "Формализуй: Каждый фермер, который работает, имеет трактор"
  expected_quantifier "forall"
  expected_predicates "фермер|работает|имеет"
  expected_fol "∀x (фермер(x) ∧ работает(x) → имеет(x, трактор))"
formalization_probe_ru_05
  record_type "formalization_probe"
  id "ru_05"
  language "ru"
  shape "existential"
  prompt "Формализуй: Некоторый кот, который спит, охотится"
  expected_quantifier "exists"
  expected_predicates "кот|спит|охотится"
  expected_fol "∃x (кот(x) ∧ спит(x) ∧ охотится(x))"
