benchmark_limitation_irrational_roots
  record_type "benchmark_limitation"
  id "irrational_roots"
  source "equation_types"
  category "polynomial"
  prompt "Solve x^2 - 2 = 0"
  observed_intent "calculation_error"
  upstream "link-calculator"
  limitation "link-calculator returns rational roots only, so an irrational root set is reported as unparseable instead of as sqrt(2)."
