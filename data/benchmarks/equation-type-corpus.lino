  id "identity_equation"
  source "equation_types"
  category "degenerate"
  prompt "Solve x = x"
  observed_intent "unknown"
  upstream "formal-ai"
  limitation "An identity (every value satisfies it) carries no calculation signal, so the router declines instead of answering 'any value'."
