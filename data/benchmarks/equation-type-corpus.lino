  observed_intent "calculation_error"
  upstream "link-calculator"
  limitation "A unit on the constant side is not stripped, so the equation is unparseable."
benchmark_limitation_named_unknown_if_clause
  record_type "benchmark_limitation"
  id "named_unknown_if_clause"
  source "equation_types"
  category "natural_language_wrapper"
  prompt "What is x if x + 7 = 12?"
  observed_intent "calculation_error"
  upstream "formal-ai"
  limitation "`x if <equation>` declares the unknown before the equation; the declaration is not stripped, so the remainder `x if x + 7 = 12` is unparseable."
