        "rust/tests/web/work-item-adapter-sessions.test.mjs",
        "rust/tests/web/work-item-file-io.test.mjs",
        "rust/tests/web/repository-documentation.test.mjs",
        "rust/tests/web/repository-consumer-discovery.test.mjs"
      ]
