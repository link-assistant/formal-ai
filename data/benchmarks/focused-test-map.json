      "description": "A work-item reference was not resolved to a repository file, or no read tool was offered.",
      "tests": [
        "rust/tests/web/draft-request-replay.test.mjs",
        "rust/tests/web/work-item-report-outcome.test.mjs",
        "rust/tests/web/work-item-evidence.test.mjs",
        "rust/tests/web/work-item-target-binding.test.mjs"
      ]
    },
