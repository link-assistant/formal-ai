language en
lemma heavy
license
  name "CC BY 4.0"
  url "https://creativecommons.org/licenses/by/4.0/"
senses
  entry
    definition "of comparatively great physical weight or density"
    examples ("a heavy load" "lead is a heavy metal" "heavy mahogany furniture")
    id oewn-01188475-a
    partOfSpeech a
  entry
    definition "unusually great in degree or quantity or number"
    examples ("heavy taxes" "a heavy fine" "heavy casualties" "heavy losses" "heavy rain" "heavy traffic")
    id oewn-01194226-a
    partOfSpeech a
  entry
    definition "of the military or industry; using (or being) the heaviest and most powerful armaments or weapons or equipment"
    examples ("heavy artillery" "heavy infantry" "a heavy cruiser" "heavy guns" "heavy industry involves large-scale production of basic products (such as steel) used by other industries")
    id oewn-01196916-a
    partOfSpeech a
  entry
    definition "marked by great psychological weight; weighted down especially with sadness or troubles or weariness"
    examples ("a heavy heart" "a heavy schedule" "heavy news" "a heavy silence" "heavy eyelids")
    id oewn-01192305-a
    partOfSpeech a
  entry
    definition "of great intensity or power or force"
    examples ("a heavy blow" "the fighting was heavy" "heavy seas")
    id oewn-01195161-a
    partOfSpeech a
  entry
    definition "(physics, chemistry) being or containing an isotope with greater than average atomic mass or weight"
    examples ("heavy hydrogen" "heavy water")
    id oewn-01194770-a
    partOfSpeech a
  entry
    definition "an actor who plays villainous roles"
    id oewn-10186954-n
    partOfSpeech n
  entry
    definition "a serious (or tragic) role in a play"
    id oewn-05938368-n
    partOfSpeech n
  entry
    definition "slowly as if burdened by much weight"
    examples ("time hung heavy on their hands")
    id oewn-00357411-r
    partOfSpeech r
    synonyms (heavily)
  entry
    definition "usually describes a large person who is fat but has a large frame to carry it"
    id oewn-00990957-s
