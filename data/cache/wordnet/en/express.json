      "partOfSpeech": "n",
      "definition": "mail that is distributed by a rapid and efficient system",
      "synonyms": [
        "express mail"
      ]
    },
    {
      "id": "oewn-03311330-n",
      "partOfSpeech": "n",
      "definition": "public transport consisting of a fast train or bus that makes only a few scheduled stops",
      "examples": [
        "he caught the express to New York"
      ],
      "synonyms": [
        "limited"
      ]
    },
    {
      "id": "oewn-01108365-n",
      "partOfSpeech": "n",
      "definition": "rapid transport of goods",
      "synonyms": [
        "expressage"
      ]
    },
    {
      "id": "oewn-00336514-r",
      "partOfSpeech": "r",
      "definition": "by express",
      "examples": [
        "please send the letter express"
      ]
    },
    {
      "id": "oewn-00944417-s",
      "partOfSpeech": "s",
      "definition": "not tacit or implied",
      "examples": [
        "her express wish"
      ]
    },
    {
      "id": "oewn-00980890-s",
      "partOfSpeech": "s",
      "definition": "without unnecessary stops",
      "examples": [
        "an express train",
        "an express shipment"
      ]
    },
    {
      "id": "oewn-00945869-v",
      "partOfSpeech": "v",
      "definition": "give expression to",
      "examples": [
