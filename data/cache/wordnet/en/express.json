        "evince"
      ]
    },
    {
      "id": "oewn-00942415-v",
      "partOfSpeech": "v",
      "definition": "articulate; either verbally or with a cry, shout, or noise",
      "examples": [
        "She expressed her anger",
        "He uttered a curse"
      ],
      "synonyms": [
