language en
lemma deep
license
  name "CC BY 4.0"
  url "https://creativecommons.org/licenses/by/4.0/"
senses
  entry
    definition "relatively deep or strong; affecting one deeply"
    examples ("a deep breath" "a deep sigh" "deep concentration" "deep emotion" "a deep trance" "in a deep sleep")
    id oewn-00696211-a
    partOfSpeech a
  entry
    definition "having great spatial extension or penetration downward or inward from an outer surface or backward or laterally or outward from a center; sometimes used in combination"
    examples ("a deep well" "a deep dive" "deep water" "a deep casserole" "a deep gash" "deep massage" "deep pressure receptors in muscles" "deep shelves" "a deep closet" "surrounded by a deep yard" "hit the ball to deep center field" "in deep space" waist-deep)
    id oewn-00693335-a
    partOfSpeech a
  entry
    definition "the central and most intense or profound part"
    examples ("in the deep of night" "in the deep of winter")
    id oewn-15292202-n
    partOfSpeech n
  entry
    definition "a long steep-sided depression in the ocean floor"
    id oewn-09484445-n
    partOfSpeech n
    synonyms (trench "oceanic abyss")
  entry
    definition "literary term for an ocean"
    examples ("denizens of the deep")
    id oewn-09286717-n
    partOfSpeech n
  entry
    definition "to a great depth; far down or in"
    examples ("dived deeply" "dug deep")
    id oewn-00306956-r
    partOfSpeech r
    synonyms (deeply)
  entry
    definition "to an advanced time"
    examples ("deep into the night" "talked late into the evening")
    id oewn-00307214-r
    partOfSpeech r
    synonyms (late)
  entry
    definition "to a great distance"
    examples ("penetrated deep into enemy territory" "went deep into the woods")
    id oewn-00307076-r
    partOfSpeech r
  entry
    definition "marked by depth of thinking"
    examples ("deep thoughts" "a deep allegory")
    id oewn-01879131-s
    partOfSpeech s
  entry
    definition "very distant in time or space"
    examples ("deep in the past" "deep in enemy territory" "deep in the woods" "a deep space probe")
    id oewn-00447971-s
    partOfSpeech s
  entry
    definition "intense or extreme"
    examples ("in deep trouble" "deep happiness")
    id oewn-01515033-s
    partOfSpeech s
  entry
    definition "having or denoting a low vocal or instrumental range"
    examples ("a deep voice" "a bass voice is lower than a baritone voice" "a bass clarinet")
    id oewn-01218606-s
    partOfSpeech s
    synonyms (bass)
  entry
    definition "strong; intense"
    examples ("deep purple" "a rich red")
    id oewn-00404462-s
    partOfSpeech s
    synonyms (rich)
  entry
    definition "relatively thick from top to bottom"
    examples ("deep carpets" "deep snow")
    id oewn-02419779-s
    partOfSpeech s
  entry
    definition "extending relatively far inward"
    examples ("a deep border")
    id oewn-02572121-s
    partOfSpeech s
  entry
    definition "(of darkness) densely dark"
    examples ("thick night" "thick darkness" "a face in deep shadow" "deep night")
    id oewn-01517859-s
    partOfSpeech s
    synonyms (thick)
  entry
    definition "large in quantity or size"
    examples ("deep cuts in the budget")
    id oewn-01387980-s
    partOfSpeech s
  entry
    definition "with head or back bent low"
    examples ("a deep bow")
    id oewn-01209588-s
    partOfSpeech s
  entry
    definition "of an obscure nature"
    examples ("the new insurance policy is written without cryptic or mysterious terms" "a deep dark secret" "the inscrutable workings of Providence" "in its mysterious past it encompasses all the dim origins of life" "rituals totally mystifying to visitors from other lands")
    id oewn-00942713-s
    partOfSpeech s
    synonyms (cryptic cryptical inscrutable mysterious mystifying)
  entry
    definition "difficult to penetrate; incomprehensible to one of ordinary understanding or knowledge"
    examples ("the professor's lectures were so abstruse that students tended to avoid them" "a deep metaphysical theory" "some recondite problem in historiography")
    id oewn-00902519-s
    partOfSpeech s
    synonyms (abstruse recondite)
  entry
    definition "exhibiting great cunning usually with secrecy"
    examples ("deep political machinations" "a deep plot")
    id oewn-00150388-s
    partOfSpeech s
