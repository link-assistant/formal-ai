    synonyms (hunt hunting)
  entry
    definition "an investigation seeking answers"
    examples ("a thorough search of the ledgers revealed nothing" "the outcome justified the search")
    id oewn-00638597-n
    partOfSpeech n
  entry
    definition "an operation that determines whether one or more of a set of items has a specified property"
    examples ("they wrote a program to do a table lookup")
    id oewn-13574763-n
    partOfSpeech n
    synonyms (lookup)
  entry
    definition "the examination of alternative hypotheses"
    examples ("his search for a move that would avoid checkmate was unsuccessful")
    id oewn-05778055-n
    partOfSpeech n
  entry
    definition "boarding and inspecting a ship on the high seas"
    examples ("right of search")
    id oewn-00645609-n
    partOfSpeech n
  entry
    definition "try to locate or discover, or try to establish the existence of"
    examples ("The police are searching for clues" "They are searching for the missing man in the entire county")
    id oewn-01318273-v
    partOfSpeech v
    synonyms (seek "look for")
  entry
    definition "search or seek"
    examples ("We looked all day and finally found the child in the forest" "Look elsewhere for the perfect gift!")
