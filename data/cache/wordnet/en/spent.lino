senses
  entry
    definition "depleted of energy, force, or strength"
    examples ("impossible to grow tobacco on the exhausted soil" "the exhausted food sources" "exhausted oil wells")
    id oewn-00929382-a
    partOfSpeech a
    synonyms (exhausted)
  entry
    definition "drained of energy or effectiveness; extremely tired; completely exhausted"
    examples ("the day's shopping left her exhausted" "he went to bed dog-tired" "was fagged and sweaty" "the trembling of his played out limbs" "felt completely washed-out" "only worn-out horses and cattle" "you look worn out")
    id oewn-02442263-s
    partOfSpeech s
    synonyms (exhausted dog-tired fagged fatigued "played out" washed-out worn-out "worn out" gone)
  entry
    definition "use up a period of time in a specific way"
    examples ("how are you spending your summer vacation?")
    id oewn-02714280-v
    partOfSpeech v
    synonyms (spend pass)
  entry
    definition "pay out"
    examples ("spend money")
    id oewn-02271905-v
    partOfSpeech v
    synonyms (spend expend drop)
  entry
    definition "spend completely"
    examples ("I spend my pocket money in two days")
    id oewn-02272374-v
    partOfSpeech v
    synonyms (spend)
