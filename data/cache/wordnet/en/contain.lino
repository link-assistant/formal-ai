language en
lemma contain
license
  name "CC BY 4.0"
  url "https://creativecommons.org/licenses/by/4.0/"
senses
  entry
    definition "include or contain; have as a component"
    examples ("A totally new idea is comprised in this paper" "The record contains many old songs from the 1930's")
    id oewn-02635616-v
    partOfSpeech v
    synonyms (incorporate comprise)
  entry
    definition "contain or hold; have within"
    examples ("The jar carries wine" "The canteen holds fresh water" "This can contains water")
    id oewn-02706727-v
    partOfSpeech v
    synonyms (hold bear carry)
  entry
    definition "lessen the intensity of; temper; hold in restraint; hold or keep within limits"
    examples ("moderate your alcohol intake" "hold your tongue" "hold your temper" "control your anger")
    id oewn-02516039-v
    partOfSpeech v
    synonyms (control "hold in" hold check curb moderate)
  entry
    definition "be divisible by"
    examples ("24 contains 6")
    id oewn-02753162-v
    partOfSpeech v
  entry
    definition "be capable of holding or containing"
    examples ("This box won't take all the items" "The flask holds one gallon")
    id oewn-02707070-v
    partOfSpeech v
    synonyms (take hold)
  entry
    definition "hold back, as of a danger or an enemy; check the expansion or influence of"
    examples ("Arrest the downward trend" "Check the growth of communism in South East Asia" "Contain the rebel movement" "Turn back the tide of communism")
    id oewn-01133899-v
    partOfSpeech v
    synonyms (check "turn back" arrest stop "hold back")
source "oewn:2024"
