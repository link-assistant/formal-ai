language en
lemma need
license
  name "CC BY 4.0"
  url "https://creativecommons.org/licenses/by/4.0/"
senses
  entry
    definition "a condition requiring relief"
    examples ("she satisfied his need for affection" "God has no need of men to accomplish His work" "there is a demand for jobs")
    id oewn-14472592-n
    partOfSpeech n
    synonyms (demand)
  entry
    definition "anything that is necessary but lacking"
    examples ("he had sufficient means to meet his simple needs" "I tried to supply his wants")
    id oewn-09390888-n
    partOfSpeech n
    synonyms (want)
  entry
    definition "the psychological feature that arouses an organism to action toward a desired goal; the reason for the action; that which gives purpose and direction to behavior"
    examples ("we did not understand his motivation" "he acted with the best of motives")
    id oewn-00023953-n
    partOfSpeech n
    synonyms (motivation motive)
  entry
    definition "a state of extreme poverty or destitution"
    examples ("their indigence appalled him" "a general state of need exists among the homeless")
    id oewn-14517300-n
    partOfSpeech n
    synonyms (indigence penury pauperism pauperization)
  entry
    definition "require as useful, just, or proper"
    examples ("It takes nerve to do what she did" "success usually requires hard work" "This job asks a lot of patience and skill" "This position demands a lot of personal sacrifice" "This dinner calls for a spectacular dessert" "This intervention does not postulate a patient's consent")
    id oewn-02634015-v
    partOfSpeech v
    synonyms (necessitate ask postulate require take involve "call for" demand)
  entry
    definition "have need of"
    examples ("This piano wants the attention of a competent tuner")
    id oewn-01191258-v
    partOfSpeech v
    synonyms (want require)
  entry
    definition "have or feel a need for"
    examples ("always needing friends and money")
    id oewn-01191646-v
    partOfSpeech v
source "oewn:2024"
