senses
  entry
    definition "not fake or counterfeit"
    examples ("a genuine Picasso" "genuine leather")
    id oewn-01119091-a
    partOfSpeech a
    synonyms (echt)
  entry
    definition "not pretended; sincerely felt or expressed"
    examples ("genuine emotion" "her interest in people was unfeigned" "true grief")
    id oewn-02187907-s
    partOfSpeech s
    synonyms ("true" unfeigned)
  entry
    definition "being or reflecting the essential or genuine character of something"
    examples ("her actual motive" "a literal solitude like a desert" "a genuine dilemma")
    id oewn-02470192-s
    partOfSpeech s
    synonyms (actual literal real)
