language en
lemma manifest
license
  name "CC BY 4.0"
  url "https://creativecommons.org/licenses/by/4.0/"
senses
  entry
    definition "a customs document listing the contents put on a ship or plane"
    id oewn-06513909-n
    partOfSpeech n
  entry
    definition "clearly revealed to the mind or the senses or judgment"
    examples ("the effects of the drought are apparent to anyone who sees the parched fields" "evident hostility" "manifest disapproval" "patent advantages" "made his meaning plain" "it is plain that he is no reactionary" "in plain view" "a palpable lie")
    id oewn-01622528-s
    partOfSpeech s
    synonyms (apparent evident palpable patent plain unmistakable)
  entry
    definition "provide evidence for; stand as proof of; show by one's behavior, attitude, or external attributes"
    examples ("His high fever attested to his illness" "The buildings in Rome manifest a high level of architectural sophistication" "This decision demonstrates his sense of fairness")
    id oewn-00822637-v
    partOfSpeech v
    synonyms (attest certify demonstrate evidence)
  entry
    definition "record in a ship's manifest"
    examples ("each passenger must be manifested")
    id oewn-01002923-v
    partOfSpeech v
  entry
    definition "reveal its presence or make an appearance"
    examples ("the ghost manifests each year on the same day")
    id oewn-00424028-v
    partOfSpeech v
source "oewn:2024"
