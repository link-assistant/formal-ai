  "senses": [
    {
      "id": "oewn-05704390-n",
      "partOfSpeech": "n",
      "definition": "a person or thing that takes or can take the place of another",
      "synonyms": [
        "replacement"
      ]
    },
    {
      "id": "oewn-10690481-n",
      "partOfSpeech": "n",
      "definition": "an athlete who plays only when a starter on the team is replaced",
      "synonyms": [
        "reserve",
        "second-stringer"
      ]
    },
    {
      "id": "oewn-10667676-n",
      "partOfSpeech": "n",
      "definition": "someone who takes the place of another (as when things get dangerous or difficult)",
      "examples": [
        "the star had a stand-in for dangerous scenes",
        "we need extra employees for summer fill-ins"
      ],
      "synonyms": [
        "stand-in",
        "relief",
        "reliever",
        "backup",
        "fill-in"
      ]
    },
    {
      "id": "oewn-01861341-s",
      "partOfSpeech": "s",
      "definition": "capable of substituting in any of several positions on a team",
      "examples": [
        "a utility infielder"
      ],
      "synonyms": [
        "utility"
      ]
    },
    {
      "id": "oewn-01859862-s",
      "partOfSpeech": "s",
      "definition": "serving or used in place of another",
      "examples": [
        "an alternative plan"
      ],
      "synonyms": [
        "alternate",
        "alternative"
      ]
    },
    {
      "id": "oewn-01577367-s",
      "partOfSpeech": "s",
      "definition": "artificial and inferior",
      "examples": [
        "ersatz coffee",
        "substitute coffee"
      ],
      "synonyms": [
        "ersatz"
      ]
    },
    {
      "id": "oewn-02262575-v",
      "partOfSpeech": "v",
      "definition": "put in the place of another; switch seemingly equivalent items",
      "examples": [
        "the con artist replaced the original with a fake Rembrandt",
        "substitute regular milk for fat-free milk",
        "synonyms can be interchanged without changing the context's meaning"
      ],
      "synonyms": [
        "replace",
        "interchange",
        "exchange"
      ]
    },
    {
      "id": "oewn-02263424-v",
      "partOfSpeech": "v",
      "definition": "be a substitute",
      "examples": [
        "The young teacher had to substitute for the sick colleague",
        "The skim milk substitutes for cream — we are on a strict diet"
      ],
      "synonyms": [
        "sub",
        "stand in",
        "fill in"
      ]
    },
    {
      "id": "oewn-02399804-v",
      "partOfSpeech": "v",
      "definition": "act as a substitute",
      "examples": [
        "She stood in for the soprano who suffered from a cold"
      ],
      "synonyms": [
        "deputize",
        "deputise",
        "step in"
      ]
    }
  ]
}
