language en
lemma patch
license
  name "CC BY 4.0"
  url "https://creativecommons.org/licenses/by/4.0/"
senses
  entry
    definition "a small contrasting part of something"
    examples ("a bald spot" "a leopard's spots" "a patch of clouds" "patches of thin ice" "a fleck of red")
    id oewn-04689819-n
    partOfSpeech n
    synonyms (spot speckle dapple fleck maculation)
  entry
    definition "a small area of ground covered by specific vegetation"
    examples ("a bean plot" "a cabbage patch" "a briar patch")
    id oewn-08692477-n
    partOfSpeech n
    synonyms (plot "plot of land" "plot of ground")
  entry
    definition "a piece of cloth used as decoration or to mend or cover a hole"
    id oewn-03903640-n
    partOfSpeech n
  entry
    definition "a period of indeterminate length (usually short) marked by some action or condition"
    examples ("he was here for a little while" "I need to rest for a piece" "a spell of good weather" "a patch of bad weather")
    id oewn-15271164-n
    partOfSpeech n
    synonyms (while piece spell)
  entry
    definition "a short set of commands to correct a bug in a computer program"
    id oewn-06585399-n
    partOfSpeech n
  entry
    definition "a connection intended to be used for a limited time"
    id oewn-04416006-n
    partOfSpeech n
    synonyms ("temporary hookup")
  entry
    definition "sewing that repairs a worn or torn hole (especially in a garment)"
    examples ("her stockings had several mends")
    id oewn-03750776-n
    partOfSpeech n
    synonyms (mend darn)
  entry
    definition "a protective cloth covering for an injured eye"
    id oewn-03314301-n
    partOfSpeech n
    synonyms (eyepatch)
  entry
    definition "a piece of soft material that covers and protects an injured part of the body"
    id oewn-02788671-n
    partOfSpeech n
    synonyms (bandage)
  entry
    definition "to join or unite the pieces of"
    examples ("patch the skirt")
    id oewn-01593092-v
    partOfSpeech v
    synonyms (piece)
  entry
    definition "provide with a patch; also used metaphorically"
    examples ("The field was patched with snow")
    id oewn-02362692-v
    partOfSpeech v
  entry
    definition "mend by putting a patch on"
    examples ("patch a hole")
    id oewn-00263589-v
    partOfSpeech v
    synonyms ("patch up")
  entry
    definition "repair by adding pieces"
    examples ("She pieced the china cup")
    id oewn-00262591-v
    partOfSpeech v
    synonyms (piece)
source "oewn:2024"
