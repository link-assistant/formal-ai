    {
      "id": "oewn-06516453-n",
      "partOfSpeech": "n",
      "definition": "a brief written record",
      "examples": [
        "he made a note of the appointment"
      ]
    },
    {
      "id": "oewn-06638793-n",
      "partOfSpeech": "n",
      "definition": "a short personal letter",
      "examples": [
        "drop me a line when you get there"
      ],
      "synonyms": [
        "short letter",
        "line",
        "billet"
      ]
    },
    {
      "id": "oewn-06878395-n",
      "partOfSpeech": "n",
      "definition": "a notation representing the pitch and duration of a musical sound",
      "examples": [
        "the singer held the note too long"
      ],
      "synonyms": [
        "musical note",
        "tone"
      ]
    },
    {
      "id": "oewn-07097011-n",
      "partOfSpeech": "n",
      "definition": "a tone of voice that shows what the speaker is feeling",
      "examples": [
        "there was a note of uncertainty in his voice"
      ]
    },
    {
      "id": "oewn-04734952-n",
      "partOfSpeech": "n",
      "definition": "a characteristic emotional quality",
      "examples": [
        "it ended on a sour note",
        "there was a note of gaiety in her manner",
        "he detected a note of sarcasm"
      ]
    },
    {
      "id": "oewn-13414935-n",
      "partOfSpeech": "n",
      "definition": "a piece of paper money (especially one issued by a central bank)",
      "examples": [
        "he peeled off five one-thousand-zloty notes"
      ],
      "synonyms": [
        "bill",
        "government note",
        "bank bill",
        "banker's bill",
        "bank note",
        "banknote",
        "Federal Reserve note",
        "greenback"
      ]
    },
    {
      "id": "oewn-06775984-n",
      "partOfSpeech": "n",
      "definition": "a comment or instruction (usually added)",
      "examples": [
        "his notes were appended at the end of the article",
        "he added a short notation to the address on the envelope"
      ],
      "synonyms": [
        "annotation",
        "notation"
      ]
    },
    {
      "id": "oewn-14458911-n",
      "partOfSpeech": "n",
      "definition": "high status importance owing to marked superiority",
      "examples": [
        "a scholar of great eminence"
      ],
      "synonyms": [
        "eminence",
        "distinction",
        "preeminence"
      ]
    },
    {
      "id": "oewn-13419642-n",
      "partOfSpeech": "n",
      "definition": "a promise to pay a specified amount on demand or at a certain time",
      "examples": [
        "I had to co-sign his note at the bank"
      ],
      "synonyms": [
        "promissory note",
        "note of hand"
      ]
    },
    {
      "id": "oewn-01022014-v",
      "partOfSpeech": "v",
      "definition": "make mention of",
      "examples": [
        "She observed that his presentation took up too much time",
        "They noted that it was a fine day to go sailing"
      ],
      "synonyms": [
        "observe",
        "mention",
        "remark"
      ]
    },
    {
      "id": "oewn-02122959-v",
      "partOfSpeech": "v",
      "definition": "notice or perceive",
      "examples": [
        "She noted that someone was following her",
        "mark my words"
      ],
      "synonyms": [
        "notice",
        "mark"
      ]
    },
    {
      "id": "oewn-02123398-v",
      "partOfSpeech": "v",
