      "examples": [
        "Take note of this chemical reaction"
      ],
      "synonyms": [
        "take note",
        "observe"
      ]
    },
    {
      "id": "oewn-01022943-v",
      "partOfSpeech": "v",
      "definition": "make a written note of",
      "examples": [
