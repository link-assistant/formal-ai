language en
lemma high
license
  name "CC BY 4.0"
  url "https://creativecommons.org/licenses/by/4.0/"
senses
  entry
    definition "greater than normal in quantity or amount"
    examples ("a high temperature" "a high price" "the high point of his career" "high risks" "has high hopes" "the river is high" "he has a high opinion of himself")
    id oewn-01213526-a
    partOfSpeech a
  entry
    definition "(literal meaning) being at or having a relatively great or specific elevation or upward extension (sometimes used in combinations like ‘knee-high’)"
    examples ("a high mountain" "high ceilings" "high buildings" "a high forehead" "a high incline" "a foot high")
    id oewn-01207229-a
    partOfSpeech a
  entry
    definition "used of sounds and voices; high in pitch or frequency"
    id oewn-01215869-a
    partOfSpeech a
    synonyms (high-pitched)
  entry
    definition "a lofty level or position or degree"
    examples ("summer temperatures reached an all-time high")
    id oewn-05104798-n
    partOfSpeech n
  entry
    definition "an air mass of higher than normal pressure"
    examples ("the east coast benefits from a Bermuda high")
    id oewn-14544272-n
    partOfSpeech n
  entry
    definition "a state of sustained elation"
    examples ("I'm on a permanent high these days")
    id oewn-14429025-n
    partOfSpeech n
  entry
    definition "a state of altered consciousness induced by alcohol or narcotics"
    examples ("they took drugs to get a high on")
    id oewn-14428856-n
    partOfSpeech n
  entry
    definition "a high place"
    examples ("they stood on high and observed the countryside" "he doesn't like heights")
    id oewn-08602145-n
    partOfSpeech n
    synonyms (heights)
  entry
    definition "a public secondary school usually including grades 9 through 12"
    examples ("he goes to the neighborhood highschool")
    id oewn-08426574-n
    partOfSpeech n
    synonyms ("senior high school" "senior high" highschool "high school")
  entry
    definition "a forward gear with a gear ratio that gives the greatest vehicle velocity for a given engine speed"
    id oewn-03523794-n
    partOfSpeech n
    synonyms ("high gear")
  entry
    definition "at a great altitude"
    examples ("he climbed high on the ladder")
    id oewn-00358753-r
