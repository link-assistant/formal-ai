function_test_contracts
  purpose "Add one synthesized function to a source module and a test of it to a test module. Slots are bound from the request, the synthesized program and the value its specification computes; no task answers live here."
  language javascript
    source "https://nodejs.org/api/test.html"
    definition "export function {name}("
    import "import { {names} } from '{specifier}';"
    header "import { test } from 'node:test';\nimport assert from 'node:assert/strict';\n"
    case "\ntest('{name}', () => {\n  assert.equal({name}({arguments}), {expected});\n});\n"
    run "node --test {test}"
    probe "node --input-type=module -e \"import { {name} } from './{module}'; console.log({name}({arguments}));\""
    samples "2 3 4 5 6 7"
