bounded-command-capture-source
  line "async function boundedCommand(file, argumentsValue = [], options = {}) {"
  line "  const { spawn } = await import('node:child_process');"
  line "  const started = process.hrtime.bigint();"
  line "  const timeout = options.timeout;"
  line "  const stdoutLimit = options.stdoutLimitBytes ?? options.maxBuffer ?? 1024 * 1024;"
  line "  const stderrLimit = options.stderrLimitBytes ?? options.maxBuffer ?? 1024 * 1024;"
  line "  const stdoutObserver = options.onStdout, stderrObserver = options.onStderr;"
  line "  const grace = 250, terminationGrace = options.terminationGraceMs ?? 0, abortSignal = options.signal;"
  line "  if (!Number.isSafeInteger(terminationGrace) || terminationGrace < 0 || terminationGrace > 30000"
  line "      || (abortSignal !== undefined && typeof abortSignal?.addEventListener !== 'function')) {"
  line "    throw new TypeError('invalid_command_cancellation');"
  line "  }"
  line "  if ((stdoutObserver !== undefined && typeof stdoutObserver !== \"function\")"
  line "      || (stderrObserver !== undefined && typeof stderrObserver !== \"function\")"
  line "      || !Number.isFinite(timeout) || timeout <= 0 || timeout > 2147482647"
  line "      || !Number.isSafeInteger(stdoutLimit) || stdoutLimit < 0"
  line "      || !Number.isSafeInteger(stderrLimit) || stderrLimit < 0) {"
  line "    throw new TypeError('invalid_command_bounds');"
  line "  }"
  line "  return new Promise((resolve) => {"
  line "    let child;"
  line "    let status = null;"
  line "    let signal = null;"
  line "    let failure = null;"
  line "    let timedOut = false;"
  line "    let exited = false;"
  line "    let stdinComplete = options.input == null;"
  line "    let stdoutComplete = stdoutLimit === 0 && !stdoutObserver;"
  line "    let stderrComplete = stderrLimit === 0 && !stderrObserver;"
  line "    let settled = false;"
  line "    let cleanupTimer;"
  line "    let terminationTimer;"
  line "    let deadlineTimer;"
  line "    const stdout = [];"
  line "    const stderr = [];"
  line "    let stdoutBytes = 0;"
  line "    let stderrBytes = 0;"
  line "    const complete = () => exited && stdinComplete && stdoutComplete && stderrComplete;"
  line "    const makeError = (code) => Object.assign(new Error(code), { code });"
  line "    const kill = (stopSignal = 'SIGKILL') => {"
  line "      if (!child?.pid) return;"
  line "      if (process.platform !== 'win32') {"
  line "        try { process.kill(-child.pid, stopSignal); } catch {}"
  line "      }"
  line "      try { child.kill(stopSignal); } catch {}"
  line "    };"
  line "    const finish = (cleanupComplete) => {"
  line "      if (settled) return;"
  line "      settled = true;"
  line "      kill();"
  line "      if (cleanupComplete && options.childSignal) Atomics.store(options.childSignal, 0, 0);"
  line "      clearTimeout(deadlineTimer);"
  line "      clearTimeout(cleanupTimer);"
  line "      clearTimeout(terminationTimer);"
  line "      abortSignal?.removeEventListener('abort', abort);"
  line "      if (!cleanupComplete) { failure ??= makeError('ECLEANUP'); child?.unref(); }"
  line "      child?.stdin?.destroy();"
  line "      child?.stdout?.destroy();"
  line "      child?.stderr?.destroy();"
  line "      let out = Buffer.concat(stdout, stdoutBytes);"
  line "      let err = Buffer.concat(stderr, stderrBytes);"
  line "      if (options.encoding && options.encoding !== 'buffer') {"
  line "        out = out.toString(options.encoding);"
  line "        err = err.toString(options.encoding);"
  line "      }"
  line "      resolve({ pid: child?.pid ?? 0, status, signal, stdout: out, stderr: err,"
  line "        output: [null, out, err], error: failure ?? undefined,"
  line "        timed_out: timedOut, cleanup_complete: cleanupComplete,"
  line "        elapsedNs: process.hrtime.bigint() - started });"
  line "    };"
  line "    const check = () => {"
  line "      if (complete()) finish(true);"
  line "    };"
  line "    const stop = (error) => {"
  line "      if (settled) return;"
  line "      if (complete() && !failure) { finish(true); return; }"
  line "      failure ??= error;"
  line "      const force = () => {"
  line "        kill();"
  line "        cleanupTimer ??= setTimeout(() => finish(complete()), grace);"
  line "      };"
  line "      if (terminationGrace > 0) {"
  line "        if (!terminationTimer) { kill('SIGTERM'); terminationTimer = setTimeout(force, terminationGrace); }"
  line "      } else force();"
  line "      child?.stdin?.destroy();"
  line "      stdinComplete = true;"
  line "      check();"
  line "    };"
  line "    const abort = () => stop(makeError('ECANCELLED'));"
  line "    try {"
  line "      child = spawn(file, argumentsValue, {"
  line "        cwd: options.cwd, env: options.env, windowsHide: true,"
  line "        detached: process.platform !== 'win32',"
  line "        stdio: [options.input == null ? 'ignore' : 'pipe',"
  line "          stdoutLimit === 0 && !stdoutObserver ? 'ignore' : 'pipe', stderrLimit === 0 && !stderrObserver ? 'ignore' : 'pipe'],"
  line "      });"
  line "      if (options.childSignal) Atomics.store(options.childSignal, 0, child.pid ?? 0);"
  line "    } catch (error) {"
  line "      failure = error;"
  line "      exited = stdinComplete = stdoutComplete = stderrComplete = true;"
  line "      finish(true);"
  line "      return;"
  line "    }"
  line "    const stream = (pipe, isStdout, limit) => {"
  line "      if (!pipe) return;"
  line "      pipe.on('data', (chunk) => {"
  line "        if (settled) return;"
  line "        try {"
  line "          const observed = (isStdout ? stdoutObserver : stderrObserver)?.(chunk);"
  line "          if (observed?.then) throw makeError('EASYNC_OUTPUT_OBSERVER');"
  line "        } catch (error) { stop(error); return; }"
  line "        if (limit === 0) return;"
  line "        const used = isStdout ? stdoutBytes : stderrBytes;"
  line "        const accepted = Math.min(limit - used, chunk.length);"
  line "        if (accepted > 0) {"
  line "          const copy = Buffer.from(chunk.subarray(0, accepted));"
  line "          if (isStdout) { stdout.push(copy); stdoutBytes += accepted; }"
  line "          else { stderr.push(copy); stderrBytes += accepted; }"
  line "        }"
  line "        if (accepted !== chunk.length) stop(makeError('ENOBUFS'));"
  line "      });"
  line "      pipe.once('end', () => {"
  line "        if (isStdout) stdoutComplete = true;"
  line "        else stderrComplete = true;"
  line "        check();"
  line "      });"
  line "      pipe.once('error', (error) => stop(error));"
  line "    };"
  line "    stream(child.stdout, true, stdoutLimit);"
  line "    stream(child.stderr, false, stderrLimit);"
  line "    child.once('error', (error) => {"
  line "      failure ??= error;"
  line "      if (!child.pid) {"
  line "        exited = stdinComplete = stdoutComplete = stderrComplete = true;"
  line "        finish(true);"
  line "      } else stop(error);"
  line "    });"
  line "    child.once('exit', (code, observedSignal) => {"
  line "      status = code;"
  line "      signal = observedSignal;"
  line "      exited = true;"
  line "      check();"
  line "    });"
  line "    deadlineTimer = setTimeout(() => {"
  line "      if (complete()) { finish(true); return; }"
  line "      timedOut = true;"
  line "      stop(makeError('ETIMEDOUT'));"
  line "    }, Math.max(0, timeout - Number(process.hrtime.bigint() - started) / 1e6));"
  line "    abortSignal?.addEventListener('abort', abort, {once:true});"
  line "    if (abortSignal?.aborted) abort();"
  line "    if (child.stdin) {"
  line "      child.stdin.once('error', (error) => stop(error));"
  line "      child.stdin.end(options.input, () => { stdinComplete = true; check(); });"
  line "    }"
  line "    check();"
  line "  });"
  line "}"
