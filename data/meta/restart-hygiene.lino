restart-hygiene
  version "1"
  evidence-root "dev/log/self-authored/"
  empty-evidence-suffix "-stream.jsonl"
  empty-evidence-suffix "/session-id.txt"
  output-flag "-o"
  output-flag "-d"
  output-flag "--output"
  binary-prefix "7f454c46"
  binary-prefix "504b0304"
  binary-prefix "504b0506"
  binary-prefix "cafebabe"
  binary-prefix "cffaedfe"
  binary-prefix "cefaedfe"
  binary-prefix "feedfacf"
  binary-prefix "feedface"
  binary-prefix "4d5a"
  command "command -v python3 >/dev/null 2>&1 && python3 -c {source} {plan}"
  untrack-command "git rm --cached --ignore-unmatch -- {files}"
  clean-command "test -z \"$(git status --porcelain --untracked-files=all)\""
  index-guard-command "git diff --cached --quiet -- . {exclude}"
  status-command "git status --porcelain --untracked-files=all"
  scope-refusal "Prepared work remains incomplete: current Git changes extend beyond the previous explicit file/directory scopes, or the fresh status listing is not safely parseable."
  commit-command "{guard} && git add -- {files} && {guard} && (if git diff --cached --quiet; then echo __formal_ai_commit_unchanged; else git commit -q -m {subject} -m {body}; fi) && __formal_ai_push_ref={branch} && if test -n \"$(git symbolic-ref --quiet --short HEAD)\"; then if test \"$__formal_ai_push_ref\" = HEAD; then __formal_ai_push_ref=$(git branch --show-current); fi; else exit 1; fi && test -n \"$__formal_ai_push_ref\" && git push -q origin \"$__formal_ai_push_ref\" && git rev-parse HEAD"
  source-line "import json"
  source-line "import os"
  source-line "import pathlib"
  source-line "import secrets"
  source-line "import stat"
  source-line "import sys"
  source-line ""
  source-line "MAXIMUM_FILE_BYTES = 16 * 1024 * 1024"
  source-line "plan = json.loads(sys.argv[1])"
  source-line "root = pathlib.Path.cwd()"
  source-line ""
  source-line ""
  source-line "def owned_path(value):"
  source-line "    if not isinstance(value, str) or not value or '\\x00' in value:"
  source-line "        raise ValueError('invalid_owned_path')"
  source-line "    relative = pathlib.PurePosixPath(value)"
  source-line "    if relative.is_absolute() or pathlib.PureWindowsPath(value).drive or '..' in relative.parts or str(relative) != value:"
  source-line "        raise ValueError('invalid_owned_path')"
  source-line "    current = root"
  source-line "    for part in relative.parts:"
  source-line "        current = current / part"
  source-line "        if current.is_symlink():"
  source-line "            raise ValueError('symbolic_owned_path')"
  source-line "    return current"
  source-line ""
  source-line ""
  source-line "def read_regular(path, limit):"
  source-line "    descriptor = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))"
  source-line "    with os.fdopen(descriptor, 'rb') as stream:"
  source-line "        before = os.fstat(stream.fileno())"
  source-line "        if not stat.S_ISREG(before.st_mode) or before.st_size > limit:"
  source-line "            raise ValueError('unbounded_owned_file')"
  source-line "        data = stream.read(limit + 1)"
  source-line "        after = os.fstat(stream.fileno())"
  source-line "    current = os.lstat(path)"
  source-line "    identity = lambda value: (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_mode)"
  source-line "    if len(data) > limit or identity(before) != identity(after) or identity(after) != identity(current):"
  source-line "        raise ValueError('owned_file_changed')"
  source-line "    return data, identity(current)"
  source-line ""
  source-line ""
  source-line "if len(plan['files']) > 256 or len(plan['outputs']) > 256:"
  source-line "    raise ValueError('hygiene_plan_limit')"
  source-line "outputs = {}"
  source-line "for entry in plan['outputs']:"
  source-line "    outputs.setdefault(entry['output'], []).append(entry['source'])"
  source-line "ignored = []"
  source-line "for value in plan['files']:"
  source-line "    path = owned_path(value)"
  source-line "    if not path.exists():"
  source-line "        continue"
  source-line "    data, _ = read_regular(path, MAXIMUM_FILE_BYTES)"
  source-line "    sources = outputs.get(value)"
  source-line "    if sources is not None:"
  source-line "        owners = [source for source in sources if source != value and owned_path(source).exists()]"
  source-line "        if len(set(owners)) != 1:"
  source-line "            raise ValueError('missing_or_ambiguous_compiler_source_owner')"
  source-line "        source_path = owned_path(owners[0])"
  source-line "        source_bytes, _ = read_regular(source_path, MAXIMUM_FILE_BYTES)"
  source-line "        source_bytes.decode('utf-8', 'strict')"
  source-line "        # A documented output operand is necessary but never sufficient to hide"
  source-line "        # a source text or arbitrary asset under that operand's spelling."
  source-line "        if not any(data.startswith(bytes.fromhex(prefix)) for prefix in plan['binary-prefixes']):"
  source-line "            raise ValueError('unproven_compiler_output')"
  source-line "        ignored.append(value)"
  source-line "    elif value.startswith(plan['evidence-root']) and value.endswith(tuple(plan['empty-evidence-suffixes'])):"
  source-line "        if data:"
  source-line "            raise ValueError('nonempty_evidence_requires_explicit_content_policy')"
  source-line "        ignored.append(value)"
  source-line "    elif b'\\x00' in data or any(data.startswith(bytes.fromhex(prefix)) for prefix in plan['binary-prefixes']):"
  source-line "        raise ValueError('unowned_binary_cannot_be_staged')"
  source-line "    else:"
  source-line "        data.decode('utf-8', 'strict')"
  source-line ""
  source-line "expected = plan['ignored']"
  source-line "if ignored != expected:"
  source-line "    raise ValueError('hygiene_classification_changed')"
  source-line "ignore_path = owned_path('.gitignore')"
  source-line "original = b''"
  source-line "identity = None"
  source-line "if ignore_path.exists():"
  source-line "    original, identity = read_regular(ignore_path, MAXIMUM_FILE_BYTES)"
  source-line ""
  source-line "def ignore_line(value):"
  source-line "    escaped = ''.join('\\\\' + character if character in '\\\\*?[]!# ' else character for character in value)"
  source-line "    return ('/' + escaped).encode('utf-8')"
  source-line ""
  source-line "lines = original.splitlines()"
  source-line "additions = [ignore_line(value) for value in ignored if ignore_line(value) not in lines]"
  source-line "if additions:"
  source-line "    updated = original + (b'\\n' if original and not original.endswith(b'\\n') else b'')"
  source-line "    updated += b'\\n'.join(additions) + b'\\n'"
  source-line "    if len(updated) > MAXIMUM_FILE_BYTES:"
  source-line "        raise ValueError('ignore_file_limit')"
  source-line "    temporary = root / ('.formal-ai-ignore-' + secrets.token_hex(12))"
  source-line "    try:"
  source-line "        with open(temporary, 'xb') as stream:"
  source-line "            if stream.write(updated) != len(updated):"
  source-line "                raise OSError('ignore_write_incomplete')"
  source-line "            if identity is not None:"
  source-line "                os.fchmod(stream.fileno(), stat.S_IMODE(identity[4]))"
  source-line "            stream.flush()"
  source-line "            os.fsync(stream.fileno())"
  source-line "        if identity is None:"
  source-line "            if ignore_path.exists() or ignore_path.is_symlink():"
  source-line "                raise ValueError('ignore_identity_changed')"
  source-line "        else:"
  source-line "            _, current_identity = read_regular(ignore_path, MAXIMUM_FILE_BYTES)"
  source-line "            if identity != current_identity:"
  source-line "                raise ValueError('ignore_identity_changed')"
  source-line "        os.replace(temporary, ignore_path)"
  source-line "    finally:"
  source-line "        if temporary.exists():"
  source-line "            temporary.unlink()"
  source-line "print(json.dumps({'ignored': ignored, 'physical_bytes_preserved': True}, sort_keys=True))"
