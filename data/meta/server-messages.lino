# The wording the JavaScript server answers with, keyed by language-neutral id.
#
# Each `text` is the exact string the Rust server writes for the same case
# (the literals in rust/src/server.rs and the modules it calls), so a client
# sees one message whichever server it reaches. The JavaScript server
# (js/server/messages.mjs) holds no prose of its own - scripts/check-js-literals.mjs
# keeps its natural-language literal count at zero - and the parity runner
# (scripts/check-server-parity.mjs) compares both servers' bodies, so a Rust
# literal that changes without this file fails CI. `{name}` is a placeholder.
server_messages
  message route_not_found
    text "route not found"
  message bearer_token_invalid
    text "missing or invalid bearer token"
  message mcp_origin_not_allowed
    text "MCP origin is not allowed"
