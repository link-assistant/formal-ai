  unregistered closure-generated-*
    owner "python3 scripts/close-total.py"
    reason "Derived from the other seed files by the total-closure pass, so embedding a snapshot of them would embed the same statements twice."
  unregistered google-trends-*
    owner "src/google_trends_catalog.rs"
    reason "The Google Trends catalog embeds its own prompts and snapshot; the capability owns the data rather than the shared bundle."
  unregistered question-generation-lexicon
    owner "src/question_generation.rs"
    reason "Question generation embeds its own lexicon so the words it may use are scoped to the one module that may use them."
  unregistered roles
    owner "scripts/generate-role-registry.py"
    reason "The reserved-role registry is generated from the other seed files and read from disk by the audits, never bundled."
  unregistered search-fusion-language-grammar
    owner "src/search_fusion_grammar.rs"
    reason "The per-language query grammar is embedded by the search-fusion module that parses it."
