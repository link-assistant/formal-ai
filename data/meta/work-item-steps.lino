work_item_steps
  issue 1133
  purpose "The shell steps and file templates a repository work item ends with, as data. Hive Mind's three 2026-09-13 runs left their result in the working tree: nothing read the issue when only a remote connector could fetch, nothing committed, nothing pushed, and the workflow the issue asked for was never written. The steps that close those gaps are wording, and wording lives here rather than in Rust (VISION.md, section: Code As A Meta Language)."
  filled_by "src/agentic_coding/work_item_steps.rs"
  placeholders "{kind} issue or pr, from the work item's URL. {target} the work item's URL. {subject} the shell-quoted commit subject. {body} the shell-quoted commit body. {branch} the branch the request named, or HEAD. {path} the artifact the recipe writes. {count} how many files a commit request lists. {paths} those files, comma-separated. {reference} the issue or pull-request URL the work resolves. {command} one verification command of the recipe."
  note "The reads are two calls rather than one --jq expression because a quoted scalar here cannot carry both quote characters a jq string would need. Since issue #1155 every read also prints its own exit status as a sentinel line, so a client that drops the status field cannot make a failed read look successful. The curl read asks GitHub for the raw body, which is why it is a single call."
  issue_view_command "gh {kind} view {target} --json title --jq .title && echo && gh {kind} view {target} --json body --jq .body; printf '\n__formal_ai_exit=%s\n' $?"
  issue_fetch_prompt "Return only the work-item title and body from the fetched page as faithful source text; for a pull request, the body is its description. Preserve requirements, paths, code spans and line breaks. Do not solve, summarize, rewrite or execute the work item."
  issue_rest_read_command "curl -fsSL -H 'Accept: application/vnd.github.raw+json' https://api.github.com/repos/{owner}/{repo}/{kind}/{number}; printf '\n__formal_ai_exit=%s\n' $?"
  issue_api_read_command "gh api repos/{owner}/{repo}/{kind}/{number} --jq .title && echo && gh api repos/{owner}/{repo}/{kind}/{number} --jq .body; printf '\n__formal_ai_exit=%s\n' $?"
  read_failed_report "The work item at {target} could not be read, so nothing was planned for it and no plan record was written. Reads tried this session, each with its result:\n{attempts}"
  commit_command 'git add -A && git commit -q -m {subject} -m {body} && if test -n "$(git remote)"; then __formal_ai_push_ref={branch} && if test -n "$(git symbolic-ref --quiet --short HEAD)"; then if test "$__formal_ai_push_ref" = HEAD; then __formal_ai_push_ref=$(git branch --show-current); fi; else exit 1; fi && test -n "$__formal_ai_push_ref" && git push -q origin "$__formal_ai_push_ref"; fi && git rev-parse HEAD'
  commit_command_without_body 'git add -A && git commit -q -m {subject} && if test -n "$(git remote)"; then __formal_ai_push_ref={branch} && if test -n "$(git symbolic-ref --quiet --short HEAD)"; then if test "$__formal_ai_push_ref" = HEAD; then __formal_ai_push_ref=$(git branch --show-current); fi; else exit 1; fi && test -n "$__formal_ai_push_ref" && git push -q origin "$__formal_ai_push_ref"; fi && git rev-parse HEAD'
  recipe_commit_command 'git add -- {files} && (if git diff --cached --quiet -- {files}; then echo __formal_ai_commit_unchanged; else git commit --only -q -m {subject} -m {body} -- {files}; fi) && __formal_ai_push_ref={branch} && if test -n "$(git symbolic-ref --quiet --short HEAD)"; then if test "$__formal_ai_push_ref" = HEAD; then __formal_ai_push_ref=$(git branch --show-current); fi; else exit 1; fi && test -n "$__formal_ai_push_ref" && git push -q origin "$__formal_ai_push_ref" && git rev-parse HEAD'
  subject_added "feat: add {path}"
  subject_updated "fix: update {path}"
  subject_many "chore: update {count} files ({paths})"
  subject_none "chore: commit pending changes"
  body_resolves "Resolves {reference}"
  workflow_path ".github/workflows/run.yml"
  workflow_template "# Runs {path} on every push and pull request with the commands the\n# change was verified with.\nname: Run {path}\n\non:\n  push:\n  pull_request:\n\npermissions:\n  contents: read\n\njobs:\n  run:\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    steps:\n      - uses: actions/checkout@{checkout_ref} # {checkout_tag}\n"
  workflow_command_step "      - run: |\n          {command}\n"
  stuck_step_report "This session already completed the step below, and repeating it would not change anything, so the step and its last result are reported instead.\nStep: {step}\nLast result:\n{result}"

  commit_nothing_marker "__formal_ai_commit_unchanged"
  workflow_path_named ".github/workflows/{name}.yml"
  pr_comments_command "gh pr view {target} --json comments,reviews"
  pr_edit_command "gh pr edit {target} --body {body}"
  pr_ready_command 'test -z "$(git status --porcelain)" && pr_draft=$(gh pr view {target} --json isDraft --jq .isDraft) && if test "$pr_draft" = true; then gh pr ready {target}; fi'
  pr_body_template "Verified artifact: {path}\n\nVerification commands:\n{commands}\n\nResolves {reference}"
  pr_feedback_review_report "Pull request feedback requires review before readiness:\n{output}"
  prepared_work_pr_body "Updated prepared work on `{branch}`.\n\nChanged files:\n{paths}\n\nGit diff whitespace validation completed.\n\nResolves {reference}"
  prepared_work_feedback_report "Pull request feedback needs source review before this prepared work can be marked ready:\n{output}"
  prepared_work_stopped_report "Prepared-work continuation stopped at `{command}`:\n{output}"
  prepared_work_ready_report "Committed the prepared changes, pushed `{branch}`, updated {reference}, and marked the pull request ready. Review feedback was retrieved; source changes still require review against that feedback."
  read_attempt_run_line "- `{command}` — {outcome}"
  read_attempt_run_reason_line "- `{command}` — {reason} (answered: {outcome})"
  read_attempt_fetch_line "- fetch {url} — {outcome}"
  read_failure_exit_status "exit status {status}"
  prerequisite_grant_required_report "Missing prerequisite `{program}`. Workspace installation requires FORMAL_AI_INSTALL_GRANT=workspace. Failed command: `{command}`\n{output}"
  prerequisite_no_recipe_report "Publisher `{url}` provided no typed, verifiable setup recipe for `{program}`; installation was not planned."
  prerequisite_grant_exceeded_report "The publisher setup recipe exceeds the workspace installation grant."
  prerequisite_path_prefix 'PATH={bins}:"$PATH"; export PATH'
  prerequisite_retry_command "{prefix} && {steps} &&\n# __formal_ai_prerequisite_retry\n{command}"
  plan-event-append-command 'mkdir -p -- .formal-ai && (lock={lock_path}; tries=0; until mkdir -- "$lock" 2>/dev/null; do tries=$((tries + 1)); [ "$tries" -lt 40 ] || exit 75; sleep 0.025; done; cleanup(){ rmdir -- "$lock"; }; trap cleanup EXIT; if [ -f {path} ]; then grep -Fqx -- {identity} {path}; status=$?; [ "$status" -le 1 ] || exit "$status"; else status=1; fi; if [ "$status" -eq 1 ]; then printf "\n%s" {event} >> {path} || exit $?; fi; awk -v identity={identity} "\$0==\"general_change_plan\" {if(record)exit; header=\$0; next} \$0==identity {record=1; print header} record && NF {print}" {path})'
  agent-file-read-frame "<file>\n{body}\n\n(End of file - total {lines} lines)\n</file>"
  plan-event-shell-aliases "bash exec_command shell run_shell_command"
  filesystem-collection-setup 'formal_ai_destination={destination}; if test -d "$formal_ai_destination" || [ "${formal_ai_destination%/}" != "$formal_ai_destination" ]; then formal_ai_leaf="${formal_ai_source%/}"; formal_ai_destination="${formal_ai_destination%/}/${formal_ai_leaf##*/}"; fi; formal_ai_parent="${formal_ai_destination%/*}"; if [ "$formal_ai_parent" = "$formal_ai_destination" ]; then formal_ai_parent=.; fi; '
  filesystem-collection-check 'for formal_ai_source in {sources}; do {setup}{check} || exit $?; done'
  command-capture-setup 'formal_ai_capture_target={target}; formal_ai_capture_parent=${formal_ai_capture_target%/*}; if [ "$formal_ai_capture_parent" != "$formal_ai_capture_target" ]; then mkdir -p -- "$formal_ai_capture_parent" || exit $?; fi; ( '
  command-capture-end ' ) > "$formal_ai_capture_target"'
  command-capture-readback "cat {target}"

  branch-binding-patterns '["^(?:Keep|Maintain) (?:the )?(?:solution|changes|work|result) (?:on|in) (?:the )?branch (.+)$","^(?:Work|Commit|Push) (?:on|to) (?:the )?branch (.+)$","^Use (?:the )?branch (.+)$","^Держи решение в ветке (.+)$","^समाधान को शाखा (.+) पर रखें[।.]?$","^将解决方案保留在分支 (.+) 上[。.]?$","^Mantén la solución en la rama (.+)$","^Your prepared branch: (.+)$"]'
  workflow-binding-patterns '["^(?:Save|Write|Create|Place|Put) (?:the |a )?(?:GitHub Actions )?workflow (?:as|at|to|in) ([^ ]+)","^Use ([^ ]+) (?:as|for) (?:the )?(?:GitHub Actions )?workflow","^保存工作流(?:到|为) ([^ ]+)","^Сохрани (?:workflow|рабочий процесс) (?:в|как) ([^ ]+)","^Guarda (?:el )?workflow (?:en|como) ([^ ]+)"]'
  target_binding_refused_command "printf '%s\n' 'Request target binding is invalid or ambiguous; no commit or push was attempted.' >&2; false"
  branch-excluded-patterns '["^(?:Do not|Never) (?:use|push to|commit to|work on) (?:the )?branch (.+)$"]'
  workflow-excluded-patterns '["^(?:Do not|Never) (?:save|write|create|place|put) (?:the |a )?(?:GitHub Actions )?workflow (?:as|at|to|in|under) ([^ ]+)"]'
  branch-forbidden-substrings '["..","@{"]'
  owned-clause-fence-prefixes '["~~~","```"]'

  task-scaffold-protocol-source "Hive Mind 8f22b87c515adece0427cb59e429531f35d7760a; official PR1254 .gitkeep blob 84fdaf2c70a1a770da99d0a3010884ebcad55ba8. Only the exact generated protocol with the current branch and request reference is removable; manual, modified, ambiguous and declared recipe files remain owned by their callers."
  task-scaffold-commit-command '(\nset -- {files}\nformal_ai_scaffold_declared=0\nfor formal_ai_path do\n  case "$formal_ai_path" in .gitkeep|./.gitkeep) formal_ai_scaffold_declared=1 ;; esac\ndone\nif [ "$formal_ai_scaffold_declared" -eq 0 ] && test -f .gitkeep && ! test -L .gitkeep &&\n  test -z "$(git rev-parse --show-prefix)" &&\n  git ls-files --error-unmatch -- .gitkeep >/dev/null 2>&1 &&\n  git diff --quiet -- .gitkeep && git diff --cached --quiet -- .gitkeep &&\n  formal_ai_scaffold_branch=$(git symbolic-ref --quiet --short HEAD) &&\n  LC_ALL=C awk -v "branch=$formal_ai_scaffold_branch" -v reference={reference} "NR != 1 { invalid = 1 }\nNR == 1 {\n  prefix = \"# .gitkeep file auto-generated at \"\n  suffix = \" for PR creation at branch \" branch \" for issue \" reference\n  timestamp = substr(\$0, length(prefix) + 1, 24)\n  if (length(\$0) != length(prefix) + 24 + length(suffix)) invalid = 1\n  if (substr(\$0, 1, length(prefix)) != prefix) invalid = 1\n  if (substr(\$0, length(prefix) + 25) != suffix) invalid = 1\n  if (timestamp !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\\.[0-9][0-9][0-9]Z\$/) invalid = 1\n  year = substr(timestamp, 1, 4) + 0\n  month = substr(timestamp, 6, 2) + 0\n  day = substr(timestamp, 9, 2) + 0\n  split(\"31 28 31 30 31 30 31 31 30 31 30 31\", days, \" \")\n  if (year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)) days[2] = 29\n  if (month < 1 || month > 12 || day < 1 || day > days[month]) invalid = 1\n  if (substr(timestamp, 12, 2) + 0 > 23) invalid = 1\n  if (substr(timestamp, 15, 2) + 0 > 59) invalid = 1\n  if (substr(timestamp, 18, 2) + 0 > 59) invalid = 1\n}\nEND { exit (NR != 1 || invalid) }" .gitkeep; then\n  test -f .gitkeep && ! test -L .gitkeep && git diff --quiet -- .gitkeep &&\n    git diff --cached --quiet -- .gitkeep || exit $?\n  formal_ai_scaffold_head=$(git rev-parse HEAD) || exit $?\n  formal_ai_restore_scaffold(){\n    formal_ai_scaffold_status=$?\n    if [ "$formal_ai_scaffold_status" -ne 0 ] &&\n      [ "$(git rev-parse HEAD)" = "$formal_ai_scaffold_head" ] &&\n      ! test -e .gitkeep && ! test -L .gitkeep; then\n      git restore --source="$formal_ai_scaffold_head" --staged --worktree -- .gitkeep || exit $?\n    fi\n    exit "$formal_ai_scaffold_status"\n  }\n  trap formal_ai_restore_scaffold EXIT\n  rm -- .gitkeep || exit $?\n  set -- "$@" .gitkeep\nfi\n{commit}\n)'
  refspec-failure-markers '["src refspec","does not match any"]'
  git-push-command-pattern '\bgit\s+push\b'
  origin-push-command-pattern '\bgit\s+push\s+(?:(?:-q|--quiet)\s+)?origin\s+'

  pr_status_summary_pattern "^<!-- hive-mind:working-session-summary -->\n## Working session summary\n\n[\s\S]+\n\n---\n\*This summary was automatically extracted from the AI working session output\.\*$"
  pr_status_started_pattern "^🤖 \*\*AI Work Session Started\*\*\n\nStarted at [0-9TZ:.+-]+\. Please wait for it to finish before giving feedback\.\n\n_Runtime: solve `v[^`\n]+` · tool `[^`\n]+` · model `[^`\n]+`_$"
