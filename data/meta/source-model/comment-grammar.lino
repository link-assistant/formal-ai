# Compositional documentary-claim grammar, not stored comment answers.
(comment-grammar
 (quantifier (meaning universal) (en "every" "all" "each") (ru "каждый" "все") (hi "हर" "प्रत्येक") (zh "每个" "所有"))
 (quantifier (meaning existential) (en "some" "any" "a" "an") (ru "некоторый") (hi "कोई" "कुछ") (zh "某个" "一些"))
 (determiner (meaning definite) (en "the") (ru "этот") (hi "यह") (zh "该"))
 (modal (meaning obligation) (en "must" "shall") (ru "должен" "должна" "должно" "должны") (hi "अनिवार्य है") (zh "必须"))
 (modal (meaning recommendation) (en "should") (ru "следует") (hi "चाहिए") (zh "应当"))
 (modal (meaning permission) (en "may") (ru "может") (hi "सकता है") (zh "可以"))
 (negation (meaning not) (en "not") (ru "не") (hi "नहीं") (zh "不"))
 (auxiliary (en "does" "do") (ru) (hi) (zh))
 (predicate (meaning produces) (kind relation) (defined-by production)
   (en-finite "returns" "produces") (en-base "return" "produce")
   (ru-finite "возвращает") (ru-base "вернуть") (hi-finite "देता है") (hi-base "देना") (zh-finite "返回" "产生") (zh-base "返回" "产生"))
 (predicate (meaning requires) (kind relation) (defined-by precondition)
   (en-finite "requires") (en-base "require") (ru-finite "требует") (ru-base "требовать") (hi-finite "आवश्यक है") (hi-base "आवश्यक") (zh-finite "需要") (zh-base "需要"))
 (predicate (meaning is-a) (kind classification) (defined-by taxonomic)
   (en-finite "is a" "is an" "is") (en-base "be") (ru-finite "это") (ru-base "быть") (hi-finite "एक प्रकार है") (hi-base "होना") (zh-finite "是一种" "是") (zh-base "是"))
 (predicate (meaning writes) (kind effect) (defined-by (changes (state filesystem) (location object)))
   (en-finite "writes") (en-base "write") (ru-finite "записывает") (ru-base "записать") (hi-finite "लिखता है") (hi-base "लिखना") (zh-finite "写入") (zh-base "写入"))
 (predicate (meaning reads) (kind effect) (defined-by (observes (state filesystem) (location object)))
   (en-finite "reads") (en-base "read") (ru-finite "читает") (ru-base "читать") (hi-finite "पढ़ता है") (hi-base "पढ़ना") (zh-finite "读取") (zh-base "读取"))
 (predicate (meaning throws) (kind effect) (defined-by (abrupt-completion (exception object)))
   (en-finite "throws") (en-base "throw") (ru-finite "выбрасывает") (ru-base "выбросить") (hi-finite "फेंकता है") (hi-base "फेंकना") (zh-finite "抛出") (zh-base "抛出"))
 (predicate (meaning preserves) (kind invariant) (defined-by (equal (before object) (after object)))
   (en-finite "preserves") (en-base "preserve") (ru-finite "сохраняет") (ru-base "сохранить") (hi-finite "संरक्षित करता है") (hi-base "संरक्षित करना") (zh-finite "保留") (zh-base "保留"))
 (type-word (meaning string) (en "string") (ru "строка") (hi "स्ट्रिंग") (zh "字符串"))
 (type-word (meaning number) (en "number") (ru "число") (hi "संख्या") (zh "数字"))
 (type-word (meaning boolean) (en "boolean") (ru "логическое значение") (hi "बूलियन") (zh "布尔值"))
 (layout (language en) (join " ") (order subject-predicate-object) (negative-auxiliary "does") (negative "not"))
 (layout (language ru) (join " ") (order subject-predicate-object) (negative-auxiliary "") (negative "не"))
 (layout (language hi) (join " ") (order subject-object-predicate) (negative-auxiliary "") (negative "नहीं"))
 (layout (language zh) (join "") (order subject-predicate-object) (negative-auxiliary "") (negative "不"))
 (parameter-documentation (syntax jsdoc-simple-param) (tags param arg argument) (owner-overrides file fileoverview module class typedef callback name memberof namespace lends enum constructor ignore) (passive-tags returns return throws deprecated since author version see summary description) (primary-source "https://jsdoc.app/tags-param"))
)
