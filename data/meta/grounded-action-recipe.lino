grounded_action_recipe
  record_type "meta_recipe"
  topic "grounded_action"
  generalization "Apply the same observe, act, verify, widen, and synthesize loop to any tool-backed task by changing meanings, slots, and capability lowering without changing the procedure."
grounded_action_step_meanings
  record_type "meta_step"
  order "1"
  operation "Declare translatable concepts, actions, scopes, kinds, and relation markers as semantic roles."
  invariant "User-language surfaces live in Links Notation seed data."
grounded_action_step_recognize
  record_type "meta_step"
  order "2"
  operation "Recognize the requested action and let explicit object location constrain the route."
  invariant "A specific local scope dominates a generic search verb."
grounded_action_step_slots
  record_type "meta_step"
  order "3"
  operation "Extract scope, target, kind, and requested operation into typed slots."
  invariant "Unrecognized or empty required slots do not produce a guessed action."
grounded_action_step_minimal_plan
  record_type "meta_step"
  order "4"
  operation "Lower the slots to the smallest deterministic tool action."
  invariant "Each planner step emits one simple command."
grounded_action_step_verify
  record_type "meta_step"
  order "5"
  operation "Read the observed tool result and verify it against the requested type and target."
  invariant "An empty observation is evidence for widening, not proof of absence."
grounded_action_step_widen
  record_type "meta_step"
  order "6"
  operation "Widen exact matching to a stable token and then to a bounded inventory only when prior evidence is empty."
  invariant "Every widening stage is bounded, ordered, and visible in the transcript."
grounded_action_step_synthesize
  record_type "meta_step"
  order "7"
  operation "Synthesize the answer from observed evidence, naming scope, mismatch, and uncertainty."
  invariant "Never silently substitute a near match or claim success without evidence."
grounded_action_step_parity
  record_type "meta_step"
  order "8"
  operation "Mirror semantic routing at every runtime boundary and measure generated variations plus a whole-task journey."
  invariant "Rust and JavaScript read the same meanings and preserve the same local-versus-web boundary."
