recipe-resume
  version "1"
  status-command "git status --porcelain --untracked-files=all # __formal_ai_recipe_ci_fallback_status"
  ci-pending-report "Local execution remains unverified because the required toolchain was unavailable. Owned source and workflow evidence have been retained. CI must build, run, and verify every requested requirement before this work can be marked ready. No local verification or full completion is claimed."
  scope-refusal "Prepared recipe remains unverified: fresh status or source ownership is incomplete, or unrelated changes prevent a safe commit. CI verification is still required."
  command "command -v python3 >/dev/null 2>&1 && python3 -c {source} {plan}"
  source-line "path_value = plan['path']"
  source-line "path = owned_path(path_value)"
  source-line "try:"
  source-line "    os.lstat(path)"
  source-line "except FileNotFoundError:"
  source-line "    result = {'schema': 'workspace-source-v1', 'path': path_value, 'success': True,"
  source-line "              'complete': True, 'absent': True, 'error_code': 'ENOENT'}"
  source-line "else:"
  source-line "    data, identity = read_regular(path, MAXIMUM_FILE_BYTES)"
  source-line "    result = {'schema': 'workspace-source-v1', 'path': path_value, 'success': True,"
  source-line "              'complete': True, 'absent': False, 'source': data.decode('utf-8'), 'identity': [str(value) for value in identity], 'sha256': hashlib.sha256(data).hexdigest()}"
  source-line "print(json.dumps(result, ensure_ascii=True))"
  ci-command "command -v node >/dev/null 2>&1 && node --input-type=module -e {source} {plan}"
  ci-verified-report "Owned source and the requested workflow were verified by CI for {head}. Local execution remained unverified; workspace installation was not attempted because managed install-output ownership could not be proven. The pull request is ready."
  ci-verified-local-report "Owned source, local execution, and the requested workflow were verified for {head}. The pull request is ready."
  ci-source-line "const plan = JSON.parse(process.argv[1]);"
  ci-source-line "const deadline = Date.now() + 120000;"
  ci-source-line "const run = async (file, argumentsValue) => {"
  ci-source-line "  const remaining = deadline - Date.now();"
  ci-source-line "  if (remaining <= 0) throw new Error('recipe_ci_deadline');"
  ci-source-line "  const result = await boundedCommand(file, argumentsValue, {"
  ci-source-line "    timeout: remaining, stdoutLimitBytes: 1048576, stderrLimitBytes: 1048576,"
  ci-source-line "    encoding: 'utf8',"
  ci-source-line "  });"
  ci-source-line "  if (result.error || result.signal !== null || !result.cleanup_complete || result.status !== 0) {"
  ci-source-line "    throw Object.assign(new Error('recipe_ci_command_failed'), {"
  ci-source-line "      complete: result.cleanup_complete, status: result.status,"
  ci-source-line "      diagnostic: result.stderr,"
  ci-source-line "    });"
  ci-source-line "  }"
  ci-source-line "  return result.stdout;"
  ci-source-line "};"
  ci-source-line "const readPullRequest = async () => JSON.parse(await run('gh', ["
  ci-source-line "  'pr', 'view', plan.reference, '--json', 'headRefOid,headRefName,isDraft,state,url',"
  ci-source-line "]));"
  ci-source-line "try {"
  ci-source-line "  const head = (await run('git', ['rev-parse', 'HEAD'])).trim();"
  ci-source-line "  const branch = (await run('git', ['branch', '--show-current'])).trim();"
  ci-source-line "  const matches = value => value?.headRefOid === head && value.headRefName === branch"
  ci-source-line "    && value.state === 'OPEN' && value.url === plan.reference && typeof value.isDraft === 'boolean';"
  ci-source-line "  if (!/^[a-f0-9]{40}$/u.test(head) || branch === '') throw new Error('recipe_ci_local_head');"
  ci-source-line "  const before = await readPullRequest();"
  ci-source-line "  if (!matches(before)) throw new Error('recipe_ci_head_mismatch');"
  ci-source-line "  await run('gh', ['pr', 'checks', plan.reference, '--watch', '--interval', '2', '--fail-fast']);"
  ci-source-line "  const checks = JSON.parse(await run('gh', ["
  ci-source-line "    'pr', 'checks', plan.reference, '--json', 'bucket,name,workflow',"
  ci-source-line "  ]));"
  ci-source-line "  if (!Array.isArray(checks) || checks.length === 0"
  ci-source-line "      || checks.some(check => check?.bucket !== 'pass')"
  ci-source-line "      || !checks.some(check => check.workflow === plan.workflow)) throw new Error('recipe_ci_not_green');"
  ci-source-line "  const after = await readPullRequest();"
  ci-source-line "  if (!matches(after) || (await run('git', ['rev-parse', 'HEAD'])).trim() !== head"
  ci-source-line "      || (await run('git', ['branch', '--show-current'])).trim() !== branch) {"
  ci-source-line "    throw new Error('recipe_ci_head_drift');"
  ci-source-line "  }"
  ci-source-line "  if (plan.ready === true && after.isDraft) {"
  ci-source-line "    await run('gh', ['pr', 'ready', plan.reference]);"
  ci-source-line "    const ready = await readPullRequest();"
  ci-source-line "    if (!matches(ready) || ready.isDraft !== false) throw new Error('recipe_ci_ready_unconfirmed');"
  ci-source-line "    after.isDraft = false;"
  ci-source-line "  }"
  ci-source-line "  console.log(JSON.stringify({ schema: 'recipe-ci-v1', success: true, complete: true,"
  ci-source-line "    reference: plan.reference, workflow: plan.workflow, head, branch,"
  ci-source-line "    isDraft: after.isDraft, ready: plan.ready === true, checks: checks.length }));"
  ci-source-line "} catch (error) {"
  ci-source-line "  console.error(JSON.stringify({ schema: 'recipe-ci-v1', success: false,"
  ci-source-line "    complete: error.complete !== false, error: error.message, status: error.status ?? null,"
  ci-source-line "    diagnostic: error.diagnostic ?? null }));"
  ci-source-line "  process.exitCode = 1;"
  ci-source-line "}"
  prepared-pull-request-patterns '["^(?:Your\\\\s+)?prepared\\\\s+pull\\\\s+request:\\\\s*(\\\\S+)\\\\s*$"]'
  update-source-line "path_value = plan['path']"
  update-source-line "path = owned_path(path_value)"
  update-source-line "expected = plan['before']"
  update-source-line "if not isinstance(expected, dict) or not isinstance(expected.get('sha256'), str):"
  update-source-line "    raise ValueError('missing_source_preimage')"
  update-source-line "expected_identity = expected.get('identity')"
  update-source-line "if not isinstance(expected_identity, list) or len(expected_identity) != 5 or not all(isinstance(value, str) and value.isdigit() for value in expected_identity):"
  update-source-line "    raise ValueError('invalid_source_identity')"
  update-source-line "if len(expected['sha256']) != 64 or any(value not in '0123456789abcdef' for value in expected['sha256']):"
  update-source-line "    raise ValueError('invalid_source_digest')"
  update-source-line "replacement = plan['source']"
  update-source-line "if not isinstance(replacement, str):"
  update-source-line "    raise ValueError('invalid_source_replacement')"
  update-source-line "updated = replacement.encode('utf-8', 'strict')"
  update-source-line "current_bytes, identity = read_regular(path, MAXIMUM_FILE_BYTES)"
  update-source-line "current_bytes.decode('utf-8', 'strict')"
  update-source-line "if [str(value) for value in identity] != expected_identity or hashlib.sha256(current_bytes).hexdigest() != expected['sha256']:"
  update-source-line "    raise ValueError('source_preimage_changed')"
  update-source-line "write_regular_atomic(path, updated, identity, expected['sha256'])"
  update-source-line "observed, _ = read_regular(path, MAXIMUM_FILE_BYTES)"
  update-source-line "if observed != updated:"
  update-source-line "    raise ValueError('source_update_readback_changed')"
  update-source-line "print(json.dumps({'schema': 'workspace-source-update-v1', 'path': path_value,"
  update-source-line "                  'success': True, 'complete': True}, ensure_ascii=True))"
  update-source-line ""
