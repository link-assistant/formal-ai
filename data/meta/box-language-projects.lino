  init_command_2 "cp main.py hello-formal-ai/main.py"
  init_step_3 "Enter the project directory."
  init_command_3 "cd hello-formal-ai"
  init_step_4 "Create the virtual environment."
  init_command_4 "python3 -m venv .venv"
  init_step_5 "Check the installer inside the environment."
  init_command_5 ".venv/bin/python -m pip --version"
  init_step_6 "Compile the program."
  init_command_6 ".venv/bin/python -m py_compile main.py"
  init_step_7 "Run the program."
  init_command_7 ".venv/bin/python main.py"
