  init_step_1 "Create the project with Cargo."
  init_command_1 "cargo new --vcs none hello-formal-ai"
  init_step_2 "Move the generated program into the crate."
  init_command_2 "cp main.rs hello-formal-ai/src/main.rs"
  init_step_3 "Enter the project directory."
  init_command_3 "cd hello-formal-ai"
  init_step_4 "Build the project."
  init_command_4 "cargo build --offline"
  init_step_5 "Run the project."
  init_command_5 "cargo run --offline --quiet"
