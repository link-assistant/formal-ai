registry_computed_trust
  record_type "meta_registry"
  registry "data/seed/sources-registry.lino"
  field "primacy"
  purpose "Every registered source carries the primacy chain its tier is derived from, so the registry's trust is computed rather than declared. The declared source_tier survives only as an assertion the derivation is checked against."
