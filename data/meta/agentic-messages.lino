# The wording the JavaScript agentic planner (js/agentic/*.mjs) answers with,
# keyed by language-neutral id.
#
# Each `text` is the exact string a `format!` / `String::from` literal in
# rust/src/agentic_coding/ (or the protocol modules around it) writes for the
# same case, so a client driving either server reads one sentence. The
# JavaScript twins hold no prose of their own - scripts/check-js-literals.mjs
# keeps js/agentic/ at zero natural-language literals - and the server parity
# runner compares both servers' bodies, so a Rust literal that changes
# without this file shows up as a divergence. `{name}` is a placeholder;
# `\n` is a newline.
agentic_messages
  message shell_tool_missing
    text "I can run `{command}` when the client advertises a shell tool such as `bash`, `shell`, or `run_command`."
  message tool_permission_refused
    text "Tool calls are not allowed for `{capability}`: {reason}. Install or import an associative package that grants this capability before enabling the tool."
  message package_permission_missing
    text "no installed associative package grants {capability}"
