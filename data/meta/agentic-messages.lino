  message rebuild_plan_keywords
    text "reattach|rebuild and reattach|reattach the improved|reattach it to the ui|rebuild the wasm worker|hot-swap the local server"
  message rebuild_plan_final_answer
    text "Composed the rebuild-and-reattach plan for accepted change `{change}` (approved by {reviewer}): a {steps}-step, reversible pipeline that recompiles Formal AI, regenerates the WebAssembly worker, reattaches it to {artifacts} grounded UI artifacts, hot-swaps the local server, and verifies the UI uses the accepted version. Nothing is rebuilt or restarted — the plan is the reviewable product, and every step is observable and reversible, so keeping the swap stays a human decision. Neural inference is not used; the plan is a deterministic function of the accepted change and the grounded artifacts.\n\nGenerated document ({path}):\n\n{document}"
  message rebuild_plan_role_cargo
    text "crate manifest recompiled into the new binary and worker"
  message rebuild_plan_role_server
    text "server/CLI entry that serves the reattached UI"
  message rebuild_plan_role_worker
    text "worker glue that loads the recompiled WebAssembly and reattaches it to the UI"
  message rebuild_plan_role_ui
    text "UI entry that mounts the reattached worker"
  message rebuild_plan_verification
    text "The rebuilt binary must pass the whole test suite, the UI smoke test must load the regenerated worker, and the version the UI reports must match the accepted change before the hot-swap is kept; otherwise the prior binary is restored."
  message rebuild_plan_step_1_action
    text "Recompile Formal AI from the accepted source."
  message rebuild_plan_step_1_command
    text "cargo build --release --locked"
  message rebuild_plan_step_1_observable
    text "a fresh target/release/formal-ai binary whose build is reproducible from the accepted source"
  message rebuild_plan_step_1_reversible
    text "the prior release binary is retained until the swap is kept"
  message rebuild_plan_step_2_action
    text "Regenerate the WebAssembly worker the browser UI runs."
  message rebuild_plan_step_2_command
    text "cargo build --release --target wasm32-unknown-unknown && wasm-bindgen (project worker build)"
  message rebuild_plan_step_2_observable
    text "a new js/formal_ai_worker.wasm whose content id differs from the shipped one"
  message rebuild_plan_step_2_reversible
    text "git restore js/formal_ai_worker.wasm rolls back to the prior worker"
  message rebuild_plan_step_3_action
    text "Reattach the regenerated worker to the UI."
  message rebuild_plan_step_3_command
    text "serve js/index.html with the worker glue pointing at the new formal_ai_worker.wasm"
  message rebuild_plan_step_3_observable
    text "the UI loads the new worker and reports the rebuilt version"
  message rebuild_plan_step_3_reversible
    text "revert the worker glue to the prior worker reference"
  message rebuild_plan_step_4_action
    text "Hot-swap the local server/worker to the rebuilt binary."
  message rebuild_plan_step_4_command
    text "restart `formal-ai serve` with the new binary (or hot-swap the running worker)"
  message rebuild_plan_step_4_observable
    text "the server's version endpoint reports the accepted change id"
  message rebuild_plan_step_4_reversible
    text "restart the prior binary to restore the previous version"
  message rebuild_plan_step_5_action
    text "Verify the UI uses the accepted version, then keep or roll back."
  message rebuild_plan_step_5_command
    text "run the UI smoke test and compare the reported version to the accepted change"
  message rebuild_plan_step_5_observable
    text "the UI smoke test passes and the reported version matches the accepted change"
  message rebuild_plan_step_5_reversible
    text "if any check fails, restore the prior binary and worker — the swap is never kept on a red check"
