# File and directory names that say what they hold (PR #1188, R1188-U5).
#
# Each `rename` moves one file; `node experiments/formal_ai_subagent/rename-by-rule.mjs`
# applies the map and rewrites every reference to the old path, and its
# `--check` (gate check_rename_map) fails while any file still names an old
# path. The companions of a rename follow by rule and are not repeated here:
# the ts/ twin of a js/ source, the rust/embedded mirror, the worker
# line-budget shard of a browser worker module and the self-AST census of a
# Rust source.
#
# `exclude` lists the historical records whose old paths stay as written:
# evidence logs, case-study data, changelog fragments, verbatim owner notes,
# captured issue texts and the coordination archive.
rename-map
  exclude "dev/log/"
  exclude "docs/case-studies/"
  exclude "changelog.d/"
  exclude "CHANGELOG.md"
  exclude "docs/changelog/"
  exclude "docs/architect-notes/"
  exclude "data/benchmarks/issue-requirements/"
  exclude "data/cache/"
  exclude "experiments/formal_ai_subagent/archive/"
  exclude "experiments/formal_ai_subagent/claims.md"
  exclude "experiments/formal_ai_subagent/tasks/"
  exclude "experiments/formal_ai_subagent/sandboxes/"
  resort "js/worker-modules.js"
  resort "ts/worker-modules.ts"
  tree browser-worker-modules
    rename
      from "js/worker/formal_ai_worker_00.js"
      to "js/worker/formal_ai_worker_seed_responses_and_language.js"
      reason "Seed hydration with its bootstrap fallbacks, the localized response lookup, response-language detection, prompt normalization and concept record matching."
      review "Read on 2026-10-08: 928 lines, 47 top-level functions from seedFileBaseName to stripLeadingRequest; the name covers the largest groups, and the module reads no other module's bindings while it loads."
    rename
      from "js/worker/formal_ai_worker_01.js"
      to "js/worker/formal_ai_worker_concept_queries_and_arithmetic.js"
      reason "Concept and how-it-works query extraction, then the arithmetic tokenizer, currency and percent expressions and the exact arithmetic evaluator."
      review "Read on 2026-10-08: 1214 lines, 64 top-level functions from extractInvertedWhoIs to parseLinearExpression; the name covers the largest groups, and the module reads no other module's bindings while it loads."
    rename
      from "js/worker/formal_ai_worker_02.js"
      to "js/worker/formal_ai_worker_equations_and_word_problems.js"
      reason "Linear and polynomial equation solving, Fibonacci references and the box, motion and train word problems the calculator normalizes."
      review "Read on 2026-10-08: 1247 lines, 67 top-level functions from formatLinearSymbolicSolution to isPunctuationOnlyPrompt; the name covers the largest groups, and the module reads no other module's bindings while it loads."
