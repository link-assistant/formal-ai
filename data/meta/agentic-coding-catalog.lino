# The coding catalog of rust/src/coding/catalog (languages, tasks, templates)
# as data for the JavaScript agentic planner in js/agentic/crate/coding_catalog.mjs.
# Generated byte for byte from the Rust tables - regenerate when they change.
# A template row names its task and language in the Rust table order; its
# program text is not copied here. It is read from data/seed/hello-world-programs.lino,
# the seed bundle the Rust catalog tests already hold equal to the tables, so the
# catalog stores each program once (issue #1165 R1165-8).
coding_catalog
  language rust
    name "Rust"
    code_fence "rust"
    check_command "rustc main.rs -o main"
    run_command "./main"
    notes "1 iteration completed under the 1 minute execution budget; no timeout reduction was needed."
    source "local Links Notation write-program seed"
    save_as "main.rs"
  language python
    name "Python"
    code_fence "python"
    check_command "python3 -m py_compile main.py"
    run_command "python3 main.py"
    notes "1 iteration completed under the 1 minute execution budget; no timeout reduction was needed."
    source "local Links Notation write-program seed"
    save_as "main.py"
  language javascript
    name "JavaScript"
    code_fence "javascript"
    check_command "node --check main.js"
    run_command "node main.js"
    notes "1 iteration completed under the 1 minute execution budget; no timeout reduction was needed."
    source "local Links Notation write-program seed"
    save_as "main.js"
  language typescript
    name "TypeScript"
    code_fence "typescript"
    check_command "tsc hello.ts"
    run_command "node hello.js"
    notes "The TypeScript seed is returned with this warning until a tsc-backed execution profile is available."
    source "local Links Notation write-program seed"
    save_as "hello.ts"
  language go
    name "Go"
    code_fence "go"
    run_command "go run main.go"
    notes "1 iteration completed under the 1 minute execution budget; no timeout reduction was needed."
    source "local Links Notation write-program seed"
    save_as "main.go"
  language c
    name "C"
    code_fence "c"
    check_command "gcc main.c -o main"
    run_command "./main"
    notes "1 iteration completed under the 1 minute execution budget; no timeout reduction was needed."
    source "local Links Notation write-program seed"
    save_as "main.c"
  language cpp
    name "C++"
    code_fence "cpp"
    check_command "g++ main.cpp -o main"
    run_command "./main"
    notes "The C++ seed is returned with this warning until a g++-backed execution profile is available."
    source "local Links Notation write-program seed"
    save_as "main.cpp"
  language java
    name "Java"
    code_fence "java"
    check_command "javac Main.java"
    run_command "java Main"
    notes "The Java seed is returned with this warning until a javac-backed execution profile is available."
    source "local Links Notation write-program seed"
    save_as "Main.java"
  language csharp
    name "C#"
    code_fence "csharp"
    check_command "dotnet build"
    run_command "dotnet run"
    notes "The C# seed is returned with this warning until a dotnet-backed execution profile is available."
    source "local Links Notation write-program seed"
    save_as "Program.cs"
  language ruby
    name "Ruby"
    code_fence "ruby"
    check_command "ruby -c main.rb"
    run_command "ruby main.rb"
    notes "The Ruby seed is returned with this warning until a ruby-backed execution profile is available."
    source "local Links Notation write-program seed"
    save_as "main.rb"
  language scala
    name "Scala"
    code_fence "scala"
    check_command "scalac Main.scala"
    run_command "scala Main"
    notes "The Scala seed is returned with this warning until a scalac-backed execution profile is available."
    source "local Links Notation write-program seed"
    save_as "Main.scala"
  language kotlin
    name "Kotlin"
    code_fence "kotlin"
    check_command "kotlinc Main.kt -include-runtime -d Main.jar"
    run_command "java -jar Main.jar"
    notes "The Kotlin seed is returned with this warning until a kotlinc-backed execution profile is available."
    source "local Links Notation write-program seed"
    save_as "Main.kt"
  language php
    name "PHP"
    code_fence "php"
    check_command "php -l main.php"
    run_command "php main.php"
    notes "1 iteration completed under the 1 minute execution budget; no timeout reduction was needed."
    source "local Links Notation write-program seed"
    save_as "main.php"
  language swift
    name "Swift"
    code_fence "swift"
    check_command "swiftc -parse hello.swift"
    run_command "swift hello.swift"
    notes ""
    source "local Links Notation write-program seed"
    save_as "hello.swift"
  language r
    name "R"
    code_fence "r"
    check_command `Rscript -e 'invisible(parse(\"hello.R\"))'`
    run_command "Rscript hello.R"
    notes ""
    source "local Links Notation write-program seed"
    save_as "hello.R"
  language laravel
    name "Laravel"
    code_fence "php"
    check_command "php -l app/Console/Commands/HelloWorld.php"
    run_command "php artisan hello:world"
    notes "Laravel Framework 13.26.1 on PHP 8.3.31: `composer create-project laravel/laravel`, then the command above printed the expected output exactly."
    source "local Links Notation write-program seed"
    save_as "app/Console/Commands/HelloWorld.php"
    framework_of "php"
  task hello_world
    label "hello world"
    output "Hello, world!"
    input ""
  task count_to_three
    label "count to three"
    output "1\n2\n3"
    input ""
  task list_files
    label "list files in the current directory"
    output "Cargo.toml\nREADME.md\nmain.rs"
    input ""
  task list_files_arg
    label "list files in the directory given as a path argument"
    output "Cargo.toml\nREADME.md\nmain.rs"
    input ""
  task list_files_reverse_sort
    label "list files in the current directory in reverse-sorted order"
    output "main.rs\nREADME.md\nCargo.toml"
    input ""
  task list_files_arg_reverse_sort
    label "list files from a path argument in reverse-sorted order"
    output "main.rs\nREADME.md\nCargo.toml"
    input ""
  task fizzbuzz
    label "FizzBuzz"
    output "1\n2\nFizz\n4\nBuzz\nFizz\n7\n8\nFizz\nBuzz\n11\nFizz\n13\n14\nFizzBuzz"
    input ""
  task factorial
    label "factorial of 5"
    output "120"
    input ""
  task reverse_string
    label "string reversal"
    output "olleh"
    input ""
  task sum_to_ten
    label "sum from 1 to 10"
    output "55"
    input ""
  task fibonacci
    label "recursive Fibonacci"
    output "55"
    input ""
  task copy_stdin_to_stdout
    label "copy standard input to standard output"
    output "hello\nworld"
    input "hello\nworld\n"
