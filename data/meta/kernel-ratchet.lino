kernel_ratchet
  issue 1085
  purpose "Behaviour belongs in links; Rust outside the kernel may only shrink. Each ceiling is the measured value at the commit that set it, and a ceiling can only move down (D1.4)."
  checker "rust-script scripts/check-kernel-ratchet.rs"
  release_rule "the non_kernel_rust_lines ceiling must be strictly lower than at the previous tag; the other ceilings must not rise"
  kernel_path "src/lib.rs"
  kernel_path "src/main.rs"
  kernel_path "src/bin/"
  kernel_path "src/server.rs"
  kernel_path "src/server/"
  kernel_path "src/protocol.rs"
