  ceiling
    measure non_kernel_rust_lines
    value 112982
    how "non-blank, non-comment lines of every src/**/*.rs file that is not under a kernel_path, measured at the commit that set the ceiling"
  ceiling
    measure handler_files
    value 43
    how "*.rs files under src/solver_handlers/ other than mod.rs and modules.rs"
  ceiling
    measure handler_migration_pending
    value 51
    how "occurrences of the phrase status pending in data/meta/handler-migration-ledger.lino"
  ceiling
    measure literal_predicates_outside_kernel
    value 526
    how "occurrences of a contains( or starts_with( call with a double-quoted first argument in non-kernel src/**/*.rs"
  ceiling
    measure hardcoded_language_rows
    value 1299
    how "non-empty, non-comment rows of scripts/hardcoded-language-allowlist.txt"
