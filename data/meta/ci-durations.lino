  issue "1188"
  branch "qa-reasoning-coding-bulk-fixes"
  measured-date "2026-10-08"
  runs-per-workflow "10"
  unit "minutes"
  regenerate "node experiments/formal_ai_subagent/ci-durations.mjs --write"
