    regression rust-source-e0308
      introduced-by "PR #1497"
      failed "cargo build: error[E0308] mismatched types in rust/src"
      workflow .github/workflows/native-type-check.yml
      check rust/tests/web/default-branch-build-policy.test.mjs
      marker "replays main run 43710854562"
