# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
#
# Only the inline tests run here. The audit itself needs the Actions API, which
# a pull request has no measurements of its own to read, so it runs weekly
# from `.github/workflows/job-headroom.yml` (issue #1076, D5). What this gate
# holds is the part a commit *can* break -- two of the tests parse the
# repository's real `.github/workflows/**`, so a job renamed or given a cap the
# reader cannot resolve fails here rather than dropping out of the weekly audit
# unnoticed.
ci_gate check_job_headroom
  stage rust
  description "Every declared job cap can still be read and matched to the job it bounds."
  run "rust-script --test scripts/check-job-headroom.rs"
