# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check_rust_api_documentation
  stage rust
  description "rustdoc builds the public API without a single warning, including broken intra-doc links."
  run "cargo doc --manifest-path rust/Cargo.toml --no-deps --lib"
  env RUSTDOCFLAGS "-D warnings"
  justification "Public API items without doc comments silently produce incomplete documentation; `cargo doc --no-deps --lib` has checked documentation completeness since the initial CI commit (6f8d4a8a0) to enforce the documentation policy."
