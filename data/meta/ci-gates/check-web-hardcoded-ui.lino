# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check_web_hardcoded_ui
  stage web
  description "The web app renders no hardcoded user-facing string."
  run "npm run --prefix rust/tests/e2e check:web-hardcoded-ui"
  justification "Hardcoded user-facing strings in the web app produce English-only UI in non-English locales; the gate was introduced in #991 to enforce the seed-data pipeline for all UI text."
