# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check_associative_terminology
  stage rust
  description "Associative-memory vocabulary stays consistent across code, data and docs."
  run "rust-script scripts/check-associative-terminology.rs"
  justification "A graph-named public API route or Rust module file would silently reintroduce the associative terminology the cleanup in #664 retired; this lint blocks new occurrences before they embed."
