# PR #1188: lane 4 of the parallel `lint` matrix -- ~80s of rust-script measurement that fits beside the lane-4 build.
ci_gate check_capability_routing
  stage rust
  lane 4
  description "Capability-routing coverage is re-measured from the held-out corpus and the production router; every recorded value must equal the tree, upward measures may not fall, and routing debt may not rise."
  run "rust-script --test scripts/check-capability-routing.rs && rust-script scripts/check-capability-routing.rs --base origin/main"
