# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check_fragment_release_map
  stage rust
  description "The fragment release map regenerates to exactly what is committed."
  run "node --test experiments/issue_738_fragment_release_map.test.mjs"
  justification "A fragment map regenerated non-atomically could produce partial or mismatched entries that misdirected release notes; the atomic regeneration test was introduced for issue #738 to prevent inconsistent fragment maps."
