# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check-coverage-ratchet
  stage rust
  description "Test coverage does not fall below the committed ratchet."
  run "rust-script --test scripts/check-coverage-ratchet.rs"
  justification "Coverage could fall to zero with the pipeline green because nothing read the LCOV numbers; the ratchet gate was added in #895 (epic #710) so every merged commit can only hold or improve measured coverage."
