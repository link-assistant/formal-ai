# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check-cache-budget
  stage rust
  description "The committed cache buckets stay inside the size budget the repository can carry."
  run "rust-script --test scripts/check-cache-budget.rs && rust-script scripts/check-cache-budget.rs"
  justification "A translation cache bucket exceeding MAX_SEED_RECORDS_PER_BUCKET causes the runtime to miss cached answers; unchecked bucket growth was caught by R222-2 in #960, and this gate prevents silent regrowth."
