# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check-language-change-parity
  stage web
  description "A change to one language's seed data is mirrored in every other language."
  run "npm run --prefix rust/tests/e2e check:language-parity"
  justification "When the source-root layout changed in #1138, the language parity check was added to ensure all natural-language definitions stay consistent across source roots; without it, adding a term in one root leaves gaps in others."
