# One CI gate, one file. Issue #991 moved the gate list out of
# `.github/workflows/release.yml`, the repository's third most conflicted path,
# because its step list was append-only. A gate lives here instead, so two
# branches adding gates create two files, never one shared region.
# `rust-script scripts/run-ci-gates.rs --stage <stage>` runs them.
ci_gate check_seed_registry
  stage rust
  description "The Rust and browser seed inventories still match data/meta/seed-registry.lino (issue #991)."
  run "rust-script --test scripts/generate-seed-registry.rs && rust-script scripts/generate-seed-registry.rs"
  justification "generate-seed-registry.rs was introduced in #991 to derive the seed registry from per-entry source files; without it, the registry file can diverge from its sources and registrations are silently lost or duplicated."
