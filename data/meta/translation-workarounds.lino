  stub waPad
    rust "pub fn wa_pad(text: &str, length: f64, fill: &str) -> String {"
    rust "    let have = text.encode_utf16().count();"
    rust "    let fill: Vec<u16> = fill.encode_utf16().collect();"
    rust "    let want = if length.is_nan() { 0 } else { length.trunc().max(0.0) as usize };"
    rust "    if want <= have || fill.is_empty() { return String::new(); }"
    rust "    String::from_utf16_lossy(&fill.iter().copied().cycle().take(want - have).collect::<Vec<u16>>()) }"
  stub waStrCodePointAt
    method codePointAt
    javascript "/** @param {string} text @param {number} index @returns {number} */ function waStrCodePointAt(text, index) { return index; }"
    rust "pub fn wa_str_code_point_at(text: String, index: f64) -> f64 {"
    rust "    let units: Vec<u16> = text.encode_utf16().collect();"
    rust "    let at = if index.is_nan() { 0.0 } else { index.trunc() };"
    rust "    if at < 0.0 || at >= units.len() as f64 { return f64::NAN; }"
    rust "    let first = units[at as usize];"
    rust "    match units.get(at as usize + 1) {"
    rust "        Some(&second) if (0xD800..0xDC00).contains(&first) && (0xDC00..0xE000).contains(&second) => {"
    rust "            f64::from(((u32::from(first) - 0xD800) << 10) + (u32::from(second) - 0xDC00) + 0x10000)"
    rust "        }"
    rust "        _ => f64::from(first),"
    rust "    } }"
