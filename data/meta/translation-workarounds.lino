  stub waStrIndexOf
    method indexOf
    javascript "/** @param {string} text @param {string} search @returns {number} */ function waStrIndexOf(text, search) { return 0; }"
    rust "pub fn wa_str_index_of(text: String, search: String) -> f64 {"
    rust "    let units: Vec<u16> = text.encode_utf16().collect();"
    rust "    let needle: Vec<u16> = search.encode_utf16().collect();"
    rust "    if needle.is_empty() { return 0.0; }"
    rust "    if needle.len() > units.len() { return -1.0; }"
    rust "    units.windows(needle.len()).position(|window| window == needle.as_slice()).map_or(-1.0, |at| at as f64) }"
  stub waStrLastIndexOf
    method lastIndexOf
    javascript "/** @param {string} text @param {string} search @returns {number} */ function waStrLastIndexOf(text, search) { return 0; }"
    rust "pub fn wa_str_last_index_of(text: String, search: String) -> f64 {"
    rust "    let units: Vec<u16> = text.encode_utf16().collect();"
    rust "    let needle: Vec<u16> = search.encode_utf16().collect();"
    rust "    if needle.is_empty() { return units.len() as f64; }"
    rust "    if needle.len() > units.len() { return -1.0; }"
    rust "    units.windows(needle.len()).rposition(|window| window == needle.as_slice()).map_or(-1.0, |at| at as f64) }"
  stub waStrsIndexOf
    method indexOf
    receiver strings
    javascript "/** @param {string[]} items @param {string} item @returns {number} */ function waStrsIndexOf(items, item) { return 0; }"
    rust "pub fn wa_strs_index_of(items: Vec<String>, item: String) -> f64 {"
    rust "    items.iter().position(|entry| *entry == item).map_or(-1.0, |at| at as f64) }"
