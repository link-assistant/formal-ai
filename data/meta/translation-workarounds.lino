# Temporary workarounds of the js -> rust translation (R1188-U30).
#
# Where the pinned link-foundation/meta-language cannot translate a construct
# yet, or emits Rust that does not hold together across modules, a workaround
# in this repository completes the translation (docs/progressive-delivery.md).
# Each record names the refusal or defect it lifts, the upstream issue whose
# fix retires it, where it acts and how. scripts/lib/translation-workarounds.mjs
# implements them; a projection's header names the ones its module needed
# (`// formal-ai:workarounds`), and data/meta/js-rust-translation.lino counts
# the items they translate (`workaround_items`) apart from upstream's own
# (`translated_items`). When the upstream issue is fixed and the pin moves
# past it, the record and its code are deleted, and the ledger shows the
# items moving from `workaround_items` to `translated_items`.
# rust/tests/web/translation-workarounds.test.mjs pins this table.
workaround import-pruning
  lifts "use crate::m::{…} naming an item m does not translate"
  upstream "https://github.com/link-foundation/meta-language/issues/220"
  scope "projection"
  how "A translated import keeps only the names that the imported module's signatures bind. Upstream carries every item that uses an unbound name, so no Rust needs it. An import with no bound name is carried with the refusal 'import of names its module does not translate'."
workaround crate-assembly
  lifts "crate-rooted helper paths (crate::ml_*) beside imports of sibling modules (use crate::m::…)"
  upstream "https://github.com/link-foundation/meta-language/issues/219"
  scope "compile"
  how "--compile (CI only) builds each root (crate, worker) as one crate with one module per projection. Each module's own crate::x paths are rewritten to crate::<module>::x, so imports and helpers both resolve. The committed projections are not changed."
lowering
  workaround string-methods
    lifts "method call .slice() .indexOf() .lastIndexOf() .split() .replace() .replaceAll() .repeat() .padStart() .padEnd() .codePointAt() .charAt() .join() on strings and arrays; length of a string; for…of over a string"
    upstream "https://github.com/link-foundation/meta-language/issues/209"
    how "receiver.method(args) becomes a call of the typed stub below that method, receiver kind and arity name, declared beside the item. The stub's emitted Rust is replaced by the recorded rust lines, which follow JavaScript's UTF-16 semantics. A receiver is read first as a string, then as an array of strings, then as an array of numbers; the first reading that type-checks is kept. A string length that upstream refuses (with its span) becomes waStrLength, and a for…of over a string that upstream reads as an array iterates waStrChars (code points). replace and replaceAll take only a string pattern and a replacement literal without $."
  workaround array-push
    lifts "method call .push()"
    upstream "https://github.com/link-foundation/meta-language/issues/208"
    how "The statement xs.push(a, b); on an array the item declares as const xs = [ or let xs = [ becomes xs = [...xs, a, b];, and the const becomes a let. The portable core builds the new array (ml_array::append)."
  workaround callback-loops
    lifts "arrow callback of .map() .filter() .some() .every()"
    upstream "https://github.com/link-foundation/meta-language/issues/207"
    how "const r = xs.map((x) => e); (or let, or return xs.map(…);) with an expression body becomes let r = []; for (const x of xs) { r = [...r, e]; }. filter keeps x when e holds, some and every break at the first decisive element, and a return returns the result."
  stubs of string-methods
stubs string-methods
  receiver string
  arity 1
  stub waIndex
    rust "pub fn wa_index(index: f64, len: usize) -> usize {"
    rust "    let whole = if index.is_nan() { 0.0 } else { index.trunc() };"
    rust "    (if whole < 0.0 { (len as f64 + whole).max(0.0) } else { whole.min(len as f64) }) as usize }"
  stub waStrSlice
    method slice
    arity 2
    needs waIndex
    javascript "/** @param {string} text @param {number} start @param {number} end @returns {string} */ function waStrSlice(text, start, end) { return text; }"
    rust "pub fn wa_str_slice(text: String, start: f64, end: f64) -> String {"
    rust "    let units: Vec<u16> = text.encode_utf16().collect();"
    rust "    let (from, to) = (wa_index(start, units.len()), wa_index(end, units.len()));"
    rust "    if from >= to { String::new() } else { String::from_utf16_lossy(&units[from..to]) } }"
  stub waStrSliceFrom
    method slice
    needs waStrSlice
    javascript "/** @param {string} text @param {number} start @returns {string} */ function waStrSliceFrom(text, start) { return text; }"
    rust "pub fn wa_str_slice_from(text: String, start: f64) -> String {"
    rust "    wa_str_slice(text, start, f64::INFINITY) }"
  stub waStrsSlice
    method slice
    receiver strings
