reasoning_episode reference_disk_space
  record_type "reasoning_episode"
  task_class "reclaim_disk_space"
  note "The reference dialog of issue #1073, distilled into the episode record the standard audits. Every gate is checked against this episode by the regression harness, and every mutation of it that removes an adopted behaviour flips the matching gate to violated. Machine details are kept only where the reasoning depends on them: the project-specific tooling, absolute paths and session bookkeeping of the original dialog are deliberately dropped."
  observation obs_df_before
    ordinal "1"
    command "df -h /"
    output "Filesystem Size Used Avail Use% Mounted on; /dev/root 468G 441G 3.2G 100% /"
    source "shell"
    check "free space on the root filesystem is reported in bytes"
  claim claim_root_is_full
    ordinal "2"
    statement "The root filesystem has 3.2G free of 468G and is at 100 percent use."
    about_world "true"
    support "obs_df_before"
  observation obs_du_home
    ordinal "3"
    command "du -h -d 1 ~ | sort -h | tail -n 5"
    output "12G ~/.cache; 19G ~/Downloads; 24G ~/.local; 102G ~/Code; 178G ~"
    source "shell"
    check "the largest directories under the home directory are ranked by size"
  claim claim_code_dominates
    ordinal "4"
    statement "The Code directory holds 102G, more than half of the 178G the home directory uses."
    about_world "true"
    support "obs_du_home"
  observation obs_du_code
    ordinal "5"
    command "du -h -d 2 ~/Code | sort -h | tail -n 5"
    output "6.1G ~/Code/b/target; 9.4G ~/Code/c/node_modules; 14G ~/Code/a/target; 58G ~/Code total in build outputs; 102G ~/Code"
    source "shell"
    check "the largest directories inside Code are ranked by size"
  claim claim_build_output_dominates
    ordinal "6"
    statement "Regenerable build output accounts for 58G of the 102G under Code."
    about_world "true"
    support "obs_du_code"
    support "obs_du_home"
  observation obs_cargo_clean_doc
    ordinal "7"
    command "read the Cargo Book page for cargo clean"
    output "cargo clean removes artifacts that Cargo has generated in the past; the target directory is rebuilt on the next build."
    source "https://doc.rust-lang.org/cargo/commands/cargo-clean.html"
    check "the tool documentation states what the command removes"
  observation obs_coreutils_doc
    ordinal "8"
    command "read the GNU coreutils manual entry for du"
    output "du estimates file space usage, summarizing disk usage of the set of files, recursively for directories."
    source "https://www.gnu.org/software/coreutils/manual/html_node/du-invocation.html"
    check "the tool documentation states what the measurement means"
  observation obs_remove_attempt
    ordinal "10"
    command "rm -rf ~/.cache/shared-runner"
    output "rm: cannot remove '~/.cache/shared-runner/lock': Permission denied; rm: cannot remove '~/.cache/shared-runner/db': Permission denied"
    source "shell"
    check "the removal reports per-path errors rather than a summary"
  observation obs_du_after
    ordinal "12"
    command "du -h -d 1 ~ | sort -h | tail -n 5"
    output "1.9G ~/.cache; 19G ~/Downloads; 24G ~/.local; 44G ~/Code; 108G ~"
    source "shell"
    check "the same directories are re-ranked after the removals"
  observation obs_df_after
    ordinal "13"
    command "df -h /"
    output "Filesystem Size Used Avail Use% Mounted on; /dev/root 468G 371G 73G 80% /"
    source "shell"
    check "free space on the root filesystem is reported again in the same units"
  claim claim_space_recovered
    ordinal "14"
    statement "Free space on the root filesystem rose from 3.2G to 73G, and use fell from 100 to 80 percent."
    about_world "true"
    support "obs_df_after"
  source_assessment source_cargo_book
    label "The Cargo Book, cargo clean"
    subject "what cargo clean removes"
    asserted_tier "original_first_party"
    primacy self_published
      upstream ""
      basis "The Cargo maintainers document the behaviour of the tool they publish, so on the question of what the command removes the source is the subject speaking about itself."
  source_assessment source_coreutils_manual
    label "GNU coreutils manual, du invocation"
    subject "what du measures"
    asserted_tier "original_first_party"
    primacy self_published
      upstream ""
      basis "The coreutils maintainers document the behaviour of the tool they publish, so on the question of what du measures the source is the subject speaking about itself."
  source_assessment source_community_answer
    label "Unix and Linux Stack Exchange answer on reclaiming disk space"
    subject "how to find and reclaim large directories"
    asserted_tier "independent_corroboration"
    primacy citation
      upstream "GNU coreutils manual, du invocation"
      basis "The answer quotes and links the manual entry it relies on, so its trust is derived one hop from the manual rather than from the answer's score."
  instruction_excerpt source_cargo_book
    step "measure the build output directory before removing it"
      check "du reports a size in bytes for the directory that is about to be removed"
    step "remove build output with the tool that created it"
      check "the build output directory no longer exists after the command returns"
  instruction_excerpt source_community_answer
    step "measure the build output directory before removing it"
      check "du reports a size in bytes for the directory that is about to be removed"
    step "re-measure free space after removing files"
      check "df reports more free space than the measurement taken before the removal"
  action action_cargo_clean
    ordinal "9"
    mutating "true"
    description "Remove regenerable build output under Code with the build tool that created it."
    outcome "succeeded"
    reported_as "succeeded"
    reason ""
    before_measurement
      metric "home_directory_size"
      value "178G"
      observation "obs_du_home"
    after_measurement
      metric "home_directory_size"
      value "108G"
      observation "obs_du_after"
  action action_remove_shared_cache
    ordinal "11"
    mutating "true"
    description "Remove the shared runner cache under the cache directory."
    outcome "partially_succeeded"
    reported_as "partially_succeeded"
    reason "Two paths under the cache are owned by another user and were left in place; removing them needs privileges that were not granted, so the directory is smaller but not empty."
    before_measurement
      metric "cache_directory_size"
      value "12G"
      observation "obs_du_home"
    after_measurement
      metric "cache_directory_size"
      value "1.9G"
      observation "obs_du_after"
  refutation probe_open_descriptors
    conclusion "conclusion_build_output_was_the_cause"
    axis "mechanism"
    mechanism "deleted_files_held_open_by_running_processes"
    denies "that removing the files returned their bytes to the filesystem"
    outcome "refuted"
    evidence "obs_df_after"
    evidence "Free space rose by 69.8G immediately after the removals, which cannot happen while the bytes are still held by open descriptors."
    blocker ""
  refutation probe_wrong_filesystem
    conclusion "conclusion_build_output_was_the_cause"
    axis "source"
    mechanism "du_and_df_describing_different_filesystems"
    denies "that the directory sizes and the free-space figure describe the same device"
    outcome "refuted"
    evidence "obs_df_before"
    evidence "df names /dev/root mounted at / and the measured directories are under the home directory on that same mount, with no separate mount point between them."
    blocker ""
  refutation probe_reserved_blocks
    conclusion "conclusion_build_output_was_the_cause"
    axis "assumption"
    mechanism "reserved_blocks_masking_usable_capacity"
    denies "that free space equals unused capacity, so that the reported shortage was real"
    outcome "refuted"
    evidence "obs_df_before"
    evidence "The filesystem reported 100 percent use with 3.2G available, and writes were already failing, so the shortage was not an artefact of the reserve."
    blocker ""
  conclusion conclusion_build_output_was_the_cause
    statement "The space was consumed by regenerable build output under Code, and removing it recovered 69.8G."
    claim "claim_build_output_dominates"
