# The HTTP route table of the formal-ai server, shared by both servers.
#
# One record per route. `method` is the HTTP method, each `path` is an exact
# path or a pattern whose `{name}` segments are parameters (one or more
# characters unless a `param` record narrows them with a regular expression),
# `auth bearer` means the route answers 401 without the configured bearer
# token (FORMAL_AI_API_BEARER_TOKEN and its aliases) while `auth none` never
# asks for one, and `example` is a concrete path for a patterned route.
#
# The JavaScript server (js/server/routes.mjs) routes from this file. The Rust
# server keeps its own match in rust/src/server.rs, and
# rust/tests/unit/server_route_manifest.rs holds the two together - every
# route here is served there, and nothing outside this table is. Order
# matters only for patterns, which are tried before exact paths, as the Rust
# dynamic routes are.
server_routes
  route options_preflight
    method OPTIONS
    path "*"
    auth none
    example "/v1/chat/completions"
  route head_probe
    method HEAD
    path "/"
    path "/health"
    auth none
  route head_probe_vendor
    method HEAD
    path "/api/anthropic"
    path "/api/openai"
    path "/api/gemini"
    path "/api/formal-ai"
    path "/api/vertex"
    path "/api/hello"
    path "/api/anthropic/api/hello"
    auth bearer
  route api_hello
    method GET
    path "/api/hello"
    path "/api/anthropic/api/hello"
    auth bearer
  route health
    method GET
    path "/health"
    auth none
  route models
    method GET
    path "/v1/models"
    path "/api/openai/v1/models"
    auth bearer
  route network
    method GET
    path "/v1/network"
    path "/api/formal-ai/v1/network"
    auth bearer
  route network_graph_alias
    method GET
    path "/v1/graph"
    path "/api/formal-ai/v1/graph"
    auth bearer
    deprecated true
  route bundle
    method GET
    path "/v1/bundle"
    path "/api/formal-ai/v1/bundle"
    auth bearer
  route links
    method GET
    path "/v1/links"
    path "/api/formal-ai/v1/links"
    auth bearer
  route links_query
    method POST
    path "/v1/links/query"
    path "/api/formal-ai/v1/links/query"
    auth bearer
  route memory
    method GET
    path "/v1/memory"
    path "/api/formal-ai/v1/memory"
    auth bearer
  route memory_since
    method GET
    path "/v1/memory/since"
    path "/api/formal-ai/v1/memory/since"
    auth bearer
  route memory_import
    method POST
    path "/v1/memory/import"
    path "/api/formal-ai/v1/memory/import"
    auth bearer
  route anthropic_messages
    method POST
    path "/v1/messages"
    path "/api/anthropic/v1/messages"
    auth bearer
  route chat_completions
    method POST
    path "/v1/chat/completions"
    path "/api/openai/v1/chat/completions"
    auth bearer
  route responses
    method POST
    path "/v1/responses"
    path "/api/openai/v1/responses"
    auth bearer
  route mcp
    method POST
    path "/mcp"
    auth bearer
  route mcp_stream
    method GET
    path "/mcp"
    auth bearer
  route telegram_webhook
    method POST
    path "/telegram/webhook"
    auth none
  route conversation_context
    method GET
    path "/v1/conversations/{dialog_id}"
    path "/api/formal-ai/v1/conversations/{dialog_id}"
    auth bearer
    example "/v1/conversations/server-parity-dialog"
  route conversation_learn
    method POST
    path "/v1/conversations/{dialog_id}/learn"
    path "/api/formal-ai/v1/conversations/{dialog_id}/learn"
    auth bearer
    example "/v1/conversations/server-parity-dialog/learn"
  route debug_session
    method POST
    path "/v1/debug/{action}"
    param action
      pattern "session|pause|advance|release"
    auth bearer
    example "/v1/debug/session"
  route gemini_models
    method GET
    path "/api/gemini/v1beta/models"
    auth bearer
  route gemini_model
    method GET
    path "/api/gemini/v1beta/models/{model}"
    param model
      pattern "[^:]*"
    auth bearer
    example "/api/gemini/v1beta/models/formal-ai"
  route gemini_generate_content
    method POST
    path "/api/gemini/v1beta/models/{model}:generateContent"
    param model
      pattern ".*"
    auth bearer
    example "/api/gemini/v1beta/models/formal-ai:generateContent"
  route gemini_stream_generate_content
    method POST
    path "/api/gemini/v1beta/models/{model}:streamGenerateContent"
    param model
      pattern ".*"
    auth bearer
    example "/api/gemini/v1beta/models/formal-ai:streamGenerateContent"
  route vertex_models
    method GET
    path "/api/vertex/v1/projects/{project}/locations/{location}/publishers/google/models"
    param project
      pattern ".*?"
    param location
      pattern ".*?"
    auth bearer
    example "/api/vertex/v1/projects/demo/locations/us-central1/publishers/google/models"
  route vertex_generate_content
    method POST
    path "/api/vertex/v1/projects/{project}/locations/{location}/publishers/google/models/{model}:generateContent"
    param project
      pattern ".*?"
    param location
      pattern ".*?"
    param model
      pattern ".*"
    auth bearer
    example "/api/vertex/v1/projects/demo/locations/us-central1/publishers/google/models/formal-ai:generateContent"
  route vertex_stream_generate_content
    method POST
    path "/api/vertex/v1/projects/{project}/locations/{location}/publishers/google/models/{model}:streamGenerateContent"
    param project
      pattern ".*?"
    param location
      pattern ".*?"
    param model
      pattern ".*"
    auth bearer
    example "/api/vertex/v1/projects/demo/locations/us-central1/publishers/google/models/formal-ai:streamGenerateContent"
