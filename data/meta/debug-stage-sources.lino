# Which functions emit each stage of a debugged turn (issue #667, R383).
#
# Generated by scripts/generate-debug-stage-sources.mjs from the source tree;
# do not edit by hand (CI runs it with --check). For every solver event kind
# that becomes a thinking step (`step`), the functions that append it in each
# runtime, and each runtime's source trees and solver entry. The step-through
# debug session (js/server/debug-stage-sources.mjs, Rust twin
# rust/src/server/debug_stage_sources.rs) picks one per stage: the only one,
# else the one fewest calls from the turn's routed handler, else from the entry.
debug_stage_sources
  runtime rust
    keyword fn
    tree "rust/src" ".rs"
    entry "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
  runtime js
    keyword function
    tree "js/worker" ".js"
    tree "js/agentic/crate" ".mjs"
    tree "js/server" ".mjs"
    entry "js/server/solver-log.mjs" nativeSolverLog
  event "action_log"
    step agent_plan
    rust "rust/src/solver_handlers/policy_gates.rs" try_policy_gates
  event "agent_mode:active"
    step agent_plan
    rust "rust/src/solver_handlers/agent_workspace.rs" try_agent_workspace_task
    rust "rust/src/solver_handlers/policy_gates.rs" try_policy_gates
  event "agent_mode:opted_in"
    step agent_plan
    rust "rust/src/solver_handlers/agent_workspace.rs" try_agent_workspace_task
    rust "rust/src/solver_handlers/policy_gates.rs" try_policy_gates
  event "calculation"
    step compute
    rust "rust/src/solver_handlers/calculator_rate.rs" rate_basis_answer
    rust "rust/src/solver_handlers/compound_interest.rs" answer_compound_interest
    rust "rust/src/solver_handlers/compound_interest.rs" answer_final_amount_conversion
    rust "rust/src/solver_handlers/mod.rs" try_arithmetic
    js "js/worker/formal_ai_worker_solver_events.js" solverCalculationEvents
  event "calculation:engine"
    step compute_engine
    rust "rust/src/solver_handlers/calculator_rate.rs" rate_basis_answer
    rust "rust/src/solver_handlers/mod.rs" try_arithmetic
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_calculator_api_call
    js "js/worker/formal_ai_worker_solver_events.js" solverCalculationEvents
  event "calculation:lino"
    step compute_expression
    rust "rust/src/solver_handlers/calculator_rate.rs" rate_basis_answer
    rust "rust/src/solver_handlers/mod.rs" try_arithmetic
    js "js/worker/formal_ai_worker_solver_events.js" solverCalculationEvents
  event "calculation:steps"
    step compute_steps
    rust "rust/src/solver_handlers/calculator_rate.rs" rate_basis_answer
    rust "rust/src/solver_handlers/mod.rs" try_arithmetic
    js "js/worker/formal_ai_worker_solver_events.js" solverCalculationEvents
  event "concept_lookup:hit"
    step lookup_fact
    rust "rust/src/concepts.rs" try_concept_lookup_with_response_language
    rust "rust/src/solver_search.rs" record_external_search
    rust "rust/src/solver_unknown_reasoning.rs" answer_from_public_knowledge_cache
  event "concept_lookup:request"
    step scan_memory
    rust "rust/src/concepts.rs" try_concept_lookup_with_response_language
    rust "rust/src/solver_unknown_reasoning.rs" answer_from_public_knowledge_cache
  event "fact_lookup:hit"
    step lookup_fact
    rust "rust/src/solver_handlers/benchmark_prompts.rs" try_fact_lookup
  event "fact_query:relation"
    step lookup_fact
    rust "rust/src/solver_handlers/benchmark_prompts.rs" try_fact_lookup
  event "fact_query:subject"
    step lookup_fact
    rust "rust/src/solver_handlers/benchmark_prompts.rs" try_fact_lookup
  event "http_fetch:request"
    step http_chat
    rust "rust/src/solver_handler_how.rs" try_how_to_procedure
    rust "rust/src/solver_handlers/web_requests.rs" answer_http_fetch_url
  event "impulse"
    step impulse
    rust "rust/src/protocol_memory.rs" answer_memory_inspection
    rust "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
    rust "rust/src/solver_handlers/conversation_memory/mod.rs" answer_memory_recall
    rust "rust/src/solver_handlers/conversation_memory/program_query.rs" execute_memory_query_with_options
    js "js/worker/formal_ai_worker_solver_events.js" solverEventLog
  event "intent"
    step dispatch_handler
    rust "rust/src/meta_method_dispatch.rs" try_diagnostic
    rust "rust/src/meta_method_dispatch.rs" try_learned_method
    rust "rust/src/meta_reasoner/integration.rs" project
    rust "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
    rust "rust/src/solver_handlers/mod.rs" finalize_simple
    rust "rust/src/solver_synthesis.rs" finalize_composed_candidate
    js "js/worker/formal_ai_worker_solver_events.js" solverEventLog
  event "intent_formalization:route"
    step formalize
    rust "rust/src/intent_formalization.rs" record_intent_formalization
    js "js/agentic/crate/intent_formalization.mjs" recordIntentFormalization
    js "js/worker/formal_ai_worker_solver_events.js" solverEventLog
  event "language"
    step detect_language
    rust "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
    rust "rust/src/solver_handlers/calendar.rs" try_calendar_reasoning
    rust "rust/src/solver_handlers/calendar.rs" try_current_day_reasoning
    rust "rust/src/solver_handlers/calendar/date_weekday.rs" try_date_weekday
    rust "rust/src/solver_handlers/calendar/month.rs" render_unresolved
    rust "rust/src/solver_handlers/calendar/month.rs" try_month_offset
    rust "rust/src/solver_handlers/calendar_create.rs" try_routed_calendar_create_event
    rust "rust/src/solver_handlers/document_originality.rs" try_document_originality_check
    rust "rust/src/solver_handlers/numeric_list/stated_result.rs" try_stated_result
    rust "rust/src/solver_handlers/statistics/primality.rs" handle_primality
    rust "rust/src/solver_handlers/task_decomposition.rs" try_task_decomposition_with_depth
    js "js/worker/formal_ai_worker_solver_events.js" solverEventLog
  event "language_from"
    step detect_language
    rust "rust/src/solver_handlers/mod.rs" translate_free_sentence
    rust "rust/src/solver_handlers/mod.rs" try_translation
  event "language_to"
    step resolve_response_language
    rust "rust/src/concepts.rs" try_concept_lookup_with_response_language
    rust "rust/src/meta_method_answers.rs" response_language_demonstration
    rust "rust/src/solver_handlers/mod.rs" translate_free_sentence
    rust "rust/src/solver_handlers/mod.rs" try_translation
    rust "rust/src/solver_handlers/pattern_inference.rs" try_pattern_inference
    rust "rust/src/solver_handlers/pattern_inference.rs" try_pattern_inference_with_response_language
    rust "rust/src/solver_handlers/response_language_followup.rs" try_response_language_followup
    rust "rust/src/solver_handlers/web_requests.rs" render_generic_repository_lookup
    rust "rust/src/solver_handlers/web_requests.rs" render_project_lookup
  event "legacy_intent"
    step dispatch_handler
    rust "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
    js "js/worker/formal_ai_worker_solver_events.js" solverWriteProgramEvents
  event "procedural_how_to:request"
    step scan_memory
    rust "rust/src/solver_handler_how.rs" try_how_to_procedure
  event "program_parameters"
    step program_plan
    rust "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
    js "js/worker/formal_ai_worker_solver_events.js" solverWriteProgramEvents
  event "release_timeline:hit"
    step lookup_fact
    rust "rust/src/solver_handlers/benchmark_prompts.rs" render_release_timeline
  event "response"
    step deformalize
    rust "rust/src/meta_method_dispatch.rs" try_diagnostic
    rust "rust/src/meta_method_dispatch.rs" try_learned_method
    rust "rust/src/meta_reasoner/integration.rs" project
    rust "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
    rust "rust/src/solver_handlers/mod.rs" finalize_simple
    rust "rust/src/solver_synthesis.rs" finalize_composed_candidate
    js "js/worker/formal_ai_worker_solver_events.js" solverEventLog
  event "tool_call"
    step invoke_tool
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_calculator_api_call
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_javascript_code_execution
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_web_search_api_call
  event "tool_parameter"
    step invoke_tool
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_calculator_api_call
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_javascript_code_execution
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_web_search_api_call
  event "tool_permission"
    step invoke_tool
    rust "rust/src/solver_handlers/natural_language_tools.rs" require_tool_permission
  event "tool_result"
    step invoke_tool
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_calculator_api_call
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_javascript_code_execution
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_web_search_api_call
  event "url_navigate:request"
    step http_chat
    rust "rust/src/solver_handlers/web_requests.rs" try_url_navigate
  event "validation"
    step rule_verification
    rust "rust/src/solver.rs" solve_with_history_probability_store_and_intent_cache
    rust "rust/src/solver_handlers/mod.rs" finalize_simple
    rust "rust/src/solver_helpers/mod.rs" record_validation
    rust "rust/src/solver_synthesis.rs" finalize_composed_candidate
    js "js/worker/formal_ai_worker_solver_events.js" solverEventLog
  event "web_search:request"
    step http_chat
    rust "rust/src/solver_handler_how.rs" record_mechanism_query
    rust "rust/src/solver_handler_how.rs" try_how_to_procedure
    rust "rust/src/solver_handlers/document_originality.rs" log_statement_verification
    rust "rust/src/solver_handlers/document_originality.rs" try_document_originality_check
    rust "rust/src/solver_handlers/natural_language_tools.rs" try_web_search_api_call
    rust "rust/src/solver_handlers/web_requests.rs" render_project_lookup
    rust "rust/src/solver_handlers/web_requests/live_search.rs" execute_web_search_answer
