# The generated system diagrams (issue #538, R382): docs/diagrams/*.md beside
# the Agent CLI recipe diagrams (docs/diagrams/agentic-recipes.md).
#
# js/agentic/system_diagram.mjs renders them (driven by
# `node scripts/generate-system-diagrams.mjs --write`, and `--check` in CI)
# and rust/src/agentic_coding/system_diagram.rs is its twin, pinned
# byte-for-byte to the committed parts by rust/tests/unit/system_diagrams.rs.
#
# Everything a diagram lists is read from the live sources named below: the
# solver's handler precedence and promotions from the seed, the CLI
# subcommands from the clap definition in rust/src/main.rs, and the HTTP
# routes from the route manifest both servers are held to. This file holds
# only the wording and the overview's edges, and every edge that names a
# subcommand or a route is checked against the live data, so an edge whose
# subcommand or route disappears fails the generator instead of drawing a
# stale arrow.
#
# `{name}` in a text is a placeholder the renderer fills.
system_diagrams
  issue 538
  requirement R382
  chunk 20
  source handler_precedence
    path "data/seed/handler-precedence.lino"
  source handler_promotions
    path "data/seed/handler-promotions.lino"
  source cli
    path "rust/src/main.rs"
  source routes
    path "data/meta/server-routes.lino"
  part overview
    file "system-overview.md"
    uses handler_precedence
    uses handler_promotions
    uses cli
    uses routes
  part handlers
    file "solver-handlers.md"
    uses handler_precedence
    uses handler_promotions
  part cli
    file "cli-subcommands.md"
    uses cli
  part routes
    file "http-routes.md"
    uses routes
  node cli
    kind entry
    part cli
    label "formal-ai CLI"
    detail "{count} subcommands"
    count cli_subcommands
  node http
    kind entry
    part routes
    label "HTTP server, JavaScript and Rust"
    detail "{count} routes"
    count routes
  node browser
    kind entry
    part handlers
    label "browser worker"
    detail "{count} browser-only handlers"
    count browser_handlers
  node planner
    kind layer
    label "agentic planner"
    detail "recipes in agentic-recipes.md"
  node solver
    kind layer
    label "universal solver"
    detail "one turn, first match wins"
  node promotions
    kind layer
    part handlers
    label "handler promotions"
    detail "{count} rules hoist a handler"
    count promotions
  node precedence
    kind layer
    part handlers
    label "specialized-handler precedence"
    detail "{count} handlers in rank order"
    count handlers
  node answer
    kind layer
    label "answer"
    detail "text, tool calls or a trace"
  edge cli_chat
    from cli
    to solver
    subcommand chat
  edge cli_serve
    from cli
    to http
    subcommand serve
  edge cli_agent
    from cli
    to planner
    subcommand agent
  edge http_chat
    from http
    to solver
    route chat_completions
  edge http_responses
    from http
    to solver
    route responses
  edge http_messages
    from http
    to solver
    route anthropic_messages
  edge browser_solver
    from browser
    to solver
  edge planner_http
    from planner
    to http
    route chat_completions
  edge solver_promotions
    from solver
    to promotions
  edge promotions_precedence
    from promotions
    to precedence
  edge precedence_answer
    from precedence
    to answer
  message document_comment
    text "<!-- Generated by `node scripts/generate-system-diagrams.mjs --write` (Rust twin: rust/src/agentic_coding/system_diagram.rs) from {sources}. Do not hand-edit; CI fails when this file drifts from the generator. -->"
  message overview_title
    text "# Formal AI system overview (generated)"
  message overview_intro
    text "A high-level view of where a request enters Formal AI and which layers it crosses, generated from the live sources each part names. The per-entry-point views:"
  message overview_part_link
    text "- [{title}]({file})"
  message overview_recipes_link
    text "- [Agent CLI recipes](agentic-recipes.md), generated by the Agent CLI itself"
  message overview_heading
    text "## Part 1 — Entry points to layers"
  message overview_entries
    text "Entry points"
  message overview_layers
    text "Layers"
  message handlers_title
    text "# Formal AI solver handler registry (generated)"
  message handlers_intro
    text "The universal solver tries its specialized handlers first-match-wins. A promotion rule that fires for a prompt hoists its handler ahead of the precedence; every other handler is tried in ascending rank. Dashed nodes are rows marked `browser_only`, which only the browser worker runs."
  message handlers_promotions_heading
    text "## Part 1 — Promotions, in rank order"
  message handlers_precedence_heading
    text "## Part {part} — Precedence, ranks {first} to {last}"
  message handlers_prompt
    text "prompt"
  message handlers_precedence_node
    text "handler precedence, Part 2 onward"
  message handlers_previous
    text "ranks before {rank}"
  message handlers_next
    text "ranks after {rank}"
  message column_rank
    text "Rank"
  message column_handler
    text "Handler"
  message column_because
    text "Why the rule exists"
  message column_surface
    text "Runs on"
  message surface_native
    text "native and browser"
  message surface_browser
    text "browser worker only"
  message cli_title
    text "# Formal AI CLI subcommands (generated)"
  message cli_intro
    text "Every subcommand of the `formal-ai` binary, in the order its clap `Command` enum declares them, with the first sentence of each one's documentation."
  message cli_heading
    text "## Part 1 — `formal-ai` subcommands"
  message column_subcommand
    text "Subcommand"
  message column_summary
    text "Summary"
  message routes_title
    text "# Formal AI HTTP routes (generated)"
  message routes_intro
    text "Every route of the route manifest, grouped by method. The JavaScript server routes from the manifest and the Rust server is held to it by rust/tests/unit/server_route_manifest.rs, so this view is both servers' surface. A solid edge needs the bearer token; a dotted edge is open."
  message routes_heading
    text "## Part 1 — Routes by method"
  message routes_server
    text "HTTP server"
  message column_route
    text "Route"
  message column_method
    text "Method"
  message column_paths
    text "Paths"
  message column_auth
    text "Auth"
  message routes_deprecated
    text "{route}, deprecated"
