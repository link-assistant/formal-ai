# The areas of the assembled requirement register (R1188-U5).
#
# `scripts/assemble-requirements.rs` (and its JavaScript twin) writes one file
# per area, `docs/requirements/assembled/<area>.md`, so each part of the
# register says what it holds instead of being a numbered page. A shard
# belongs to the first area, in the order below, whose `match` text occurs in
# its file name; the last area matches every name, so a new shard always has a
# home. An area that grows past the 1400-line limit of an assembled part fails
# the assembly: give some of its shards a more specific `match` elsewhere.
requirement-areas
  area standing-doctrine
    title "Standing doctrine, vision and scope"
    match "preamble-"
    match "doctrine-"
    match "vision"
    match "standards"
    match "reasoning-standard"
    match "current-scope"
    match "moonshot"
    match "least-action"
    match "links-network"
    match "user-requirements"
    match "symbolic-ai-reference"
    match "dropped-requirements"
    match "recursive-semantic"
    match "self-development"
  area delivery-quality-and-compliance
    title "Delivery, quality and compliance"
    match "ci-"
    match "-ci"
    match "release"
    match "coverage"
    match "test-matrix"
    match "benchmark"
    match "ratchet"
    match "census"
    match "generated-versions"
    match "dependency"
    match "conventions"
    match "false-results"
    match "evidence"
    match "badge"
    match "replay"
    match "bottleneck"
    match "gate"
    match "legal"
  area interfaces-and-integrations
    title "Interfaces and integrations"
    match "telegram"
    match "ui-"
    match "demo"
    match "surface"
    match "docker"
    match "memory-export"
    match "transports"
    match "client"
    match "codex"
    match "cli-"
    match "credentials"
    match "agent-config"
    match "reporting"
    match "issue-reports"
    match "recap"
    match "failure-report"
    match "hive-mind"
    match "connectivity"
    match "sharing"
    match "cloud"
    match "orchestration"
    match "i18n"
    match "nemotron"
    match "deletion"
  area coding-and-agents
    title "Coding and agents"
    match "coding"
    match "code"
    match "program"
    match "agentic"
    match "workspace"
    match "repository"
    match "discovery"
    match "decomposition"
    match "skill-compiler"
    match "software"
    match "editing"
    match "synthesis-parity"
    match "substitution"
    match "box-language"
    match "continuation"
    match "work-item"
    match "repair"
    match "duplication"
    match "verifiable-task"
  area reasoning-and-knowledge
    title "Reasoning and knowledge"
    match ""
