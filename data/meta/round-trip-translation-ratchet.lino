  ru-hi-term-survival 0.336
  ru-zh-sentence-survival 0.125
  ru-zh-term-survival 0.352
  ru-es-sentence-survival 0.125
  ru-es-term-survival 0.361
  hi-en-sentence-survival 0.093
  hi-en-term-survival 0.384
  hi-ru-sentence-survival 0.093
  hi-ru-term-survival 0.401
  hi-zh-sentence-survival 0.093
  hi-zh-term-survival 0.392
  hi-es-sentence-survival 0.093
  hi-es-term-survival 0.396
  zh-en-sentence-survival 0.109
