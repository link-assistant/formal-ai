  ru-hi-term-survival 0.333
  ru-zh-sentence-survival 0.125
  ru-zh-term-survival 0.351
  ru-es-sentence-survival 0.109
  ru-es-term-survival 0.28
  hi-en-sentence-survival 0.093
  hi-en-term-survival 0.382
  hi-ru-sentence-survival 0.093
  hi-ru-term-survival 0.401
  hi-zh-sentence-survival 0.093
  hi-zh-term-survival 0.382
  hi-es-sentence-survival 0.078
  hi-es-term-survival 0.292
