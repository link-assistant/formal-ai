{
  "language": ["^(?:answer|respond|reply)\\s+in\\s+the\\s+(same)\\s+language\\s+as\\s+the\\s+user['’]s\\s+input$", "^(?:[-*]\\s+)?(?:(?:(?:you\\s+)?(?:must\\s+)?(?:always\\s+)?)|(?:do\\s+not\\s+|never\\s+|don't\\s+))(?:answer|respond|reply|write)\\s+(?:only\\s+)?in\\s+([\\p{L}-]+)", "^(?:[-*]\\s+)?(?:не\\s+)?(?:отвечай|отвечайте|ответь)\\s+(?:только\\s+)?(?:на\\s+|по-)?([\\p{L}-]+)"],
