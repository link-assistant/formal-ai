# Vendored tree-sitter runtime and Rust grammar (issue #1180 R11).
#
# The JavaScript root's Rust node-kind histogram (js/agentic/crate/
# rust_ast_census.mjs) parses with these files. They are verbatim upstream
# artifacts, never edited: web-tree-sitter.mjs is the package's ESM build
# (web-tree-sitter.js renamed to .mjs so it is not a translated source), and
# tree-sitter-rust.wasm is the release asset of the same tree-sitter-rust
# version Cargo.lock resolves for meta-language, so both runtimes parse with
# one grammar. rust/tests/web/issue-1180-rust-ast-census.test.mjs checks each
# sha256 below and the grammar version against Cargo.lock.
vendored_tree_sitter
  file web-tree-sitter.mjs
    package "web-tree-sitter"
    version "0.27.0"
    source "https://registry.npmjs.org/web-tree-sitter/-/web-tree-sitter-0.27.0.tgz"
    upstream_path "package/web-tree-sitter.js"
    license "LICENSE-web-tree-sitter"
    sha256 "7c49e3c1d87e24e0bb4c2def909d17154dfde281f5f8280225450090bb4b8110"
  file web-tree-sitter.wasm
    package "web-tree-sitter"
    version "0.27.0"
    source "https://registry.npmjs.org/web-tree-sitter/-/web-tree-sitter-0.27.0.tgz"
    upstream_path "package/web-tree-sitter.wasm"
    license "LICENSE-web-tree-sitter"
    sha256 "c03bccdc3b448a32848f5ae327e209c982bbb0840d43eec8bc2d5759544a1ed3"
  file tree-sitter-rust.wasm
    package "tree-sitter-rust"
    version "0.24.2"
    source "https://github.com/tree-sitter/tree-sitter-rust/releases/download/v0.24.2/tree-sitter-rust.wasm"
    upstream_path "tree-sitter-rust.wasm"
    license "LICENSE-tree-sitter-rust"
    sha256 "24c89bd9252255e4aebbcbd7d2d308bd92c86dd95a130fdc80efa49577b8d738"
