{
  "name": "formal-ai-vscode",
  "displayName": "formal-ai",
  "version": "0.345.0",
  "private": true,
  "description": "VS Code extension (desktop + web) embedding the formal-ai symbolic chat UI",
  "publisher": "link-assistant",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/link-assistant/formal-ai"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Machine Learning",
    "Chat",
    "Other"
  ],
  "main": "./src/extension.node.cjs",
  "browser": "./src/extension.web.cjs",
  "activationEvents": [
    "onView:formal-ai.chatView",
    "onCommand:formal-ai.openChat",
    "onCommand:formal-ai.openDebugger"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The in-process symbolic agent is safe everywhere; the opt-in local server and Docker code execution only run in trusted desktop windows."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "formal-ai.openChat",
        "title": "Open Chat",
        "category": "formal-ai"
      },
      {
        "command": "formal-ai.toggleServer",
        "title": "Toggle Local Server",
        "category": "formal-ai"
      },
      {
        "command": "formal-ai.syncMemory",
        "title": "Sync Memory",
        "category": "formal-ai"
      },
      {
        "command": "formal-ai.openNetworkView",
        "title": "Open Network View",
        "category": "formal-ai"
      },
      {
        "command": "formal-ai.openDebugger",
        "title": "Open Debugger",
        "category": "formal-ai"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "formal-ai",
          "title": "formal-ai",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "formal-ai": [
        {
          "type": "webview",
          "id": "formal-ai.chatView",
          "name": "Chat"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "formal-ai.toggleServer",
          "when": "view == formal-ai.chatView",
          "group": "navigation@1"
        },
        {
          "command": "formal-ai.openNetworkView",
          "when": "view == formal-ai.chatView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "formal-ai",
      "properties": {
        "formal-ai.server.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Start a local OpenAI-compatible `formal-ai serve` process and route chat through `POST /v1/chat/completions`. Desktop (Node) host only; ignored in the web host, which always runs the in-process symbolic agent."
        },
        "formal-ai.server.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Loopback host the local server binds to (desktop host only)."
        },
        "formal-ai.server.port": {
          "type": "number",
          "default": 18080,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port the local server binds to (desktop host only)."
        },
        "formal-ai.docker.image": {
          "type": "string",
          "default": "konard/box-dind:2.10.2",
          "description": "Docker image used to sandbox code-execution tool calls (desktop host only, when a permitted tool runs)."
        },
        "formal-ai.tools.allowByDefault": {
          "type": "boolean",
          "default": false,
          "description": "Grant write, edit, host shell, and sandboxed code-execution tool calls by default. Read-only file and web tools remain available when this is off."
        },
        "formal-ai.agent.defaultOn": {
          "type": "boolean",
          "default": false,
          "description": "Enable agent mode (which drives tool grants) by default when the chat view opens."
        }
      }
    }
  },
  "scripts": {
    "dev": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=.",
    "prepare-resources": "node scripts/prepare-resources.mjs",
    "vscode:prepublish": "node scripts/prepare-resources.mjs",
    "package": "vsce package",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/config.test.mjs scripts/bridge.test.mjs scripts/webview-html.test.mjs scripts/chat-view.test.mjs scripts/server-process.test.mjs && node scripts/smoke.mjs",
    "test:package": "node --test scripts/bundle-web-tools.test.mjs"
  },
  "devDependencies": {
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@link-assistant/web-capture": "^1.12.0",
    "@link-assistant/web-search": "^0.11.1",
    "playwright": "^1.64.0"
  },
  "browser-commander//": "blocked: https://github.com/link-assistant/web-capture/issues/160 (0.21+ launches the installed Chrome over CDP by default; web-capture 1.11.2 does not pass launch: 'engine', so 0.20.0 is the newest override it runs on)",
  "@kreuzberg/html-to-markdown-node//": "blocked: https://github.com/xberg-io/html-to-markdown/issues/459 (every release after 3.5.5, through 3.7.2, declares linux musl optional packages that npm does not have)",
  "overrides": {
    "@link-assistant/web-capture": {
      "@kreuzberg/html-to-markdown-node": "3.5.5",
      "browser-commander": "0.20.0",
      "puppeteer": "^25.12.0",
      "puppeteer-core": "^25.12.0",
      "qs": "^6.16.0"
    }
  },
  "allowScripts": {
    "@playwright/browser-chromium": true,
    "@vscode/vsce-sign": true,
    "esbuild": true,
    "keytar": true,
    "puppeteer": true
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#175f4f",
    "theme": "dark"
  },
  "keywords": [
    "symbolic AI",
    "Links Notation",
    "deterministic",
    "WebAssembly",
    "agent",
    "chat"
  ],
  "bugs": {
    "url": "https://github.com/link-assistant/formal-ai/issues"
  },
  "homepage": "https://github.com/link-assistant/formal-ai/tree/main/vscode"
}
