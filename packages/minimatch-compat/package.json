{
  "name": "@formal-ai/minimatch-compat",
  "version": "11.0.1",
  "private": true,
  "description": "Callable CommonJS facade, versioned with its patched upstream minimatch implementation",
  "type": "module",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "minimatch-modern": "npm:minimatch@11.0.1"
  }
}
