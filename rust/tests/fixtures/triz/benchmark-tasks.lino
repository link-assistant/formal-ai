triz_task_truck_braking
  record_type "triz_benchmark_task"
  task_id "truck_braking"
  domain "automotive"
  statement "Stop a loaded truck in the same distance as an empty one."
  contradiction "stopping distance vs load"
  methods "family_condition_separation family_partial_spectrum"
