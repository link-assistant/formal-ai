triz_task_bridge_corrosion
  record_type "triz_benchmark_task"
  task_id "bridge_corrosion"
  domain "infrastructure"
  statement "Protect a steel bridge from rust without repainting it every few years."
  contradiction "protection interval vs maintenance cost"
  methods "family_inverse_problem family_supersystem"
  notes "Sacrificial anodes: let the corrosion you cannot stop protect what it would have eaten."
  source "https://en.wikipedia.org/wiki/TRIZ"
triz_task_vending_coins
  record_type "triz_benchmark_task"
  task_id "vending_coins"
  domain "payment hardware"
  statement "Accept genuine coins reliably without jams from slugs and bent coins."
  contradiction "acceptance reliability vs jam resistance"
  methods "family_condition_separation family_dimension_change"
  notes "Read mass, diameter and conductivity in different fields; route rejects by a path that cannot jam the accept path."
  source "https://en.wikipedia.org/wiki/TRIZ"
triz_task_bottle_cutting
  record_type "triz_benchmark_task"
  task_id "bottle_cutting"
  domain "craft and workshop"
  statement "Cut a glass bottle cleanly at home with no saw and no shattering."
  contradiction "cut quality vs tool availability"
  methods "family_phase_transition family_dimension_change"
  notes "Score, then thermal shock: stress in a different field does the separating."
  source "https://en.wikipedia.org/wiki/TRIZ"
