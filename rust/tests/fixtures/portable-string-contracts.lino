# Shared observed string contracts; not a claim of complete runtime parity.
(contract quote-empty (function quoteShellWord) (arguments (text %)) (expected %27%27))
(contract quote-simple (function quoteShellWord) (arguments (text hello)) (expected %27hello%27))
(contract quote-apostrophes (function quoteShellWord) (arguments (text a%27b%27c)) (expected %27a%27%5C%27%27b%27%5C%27%27c%27))
(contract quote-shell-control (function quoteShellWord) (arguments (text %24%28touch%20impossible%29%3B%20&%20|%20<%20>)) (expected %27%24%28touch%20impossible%29%3B%20&%20|%20<%20>%27))
(contract quote-multiline (function quoteShellWord) (arguments (text first%0Asecond)) (expected %27first%0Asecond%27))
(contract quote-unicode (function quoteShellWord) (arguments (text %E6%97%A5%E6%9C%AC%E8%AA%9E%20%F0%9F%8C%8D%20caf%C3%A9)) (expected %27%E6%97%A5%E6%9C%AC%E8%AA%9E%20%F0%9F%8C%8D%20caf%C3%A9%27))
(contract quote-backslashes (function quoteShellWord) (arguments (text C%3A%5Cwork%5Cfolder)) (expected %27C%3A%5Cwork%5Cfolder%27))
(contract quote-nul (function quoteShellWord) (arguments (text a%00b)) (expected %27a%00b%27))
(contract join-empty (function joinFailureInvitation) (arguments (text %) (text %)) (expected %))
(contract join-body (function joinFailureInvitation) (arguments (text body) (text %)) (expected body))
(contract join-invitation (function joinFailureInvitation) (arguments (text %) (text invite)) (expected invite))
(contract join-both (function joinFailureInvitation) (arguments (text diagnostic) (text question)) (expected diagnostic%0A%0Aquestion))
(contract join-spanish (function joinFailureInvitation) (arguments (text Diagn%C3%B3stico) (text %C2%BFPreparar%20informe%3F)) (expected Diagn%C3%B3stico%0A%0A%C2%BFPreparar%20informe%3F))
(contract join-unicode (function joinFailureInvitation) (arguments (text %E6%95%85%E9%9A%9C%20%F0%9F%8C%8D) (text %E7%BB%A7%E7%BB%AD%EF%BC%9F)) (expected %E6%95%85%E9%9A%9C%20%F0%9F%8C%8D%0A%0A%E7%BB%A7%E7%BB%AD%EF%BC%9F))
(contract join-preserve-whitespace (function joinFailureInvitation) (arguments (text body%0A) (text %20invite%20)) (expected body%0A%0A%0A%20invite%20))
