# Response templates for numeric-list code answers (issue #918).
#
# Each operation of data/seed/numeric-list-operations.lino introduces its
# generated program with one numeric_list_intro_<operation> sentence; English
# names the value noun ({noun}: numbers or strings). {lang} is the program
# language and {given} the list as given. Filled in one pass by
# rust/src/solver_handlers/numeric_list/mod.rs and the browser twin in
# js/worker/formal_ai_worker_06.js.
multilingual_responses
  response response_numeric_list_intro_sort_en
    intent numeric_list_intro_sort
    language en
    text "Here is {lang} code that sorts the {noun} {given} in ascending order:"
  response response_numeric_list_intro_reverse_sort_en
    intent numeric_list_intro_reverse_sort
    language en
    text "Here is {lang} code that sorts the {noun} {given} in descending order:"
  response response_numeric_list_intro_reverse_en
    intent numeric_list_intro_reverse
    language en
    text "Here is {lang} code that reverses the {noun} {given}:"
  response response_numeric_list_intro_sum_en
    intent numeric_list_intro_sum
    language en
    text "Here is {lang} code that sums the {noun} {given}:"
  response response_numeric_list_intro_product_en
    intent numeric_list_intro_product
    language en
    text "Here is {lang} code that multiplies the {noun} {given}:"
  response response_numeric_list_intro_minimum_en
    intent numeric_list_intro_minimum
    language en
    text "Here is {lang} code that finds the smallest of the {noun} {given}:"
  response response_numeric_list_intro_maximum_en
    intent numeric_list_intro_maximum
    language en
    text "Here is {lang} code that finds the largest of the {noun} {given}:"
  response response_numeric_list_intro_sort_ru
    intent numeric_list_intro_sort
    language ru
    text "Вот код на {lang}, который сортирует числа {given} по возрастанию:"
