      text "  -> func makeArray<Item>(repeating item: Item, numberOfTimes: Int) -> [Item] {\n         var result: [Item] = []\n         for _ in 0..<numberOfTimes {\n              result.append(item)\n         }\n         return result\n     }\n  >> let fourKnocks =\n  -> makeArray(repeating: ""knock"", numberOfTimes: 4)\n  >> print(fourKnocks)\n  << [""knock"", ""knock"", ""knock"", ""knock""]"
