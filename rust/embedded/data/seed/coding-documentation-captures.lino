      language "swift"
      text "func anyCommonElements<T: Sequence, U: Sequence>(_ lhs: T, _ rhs: U) -> Bool\n    where T.Element: Equatable, T.Element == U.Element\n{\n    for lhsItem in lhs {\n        for rhsItem in rhs {\n            if lhsItem == rhsItem {\n                return true\n            }\n        }\n    }\n   return false\n}\nanyCommonElements([1, 2, 3], [3])"
    block
      language "swifttest"
      text "  -> func anyCommonElements<T: Sequence, U: Sequence>(_ lhs: T, _ rhs: U) -> Bool\n         where T.Element: Equatable, T.Element == U.Element\n     {\n         for lhsItem in lhs {\n             for rhsItem in rhs {\n                 if lhsItem == rhsItem {\n                     return true\n                 }\n             }\n         }\n        return false\n     }\n  >> let hasAnyCommon =\n  -> anyCommonElements([1, 2, 3], [3])\n  >> print(hasAnyCommon)\n  << true"
