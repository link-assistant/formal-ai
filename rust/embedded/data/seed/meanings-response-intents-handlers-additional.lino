  inappropriate-content
    defined-by answer
    role localized_response_template
    precondition "a message holds vulgar or abusive words"
    effect "asks to keep the conversation respectful"
    unit "not applicable"
    example "That message contains inappropriate content."
    grounding "data/seed/multilingual-responses.lino"
  bounded-autonomy
    defined-by answer
    role localized_response_template
    precondition "a chat request asks for repeated actions with no end and no agent opt-in"
    effect "says a chat reply is bounded and open-ended work needs agent mode in a sandbox"
    unit "not applicable"
    example "I can only run a bounded chat reply per message."
    grounding "data/seed/multilingual-responses-policy.lino"
  add-only-history
    defined-by answer
    role localized_response_template
    precondition "a request asks to forget something the link network holds"
    effect "says the network only appends and a retraction appends a superseding event"
    unit "not applicable"
    example "The link network is append-only."
    grounding "data/seed/multilingual-responses-policy.lino"
  cache-flush-requires-confirmation
    defined-by answer
    role localized_response_template
    precondition "a request asks to clear the source cache"
    effect "asks for an explicit confirmation of the auditable flush"
    unit "not applicable"
    example "Flushing the source cache is an auditable action."
    grounding "data/seed/multilingual-responses-policy.lino"
  destructive-action-requires-confirmation
    defined-by answer
    role localized_response_template
    precondition "an agent request asks to destroy a repository, a database or a file tree"
    effect "asks for an explicit human confirmation before the sandboxed action runs"
    unit "not applicable"
    example "Destructive agent actions require an explicit human confirmation."
    grounding "data/seed/multilingual-responses-policy.lino"
  agent-time-budget
    defined-by answer
    role localized_response_template
    precondition "an agent request asks to run without a time bound"
    effect "refuses the unbounded loop under the documented time budget"
    unit "not applicable"
    example "Agent execution is bounded by a documented time budget."
    grounding "data/seed/multilingual-responses-policy.lino"
  agent-action
    defined-by answer
    role localized_response_template
    precondition "a request opts in to agent mode for one message"
    effect "confirms the opt-in, the isolated sandbox and the action log"
    unit "not applicable"
    example "Agent mode is opted in for this message."
    grounding "data/seed/multilingual-responses-policy.lino"
  machine
    defined-by concept
    role response_audience
    precondition "a multilingual response row is read by a program (a code template, a log line), not by a person"
    effect "marks the row with audience machine, so its language owes no translation in the response-language debt"
    unit "not applicable"
    example "audience machine"
    grounding "scripts/generate-response-parity-debt.mjs"
