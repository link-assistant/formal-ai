    precondition "one relation row of a seeded-fact comparison is rendered"
    effect "the relation is listed with each subject's seeded value"
    unit "not applicable"
    example "- capital: Japan — Tokyo; Russia — Moscow"
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_comparison_known_row
    defined-by answer
    role localized_response_template
    precondition "one relation row of the side a comparison gap does know is rendered"
    effect "the relation is listed with its seeded value"
    unit "not applicable"
    example "- capital: Tokyo"
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_comparison_missing_value
    defined-by answer
    role localized_response_template
    precondition "a comparison row lacks a seeded value for one subject"
    effect "the missing side is marked instead of guessed"
    unit "not applicable"
    example "no seeded value"
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_comparison_difference
    defined-by answer
    role localized_response_template
    precondition "a relation seeded for both compared subjects carries different values"
    effect "the difference is stated with both values"
    unit "not applicable"
    example "Difference in capital: Tokyo for Japan, Moscow for Russia."
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_comparison_same
    defined-by answer
    role localized_response_template
    precondition "a relation seeded for both compared subjects carries the same value"
    effect "the shared value is stated once"
    unit "not applicable"
    example "Same capital for both: Tokyo."
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_comparison_unaligned
    defined-by answer
    role localized_response_template
    precondition "a relation is seeded for only one compared subject"
    effect "the relation is named as not comparable yet"
    unit "not applicable"
    example "capital is seeded only for Japan, so it cannot be compared yet."
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_comparison_gap
    defined-by answer
    role localized_response_template
    precondition "a comparison names one subject with seeded facts and one without"
    effect "the missing side is named and the known side's facts are listed"
    unit "not applicable"
    example "I can compare Japan and Australia only from seeded facts, and I have none for Australia."
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_answer
    defined-by answer
    role localized_response_template
    precondition "a question over prompt-supplied text is answered from that text alone"
    effect "the sentence of the text that covers the question is quoted"
    unit "not applicable"
    example "The text answers this: «The meeting moved to Thursday at 3 pm in room 204.»"
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_gap
    defined-by answer
    role localized_response_template
    precondition "no sentence of the prompt-supplied text covers the question"
    effect "the answer says the text does not say, naming the uncovered words"
    unit "not applicable"
    example "The given text does not say: none of its sentences mentions ceo."
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_slot_answer
    defined-by answer
    role localized_response_template
    precondition "the question asks a slot (time, place or subject) the covering sentence's statement fills"
    effect "the asked slots of the projected statement are stated first"
    unit "not applicable"
    example "From the text — time «from Tuesday to Thursday at 3 pm»; place «in room 204»."
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_statement
    defined-by answer
    role localized_response_template
    precondition "the covering sentence of a prompt-supplied text projects into a statement"
    effect "the statement's filled slots are listed after the quoted sentence"
    unit "not applicable"
    example "As a statement: subject «The meeting»; predicate «moved»; time «from Tuesday to Thursday at 3 pm»; place «in room 204»"
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_slot_subject
    defined-by answer
    role localized_response_template
    precondition "a projected statement has a subject"
    effect "the subject slot is named with its words"
    unit "not applicable"
    example "subject «The meeting»"
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_slot_predicate
    defined-by answer
    role localized_response_template
    precondition "a projected statement has a predicate"
    effect "the predicate slot is named with its words"
    unit "not applicable"
    example "predicate «moved»"
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_slot_object
    defined-by answer
    role localized_response_template
    precondition "a projected statement has an object"
    effect "the object slot is named with its words"
    unit "not applicable"
    example "object «the report»"
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_slot_time
    defined-by answer
    role localized_response_template
    precondition "a projected statement has a time phrase"
    effect "the time slot is named with its phrases"
    unit "not applicable"
    example "time «from Tuesday to Thursday at 3 pm»"
    grounding "data/seed/multilingual-responses-entities.lino"
  prompt_text_slot_place
    defined-by answer
    role localized_response_template
    precondition "a projected statement has a place phrase"
    effect "the place slot is named with its phrases"
    unit "not applicable"
    example "place «in room 204»"
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_live_answer
    defined-by answer
    role localized_response_template
    precondition "no seeded fact answers the question and Wikidata states a value for the asked relation of the subject"
    effect "the value is stated with the reference URL the claim cites, else the subject snapshot it was read from"
    unit "not applicable"
    example "Wikidata states that the capital of Australia is Canberra, with the page its claim cites as the source."
    grounding "data/seed/multilingual-responses-entities.lino"
  fact_live_answer_author_of_book
    defined-by answer
    role localized_response_template
    precondition "no seeded fact answers an authorship question and Wikidata states the author of the work"
    effect "the author is stated as the writer of the work, with the reference URL the claim cites, else the work snapshot it was read from"
    unit "not applicable"
    example "War and Peace was written by Leo Tolstoy, with the page its claim cites as the source."
    grounding "data/seed/multilingual-responses-entities.lino"
  explanation_research_answer
    defined-by answer
    role localized_response_template
    precondition "an explanation request names a concept and retrieved pages state something about it"
    effect "the statements of the retrieved pages that mention the concept are listed"
    unit "not applicable"
    example "What the retrieved pages say about kotlin compiler, followed by one row per statement"
    grounding "data/seed/multilingual-responses-entities.lino"
  explanation_research_row
    defined-by answer
    role localized_response_template
    precondition "a retrieved page states something about the explained concept"
    effect "the statement is quoted with the page URL and the SHA-256 of its bytes"
    unit "not applicable"
    example "One retrieved statement about the compiler, followed by its page address and digest."
    grounding "data/seed/multilingual-responses-entities.lino"
