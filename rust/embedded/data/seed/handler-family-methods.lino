handler_family_methods
  issue 1138
  purpose "Generic method families selected from reusable evidence groups. Every family uses the same matcher; adding a paraphrase adds lexical knowledge here, not a Rust branch or a memorized answer."
  family dialogue_state_query
    priority 10
    preempts capability_gap
    preempts compose_from_sources
    preempts concept_measurement_lookup
    evidence_group dialogue_reference
      cue earlier
      cue "this conversation"
      cue "so far"
      cue "first wrote"
      cue "before the last"
      cue "already ask"
