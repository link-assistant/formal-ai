  # ------------------------------------------------------ advice knowledge
  advice_evidence_grade
    grade systematic_review
    weight 0.9
    label "strong (systematic review)"
  advice_evidence_grade
    grade authority_guideline
    weight 0.75
    label "strong (health-authority guideline)"
  advice_evidence_grade
    grade primary_study
    weight 0.6
    label "moderate (individual primary study)"
  advice_evidence_grade
    grade anecdote
    weight 0.3
    label "weak (anecdote)"
  advice_topic
    topic sleep
    surface sleep
    surface sleeping
    surface "trouble sleeping"
    surface insomnia
    surface сон
    surface бессонница
    surface "не сплю"
    surface नींद
    surface अनिद्रा
    surface 睡眠
    surface 失眠
    surface sueño
    surface insomnio
    note "retrieved from primary health-authority pages and formalized here; the ordinal weighting below awaits the relative meta logic of issue #1179 for full probabilities"
  advice_recommendation
    topic sleep
    grade authority_guideline
    text "Keep a consistent sleep schedule: go to bed and get up at the same times every day, including weekends."
    source "CDC — About Sleep"
    source_url "https://www.cdc.gov/sleep/about/index.html"
  advice_recommendation
    topic sleep
    grade authority_guideline
    text "Most adults need 7 or more hours of sleep per night; teens need 8-10."
    source "CDC — About Sleep"
    source_url "https://www.cdc.gov/sleep/about/index.html"
  advice_recommendation
    topic sleep
    grade authority_guideline
    text "Keep the bedroom quiet, dark, relaxing, and at a comfortable temperature."
    source "NIH News in Health — Good Sleep for Good Health"
    source_url "https://newsinhealth.nih.gov/2013/04/good-sleep-good-health"
  advice_recommendation
    grade primary_study
    topic sleep
    text "Avoid large meals, caffeine, and alcohol in the late evening."
    source "NIH News in Health — Good Sleep for Good Health"
    source_url "https://newsinhealth.nih.gov/2013/04/good-sleep-good-health"
  advice_recommendation
    topic sleep
    grade authority_guideline
    text "Be physically active during the day; it helps you fall asleep at night."
    source "NHLBI — Sleep Health"
    source_url "https://www.nhlbi.nih.gov/health/sleep"
  advice_recommendation
    topic sleep
    grade authority_guideline
    text "Remove electronic devices from the bedroom and stop screen time before sleep."
    source "CDC — About Sleep"
    source_url "https://www.cdc.gov/sleep/about/index.html"
