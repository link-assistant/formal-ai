  # -------------------------------------------------- verse-line skeletons
  poem_line_skeleton
    language en
    rhyme_slot true
    text "the {topic} keeps its counsel by the {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "and all our evenings settle toward the {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "I learned the {topic} the way one learns a {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "no letter reaches farther than the {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "the morning opens like a {rhyme}"
  poem_line_skeleton
    language en
    rhyme_slot true
    text "give the {topic} one more evening, one more {rhyme}"
