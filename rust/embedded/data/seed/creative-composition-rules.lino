  # -------------------------------------------- brainstorm morphology rules
  brainstorm_rule
    kind compound
    note "capitalize both topic words and join them"
  brainstorm_rule
    kind blend
    note "front half of the first topic word fused to the back half of the second"
  brainstorm_rule
    kind suffix
    piece Hub
    piece Lab
    piece Works
    piece House
    piece Corner
    piece Room
    piece Club
    piece Point
    note "capitalize the topic word and append one generic establishment piece"
  brainstorm_rule
    kind definite
    note "the definite article over the two topic words"
  distinctness_metric
    name "pairwise normalized levenshtein ratio"
    floor 0.3
    share_rule "no two returned candidates may share both of their content words"
    statement "candidates are ranked by the stated pairwise normalized levenshtein ratio (floor 0.3, nearest duplicates dropped, first kept) and no two returned candidates share both content words"
