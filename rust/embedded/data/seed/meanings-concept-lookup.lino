meanings
  concept_lookup_unresolved
    defined-by output
    role output_display_request
    precondition "A concept lookup completed and no consulted source produced a sense."
    effect "Name the surface and every consulted source outcome without inventing a meaning."
    unit "count"
    example "No consulted source defined the surface."
    grounding "src/concept_lookup.rs::lookup_surface"
  response_concept_lookup_unresolved_en
    defined-by concept_lookup_unresolved
    language en
    role output_display_request
    precondition "A concept lookup completed and no consulted source produced a sense."
    effect "Report the unresolved surface and consulted outcomes in English."
    unit "count"
    example "No consulted source defined the surface."
    grounding "src/concept_lookup.rs::lookup_surface"
  response_concept_lookup_unresolved_ru
    defined-by concept_lookup_unresolved
    language ru
    role output_display_request
    precondition "A concept lookup completed and no consulted source produced a sense."
    effect "Report the unresolved surface and consulted outcomes in Russian."
    unit "count"
    example "Ни один источник не определил поверхность."
    grounding "src/concept_lookup.rs::lookup_surface"
  response_concept_lookup_unresolved_hi
    defined-by concept_lookup_unresolved
    language hi
    role output_display_request
    precondition "A concept lookup completed and no consulted source produced a sense."
    effect "Report the unresolved surface and consulted outcomes in Hindi."
    unit "count"
    example "किसी स्रोत ने सतह को परिभाषित नहीं किया।"
