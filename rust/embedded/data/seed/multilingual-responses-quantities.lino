  response response_calendar_weekday_offset_split_next_en
    intent calendar_weekday_offset_split_next
    language en
    text "{n} days after {source} is {result}. {n} days = {weeks} weeks + {days} days, and {source_plain} + {days} days = {result} in the seven-day calendar cycle."
  response response_calendar_weekday_offset_split_next_ru
    intent calendar_weekday_offset_split_next
    language ru
    text "Через {n} дней после {source} — {result}. {n} дней = {weeks} недель + {days} дня; {source_plain} + {days} дня = {result} в семидневном календарном цикле."
  response response_calendar_weekday_offset_split_next_hi
    intent calendar_weekday_offset_split_next
    language hi
    text "{source} के {n} दिन बाद {result} है। {n} दिन = {weeks} सप्ताह + {days} दिन; {source_plain} + {days} दिन = {result}, सात दिनों के कैलेंडर चक्र में।"
