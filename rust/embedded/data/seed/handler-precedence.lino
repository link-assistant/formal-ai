# Specialized-handler precedence as rank links (plan 09 leaf 41, issue #1138
# stage 3). Each handler row declares its dispatch precedence as an explicit
# `rank` link — first-match-wins tries handlers in ascending rank order, and two
# rows never share a rank. The rank step is 10 so a new handler can be slotted
# between two neighbours without renumbering the table. Document position
# carries no meaning — the loader sorts by rank, so an operator edit is
# changing a rank value, not moving a row.
#
# `browser_only true` marks rows only the browser worker runs; the native
# dispatcher skips them when it joins the order to its function pointers
# (plan 09 leaf 13). Trailing guard notes are `note` fields, still comments to
# the meaning-closure audit — only value tokens are grounded, never the head
# slug a row names.
handler_precedence
  handler conversation_control
    rank 10
    note "explicit preferences and corrections stay local instead of becoming web searches"
  handler agentic_continuation
    rank 20
    note "a turn that is only a continuation cue resumes the agentic task; with nothing to resume it is answered here, never searched for (issue 1095)"
  handler exact_memory_query
    rank 30
    browser_only true
    note "the memory store lives in the worker, so the exact-memory query runs there alone (plan 09 leaf 13)"
  handler memory_program
    rank 40
    browser_only true
    note "the worker interprets stored memory programs there alone (plan 09 leaf 13)"
  handler memory_program_gap
    rank 50
    browser_only true
    note "surfaces what the stored memory program cannot yet answer (plan 09 leaf 13)"
  handler current_dialogue_fact_checking
    rank 60
    browser_only true
    note "checks the running dialogue against the worker's memory (plan 09 leaf 13)"
  handler link_native_synthesis
    rank 70
    browser_only true
    note "synthesizes over the link store the worker itself holds (plan 09 leaf 13)"
  handler historical
    rank 80
    browser_only true
    note "replays the worker's stored conversation history (plan 09 leaf 13)"
  handler write_program_coreference
    rank 90
    browser_only true
    note "context-bound write-program rewrite over resolved coreference (plan 09 leaf 13)"
  handler program_blueprint_from_prompt
    rank 100
    browser_only true
    note "composes the program blueprint from a bare prompt (plan 09 leaf 13)"
  handler write_program_concrete
    rank 110
    browser_only true
    note "context-bound concrete write-program binding (plan 09 leaf 13)"
  handler software_project_request
    rank 120
    browser_only true
    note "the browser's interactive software-project dialogue (plan 09 leaf 13)"
  handler http_fetch
    rank 130
    note "phase async -- the worker answers fetches in its async network phase"
