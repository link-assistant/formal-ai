# Line-level meaning sentences for common code structures (issue #1177).
#
# `structure` records map a recognizable construct to the sentence the
# explanation handler emits for it. Placeholders in braces ({name}, {item},
# {items}, {expr}, {value}, {index}, {method}, {args}) are filled from the
# matched code line. `grounding` cites the language reference that defines
# the construct.
#
# `function_intent` records map a function name (with aliases) to the
# property that name promises, which the debugging handler uses to state
# what a correct implementation must compute. `correct_form` is the
# canonical expression of that property; `grounding` cites a math source.
#
# Read by `rust/src/solver_handlers/code_explanation.rs` and
# `rust/src/solver_handlers/code_debugging.rs` through
# `crate::seed::seed_files()`.
structure
  construct function_definition
    language python
    pattern "def {name}({args}):"
    explanation "defines a function named {name} which runs its indented body whenever it is called"
    grounding "https://docs.python.org/3.12/reference/compound_stmts.html#function-definitions"
  construct for_loop
    language python
    pattern "for {item} in {items}:"
    explanation "binds {item} to each element of {items} in turn and runs the indented body once per element"
    grounding "https://docs.python.org/3.12/reference/compound_stmts.html#the-for-statement"
  construct if_statement
    language python
    pattern "if {condition}:"
    explanation "runs the indented body only when {condition} evaluates to true"
    grounding "https://docs.python.org/3.12/reference/compound_stmts.html#the-if-statement"
  construct comprehension
    language python
    pattern "[{expr} for {item} in {items}]"
    explanation "builds a new list by evaluating {expr} once for every element of {items}"
    grounding "https://docs.python.org/3.12/reference/expressions.html#displays-for-lists-sets-and-dictionaries"
  construct builtin_sum
    language python
    pattern "sum({items})"
    explanation "adds up all the elements of {items} and returns the total"
    grounding "https://docs.python.org/3.12/library/functions.html#sum"
  construct builtin_len
    language python
    pattern "len({items})"
    explanation "returns the number of elements in {items}"
    grounding "https://docs.python.org/3.12/library/functions.html#len"
  construct builtin_max
    language python
    pattern "max({items})"
    explanation "returns the largest element of {items}"
    grounding "https://docs.python.org/3.12/library/functions.html#max"
  construct builtin_min
    language python
    pattern "min({items})"
    explanation "returns the smallest element of {items}"
    grounding "https://docs.python.org/3.12/library/functions.html#min"
  construct comparison
    language python
    pattern "a == b"
    explanation "compares the two sides for equality and yields true only when they are equal"
    grounding "https://docs.python.org/3.12/reference/expressions.html#value-comparisons"
  construct assignment
    language python
    pattern "{name} = {value}"
    explanation "binds the name {name} to the value on the right"
    grounding "https://docs.python.org/3.12/reference/simple_stmts.html#assignment-statements"
  construct return_statement
    language python
    pattern "return {value}"
    explanation "hands {value} back to the caller and ends the function immediately"
    grounding "https://docs.python.org/3.12/reference/simple_stmts.html#the-return-statement"
  construct division
    language python
    pattern "a / b"
    explanation "divides the left side by the right, producing a float in Python 3 even when both divide evenly"
    grounding "https://docs.python.org/3.12/reference/expressions.html#binary-arithmetic-operations"
  construct indexing
    language python
    pattern "{items}[{index}]"
    explanation "selects the element of {items} at position {index}, counting from zero"
    grounding "https://docs.python.org/3.12/reference/expressions.html#subscriptions"
  construct method_call
    language python
    pattern "{value}.{method}({args})"
    explanation "calls the method named {method} on {value} with the given arguments"
    grounding "https://docs.python.org/3.12/reference/expressions.html#calls"
  construct arrow_function
    language javascript
    pattern "({args}) => {expr}"
    explanation "defines a function taking {args} whose body is {expr}; when the body is an expression its value is returned"
    grounding "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Functions/Arrow_functions"
  construct const_declaration
    language javascript
    pattern "const {name} = {value}"
    explanation "binds {name} to {value} in a binding that cannot be reassigned"
    grounding "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Statements/const"
  construct promise_then
    language javascript
    pattern "{value}.then({handler})"
    explanation "registers {handler} to run with the result when {value} resolves, and returns a new promise that chains further handlers"
    grounding "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Promise/then"
function_intent
  name average
    alias mean
    property "the arithmetic mean: the sum of the elements divided by their count"
    correct_form "sum(xs) / len(xs)"
    grounding "https://en.wikipedia.org/wiki/Arithmetic_mean"
function_intent
  name max
    alias maximum
    property "the largest of the elements"
    correct_form "max(xs)"
    grounding "https://en.wikipedia.org/wiki/Maxima_and_minima"
function_intent
  name min
    alias minimum
    property "the smallest of the elements"
    correct_form "min(xs)"
    grounding "https://en.wikipedia.org/wiki/Maxima_and_minima"
function_intent
  name sum
    alias total
    property "the total: the sum of all the elements added together"
    correct_form "sum(xs)"
    grounding "https://en.wikipedia.org/wiki/Summation"
function_intent
  name count
    alias length
    property "the number of elements"
    correct_form "len(xs)"
    grounding "https://en.wikipedia.org/wiki/Cardinality"
