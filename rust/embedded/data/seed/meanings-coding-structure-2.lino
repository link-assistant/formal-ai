  extend_run
    defined-by reduction
    role coding_fragment
    role coding_structure
    precondition "an accumulated run sequence and the next text item are available"
    effect "extends the last equal run or appends a new run with count one"
    unit run
    example "[('a', 1)] followed by 'a' becomes [('a', 2)]"
    idiom "{accumulator} + [({item}, 1)] if not {accumulator} or {accumulator}[-1][0] != {item} else {accumulator}[:-1] + [({item}, {accumulator}[-1][1] + 1)]"
    grounding "https://docs.python.org/3.12/library/itertools.html#itertools.groupby"
    license "PSF-2.0"
    bootstrap true
    rediscovery_query "accumulate consecutive equal values"
    realization
      rust "{ let mut extended = {accumulator}; match extended.last_mut() { Some(last) if last.0 == {item} => last.1 += 1, _ => extended.push(({item}, 1_usize)), } extended }"
    fragment_signature (sequence<pair<text,integer>> text)
    fragment_result "sequence<pair<text,integer>>"
    lexeme en
      surface
        text "runs of equal characters"
      surface
        text "run of equal characters"
