  family MiniLM
  params_m 22
  ram_required_mb 128
  disk_required_mb 90
  rating 58
  rating_source "MTEB reranking tier (approx)"
  task_affinity "pick the best match from given options"
  license apache_2
  packaged false
  note "cross-encoder reranker: built for exactly the options-then-select shape, English"
