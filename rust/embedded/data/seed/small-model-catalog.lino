  family Qwen2.5
  params_m 500
  ram_required_mb 1024
  disk_required_mb 450
  rating 52
  rating_source "Open LLM Leaderboard (approx)"
  task_affinity "formalization matching with options"
  license apache_2
  packaged false
  note "strong multilingual coverage for the size"
small_model
