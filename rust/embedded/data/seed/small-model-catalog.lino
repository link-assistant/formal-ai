# Small-model catalog for formalization matching (issue #483).
#
# Candidates for the smallest models that can actually help with
# formalization matching against grounded knowledge (Wikipedia/Wikidata
# Q-ids) — given a surface and a list of candidate entities, pick the
# best match. Two shapes matter -- tiny instruct decoders (the
# link-assistant/model-in-browser experiment runs SmolLM2-135M-Instruct
# via Candle-in-WASM, ~270 MB of weights, ~512 MB free memory) and
# small encoder rerankers (cross-encoders built exactly for
# pick-the-match-from-options, and far smaller).
#
# `ram_required_mb` is the total working-set estimate (weights +
# runtime) and `disk_required_mb` the download size, both rounded up;
# the gate that hides non-fitting models reads them. `rating` is a
# public-standing score on a 0-100 scale, rounded and approximate --
# drawn from the Open LLM Leaderboard for decoders and MTEB retrieval
# scores for encoders -- and only ever used for *sorting and flooring*
# (`rating_source` names where the number came from), never as a
# correctness claim. Verify the two or three rows you act on before
# wiring a download URL into a release.
#
# Every row is `packaged false` — nothing here ships in the application
# package or the web UI; downloads happen on demand, only after the
# user enables the feature (`SmallModelOptions::default()` is off).
# Plain data fields only -- no lexeme blocks, so no language-parity
# gaps open.
small_model_catalog
  record_type "small_model_catalog"
  schema_version 1
  policy formal_first
  steering "llms_never_at_steering_wheel"
  default_state off
  download "on_demand_only"
small_model
  model_id smollm2_135m_instruct
  kind decoder
  family SmolLM2
  params_m 135
  ram_required_mb 512
  disk_required_mb 270
  rating 38
  rating_source "Open LLM Leaderboard (approx, smallest tier)"
  task_affinity "formalization matching with options"
  license apache_2
  packaged false
  note "runs fully client-side via Candle-in-WASM (link-assistant/model-in-browser)"
small_model
  model_id smollm2_360m_instruct
  kind decoder
  family SmolLM2
  params_m 360
  ram_required_mb 1024
  disk_required_mb 700
  rating 45
  rating_source "Open LLM Leaderboard (approx)"
  task_affinity "formalization matching with options"
  license apache_2
  packaged false
  note "same family, better accuracy, still browser-sized"
small_model
