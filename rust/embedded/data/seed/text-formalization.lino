# Numeric symbols/group widths: Unicode LDML Part3, https://www.unicode.org/reports/tr35/tr35-78/tr35-numbers.html
# Measured2026-10-17 with maintained Intl.NumberFormat/ICU 77.1; space/NBSP/NNBSP accepted as grouping only with declared widths.
# R1188-U18, U19 and U21 — the words the shared text formalizer reads a sentence
# with (js/agentic/crate/text_formalization.mjs, its Rust twin
# rust/src/formalization/text_statements.rs). The code names only the three
# kinds below; every word is data, one record per language.
#
#   anaphor              a pronoun that opens a clause by pointing back at the
#                        subject named before; it is read as that subject.
#   clause-continuation  a conjunction or relative pronoun that opens a clause
#                        which keeps the subject of the clause before it.
#   inflection-ending    an ending the formalizer may remove, or exchange for
#                        another ending of the language, to reach the
#                        dictionary form of an inflected word.
#
# Issue #1487 — the proposition structure a statement identity keeps
# (js/agentic/crate/proposition_structure.mjs, its Rust twin
# rust/src/formalization/proposition_structure.rs):
#
#   connective-conjunction / connective-disjunction  the words that join the
#                        parts of one proposition with "and" or with "or";
#   repetition-twice / repetition-thrice  an explicit count of an effect
#                        ("print it twice"), never inferred from a repeated
#                        mention.
#   repetition-twice-count / repetition-thrice-count  the number each explicit
#                        count stands for, read by the output binding of
#                        issue #1166 (rust/src/intent_formalization/obligations.rs).
#
# Issue #1162 — the output a program request binds
# (js/agentic/crate/intent_formalization_obligations.mjs, its Rust twin
# rust/src/intent_formalization/obligations.rs) reads an explicit count right
# after a quoted output through repetition-twice-count / repetition-thrice-count
# above ("prints `Hi` twice" is two lines). The structural rule
# output-repetition names
#
#   repetition-again     the words that make a later mention of an output
#                        already bound a further line ("prints `Hi` and then
#                        prints `Hi` again"). Without them, mentions of one
#                        literal are one output obligation (#1156).
#
# Issue #1550 — the task decomposition the recursive meta-executor splits a
# formalized request with (js/agentic/crate/meta_executor.mjs, its Rust twin
# rust/src/meta_executor.rs):
#
#   connective-sequence / connective-alternative / connective-aggregation
#                        the words that join two tasks done one after the
#                        other, two tasks of which either one answers, and two
#                        tasks whose answers are gathered together. The
#                        structural rule task-decomposition names the
#                        relations in the order a level is split by, the
#                        bounds of the recursion, the test checks and the
#                        action cost of each drafting method.
#
# The structural rules proposition-structure, comparison-relation and
# symbolic-operator name the kinds and lexicon meanings read as connectives,
# quantifiers, ordered comparisons and operators.
#
# Function words and negation cues are not repeated here. They are the
# translation_stop_word, statement_function_word and statement_negation_cue
# roles of the meaning lexicon.
text-formalization
  defaults
    numeric-decimal "."
    numeric-group ","
    numeric-primary-width "3"
    numeric-secondary-width "3"
  structural-rule target-surface
    reject-fragment "response:"
    reject-fragment "-->"
    reject-fragment "{{"
    reject-fragment "[["
  structural-rule numeric-identity
    resolved-prefix "number:"
    unresolved-prefix "number-unresolved:"
  structural-rule typed-statement-notation
    template "(statement (terms {legacy}) (typed_meaning {typed}))"
  structural-rule answer-compatibility
    missing-reason "missing typed evidence"
  structural-rule proposition-structure
    conjunction-vocabulary "connective-conjunction"
    disjunction-vocabulary "connective-disjunction"
    repetition-vocabulary "repetition-twice"
    repetition-vocabulary "repetition-thrice"
    repetition-twice-count "2"
    repetition-thrice-count "3"
    universal-meaning "quantifier_all"
    existential-meaning "quantifier_any"
  structural-rule output-repetition
    again-vocabulary "repetition-again"
  structural-rule task-decomposition
    relation "sequence"
    relation "alternative"
    relation "aggregation"
    sequence-vocabulary "connective-sequence"
    alternative-vocabulary "connective-alternative"
    aggregation-vocabulary "connective-aggregation"
    sequence-requires "all"
    alternative-requires "any"
    aggregation-requires "all"
    depth-bound "2"
    breadth-bound "6"
    budget-bound "8"
    leaf-check "answered"
    composite-check "children"
    unresolved-intent "unknown"
    unresolved-intent "calculation_error"
    unresolved-suffix "_skill_gap"
    unresolved-suffix "_unspecified"
    cache-cost "1"
    derivation-cost "2"
    composition-cost "1"
    quote-pair "«»"
    quote-pair "“”"
    quote-pair "„“"
    quote-pair "「」"
    quote-pair "『』"
    quote-pair "``"
    quote-pair "\"\""
    quote-pair "''"
    edge-punctuation ","
    edge-punctuation ";"
    edge-punctuation "，"
    edge-punctuation "；"
    edge-punctuation "、"
  structural-rule comparison-relation
    less "number_constraint_upper_strict"
    less-converse "number_constraint_lower_strict"
    less-or-equal "number_constraint_upper_inclusive"
    less-or-equal "recurrence_less_equal"
    less-or-equal-converse "number_constraint_lower_inclusive"
  structural-rule symbolic-operator
    less "<"
    less-converse ">"
    less-or-equal "<="
    less-or-equal "≤"
    less-or-equal-converse ">="
    less-or-equal-converse "≥"
    equal "=="
    equal "="
    not-equal "!="
    not-equal "≠"
    minus "-"
    minus "−"
    plus "+"
    times "*"
    times "×"
    divide "/"
    compound-joiner "-"
    compound-joiner "/"
    commutative "equal"
    commutative "not-equal"
    commutative "plus"
    commutative "times"
  language en
    question-where "where"
    question-how-many "how many"
    question-how-many "how much"
    question-which "which"
    question-which "what"
    question-why "why"
    question-who "who"
    question-when "when"
    question-auxiliary "do"
