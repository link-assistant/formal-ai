# R1188-U18, U19 and U21 — the words the shared text formalizer reads a sentence
# with (js/agentic/crate/text_formalization.mjs, its Rust twin
# rust/src/formalization/text_statements.rs). The code names only the three
# kinds below; every word is data, one record per language.
#
#   anaphor              a pronoun that opens a clause by pointing back at the
#                        subject named before; it is read as that subject.
#   clause-continuation  a conjunction or relative pronoun that opens a clause
#                        which keeps the subject of the clause before it.
#   inflection-ending    an ending the formalizer may remove, or exchange for
#                        another ending of the language, to reach the
#                        dictionary form of an inflected word.
#
# Function words and negation cues are not repeated here. They are the
# translation_stop_word, statement_function_word and statement_negation_cue
# roles of the meaning lexicon.
text-formalization
  language en
    anaphor "it"
    anaphor "he"
    anaphor "she"
    anaphor "they"
    anaphor "this"
    anaphor "these"
    clause-continuation "and"
    clause-continuation "which"
    clause-continuation "who"
    clause-continuation "but"
    clause-continuation "or"
    inflection-ending "'s"
    inflection-ending "s"
    inflection-ending "es"
    inflection-ending "ed"
    inflection-ending "ing"
    inflection-ending "ly"
  language ru
    anaphor "он"
    anaphor "она"
    anaphor "оно"
    anaphor "они"
    anaphor "это"
    anaphor "этот"
    anaphor "эта"
