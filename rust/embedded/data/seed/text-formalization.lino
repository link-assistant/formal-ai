    anaphor "it"
    anaphor "he"
    anaphor "she"
    anaphor "they"
    anaphor "this"
    anaphor "these"
    clause-continuation "and"
    clause-continuation "which"
    clause-continuation "who"
    clause-continuation "but"
    clause-continuation "or"
    inflection-ending "'s"
    inflection-ending "s"
    inflection-ending "es"
    inflection-ending "ed"
    inflection-ending "ing"
    inflection-ending "ly"
    connective-conjunction "and"
    connective-disjunction "or"
    connective-sequence "then"
    connective-sequence "and then"
    connective-sequence "after that"
    connective-alternative "or"
    connective-aggregation "and"
    repetition-twice "twice"
    repetition-twice "two times"
    repetition-thrice "thrice"
    repetition-thrice "three times"
    repetition-again "again"
    repetition-again "once more"
    repetition-again "one more time"
