    clause-continuation "а"
    clause-continuation "но"
    inflection-ending "ется"
    inflection-ending "ится"
    inflection-ending "ются"
    inflection-ending "ятся"
    inflection-ending "ться"
    inflection-ending "ает"
    inflection-ending "яет"
