  frame_filler_word
    defined-by concept
    role frame_filler_word
    precondition "a request frames its operand with a word that names no operand of its own"
    effect "the word is set aside when the router asks whether an operand remains"
    unit "not applicable"
    example "hey"
    grounding "data/seed/capability-routing.lino"
    lexeme en
      words "hey" "come on" "ok" "okay" "oh" "well" "everyone says" "everybody says" "statement" "sentence" "following"
    lexeme ru "ну" "давай" "ладно" "все говорят" "все так говорят" "а ты" "утверждение" "предложение" "следующее"
    lexeme hi "चलो" "ना" "अरे" "सब कहते हैं" "इसे" "कथन" "वाक्य" "निम्नलिखित"
    lexeme zh "快" "吧" "啊" "呀" "嘛" "请" "这个" "这句话" "句子" "命题" "一下" "大家都说"
    lexeme es "oye" "vamos" "por favor" "todos dicen" "esto" "enunciado" "frase"
  source_conflict_cue
    defined-by concept
    role source_conflict_cue
    precondition "a request says that sources disagree"
    effect "the source-conflict handler is cued"
    unit "not applicable"
    example "the sources conflict"
    grounding "data/seed/capability-routing.lino"
    lexeme en "conflict" "disagree" "contradict"
    lexeme ru "противореч" "расходятся" "не сходятся" "конфликт"
    lexeme hi "विरोधाभास" "असहमत" "मेल नहीं खाते"
    lexeme zh "矛盾" "冲突" "不一致" "说法不一"
    lexeme es "contradic" "no coinciden" "conflicto"
  information_source_noun
    defined-by concept
    role information_source_noun
    precondition "a request names sources of information as a class"
    effect "a conflict cue is read as a disagreement between sources"
    unit "not applicable"
    example "sources"
    grounding "data/seed/capability-routing.lino"
    lexeme en "source"
    lexeme ru "источник"
    lexeme hi "स्रोत"
    lexeme zh "来源" "资料"
    lexeme es "fuente"
  source_attribution_marker
    defined-by concept
    role source_attribution_marker
    precondition "a clause attributes what it states to a named source"
    effect "the clause is read as one attributed alternative of a source conflict"
    unit "not applicable"
    example "according to"
    grounding "data/seed/capability-routing.lino"
    lexeme en "says" "say" "said" "according to" "states" "claims" "reports" "lists" "gives"
    lexeme ru "пишет" "говорит" "утверждает" "по данным" "согласно" "указывает" "сообщает"
    lexeme hi "के अनुसार" "कहता है" "कहती है" "लिखता है" "बताता है"
    lexeme zh "说" "称" "据" "根据" "写道" "记载"
    lexeme es "dice" "según" "afirma" "indica"
  clause_joiner
    defined-by concept
    role clause_joiner
    precondition "two clauses are joined by a contrastive conjunction"
    effect "the request is split into its clauses at the conjunction"
    unit "not applicable"
    example "but"
    grounding "data/seed/capability-routing.lino"
    lexeme en "but" "while" "whereas"
    lexeme ru "а" "но" "тогда как" "однако"
    lexeme hi "लेकिन" "जबकि" "पर" "मगर"
    lexeme zh "但是" "但" "而" "可是"
    lexeme es "pero" "mientras que"
  second_person_possessive
    defined-by concept
    role second_person_possessive
    precondition "a request names something as belonging to the addressee"
    effect "the object is read as the assistant's own"
    unit "not applicable"
    example "your"
    grounding "data/seed/capability-routing.lino"
    lexeme en "your" "yours"
    lexeme ru "твое" "твоё" "твой" "твоя" "твоего" "твоем" "твоём" "ваш" "ваше" "ваша" "вашего" "вашем"
    lexeme hi "तुम्हारा" "तुम्हारे" "तुम्हारी" "आपका" "आपके" "आपकी"
    lexeme zh "你的" "您的"
    lexeme es "tu" "tus"
