  prime "MOVE: हिलना|हिल|हिलने|हिलता|हिलती|हिलते"
  prime "BE SOMEWHERE: होना|है|हैं"
  prime "THERE IS: है|हैं"
  prime "BE SOMEONE: होना|है|हैं|हो|हूँ"
