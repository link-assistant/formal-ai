# Code example part vocabulary (issue #1164, E129).
#
# The decomposer (rust/src/code_example_knowledge.rs) assigns meanings to
# code parts from two inputs only: the CST node kinds the meta-language
# parse produced, and the per-language vocabulary recorded here. No
# per-language meaning table lives in Rust (R1164-3) -- every language
# fact below is data, so growing language coverage means growing this file.
code_example_parts
  part_language rust
    output_call println!
    output_call print!
    output_call eprintln!
    entry_name main
  part_language kotlin
    output_call println
    output_call print
    entry_name main
  part_language scala
    output_call println
    output_call print
    entry_name main
  part_language swift
    output_call print
    entry_name none
  part_language go
    output_call fmt.Println
    output_call fmt.Print
    output_call println
    entry_name main
  part_language java
    output_call System.out.println
    output_call System.out.print
    entry_name main
  part_language csharp
    output_call Console.WriteLine
    output_call Console.Write
    entry_name Main
  part_language c
    output_call printf
    output_call puts
    entry_name main
  part_language cpp
    output_call std::cout
    output_call printf
    output_call puts
    entry_name main
  part_language javascript
    output_call console.log
    entry_name none
  part_language typescript
    output_call console.log
    entry_name none
  part_language python
    output_call print
    entry_name none
  part_language ruby
    output_call puts
    output_call print
    entry_name none
  part_language php
    output_call echo
    entry_name none
  # Pascal is held out (R1164-9): no grammar row is registered in
  # program-cst-grammars.lino yet, so decompose_code_node answers
  # UnknownGrammar("pascal") today. The vocabulary and shape below are
  # ready for the day the grammar lands; nothing in Rust changes then.
  part_language pascal
    output_call writeln
    output_call write
    entry_name none
  entry_hint_kind function
  entry_hint_kind func
  entry_hint_kind method
  call_hint_kind call
  string_kind_hint string
  import_kind_hint import
  assert_kind_hint assert
  prose_relation
    relation compile_with
    kind build_command
  prose_relation
    relation build_with
    kind build_command
  prose_relation
    relation run_with
    kind run_command
  program_shape rust
    template "fn main() {\n    println!(\"{literal}\");\n}\n"
  program_shape kotlin
    template "fun main() {\n    println(\"{literal}\")\n}\n"
  program_shape scala
    template "object HelloWorld {\n  def main(args: Array[String]): Unit = {\n    println(\"{literal}\")\n  }\n}\n"
  program_shape swift
    template "print(\"{literal}\")\n"
  program_shape go
    template "package main\n\nimport \"fmt\"\n\nfunc main() {\n    fmt.Println(\"{literal}\")\n}\n"
  program_shape java
    template "public class Main {\n    public static void main(String[] args) {\n        System.out.println(\"{literal}\");\n    }\n}\n"
  program_shape csharp
    template "using System;\n\nclass Program {\n    static void Main() {\n        Console.WriteLine(\"{literal}\");\n    }\n}\n"
  program_shape c
    template "#include <stdio.h>\n\nint main(void) {\n    printf(\"{literal}\\n\");\n    return 0;\n}\n"
  program_shape cpp
    template "#include <iostream>\n\nint main() {\n    std::cout << \"{literal}\" << std::endl;\n    return 0;\n}\n"
  program_shape javascript
    template "console.log(\"{literal}\");\n"
  program_shape typescript
    template "console.log(\"{literal}\");\n"
  program_shape python
    template "print(\"{literal}\")\n"
  program_shape ruby
    template "puts \"{literal}\"\n"
  program_shape php
    template "<?php\necho \"{literal}\";\n"
  program_shape pascal
    template "program HelloWorld;\nbegin\n    writeln('{literal}');\nend.\n"
  note "Templates carry each language's quoting style, so the one unquoted bound literal renders correctly everywhere; {literal} is the only placeholder."
