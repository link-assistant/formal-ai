meanings
  install_steps
    defined-by concept
    role action
    precondition "the request carries installation commands to convert"
    effect "admits the claim of the installation conversion handler"
    unit "boolean"
    example "git clone then make install"
    grounding "data/seed/capability-routing.lino"
  learnable_source
    defined-by concept
    role action
    precondition "the request names a declared source the engine can learn from"
    effect "admits the claim of the learn from source handler"
    unit "boolean"
    example "learn from google trends"
    grounding "data/seed/capability-routing.lino"
  legality_assessment
    defined-by concept
    role action
    precondition "the legality catalogue assesses the request by phrase or by act and object"
    effect "admits the claim of the legality advisory"
    unit "boolean"
    example "break into a parked car"
    grounding "data/seed/capability-routing.lino"
  list_items
    defined-by concept
    role action
    precondition "the request lists numbers or at least two quoted values"
    effect "admits the claim of the list operation handler"
    unit "boolean"
    example "sort 5, 2, 9"
    grounding "data/seed/capability-routing.lino"
  marketplace_scope
    defined-by concept
    role action
    precondition "the request names the marketplace a search is scoped to"
    effect "admits the claim of the product search handler"
    unit "boolean"
    example "find a usb cable on amazon.in"
    grounding "data/seed/capability-routing.lino"
  mechanism_subject
    defined-by concept
    role action
    precondition "the mechanism question names its subject"
    effect "admits the claim of the how it works handler"
    unit "boolean"
    example "how does a compiler work"
    grounding "data/seed/capability-routing.lino"
  memory_program_reading
    defined-by concept
    role action
    precondition "the request reads as a seeded memory program family"
    effect "admits the claim of the memory program handlers"
    unit "boolean"
    example "count my saved notes"
    grounding "data/seed/capability-routing.lino"
  pattern_constraints
    defined-by concept
    role action
    precondition "the request names character classes and separators a pattern is composed from"
    effect "admits the claim of the regex synthesis handler"
    unit "boolean"
    example "a regex for five digits"
    grounding "data/seed/capability-routing.lino"
  prior_numeric_list
    defined-by concept
    role action
    precondition "an earlier turn established the list, language or code request a follow-up inherits"
    effect "admits the claim of the list operation handler"
    unit "boolean"
    example "now in rust"
    grounding "data/seed/capability-routing.lino"
  prior_procedure
    defined-by concept
    role action
    precondition "the earlier exchange was an answered how-to request whose task re-parses"
    effect "admits the claim of the procedure follow-up handler"
    unit "boolean"
    example "give me the exact steps"
