# Mandarin Chinese (Simplified) grammar of the controlled output fragment (issue #1584).
# One description drives three directions: realization, parsing (its exact
# inverse) and validation. The tokenizer reads every Han character as its own
# token, so every word list, prime exponent and grammar entry below is checked
# per character: a word such as 动物 passes when both 动 and 物 are allowed.
# NSM prime exponents follow the published Mandarin tables (Chappell; Ye
# Zhengdao; Goddard and Wierzbicka). Because the primes check accepts any
# character that occurs in some prime exponent, it is a known approximation for
# Chinese: the explications below are written with whole prime exponents only.
# The ste, minimal, basic, special, globish and gellish lists are small
# project-authored Chinese analogs of those standards (their dictionaries are
# English or not redistributable here). Frequency tiers are project-authored
# upper character-rank bounds, not a corpus. Keys: bare noun, and the noun with
# its measure word (只猫, 棵树) for quantified templates (每只猫, 一棵树).
# The E-Prime analog forbids the copula 是 anywhere in a sentence.
# Input-only surfaces: a bare 鼠 names the rodent and, colloquially (无线鼠),
# the computer mouse, so a question with it asks which one is meant.
cnl-language zh
  keys ("bare" "measure")
  sentence-space ""
  grammar ("的" "了" "吗" "也" "都" "一" "个" "只" "棵" "片" "根" "台")
  copula "是"
  pronouns ("它" "他" "她" "这" "那" "此" "其" "该")
  fillers ("嗯" "呃" "啊" "哎" "哦" "喂" "哈" "吧" "呢" "呀" "啦" "请" "请问" "问一下" "一下" "帮我" "麻烦你" "到底" "究竟")
  loose ("个=只" "棵=只" "株=只" "片=只" "根=只" "台=只" "条=只" "头=只" "位=只" "部=只")
  typos ("貓=猫" "動=动" "樹=树" "葉=叶" "電=电" "腦=脑" "恼=脑" "帳=账" "賬=账" "帐=账" "戶=户" "碼=码" "標=标" "隻=只" "這=这" "嗎=吗" "么=吗" "麼=吗" "嘛=吗" "種=种" "須=须" "個=个" "臺=台" "類=类" "屬=属" "構=构" "計=计" "數=数" "們=们" "於=于" "與=与" "減=减" "後=后" "還=还" "書=书" "買=买" "現=现" "筆=笔" "裡=里" "裏=里" "說=说" "話=话" "義=义" "題=题" "問=问" "號=号" "編=编" "擇=择" "選=选" "體=体" "塊=块" "幾=几" "來=来" "蘋=苹" "給=给" "將=将" "為=为" "則=则" "陣=阵" "個=个" "數=数" "試=试" "寫=写" "碼=码" "轉=转" "單=单" "兩=两" "乘=乘" "積=积" "差=差" "區=区" "狀=状" "長=长")
  prime "I"
    forms ("我")
  prime "YOU"
    forms ("你")
  prime "SOMEONE"
    forms ("某人" "人")
  prime "SOMETHING"
    forms ("某物" "东西")
  prime "PEOPLE"
    forms ("人们")
  prime "BODY"
    forms ("身体")
  prime "KIND"
    forms ("种")
  prime "PART"
    forms ("部分")
  prime "THIS"
    forms ("这")
  prime "THE SAME"
    forms ("一样" "同")
  prime "OTHER"
    forms ("别的")
  prime "ONE"
    forms ("一")
  prime "TWO"
    forms ("两" "二")
  prime "SOME"
    forms ("有些")
  prime "ALL"
    forms ("所有" "都")
  prime "MUCH"
    forms ("多")
  prime "LITTLE"
    forms ("少")
  prime "GOOD"
    forms ("好")
  prime "BAD"
    forms ("坏")
  prime "BIG"
    forms ("大")
  prime "SMALL"
    forms ("小")
  prime "THINK"
    forms ("想")
  prime "KNOW"
    forms ("知道")
  prime "WANT"
    forms ("要")
  prime "DON'T WANT"
    forms ("不要")
  prime "FEEL"
    forms ("感觉")
  prime "SEE"
    forms ("看见")
  prime "HEAR"
    forms ("听见")
  prime "SAY"
    forms ("说")
  prime "WORDS"
    forms ("话")
  prime "TRUE"
    forms ("真")
  prime "DO"
    forms ("做")
  prime "HAPPEN"
    forms ("发生")
  prime "MOVE"
    forms ("动")
  prime "BE SOMEWHERE"
    forms ("在")
  prime "THERE IS"
    forms ("有")
  prime "BE SOMEONE"
    forms ("是")
  prime "MINE"
    forms ("我的")
  prime "LIVE"
    forms ("活")
  prime "DIE"
    forms ("死")
  prime "WHEN"
    forms ("时候")
  prime "NOW"
    forms ("现在")
  prime "BEFORE"
    forms ("以前")
  prime "AFTER"
    forms ("以后")
  prime "A LONG TIME"
    forms ("很久")
  prime "A SHORT TIME"
    forms ("一会儿")
  prime "FOR SOME TIME"
    forms ("一段时间")
  prime "MOMENT"
    forms ("片刻")
  prime "WHERE"
    forms ("地方")
  prime "HERE"
    forms ("这里")
  prime "ABOVE"
    forms ("上面")
  prime "BELOW"
    forms ("下面")
  prime "FAR"
    forms ("远")
  prime "NEAR"
    forms ("近")
  prime "SIDE"
    forms ("边")
  prime "INSIDE"
    forms ("里面")
  prime "TOUCH"
    forms ("碰")
  prime "NOT"
    forms ("不" "没")
  prime "MAYBE"
    forms ("可能")
  prime "CAN"
    forms ("能" "会")
  prime "BECAUSE"
    forms ("因为")
  prime "IF"
    forms ("如果")
  prime "VERY"
    forms ("很")
  prime "MORE"
    forms ("更")
  prime "LIKE"
    forms ("像")
  list "ste"
    forms ("是" "对" "不" "没" "每" "种" "类" "部" "分" "必" "须" "有" "需" "要" "所" "都" "猫" "狗" "动" "物" "植" "树" "叶" "子" "手" "指" "电" "脑" "家" "老" "鼠" "标" "账" "户" "密" "码" "问" "题" "可" "能" "含" "义" "回" "答" "用" "编" "号" "你" "想" "选" "择" "按" "属" "于" "构" "成" "并" "非" "真" "假" "这" "个" "请" "的" "一" "我" "知" "道" "切")
  list "minimal"
    forms ("是" "对" "不" "没" "每" "种" "部" "分" "必" "须" "有" "需" "要" "都" "猫" "狗" "动" "物" "植" "树" "叶" "子" "手" "指" "电" "脑" "家" "老" "鼠" "标" "账" "户" "密" "码" "问" "题" "可" "能" "含" "义" "回" "答" "用" "编" "号" "你" "想" "选" "择" "按" "属" "于" "类" "构" "成" "并" "非" "真" "假" "这" "个" "请" "的" "一" "我" "知" "道" "切")
  list "basic"
    forms ("是" "对" "不" "种" "部" "分" "有" "必" "要" "的" "一" "这" "个" "问" "题" "可" "能" "意" "思" "请" "给" "出" "你" "心" "里" "想" "编" "号" "猫" "狗" "动" "物" "植" "树" "叶" "子" "手" "指" "电" "脑" "标" "账" "户" "密" "码" "小" "鼠" "科" "计" "算" "机" "点" "器" "秘" "词" "我" "知" "道" "切")
  list "special"
    forms ("是" "对" "不" "种" "部" "分" "必" "须" "有" "需" "要" "的" "一" "这" "个" "问" "题" "可" "能" "含" "义" "请" "用" "你" "想" "编" "号" "回" "答" "猫" "狗" "动" "物" "植" "树" "叶" "子" "手" "指" "电" "脑" "老" "鼠" "标" "账" "户" "密" "码" "住" "在" "房" "里" "小" "握" "控" "制" "器" "我" "知" "道" "切")
  list "globish"
    forms ("是" "对" "不" "种" "部" "分" "必" "须" "有" "需" "要" "的" "一" "这" "个" "问" "题" "可" "能" "含" "义" "请" "用" "你" "想" "编" "号" "回" "答" "猫" "狗" "动" "物" "植" "树" "叶" "子" "手" "指" "电" "脑" "家" "老" "鼠" "标" "账" "户" "密" "码" "我" "知" "道" "切")
  list "gellish"
    forms ("是" "不" "特" "化" "组" "成" "部" "分" "一" "应" "有" "要" "求" "的" "这" "个" "问" "题" "种" "可" "能" "含" "义" "请" "用" "你" "想" "编" "号" "回" "答" "猫" "狗" "动" "物" "植" "树" "叶" "子" "手" "指" "电" "脑" "老" "鼠" "标" "账" "户" "密" "码")
  tier "100"
    forms ("的" "一" "是" "不" "了" "在" "人" "有" "我" "他" "这" "个" "们" "中" "来" "上" "大" "为" "和" "到" "以" "说" "时" "要" "就" "出" "会" "可" "也" "你" "对" "生" "能" "子" "那" "得" "于" "下" "后" "里" "用" "道" "所" "家" "种" "事" "成" "方" "多" "如" "都" "同" "现" "没" "动" "面" "看" "分" "好" "小" "部" "些" "样" "心" "本" "前" "因" "只" "想")
  tier "200"
    forms ("意" "无" "力" "它" "机" "知" "关" "间" "问" "很" "物" "手" "应" "并" "见" "西" "身" "体" "果" "话" "回" "化" "老" "给" "东" "儿" "真" "义" "题" "活" "更" "别" "电" "少" "感" "做" "必" "计" "指" "非" "听" "像" "定" "然" "特" "点" "制" "科")
  tier "500"
    forms ("类" "边" "死" "觉" "候" "每" "近" "远" "台" "算" "需" "器" "须" "片" "吗" "标" "号" "构" "房" "选" "答" "按" "密" "刻" "段" "求" "规" "许" "组" "思" "切" "住" "属" "久")
  tier "1000"
    forms ("含" "编" "择" "控" "词" "植" "码" "狗" "树" "叶" "根" "坏" "脑" "户" "秘" "假" "某" "握" "碰" "允")
  tier "2000"
    forms ("猫" "账" "棵")
  tier "3000"
    forms ("鼠")
  term animal
    forms ("动物" "只动物")
    primes ("能动的活东西" "个能动的活东西")
  term plant
    forms ("植物" "棵植物")
    primes ("不能动的活东西" "个不能动的活东西")
  term cat
    forms ("猫" "只猫")
    primes ("能动、能在人们活的地方活的小活东西" "个能动、能在人们活的地方活的小活东西")
  term dog
    forms ("狗" "只狗")
    primes ("能动、能在人们活的地方活的大活东西" "个能动、能在人们活的地方活的大活东西")
  term mouse-animal
    forms ("老鼠" "只老鼠")
    input ("鼠" "只鼠")
    precise ("家鼠" "只家鼠")
    ste ("家鼠" "只家鼠")
    special ("住在房子里的小动物" "只住在房子里的小动物")
    basic ("鼠科的小动物" "只鼠科的小动物")
    primes ("能动的很小的活东西" "个能动的很小的活东西")
  term tree
    forms ("树" "棵树")
    primes ("不能动的很大的活东西" "个不能动的很大的活东西")
  term leaf
    forms ("叶子" "片叶子")
    primes ("不能动的活东西的小部分" "个不能动的活东西的小部分")
  term hand
    forms ("手" "只手")
    primes ("身体能碰东西的部分" "个身体能碰东西的部分")
  term finger
    forms ("手指" "根手指")
    primes ("身体能碰东西的小部分" "个身体能碰东西的小部分")
  term computer
    forms ("电脑" "台电脑")
    basic ("计算机" "台计算机")
    primes ("里面能有很多话的东西" "个里面能有很多话的东西")
  term mouse-device
    forms ("鼠标" "个鼠标")
    input ("鼠" "个鼠")
    precise ("电脑鼠标" "个电脑鼠标")
    ste ("电脑鼠标" "个电脑鼠标")
    special ("手握的电脑控制器" "个手握的电脑控制器")
    basic ("指点器" "个指点器")
    primes ("人们动了以后话也会动的小东西" "个人们动了以后话也会动的小东西")
  term account
    forms ("账户" "个账户")
    primes ("有话的我的东西" "个有话的我的东西")
  term password
    forms ("密码" "个密码")
    basic ("秘密的词" "个秘密的词")
    primes ("我知道、别人不知道的话" "个我知道、别人不知道的话")
  template "reply statement"
    styles ("plain" "ste" "ace" "gellish" "sbvr" "dense" "basic")
    positive "是的。"
    negative "不是。"
  template "reply statement"
    styles ("eprime")
    positive "对。"
    negative "不对。"
  template "reply statement"
    styles ("primes")
    positive "这是真的。"
    negative "这不是真的。"
  template "kind-of statement"
    styles ("plain" "basic" "primes")
    positive "{subject.bare}是一种{object.bare}。"
    negative "{subject.bare}不是一种{object.bare}。"
  template "kind-of question"
    styles ("plain" "basic" "primes")
    positive "{subject.bare}是一种{object.bare}吗？"
    negative "{subject.bare}不是一种{object.bare}吗？"
  template "kind-of statement"
    styles ("ste")
    positive "{subject.bare}是{object.bare}的一种。"
    negative "{subject.bare}不是{object.bare}的一种。"
  template "kind-of question"
    styles ("ste")
    positive "{subject.bare}是{object.bare}的一种吗？"
    negative "{subject.bare}不是{object.bare}的一种吗？"
  template "kind-of statement"
    styles ("ace")
    positive "每{subject.measure}都是{object.bare}。"
    negative "没有{subject.bare}是{object.bare}。"
  template "kind-of question"
    styles ("ace")
    positive "每{subject.measure}都是{object.bare}吗？"
    negative "没有{subject.bare}是{object.bare}吗？"
  template "kind-of statement"
    styles ("gellish")
    positive "{subject.bare}是{object.bare}的特化。"
    negative "{subject.bare}不是{object.bare}的特化。"
  template "kind-of question"
    styles ("gellish")
    positive "{subject.bare}是{object.bare}的特化吗？"
    negative "{subject.bare}不是{object.bare}的特化吗？"
  template "kind-of statement"
    styles ("sbvr")
    positive "必然每{subject.measure}都是{object.bare}。"
    negative "不可能有{subject.bare}是{object.bare}。"
  template "kind-of question"
    styles ("sbvr")
    positive "必然每{subject.measure}都是{object.bare}吗？"
    negative "不可能有{subject.bare}是{object.bare}吗？"
  template "kind-of statement"
    styles ("eprime")
    positive "{subject.bare}属于{object.bare}类。"
    negative "{subject.bare}不属于{object.bare}类。"
  template "kind-of question"
    styles ("eprime")
    positive "{subject.bare}属于{object.bare}类吗？"
    negative "{subject.bare}不属于{object.bare}类吗？"
  template "kind-of statement"
    styles ("dense")
    positive "{subject.bare}是{object.bare}。"
    negative "{subject.bare}不是{object.bare}。"
  template "kind-of question"
    styles ("dense")
    positive "{subject.bare}是{object.bare}吗？"
    negative "{subject.bare}不是{object.bare}吗？"
  template "kind-of question"
    styles ("colloquial")
    positive "{subject.bare}是{object.bare}吗"
    positive "{subject.bare}是不是{object.bare}"
    positive "一{subject.bare}是{object.bare}吗"
    positive "一{subject.bare}是一{object.bare}吗"
    positive "{subject.bare}是一{object.bare}吗"
    positive "{subject.bare}算{object.bare}吗"
    positive "{subject.bare}算是{object.bare}吗"
    positive "{subject.bare}算不算{object.bare}"
    positive "{subject.bare}属于{object.bare}吗"
    positive "你觉得{subject.bare}是{object.bare}吗"
    positive "{subject.bare}也是{object.bare}吗"
    negative "{subject.bare}不算{object.bare}吗"
  template "kind-of statement"
    styles ("colloquial")
    positive "{subject.bare}是{object.bare}"
    positive "一{subject.bare}是一{object.bare}"
    positive "{subject.bare}算{object.bare}"
    positive "{subject.bare}算是{object.bare}"
    positive "{subject.bare}属于{object.bare}"
    negative "{subject.bare}不算{object.bare}"
  template "part-of statement"
    styles ("plain" "basic" "ste" "primes")
    positive "{subject.bare}是{object.bare}的一部分。"
    negative "{subject.bare}不是{object.bare}的一部分。"
  template "part-of question"
    styles ("plain" "basic" "ste" "primes")
    positive "{subject.bare}是{object.bare}的一部分吗？"
    negative "{subject.bare}不是{object.bare}的一部分吗？"
  template "part-of statement"
    styles ("ace")
    positive "每{subject.measure}都是一{object.measure}的一部分。"
    negative "没有{subject.bare}是一{object.measure}的一部分。"
  template "part-of question"
    styles ("ace")
    positive "每{subject.measure}都是一{object.measure}的一部分吗？"
    negative "没有{subject.bare}是一{object.measure}的一部分吗？"
  template "part-of statement"
    styles ("gellish")
    positive "{subject.bare}是{object.bare}的组成部分。"
    negative "{subject.bare}不是{object.bare}的组成部分。"
  template "part-of question"
    styles ("gellish")
    positive "{subject.bare}是{object.bare}的组成部分吗？"
    negative "{subject.bare}不是{object.bare}的组成部分吗？"
  template "part-of statement"
    styles ("sbvr")
    positive "必然每{subject.measure}都是一{object.measure}的一部分。"
    negative "不可能有{subject.bare}是{object.bare}的一部分。"
  template "part-of question"
    styles ("sbvr")
    positive "必然每{subject.measure}都是一{object.measure}的一部分吗？"
    negative "不可能有{subject.bare}是{object.bare}的一部分吗？"
  template "part-of statement"
    styles ("eprime")
    positive "{subject.bare}构成{object.bare}的一部分。"
    negative "{subject.bare}不构成{object.bare}的一部分。"
  template "part-of question"
    styles ("eprime")
    positive "{subject.bare}构成{object.bare}的一部分吗？"
    negative "{subject.bare}不构成{object.bare}的一部分吗？"
  template "part-of statement"
    styles ("dense")
    positive "{object.bare}有{subject.bare}。"
    negative "{object.bare}没有{subject.bare}。"
  template "part-of question"
    styles ("dense")
    positive "{object.bare}有{subject.bare}吗？"
    negative "{object.bare}没有{subject.bare}吗？"
  template "part-of question"
    styles ("colloquial")
    positive "{subject.bare}是{object.bare}的一部分吗"
    positive "{subject.bare}是{object.bare}的部分吗"
    positive "{subject.bare}是不是{object.bare}的一部分"
    positive "{object.bare}有{subject.bare}吗"
    positive "{object.bare}有没有{subject.bare}"
    positive "{object.bare}上有{subject.bare}吗"
    positive "一{object.bare}有{subject.bare}吗"
  template "part-of statement"
    styles ("colloquial")
    positive "{subject.bare}是{object.bare}的一部分"
    positive "{subject.bare}是{object.bare}的部分"
    positive "{object.bare}上有{subject.bare}"
  template "must-have statement"
    styles ("plain" "ste" "eprime")
    positive "{subject.bare}必须有{object.bare}。"
    negative "{subject.bare}不需要{object.bare}。"
  template "must-have question"
    styles ("plain" "ste" "eprime")
    positive "{subject.bare}必须有{object.bare}吗？"
    negative "{subject.bare}不需要{object.bare}吗？"
  template "must-have statement"
    styles ("basic")
    positive "{subject.bare}有{object.bare}是必要的。"
    negative "{subject.bare}有{object.bare}不是必要的。"
  template "must-have question"
    styles ("basic")
    positive "{subject.bare}有{object.bare}是必要的吗？"
    negative "{subject.bare}有{object.bare}不是必要的吗？"
  template "must-have statement"
    styles ("ace")
    positive "每{subject.measure}都必须有一{object.measure}。"
    negative "并非每{subject.measure}都必须有一{object.measure}。"
  template "must-have question"
    styles ("ace")
    positive "每{subject.measure}都必须有一{object.measure}吗？"
    negative "并非每{subject.measure}都必须有一{object.measure}吗？"
  template "must-have statement"
    styles ("gellish")
    positive "{subject.bare}应有{object.bare}。"
    negative "{subject.bare}不要求{object.bare}。"
  template "must-have question"
    styles ("gellish")
    positive "{subject.bare}应有{object.bare}吗？"
    negative "{subject.bare}不要求{object.bare}吗？"
  template "must-have statement"
    styles ("sbvr")
    positive "规定每{subject.measure}都有一{object.measure}。"
    negative "允许{subject.bare}没有{object.bare}。"
  template "must-have question"
    styles ("sbvr")
    positive "规定每{subject.measure}都有一{object.measure}吗？"
