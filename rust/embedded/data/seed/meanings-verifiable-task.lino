# Recognition vocabulary for tasks whose answer has a checkable shape.
#
# The runtime names only the semantic roles below. Surface forms and their open
# slots live here, so adding a language or paraphrase never adds a branch to the
# recognizer. The ellipsis is the lexicon's language-independent slot marker.
meanings
  expectation
    defined-by concept
  expectation_count
    defined-by expectation
    role verifiable_expectation
    role verifiable_expectation_count
    lexeme en
      surface
        text "how many … do i have"
    lexeme ru
      surface
        text "сколько у меня …"
    lexeme hi
      surface
        text "मेरे पास कितने … हैं"
    lexeme zh
      surface
        text "我有多少…"
    lexeme es
      surface
        text "cuántos … tengo"
  expectation_edited_text
    defined-by expectation
    role verifiable_expectation
    role verifiable_expectation_edited_text
    lexeme en
      surface
        text "make this sentence more concise: …"
    lexeme ru
      surface
        text "сделай это предложение короче: …"
    lexeme hi
      surface
        text "इस वाक्य को अधिक संक्षिप्त बनाओ: …"
    lexeme zh
      surface
        text "把这句话改得更简洁：…"
    lexeme es
      surface
        text "haz esta frase más concisa: …"
