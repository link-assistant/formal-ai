# Response templates for the user-facing formalization task (issue #1186,
# E150).
#
# The formalization and deformalization handlers render their prose through
# these records so no response text lives in Rust. Placeholders in braces
# are filled by the handler. The rendering blocks themselves (FOL, Lean,
# Rocq, Links Notation) are language-neutral and are inserted through the
# {statement_block} and {derivation} slots.
#
# The `repository_lineage` records render the lineage route's answer
# (issue #1180 R10, repository history formalized into commits, issues and
# pull requests); the commit list, path and numbers fill their slots.

multilingual_responses
  response response_formalization_result_en
    intent formalization_result
    language en
    text "Formalized statement:\n\n{statement_block}\n\n{honesty}\n\nDerivation:\n{derivation}"
  response response_formalization_result_ru
    intent formalization_result
    language ru
    text "Формализованное утверждение:\n\n{statement_block}\n\n{honesty}\n\nВывод:\n{derivation}"
  response response_formalization_result_hi
    intent formalization_result
    language hi
    text "औपचारिक कथन:\n\n{statement_block}\n\n{honesty}\n\nव्युत्पत्ति:\n{derivation}"
  response response_formalization_result_zh
    intent formalization_result
    language zh
    text "形式化命题：\n\n{statement_block}\n\n{honesty}\n\n推导：\n{derivation}"
  response response_formalization_result_es
    intent formalization_result
    language es
    text "Enunciado formalizado:\n\n{statement_block}\n\n{honesty}\n\nDerivación:\n{derivation}"
  response response_formalization_unparsed_en
    intent formalization_unparsed
    language en
    text "The sentence was recognized as a formalization request, but no quantified clause could be parsed from it: {reason}. A formalization needs a quantifier word (every, some, no) or a formal quantifier symbol and at least one predicate."
  response response_formalization_unparsed_ru
    intent formalization_unparsed
    language ru
    text "Предложение распознано как запрос на формализацию, но кванторной конструкции из него извлечь не удалось: {reason}. Для формализации нужно кванторное слово (каждый, некоторый, никакой) или формальный символ квантора и хотя бы один предикат."
  response response_formalization_unparsed_hi
    intent formalization_unparsed
    language hi
    text "वाक्य औपचारिकीकरण अनुरोध माना गया, पर इसमें से कोई क्वांटिफाइड क्लॉज नहीं निकाला जा सका: {reason}। औपचारिकीकरण के लिए क्वांटिफायर शब्द (हर, कोई) या औपचारिक क्वांटिफायर प्रतीक और कम से कम एक विधेय चाहिए।"
  response response_formalization_unparsed_zh
    intent formalization_unparsed
    language zh
    text "该句子已被识别为形式化请求，但未能从中解析出含量化的子句：{reason}。形式化需要一个量词（每个、某个、没有）或形式量词符号以及至少一个谓词。"
  response response_formalization_unparsed_es
    intent formalization_unparsed
    language es
    text "La frase se reconoció como una solicitud de formalización, pero no se pudo extraer de ella una cláusula cuantificada: {reason}. Una formalización necesita una palabra cuantificadora (todo, algún, ningún) o un símbolo cuantificador formal y al menos un predicado."
  response response_formalization_deformalized_en
    intent formalization_deformalized
    language en
    text "Natural-language reading:\n\n{sentence}\n\nRound trip: {round_trip}\n\n{honesty}"
  response response_formalization_deformalized_ru
    intent formalization_deformalized
    language ru
    text "Прочтение на естественном языке:\n\n{sentence}\n\nОбратный проход: {round_trip}\n\n{honesty}"
  response response_formalization_deformalized_hi
    intent formalization_deformalized
    language hi
    text "सहज भाषा में पाठ:\n\n{sentence}\n\nपुनः पारगमन: {round_trip}\n\n{honesty}"
  response response_formalization_deformalized_zh
    intent formalization_deformalized
    language zh
    text "自然语言读法：\n\n{sentence}\n\n往返：{round_trip}\n\n{honesty}"
  response response_formalization_deformalized_es
    intent formalization_deformalized
    language es
    text "Lectura en lenguaje natural:\n\n{sentence}\n\nRecorrido de ida y vuelta: {round_trip}\n\n{honesty}"
  response response_formalization_rml_absent_en
    intent formalization_rml_absent
    language en
    text "rml was not found in PATH and FORMAL_AI_RML names no executable, so the clause was not exported through relative-meta-logic."
  response response_formalization_rml_outside_subset_en
    intent formalization_rml_outside_subset
    language en
    text "The {quantifier} reading is outside the relative-meta-logic export subset, which has no binder for it, so rml was not run."
  response response_formalization_rml_ran_en
    intent formalization_rml_ran
    language en
    text "rml export lean ran on {source} and exited with status {exit}; its Lean output path is {output}."
  response response_formalization_honesty_en
    intent formalization_honesty
    language en
    text "No theorem prover was invoked. {lean_check} {rocq_check} {rml_check} The Lean and Rocq texts are seed-grammar renderings, and their in-process export through the relative-meta-logic crate is recorded as follow-up until it is published (link-foundation/relative-meta-logic#185)."
  response response_formalization_honesty_ru
    intent formalization_honesty
    language ru
    text "Теорем-прувер не вызывался. {lean_check} {rocq_check} {rml_check} Тексты Lean и Rocq — порождения сид-грамматики; их экспорт внутри процесса через relative-meta-logic записан как последующая работа до публикации crates.io (link-foundation/relative-meta-logic#185)."
  response response_formalization_honesty_hi
    intent formalization_honesty
    language hi
    text "कोई थीरम प्रोवर नहीं चलाया गया। {lean_check} {rocq_check} {rml_check} Lean और Rocq पाठ सीड-व्याकरण से बने हैं; relative-meta-logic के crates.io प्रकाशन तक उनका इन-प्रोसेस निर्यात आगामी कार्य के रूप में दर्ज है (link-foundation/relative-meta-logic#185)।"
  response response_formalization_honesty_zh
    intent formalization_honesty
    language zh
    text "未调用任何定理证明器。{lean_check} {rocq_check} {rml_check} Lean 与 Rocq 文本由种子文法生成；在 relative-meta-logic 发布到 crates.io 之前，其进程内导出被记录为后续工作（link-foundation/relative-meta-logic#185）。"
  response response_formalization_honesty_es
    intent formalization_honesty
    language es
    text "No se invocó ningún demostrador de teoremas. {lean_check} {rocq_check} {rml_check} Los textos Lean y Rocq son producciones de la gramática semilla; su exportación en proceso a través de relative-meta-logic queda registrada como trabajo posterior hasta su publicación en crates.io (link-foundation/relative-meta-logic#185)."
  response response_repository_lineage_en
    intent repository_lineage
    language en
    text "{path} has {count} commits in this repository's history, oldest first:\n{commits}\n\nThe introducing commit {first} was made for issue {issue} and delivered by pull request {pull}. The lineage is read from `git log --follow`; the issue comes from the commit's trailer and the pull request from the merge that delivered it."
  response response_repository_lineage_ru
    intent repository_lineage
    language ru
    text "У {path} в истории этого репозитория {count} коммитов, от старых к новым:\n{commits}\n\nВводящий коммит {first} сделан для задачи {issue} и доставлен пулл-реквестом {pull}. Происхождение прочитано из `git log --follow`; задача взята из трейлера коммита, пулл-реквест — из доставившего его слияния."
  response response_repository_lineage_hi
    intent repository_lineage
    language hi
    text "इस रिपॉज़िटरी के इतिहास में {path} के {count} कमिट हैं, सबसे पुराने पहले:\n{commits}\n\nपरिचय कराने वाला कमिट {first} इश्यू {issue} के लिए बना और पुल रिक्वेस्ट {pull} द्वारा पहुँचाया गया। वंश `git log --follow` से पढ़ा गया है; इश्यू कमिट के ट्रेलर से और पुल रिक्वेस्ट उसे पहुँचाने वाले मर्ज से आता है।"
  response response_repository_lineage_zh
    intent repository_lineage
    language zh
    text "{path} 在本仓库历史中有 {count} 个提交，按时间从早到晚：\n{commits}\n\n引入它的提交 {first} 是为问题 {issue} 而做的，并由拉取请求 {pull} 交付。来历读取自 `git log --follow`；问题来自提交的尾注，拉取请求来自交付它的合并。"
  response response_repository_lineage_es
    intent repository_lineage
    language es
    text "{path} tiene {count} commits en la historia de este repositorio, del más antiguo al más reciente:\n{commits}\n\nEl commit que lo introdujo, {first}, se hizo para el issue {issue} y lo entregó el pull request {pull}. El linaje se lee de `git log --follow`; el issue sale del trailer del commit y el pull request de la fusión que lo entregó."
  response response_repository_lineage_unrecorded_en
    intent repository_lineage_unrecorded
    language en
    text "(not recorded in the history)"
  response response_repository_lineage_unrecorded_ru
    intent repository_lineage_unrecorded
    language ru
    text "(не записан в истории)"
  response response_repository_lineage_unrecorded_hi
    intent repository_lineage_unrecorded
    language hi
    text "(इतिहास में दर्ज नहीं)"
  response response_repository_lineage_unrecorded_zh
    intent repository_lineage_unrecorded
    language zh
    text "（历史中未记录）"
  response response_repository_lineage_unrecorded_es
    intent repository_lineage_unrecorded
    language es
    text "(no registrado en la historia)"
  response response_repository_status_explanation_en
    intent repository_status_explanation
    language en
    text "The {status} is checked by {script}, introduced for issue {issue}. It measures the commit range {range}: {commits} commits, {sessions} of them carrying the {trailer} trailer. The floor is {floor} {unit} per release cycle ({attribution}), and the self-hosting share may not fall below the target of {target} recorded for {target_tag} ({policy}). The status fails when the range holds no {unit}, or when its projected share falls below that target; this answer reads the range and the ledger {ledger} and does not run the measurement, so run {script} to see which of the two applies."
  response response_repository_status_explanation_ru
    intent repository_status_explanation
    language ru
    text "{status} проверяет {script}, добавленный для задачи {issue}. Он измеряет диапазон коммитов {range}: {commits} коммитов, из них {sessions} несут трейлер {trailer}. Нижняя граница — {floor} ({unit}) на цикл выпуска ({attribution}), а доля самостоятельной разработки не может опуститься ниже цели {target}, записанной для {target_tag} ({policy}). Статус не проходит, когда в диапазоне нет ни одного слитого пулл-реквеста этого вида или когда прогнозная доля ниже цели; этот ответ читает диапазон и журнал {ledger} и не запускает измерение, поэтому запустите {script}, чтобы узнать, какое из двух условий сработало."
  response response_repository_status_explanation_hi
    intent repository_status_explanation
    language hi
    text "{status} की जाँच {script} करता है, जो इश्यू {issue} के लिए जोड़ा गया। यह कमिट सीमा {range} मापता है: {commits} कमिट, जिनमें से {sessions} पर {trailer} ट्रेलर है। निचली सीमा प्रति रिलीज़ चक्र {floor} ({unit}) है ({attribution}), और स्व-विकास का हिस्सा {target_tag} के लिए दर्ज लक्ष्य {target} से नीचे नहीं जा सकता ({policy})। स्थिति तब विफल होती है जब सीमा में ऐसा कोई मर्ज हुआ पुल रिक्वेस्ट न हो, या अनुमानित हिस्सा लक्ष्य से नीचे हो; यह उत्तर सीमा और लेजर {ledger} पढ़ता है और माप नहीं चलाता, इसलिए कौन सी शर्त लागू है यह जानने के लिए {script} चलाएँ।"
  response response_repository_status_explanation_zh
    intent repository_status_explanation
    language zh
    text "{status} 由 {script} 检查，它是为问题 {issue} 引入的。它度量提交范围 {range}：共 {commits} 个提交，其中 {sessions} 个带有 {trailer} 尾注。下限是每个发布周期 {floor} 个（{unit}）（{attribution}），自我开发占比不得低于为 {target_tag} 记录的目标 {target}（{policy}）。当该范围内没有已合并的此类拉取请求，或预计占比低于该目标时，状态失败；本回答只读取范围和账本 {ledger}，并不运行度量，请运行 {script} 查看是哪一种情况。"
  response response_repository_status_explanation_es
    intent repository_status_explanation
    language es
    text "El {status} lo comprueba {script}, introducido para el issue {issue}. Mide el rango de commits {range}: {commits} commits, {sessions} de ellos con el trailer {trailer}. El mínimo es {floor} ({unit}) por ciclo de publicación ({attribution}), y la proporción de autodesarrollo no puede bajar del objetivo {target} registrado para {target_tag} ({policy}). El estado falla cuando el rango no contiene ningún pull request fusionado de ese tipo, o cuando su proporción proyectada queda por debajo del objetivo; esta respuesta lee el rango y el registro {ledger} y no ejecuta la medición, así que ejecute {script} para ver cuál de las dos condiciones se cumple."
  response response_repository_definition_en
    intent repository_definition
    language en
    text "`{name}` is a {kind} in {file}, lines {start} to {end}. {doc} The symbol was introduced by commit {first} for issue {issue} (read from `git log -S`, with the issue from the commit's trailer)."
  response response_repository_definition_ru
    intent repository_definition
    language ru
    text "`{name}` — {kind} в {file}, строки с {start} по {end}. {doc} Символ добавлен коммитом {first} для задачи {issue} (прочитано из `git log -S`, задача — из трейлера коммита)."
  response response_repository_definition_hi
    intent repository_definition
    language hi
    text "`{name}` {file} में एक {kind} है, पंक्ति {start} से {end} तक। {doc} यह प्रतीक कमिट {first} द्वारा इश्यू {issue} के लिए जोड़ा गया (`git log -S` से पढ़ा गया, इश्यू कमिट के ट्रेलर से)।"
  response response_repository_definition_zh
    intent repository_definition
    language zh
    text "`{name}` 是 {file} 中的一个 {kind}，位于第 {start} 到 {end} 行。{doc} 该符号由提交 {first} 为问题 {issue} 引入（读取自 `git log -S`，问题来自提交的尾注）。"
  response response_repository_definition_es
    intent repository_definition
    language es
    text "`{name}` es un {kind} en {file}, líneas {start} a {end}. {doc} El símbolo lo introdujo el commit {first} para el issue {issue} (leído de `git log -S`, con el issue tomado del trailer del commit)."
  response response_repository_definition_documented_en
    intent repository_definition_documented
    language en
    text "Its documentation comment reads: {doc}"
  response response_repository_definition_documented_ru
    intent repository_definition_documented
    language ru
    text "Его документирующий комментарий гласит: {doc}"
  response response_repository_definition_documented_hi
    intent repository_definition_documented
    language hi
    text "इसकी प्रलेखन टिप्पणी कहती है: {doc}"
  response response_repository_definition_documented_zh
    intent repository_definition_documented
    language zh
    text "它的文档注释写道：{doc}"
  response response_repository_definition_documented_es
    intent repository_definition_documented
    language es
    text "Su comentario de documentación dice: {doc}"
  response response_repository_definition_undocumented_en
    intent repository_definition_undocumented
    language en
    text "It carries no documentation comment, so what it does is stated only by its source."
  response response_repository_definition_undocumented_ru
    intent repository_definition_undocumented
    language ru
    text "У него нет документирующего комментария, поэтому что он делает, говорит только его исходный код."
  response response_repository_definition_undocumented_hi
    intent repository_definition_undocumented
    language hi
    text "इस पर कोई प्रलेखन टिप्पणी नहीं है, इसलिए यह क्या करता है यह केवल इसका स्रोत बताता है।"
  response response_repository_definition_undocumented_zh
    intent repository_definition_undocumented
    language zh
    text "它没有文档注释，因此它做什么只能由其源代码说明。"
  response response_repository_definition_undocumented_es
    intent repository_definition_undocumented
    language es
    text "No tiene comentario de documentación, así que lo que hace solo lo dice su código fuente."
