# Response templates for the user-facing formalization task (issue #1186,
# E150).
#
# The formalization and deformalization handlers render their prose through
# these records so no response text lives in Rust. Placeholders in braces
# are filled by the handler. The rendering blocks themselves (FOL, Lean,
# Rocq, Links Notation) are language-neutral and are inserted through the
# {statement_block} and {derivation} slots.
#
# The `repository_lineage` records render the lineage route's answer
# (issue #1180 R10, repository history formalized into commits, issues and
# pull requests); the commit list, path and numbers fill their slots.
#
# The `formalization_prover_*` records state, in each answer language, what
# the theorem-prover step did: no prover invoked, which ones ran, and per
# prover whether its binary was absent from PATH or ran with an exit status
# on the compile unit the `prover` records of `formal-targets.lino` build.

multilingual_responses
  response response_formalization_result_en
    intent formalization_result
    language en
    text "Formalized statement:\n\n{statement_block}\n\n{honesty}\n\nDerivation:\n{derivation}"
  response response_formalization_result_ru
    intent formalization_result
    language ru
    text "Формализованное утверждение:\n\n{statement_block}\n\n{honesty}\n\nВывод:\n{derivation}"
  response response_formalization_result_hi
    intent formalization_result
    language hi
    text "औपचारिक कथन:\n\n{statement_block}\n\n{honesty}\n\nव्युत्पत्ति:\n{derivation}"
