# Response templates for the user-facing formalization task (issue #1186,
# E150).
#
# The formalization and deformalization handlers render their prose through
# these records so no response text lives in Rust. Placeholders in braces
# are filled by the handler. The rendering blocks themselves (FOL, Lean,
# Rocq, Links Notation) are language-neutral and are inserted through the
# {statement_block} and {derivation} slots.
#
# The `repository_lineage` records render the lineage route's answer
# (issue #1180 R10, repository history formalized into commits, issues and
# pull requests); the commit list, path and numbers fill their slots.

multilingual_responses
  response response_formalization_result_en
    intent formalization_result
    language en
    text "Formalized statement:\n\n{statement_block}\n\n{honesty}\n\nDerivation:\n{derivation}"
  response response_formalization_result_ru
    intent formalization_result
    language ru
    text "Формализованное утверждение:\n\n{statement_block}\n\n{honesty}\n\nВывод:\n{derivation}"
  response response_formalization_result_hi
    intent formalization_result
    language hi
    text "औपचारिक कथन:\n\n{statement_block}\n\n{honesty}\n\nव्युत्पत्ति:\n{derivation}"
  response response_formalization_result_zh
    intent formalization_result
    language zh
    text "形式化命题：\n\n{statement_block}\n\n{honesty}\n\n推导：\n{derivation}"
  response response_formalization_result_es
    intent formalization_result
    language es
    text "Enunciado formalizado:\n\n{statement_block}\n\n{honesty}\n\nDerivación:\n{derivation}"
  response response_formalization_unparsed_en
    intent formalization_unparsed
    language en
    text "The sentence was recognized as a formalization request, but no quantified clause could be parsed from it: {reason}. A formalization needs a quantifier word (every, some, no) or a formal quantifier symbol and at least one predicate."
  response response_formalization_unparsed_ru
    intent formalization_unparsed
    language ru
    text "Предложение распознано как запрос на формализацию, но кванторной конструкции из него извлечь не удалось: {reason}. Для формализации нужно кванторное слово (каждый, некоторый, никакой) или формальный символ квантора и хотя бы один предикат."
  response response_formalization_unparsed_hi
    intent formalization_unparsed
    language hi
    text "वाक्य औपचारिकीकरण अनुरोध माना गया, पर इसमें से कोई क्वांटिफाइड क्लॉज नहीं निकाला जा सका: {reason}। औपचारिकीकरण के लिए क्वांटिफायर शब्द (हर, कोई) या औपचारिक क्वांटिफायर प्रतीक और कम से कम एक विधेय चाहिए।"
  response response_formalization_unparsed_zh
    intent formalization_unparsed
    language zh
    text "该句子已被识别为形式化请求，但未能从中解析出含量化的子句：{reason}。形式化需要一个量词（每个、某个、没有）或形式量词符号以及至少一个谓词。"
  response response_formalization_unparsed_es
    intent formalization_unparsed
    language es
    text "La frase se reconoció como una solicitud de formalización, pero no se pudo extraer de ella una cláusula cuantificada: {reason}. Una formalización necesita una palabra cuantificadora (todo, algún, ningún) o un símbolo cuantificador formal y al menos un predicado."
  response response_formalization_deformalized_en
    intent formalization_deformalized
    language en
    text "Natural-language reading:\n\n{sentence}\n\nRound trip: {round_trip}\n\n{honesty}"
  response response_formalization_deformalized_ru
    intent formalization_deformalized
    language ru
    text "Прочтение на естественном языке:\n\n{sentence}\n\nОбратный проход: {round_trip}\n\n{honesty}"
  response response_formalization_deformalized_hi
    intent formalization_deformalized
    language hi
    text "सहज भाषा में पाठ:\n\n{sentence}\n\nपुनः पारगमन: {round_trip}\n\n{honesty}"
  response response_formalization_deformalized_zh
    intent formalization_deformalized
    language zh
    text "自然语言读法：\n\n{sentence}\n\n往返：{round_trip}\n\n{honesty}"
  response response_formalization_deformalized_es
    intent formalization_deformalized
    language es
    text "Lectura en lenguaje natural:\n\n{sentence}\n\nRecorrido de ida y vuelta: {round_trip}\n\n{honesty}"
  response response_formalization_honesty_en
    intent formalization_honesty
    language en
    text "No theorem prover was invoked. {lean_check} {rocq_check} The Lean and Rocq texts are seed-grammar renderings, and their in-process export through the relative-meta-logic crate is recorded as follow-up until it is published (link-foundation/relative-meta-logic#185)."
  response response_formalization_honesty_ru
    intent formalization_honesty
    language ru
    text "Теорем-прувер не вызывался. {lean_check} {rocq_check} Тексты Lean и Rocq — порождения сид-грамматики; их экспорт внутри процесса через relative-meta-logic записан как последующая работа до публикации crates.io (link-foundation/relative-meta-logic#185)."
  response response_formalization_honesty_hi
    intent formalization_honesty
    language hi
    text "कोई थीरम प्रोवर नहीं चलाया गया। {lean_check} {rocq_check} Lean और Rocq पाठ सीड-व्याकरण से बने हैं; relative-meta-logic के crates.io प्रकाशन तक उनका इन-प्रोसेस निर्यात आगामी कार्य के रूप में दर्ज है (link-foundation/relative-meta-logic#185)।"
  response response_formalization_honesty_zh
    intent formalization_honesty
    language zh
    text "未调用任何定理证明器。{lean_check} {rocq_check} Lean 与 Rocq 文本由种子文法生成；在 relative-meta-logic 发布到 crates.io 之前，其进程内导出被记录为后续工作（link-foundation/relative-meta-logic#185）。"
  response response_formalization_honesty_es
    intent formalization_honesty
    language es
    text "No se invocó ningún demostrador de teoremas. {lean_check} {rocq_check} Los textos Lean y Rocq son producciones de la gramática semilla; su exportación en proceso a través de relative-meta-logic queda registrada como trabajo posterior hasta su publicación en crates.io (link-foundation/relative-meta-logic#185)."
  response response_repository_lineage_en
    intent repository_lineage
    language en
    text "{path} has {count} commits in this repository's history, oldest first:\n{commits}\n\nThe introducing commit {first} was made for issue {issue} and delivered by pull request {pull}. The lineage is read from `git log --follow`; the issue comes from the commit's trailer and the pull request from the merge that delivered it."
  response response_repository_lineage_ru
    intent repository_lineage
    language ru
    text "У {path} в истории этого репозитория {count} коммитов, от старых к новым:\n{commits}\n\nВводящий коммит {first} сделан для задачи {issue} и доставлен пулл-реквестом {pull}. Происхождение прочитано из `git log --follow`; задача взята из трейлера коммита, пулл-реквест — из доставившего его слияния."
  response response_repository_lineage_hi
    intent repository_lineage
    language hi
    text "इस रिपॉज़िटरी के इतिहास में {path} के {count} कमिट हैं, सबसे पुराने पहले:\n{commits}\n\nपरिचय कराने वाला कमिट {first} इश्यू {issue} के लिए बना और पुल रिक्वेस्ट {pull} द्वारा पहुँचाया गया। वंश `git log --follow` से पढ़ा गया है; इश्यू कमिट के ट्रेलर से और पुल रिक्वेस्ट उसे पहुँचाने वाले मर्ज से आता है।"
  response response_repository_lineage_zh
    intent repository_lineage
    language zh
    text "{path} 在本仓库历史中有 {count} 个提交，按时间从早到晚：\n{commits}\n\n引入它的提交 {first} 是为问题 {issue} 而做的，并由拉取请求 {pull} 交付。来历读取自 `git log --follow`；问题来自提交的尾注，拉取请求来自交付它的合并。"
  response response_repository_lineage_es
    intent repository_lineage
    language es
    text "{path} tiene {count} commits en la historia de este repositorio, del más antiguo al más reciente:\n{commits}\n\nEl commit que lo introdujo, {first}, se hizo para el issue {issue} y lo entregó el pull request {pull}. El linaje se lee de `git log --follow`; el issue sale del trailer del commit y el pull request de la fusión que lo entregó."
  response response_repository_lineage_unrecorded_en
    intent repository_lineage_unrecorded
    language en
    text "(not recorded in the history)"
  response response_repository_lineage_unrecorded_ru
    intent repository_lineage_unrecorded
    language ru
    text "(не записан в истории)"
  response response_repository_lineage_unrecorded_hi
    intent repository_lineage_unrecorded
    language hi
    text "(इतिहास में दर्ज नहीं)"
  response response_repository_lineage_unrecorded_zh
    intent repository_lineage_unrecorded
    language zh
    text "（历史中未记录）"
  response response_repository_lineage_unrecorded_es
    intent repository_lineage_unrecorded
    language es
    text "(no registrado en la historia)"
