  numeric-response-only
    defined-by answer
    defined-by predicate
    role numeric-response-only-clause
    lexeme en "return only the numeric result" "return only the number" "answer with only the numeric result"
    precondition "a complete calculation operand is followed by an unquoted numeric-only clause, and evaluation yields a finite scalar numeric string"
    effect "returns the evaluated scalar numeric string without the expression or explanatory text; conflicting or incomplete clauses and evaluation errors remain unshaped"
    unit "not applicable"
    example "Calculate 31 + 6. Return only the numeric result. => 37"
    lexeme ru "верни только числовой результат" "верни только число" "ответь только числовым результатом"
    lexeme hi "केवल संख्यात्मक परिणाम लौटाएँ" "केवल संख्या लौटाएँ"
    lexeme zh "仅返回数值结果" "只返回数字"
    lexeme es "devuelve solo el resultado numérico" "devuelve solo el número"

  quantity-constraint-bound-frame
    defined-by arithmetic_operation
    role quantity-constraint-bound-frame
    role scoped-grammar-pattern
    precondition "A fully consumed bound sentence names one bound, an exact nonnegative integer and a resolvable unit."
    effect "Capture the bound reference, quantity surface and original UTF-8 spans."
    unit "not applicable"
    example "The budget is 1200 ms."
    lexeme en "the {bound_ref} is {bound_amount} {bound_unit}"
    lexeme ru "значение {bound_ref} составляет {bound_amount} {bound_unit}"
    lexeme hi "{bound_ref} का मान {bound_amount} {bound_unit} है"
    lexeme zh "{bound_ref}为{bound_amount} {bound_unit}"
    lexeme es "{bound_ref} es {bound_amount} {bound_unit}"
  quantity-constraint-members-frame
    defined-by arithmetic_operation
    role quantity-constraint-members-frame
    role scoped-grammar-pattern
    precondition "A fully consumed collection sentence explicitly lists one or more nonnegative quantities."
    effect "Capture every listed quantity and its original source spans without inventing members."
    unit "not applicable"
    example "The amounts are 300 ms and 600 ms."
    lexeme en "the {members_ref} are {quantities}"
    lexeme ru "{members_ref} равны {quantities}"
    lexeme hi "{members_ref} {quantities} हैं"
    lexeme zh "{members_ref}为{quantities}"
    lexeme es "{members_ref} son {quantities}"
  quantity-constraint-comparison-frame
    defined-by arithmetic_operation
    role quantity-constraint-comparison-frame
    role scoped-grammar-pattern
    precondition "The question explicitly requests an aggregate and an inclusive comparison with the same named bound."
    effect "Bind the aggregate cue and comparison relation to their original source spans."
    unit "not applicable"
    example "Is their combined total within the budget?"
    lexeme en "is their {aggregation} {relation} the {query_ref}"
    lexeme ru "верно ли, что {aggregation} {relation} {query_ref}"
    lexeme hi "क्या {aggregation} {query_ref} {relation} है"
    lexeme zh "是否{aggregation}{relation}{query_ref}"
    lexeme es "¿es {aggregation} {relation} {query_ref}"
  quantity-constraint-ownership-frame
    defined-by comparison
    role quantity-constraint-ownership-frame
    role scoped-grammar-pattern
    precondition "A comparison phrase contains a recognized inclusive relation and a bound reference."
    effect "Own the stated comparison; unsupported conditions remain unresolved rather than becoming unit conversions."
    unit "not applicable"
    example "within the budget"
    lexeme en "{relation} the {query_ref}"
    lexeme ru "{relation} {query_ref}"
    lexeme hi "{query_ref} {relation}"
    lexeme zh "{relation}{query_ref}"
    lexeme es "{relation} {query_ref}"
