  meta_explanation_architecture
    defined-by answer
    role localized_response_template
    precondition "a prompt asks how the assistant itself is built, addressing it and naming an architecture concept"
    effect "the answer says it is not an LLM runtime and names the current surface, its runtime, memory and web-search notes"
    unit "not applicable"
    example "I am not an LLM runtime and I do not perform neural inference."
    grounding "data/seed/multilingual-responses-capabilities.lino"
  algorithm_sort
    defined-by answer
    role localized_response_template
    precondition "a request asks for a sorting algorithm or names an algorithm without a test"
    effect "the answer lays out the seeded snippet of the found language with its execution status"
    unit "not applicable"
    example "Here is a reviewable sorting algorithm in rust:"
    grounding "data/seed/multilingual-responses-code-tasks.lino"
  algorithm_sort_with_tests
    defined-by answer
