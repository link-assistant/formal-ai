    effect "the plan's opening sentence carries the requested format label"
    unit "not applicable"
    example " in PDF format"
    grounding "data/seed/multilingual-responses-synthesis.lino"
  document_format_conversion
    defined-by answer
    role localized_response_template
    precondition "a document conversion answer opens with the engine, the source, the target and the supported formats"
    effect "the answer names the conversion engine and both formats before the converted output"
    unit "not applicable"
    example "Source: Markdown; target: HTML."
    grounding "data/seed/multilingual-responses-synthesis.lino"
  document_format_conversion_native_concepts
    defined-by answer
    role localized_response_template
    precondition "a conversion answer lists the target's native concepts"
    effect "the answer names the concepts the target format represents natively"
    unit "not applicable"
    example "Native target concepts: heading, paragraph."
    grounding "data/seed/multilingual-responses-synthesis.lino"
  document_format_conversion_fallbacks
    defined-by answer
    role localized_response_template
    precondition "a conversion answer introduces the concepts the target lacks"
    effect "the answer heads the list of concepts that fall back to another form"
    unit "not applicable"
    example "Documented target fallbacks:"
    grounding "data/seed/multilingual-responses-synthesis.lino"
  document_format_conversion_fallback
    defined-by answer
    role localized_response_template
    precondition "a conversion answer lists one concept the target lacks"
    effect "the answer pairs the concept with the form it falls back to"
    unit "not applicable"
    example "- emphasis -> plain text"
    grounding "data/seed/multilingual-responses-synthesis.lino"
  document_format_conversion_package
