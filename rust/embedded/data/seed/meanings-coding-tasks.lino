    lexeme es elimina eliminar borra borrar quita
  coding_declaration
    defined-by code
    role coding_declaration_noun
    precondition "a removal request names the functions it removes by name, with no quoted text"
    effect "the request's names are read as functions the file declares, each removed whole with the comments and attributes directly above it"
    unit "not applicable"
    example "delete the function parse_header from util.rs"
    lexeme en "function" "functions" "method" "methods"
    lexeme ru "функцию" "функции" "функций" "метод" "методы"
    lexeme hi "फ़ंक्शन" "फंक्शन"
    lexeme zh "函数" "方法"
    lexeme es "función" "funciones"
  # A programming-language keyword is the same word whatever language the
  # request is written in, so every lexeme lists the same keywords.
  function_declaration
    defined-by code
    role function_declaration_keyword
    precondition "a source line declares a function"
    effect "the keyword right before a name followed by its parameter list marks the line as that function's declaration"
    unit "not applicable"
    example "fn in fn parse_header(line: &str)"
    lexeme en "function" "fn" "def" "func" "fun"
    lexeme ru "function" "fn" "def" "func" "fun"
    lexeme hi "function" "fn" "def" "func" "fun"
    lexeme zh "function" "fn" "def" "func" "fun"
    lexeme es "function" "fn" "def" "func" "fun"
