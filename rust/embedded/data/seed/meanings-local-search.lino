  workspace_content_search_form
    # PR #1188 T90 (gap G12): a request for the places a name or literal is
    # used inside the workspace's files. `…` is the searched pattern (one
    # identifier or one quoted literal); the content-search arm greps it and
    # answers with the file:line hits, ahead of the file-name locate arm.
    defined-by action
    role workspace_content_search_form
    precondition "a request asks where a name or literal occurs in the workspace files"
    effect "the slot text is grepped across the scope and answered with file:line hits or a not-found answer"
    unit "not applicable"
    example "usages of add"
    lexeme en
      words "usages of …" "usage of …" "uses of …" "occurrences of …" "references to …" "references of …" "callers of …"
      words "who calls …" "what uses …" "where is … used" "where are … used" "where is … called" "where is … referenced"
      words "where does … appear" "grep for …" "grep …" "search for … in the files" "search for … in the code"
      words "search for … in the source" "search for … in this project" "search for … in the project"
      words "search for … in this repository" "search for … in the repository" "search for … in this directory"
      words "search for … in the current directory" "search for … in the workspace" "search for … in this workspace"
      words "find … in the code" "find … in the repository" "find … in this project" "search the files for …"
      words "search the code for …" "lines containing …" "files that mention …" "files containing …"
    lexeme ru
      words "использования …" "использование …" "вхождения …" "упоминания …" "ссылки на …" "где используется …"
      words "где используются …" "где вызывается …" "кто вызывает …" "грепни …" "найди … в файлах" "поищи … в файлах"
      words "найди … в коде" "найди … в проекте" "найди … в репозитории" "поищи … в проекте" "строки с …"
    lexeme hi
      words "… के सभी उपयोग" "… के उपयोग" "… का उपयोग कहाँ" "… कहाँ उपयोग" "… कहाँ इस्तेमाल" "… के सभी संदर्भ"
      words "… के संदर्भ" "… की सभी घटनाएँ" "फ़ाइलों में … खोजें" "प्रोजेक्ट में … खोजें" "कोड में … खोजें"
    lexeme zh
      words "…的所有用法" "…的用法" "…的所有引用" "…的引用" "…的所有出现" "…在哪里被使用" "…在哪里使用" "…在哪里被调用" "…被用在哪里" "在文件中搜索…" "在项目中搜索…" "在代码中搜索…"
    lexeme es
      words "usos de …" "ocurrencias de …" "apariciones de …" "referencias a …" "dónde se usa …" "dónde se utiliza …"
      words "dónde se llama a …" "quién llama a …" "busca … en los archivos" "busca … en el código"
      words "busca … en el proyecto" "busca … en este proyecto" "busca … en el repositorio"
  workspace_content_search_noise
    # Words that stand in the searched slot of a content-search form without
    # being the pattern ("usages of the function add"): skipped, never grepped.
    defined-by concept
    role workspace_content_search_noise
    precondition "a word stands in the searched slot of a content-search form"
    effect "the word is skipped and never grepped"
    unit "not applicable"
    example "the"
    lexeme en
      words the a an all every each "for" function method "variable" constant class "field" property symbol identifier
      words name word string text term
    lexeme ru
      words все всех функции функция функцию метода метод переменной переменная класса слова слово строки строку имени
      words идентификатора
    lexeme hi सभी फ़ंक्शन फंक्शन चर शब्द नाम
    lexeme zh 函数 方法 变量 所有
    lexeme es el la los las un una todos todas función método "variable" clase palabra cadena texto nombre identificador
