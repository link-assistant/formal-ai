prerequisite_recipe
  record_type "meta_recipe"
  issue "1138"
  topic "prerequisite_discovery"
  predecessor "docs/case-studies/issue-710/plans/07-prerequisite-discovery-bridge.md"
prerequisite_step_bind_failure
  record_type "meta_step"
  order "1"
  id "bind_failure"
  detail "Bind the failure to the actual prior call and recipe step. A nonzero exit is not always a missing compiler; permission denial is not installation consent."
  precondition "A command was observed failing, with its exit status and standard error retained."
  postcondition "Either a prerequisite need naming one program, or the honest verdict that this failure is not a prerequisite at all."
  source_file "src/prerequisite/mod.rs"
prerequisite_step_observe_platform
  record_type "meta_step"
  order "2"
  id "observe_platform"
  detail "Observe the missing executable, the platform and the runtime already present in the client workspace. Do not infer the host from the requested language."
  precondition "A prerequisite need exists and names a program."
  postcondition "The platform is the machine's, observed, and the need carries every toolchain it depends on."
  source_file "src/prerequisite/mod.rs"
prerequisite_step_look_up_publisher
  record_type "meta_step"
  order "3"
  id "look_up_publisher"
  detail "Find the procedure at the publisher that is authoritative for this program, not at the best-ranked page. A lookalike host is refused and the refusal is recorded."
  precondition "The program and the platform are known."
  postcondition "A publisher is named with the sources consulted, or the search is exhausted and names them all."
  source_file "src/prerequisite/publisher.rs"
prerequisite_step_formalize_procedure
  record_type "meta_step"
  order "4"
  id "formalize_procedure"
  detail "Turn the retrieved page into ordered steps with a postcondition probe. A procedure nothing can verify is refused before anything runs."
  precondition "A trusted publisher was selected."
  postcondition "A setup procedure carrying a postcondition probe for the program it claims to install."
  source_file "src/prerequisite/publisher.rs"
prerequisite_step_prefer_workspace_scope
  record_type "meta_step"
  order "5"
  id "prefer_workspace_scope"
  detail "Install beneath the workspace root only. Nothing is written outside it, nothing is written system-wide, and fetched text may never widen the grant."
  precondition "A setup procedure exists and a grant names the program."
  postcondition "A prefix under the workspace root, and environment bindings returned explicitly rather than exported."
  source_file "src/prerequisite/install.rs"
prerequisite_step_lower_to_tools
  record_type "meta_step"
  order "6"
  id "lower_to_tools"
  detail "Lower each step to the tools the surface actually has, under the default-deny grant, refusing before execution on scope, digest or free disk."
  precondition "The workspace prefix is prepared and the grant is still the caller's, unmodified."
  postcondition "Either every step ran, or the refusal names which rule stopped it and no bytes changed."
  source_file "src/prerequisite/install.rs"
prerequisite_step_retry_and_recheck
  record_type "meta_step"
  order "7"
  id "retry_and_recheck"
  detail "Re-probe. A setup command that exited zero is not success; only the postcondition probe returning Present discharges the need, and the original step may then be retried."
  precondition "The setup steps were attempted."
  postcondition "Recovered with the observed version, or StillMissing naming both observations."
  source_file "src/prerequisite/mod.rs"
prerequisite_step_retain_experience
  record_type "meta_step"
  order "8"
  id "retain_experience"
  detail "Retain the reconstruction record, never the payload: publisher, URL, content id, postcondition probe and the version as observed. The installed bytes stay disposable."
  precondition "A procedure was discovered, whether or not the grant let it run."
  postcondition "One append-only ledger row per program, enough to rediscover the same procedure to the same content id."
  source_file "src/prerequisite/ledger.rs"
