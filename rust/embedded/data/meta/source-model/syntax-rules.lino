(source-syntax-rules
  (parse-rule (language "JavaScript") (kind "program") (concept "module"))
  (parse-rule (language "TypeScript") (kind "program") (concept "module"))
  (parse-rule (language "Rust") (kind "source_file") (concept "module"))
  (parse-rule (language "JavaScript") (kind "function_declaration") (concept "function"))
  (parse-rule (language "TypeScript") (kind "function_declaration") (concept "function"))
  (parse-rule (language "Rust") (kind "function_item") (concept "function"))
  (parse-rule (language "JavaScript") (kind "identifier") (concept "identifier"))
  (parse-rule (language "TypeScript") (kind "identifier") (concept "identifier"))
  (parse-rule (language "Rust") (kind "identifier") (concept "identifier"))
  (parse-rule (language "JavaScript") (kind "comment") (concept "comment"))
  (parse-rule (language "TypeScript") (kind "comment") (concept "comment"))
  (parse-rule (language "Rust") (kind "line_comment") (concept "comment"))
  (parse-rule (language "Rust") (kind "block_comment") (concept "comment"))
  (parse-rule (language "JavaScript") (kind "whitespace") (concept "layout"))
  (parse-rule (language "TypeScript") (kind "whitespace") (concept "layout"))
  (parse-rule (language "Rust") (kind "whitespace") (concept "layout")))
