process_verification
  source "https://pubs.opengroup.org/onlinepubs/9799919799/utilities/cmp.html"
  purpose "A byte comparison preserves case, spaces and trailing newlines; a failed process cannot pass by printing the expected text before exiting."
  path "tests/verify-output.sh"
  template '#!/bin/sh\nset -eu\nverification_dir=$(mktemp -d)\ntrap \x27rm -f "$verification_dir/expected" "$verification_dir/actual"; rmdir "$verification_dir"\x27 EXIT HUP INT TERM\nprintf \x27%s\\n\x27 {expected} > "$verification_dir/expected"\n{command} > "$verification_dir/actual"\ncmp "$verification_dir/expected" "$verification_dir/actual"\ncat "$verification_dir/actual"\n'
  isolated-template '#!/bin/sh\nset -eu\nsource_path={source_path}\ntest -f "$source_path" && test ! -L "$source_path"\nverification_dir=$(mktemp -d "${TMPDIR:-/tmp}/formal-ai-verification.XXXXXXXXXX")\ntrap ''rm -rf -- "$verification_dir"'' EXIT\nprintf ''%s'' {declared_source} > "$verification_dir/declared-source"\ncmp "$source_path" "$verification_dir/declared-source"\nmkdir -p "$verification_dir/workspace/$(dirname "$source_path")"\ncp -- "$source_path" "$verification_dir/workspace/$source_path"\ncmp "$source_path" "$verification_dir/workspace/$source_path"\ncd "$verification_dir/workspace"\nprintf ''%s\\n'' {expected} > "$verification_dir/expected"\n{stages}cmp "$verification_dir/expected" "$verification_dir/actual"\ncat "$verification_dir/actual"\n'
  isolated-stage 'if {command}{redirect}; then\n  :\nelse\n  process_status=$?\n  printf ''\\n%s\\n'' ''__formal_ai_owned_process_failed_{index}__'' >&2\n  exit "$process_status"\nfi\n'
  isolated-failure "__formal_ai_owned_process_failed_{index}__"
