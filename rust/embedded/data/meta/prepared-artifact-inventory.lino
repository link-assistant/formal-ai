prepared-artifact-inventory
  version "1"
  command "command -v node >/dev/null 2>&1 && node --input-type=module -e {source} {plan}"
  evidence-template "dev/log/self-authored/issue-{number}/evidence/"
  evidence-pattern "^dev/log/self-authored/issue-[1-9][0-9]*/evidence/$"
  session-pattern "formal-ai session [A-Za-z0-9][A-Za-z0-9._:-]{0,127}\\nformal-ai model formal-ai/[A-Za-z0-9][A-Za-z0-9._+-]{0,127}\\n"
  session-limit "320"
  stream "claude-stream.jsonl"
  stream "codex-stream.jsonl"
  stream "agent-stream.jsonl"
  python-line "candidates = plan['candidates']"
  python-line "tracked = plan['tracked']"
  python-line "if len(candidates) > 256 or len(tracked) > 256 or len(set(tracked)) != len(tracked):"
  python-line "    raise ValueError('inventory_limit')"
  python-line "if any(value not in candidates for value in tracked):"
  python-line "    raise ValueError('inventory_unowned_member')"
  python-line "outputs = plan['outputs']"
  python-line "evidence = plan['evidenceRoot']"
  python-line "owned = []"
  python-line "for value in tracked:"
  python-line "    path = owned_path(value)"
  python-line "    data, identity = read_regular(path, MAXIMUM_FILE_BYTES)"
  python-line "    owners = [entry['source'] for entry in outputs if entry['output'] == value]"
  python-line "    if owners:"
  python-line "        if len(set(owners)) != 1:"
  python-line "            raise ValueError('inventory_ambiguous_source')"
  python-line "        source, source_identity = read_regular(owned_path(owners[0]), MAXIMUM_FILE_BYTES)"
  python-line "        source.decode('utf-8', 'strict')"
  python-line "        if not any(data.startswith(bytes.fromhex(prefix)) for prefix in plan['binaryPrefixes']):"
  python-line "            raise ValueError('inventory_unproven_output')"
  python-line "    elif value == evidence + 'session-id.txt':"
  python-line "        import re"
  python-line "        if len(data) > plan['sessionLimit'] or re.fullmatch(plan['sessionPattern'], data.decode('ascii', 'strict')) is None:"
  python-line "            raise ValueError('inventory_invalid_session')"
  python-line "    elif value in [evidence + member for member in plan['streams']]:"
  python-line "        if data:"
  python-line "            raise ValueError('inventory_nonempty_stream')"
  python-line "    else:"
  python-line "        raise ValueError('inventory_unowned_member')"
  python-line "    owned.append(value)"
  python-line "print(json.dumps({'schema': 'prepared-artifact-inventory/v1', 'complete': True,"
  python-line "                  'sourcePaths': plan['sourcePaths'], 'evidenceRoot': evidence, 'ownedPaths': owned}))"
  source-line "const plan = JSON.parse(process.argv[1]);"
  source-line "const deadline = Date.now() + 30000;"
  source-line "const run = async (program, argumentsValue) => {"
  source-line "  const remaining = deadline - Date.now();"
  source-line "  if (remaining <= 0) throw new Error('inventory_deadline');"
  source-line "  const result = await boundedCommand(program, argumentsValue, {"
  source-line "    timeout: remaining, stdoutLimitBytes: 65536, stderrLimitBytes: 65536, encoding: 'utf8',"
  source-line "  });"
  source-line "  if (result.error || result.status !== 0 || result.signal !== null || !result.cleanup_complete) {"
  source-line "    throw new Error('inventory_command_failed');"
  source-line "  }"
  source-line "  return result.stdout;"
  source-line "};"
  source-line "try {"
  source-line "  const tracked = await run('git', ['ls-files', '-z', '--', ...plan.candidates.map(value => ':(literal)' + value)]);"
  source-line "  if (tracked !== '' && !tracked.endsWith('\\0')) throw new Error('inventory_incomplete_git');"
  source-line "  plan.tracked = tracked === '' ? [] : tracked.slice(0, -1).split('\\0');"
  source-line "  const output = await run('python3', ['-c', plan.python, JSON.stringify(plan)]);"
  source-line "  process.stdout.write(output);"
  source-line "} catch (error) {"
  source-line "  console.error('prepared_artifact_inventory_failed');"
  source-line "  process.exitCode = 1;"
  source-line "}"
