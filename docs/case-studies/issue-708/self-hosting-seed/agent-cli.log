      "input": {
        "content": "general_change_plan\n  id \"general_change_plan_813df68fb867338e\"\n  execution_mode \"literal_file\"\n  goal \"Create a Links Notation file named memory-programs.lino with exactly this content:\\nmemory_program_catalog\\n  primitive match\\n    permission read\\n  primitive create\\n    permission write\\n  primitive update\\n    permission write\\n  primitive delete_with_retraction\\n    permission destructive\\n  primitive map_matches\\n    permission read\\n  primitive filter\\n    permission read\\n  primitive sequential_compose\\n    permission read\\n  primitive bounded_iterate_to_fixpoint\\n    permission read\\n  cue fact\\n  cue facts\\n  cue event\\n  cue events\\n  cue memory\\n  cue meaning\\n  cue label\\n  cue факт\\n  cue факты\\n  cue событие\\n  cue память\\n  cue значение\\n  cue तथ्य\\n  cue घटना\\n  cue स्मृति\\n  cue अर्थ\\n  cue 事实\\n  cue 事件\\n  cue 记忆\\n  cue 含义\\n  family contributed_fact_rename\\n    step_1 \\\"match contains=$old\\\"\\n    step_2 \\\"filter role=user\\\"\\n    step_3 \\\"map_matches field=content\\\"\\n    step_4 \\\"update old=$old new=$new\\\"\\n    step_5 sequential_compose\\n    step_6 bounded_iterate_to_fixpoint\\n    template_en \\\"list every fact i contributed about {old} and rename {old} to {new} in all of them\\\"\\n    template_ru \\\"перечисли все факты, которые я добавил о {old}, и переименуй {old} в {new} во всех них\\\"\\n    template_hi \\\"{old} के बारे में मेरे जोड़े हर तथ्य को सूचीबद्ध करो और उन सभी में {old} का नाम {new} कर दो\\\"\\n    template_zh \\\"列出我贡献的关于 {old} 的每个事实，并在所有事实中将 {old} 重命名为 {new}\\\"\\n  family topic_count_summary_week\\n    step_1 \\\"match period=this_week kind=event\\\"\\n    step_2 \\\"map_matches group=topic aggregate=count\\\"\\n    step_3 \\\"create kind=topic_summary\\\"\\n    step_4 sequential_compose\\n    step_5 bounded_iterate_to_fixpoint\\n    template_en \\\"count events per topic this week and store the summary\\\"\\n    template_en_alt \\\"count events per topic this week and store summary\\\"\\n    template_ru \\\"посчитай события по темам за эту неделю и сохрани сводку\\\"\\n    template_hi \\\"इस सप्ताह प्रति विषय घटनाएँ गिनो और सारांश सहेजो\\\"\\n    template_zh \\\"按主题统计本周事件并保存摘要\\\"\\n  family missing_russian_label_todo\\n    step_1 \\\"match kind=meaning\\\"\\n    step_2 \\\"filter missing=label_ru\\\"\\n    step_3 \\\"map_matches create=todo\\\"\\n    step_4 \\\"create kind=todo\\\"\\n    step_5 sequential_compose\\n    step_6 bounded_iterate_to_fixpoint\\n    template_en \\\"for every meaning without a russian label, add a todo link\\\"\\n    template_ru \\\"для каждого значения без русской метки добавь ссылку задачи\\\"\\n    template_hi \\\"रूसी लेबल के बिना हर अर्थ के लिए कार्य लिंक जोड़ो\\\"\\n    template_zh \\\"为每个没有俄语标签的含义添加待办链接\\\"\\n  family list_facts_about\\n    step_1 \\\"match contains=$topic\\\"\\n    step_2 \\\"filter kind=fact\\\"\\n    template_en \\\"list every fact about {topic}\\\"\\n    template_ru \\\"перечисли все факты о {topic}\\\"\\n    template_hi \\\"{topic} के बारे में हर तथ्य सूचीबद्ध करो\\\"\\n    template_zh \\\"列出关于 {topic} 的每个事实\\\"\\n  family replace_everywhere\\n    step_1 \\\"match contains=$old\\\"\\n    step_2 \\\"map_matches field=content\\\"\\n    step_3 \\\"update old=$old new=$new\\\"\\n    step_4 sequential_compose\\n    step_5 bounded_iterate_to_fixpoint\\n    template_en \\\"replace {old} with {new} in every memory event\\\"\\n    template_ru \\\"замени {old} на {new} в каждом событии памяти\\\"\\n    template_hi \\\"हर स्मृति घटना में {old} को {new} से बदलो\\\"\\n    template_zh \\\"在每个记忆事件中将 {old} 替换为 {new}\\\"\\n  family archive_duplicate_facts\\n    step_1 \\\"match kind=fact\\\"\\n    step_2 \\\"filter duplicate=true\\\"\\n    step_3 \\\"map_matches field=kind\\\"\\n    step_4 \\\"update value=archived_fact\\\"\\n    step_5 sequential_compose\\n    step_6 bounded_iterate_to_fixpoint\\n    template_en \\\"archive every duplicate fact\\\"\\n    template_ru \\\"архивируй каждый повторяющийся факт\\\"\\n    template_hi \\\"हर डुप्लिकेट तथ्य को संग्रहित करो\\\"\\n    template_zh \\\"归档每个重复事实\\\"\\n  family tag_matching_facts\\n    step_1 \\\"match contains=$topic\\\"\\n    step_2 \\\"filter kind=fact\\\"\\n    step_3 \\\"map_matches field=evidence\\\"\\n    step_4 \\\"update append=$tag\\\"\\n    step_5 sequential_compose\\n    template_en \\\"tag every fact about {topic} with {tag}\\\"\\n    template_ru \\\"пометь каждый факт о {topic} тегом {tag}\\\"\\n    template_hi \\\"{topic} के हर तथ्य को {tag} से टैग करो\\\"\\n    template_zh \\\"用 {tag} 标记关于 {topic} 的每个事实\\\"\\n  family copy_matches_to_collection\\n    step_1 \\\"match contains=$topic\\\"\\n    step_2 \\\"map_matches copy=true\\\"\\n    step_3 \\\"create collection=$collection\\\"\\n    step_4 sequential_compose\\n    template_en \\\"copy every fact about {topic} to collection {collection}\\\"\\n    template_ru \\\"скопируй каждый факт о {topic} в коллекцию {collection}\\\"\\n    template_hi \\\"{topic} के हर तथ्य को {collection} संग्रह में कॉपी करो\\\"\\n    template_zh \\\"将关于 {topic} 的每个事实复制到集合 {collection}\\\"\\n  family retract_contributed_facts\\n    step_1 \\\"match contains=$topic\\\"\\n    step_2 \\\"filter role=user\\\"\\n    step_3 \\\"map_matches target=id\\\"\\n    step_4 \\\"delete_with_retraction reason=user_request\\\"\\n    step_5 sequential_compose\\n    step_6 bounded_iterate_to_fixpoint\\n    template_en \\\"delete every fact i contributed about {topic}\\\"\\n    template_ru \\\"удали каждый факт, который я добавил о {topic}\\\"\\n    template_hi \\\"{topic} के बारे में मेरा जोड़ा हर तथ्य हटाओ\\\"\\n    template_zh \\\"删除我贡献的关于 {topic} 的每个事实\\\"\\n  family normalize_labels_fixpoint\\n    step_1 \\\"match field=label\\\"\\n    step_2 \\\"map_matches field=content\\\"\\n    step_3 \\\"update normalize=whitespace\\\"\\n    step_4 sequential_compose\\n    step_5 bounded_iterate_to_fixpoint\\n    template_en \\\"normalize every label until no