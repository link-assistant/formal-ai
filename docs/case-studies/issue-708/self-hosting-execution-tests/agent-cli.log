  "part": {
    "id": "prt_fbc7da7250012lY8X1aQRxFeoY",
    "sessionID": "ses_043825d8effei1XSgD3l0ddOLk",
    "messageID": "msg_fbc7da5dc001g0hfLS5Hd2gkNv",
