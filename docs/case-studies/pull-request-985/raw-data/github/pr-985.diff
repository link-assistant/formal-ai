+  --path - --into "$MEMORY_PATH" \
+  <"$workdir/released-memory.lino"
+run_image "$PREVIOUS_IMAGE" bash -c \
+  "sed -i '/content \"remember the amber migration canary\"/a\    futureField \"preserve this extension\"' '$MEMORY_PATH' && sync"
