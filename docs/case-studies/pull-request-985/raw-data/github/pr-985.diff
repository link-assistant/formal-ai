+    let before_retry = std::fs::read(&memory_path).expect("memory before retry");
+    let retry = run_memory_command(&[
+        "migrate",
+        "--path",
+        memory_path.to_str().expect("memory path"),
+        "--backup",
+        backup_path.to_str().expect("backup path"),
+        "--receipt",
