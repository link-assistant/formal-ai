{"path":".github/workflows/templates.yml","name":"Captured templates","events":{"pull_request":{"types":["opened","synchronize","reopened"]},"push":{"branches":["main"]},"workflow_dispatch":null,"schedule":[{"cron":"41 7 * * 1"}]},"permissions":{"contents":"read"},"concurrency":{"group":"templates-${{ github.ref }}","cancel-in-progress":"${{ github.ref != 'refs/heads/main' }}"},"jobs":[{"id":"javascript","runsOn":"ubuntu-26.04","timeout":25,"steps":[{"uses":"actions/checkout@v7.0.1"},{"uses":"actions/setup-node@v7.1.0"},{"run":"npm install --global npm@12.2.2"},{"run":"npm ci"},{"run":"npm ci --prefix examples/universal-app"},{"run":"npm test"},{"uses":"oven-sh/setup-bun@v2.2.0"},{"run":"bun test --timeout 30000 tests"},{"uses":"denoland/setup-deno@v2.0.5"},{"run":"deno test --frozen-lockfile --allow-read --allow-write --allow-env --allow-run tests"},{"run":"npm run check"},{"run":"npm pack --dry-run"},{"run":"npm run example:web:build"},{"run":"npm run example:desktop:package"},{"run":"npm run example:mobile:sync"},{"run":"deno audit"},{"run":"npm audit"},{"run":"npm audit --prefix examples/universal-app"}]},{"id":"python","runsOn":"ubuntu-26.04","timeout":20,"steps":[{"uses":"actions/checkout@v7.0.1"},{"uses":"actions/setup-python@v7.1.0"},{"run":"python -m pip install --upgrade pip==26.3\npip install -r requirements.lock\npip install --no-deps --no-build-isolation .\n"},{"run":"ruff check ."},{"run":"ruff format --check ."},{"run":"mypy src tests"},{"run":"pytest --cov=src --cov-report=term-missing"},{"run":"python -m build --no-isolation"},{"run":"twine check dist/*"},{"run":"sphinx-build -W --keep-going -b html docs docs/_build/html"},{"run":"pip-audit -r requirements.lock"},{"name":"Validate every pre-commit configuration","run":"pre-commit validate-config .pre-commit-config.yaml\npre-commit validate-config ../csharp/.pre-commit-config.yaml\npre-commit validate-config ../rust/.pre-commit-config.yaml\n"}]},{"id":"csharp","runsOn":"ubuntu-26.04","timeout":20,"st