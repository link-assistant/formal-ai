{
  "type": "tool_use",
  "timestamp": 1789528691161,
  "sessionID": "ses_f57c7498effeH7n8M2Oon1cbp6",
  "part": {
    "id": "prt_0a838cf06002jwuePI4AKIiEI2",
    "sessionID": "ses_f57c7498effeH7n8M2Oon1cbp6",
    "messageID": "msg_0a838ce14001aj7Zc6JBW7uUD1",
    "type": "tool",
    "callID": "call_8f0e361cef504f78",
    "tool": "webfetch",
    "state": {
      "status": "completed",
      "input": {
        "format": "text",
        "url": "https://ondoku3.com/hi/post/learn-chinese-with-practical-examples/"
      },
      "output": "चीनी दैनिक बातचीत के उदाहरण और ऑडियो सामग्री बनाने का तरीका [उच्चारण के साथ]｜पाठ से भाषण सॉफ्टवेयर Ondoku\n    \n\n\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    \n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n    \n\n\n    \n    \n    \n    \n    \n    \n\n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    \n    \n    \n    \n\n    \n    \n\n    \n    \n    \n\n    \n    \n    \n\n\n\n    \n    \n        \n            \n                \n                    \n                    \n              \n            \n              \n              \n              \n                    \n                    \n\n                    \n                    \n                        \n                    \n                    \n\n                    \n                    \n\n\n                        \n                            \n                            \n                                घर\n                            \n                            \n                                \n                                    कीमत\n                                \n                            \n\n                            \n                                फ़ीचर\n                            \n                            \n                                मामले का अध्ययन\n                            \n                            \n                                सामान्य प्रश्न\n                            \n\n                            \n                                \n                                    लॉग इन करें\n                                \n                                \n                                    निःशुल्क पंजीकरण\n                                \n                            \n\n\n                        \n\n\n                    \n                \n            \n        \n    \n    \n\n\n    \n    \n        \n            \n    \n    \n    \n        \n\n            \n            \n            \n                \n                    Ondoku\n                    ब्लॉग\n                    \n                        सुझावों\n                    \n                \n            \n\n\n            \n                \n                    चीनी दैनिक बातचीत के उदाहरण और ऑडियो सामग्री बनाने का तरीका [उच्चारण के साथ]\n                \n            \n            9 सितमबर 2026\n            \n                \n                \n                \n\n\n\n\n\n\n\n\n\n\n\nमैं अपने चीनी दोस्तों के साथ चीनी भाषा में बात करना चाहता हूँ!\n                \n\n\n\n\n\n\n\n\nमैं वाक्यांशों को याद करना और संवाद करना चाहता हूँ!\n                \n\n\n\n\n\n\n\nउन लोगों के लिए जो ऐसा चाहते हैं, हम यहाँ चीनी भाषा के दैनिक बातचीत के वाक्यांश और उदाहरण पेश कर रहे हैं जिनका आप अभी उपयोग कर सकते हैं, जिन्हें विशिष्ट स्थितियों के अनुसार वर्गीकृत किया गया है।\n\nइस लेख में उपयोग की गई सभी आवाज़ें Ondoku की AI आवाज़ें हैं। इनका उच्चारण पुरुष और महिला की आवाज़ों में किया गया है।\n\nयदि कोई उच्चारण सुनने में कठिन है, तो कृपया उसे किसी अन्य प्रकार की आवाज़ में सुनने का प्रयास करें। अपनी पसंद की आवाज़ में सुनने से इसे समझना और भी आसान हो जाता है।\n\nचीनी टेक्स्ट या इमेज इनपुट करके ऑडियो बनाने और यहाँ तक कि MP3 डाउनलोड करने की सुविधा देने वाले उपयोगी \"Ondoku\" का उपयोग करके अपनी खुद की मूल ऑडियो शिक्षण सामग्री बनाने का तरीका भी हम आपको बताएंगे।\n\nकृपया इसका भरपूर लाभ उठाएं!\n\n१. अभिवादन\n\n\nवाक्यांश\n\nऑडियो\n\n\n\n\nधन्यवाद।\n            \n            Xièxiè\n            \n谢谢。\n\n\n\n\n\n\n\n\n\n\nशुभ प्रभात।\n            \n            Zǎo shàng hǎo\n            \n早上好。\n\n\n\n\n\n\n\n\n\n\nस्वागत है।\n            \n            Huānyíng\n            \n欢迎。\n\n\n\n\n\n\n\n\n\n\nशुभ रात्रि।\n            \n            Wǎn'ān\n            \n晚安。\n\n\n\n\n\n\n\n\n\n\nआपका दिन शुभ हो।\n            \n            Zhù nǐ yīgè hǎo de yītiān\n            \n祝你一个好的一天。\n\n\n\n\n\n\n\n\n\n\nआपसे मिलकर खुशी हुई।\n            \n            Hěn gāoxìng jiàn dào nǐ\n            \n很高兴见到你。\n\n\n\n\n\n\n\n\n\n\nआप कैसे हैं?\n            \n            Nǐ hǎo ma?\n            \n你好吗？\n\n\n\n\n\n\n\n\n\n\nकृपया मेरा ख्याल रखें (आपसे मिलकर अच्छा लगा)।\n            \n            Qǐng duō guānzhào\n            \n请多关照。\n\n\n\n\n\n\n\n\n\n\nअलविदा, फिर मिलते हैं।\n            \n            Zàijiàn, huí tóu jiàn\n            \n再见，回头见。\n\n\n\n\n\n\n\n\n\n\nअपना ख्याल रखें।\n            \n            Bǎozhòng\n            \n保重。\n\n\n\n\n\n\n\n\n२．सुपरमार्केट में खाद्य पदार्थ खरीदना\n\n\n\n\n\nवाक्यांश\n\nऑडियो\n\n\n\n\nयह कितने का है?\n            \n            Zhè shì duōshǎo qián?\n            \n这是多少钱？\n\n\n\n\n\n\n\n\n\n\nक्या आप इसे बैग में डाल सकते हैं?\n            \n            Kěyǐ bāng wǒ zhuāng dài ma?\n            \n可以帮我装袋吗？\n\n\n\n\n\n\n\n\n\n\nक्या कोई छूट है?\n            \n            Yǒu zhékòu ma?\n            \n有折扣吗？\n\n\n\n\n\n\n\n\n\n\nक्या यह उत्पाद स्टॉक में है?\n            \n            Zhè jiàn shāngpǐn yǒu kùcún ma?\n            \n这件商品有库存吗？\n\n\n\n\n\n\n\n\n\n\nकार्ट कहाँ है?\n            \n            Gòuwù chē zài nǎlǐ?\n            \n购物车在哪里？\n\n\n\n\n\n\n\n\n\n\nक्या क्रेडिट कार्ड का उपयोग किया जा सकता है?\n            \n            Kěyǐ yòng xìnyòngkǎ ma?\n            \n可以用信用卡吗？\n\n\n\n\n\n\n\n\n\n\nयह कौन सी सामग्री है?\n            \n            Zhè shì shénme shí cái?\n            \n这是什么食材？\n\n\n\n\n\n\n\n\n\n\nक्या मैं इस उत्पाद को वापस कर सकता हूँ?\n            \n            Wǒ kěyǐ tuì zhè jiàn shāngpǐn ma?\n            \n我可以退这件商品吗？\n\n\n\n\n\n\n\n\n\n\nक्या मैं इसे चख सकता हूँ?\n            \n            Kěyǐ shìshí ma?\n            \n可以试食吗？\n\n\n\n\n\n\n\n\n३．दोस्तों के साथ भोजन करना\n\n\n\n\n\nवाक्यांश\n\nऑडियो\n\n\n\n\nकृपया मुझे मेनू दिखाएं।\n            \n            Qǐng gěi wǒ càidān\n            \n请给我菜单。\n\n\n\n\n\n\n\n\n\n\nमैं इसे ऑर्डर करूँगा।\n            \n            Wǒ yào zhègè\n            \n我要这个。\n\n\n\n\n\n\n\n\n\n\nयह स्वादिष्ट है।\n            \n            Hǎochī\n            \n好吃。\n\n\n\n\n\n\n\n\n\n\nक्या आप कुछ मीठा लेना चाहेंगे?\n            \n            Nǐ yào chī tián de ma?\n            \n你要吃甜的吗？\n\n\n\n\n\n\n\n\n\n\nक्या आप बीयर लेना चाहेंगे?\n            \n            Yào píjiǔ ma?\n            \n要啤酒吗？\n\n\n\n\n\n\n\n\n\n\nइस व्यंजन का नाम क्या है?\n            \n            Zhè dào cài jiào shénme míngzi?\n            \n这道菜叫什么名字？\n\n\n\n\n\n\n\n\n\n\nइस दुकान की सिफारिश क्या है?\n            \n            Zhè jiā diàn de tuījiàn shì shénme?\n            \n这家店的推荐是什么？\n\n\n\n\n\n\n\n\n\n\nकृपया और पानी दें।\n            \n            Qǐng gěi wǒ gèng duō shuǐ\n            \n请给我更多水。\n\n\n\n\n\n\n\n\n\n\nकृपया बिल ले आएं।\n            \n            Mǎidān\n            \n买单。\n\n\n\n\n\n\n\n\n४．रास्ता पूछना\n\n\n\n\n\nवाक्यांश\n\nऑディオ\n\n\n\n\nस्टेशन कहाँ है?\n            \n            Chēzhàn zài nǎlǐ?\n            \n车站在哪里？\n\n\n\n\n\n\n\n\n\n\nकृपया दाएं मुड़ें।\n            \n            Qǐng yòu zhuǎn\n            \n请右转。\n\n\n\n\n\n\n\n\n\n\nक्या आप मुझे नक्शा दिखा सकते हैं?\n            \n            Kěyǐ gěi wǒ dìtú ma?\n            \n可以给我地图吗？\n\n\n\n\n\n\n\n\n\n\nशौचालय कहाँ है?\n            \n            Cèsuǒ zài nǎlǐ?\n            \n厕所在哪里？\n\n\n\n\n\n\n\n\n\n\nक्या यह यहाँ से दूर है?\n            \n            Lí zhèlǐ yuǎn ma?\n            \n离这里远吗？\n\n\n\n\n\n\n\n\n\n\nबस स्टॉप कहाँ है?\n            \n            Gōngjiāo chēzhàn zài nǎlǐ?\n            \n公交车站在哪里？\n\n\n\n\n\n\n\n\n\n\nमैं यहाँ कैसे जा सकता हूँ?\n            \n            Wǒ yīnggāi rúhé qù zhèlǐ?\n            \n我应该如何去这里？\n\n\n\n\n\n\n\n\n\n\nक्या अगले चौराहे पर बाएं मुड़ना है?\n            \n            Xià yīgè lùkǒu zuǒ zhuǎn ma?\n            \n下一个路口左转吗？\n\n\n\n\n\n\n\n\n\n\nक्या यह जगह एक पर्यटन स्थल है?\n            \n            Zhè ge dìfāng shì guānguāng míngshèng ma?\n            \n这个地方是观光名胜吗？\n\n\n\n\n\n\n\n\n५．गलती के लिए माफी मांगना\n\n\n\n\n\nवाक्यांश\n\nऑडियो\n\n\n\n\nमुझे क्षमा करें।\n            \n            Duìbùqǐ\n            \n对不起。\n\n\n\n\n\n\n\n\n\n\nयह मेरी गलती है।\n            \n            Zhè shì wǒ de cuò\n            \n这是我的错。\n\n\n\n\n\n\n\n\n\n\nकृपया मुझे माफ कर दें।\n            \n            Qǐng yuánliàng wǒ\n            \n请原谅我。\n\n\n\n\n\n\n\n\n\n\nमेरी वजह से आपको परेशानी हुई।\n            \n            Wǒ de cuò, gěi nǐ tiān máfan le\n            \n我的错，给你添麻烦了。\n\n\n\n\n\n\n\n\n\n\nचिंता न करें।\n            \n            Bùyào zàiyì\n            \n不要在意。\n\n\n\n\n\n\n\n\n\n\nक्या आप ठीक हैं?\n            \n            Nǐ méishì ba?\n            \n你没事吧？\n\n\n\n\n\n\n\n\n\n\nमैं अगली बार सावधान रहूँगा।\n            \n            Xià cì wǒ huì zhùyì\n            \n下次我会注意。\n\n\n\n\n\n\n\n\n\n\nआपको चिंता कराने के लिए मुझे खेद है।\n            \n            Ràng nǐ dānxīn le, duìbùqǐ\n            \n让你担心了，对不起。\n\n\n\n\n\n\n\n\n६．अक्सर उपयोग किए जाने वाले वाक्यांश\n\n\n\n\n\nवाक्यांश\n\nऑडियो\n\n\n\n\nमैं समझ गया।\n            \n            Wǒ míngbái le\n            \n我明白了。\n\n\n\n\n\n\n\n\n\n\nकृपया/लीजिए।\n            \n            Qǐng\n            \n请。\n\n\n\n\n\n\n\n\n\n\nअसुविधा के लिए खेद है।\n            \n            Máfan nǐ le\n            \n麻烦你了。\n\n\n\n\n\n\n\n\n\n\nक्या आप कृपया इसे फिर से कह सकते हैं?\n            \n            Qǐng zài shuō yīcì\n            \n请再说一次。\n\n\n\n\n\n\n\n\n\n\nकृपया प्रतीक्षा करें।\n            \n            Qǐng děng yīxià\n            \n请等一下。\n\n\n\n\n\n\n\n\n\n\nक्या आप मुझे समय बता सकते हैं?\n            \n            Qǐng wèn jǐ diǎn?\n            \n请问几点？\n\n\n\n\n\n\n\n\n\n\nआपका जन्म कहाँ हुआ था?\n            \n            Nǐ zài nǎlǐ chūshēng de?\n            \n你在哪里出生的？\n\n\n\n\n\n\n\n\n\n\nआपका नाम क्या है?\n            \n            Nǐ jiào shénme míngzi?\n            \n你叫什么名字？\n\n\n\n\n\n\n\n\n७．दो लोगों के बीच बातचीत\n\n\n\n\nशहर में अचानक मिले दो लोगों के बीच की बातचीत है\n\n\n\n\n\n\n\nA (ली लेई): 嗨，你好！好久不见了！\n\n        Hāi, nǐ hǎo! Hǎojiǔ bújiàn le!\n        \n        \"हाय, नमस्ते! बहुत समय बाद मिले!\"\n    \nB (हान मेइमेई): 啊，李雷！是你啊！真没想到在这里碰到你！\n\n        A, Lǐ Léi! Shì nǐ a! Zhēn méi xiǎngdào zài zhèlǐ pèngdào nǐ!\n        \n        \"ओह, ली लेई! यह तुम हो! मैंने सच में नहीं सोचा था कि यहाँ तुमसे मुलाकात होगी!\"\n    \nA (ली लेई): 我也是！你最近怎么样？\n\n        Wǒ yěshì! Nǐ zuìjìn zěnme yàng?\n        \n        \"मैं भी! तुम आजकल कैसी हो?\"\n    \nB (हान मेइमेई): 挺好的，谢谢！你呢？忙吗？\n\n        Tǐng hǎo de, xièxiè! Nǐ ne? Máng ma?\n        \n        \"मैं ठीक हूँ, धन्यवाद! और तुम? क्या तुम व्यस्त हो?\"\n    \nA (ली लेई): 有点忙，但是都还好。对了，下个星期六有空吗？我们可以一起吃饭。\n\n        Yǒudiǎn máng, dànshì dōu hái hǎo. Duìle, xià gè xīngqīliù yǒu kòng ma? Wǒmen kěyǐ yīqǐ chīfàn.\n        \n        \"थोड़ा व्यस्त हूँ, लेकिन सब ठीक है। वैसे, क्या तुम अगले शनिवार को खाली हो? हम साथ में खाना खा सकते हैं।\"\n    \nB (हान मेइमेई): 好主意！我也想和你见面。下个星期六见！\n\n        Hǎo zhǔyì! Wǒ yě xiǎng hé nǐ jiànmiàn. Xià gè xīngqīliù jiàn!\n        \n        \"अच्छा विचार है! मैं भी तुमसे मिलना चाहती थी। अगले शनिवार को मिलते हैं!\"\n    \nA (ली लेई): 好的，下周六见！保重！\n\n        Hǎo de, xià zhōu liù jiàn! Bǎozhòng!\n        \n        \"ठीक है, अगले शनिवार को मिलते हैं! अपना ख्याल रखना!\"\n    \nB (हान मेइमेई): 你也是，再见！\n\n        Nǐ yěshì, zàijiàn!\n        \n        \"तुम भी, अलविदा!\"\n    \n\nOndoku, एक सेवा जो आपको आसानी से चीनी भाषा पढ़ने की अनुमति देती है\n\n\n\n\nOndoku आधिकारिक वेबसाइट\n\nOndoku एक ऐसी सेवा है जो टेक्स्ट या इमेज डालने पर उसे आवाज़ में बदलकर पढ़ सकती है। यह सरल है और इसका संचालन समझने में आसान है।\n\nहमारे जैसे चीनी भाषा सीखने वालों के लिए उच्चारण की जाँच करने के लिए यह सेवा एकदम सही है!\n\nयह सरलीकृत और पारंपरिक चीनी दोनों का समर्थन करता है, और इसमें महिला और पुरुष सहित कई वक्ता हैं, इसलिए आप अपनी पसंद की आवाज़ चुन सकते हैं।\n\nचीनी भाषा के लिए Ondoku की आवाज़ों के प्रकार\n\nआवाज़ों में महिला, पुरुष, लड़की और लड़के की आवाज़ें शामिल हैं।\n\n\nमैंडरिन (चीन मुख्य भूमि)\n        \nपुरुष: 10 प्रकार\n\nमहिला: 16 प्रकार\n\nलड़का: 3 प्रकार\n\nलड़की: 3 प्रकार\n\nकैंटोनीज़ (हांगकांग)\n        \nपुरुष: 1 प्रकार\n\nमहिला: 2 प्रकार\n\nगुओयू (ताइवान)\n        \nपुरुष: 3 प्रकार\n\nमहिला: 3 प्रकार\n\n\n41 वक्ताओं के पास अपना स्वयं का अनूठा उच्चारण है, जिससे आप वास्तविक चीनी सुन सकते हैं।\n\n\nबोलने की गति को तेज़ या धीमा करने की सुविधा और\n    \nआवाज़ की पिच को ऊँचा या नीचा करने की सुविधा\n    \n\nभी दी गई है। सेटिंग्स बदलने से प्रभाव बदल जाता है और सुनने में आसानी भी बदल जाती है।\n\nOndoku &gt;&gt; चीनी ऑडियो सैंपल पेज\n\n\n\n\n\nजब मैंने अपने चीनी दोस्त को यह आवाज़ सुनाई, तो उसने कहा, \"अद्भुत! यह बिल्कुल स्थानीय (Native) लगता है!\"\n                \n\n\n\n\n\n\n\nआप इस लेख में चीनी ऑडियो के सैंपल मुफ्त में सुन सकते हैं, इसलिए कृपया इसे ज़रूर देखें!\n\n\n\n\n\n\n\n\n\n\n\n                चीनी भाषा सीखने के लिए उच्चारण जाँच और सुनने के अभ्यास के लिए! स्थानीय उच्चारण, 40 वक्ताओं को सुनें (सैंपल) महिला, पुरुष, लड़की की आवाज़ें\n            \n\n                यहाँ आप Ondoku की चीनी आवाज़ों का सैंपल सुन सकते हैं। चीनी ऑडियो के लिए आप सरलीकृत चीनी (मैंडरिन), कैंटोनीज़ और पारंपरिक चीनी (गुओयू) जैसे विभिन्न क्षेत्रीय भाषाओं में से चुन सकते हैं। आवाज़ों में महिला, पुरुष, लड़की और लड़के की आवाज़ें शामिल हैं।\n            \n\n\n\n\nइसके अलावा, यह 81 भाषाओं और क्षेत्रों का समर्थन करता है, इसलिए आप इसे चीनी के अलावा अन्य भाषा सीखने के लिए भी उपयोग कर सकते हैं।\n\n\n\n\n\n\n\n\n\n\n\n                【Ondoku】समर्थित भाषाओं के आवाज़ के प्रकार और सैंपल ऑडियो सुनें\n            \n\n                यहाँ हम Ondoku की समर्थित भाषाओं और सैंपल ऑडियो के बारे में जानकारी देंगे।\n            \n\n\n\n\nइसे बुनियादी तौर पर मुफ्त में इस्तेमाल किया जा सकता है, और यदि आप पढ़े जाने वाले शब्दों की संख्या बढ़ाना चाहते हैं, तो सशुल्क उपयोग आवश्यक है।\n\nहालाँकि, केवल चीनी उच्चारण की जाँच करने के लिए मुफ्त सीमा पर्याप्त है।\n\nOndoku का उपयोग कैसे करें\n\n\n\n\nOndoku को मुफ्त में उपयोग करना बहुत आसान है।\n\nकिसी ऐप या सॉफ़्टवेयर को डाउनलोड करने की आवश्यकता नहीं है। वेब ब्राउज़र में ही सब कुछ किया जा सकता है, जो इसकी एक विशेषता है।\n\nउपयोग करने का तरीका:\n\n\n\nOndoku वेबसाइट पर जाएँ\n\nटेक्स्ट बॉक्स में वह शब्द दर्ज करें जिन्हें आप पढ़वाना चाहते हैं (कॉपी-पेस्ट भी ठीक है)\n\nभाषा, आवाज़ का प्रकार और गति जैसी अपनी पसंदीदा सेटिंग्स समायोजित करें\n\n\"पढ़ें\" पर क्लिक करें\n\n\n\nबस इतना ही।\n\nइसके अतिरिक्त, ऑडियो को MP3 प्रारूप में डाउनलोड भी किया जा सकता है।\n\nपाठ्यपुस्तकों और प्रिंटआउट को भी पढ़ा जा सकता है\n\nOndoku की एक छिपी हुई सुविधाजनक विशेषता\n\n\"इमेज अपलोड करके टेक्स्ट को पढ़वाना\" है।\n\nयह एक ऐसी सुविधा है जो स्मार्टफोन आदि से ली गई तस्वीरों को आवाज़ में पढ़ सकती है।\n\n\n\n\n\n\n\n\nआप चित्रों वाली किताबों, किताबों, पाठ्यपुस्तकों आदि की फोटो खींच सकते हैं और उन्हें Ondoku द्वारा पढ़वा सकते हैं।\n                \n\n\n\n\nचीनी भाषा में कुछ ऐसे अक्षर होते हैं जिन्हें जापानी स्मार्टफोन या कंप्यूटर से दर्ज नहीं किया जा सकता है, इसलिए यह बहुत सुविधाजनक है!\n\nजब घर पर बच्चों को चीनी भाषा सिखाई जाती है या चीनी पाठ्यपुस्तकें पढ़ी जाती हैं, तो यह सुविधा \"इसे कैसे पढ़ें\" की चिंता को एक ही बार में हल कर देती है।\n\nइसके अलावा, आपको प्रत्येक शब्द को स्वयं दर्ज करने की आवश्यकता नहीं है, इसलिए यह बिना किसी परेशानी के बहुत सुविधाजनक है।\n\n【इमेज → टेक्स्ट पढ़ने की सुविधा का उपयोग कैसे करें】\n\n\n\n\n\n\n\nOndoku के मुख्य पृष्ठ पर जाएँ\n        \nटेक्स्ट बॉक्स के ऊपर \"टेक्स्ट\" और \"इमेज\" टैब हैं\n        \n\"इमेज\" टैब पर क्लिक करें\n        \nइमेज अपलोड पर क्लिक करें और अपनी पसंद की इमेज चुनें\n            \n            ※ स्मार्टफोन के मामले में, आप यहाँ कैमरा शुरू कर सकते हैं और सीधे फोटो ले सकते हैं।\n        \nइमेज चुनने के बाद, पढ़ने की गति और पिच को समायोजित करें।\n        \n\"पढ़ें\" बटन पर क्लिक करें\n        \n\n\nफिर कुछ ही सेकंड में इमेज का विश्लेषण किया जाएगा और ऑडियो पढ़ा जाएगा।\n\nइमेज लोड करने के बाद, पहचाने गए अक्षर टेक्स्ट बॉक्स में प्रदर्शित होंगे।\n\nयदि कोई पहचान त्रुटि है और पढ़ना अजीब लग रहा है, तो आप इसे यहाँ संपादित कर सकते हैं।\n\nउपयोग करने के विस्तृत तरीके की जानकारी यहाँ दी गई है।\n\n\n\n\n\n\n\n\n\n\n\n                इमेज रीडिंग का उपयोग कैसे करें | फोटो के अक्षरों को मुफ्त OCR करके ऑडियो में बदलने का तरीका\n            \n\n                'Ondoku' की सुविधा की व्याख्या करता है जो इमेज या फोटो के अक्षरों को पढ़कर (OCR) ऑडियो में बदल सकती है। यह मुफ़्त है। पीसी या स्मार्टफोन पर बस इमेज अपलोड करने से कुछ ही सेकंड में रीडिंग पूरी हो जाती है।\n            \n\n\n\n\nOndoku चीनी भाषा सीखने के लिए एकदम सही है\n\nचीनी उच्चारण की जाँच करना, चीनी टेक्स्ट पढ़ना, और यहाँ तक कि इमेज से टेक्स्ट पहचान कर चीनी पढ़वाना... Ondoku बहुत सुविधाजनक है।\n\nइतनी सारी सुविधाएँ मुफ्त में उपलब्ध हैं, यह वास्तव में एक महान समय है।\n\nमुफ्त होने के कारण, आप इसे अभी आज़मा सकते हैं!\n\nहमे उम्मीद है कि उत्कृष्ट Ondoku, जो चीनी उच्चारण के साथ पढ़ता है, आपकी चीनी भाषा की पढ़ाई में मदद करेगा।\n\nकृपया इसे ज़रूर आज़माएँ।\n\nचीनी भाषा पढ़ने से संबंधित लेख\n\n\n\n\n\n\n\n\n\n\n\n                चीनी भाषा सीखने के लिए उच्चारण जाँच और सुनने के अभ्यास के लिए! स्थानीय उच्चारण, 40 वक्ताओं को सुनें (सैंपल) महिला, पुरुष, लड़की की आवाज़ें\n            \n\n                यहाँ आप Ondoku की चीनी आवाज़ों का सैंपल सुन सकते हैं। चीनी ऑडियो के लिए आप सरलीकृत चीनी (मैंडरिन), कैंटोनीज़ और पारंपरिक चीनी (गुओयू) जैसे विभिन्न क्षेत्रीय भाषाओं में से चुन सकते हैं। आवाज़ों में महिला, पुरुष, लड़की और लड़के की आवाज़ें शामिल हैं।\n            \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n                पिनयिन उच्चारण को पढ़ने और डाउनलोड करने के लिए बेहतरीन वेबसाइट 【चीनी शिक्षार्थियों के लिए अवश्य देखें】\n            \n\n                Ondoku एक ऐसी वेबसाइट है जहाँ आप चीनी लिपि और पिनयिन लिपि दोनों में टेक्स्ट पढ़वा सकते हैं और उसे डाउनलोड भी कर सकते हैं। स्मार्टफोन का उपयोग करके, आप मौके पर ली गई फोटो से चीनी उच्चारण भी करवा सकते हैं।\n            \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n                【2026 संस्करण】चीनी पढ़ने की अध्ययन विधि! अनुशंसित साइटें, ऐप, नमूना टेक्स्ट और उनके उपयोग का विस्तृत विवरण\n            \n\n                आप कांजी पढ़ सकते हैं लेकिन उच्चारण नहीं कर सकते... इस समस्या का समाधान यहाँ है! चीनी भाषा को ज़ोर से पढ़ने के लिए चुनिंदा साइटों और ऐप्स का परिचय। मुफ़्त 'Ondoku' के उपयोग, स्थानीय स्तर का उच्चारण प्राप्त करने के सुझाव और नमूना टेक्स्ट के बारे में जानकारी।\n            \n\n\n\n\n\n                ■ एआई भाषण संश्लेषण सॉफ्टवेयर \"ओन्डोकू\"\n                \n                    \"ओन्डोकू\" एक ऑनलाइन टेक्स्ट-टू-स्पीच टूल है जिसका उपयोग बिना किसी प्रारंभिक लागत के किया जा सकता है।\n                \n                    \n                        जापानी, अंग्रेजी, चीनी, कोरियाई, स्पेनिश, फ्रेंच, जर्मन आदि सहित 81 भाषाओं और क्षेत्रों का समर्थन करता है।\n                    \n                    पीसी और स्मार्टफोन दोनों से उपलब्ध है\n                    व्यवसाय, शिक्षा, मनोरंजन आदि के लिए उपयुक्त।\n                    \n                    किसी इंस्टॉलेशन की आवश्यकता नहीं, आपके ब्राउज़र से तुरंत उपयोग किया जा सकता है\n                    छवियों से पढ़ने का भी समर्थन करता है\n                \n                \n                    इसका उपयोग करने के लिए, बस टेक्स्ट दर्ज करें या साइट से एक फ़ाइल अपलोड करें।\n                    सेकंडों में प्राकृतिक ध्वनि फ़ाइलें उत्पन्न करें।\n                    आप 5,000 वर्णों तक वाक् संश्लेषण का निःशुल्क उपयोग कर सकते हैं, इसलिए कृपया पहले इसे आज़माएँ।\n                \n                \n                    \n                        अभी टेक्स्ट को ऑडियो में बदलें\n                    \n                    \n                        मुफ्त में शुरू करें - पंजीकरण 1 मिनट में पूरा हो जाएगा\n                    \n                \n                \n                    \n                        \n                            \n                        \n                        \n                    \n                    \n                        टेक्स्ट-टू-स्पीच सॉफ्टवेयर \"ओंडोकू\" हर महीने एआई आवाज के साथ मुफ्त में 5000 अक्षरों को पढ़ सकता है।\n                        आप आसानी से MP3 डाउनलोड कर सकते हैं और व्यावसायिक उपयोग भी संभव है।\n                        यदि आप निःशुल्क साइन अप करते हैं, तो आप प्रति माह 5,000 अक्षरों तक को टेक्स्ट से स्पीच में निःशुल्क रूपांतरित कर सकते हैं।\n                        अभी ओन्डोकू आज़माएँ।\n                        \n                        HP:\n                            ondoku3.com\n                            \n                            Email: ondoku3.com@gmail.com\n                        \n                    \n\n                \n                \n                    \n                        ←पिछला लेख\n                    | \n                    अगला लेख→\n                \n                संबंधित लेख\n                \n                    \n                        \n                            \n                            \n                                \n                                    \n                                        \n                                    \n                                        टेक्स्ट-टू-स्पीच सॉफ़्टवेयर के 7 बेहतरीन विकल्प। व्यावसायिक उपयोग के लिए (मुफ़्त/सशुल्क)\n                                    \n                                        \n                                    \n                                \n                                \n                            \n                        \n                    \n                        \n                            \n                            \n                                \n                                    \n                                        \n                                    \n                                        टेक्स्ट-टू-स्पीच, Ondoku के अक्सर पूछे जाने वाले प्रश्न (FAQ)\n                                    \n                                        \n                                    \n                                \n                                \n                            \n                        \n                    \n                        \n                            \n                            \n                                \n                                    \n                                        \n                                    \n                                        Ondoku के वाचन में, अंतराल और खाली समय को समायोजित करने के तरीके 【2 प्रकार】\n                                    \n                                        \n                                    \n                                \n                                \n                            \n                        \n                    \n                        \n                            \n                            \n                                \n                                    \n                                        \n                                    \n                                        Ondoku को क्रेडिट देने का तरीका। उदाहरण और ध्यान देने योग्य बातें।\n                                    \n                                        \n                                    \n                                \n                                \n                            \n                        \n                    \n                        \n                            \n                            \n                                \n                                    \n                                        \n                                    \n                                        [मुफ़्त] Mac के लिए 4 मुफ़्त टेक्स्ट-टू-स्पीच सॉफ़्टवेयर\n                                    \n                                        \n                                    \n                                \n                                \n                            \n                        \n                    \n                        \n                            \n                            \n                                \n                                    \n                                        \n                                    \n                                        Ondoku की भुगतान विधियां (क्रेडिट कार्ड, डेबिट कार्ड, बैंक हस्तांतरण) और रसीदों के बारे में\n                                    \n                                        \n                                    \n                                \n                                \n                            \n                        \n                    \n                \n                \n\n            \n        \n        \n            \n                \n                    \n\n                \n            \n            \n                Ondoku\n            \n            \n                टेक्स्ट रीडिंग सॉफ्टवेयर ओन्डोकू। यह एक टेक्स्ट-टू-स्पीच सेवा है जिसका उपयोग बिना किसी इंस्टॉलेशन के मुफ्त में किया जा सकता है।\n                    यदि आप निःशुल्क पंजीकरण करते हैं, तो आप प्रत्येक माह 5000 अक्षर तक निःशुल्क प्राप्त कर सकते हैं।\n                    \nअभी मुफ्त में रजिस्टर करें\n                \n                \n            \n\n            मेन्यू\n            \n                Ondoku क्या है?\n                ओन्डोकू पर पाठ पढ़ें\n                \n\n                निःशुल्क पंजीकरण\n                मूल्य का रेखाचित्र\n                \n\n                लेखों की सूची\n                \n                    अन्य मुफ्त सेवाओं को भी आजमाएं\n            \n\n            नए लेख\n            \n                \n                    \n                        \n                            \n                                \n                                    \n                                \n                            \n                            Irodori-TTS क्या है? इसकी विशेषताएं और उपयोग का तरीका विस्तार से जानें\n                            \n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    \n                                \n                            \n                            वर्टिकल टेक्स्ट इमेज को पढ़ने का तरीका | Mojiokoshi-san से टेक्स्ट बनाकर Ondoku पर\n                            \n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    \n                                \n                            \n                            iPhone पर वीडियो में नैरेशन कैसे जोड़ें! सिर्फ iMovie काफी है\n                            \n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    \n                                \n                            \n                            Chrome रीडिंग मोड क्या है? PC पर उपयोग करने का तरीका और समाधान\n                            \n                        \n                    \n                \n                    \n                        \n                            \n                                \n                                    \n                                \n                            \n                            PDF को MP3 में बदलने के 2 तरीके | 文字起こしさん × Ondoku से मुफ्त ऑडियो\n                            \n                        \n                    \n                \n            \n            \n\nलोकप्रिय लेख\n\n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    टेक्स्ट-टू-स्पीच सॉफ़्टवेयर के 7 बेहतरीन विकल्प। व्यावसायिक उपयोग के लिए (मुफ़्त/सशुल्क)\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    टेक्स्ट-टू-स्पीच, Ondoku के अक्सर पूछे जाने वाले प्रश्न (FAQ)\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    Ondoku के वाचन में, अंतराल और खाली समय को समायोजित करने के तरीके 【2 प्रकार】\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    Ondoku को क्रेडिट देने का तरीका। उदाहरण और ध्यान देने योग्य बातें।\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    [मुफ़्त] Mac के लिए 4 मुफ़्त टेक्स्ट-टू-स्पीच सॉफ़्टवेयर\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    Ondoku की भुगतान विधियां (क्रेडिट कार्ड, डेबिट कार्ड, बैंक हस्तांतरण) और रसीदों के बारे में\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    [पेड वर्शन] टेक्स्ट-टू-स्पीच सॉफ्टवेयर का कमर्शियल उपयोग और YouTube लाइसेंस\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    टेक्स्ट-टू-स्पीच सॉफ़्टवेयर के साथ YouTube वीडियो नरेशन बनाने का तरीका और टिप्स।\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    अंग्रेजी उच्चारण सीखने के लिए बेहतरीन! मुफ़्त टेक्स्ट-टू-स्पीच सॉफ़्टवेयर के प्रभावी उपयोग।\n                    \n                \n            \n        \n    \n        \n            \n                \n                    \n                        \n                    \n                \n                \n                    PowerPoint जैसी स्लाइड और प्रेजेंटेशन में ऑडियो फाइलें शामिल करें। अनुशंसित सॉफ़्टवेयर और जोड़ने का तरीका\n                    \n                \n            \n        \n    \n\n        \n    \n\n    \n        \n            \n                \n                    \n\n                        \n                            \n                                ब्लॉग\n                            \n                            \n                                |\n                            \n                            \n                                सामान्य प्रश्न\n                            \n                            \n                                |\n                            \n                            \n                                फ़ीचर\n                            \n                            \n                                |\n                            \n                            \n                                जाँच करना\n                            \n\n                            \n                                |\n                            \n                            \n                                सेवा की शर्तें\n                            \n\n                            \n                                |\n                            \n                            \n                                गोपनीयता नीति\n                            \n                            \n                                |\n                            \n                            \n                                कुकी सेटिंग बदलें\n                            \n\n                            \n                                |\n                            \n                            \n                                निर्दिष्ट वाणिज्यिक लेनदेन कानून प्रदर्शन\n                            \n                            \n                                |\n                            \n                            \n                                अन्य मुफ्त AI बिजनेस टूल देखें\n                            \n                            \n                                &copy; 2026\n                                    Ondoku3. All Rights\n                                    Reserved.\n                            \n                        \n                    \n                \n\n                \n            \n        \n    \n    \n    \n        \n    \n\n\n\n\n\n\n\n\n\n\n\n\n\n    \n        \n            आपकी कुकी सहमति वापस ले ली गई है। आप फिर से चुन सकते हैं।\n            हम यह समझने के लिए कि हमारी साइट का उपयोग कैसे किया जाता है, Google Analytics के लिए कुकी का उपयोग करते हैं।\n            हमारी साइट कुकीज़ का उपयोग करती है। कुकीज़ के उपयोग के विवरण के लिए \"गोपनीयता नीति\" देखें।\n        \n        \n            OK\n            अस्वीकार करें\n        \n    \n\n\n    \n        \n    \n    स्क्रीन रिज़ॉल्यूशन 1400px से कम है",
