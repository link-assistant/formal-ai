{
  "type": "tool_use",
  "timestamp": 1789528825567,
  "sessionID": "ses_f57c53740ffesy100TRVnBYTJ2",
  "part": {
    "id": "prt_0a83ad8bb0017EwMP4OJ1sp6zz",
    "sessionID": "ses_f57c53740ffesy100TRVnBYTJ2",
