E;&#x93E;&#x924; &#x928;&#x939;&#x940;&#x902; &#x939;&#x948;, &#x932;&#x947;&#x915;&#x93F;&#x928; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x947; &#x905;&#x915;&#x94D;&#x938;&#x930; &#x927;&#x940;&#x930;&#x947;-&#x927;&#x940;&#x930;&#x947; &#x905;&#x930;&#x94D;&#x925; &#x92E;&#x947;&#x902; &#x92C;&#x926;&#x932;&#x93E;&#x935; &#x938;&#x947; &#x917;&#x941;&#x91C;&#x930;&#x924;&#x947; &#x939;&#x948;&#x902;&#x964;&#x926;&#x948;&#x928;&#x93F;&#x915; &#x935;&#x93E;&#x930;&#x94D;&#x924;&#x93E;&#x932;&#x93E;&#x92A; &#x92E;&#x947;&#x902; &#x909;&#x92A;&#x92F;&#x94B;&#x917;: &#x915;&#x908; &#x909;&#x926;&#x93E;&#x939;&#x930;&#x923;\n&#x92F;&#x939; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x93E; &#x915;&#x908; &#x935;&#x93E;&#x930;&#x94D;&#x924;&#x93E;&#x932;&#x93E;&#x92A;&#x94B;&#x902; &#x92E;&#x947;&#x902;, &#x914;&#x92A;&#x91A;&#x93E;&#x930;&#x93F;&#x915; &#x914;&#x930; &#x905;&#x928;&#x94C;&#x92A;&#x91A;&#x93E;&#x930;&#x93F;&#x915; &#x926;&#x94B;&#x928;&#x94B;&#x902; &#x92E;&#x947;&#x902;, &#x909;&#x92A;&#x92F;&#x94B;&#x917; &#x939;&#x94B;&#x924;&#x93E; &#x939;&#x948;&#x964; &#x92F;&#x939;&#x93E;&#x901; &#x915;&#x941;&#x91B; &#x909;&#x926;&#x93E;&#x939;&#x930;&#x923; &#x939;&#x948;&#x902;: 1. &#8216;I tried explaining the concept to him, but it went completely over his head.&#8217;(&#x92E;&#x948;&#x902;&#x928;&#x947; &#x909;&#x938;&#x947; &#x905;&#x935;&#x927;&#x93E;&#x930;&#x923;&#x93E; &#x938;&#x92E;&#x91D;&#x93E;&#x928;&#x947; &#x915;&#x940; &#x915;&#x94B;&#x936;&#x93F;&#x936; &#x915;&#x940;, &#x932;&#x947;&#x915;&#x93F;&#x928; &#x92F;&#x939; &#x92A;&#x942;&#x930;&#x940; &#x924;&#x930;&#x939; &#x938;&#x947; &#x909;&#x938;&#x915;&#x947; &#x938;&#x93F;&#x930; &#x915;&#x947; &#x90A;&#x92A;&#x930; &#x91A;&#x932;&#x93E; &#x917;&#x92F;&#x93E;&#x964;) 2. &#8216;The professor&#8217;s lecture was so advanced that it went over most of the students&#8217; heads.&#8217;(&#x92A;&#x94D;&#x930;&#x94B;&#x92B;&#x947;&#x938;&#x930; &#x915;&#x93E; &#x935;&#x94D;&#x92F;&#x93E;&#x916;&#x94D;&#x92F;&#x93E;&#x928; &#x907;&#x924;&#x928;&#x93E; &#x909;&#x928;&#x94D;&#x928;&#x924; &#x925;&#x93E; &#x915;&#x93F; &#x92F;&#x939; &#x905;&#x927;&#x93F;&#x915;&#x93E;&#x902;&#x936; &#x91B;&#x93E;&#x924;&#x94D;&#x930;&#x94B;&#x902; &#x915;&#x947; &#x938;&#x92E;&#x91D; &#x938;&#x947; &#x92C;&#x93E;&#x939;&#x930; &#x925;&#x93E;&#x964;) 3. &#8216;The technical jargon in the manual went over my head, so I sought help.&#8217;(&#x92E;&#x948;&#x928;&#x941;&#x905;&#x932; &#x915;&#x940; &#x924;&#x915;&#x928;&#x940;&#x915;&#x940; &#x92D;&#x93E;&#x937;&#x93E; &#x92E;&#x947;&#x930;&#x947; &#x938;&#x92E;&#x91D; &#x938;&#x947; &#x92C;&#x93E;&#x939;&#x930; &#x925;&#x940;, &#x907;&#x938;&#x932;&#x93F;&#x90F; &#x92E;&#x948;&#x902;&#x928;&#x947; &#x92E;&#x926;&#x926; &#x92E;&#x93E;&#x902;&#x917;&#x940;&#x964;) &#x92F;&#x947; &#x935;&#x93E;&#x915;&#x94D;&#x92F; &#x910;&#x938;&#x947; &#x939;&#x93E;&#x932;&#x93E;&#x924; &#x926;&#x930;&#x94D;&#x936;&#x93E;&#x924;&#x947; &#x939;&#x948;&#x902; &#x91C;&#x939;&#x93E;&#x901; &#x91C;&#x93E;&#x928;&#x915;&#x93E;&#x930;&#x940; &#x92F;&#x93E; &#x935;&#x93F;&#x91A;&#x93E;&#x930; &#x936;&#x94D;&#x930;&#x94B;&#x924;&#x93E; &#x915;&#x947; &#x932;&#x93F;&#x90F; &#x92C;&#x939;&#x941;&#x924; &#x91C;&#x91F;&#x93F;&#x932; &#x925;&#x93E;&#x964;\n&#x930;&#x942;&#x92A;&#x93E;&#x902;&#x924;&#x930;&#x923; &#x914;&#x930; &#x92A;&#x930;&#x94D;&#x92F;&#x93E;&#x92F;&#x935;&#x93E;&#x91A;&#x940;: &#x938;&#x92E;&#x93E;&#x928; &#x935;&#x93F;&#x91A;&#x93E;&#x930; &#x935;&#x94D;&#x92F;&#x915;&#x94D;&#x924; &#x915;&#x930;&#x928;&#x93E;\n&#x939;&#x93E;&#x932;&#x93E;&#x902;&#x915;&#x93F; &#8216;go over someone&#8217;s head&#8217; &#x90F;&#x915; &#x906;&#x92E; &#x909;&#x92A;&#x92F;&#x94B;&#x917; &#x935;&#x93E;&#x932;&#x93E; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x93E; &#x939;&#x948;, &#x910;&#x938;&#x947; &#x905;&#x928;&#x94D;&#x92F; &#x935;&#x93E;&#x915;&#x94D;&#x92F;&#x93E;&#x902;&#x936; &#x92D;&#x940; &#x939;&#x948;&#x902; &#x91C;&#x94B; &#x938;&#x92E;&#x93E;&#x928; &#x905;&#x930;&#x94D;&#x925; &#x935;&#x94D;&#x92F;&#x915;&#x94D;&#x924; &#x915;&#x930;&#x924;&#x947; &#x939;&#x948;&#x902;&#x964; &#x907;&#x928;&#x92E;&#x947;&#x902; &#x936;&#x93E;&#x92E;&#x93F;&#x932; &#x939;&#x948;&#x902; &#8216;be beyond someone&#8217;, &#8216;be over someone&#8217;s head&#8217;, &#x92F;&#x93E; &#8216;be too much for someone&#8217;&#x964; &#x92F;&#x947; &#x938;&#x92D;&#x940; &#x905;&#x92D;&#x93F;&#x935;&#x94D;&#x92F;&#x915;&#x94D;&#x924;&#x93F;&#x92F;&#x93E;&#x901; &#x92F;&#x939; &#x926;&#x930;&#x94D;&#x936;&#x93E;&#x924;&#x940; &#x939;&#x948;&#x902; &#x915;&#x93F; &#x915;&#x941;&#x91B; &#x92C;&#x939;&#x941;&#x924; &#x91C;&#x91F;&#x93F;&#x932; &#x92F;&#x93E; &#x938;&#x92E;&#x91D;&#x928;&#x947; &#x92E;&#x947;&#x902; &#x915;&#x920;&#x93F;&#x928; &#x939;&#x948;&#x964;&#x938;&#x902;&#x92C;&#x902;&#x927;&#x93F;&#x924; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x93E; &#x92A;&#x93E;&#x920;\n\n\n\n&#x907;&#x938; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x947; &#x938;&#x947; &#x938;&#x902;&#x92C;&#x902;&#x927;&#x93F;&#x924; &#x914;&#x930; &#x92A;&#x93E;&#x920; &#x938;&#x940;&#x916;&#x947;&#x902;: go over someones head:\n\n\n\n\nGo OverGo Over To The MajorityGo To Someones HeadGo Soak Your HeadGo A Long Way\n&#x928;&#x93F;&#x937;&#x94D;&#x915;&#x930;&#x94D;&#x937;: &#x92D;&#x93E;&#x937;&#x93E; &#x92E;&#x947;&#x902; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x94B;&#x902; &#x915;&#x940; &#x936;&#x915;&#x94D;&#x924;&#x93F;\n&#8216;Go Over Someone&#8217;s Head&#8217; &#x915;&#x940; &#x939;&#x92E;&#x93E;&#x930;&#x940; &#x916;&#x94B;&#x91C; &#x938;&#x92E;&#x93E;&#x92A;&#x94D;&#x924; &#x915;&#x930;&#x924;&#x947; &#x939;&#x941;&#x90F;, &#x939;&#x92E;&#x947;&#x902; &#x92F;&#x93E;&#x926; &#x906;&#x924;&#x93E; &#x939;&#x948; &#x915;&#x93F; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x947; &#x939;&#x92E;&#x93E;&#x930;&#x940; &#x92C;&#x93E;&#x924;&#x91A;&#x940;&#x924; &#x915;&#x94B; &#x915;&#x93F;&#x924;&#x928;&#x93E; &#x938;&#x92E;&#x943;&#x926;&#x94D;&#x927; &#x92C;&#x928;&#x93E;&#x924;&#x947; &#x939;&#x948;&#x902;&#x964; &#x92F;&#x947; &#x938;&#x93E;&#x902;&#x938;&#x94D;&#x915;&#x943;&#x924;&#x93F;&#x915; &#x938;&#x902;&#x926;&#x930;&#x94D;&#x92D;, &#x910;&#x924;&#x93F;&#x939;&#x93E;&#x938;&#x93F;&#x915; &#x92A;&#x943;&#x937;&#x94D;&#x920;&#x92D;&#x942;&#x92E;&#x93F; &#x914;&#x930; &#x938;&#x93E;&#x91D;&#x93E; &#x905;&#x928;&#x941;&#x92D;&#x935;&#x94B;&#x902; &#x915;&#x94B; &#x938;&#x92E;&#x947;&#x91F;&#x947; &#x939;&#x941;&#x90F; &#x939;&#x948;&#x902;&#x964; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x94B;&#x902; &#x915;&#x93E; &#x905;&#x927;&#x94D;&#x92F;&#x92F;&#x928; &#x915;&#x930;&#x915;&#x947; &#x939;&#x92E; &#x928; &#x915;&#x947;&#x935;&#x932; &#x905;&#x92A;&#x928;&#x940; &#x92D;&#x93E;&#x937;&#x93E; &#x915;&#x94C;&#x936;&#x932; &#x92C;&#x922;&#x93C;&#x93E;&#x924;&#x947; &#x939;&#x948;&#x902;, &#x92C;&#x932;&#x94D;&#x915;&#x93F; &#x92E;&#x93E;&#x928;&#x935; &#x938;&#x902;&#x91A;&#x93E;&#x930; &#x915;&#x947; &#x935;&#x93F;&#x935;&#x93F;&#x927; &#x92A;&#x939;&#x932;&#x941;&#x913;&#x902; &#x915;&#x94B; &#x92D;&#x940; &#x938;&#x92E;&#x91D;&#x924;&#x947; &#x939;&#x948;&#x902;&#x964; &#x924;&#x94B; &#x91A;&#x932;&#x93F;&#x90F;, &#x90F;&#x915;-&#x90F;&#x915; &#x92E;&#x941;&#x939;&#x93E;&#x935;&#x930;&#x947; &#x915;&#x947; &#x938;&#x93E;&#x925; &#x905;&#x92A;&#x928;&#x940; &#x92D;&#x93E;&#x937;&#x93E;&#x908; &#x92F;&#x93E;&#x924;&#x94D;&#x930;&#x93E; &#x91C;&#x93E;&#x930;&#x940; &#x930;&#x916;&#x947;&#x902;&#x964; &#x905;&#x917;&#x932;&#x940; &#x92C;&#x93E;&#x930; &#x924;&#x915;, &#x936;&#x941;&#x92D; &#x905;&#x927;&#x94D;&#x92F;&#x92F;&#x928;!\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n←Previous:  Go Over मुहावरा &#8211; अर्थ और वाक्यों में उदाहरण सहित उपयोग\n\nNext:  Go Over to the Majority मुहावरा &#8211; अर्थ और वाक्यों में उदाहरण उपयोग→\n\n\n\n\n\n\n\n\n\n\n\nनवीनतम पाठ\n\n\nType 2 conditional (दूसरा conditional) का सरल मार्गदर्शन\nSecond conditional sentences: क्या है, नियम और आसान उदाहरण\nConditional Sentences Type 2: