  "sessionID": "ses_f57c60de7fferRZM6u5B2FmYYC",
  "part": {
    "id": "prt_0a83a0f4d002Za5qvxgWVaXggs",
    "sessionID": "ses_f57c60de7fferRZM6u5B2FmYYC",
    "messageID": "msg_0a83a0d73001BDOn3KrFHgPYe3",
    "type": "tool",
    "callID": "call_d9a28b662fb1d7e9",
