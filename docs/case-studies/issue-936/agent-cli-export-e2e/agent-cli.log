    "text": "Created and verified `program_plan_rules.mjs` through the agentic CLI harness.\n\n```javascript\n// Generated JavaScript interop; substitution semantics remain in Rust/WASM.\n// Compile program_plan_rules_wasm.rs to a WebAssembly module before loading this file.\n\nexport async function instantiateSubstitution(wasmBytes) {\n  const { instance } = await WebAssembly.instantiate(wasmBytes, {});\n  return (input) => {\n    const bytes = new TextEncoder().encode(input);\n    if (bytes.length > instance.exports.input_capacity()) {\n      throw new Error(\"input exceeds WASM capacity\");\n    }\n    new Uint8Array(instance.exports.memory.buffer, instance.exports.input_ptr(), bytes.length).set(bytes);\n    const outputLength = instance.exports.run(bytes.length);\n    const output = new Uint8Array(\n      instance.exports.memory.buffer,\n      instance.exports.output_ptr(),\n      outputLength,\n    );\n    return new TextDecoder().decode(output);\n  };\n}\n\nif (typeof process !== \"undefined\" && process.release?.name === \"node\") {\n  const wasmPath = process.argv[2];\n  if (!wasmPath) throw new Error(\"usage: node INTEROP.mjs PROGRAM.wasm\");\n  const { readFile } = await import(\"node:fs/promises\");\n  const chunks = [];\n  for await (const chunk of process.stdin) chunks.push(chunk);\n  const runSubstitution = await instantiateSubstitution(await readFile(wasmPath));\n  process.stdout.write(runSubstitution(Buffer.concat(chunks).toString(\"utf8\")));\n}\n\n```\n\nCommands executed by the harness:\n\n`program_plan_rules_wasm.rs`\n\n```text\n// Generated by Formal AI's Rust-owned substitution compiler.\n#![no_std]\n\nextern crate alloc;\n\nuse alloc::borrow::ToOwned as _;\nuse alloc::collections::{BTreeMap, BTreeSet};\nuse alloc::format;\nuse alloc::string::String;\nuse core::alloc::{GlobalAlloc, Layout};\nuse core::cell::UnsafeCell;\nuse core::fmt::Write as _;\nuse core::sync::atomic::{AtomicUsize, Ordering};\n\nconst INPUT_CAPACITY: usize = 65_536;\nconst OUTPUT_CAPACITY: usize = 65_536;\nconst HEAP_CAPACITY: usize = 2_097_152;\n\nstatic mut INPUT: [u8; INPUT_CAPACITY] = [0; INPUT_CAPACITY];\nstatic mut OUTPUT: [u8; OUTPUT_CAPACITY] = [0; OUTPUT_CAPACITY];\n\nstruct Heap { buffer: UnsafeCell<[u8; HEAP_CAPACITY]> }\nunsafe impl Sync for Heap {}\nstatic HEAP: Heap = Heap { buffer: UnsafeCell::new([0; HEAP_CAPACITY]) };\nstatic OFFSET: AtomicUsize = AtomicUsize::new(0);\nstruct Allocator;\n\nunsafe impl GlobalAlloc for Allocator {\n    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {\n        let base = HEAP.buffer.get() as usize;\n        loop {\n            let current = OFFSET.load(Ordering::Relaxed);\n            let address = (base + current + layout.align() - 1) & !(layout.align() - 1);\n            let next = address - base + layout.size();\n            if next > HEAP_CAPACITY { return core::ptr::null_mut(); }\n            if OFFSET.compare_exchange(current, next, Ordering::AcqRel, Ordering::Relaxed).is_ok() {\n                return address as *mut u8;\n            }\n        }\n    }\n    unsafe fn dealloc(&self, _pointer: *mut u8, _layout: Layout) {}\n}\n\n#[global_allocator]\nstatic ALLOCATOR: Allocator = Allocator;\n\n#[panic_handler]\nfn panic(_info: &core::panic::PanicInfo<'_>) -> ! { loop {} }\n\nconst MAX_APPLICATIONS: usize = 64;\n\n#[allow(dead_code)]\n#[derive(Clone, Copy)]\nenum Node {\n    Literal(&'static str),\n    Variable(&'static str),\n    PrefixVariable(&'static str, &'static str),\n}\n\n#[derive(Clone, Copy)]\nstruct Pattern {\n    from: Node,\n    to: Node,\n}\n\nstruct Action {\n    remove: Pattern,\n    add: &'static [Pattern],\n}\n\nstruct Rule {\n    conditions: &'static [Pattern],\n    actions: &'static [Action],\n}\n\ntype Link = (String, String);\ntype Bindings = BTreeMap<String, String>;\n\nfn bind(bindings: &mut Bindings, name: &str, value: &str) -> bool {\n    if let Some(bound) = bindings.get(name) {\n        bound == value\n    } else {\n        bindings.insert(name.to_owned(), value.to_owned());\n        true\n    }\n}\n\nfn match_node(pattern: Node, value: &str, bindings: &mut Bindings) -> bool {\n    match pattern {\n        Node::Literal(literal) => literal == value,\n        Node::Variable(name) => bind(bindings, name, value),\n        Node::PrefixVariable(prefix, name) => value\n            .strip_prefix(prefix)\n            .is_some_and(|suffix| bind(bindings, name, suffix)),\n    }\n}\n\nfn match_pattern(pattern: Pattern, link: &Link, bindings: &mut Bindings) -> bool {\n    match_node(pattern.from, &link.0, bindings)\n        && match_node(pattern.to, &link.1, bindings)\n}\n\nfn find_bindings(\n    patterns: &[Pattern],\n    links: &BTreeSet<Link>,\n    bindings: Bindings,\n) -> Option<Bindings> {\n    let Some((pattern, remaining)) = patterns.split_first() else {\n        return Some(bindings);\n    };\n    for link in links {\n        let mut candidate = bindings.clone();\n        if match_pattern(*pattern, link, &mut candidate) {\n            if let Some(found) = find_bindings(remaining, links, candidate) {\n                return Some(found);\n            }\n        }\n    }\n    None\n}\n\nfn instantiate_node(node: Node, bindings: &Bindings) -> Option<String> {\n    match node {\n        Node::Literal(value) => Some(value.to_owned()),\n        Node::Variable(name) => bindings.get(name).cloned(),\n        Node::PrefixVariable(prefix, name) => bindings.get(name).map(|value| format!(\"{prefix}{value}\")),\n    }\n}\n\nfn instantiate(pattern: Pattern, bindings: &Bindings) -> Option<Link> {\n    Some((\n        instantiate_node(pattern.from, bindings)?,\n        instantiate_node(pattern.to, bindings)?,\n    ))\n}\n\nfn apply_rule(rule: &Rule, links: &mut BTreeSet<Link>) -> bool {\n    let mut required = rule.conditions.to_vec();\n    required.extend(rule.actions.iter().map(|action| action.remove));\n    let Some(bindings) = find_bindings(&required, links, Bindings::new()) else {\n        return false;\n    };\n    let before = links.clone();\n    for action in rule.actions {\n        let Some(remove) = instantiate(action.remove, &bindings) else {\n            return false;\n        };\n        links.remove(&remove);\n        for add in action.add {\n            let Some(link) = instantiate(*add, &bindings) else {\n                return false;\n            };\n            links.insert(link);\n        }\n    }\n    *links != before\n}\n\nfn transform(input: &str) -> String {\n    let mut links: BTreeSet<Link> = input\n        .lines()\n        .filter_map(|line| line.split_once('\\t'))\n        .map(|(from, to)| (from.to_owned(), to.to_owned()))\n        .collect();\n    for _ in 0..MAX_APPLICATIONS {\n        let Some(rule) = RULES.iter().find(|rule| apply_rule(rule, &mut links)) else {\n            break;\n        };\n        let _ = rule;\n    }\n    let mut output = String::new();\n    for (from, to) in links {\n        let _ = writeln!(output, \"{from}\\t{to}\");\n    }\n    output\n}\nstatic RULES: &[Rule] = &[\n    Rule { conditions: &[\n        Pattern { from: Node::Literal(\"request:modifier\"), to: Node::Literal(\"path_argument\") },\n    ], actions: &[\n        Action { remove: Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files\") }, add: &[\n            Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_arg\") },\n        ] },\n    ] },\n    Rule { conditions: &[\n        Pattern { from: Node::Literal(\"request:modifier\"), to: Node::Literal(\"path_argument\") },\n    ], actions: &[\n        Action { remove: Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_reverse_sort\") }, add: &[\n            Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_arg_reverse_sort\") },\n        ] },\n    ] },\n    Rule { conditions: &[\n        Pattern { from: Node::Literal(\"request:modifier\"), to: Node::Literal(\"cancel_reverse_sort\") },\n    ], actions: &[\n        Action { remove: Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_reverse_sort\") }, add: &[\n            Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files\") },\n        ] },\n    ] },\n    Rule { conditions: &[\n        Pattern { from: Node::Literal(\"request:modifier\"), to: Node::Literal(\"cancel_reverse_sort\") },\n    ], actions: &[\n        Action { remove: Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_arg_reverse_sort\") }, add: &[\n            Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_arg\") },\n        ] },\n    ] },\n    Rule { conditions: &[\n        Pattern { from: Node::Literal(\"request:modifier\"), to: Node::Literal(\"reverse_sort\") },\n    ], actions: &[\n        Action { remove: Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files\") }, add: &[\n            Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_reverse_sort\") },\n        ] },\n    ] },\n    Rule { conditions: &[\n        Pattern { from: Node::Literal(\"request:modifier\"), to: Node::Literal(\"reverse_sort\") },\n    ], actions: &[\n        Action { remove: Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_arg\") }, add: &[\n            Pattern { from: Node::Literal(\"request:task\"), to: Node::Literal(\"list_files_arg_reverse_sort\") },\n        ] },\n    ] },\n];\n\n#[no_mangle]\npub extern \"C\" fn input_ptr() -> *mut u8 { core::ptr::addr_of_mut!(INPUT).cast::<u8>() }\n\n#[no_mangle]\npub extern \"C\" fn output_ptr() -> *mut u8 { core::ptr::addr_of_mut!(OUTPUT).cast::<u8>() }\n\n#[no_mangle]\npub extern \"C\" fn input_capacity() -> usize { INPUT_CAPACITY }\n\n#[no_mangle]\npub extern \"C\" fn run(length: usize) -> usize {\n    OFFSET.store(0, Ordering::Release);\n    let length = length.min(INPUT_CAPACITY);\n    let bytes = unsafe { core::slice::from_raw_parts(core::ptr::addr_of!(INPUT).cast::<u8>(), length) };\n    let Ok(input) = core::str::from_utf8(bytes) else { return 0; };\n    let output = transform(input);\n    let length = output.len().min(OUTPUT_CAPACITY);\n    unsafe {\n        core::ptr::copy_nonoverlapping(output.as_ptr(), core::ptr::addr_of_mut!(OUTPUT).cast::<u8>(), length);\n    }\n    length\n}\n\n```\n\n`program_plan_rules.substitution-ir.json`\n\n```text\n{\n  \"id\": \"program_plan_rules\",\n  \"max_applications\": 64,\n  \"rules\": [\n    {\n      \"id\": \"path_argument_list_files\",\n      \"order\": 10,\n      \"manual\": true,\n      \"conditions\": [\n        {\n          \"from\": {\n            \"kind\": \"literal\",\n            \"value\": \"request:modifier\"\n          },\n          \"to\": {\n            \"kind\": \"literal\",\n            \"value\": \"path_argument\"\n          }\n        }\n      ],\n      \"actions\": [\n        {\n          \"remove\": {\n            \"from\": {\n              \"kind\": \"literal\",\n              \"value\": \"request:task\"\n            },\n            \"to\": {\n              \"kind\": \"literal\",\n              \"value\": \"list_files\"\n            }\n          },\n          \"add\": [\n            {\n              \"from\": {\n                \"kind\": \"literal\",\n                \"value\": \"request:task\"\n              },\n              \"to\": {\n                \"kind\": \"literal\",\n                \"value\": \"list_files_arg\"\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"path_argument_list_files_reverse_sort\",\n      \"order\": 10,\n      \"manual\": true,\n      \"conditions\": [\n        {\n          \"from\": {\n            \"kind\": \"literal\",\n            \"value\": \"request:modifier\"\n          },\n          \"to\": {\n            \"kind\": \"literal\",\n            \"value\": \"path_argument\"\n          }\n        }\n      ],\n      \"actions\": [\n        {\n          \"remove\": {\n            \"from\": {\n              \"kind\": \"literal\",\n              \"value\": \"request:task\"\n            },\n            \"to\": {\n              \"kind\": \"literal\",\n              \"value\": \"list_files_reverse_sort\"\n            }\n          },\n          \"add\": [\n            {\n              \"from\": {\n                \"kind\": \"literal\",\n                \"value\": \"request:task\"\n              },\n              \"to\": {\n                \"kind\": \"literal\",\n                \"value\": \"list_files_arg_reverse_sort\"\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"cancel_reverse_sort__reverse_sort_list_files\",\n      \"order\": 20,\n      \"manual\": true,\n      \"conditions\": [\n        {\n          \"from\": {\n            \"kind\": \"literal\",\n            \"value\": \"request:modifier\"\n          },\n          \"to\": {\n            \"kind\": \"literal\",\n            \"value\": \"cancel_reverse_sort\"\n          }\n        }\n      ],\n      \"actions\": [\n        {\n          \"remove\": {\n            \"from\": {\n              \"kind\": \"literal\",\n              \"value\": \"request:task\"\n            },\n            \"to\": {\n              \"kind\": \"literal\",\n              \"value\": \"list_files_reverse_sort\"\n            }\n          },\n          \"add\": [\n            {\n              \"from\": {\n                \"kind\": \"literal\",\n                \"value\": \"request:task\"\n              },\n              \"to\": {\n                \"kind\": \"literal\",\n                \"value\": \"list_files\"\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"cancel_reverse_sort__reverse_sort_list_files_arg\",\n      \"order\": 20,\n      \"manual\": true,\n      \"conditions\": [\n        {\n          \"from\": {\n            \"kind\": \"literal\",\n            \"value\": \"request:modifier\"\n          },\n          \"to\": {\n            \"kind\": \"literal\",\n            \"value\": \"cancel_reverse_sort\"\n          }\n        }\n      ],\n      \"actions\": [\n        {\n          \"remove\": {\n            \"from\": {\n              \"kind\": \"literal\",\n              \"value\": \"request:task\"\n            },\n            \"to\": {\n              \"kind\": \"literal\",\n              \"value\": \"list_files_arg_reverse_sort\"\n            }\n          },\n          \"add\": [\n            {\n              \"from\": {\n                \"kind\": \"literal\",\n                \"value\": \"request:task\"\n              },\n              \"to\": {\n                \"kind\": \"literal\",\n                \"value\": \"list_files_arg\"\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"reverse_sort_list_files\",\n      \"order\": 20,\n      \"manual\": true,\n      \"conditions\": [\n        {\n          \"from\": {\n            \"kind\": \"literal\",\n            \"value\": \"request:modifier\"\n          },\n          \"to\": {\n            \"kind\": \"literal\",\n            \"value\": \"reverse_sort\"\n          }\n        }\n      ],\n      \"actions\": [\n        {\n          \"remove\": {\n            \"from\": {\n              \"kind\": \"literal\",\n              \"value\": \"request:task\"\n            },\n            \"to\": {\n              \"kind\": \"literal\",\n              \"value\": \"list_files\"\n            }\n          },\n          \"add\": [\n            {\n              \"from\": {\n                \"kind\": \"literal\",\n                \"value\": \"request:task\"\n              },\n              \"to\": {\n                \"kind\": \"literal\",\n                \"value\": \"list_files_reverse_sort\"\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"reverse_sort_list_files_arg\",\n      \"order\": 20,\n      \"manual\": true,\n      \"conditions\": [\n        {\n          \"from\": {\n            \"kind\": \"literal\",\n            \"value\": \"request:modifier\"\n          },\n          \"to\": {\n            \"kind\": \"literal\",\n            \"value\": \"reverse_sort\"\n          }\n        }\n      ],\n      \"actions\": [\n        {\n          \"remove\": {\n            \"from\": {\n              \"kind\": \"literal\",\n              \"value\": \"request:task\"\n            },\n            \"to\": {\n              \"kind\": \"literal\",\n              \"value\": \"list_files_arg\"\n            }\n          },\n          \"add\": [\n            {\n              \"from\": {\n                \"kind\": \"literal\",\n                \"value\": \"request:task\"\n              },\n              \"to\": {\n                \"kind\": \"literal\",\n                \"value\": \"list_files_arg_reverse_sort\"\n              }\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}\n```\n\n`input.tsv`\n\n```text\nrequest:modifier\treverse_sort\nrequest:task\tlist_files\n\n```\n- `rustup target add wasm32-unknown-unknown`\n- `rustc --edition=2021 --target wasm32-unknown-unknown --crate-type cdylib -C panic=abort program_plan_rules_wasm.rs -o program_plan_rules.wasm`\n- `node program_plan_rules.mjs program_plan_rules.wasm < input.tsv`\n\nActual tool output:\n\n```text\nrequest:modifier\treverse_sort\nrequest:task\tlist_files_reverse_sort\n```",
