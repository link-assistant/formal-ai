00924|         \"I can run `{command}` when the client advertises a shell tool such as `bash`, `shell`, or `run_command`.\"\n00925|     ))\n00926| }\n00927| \n00928| pub(super) fn plan_one(tool: &str, arguments: String) -> AgenticPlan {\n00929|     AgenticPlan::ToolCalls(vec![PlannedToolCall {\n00930|         tool: tool.to_owned(),\n00931|         arguments,\n00932|     }])\n00933| }\n00934| \n00935| /// Arguments for a write step that satisfy whichever key the advertised write\n00936| /// tool expects. Agentic CLIs disagree on the parameter name — the in-repo driver\n00937| /// reads `path`, the `@link-assistant/agent` CLI's `write` tool wants `filePath`,\n00938| /// others use `file_path`. All are emitted; a schema-validating CLI keeps the one\n00939| /// it declared and strips the rest, so the same plan drives any of them without a\n00940| /// per-CLI special case.\n00941| pub(super) fn write_arguments(path: &str, content: &str) -> String {\n00942|     json!({\n00943|         \"path\": path,\n00944|         \"filePath\": path,\n00945|         \"file_path\": path,\n00946|         \"content\": content,\n00947|     })\n00948|     .to_string()\n00949| }\n00950| \n00951| /// Arguments for a fetch step. Emits `url` (the universal key) plus `format`\n00952| /// set to `\"text\"` — the `@link-assistant/agent` CLI's `webfetch` tool declares\n00953| /// a required `format` enum (`\"text\" | \"markdown\" | \"html\"`) and zod refuses the\n00954| /// call otherwise (observed live: *\"Invalid option: expected one of\n00955| /// \\\"text\\\"|\\\"markdown\\\"|\\\"html\\\"\"*). The in-repo driver reads only `url`, and\n00956| /// CLIs whose schemas don't declare `format` strip it, so one shape drives all\n00957| /// of them without a per-CLI special case.\n00958| pub(super) fn fetch_arguments(url: &str) -> String {\n00959|     json!({\n00960|         \"url\": url,\n00961|         \"format\": \"text\",\n00962|     })\n00963|     .to_string()\n00964| }\n00965| \n00966| /// The seed