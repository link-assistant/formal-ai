he planner (to pick which advertised tool to call for each recipe step) and\n00092| /// the server's permission gate (to decide whether an agentic client may drive a\n00093| /// tool of this kind) classify tool names through [`tool_capability`] — so the\n00094| /// two never drift and no per-tool-name special cases accumulate.\n00095| #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n00096| pub enum Capability {\n00097|     Search,\n00098|     Fetch,\n00099|     Read,\n00100|     Write,\n00101|     Edit,\n00102|     Run,\n00103|     Grep,\n00104|     Glob,\n00105|     ListDir,\n00106|     Todo,\n00107|     Subagent,\n00108|     ReadMany,\n00109|     MultiEdit,\n00110|     AskUser,\n00111| }\n00112| \n00113| impl Capability {\n00114|     /// The associative-package capability key that grants an agentic client the\n00115|     /// right to drive a tool of this kind, e.g. `tool:capability:write`. Grants\n00116|     /// are by *capability class*, not by tool name, so any CLI's naming\n00117|     /// (`write`, `write_file`, `edit`, `patch`, …) maps to the same permission.\n00118|     #[must_use]\n00119|     pub const fn permission_key(self) -> &'static str {\n00120|         match self {\n00121|             Self::Search => \"tool:capability:search\",\n00122|             Self::Fetch => \"tool:capability:fetch\",\n00123|             Self::Read => \"tool:capability:read\",\n00124|             Self::Write => \"tool:capability:write\",\n00125|             Self::Edit => \"tool:capability:edit\",\n00126|             Self::Run => \"tool:capability:run\",\n00127|             Self::Grep => \"tool:capability:grep\",\n00128|             Self::Glob => \"tool:capability:glob\",\n00129|             Self::ListDir => \"tool:capability:list_dir\",\n00130|             Self::Todo => \"tool:capability:todo\",\n00131|             Self::Subagent => \"tool:capability:subagent\",\n00132|             Self::ReadMany => \"tool:capability:read_many\",\n00133|             Self::MultiEdit => \"tool:capability:multi_edit\",\n00134|             Self::AskUser => \"tool:capability:ask_user\",\n00135|         }\n00136|     }\n00137| \n00138|     pub(super) const fn registry_id(self) -> &'static str {\n00139|         match self {\n00140|             Self::Search => \"web_search\",\n00141|             Self::Fetch => \"web_fetch\",\n00142|             Self::Read => \"read_file\",\n00143|             Self::Write => \"write_file\",\n00144|             Self::Edit => \"edit_file\",\n00145|             Self::Run => \"shell\",\n00146|             Self::Grep => \"grep\",\n00147|             Self::Glob => \"glob\",\n00148|             Self::ListDir => \"list_dir\",\n00149|             Self::Todo => \"todo\",\n00150|             Self::Subagent => \"subagent\",\n00151|             Self::ReadMany => \"read_many\",\n00152|             Self::MultiEdit => \"multi_edit\",\n00153|             Self::AskUser => \"ask_user\",\n00154|         }\n00155|     }\n00156| }\n00157| \n00158| /// Classify an advertised tool name into the [`Capability`] it provides.\n00159| ///\n00160| /// Returns [`None`] when the planner's recipe has no use for it\n00161| /// (list/grep/todo/…). Public so the permission gate classifies through the\n00162| /// *same* function the planner uses.\n00163| #[must_use]\n00164| pub fn tool_capability(name: &str) -> Option<Capability> {\n00165|     capability_router::classify_tool(name)\n00166| }\n00167| \n00168| /// Plan the next agentic step from the conversation and advertised tools.\n00169| /// Returns [`None`] when neither a stored recipe nor a safe general plan applies.\n00170| #[must_use]\n00171| pub fn plan_chat_step(messages: &[ChatMessage], tool_names: &[&str]) -> Option<AgenticPlan> {\n00172|     let received = crate::protocol::latest_user_request(messages)?;\n00173|     // A harness prompt that quotes the task to have it summarized is answered\n00174|     // with the summary, never by doing the task again (issue #1133).\n00175|     if let Some(summary) = harness_envelope::summarize_request(&received) {\n00176|         return Some(AgenticPlan::Final(summary));\n00177|     }\n00178|     // A restart over prepared work (changed paths plus a pull request link)\n00179|     // is the whole turn's shape, not one arm of the precedence cascade: it is\n00180|     // decided on the same effective request the cascade reads, ahead of it,\n00181|     // and its plan still passes the repeated-call and repeated-failure stops.\n00182|     let effective = continued_agent_task(messages, &received);\n00183|     let restart = super::restart_feedback::plan_restart(\n00184|         effective.as_deref().unwrap_or(&received),\n00185|         messages,\n00186|         tool_names,\n00187|     );\n00188|     let plan = restart.or_else(|| plan_chat_step_routes(messages, tool_names, received))?;\n00189|     Some(stop_repeated_failure(\n00190|         stop_repeated_call(plan, messages),\n00191|         messages,\n00192|     ))\n00193| }\n00194| \n00195| /// A tool call this turn already completed is not a plan again (issue #1154).\n00196| ///\n00197| /// Independent of any argument parsing: whatever keys a client names its\n00198| /// arguments by, a stateless planner that re-derives a call whose result is\n00199| /// already in the transcript ignored that result. The Codex Rust run planned\n00200| /// the identical `gh issue view` 78 times over 6.2M input tokens because the\n00201| /// read's accounting could not see the `cmd` key; this stop would have ended\n00202| /// the loop on the second attempt whatever the parser did. The repeat is\n00203| /// answered by reporting the stuck step and its last result.\n00204| fn stop_repeated_call(plan: AgenticPlan, messages: &[ChatMessage]) -> AgenticPlan {\n00205|     let AgenticPlan::ToolCalls(calls) = &plan else {\n00206|         return plan;\n00207|     };\n00208|     let progress = Progress::scan(messages);\n00209|     let Some((repeated, attempt)) = calls\n00210|         .iter()\n00211|         .find_map(|call| progress.repeated_call(call).map(|attempt| (call, attempt)))\n00212|     else {\n00213|         return plan;\n00214|     };\n00215|     AgenticPlan::Final(super::work_item_steps::fill(\n00216|         \"stuck_step_report\",\n00217|         &[\n00218|             (\n00219|                 \"{step}\",\n00220|                 &format!(\"{} {}\", repeated.tool, repeated.arguments),\n00221|             ),\n00222|             (\"{result}\", attempt.detail.trim()),\n00223|         ],\n00224|     ))\n00225| }\n00226| \n00227| /// A tool call that has already failed twice this turn with the same report\n00228| /// is not a plan; the third attempt is replaced by the report of the failure.\n00229| ///\n00230| /// Issue #1133: the Kotlin run planned `mcp__playwright__browser_click` 547\n00231| /// times, each answered by the same selector error, until the context window\n00232| /// overflowed. No route knows it is looping -- each re-derives the same next\n00233| /// step from the same transcript -- so the stop is applied to whatever any\n00234| /// route planned.\n00235| fn stop_repeated_failure(plan: AgenticPlan, messages: &[ChatMessage]) -> AgenticPlan {\n00236|     const REPEATED_FAILURES_THAT_STOP: usize = 2;\n00237|     let AgenticPlan::ToolCalls(calls) = &plan else {\n00238|         return plan;\n00239|     };\n00240|     let progress = Progress::scan(messages);\n00241|     let Some(repeated) = calls\n00242|         .iter()\n00243|         .find(|call| progress.identical_failures_of(&call.tool) >= REPEATED_FAILURES_THAT_STOP)\n00244|     else {\n00245|         return plan;\n00246|     };\n00247|     let Some(failure) = progress.latest_failure_of_tool(&repeated.tool) else {\n00248|         return plan;\n00249|     };\n00250|     let prompt = crate::protocol::latest_user_request(messages).unwrap_or_default();\n00251|     AgenticPlan::Final(tool_result::render_failure(\n00252|         &repeated.tool,\n00253|         &failure.detail,\n00254|         &prompt,\n00255|     ))\n00256| }\n00257| \n00258| fn plan_chat_step_routes(\n00259|     messages: &[ChatMessage],\n00260|     tool_names: &[&str],\n00261|     received: String,\n00262| ) -> Option<AgenticPlan> {\n00263|     // Load-time precedence join (plan 10 leaf 18): first plan step of a run\n00264|     // proves the seed still names the cascade this function is about to walk.\n00265|     checked_route_precedence();\n00266|     trace_route(\"agentic_received\", &received);\n00267|     // Agent compacts a long tool loop by asking the model to summarize it, then\n00268|     // starts the next request with the protocol turn \"Continue if you have next\n00269|     // steps\". The work is still present, but only inside the assistant's\n00270|     // `Conversation summary:` envelope. Treating the protocol turn as a fresh\n00271|     // request loses that work and sends the sentence itself to web search.\n00272|     // Recover only our own summary envelope, immediately before the exact\n00273|     // continuation turn; ordinary user requests that happen to say \"continue\"\n00274|     // keep their normal meaning.\n00275|     let effective = continued_agent_task(messages, &received).unwrap_or(received);\n00276|     // An *unmarked* harness preamble is still the caller talking (issue #907,\n00277|     // follow-up). `<session_context>`-style markup is stripped upstream in\n00278|     // `crate::protocol`, but Hive Mind's adapters concatenated their workflow\n00279|     // policy and the objective into one untagged user message, so the tell has\n00280|     // to be the objective delimiter the caller wrote instead of a tag:\n00281|     // everything before a line-anchored `Issue to solve:` / `Task:` / `Goal:`\n00282|     // lead is the caller's framing, and only the text after it is the request.\n00283|     //\n00284|     // Routing the whole message let the preamble win: \"When running sudo\n00285|     // commands, run them in the background.\" paired a run verb with the `sudo`\n00286|     // shell token and planned bare `sudo`, and \"Your prepared working\n00287|     // directory: …\" planned `pwd`, in both cases dropping the repository work\n00288|     // that followed. The general planner already read the objective this way\n00289|     // (issue #904); every other route now reads it the same way, so one\n00290|     // boundary serves the whole router rather than one recipe.\n00291|     let task = objective_text(&effective).to_owned();\n00292|     trace_route(\"agentic_task\", &task);\n00293|     // A bare continuation cue with nothing to resume is still the cue here,\n00294|     // and the `agentic_continuation` conversation handler answers it; the\n00295|     // words of the cue are never a request (issue #1095).\n00296|     if crate::rule_interpreter::handler_matches(\"conversation_control\", &task)\n00297|         || is_continuation_cue(&task)\n00298|         // An edit request's block is its payload: a `when … then` inside it is\n00299|         // text being written, not a skill being taught (PR #1188 T57).\n00300|         || looks_like_skill_description(super::positional_edit::own_text(&task))\n00301|     {\n00302|         return None;\n00303|     }\n00304|     // Issue #707: seed-defined computer-use plans own their exact multilingual\n00305|     // prompts before broad write/search routing. Each emitted primitive carries\n00306|     // explicit pre/postconditions and is executed by the advertising client.\n00307|     // Ahead of them, quotes that do not pair leave no telling the quoted text\n00308|     // from the instruction, so the request is declined before any arm reads its\n00309|     // payload as words to act on (PR #1188 G71).\n00310|     if let Some(plan) = super::quote_nesting::request_fault_answer(&task)\n00311|         .or_else(|| crate::computer_use::plan_agentic_step(messages, tool_names))\n00312|     {\n00313|         return Some(plan);\n00314|     }\n00315|     // An explicit exact-content marker makes the following bytes authoritative.\n00316|     // Claim this narrow shape before edit/source semantics inspect the payload:\n00317|     // literal bytes may themselves say \"rename X to Y\" (issue #708). Broader\n00318|     // file-write requests remain below the semantic coding routes.\n00319|     if has_authoritative_literal_write(&task)\n00320|         && let Some(plan) = capability_router::workspace_creation_tool(tool_names)\n00321|             .and_then(|_| compose_general_change_plan(&task))\n00322|             .map(|plan| plan_general_change_step(messages, tool_names, &plan))\n00323|     {\n00324|         return Some(plan);\n00325|     }\n00326|     // Bind a program's semantic operands before treating its source path as a\n00327|     // destination for a report about the rest of the request.\n00328|     if let Some(mut answer) =\n00329|         crate::coding::program_contract::answer(&task, &mut crate::event_log::EventLog::default())\n00330|     {\n00331|         if let Some(recipe) = answer.execution_recipe.as_mut()\n00332|             && super::ci_workflow::requested_in(&task)\n00333|         {\n00334|             super::ci_workflow::attach(recipe);\n00335|         }\n00336|         if let Some(plan) =\n00337|             super::command_reroute::plan_symbolic_command_reroute(messages, tool_names, &answer)\n00338|         {\n00339|             return Some(plan);\n00340|         }\n00341|     }\n00342|     // \"Find this out and leave the answer in FILE\" (issue #1066). This sits ahead\n00343|     // of every route that reads a request's lone file-shaped token, because that\n00344|     // token is the *destination* here and opening it for reading ends the run with\n00345|     // the evidence file unwritten. It sits behind the literal-write routes above,\n00346|     // which own a request that spells its bytes out; this one owns the request\n00347|     // whose bytes still have to be found.\n00348|     //\n00349|     // It sits ahead of the change routes below for the same reason it sits ahead\n00350|     // of the readers: a request can carry both halves. The ladder's leaf says\n00351|     // \"Edit `src/engine_responses.rs` … Then create `agent-ladder-effects/…lino`\n00352|     // recording what you changed. Leave evidence in `.agent-ladder/…-proof.md`\",\n00353|     // and the change routes answer `Final` for the whole request the moment the\n00354|     // edit lands, so the two records the caller verifies are never written and\n00355|     // the node fails `missing_proof` having done the work. This route peels one\n00356|     // delivery at a time and re-plans the residual (see `parse_obligation`), so\n00357|     // the change route still receives the edit -- with only the edit left in it.\n00358|     if let Some(plan) = evidence_record::plan_evidence_record_step(&task, messages, tool_names) {\n00359|         return Some(plan);\n00360|     }\n00361|     plan_settled_routes(&task, messages, tool_names)\n00362| }\n00363| \n00364| /// Every route below the delivery peeling above, as one function.\n00365| ///\n00366| /// [`plan_evidence_record_step`](evidence_record::plan_evidence_record_step)\n00367| /// peels a named destination off a request and re-plans the remainder, and that\n00368| /// is only ever the right reading when the destination is not already some\n00369| /// other route's whole answer. A registered recipe *is* named by its artifact —\n00370| /// `learning_report::route` matches a prompt precisely by finding its own\n00371| /// `path` in it — so peeling that path off leaves a residual that no longer\n00372| /// reaches the recipe, and the request is answered by whatever the remainder\n00373| /// happens to look like instead.\n00374| ///\n00375| /// Splitting the tail out lets the peeling ask the question directly: plan the\n00376| /// *whole* request through the routes below and see whether one of them writes\n00377| /// the file. Nothing here re-enters the peeling, so asking cannot recurse.\n00378| pub(super) fn plan_settled_routes(\n00379|     task: &str,\n00380|     messages: &[ChatMessage],\n00381|     tool_names: &[&str],\n00382| ) -> Option<AgenticPlan> {\n00383|     // A request to commit what is already in the tree is one shell step. It\n00384|     // is claimed first because its words (\"review these changes and commit\n00385|     // them\", with a `?? Main.scala` listing) read to later routes as a search\n00386|     // for the file; the route itself declines any request that also names the\n00387|     // work to do (issue #1133).\n00388|     if let Some(plan) = git_commit::plan_commit_step(task, messages, tool_names) {\n00389|         return Some(plan);\n00390|     }\n00391|     // A learned workspace-change procedure owns grounded repository rewrites\n00392|     // and multi-file compositions before source creation or shell routing can\n00393|     // collapse them into one incomplete action. A function and its test added\n00394|     // to existing modules (PR #1188 T1) is one such composition: read both\n00395|     // modules, write both, run the stated command.\n00396|     // A copy or move followed by edits of the file it makes is planned\n00397|     // sentence by sentence (PR #1188 G82).\n00398|     if let Some(plan) = super::request_sequence::plan_request_sequence_step(\n00399|         task,\n00400|         messages,\n00401|         tool_names,\n00402|         plan_chat_step,\n00403|     )\n00404|     .or_else(|| super::workspace_change::plan_workspace_change_step(task, messages, tool_names))\n00405|     .or_else(|| super::module_function::plan_module_function_step(task, messages, tool_names))\n00406|     // A bug report with a stated expectation is checked before anything is\n00407|     // rewritten (PR #1188 T93).\n00408|     .or_else(|| {\n00409|         super::function_expectation::plan_function_expectation_step(task, messages, tool_names)\n00410|     })\n00411|     // An assertion of a stated call and value is added in the test\n00412|     // file's own form, and the file is run (PR #1188 G13).\n00413|     .or_else(|| super::test_assertion::plan_test_assertion_step(task, messages, tool_names))\n00414|     // A test asked for with no expected result is a question (PR #1188\n00415|     // G25).\n00416|     .or_else(|| super::function_expectation::test_expectation_question(task))\n00417|     {\n00418|         return Some(plan);\n00419|     }\n00420|     // A source-code description is not literal file content. Lower bounded\n00421|     // seed-backed source tasks before the broad literal-write parser so coding\n00422|     // requests produce executable bytes and verify those exact bytes.\n00423|     if let Some(plan) = code_task::plan_generated_source_step(task, messages, tool_names) {\n00424|         return Some(plan);\n00425|     }\n00426|     if let Some(plan) = structured_edit::plan_structured_edit_step(task, messages, tool_names) {\n00427|         return Some(plan);\n00428|     }\n00429|     // A source-backed structured document is a read/derive/write transaction.\n00430|     // It must win before the ordinary file reader, which would otherwise read\n00431|     // the input correctly and then mistake that intermediate observation for\n00432|     // the answer to the whole authored-artifact request.\n00433|     if let Some(plan) = structured_document::plan_step(task, messages, tool_names) {\n00434|         return Some(plan);\n00435|     }\n00436|     // A repository audit names the artifact its CLI command will produce; that\n00437|     // filename is a destination, not literal content for the generic writer.\n00438|     // Keep the replayable recipe ahead of literal fallback so an observed CLI\n00439|     // result completes the audit instead of starting a redundant write plan.\n00440|     if statement_audit::is_statement_audit_task(task) {\n00441|         return Some(plan_shell_step(\n00442|             messages,\n00443|             tool_names,\n00444|             statement_audit::command_for(task),\n00445|         ));\n00446|     }\n00447|     // Resolve an unambiguous literal write before keyword recipes: arbitrary\n00448|     // filenames/payloads may legitimately contain \"issue\", \"report\", or \"learning\".\n00449|     // Unambiguous is the operative word: a request that also pins the target\n00450|     // file's opening line has not spelled its bytes out, and content recovered\n00451|     // from its prose would be written without that line (issue #1066).\n00452|     // Plan 16 L2g: a request that names a source-tree file (`js/app.js … to\n00453|     // typescript`) is the meta pivot's translate family, and must be claimed\n00454|     // before the literal-write and obligation composers read \"write it\" as an\n00455|     // artifact write of the goal text. The structural gate (a path token plus\n00456|     // the target's canonical spelling) is cheap; the family itself is decided\n00457|     // by the shared solver, whose bridge lowers it to one `translate` tool\n00458|     // call — or answers with the rendered gap on a client without the tool.\n00459|     if crate::meta_translate::source_tree_request(task).is_some() {\n00460|         match super::conversation_recall::plan_shared_solver_step(messages, tool_names) {\n00461|             super::conversation_recall::SharedSolverStep::Ready(plan) => return Some(plan),\n00462|             super::conversation_recall::SharedSolverStep::NotOurs\n00463|             | super::conversation_recall::SharedSolverStep::Defer => {}\n00464|         }\n00465|     }\n00466|     // An enumerated request is planned one obligation at a time, and is not\n00467|     // successfully finished until the runtime ledger has discharged every\n00468|     // node with at least one execution record (issues #1099 and #1138 B5).\n00469|     // Single-clause requests deliberately bypass this path and keep the\n00470|     // established whole-request composer below. So does a request the shell\n00471|     // executes as one command and no composer reads as an artifact write:\n00472|     // \"show me the working directory: then list its files\" splits into clauses\n00473|     // whose first half names no artifact, and the ledger reported a gap where\n00474|     // the shell cascade answers the whole request (issue #907). The semantic\n00475|     // resolver, not the general one: \"copy\" inside \"a fresh repository copy\"\n00476|     // matches a shell verb surface without the request being a command.\n00477|     let shell_owned = super::shell_command::semantic_shell_command_for_task(task).is_some()\n00478|         && compose_general_change_plan(task).is_none();\n00479|     if capability_router::workspace_creation_tool(tool_names).is_some()\n00480|         && !shell_owned\n00481|         && let Some(obligations) = task_obligations::obligations(task)\n00482|     {\n00483|         match task_obligations::next_step(task, messages) {\n00484|             Some(\n00485|                 task_obligations::ObligationStep::Observe(node)\n00486|                 | task_obligations::ObligationStep::Decompose(node),\n00487|             ) => {\n00488|                 // Observable artifact nodes re-enter the ordinary composer;\n00489|                 // underivable nodes have already been recursively split by\n00490|                 // `ObligationNode::build`. If no executable plan can be\n00491|                 // derived, decline instead of turning an unobserved node into\n00492|                 // completion prose.\n00493|                 return compose_general_change_plan(&node.clause)\n00494|                     .map(|plan| plan_general_change_step(messages, tool_names, &plan));\n00495|             }\n00496|             Some(task_obligations::ObligationStep::ReportGap {\n00497|                 node_id,\n00498|                 clause,\n00499|                 span,\n00500|                 reason,\n00501|             }) => {\n00502|                 return Some(AgenticPlan::Final(task_obligations::gap_answer(\n00503|                     &node_id, &clause, span, &reason,\n00504|                 )));\n00505|             }\n00506|             None if task_obligations::successfully_discharged(task, messages) => {\n00507|                 // Re-enter the final executable obligation's ordinary state\n00508|                 // machine so the completion wording and verification report\n00509|                 // stay identical to a single-target request.\n00510|                 return obligations\n00511|                     .iter()\n00512|                     .rev()\n00513|                     .find_map(|obligation| compose_general_change_plan(&obligation.clause))\n00514|                     .map(|plan| plan_general_change_step(messages, tool_names, &plan));\n00515|             }\n00516|             None => return None,\n00517|         }\n00518|     }\n00519|     if let Some(plan) = capability_router::workspace_creation_tool(tool_names)\n00520|         .and_then(|_| compose_general_change_plan(task))\n00521|         .map(|plan| plan_general_change_step(messages, tool_names, &plan))\n00522|     {\n00523|         return Some(plan);\n00524|     }\n00525|     // Portable event logs own the independently validated trace-learning route.\n00526|     if let Some(task) = algorithm_learning::compile_task(task) {\n00527|         return Some(algorithm_learning::plan_step(messages, tool_names, &task));\n00528|     }\n00529|     // A freely phrased procedure is one generalized compile → persist → verify\n00530|     // recipe on both the symbolic and Agent CLI surfaces.\n00531|     if let Some(procedure) = procedure::compile_task(task) {\n00532|         return Some(procedure::plan_step(messages, tool_names, &procedure));\n00533|     }\n00534|     // Specific self-inspection routes precede broad formalization. Associative\n00535|     // learning comes before self-healing because both accept auto-learning terms;\n00536|     // the requested artifact scope distinguishes their recipes.\n00537|     if let Some(report) = learning_report::route(task) {\n00538|         return Some(report.plan_step(messages, tool_names));\n00539|     }\n00540|     // Workspace mutations are grounded in client-owned file bytes. This route\n00541|     // follows the explicit learning recipes so their requested artifacts cannot\n00542|     // be mistaken for an edit, and precedes the generic edit/read/shell routers\n00543|     // below. Requests naming both a literal target and literal content are\n00544|     // already claimed by the write probe above.\n00545|     if let Some(plan) = code_artifact::plan_code_artifact_step(task, messages, tool_names) {\n00546|         return Some(plan);\n00547|     }\n00548|     if self_heal::is_self_heal_task(task) {\n00549|         return Some(plan_self_heal_step(messages, tool_names));\n00550|     }\n00551|     if dreaming_audit::is_dreaming_audit_task(task) {\n00552|         return Some(plan_dreaming_audit_step(messages, tool_names));\n00553|     }\n00554|     if self_ast::is_self_ast_task(task) {\n00555|         return Some(plan_self_ast_step(messages, tool_names));\n00556|     }\n00557|     // The whole-repository source-links recipe: checked alongside the other\n00558|     // self-inspection recipes and before formalization, because its request\n00559|     // legitimately names \"links\" (its output format), which the broad\n00560|     // formalization keyword match below would otherwise capture.\n00561|     if source_links::is_source_links_task(task) {\n00562|         return Some(plan_source_links_step(messages, tool_names));\n00563|     }\n00564|     // The learning-ledger recipe: the promotion step that follows an approved repair\n00565|     // case. Checked after self-healing (which owns the \"auto learning\" keywords) and\n00566|     // before formalization, since its request legitimately names \"Links Notation\".\n00567|     if ledger::is_ledger_task(task) {\n00568|         return Some(plan_ledger_step(messages, tool_names));\n00569|     }\n00570|     // The grounded self-explanation recipe: answers \"how does Formal AI work?\" from\n00571|     // real source/data/test artifacts. Checked alongside the other self-inspection\n00572|     // recipes and before formalization, since its request legitimately names \"Links\n00573|     // Notation\" as the output format its document is rendered in.\n00574|     if explain::is_explain_task(task) {\n00575|         return Some(plan_explain_step(messages, tool_names));\n00576|     }\n00577|     // The user-initiated self-change recipe: turns a natural-language \"change Formal AI\n00578|     // itself\" request into a reviewable pull request through the same human-gated loop.\n00579|     // Checked alongside the other self-referential recipes and before formalization,\n00580|     // since its request legitimately names \"Links Notation\" as the output format.\n00581|     if change_request::is_change_request_task(task) {\n00582|         return Some(plan_change_request_step(messages, tool_names));\n00583|     }\n00584|     // The general repair-classification recipe: given an arbitrary failure trace, decide\n00585|     // whether the repair is a solver method, a data record, or a test, and compose the\n00586|     // grounded, human-gated strategy for each class. Checked alongside the other\n00587|     // self-referential recipes and before formalization, since its request legitimately\n00588|     // names \"Links Notation\" as the output format its strategies are rendered in. Its\n00589|     // keywords are disjoint from the self-healing recipe's (\"repair case\"/\"repair loop\"),\n00590|     // so ordering only guards a request that somehow names both.\n00591|     if repair_strategy::is_repair_strategy_task(task) {\n00592|         return Some(plan_repair_strategy_step(messages, tool_names));\n00593|     }\n00594|     // Rebuild-and-reattach recipe: once a change is accepted, recompile Formal AI and\n00595|     // reattach the improved WebAssembly worker to the UI (issue #558's `R558-06`).\n00596|     // Checked alongside the other self-referential recipes and before formalization,\n00597|     // since its request legitimately names \"Links Notation\" as the output format its plan\n00598|     // is rendered in. Its keywords key on \"reattach\" and are disjoint from the\n00599|     // source-links recipe's \"recompile\", so ordering only guards a request that somehow\n00600|     // names both.\n00601|     if rebuild_plan::is_rebuild_task(task) {\n00602|         return Some(plan_rebuild_step(messages, tool_names));\n00603|     }\n00604|     // The learning-frontier recipe (issues #498 + #558): route the trending prompts the\n00605|     // engine cannot yet resolve through the human-gated self-improvement loop. Checked\n00606|     // before the sibling catalog recipe because both legitimately name \"Google Trends\";\n00607|     // its keywords (\"learning frontier\", \"self-improvement loop\", \"cannot … resolve\") are\n00608|     // disjoint from the catalog recipe's (prompt/answer/catalog/test), so ordering only\n00609|     // guards a request that somehow names both.\n00610|     if google_trends_learning::is_google_trends_learning_task(task) {\n00611|         return Some(plan_google_trends_learning_step(messages, tool_names));\n00612|     }\n00613|     if google_trends_catalog::is_google_trends_catalog_task(task) {\n00614|         return Some(plan_google_trends_catalog_step(messages, tool_names));\n00615|     }\n00616|     // The question-catalog recipe (issue #527): enumerate every possible question\n00617|     // smallest-first, classify each grammatically and logically, and answer the\n00618|     // meaningful ones. Checked alongside the other self-referential recipes and before\n00619|     // formalization, since its request legitimately names \"Links Notation\" as the output\n00620|     // format its catalog is rendered in. Its keywords (\"question catalog\", \"all possible\n00621|     // questions\", …) are disjoint from the sibling recipes', so ordering only guards a\n00622|     // request that somehow names both.\n00623|     if question_catalog::is_question_catalog_task(task) {\n00624|         return Some(plan_question_catalog_step(messages, tool_names));\n00625|     }\n00626|     // A request to inspect named files and report what it finds is a file\n00627|     // analysis, not a request to open a repository issue. In particular, a\n00628|     // `.github/...` path supplies the report router's otherwise-valid subject\n00629|     // word. Let the typed read + audit object govern the output verb before the\n00630|     // conversation-level report wizard sees it (issue #1138 self-use).\n00631|     // After it, where a name or literal is used inside the workspace is a\n00632|     // content search (PR #1188 T90): grep it, ahead of the file-name locate arm\n00633|     // and web search.\n00634|     if let Some(plan) = file_read_task_for(task)\n00635|         .filter(super::file_read::FileReadTask::is_analysis)\n00636|         .map(|file_task| plan_file_read_step(&file_task, messages, tool_names))\n00637|         .or_else(|| workspace_search::plan_workspace_search_step(task, messages, tool_names))\n00638|         // What a named module exports is answered from its declarations (T99).\n00639|         .or_else(|| super::module_exports::plan_module_exports_step(task, messages, tool_names))\n00640|         // A summary of a named file summarizes the file's text (T100).\n00641|         .or_else(|| super::file_summary::plan_file_summary_step(task, messages, tool_names))\n00642|     {\n00643|         return Some(plan);\n00644|     }\n00645|     // Agent-mode counterpart of the web UI's report action (issues #687 + #822).\n00646|     // This is a conversation state machine: after the initial report intent it\n00647|     // continues across structured tool results or plain-text user choices.\n00648|     if let Some(plan) = report_issue::plan_report_flow(messages, tool_names) {\n00649|         return Some(plan);\n00650|     }\n00651|     match conversation_recall::plan_shared_solver_step(messages, tool_names) {\n00652|         conversation_recall::SharedSolverStep::Ready(plan) => return Some(plan),\n00653|         // The shared solver's typed recipe owns the turn and the client can run\n00654|         // it: stop routing and yield the request so the server's recipe path\n00655|         // delivers the verified write--check--run chain (issue #916) -- falling\n00656|         // through instead would let the research arms below steal the prompt\n00657|         // back (issue #936).\n00658|         conversation_recall::SharedSolverStep::Defer => return None,\n00659|         conversation_recall::SharedSolverStep::NotOurs => {}\n00660|     }\n00661|     if let Some(answer) = tool_result::follow_up_answer(messages, task) {\n00662|         return Some(AgenticPlan::Final(answer));\n00663|     }\n00664|     if let Some(answer) = web_research::contextual_reference_clarification(task) {\n00665|         return Some(AgenticPlan::Final(answer));\n00666|     }\n00667|     if web_research::is_definition_followup(task) {\n00668|         if let Some(query) = web_research::definition_followup_topic(messages, task) {\n00669|             if let Some(plan) =\n00670|                 web_research::plan_web_research_step(messages, tool_names, &query, true)\n00671|             {\n00672|                 return Some(plan);\n00673|             }\n00674|         } else {\n00675|             return Some(AgenticPlan::Final(\n00676|                 web_research::definition_followup_clarification(task),\n00677|             ));\n00678|         }\n00679|     }\n00680|     if let Some(plan) = intent_router::plan_edit_step(task, messages, tool_names) {\n00681|         return Some(plan);\n00682|     }\n00683|     // Preserve the established stateful list/read recipe whenever the client\n00684|     // exposes its typed read capability. The shared read-many route remains\n00685|     // available for CLIs that advertise only a batch reader.\n00686|     if tool_for(tool_names, Capability::Read).is_some()\n00687|         && let Some(file_task) = file_read_task_for(task)\n00688|     {\n00689|         return Some(plan_file_read_step(&file_task, messages, tool_names));\n00690|     }\n00691|     // A meanings-driven explicit local scope dominates generic search verbs.\n00692|     // This state machine observes each result and widens only after emptiness.\n00693|     if let Some(plan) = local_search::plan_local_search_step(messages, tool_names) {\n00694|         return Some(plan);\n00695|     }\n00696|     if let Some(plan) = comparison::plan_comparison_step(task, messages, tool_names) {\n00697|         return Some(plan);\n00698|     }\n00699|     // Plan 10 leaf 11: the shared cue-phrase arm that stood here is retired, and its *position*\n00700|     // is kept -- because position is what the seven named capabilities still need. The decision\n00701|     // table decides them now by `(object, act, locus)` with no phrase scan, and it decides them\n00702|     // here, ahead of the shell cascade, so a request whose row names an advertised `grep`, `glob`,\n00703|     // `list_dir`, `read_many`, `multi_edit`, `todo` or `subagent` is not answered by the shell\n00704|     // lowering that same row declares as its fallback. A row the table cannot decide here (no\n00705|     // row, or a capability outside the seven) leaves the cascade exactly as it was.\n00706|     if let Some(plan) = capability_router::plan_named_capability_step(task, messages, tool_names) {\n00707|         return Some(plan);\n00708|     }\n00709|     if let Some(plan) = plan_shell_command_arm(task, messages, tool_names) {\n00710|         return Some(plan);\n00711|     }\n00712|     if let Some(file_task) = file_read_task_for(task) {\n00713|         return Some(plan_file_read_step(&file_task, messages, tool_names));\n00714|     }\n00715|     if formalization_recipe::is_formalization_task(task) {\n00716|         return Some(formalization_recipe::plan_formalization_step(\n00717|             task, messages, tool_names,\n00718|         ));\n00719|     }\n00720|     if meaning_detail::is_meaning_detail_task(task) {\n00721|         return Some(plan_meaning_detail_step(task, messages, tool_names));\n00722|     }\n00723|     if diagram::is_diagram_task(task) {\n00724|         return Some(plan_diagram_step(messages, tool_names));\n00725|     }\n00726|     // Plan 10 leaf 19 (issue #1138): the URL route that stood here is retired.\n00727|     // The decision table's five `url` rows — one per act — decide that request\n00728|     // class at the named-or-local stage below, with the same `fetch_arguments`\n00729|     // lowering this arm produced, so the arm was a second URL decision ahead of\n00730|     // its own table backstop. The table also guards what this arm never did: a\n00731|     // URL named while a research recipe is already under way is the recipe's\n00732|     // to continue, not a one-step fetch that ends it (issue #781).\n00733|     // A request to look at the repository the agent was handed is answered by\n00734|     // reading that repository. It has to be resolved before the research\n00735|     // routers, which would otherwise claim it on the strength of its question\n00736|     // shape alone and look the answer up on the open web (issue #1066). The\n00737|     // subject rule inside `workspace_inspection_search_for_task` is what keeps a\n00738|     // genuinely external question out of this route.\n00739|     if !tool_result::has_latest_turn_result(messages)\n00740|         && let Some(search) = workspace_inspection::workspace_inspection_search_for_task(task)\n00741|         && let Some(tool) = tool_for(tool_names, Capability::Grep)\n00742|     {\n00743|         let mut arguments = json!({\n00744|             \"query\": search.query,\n00745|             \"pattern\": search.pattern,\n00746|         });\n00747|         if let Some(include) = search.include {\n00748|             arguments[\"include\"] = include.into();\n00749|         }\n00750|         return Some(plan_one(tool, arguments.to_string()));\n00751|     }\n00752|     // A question about how a task decomposes is answered by decomposing it. It\n00753|     // has to be resolved before the research routers for the same reason the\n00754|     // workspace inspection above does: the question shape alone would otherwise\n00755|     // send a task the web has never heard of to a web search (issue #1066).\n00756|     //\n00757|     // The route reads `messages` for the same reason its neighbour above does,\n00758|     // and it makes that judgement itself: a turn on which a tool has already run\n00759|     // is not one an answer composed from the request alone may claim.\n00760|     if let Some(plan) = task_structure::plan_task_structure_step(messages, task) {\n00761|         return Some(plan);\n00762|     }\n00763|     // The decision table of `data/seed/capability-routing.lino` (issue #1138 B10,\n00764|     // plan 10 leaves 9-11). Capability is a function of the object in the\n00765|     // request, the act asked for, and where the effect lands, and a triple with\n00766|     // no row declines here rather than guessing -- so the research routers below\n00767|     // answer only what the table did not claim.\n00768|     //\n00769|     // It sits *here*, and not ahead of the semantic routes above, because that\n00770|     // is the position the #745 and #758 misroutes were actually made from:\n00771|     // every one of them was a request the routes above declined and a research\n00772|     // router then claimed on the strength of its sentence shape alone. Ahead of\n00773|     // those routes the table preempts the ones that read the conversation and\n00774|     // the workspace, which was measured at 239 failing tests -- the recipe\n00775|     // driver, the ladder capability suite and the agentic surfaces among them.\n00776|     // Since leaf 11 removed the 280 memorized cues there is no second capability\n00777|     // decision behind this one; what the table declines is visible as an honest\n00778|     // gap in the event log rather than as a phrase match that never fired.\n00779|     // One more thing the table may not claim: a turn that is *mid-recipe*.\n00780|     // Once a search has produced usable output the conversation is inside the\n00781|     // multi-step research route -- search, then fetch each result, then compose\n00782|     // -- and the request text on that turn is still the original request. The\n00783|     // table reads that text, sees the object it named (\"… на amazon.in\" names a\n00784|     // registrable host), and answers the whole conversation with one step,\n00785|     // ending the recipe after its first (issue #781). Routing by object, act and\n00786|     // locus decides *which capability a request needs*; it does not decide that\n00787|     // a recipe already under way is finished. The `has_successful_search_result`\n00788|     // boundary is the one the research routes below already draw for themselves.\n00789|     if !web_research::has_successful_search_result(messages)\n00790|         && let Some(plan) = capability_router::plan_routed_capability_step(\n00791|             task,\n00792|             messages,\n00793|             tool_names,\n00794|             capability_router::RoutingStage::NamedOrLocal,\n00795|         )\n00796|     {\n00797|         return Some(plan);\n00798|     }\n00799|     // An addition that quotes no text earns a question naming what is missing\n00800|     // (PR #1188 G69).\n00801|     // An instruction that edits a named file is never a web question -- when\n00802|     // no edit route above could compose it, the honest answer is that nothing\n00803|     // was planned, not a search for the sentence (issues #1115, #1133).\n00804|     if super::positional_edit::unquoted_addition_path(task).is_some()\n00805|         || super::positional_edit::names_local_edit(task)\n00806|     {\n00807|         return unquoted_addition_question(task);\n00808|     }\n00809|     if let Some(query) = web_research::web_research_query_for(messages)\n00810|         && let Some(plan) =\n00811|             web_research::plan_web_research_step(messages, tool_names, &query, false)\n00812|     {\n00813|         return Some(plan);\n00814|     }\n00815|     if let Some(plan) = intent_router::plan_web_search_step(task, messages, tool_names) {\n00816|         return Some(plan);\n00817|     }\n00818|     // A generic localized \"find\" cue can describe either an open-web lookup or\n00819|     // a workspace grep. The research routers above get first refusal whenever\n00820|     // the client exposes their tools; explicit local/repository searches were\n00821|     // already claimed by the capability router. This fallback therefore keeps\n00822|     // grep available to grep-only clients without letting an alphabetically\n00823|     // earlier local tool steal a web-research request.\n00824|     if !tool_result::has_latest_turn_result(messages)\n00825|         && let Some(query) = shell_command::code_search_query_for_task(task)\n00826|         && let Some(tool) = tool_for(tool_names, Capability::Grep)\n00827|     {\n00828|         return Some(plan_one(\n00829|             tool,\n00830|             json!({ \"query\": query, \"pattern\": query }).to_string(),\n00831|         ));\n00832|     }\n00833|     if web_research::has_successful_search_result(messages)\n00834|         && let Some(query) = web_research::mid_research_web_query_for(messages)\n00835|         && let Some(plan) =\n00836|             web_research::plan_web_research_step(messages, tool_names, &query, false)\n00837|     {\n00838|         return Some(plan);\n00839|     }\n00840|     if let Some(answer) = tool_result::latest_turn_answer(messages, tool_names, task) {\n00841|         return Some(AgenticPlan::Final(answer));\n00842|     }\n00843|     // A request that specifies what a document has to *cover* is answered by\n00844