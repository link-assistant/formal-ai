   00231|     return 0;
   00232|   }
   00233|   if (drift.length === 0) {
   00234|     console.log(`The ${expected.size} worker crate files are current.`);
   00235|     return 0;
   00236|   }
   00237|   console.error(`Stale worker crate files (run \`${COMMAND}\`):`);
   00238|   for (const file of drift) console.error(`  ${file}`);
