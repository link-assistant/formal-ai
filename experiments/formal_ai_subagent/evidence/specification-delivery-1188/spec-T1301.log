   00203|   files.set(`${WORKER_ROOT}/${REGISTRY_FILE}`, registryFileOf(meaningSeeds(registry)));
   00204|   return files;
   00205| }
   00206| 
   00207| /** The generated worker files on disk now (the hand-written loader excluded). */
   00208| function filesOnDisk() {
   00209|   return readdirSync(path.join(REPO_ROOT, WORKER_ROOT))
   00210|     .filter((file) => file.startsWith(FILE_PREFIX) && file !== LOADER_FILE)
   00211|     .map((file) => `${WORKER_ROOT}/${file}`);
   00212| }
   00213| 
   00214| function main(argv) {
   00215|   const write = argv.includes('--write');
   00216|   const expected = generatedFiles();
