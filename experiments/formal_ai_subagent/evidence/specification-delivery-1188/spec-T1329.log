',\n00189|     '// them, and the browser does not fetch the registry itself.',\n00190|     '',\n00191|     'self.FORMAL_AI_CRATE_MEANING_SEEDS = Object.freeze([',\n00192|     ...seeds.map((seed) => `  \"${seed}\",`),\n00193|     ']);',\n00194|     '',\n00195|   ].join('\\n');\n00196| }\n00197| \n00198| /** Every generated file, as a map from its worker path to its text. */\n00199| export function generatedFiles() {\n00200|   const read = (name) => readFileSync(path.join(REPO_ROOT, AGENTIC_ROOT, name), 'utf8');\n00201|   const files = new Map();\n00202|   for (const name of importClosure(ENTRY_MODULES, read)) {\n00203|     files.set(`${WORKER_ROOT}/${workerFileOf(name)}`, factoryOf(name, read(name)));\n00204|   }\n00205|   const registry = readFileSync(path.join(REPO_ROOT, SEED_REGISTRY), 'utf8');\n00206|   files.set(`${WORKER_ROOT}/${REGISTRY_FILE}`, registryFileOf(meaningSeeds(registry)));\n00207|   return files;\n00208| }\n00209| \n00210| /** The generated worker files on disk now (the hand-written loader excluded). */\n00211| function filesOnDisk() {\n00212|   return readdirSync(path.join(REPO_ROOT, WORKER_ROOT))\n00213|     .filter((file) => file.startsWith(FILE_PREFIX) && file !== LOADER_FILE)\n00214|     .map((file) => `${WORKER_ROOT}/${file}`);\n00215| }\n00216| \n00217| function main(argv) {\n00218|   const write = argv.includes('--write');\n00219|   const expected = generatedFiles();\n00220|   const drift = [];\n00221|   for (const [file, text] of expected) {\n00222|     const full = path.join(REPO_ROOT, file);\n00223|     if (existsSync(full) && readFileSync(full, 'utf8') === text) continue;\n00224|     drift.push(file);\n00225|     if (write) writeFileSync(full, text);\n00226|   }\n00227|   for (const file of filesOnDisk()) {\n00228|     if (expected.has(file)) continue;\n00229|     drift.push(file);\n00230|     if (write) unlinkSync(path.join(REPO_ROOT, file));\n00231|   }\n00232|   if (write) {\n00233|     console.log(`${expected.size} worker crate file