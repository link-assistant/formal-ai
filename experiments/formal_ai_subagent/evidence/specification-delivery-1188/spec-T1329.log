      "result": "<file>\n00001| #!/usr/bin/env node\n00002| // Generate the browser worker's copies of the crate modules the chat routes\n00003| // call (R1188-U18, U19, U21): text formalization, dependency summarization,\n00004| // page formalization and round-trip translation; and the event log's evidence\n00005| // projection every answer carries (R1188-U29).\n00006| //\n00007| // The browser worker is a classic script (js/worker/formal_ai_worker.js loads\n00008| // its modules with `importScripts`), so it cannot import the ES modules of\n00009| // js/agentic/crate/. Instead of a second, hand-kept port, every module in the\n00010| // import closure of the entry modules below is written to\n00011| // js/worker/formal_ai_worker_crate_<name>.js as a factory:\n00012| //\n00013| //   (self.FORMAL_AI_CRATE_FACTORIES ||= {})[\"crate/text_formalization.mjs\"] =\n00014| //     (crateRequire) => { <the module body>; return { <its exports> }; };\n00015| //\n00016| // Its body is the module's own text, byte for byte, with each `import` turned\n00017| // into a `crateRequire` of the module it names and each `export` keyword\n00018| // dropped. A factory runs on first use, so the worker loads the files in any\n00019| // order. js/worker/formal_ai_worker_crate_modules.js instantiates them and\n00020| // installs the worker as the host of js/agentic/host.mjs.\n00021| //\n00022| // host.mjs reads the seed registry to find the meaning lexicon's files; the\n00023| // browser does not fetch data/meta/, so the registry's meaning seeds are\n00024| // written to formal_ai_worker_crate_seed_registry.js in its order.\n00025| //\n00026| // Usage:\n00027| //   node scripts/generate-worker-crate-modules.mjs --write   regenerate the files\n00028| //   node scripts/generate-worker-crate-modules.mjs --check   fail when a file drifts (CI gate)\n00029| \n00030| import { existsSync, readFileSync, readdirSync, unlinkSync, writeFileSync } from 'node:fs';\n00031| import path from 'node:path';\n00032| \n00033| import { REPO_ROOT } from '../js/server/lino.mjs';\n00034| \n00035| /** The modules the chat routes call; their import closure is generated. */\n00036| export const ENTRY_MODULES = Object.freeze([\n00037|   'crate/dependency_summarization.mjs',\n00038|   'crate/event_log.mjs',\n00039|   'crate/page_formalization.mjs',\n00040|   'crate/skill_procedure.mjs',\n00041|   'crate/skill_procedure_artifact.mjs',\n00042|   'crate/solver_formalization.mjs',\n00043|   'crate/round_trip_translation.mjs',\n00044| ]);\n00045| \n00046| const AGENTIC_ROOT = 'js/agentic';\n00047| const WORKER_ROOT = 'js/worker';\n00048| const FILE_PREFIX = 'formal_ai_worker_crate_';\n00049| const REGISTRY_FILE = `${FILE_PREFIX}seed_registry.js`;\n00050| const LOADER_FILE = `${FILE_PREFIX}modules.js`;\n00051| const SEED_REGISTRY = 'data/meta/seed-registry.lino';\n00052| const COMMAND = 'node scripts/generate-worker-crate-modules.mjs --write';\n00053| \n00054| const IMPORT = /^(?:import|export)\\s*\\{([^}]*)\\}\\s*from\\s*'([^']+)';\\n/gmu;\n00055| const EXPORT_DECLARATION = /^export (async function|function|const|let|class) ([A-Za-z_$][\\w$]*)/gmu;\n00056| \n00057| /**\n00058|  * The module name of `specifier` imported from `from`, both relative to\n00059|  * js/agentic (`crate/x.mjs`, `host.mjs`).\n00060|  * @param {string} from\n00061|  * @param {string} specifier\n00062|  */\n00063| export function resolveModule(from, specifier) {\n00064|   return path.posix.normalize(path.posix.join(path.posix.dirname(from), specifier));\n00065| }\n00066| \n00067| /**\n00068|  * The names a module exports, in source order.\n00069|  * @param {string} source\n00070|  */\n00071| export function exportedNames(source) {\n00072|   return [...source.matchAll(EXPORT_DECLARATION)].map((match) => match[2]);\n00073| }\n00074| \n00075| /**\n00076|  * The bindings of one import list as a destructuring pattern\n00077|  * (`a, b as c` gives `a, b: c`).\n00078|  * @param {string} list\n00079|  */\n00080| export functio