   00076| /// The issue-#627 file-reading recipe: direct filename requests use an advertised
   00077| /// `read` tool, shell-shaped `cat` requests use the run tool, and multi-step
   00078| /// "list then read" prompts walk `bash(ls)` → `read(file)` → final content.
   00079| pub(super) fn plan_file_read_step(
   00080|     task: &FileReadTask,
   00081|     messages: &[ChatMessage],
   00082|     tool_names: &[&str],
   00083| ) -> AgenticPlan {
   00084|     let read_tool = tool_for(tool_names, Capability::Read);
   00085|     let run_tool = tool_for(tool_names, Capability::Run);
   00086|     let grep_tool = tool_for(tool_names, Capability::Grep);
   00087|     let records = tool_result_records(messages);
   00088|     let request = crate::protocol::latest_user_request(messages).unwrap_or_default();
   00089| 
   00090|     match task {
   00091|         FileReadTask::Direct {
   00092|             path,
   00093|             mode,
   00094|             prefer_run,
   00095|         } => plan_direct_file_read(
   00096|             path,
   00097|             mode,
   00098|             *prefer_run,
   00099|             read_tool,
   00100|             run_tool,
   00101|             grep_tool,
   00102|             &records,
   00103|             &request,
   00104|         ),
   00105|         FileReadTask::DirectMany { paths, mode } => exact::plan_direct_file_reads(
   00106|             paths, mode, read_tool, run_tool, grep_tool, &records, &request,
   00107|         ),
   00108|         FileReadTask::ListThenRead {
   00109|             directory,
   00110|             selection,
   00111|             mode,
   00112|         } => plan_list_then_read(
   00113|             directory, *selection, mode, read_tool, run_tool, &records, &request,
   00114|         ),
   00115|     }
   00116| }
