   00556|     let Some((stem, extension)) = token.rsplit_once('.') else {
   00557|         return false;
   00558|     };
   00559|     !stem.is_empty()
   00560|         && !extension.is_empty()
   00561|         && extension.len() <= 12
   00562|         && token.chars().all(is_file_path_char)
