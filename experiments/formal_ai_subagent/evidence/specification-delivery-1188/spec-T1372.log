   00521| /// A path token as prose wrote it, stripped of the punctuation the sentence put
   00522| /// around it.
   00523| ///
   00524| /// The terminating dot is delegated to
   00525| /// [`trim_trailing_sentence_dot`](super::file_path_shape::trim_trailing_sentence_dot)
   00526| /// so the read route, the write-request parser and the shell route all draw the
   00527| /// same boundary between a path and the sentence carrying it.
   00528| fn clean_file_token(token: &str) -> String {
   00529|     peel_sentence_punctuation(token, |token| {
   00530|         token
   00531|             .trim_matches('`')
   00532|             .trim_matches('"')
   00533|             .trim_matches('\'')
   00534|             .trim_matches(|c: char| {
   00535|                 matches!(
   00536|                     c,
