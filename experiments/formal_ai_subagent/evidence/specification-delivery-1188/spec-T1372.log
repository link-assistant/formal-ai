   00643| fn read_result_for_path<'a>(records: &'a [ToolResultRecord], path: &str) -> Option<&'a str> {
   00644|     records
   00645|         .iter()
   00646|         .find(|record| {
   00647|             record.capability == Some(Capability::Read)
   00648|                 && path_argument(&record.arguments)
   00649|                     .is_some_and(|recorded| same_path(&recorded, path))
   00650|         })
   00651|         .map(|record| record.content.as_str())
   00652| }
