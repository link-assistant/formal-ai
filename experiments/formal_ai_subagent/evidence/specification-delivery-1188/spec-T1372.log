   00674| /// Whether a recorded path argument denotes the path the planner asked for.
   00675| ///
   00676| /// The transcript holds the argument the *client's* schema accepted, not the one
   00677| /// the planner planned with: [`crate::protocol_responses`] rewrites `path` to
   00678| /// Gemini's `absolute_path` and absolutises it, so a recorded
   00679| /// `/work/alpha.txt` has to answer a planned `alpha.txt`.
   00680| fn same_path(recorded: &str, planned: &str) -> bool {
   00681|     if recorded == planned {
   00682|         return true;
   00683|     }
   00684|     let planned = planned.trim_start_matches("./");
   00685|     recorded
   00686|         .trim_start_matches("./")
   00687|         .strip_suffix(planned)
   00688|         .is_some_and(|prefix| prefix.is_empty() || prefix.ends_with('/'))
   00689| }
