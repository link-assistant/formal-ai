   00654| fn grep_result_for_path<'a>(
   00655|     records: &'a [ToolResultRecord],
   00656|     path: &str,
   00657|     pattern: &str,
   00658| ) -> Option<&'a str> {
   00659|     records
   00660|         .iter()
   00661|         .find(|record| {
   00662|             record.capability == Some(Capability::Grep)
   00663|                 && path_argument(&record.arguments)
   00664|                     .is_some_and(|recorded| same_path(&recorded, path))
   00665|                 && record
   00666|                     .arguments
   00667|                     .get("pattern")
   00668|                     .and_then(serde_json::Value::as_str)
   00669|                     == Some(pattern)
   00670|         })
