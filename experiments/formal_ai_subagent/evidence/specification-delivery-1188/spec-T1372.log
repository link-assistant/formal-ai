   00544| fn looks_like_local_file_path(token: &str) -> bool {
   00545|     if token.is_empty()
   00546|         || token.contains("://")
   00547|         || token.starts_with("http:")
   00548|         || token.starts_with("https:")
   00549|         || is_dotted_number(token)
