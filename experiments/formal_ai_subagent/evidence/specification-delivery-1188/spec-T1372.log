   00602| fn tool_result_records(messages: &[ChatMessage]) -> Vec<ToolResultRecord> {
   00603|     // Only results produced *within the current user turn* ground a read. A
   00604|     // client loops tool calls without a new user message, so the current turn is
   00605|     // everything after the last user message; a `cat 1.txt` result from an
   00606|     // earlier turn must never be replayed as the answer to a later `read 1.txt`
   00607|     // (issue #755 — read/list determinism). Without this bound the recipe short
   00608|     // -circuits on a stale, unrelated result and skips the fresh read entirely.
   00609|     let turn_start = messages
   00610|         .iter()
   00611|         .rposition(|message| message.role.eq_ignore_ascii_case("user"))
   00612|         .map_or(0, |index| index + 1);
   00613|     let mut records = Vec::new();
   00614|     for (index, message) in messages.iter().enumerate().skip(turn_start) {
   00615|         if !message.role.eq_ignore_ascii_case("tool") {
   00616|             continue;
   00617|         }
   00618|         let (capability, arguments) =
   00619|             tool_result_call(messages, index).map_or((None, serde_json::Value::Null), |call| {
   00620|                 (
   00621|                     tool_capability(&call.function.name),
   00622|                     serde_json::from_str(&call.function.arguments)
   00623|                         .unwrap_or(serde_json::Value::Null),
   00624|                 )
   00625|             });
   00626|         records.push(ToolResultRecord {
   00627|             capability,
   00628|             arguments,
   00629|             content: message.content.plain_text(),
   00630|         });
   00631|     }
   00632|     records
   00633| }
   00634| 
   00635| fn tool_result_call(messages: &[ChatMessage], index: usize) -> Option<&ToolCall> {
   00636|     let call_id = messages[index].tool_call_id.as_ref()?;
   00637|     messages[..index]
   00638|         .iter()
   00639|         .flat_map(|prior| prior.tool_calls.iter())
   00640|         .find(|call| &call.id == call_id)
   00641| }
