   00304| /// Shell syntax that chains, pipes or redirects commands.
   00305| const SHELL_OPERATORS: [&str; 5] = ["&&", "||", ";", "|", ">"];
   00306| 
   00307| pub(super) fn file_read_task_for(prompt: &str) -> Option<FileReadTask> {
   00308|     let lower = prompt.to_lowercase();
   00309| 
   00310|     // Issue #681: a file-creation / write request must never be routed to the read
   00311|     // recipe — the target does not exist yet, so reading it is always the wrong
   00312|     // tool. When the request is a write intent, decline here and let the router
   00313|     // fall through to the general write/create planner. This is the general rule
   00314|     // ("write intent beats read intent"), not a per-phrase special case: the same
   00315|     // gate catches create/write/save/generate across every supported language.
   00316|     if has_file_write_intent(&lower) {
   00317|         return None;
   00318|     }
   00319|     // A command quoted after a run prefix that chains, pipes or redirects is
   00320|     // run as written, not read file by file (PR #1188 G62).
   00321|     if super::shell_command::explicit_passthrough_command(prompt).is_some_and(|command| {
   00322|         SHELL_OPERATORS
   00323|             .iter()
   00324|             .any(|operator| command.contains(operator))
   00325|     }) {
   00326|         return None;
   00327|     }
   00328| 
   00329|     if let Some(path) = leading_cat_path(prompt) {
   00330|         return Some(FileReadTask::Direct {
   00331|             path,
   00332|             mode: FileReadMode::Full,
   00333|             prefer_run: false,
   00334|         });
   00335|     }
   00336| 
   00337|     if asks_to_read_every_file(&lower) {
   00338|         return Some(FileReadTask::ListThenRead {
   00339|             directory: String::from("."),
   00340|             selection: FileSelection::All,
   00341|             mode: FileReadMode::Summary,
   00342|         });
   00343|     }
   00344| 
   00345|     if asks_to_list_then_read(&lower) {
   00346|         return Some(FileReadTask::ListThenRead {
   00347|             directory: directory_for_list_read(prompt).unwrap_or_else(|| String::from(".")),
   00348|             selection: selection_for_prompt(&lower),
   00349|             mode: mode_for_prompt(prompt),
   00350|         });
   00351|     }
   00352| 
   00353|     if asks_to_read_file_in_folder(&lower) {
   00354|         return Some(FileReadTask::ListThenRead {
   00355|             directory: directory_for_list_read(prompt).unwrap_or_else(|| String::from(".")),
   00356|             selection: FileSelection::First,
   00357|             mode: mode_for_prompt(prompt),
   00358|         });
   00359|     }
   00360| 
   00361|     // A read cue and a path in the same sentence are about each other, and that
   00362|     // is the ordinary case: "выведи sample.txt", "show me the contents of
   00363|     // beta.md". Answering it from the sentence rather than from the whole prompt
   00364|     // is what keeps the two-obligation requests below from being decided by a
   00365|     // cue that belongs to a different clause (issue #1066).
   00366|     let read_paths = read_paths_named_beside_their_cue(prompt);
   00367|     if read_paths.len() > 1 {
   00368|         return Some(FileReadTask::DirectMany {
   00369|             paths: read_paths,
   00370|             mode: mode_for_prompt(prompt),
   00371|         });
   00372|     }
   00373|     if let Some(path) = read_paths.into_iter().next() {
   00374|         return Some(FileReadTask::Direct {
   00375|             path,
   00376|             mode: mode_for_prompt(prompt),
   00377|             prefer_run: false,
   00378|         });
   00379|     }
   00380| 
   00381|     // Issue #1066: "write intent beats read intent" is decided above over the
   00382|     // whole prompt, which settles a request that is only a write. It does not
   00383|     // settle a request that is both -- "find X out, and leave the answer in
   00384|     // FILE" -- because there the read cue and the path belong to different
   00385|     // sentences and different obligations. "Leave observable evidence in
   00386|     // `.agent-ladder/node-1.2-proof.md`. The first line must be exactly
   00387|     // `node_path=1.2`" carries the read cue *first line* in the sentence that
   00388|     // constrains the file's opening, and the only path in the prompt is the one
   00389|     // the caller asked to have written. Opening it reads a file that does not
   00390|     // exist yet, and the run ends by recording the resulting error as its
   00391|     // evidence. Where cue and path were never in one sentence, a path the
   00392|     // request states as a write destination is therefore not a read target.
   00393|     if has_file_read_intent(&lower)
   00394|         && let Some(path) = first_local_file_path(prompt)
   00395|         && !write_request::is_stated_write_target(prompt, &path)
   00396|     {
   00397|         return Some(FileReadTask::Direct {
   00398|             path,
   00399|             mode: mode_for_prompt(prompt),
   00400|             prefer_run: false,
   00401|         });
   00402|     }
   00403| 
   00404|     None
   00405| }
   00406| 
   00407| /// The first path a request names in the same sentence as a read cue.
   00408| ///
   00409| /// Sentence scope is what separates a cue that is *about* the path from one that
   00410| /// merely shares a prompt with it, the same scoping
   00411| /// [`super::evidence_record`] uses to split a delivery obligation from the work
   00412| /// it delivers, and [`super::shell_command`] uses to tell a named command from an
   00413| /// ordered one (issue #907).
   00414| fn read_paths_named_beside_their_cue(prompt: &str) -> Vec<String> {
   00415|     sentences(prompt)
   00416|         .into_iter()
   00417|         .find_map(|sentence| {
   00418|             has_file_read_intent(&sentence.text.to_lowercase())
   00419|                 .then(|| local_file_paths(sentence.text))
   00420|         })
   00421|         .unwrap_or_default()
   00422| }
   00423| 
   00424| fn has_file_read_intent(lower: &str) -> bool {
   00425|     seed::lexicon().mentions_role(seed::ROLE_FILE_READ_ACTION_CUE, lower)
   00426| }
   00427| 
   00428| fn asks_to_read_every_file(lower: &str) -> bool {
   00429|     (lower.contains("read every file") || lower.contains("read all files"))
   00430|         && (lower.contains("summarize") || lower.contains("summary") || lower.contains("here"))
   00431| }
   00432| 
   00433| fn asks_to_list_then_read(lower: &str) -> bool {
   00434|     let lists_files = lower.contains("list the files")
   00435|         || lower.contains("list files")
   00436|         || lower.contains("ls the folder")
   00437|         || lower.contains("ls ");
   00438|     let reads_after = lower.contains("read")
   00439|         || lower.contains("contents")
   00440|         || lower.contains("content")
   00441|         || lower.contains("show me");
   00442|     lists_files && reads_after
   00443| }
   00444| 
   00445| fn asks_to_read_file_in_folder(lower: &str) -> bool {
   00446|     lower.contains("read the file") && (lower.contains(" folder") || lower.contains(" directory"))
   00447| }
   00448| 
   00449| fn selection_for_prompt(lower: &str) -> FileSelection {
   00450|     if lower.contains("last") {
   00451|         FileSelection::Last
   00452|     } else {
   00453|         FileSelection::First
   00454|     }
   00455| }
   00456| 
   00457| fn mode_for_prompt(prompt: &str) -> FileReadMode {
   00458|     // Inspection verbs are multilingual seed data, so normalization must fold
   00459|     // every script that has case rather than only ASCII. Otherwise a capitalized
   00460|     // Russian imperative misses the same semantic role its lowercase form hits.
   00461|     let lower = prompt.to_lowercase();
   00462|     if lower.contains("first line") {
   00463|         return FileReadMode::FirstLine;
   00464|     }
   00465|     if let Some(key) = extract_value_key(prompt) {
   00466|         return FileReadMode::ExtractValue(key);
   00467|     }
   00468|     if let Some(key) = exact::exact_line_key(prompt) {
   00469|         return FileReadMode::ExtractValue(key);
   00470|     }
   00471|     if seed::lexicon().mentions_role(seed::ROLE_WORKSPACE_INSPECTION_ACTION, &lower) {
   00472|         return FileReadMode::Audit;
   00473|     }
   00474|     if lower.contains("summarize") || lower.contains("summary") {
   00475|         return FileReadMode::Summary;
   00476|     }
   00477|     super::workspace_line_operation::line_slice(prompt)
   00478|         .map_or(FileReadMode::Full, FileReadMode::LineSlice)
   00479| }
   00480| 
   00481| fn extract_value_key(prompt: &str) -> Option<String> {
   00482|     let lower = prompt.to_ascii_lowercase();
   00483|     let marker = "value of ";
   00484|     let start = lower.find(marker)? + marker.len();
   00485|     let rest = &prompt[start..];
   00486|     let key = rest
   00487|         .split_whitespace()
   00488|         .next()
   00489|         .unwrap_or_default()
   00490|         .trim_matches(|c: char| !is_file_path_char(c));
   00491|     (!key.is_empty()).then(|| key.to_owned())
   00492| }
   00493| 
   00494| fn leading_cat_path(prompt: &str) -> Option<String> {
   00495|     let trimmed = prompt.trim().trim_matches('`').trim();
   00496|     let mut parts = trimmed.split_whitespace();
   00497|     let command = parts.next()?;
   00498|     if !command.eq_ignore_ascii_case("cat") {
   00499|         return None;
   00500|     }
   00501|     parts
   00502|         .next()
   00503|         .map(clean_file_token)
   00504|         .filter(|path| !path.is_empty())
   00505| }
   00506| 
   00507| fn first_local_file_path(prompt: &str) -> Option<String> {
   00508|     local_file_paths(prompt).into_iter().next()
   00509| }
   00510| 
   00511| fn local_file_paths(prompt: &str) -> Vec<String> {
   00512|     let mut paths = prompt
   00513|         .split_whitespace()
   00514|         .map(clean_file_token)
   00515|         .filter(|token| looks_like_local_file_path(token))
   00516|         .collect::<Vec<_>>();
   00517|     paths.dedup();
   00518|     paths
   00519| }
