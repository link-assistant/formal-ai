   00131| // The eight parameters are the read plan's own slots (path, mode, tool
   00132| // availability, prior records, request); bundling them would invent a struct
   00133| // only this planner reads.
   00134| #[allow(clippy::too_many_arguments)]
   00135| fn plan_direct_file_read(
   00136|     path: &str,
   00137|     mode: &FileReadMode,
   00138|     prefer_run: bool,
   00139|     read_tool: Option<&str>,
   00140|     run_tool: Option<&str>,
   00141|     grep_tool: Option<&str>,
   00142|     records: &[ToolResultRecord],
   00143|     request: &str,
   00144| ) -> AgenticPlan {
   00145|     if mode == &FileReadMode::Audit {
   00146|         return exact::plan_direct_file_reads(
   00147|             &[path.to_owned()],
   00148|             mode,
   00149|             read_tool,
   00150|             run_tool,
   00151|             grep_tool,
   00152|             records,
   00153|             request,
   00154|         );
   00155|     }
   00156|     let read_command = read_command_for(path, mode);
   00157|     let exact_run = exact::exact_line_key(request).is_some() && run_tool.is_some();
   00158|     let recorded = if exact_run {
   00159|         run_record_for_command(records, &read_command).map(|raw| {
   00160|             (
   00161|                 read_command.as_str(),
   00162|                 raw,
   00163|                 super::tool_result::strip_transport_envelope(raw),
   00164|             )
   00165|         })
   00166|     } else {
   00167|         read_result_for_path(records, path)
   00168|             .map(|raw| (path, raw, raw.to_owned()))
   00169|             .or_else(|| {
   00170|                 run_record_for_command(records, &read_command).map(|raw| {
   00171|                     (
   00172|                         read_command.as_str(),
   00173|                         raw,
   00174|                         super::tool_result::strip_transport_envelope(raw),
   00175|                     )
   00176|                 })
   00177|             })
   00178|     };
   00179|     if let Some((label, raw, content)) = recorded {
   00180|         if let Some(failure) = failed_step_answer(label, raw, request) {
   00181|             return AgenticPlan::Final(failure);
   00182|         }
   00183|         let content = if label == path {
   00184|             super::code_artifact::source_from_read_result(&content)
   00185|         } else {
   00186|             content
   00187|         };
   00188|         return AgenticPlan::Final(file_read_final_answer(
   00189|             mode,
   00190|             &[(path.to_owned(), content)],
   00191|             request,
   00192|         ));
   00193|     }
   00194| 
   00195|     if (prefer_run || exact_run)
   00196|         && let Some(tool) = run_tool
   00197|     {
   00198|         return plan_one(
   00199|             tool,
   00200|             json!({ "command": read_command_for(path, mode) }).to_string(),
   00201|         );
   00202|     }
   00203| 
   00204|     if let Some(tool) = read_tool {
   00205|         return plan_one(tool, read_arguments(path, mode));
   00206|     }
   00207|     if let Some(tool) = run_tool {
   00208|         return plan_one(
   00209|             tool,
   00210|             json!({ "command": read_command_for(path, mode) }).to_string(),
   00211|         );
   00212|     }
   00213| 
   00214|     AgenticPlan::Final(format!(
   00215|         "I can read `{path}` when the client advertises a file read tool or a shell tool."
   00216|     ))
   00217| }
