   00746| /// Build the audit query from semantic seed data. The one structural member is
   00747| /// an unchecked Markdown box: syntax rather than natural-language domain data.
   00748| fn file_analysis_pattern() -> String {
   00749|     let mut alternatives = vec![String::from(r"\[\s*\]")];
   00750|     alternatives.extend(
   00751|         seed::lexicon()
   00752|             .words_for_role(seed::ROLE_FILE_ANALYSIS_GAP_MARKER)
   00753|             .into_iter()
   00754|             .filter(|surface| !surface.trim().is_empty())
   00755|             .map(|surface| regex_escape(&surface)),
   00756|     );
   00757|     alternatives.sort();
   00758|     alternatives.dedup();
   00759|     format!("(?i)(?:{})", alternatives.join("|"))
   00760| }
   00761| 
   00762| fn regex_escape(surface: &str) -> String {
   00763|     surface
   00764|         .chars()
   00765|         .flat_map(|character| {
   00766|             if matches!(
   00767|                 character,
   00768|                 '.' | '+' | '*' | '?' | '(' | ')' | '|' | '[' | ']' | '{' | '}' | '^' | '$' | '\\'
   00769|             ) {
   00770|                 vec!['\\', character]
   00771|             } else {
   00772|                 vec![character]
   00773|             }
   00774|         })
   00775|         .collect()
   00776| }
