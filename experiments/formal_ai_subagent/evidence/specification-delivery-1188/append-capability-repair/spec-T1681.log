t_reference\\n    lexeme en first\\n    lexeme ru первый первого первую\\n    lexeme hi पहले पहली\\n    lexeme zh 第一个 第一\\n    lexeme es primero primera primer\\n  tool_result_second_reference\\n    defined-by concept\\n    role tool_result_second_reference\\n    lexeme en second\\n    lexeme ru второй второго вторую\\n    lexeme hi दूसरे दूसरी\\n    lexeme zh 第二个 第二\\n    lexeme es segundo segunda\\n  filesystem-absence\\n    defined-by observation\\n    role filesystem-absent-result\\n    lexeme en enoent \\\"file not found\\\" \\\"no such file\\\"\\n    lexeme ru \\\"файл не найден\\\" \\\"нет такого файла\\\"\\n    lexeme hi \\\"फ़ाइल नहीं मिली\\\" \\\"ऐसी कोई फ़ाइल नहीं\\\"\\n    lexeme zh 文件不存在 找不到文件\\n    lexeme es \\\"archivo no encontrado\\\" \\\"no existe el archivo\\\"\\n\"\n    command \"cat data/seed/meanings-tool-access.lino\"\n  verification_command \"cat data/seed/meanings-tool-access.lino\"\ngeneral_change_plan\n  id \"general_change_plan_cc1902b4b94199dc\"\n  execution_mode \"literal_file\"\n  terminal_state \"executed\"\n  goal \"Set the contents of js/agentic/general_execution.mjs to «// Execution state machine for a composed general change plan\\n// (rust/src/agentic_coding/general_execution.rs).\\n\\nimport { Capability } from './capability.mjs';\\nimport { isHostedResearchTool, shellCommandTool, toolFor } from './capability_router.mjs';\\nimport { attach, requestedIn } from './ci_workflow.mjs';\\nimport { executionRecipeFinalAnswer, planSymbolicCommandReroute } from './command_reroute.mjs';\\nimport { sourceFromReadResult } from './code_artifact.mjs';\\nimport { mentionsRoleRaw } from './write_lexicon.mjs';\\nimport { normalizePrompt } from './crate/engine.mjs';\\nimport { plainText } from './content.mjs';\\nimport {\\n  GeneralPlanMode, PLAN_PATH, composeGeneralChangePlan, planLinksNotation, plannedNotExecutedAnswer,\\n  repositoryWorkReference, shellQuote,\\n} from './general_planner.mjs';\\nimport { finalAnswer, jsonText, planOne, writeArguments } from './plan.mjs';\\nimport { guardedStep, isGuardRead } from './literal_write_guard.mjs';\\nimport { Progress, isWorkItemRead } from './progress.mjs';\\nimport { failedVerification, harnessReportedFailure, observedPayload, reportedExitCode, renderFailure } from './tool_result.mjs';\\nimport { fill } from './work_item_steps.mjs';\\nimport { programContractAnswer } from './crate/coding_program_contract.mjs';\\nimport { fencedBlock, LINO_FENCE_LANGUAGE } from './crate/issue_report.mjs';\\nimport { detect } from './crate/language.mjs';\\nimport { localizedResponse } from './crate/seed.mjs';\\nimport { isAsciiDigit, splitWhitespace, trim, trimEndMatches, charIn } from './write_str.mjs';\\n\\n/**\\n * Mirrors `fn plan_general_change_step`.\\n * @param {Array<object>} messages\\n * @param {Array<string>} toolNames\\n * @param {object} plan a `GeneralChangePlan` (general_planner.mjs)\\n */\\nexport function planGeneralChangeStep(messages, toolNames, plan) {\\n  return generalChangeStep(messages, toolNames, plan, false);\\n}\\n\\n/** Mirrors `fn plan_work_item_change_step`. */\\nexport function planWorkItemChangeStep(messages, toolNames, plan) {\\n  return generalChangeStep(messages, toolNames, plan, true);\\n}\\n\\nconst command = (text) => jsonText({ command: text });\\n\\nfunction generalChangeStep(messages, toolNames, plan, resolvedFromWorkItem) {\\n  // A literal-file write reads its target first unless the request names a\\n  // whole-file write, and never replaces an existing file unasked (PR #1188 T96).\\n  const guarded = guardedStep(plan, messages, toolNames);\\n  if (guarded !== null) return guarded;\\n  const progress = Progress.scan(messages);\\n  const latestFailure = progress.latestFailure();\\n  const workItemUnreadable = plan.mode === GeneralPlanMode.RepositoryWorkItem\\n    && latestFailure !== null\\n    && (latestFailure.capability === Capability.Fetch || isWorkItemRead(latestFailure));\\n  const targetMissing = latestFailure !== null && isGuardRead(plan,\\n    latestFailure.arguments === null || latestFailure.arguments === undefined ? null : toolArgumentPath(latestFailure.arguments),\\n    latestFailure.capability);\\n  const eventMissing = latestFailure !== null && latestFailure.capability === Capability.Read\\n    && toolArgumentPath(latestFailure.arguments) === PLAN_PATH && absentPlanEvent(latestFailure.detail);\\n  const failure = workItemUnreadable || targetMissing || eventMissing ? null : latestFailure;\\n  if (failure) {\\n    if (failure.capability === Capability.Write) {\\n      const path = failure.arguments === null || failure.arguments === undefined ? null : toolArgumentPath(failure.arguments);\\n      const readTool = toolFor(toolNames, Capability.Read);\\n      if (path !== null && readTool && progress.failedWriteCountFor(path) === 1) {\\n        return planOne(readTool, readArguments(path));\\n      }\\n      const writeTool = toolFor(toolNames, Capability.Write);\\n      if (path === PLAN_PATH && plan.mode === GeneralPlanMode.LiteralFile && !readTool\\n        && progress.failedWriteCountFor(PLAN_PATH) === 1 && writeTool) {\\n        return planOne(writeTool, writeArguments(plan.target, plan.content));\\n      }\\n      const runTool = shellCommandTool(toolNames);\\n      if (plan.mode !== GeneralPlanMode.RepositoryWorkItem && trim(plan.verification_command) !== ''\\n        && progress.runCountFor(plan.verification_command) === 0 && runTool) {\\n        return planOne(runTool, command(plan.verification_command));\\n      }\\n      return finalAnswer(renderFailure(path ?? 'write', failure.detail, plan.goal));\\n    }\\n    if (failure.capability === Capability.Run) {\\n      const output = progress.latestRunOutputFor(plan.verification_command);\\n      const report = output === null || output === undefined\\n        ? null\\n        : failedVerification([output], plan.verification_command, plan.goal);\\n      if (report !== null && report !== undefined) return finalAnswer(report);\\n    }\\n    const previous = progress.previousAttempt();\\n    const recoveringMissingWrite = failure.capability === Capability.Read\\n      && Boolean(previous) && previous.capability === Capability.Write && !previous.succeeded;\\n    if (!recoveringMissingWrite) {\\n      return finalAnswer(renderFailure(capabilityLabel(failure.capability), failure.detail, plan.goal));\\n    }\\n  }\\n  const previous = progress.previousAttempt();\\n  const recoveringWrite = progress.last() === Capability.Read\\n    && Boolean(previous) && previous.capability === Capability.Write && !previous.succeeded;\\n  if (recoveringWrite) {\\n    const tool = toolFor(toolNames, Capability.Write);\\n    const args = previous.arguments;\\n    if (tool && args !== null && args !== undefined) return planOne(tool, args);\\n  }\\n  if (plan.mode === GeneralPlanMode.RepositoryWorkItem) {\\n    const fetched = repositoryWorkItemObjective(plan, progress);\\n    if (fetched !== null) {\\n      const step = planWorkItemExecution(fetched, messages, toolNames);\\n      if (step) return step;\\n    } else {\\n      const step = planWorkItemRead(messages, toolNames, plan.target, progress);\\n      if (step) return step;\\n    }\\n    const report = workItemReadFailureReport(plan, progress);\\n    if (report !== null) return finalAnswer(report);\\n  }\\n  const eventStep = planEventStep(plan, progress, toolNames);\\n  if (eventStep !== null) return eventStep;\\n  const writeTool = toolFor(toolNames, Capability.Write);\\n  if (writeTool && plan.mode === GeneralPlanMode.LiteralFile && !progress.successfulWriteFor(plan.target)) {\\n    return planOne(writeTool, writeArguments(plan.target, plan.content));\\n  }\\n  const runTool = shellCommandTool(toolNames);\\n  if (runTool) {\\n    if (plan.mode === GeneralPlanMode.CommandOutput) {\\n      const generation = plan.steps[1]?.command ?? null;\\n      if (generation !== null) {\\n        if (progress.successfulRunCountFor(generation) === 0) return planOne(runTool, command(generation));\\n        if (progress.successfulRunCountFor(plan.verification_command) === 0) {\\n          return planOne(runTool, command(plan.verification_command));\\n        }\\n      }\\n    } else if (plan.mode === GeneralPlanMode.LiteralFile && progress.successfulRunCountFor(plan.verification_command) === 0) {\\n      return planOne(runTool, command(plan.verification_command));\\n    }\\n  }\\n  return finishGeneralChange(plan, progress, resolvedFromWorkItem);\\n}\\n\\n// The event stream is an observed artifact: generic Write replaces bytes, so\\n// read its previous contents before composing an append and verify afterwards.\\nfunction absentPlanEvent(detail) {\\n  return mentionsRoleRaw('filesystem-absent-result', normalizePrompt(detail));\\n}\\n\\nfunction planEventAppendCommand(plan) {\\n  const event = planLinksNotation(plan);\\n  const identity = event.split('\\\\n')[1];\\n  const path = shellQuote(PLAN_PATH);\\n  return 'mkdir -p -- .formal-ai && ('\\n    + 'if [ -f ' + path + ' ]; then grep -Fqx -- ' + shellQuote(identity) + ' ' + path + '; status=$?; '\\n    + '[ \\\"$status\\\" -le 1 ] || exit \\\"$status\\\"; else status=1; fi; '\\n    + 'if [ \\\"$status\\\" -eq 1 ]; then printf \\\\'\\\\\\\\n%s\\\\' ' + shellQuote(event) + ' >> ' + path + ' || exit $?; fi; '\\n    + 'cat -- ' + path + ')';\\n}\\n\\nfunction unverifiedPlanEvent(plan) {\\n  return finalAnswer(generalPlanUnverified({ ...plan, target: PLAN_PATH, verification_command: 'cat ' + PLAN_PATH }));\\n}\\n\\nfunction planEventStep(plan, progress, toolNames) {\\n  const event = planLinksNotation(plan);\\n  const identity = event.split('\\\\n')[1];\\n  const read = toolFor(toolNames, Capability.Read);\\n  const write = toolFor(toolNames, Capability.Write);\\n  if (read && write) {\\n    const output = progress.successfulReadOutputFor(PLAN_PATH);\\n    const prior = output === null ? null : sourceFromReadResult(output);\\n    const expected = progress.successfulWriteContentFor(PLAN_PATH);\\n    if (expected !== null) {\\n      if (prior !== null && prior.startsWith(expected)) return null;\\n      if (progress.last() === Capability.Read\\n        && toolArgumentPath(progress.latestSuccessfulArguments(Capability.Read)) === PLAN_PATH) return unverifiedPlanEvent(plan);\\n      return planOne(read, readArguments(PLAN_PATH));\\n    }\\n    if (prior !== null && prior.split('\\\\n').includes(identity)) return prior.includes(event) ? null : unverifiedPlanEvent(plan);\\n    const failure = progress.latestFailure();\\n    const missing = failure !== null && failure.capability === Capability.Read\\n      && toolArgumentPath(failure.arguments) === PLAN_PATH && absentPlanEvent(failure.detail);\\n    if (prior === null && !missing) return planOne(read, readArguments(PLAN_PATH));\\n    const before = prior ?? '';\\n    const separator = before !== '' && !before.endsWith('\\\\n') ? '\\\\n' : '';\\n    return planOne(write, writeArguments(PLAN_PATH, before + separator + event));\\n  }\\n  const run = shellCommandTool(toolNames);\\n  if (!run) return finalAnswer(plannedNotExecutedAnswer(plan));\\n  const append = planEventAppendCommand(plan);\\n  if (progress.successfulRunCountFor(append) === 0) return planOne(run, command(append));\\n  const raw = progress.latestSuccessfulRunOutputFor(append);\\n  const observed = raw === null ? null : observedPayload(raw);\\n  return observed !== null && observed.includes(trim(event)) ? null : unverifiedPlanEvent(plan);\\n}\\n\\n/**\\n * Mirrors `fn plan_work_item_execution`.\\n *\\n * Partial: rust/src/solver.rs `UniversalSolver::default().solve` is consulted\\n * only for the `execution_recipe` its answer carries. The solver's first\\n * recipe-bearing arm, `coding::program_contract::answer`, is ported\\n * (crate/coding_program_contract.mjs) and used here; the later catalog\\n * `write_program` recipe arm is native-only, so a work item only that arm\\n * would answer falls through to the literal-file composer.\\n */\\nfunction planWorkItemExecution(objective, messages, toolNames) {\\n  const answer = workItemSolverAnswer(objective);\\n  if (answer && answer.execution_recipe && requestedIn(objective)) attach(answer.execution_recipe);\\n  const step = answer ? planSymbolicCommandReroute(messages, toolNames, answer) : null;\\n  if (step) return step;\\n  const executable = composeGeneralChangePlan(objective);\\n  if (!executable || executable.mode === GeneralPlanMode.RepositoryWorkItem) return null;\\n  return planWorkItemChangeStep(messages, toolNames, executable);\\n}\\n\\nfunction workItemSolverAnswer(objective) {\\n  return programContractAnswer(objective);\\n}\\n\\nfunction planWorkItemRead(messages, toolNames, target, progress) {\\n  const fetch = toolFor(toolNames, Capability.Fetch);\\n  if (fetch && isHostedResearchTool(fetch)) {\\n    return progress.attemptedFetchOf(target) ? null : planOne(fetch, workItemFetchArguments(target));\\n  }\\n  const run = shellCommandTool(toolNames);\\n  if (!progress.attemptedWorkItemReadOf(target) && run) return planOne(run, command(issueViewCommand(target)));\\n  if (!progress.attemptedFetchOf(target) && fetch) return planOne(fetch, workItemFetchArguments(target));\\n  if (run) {\\n    for (const fallback of [issueRestReadCommand(target), issueApiReadCommand(target)]) {\\n      if (fallback !== null && !progress.hasRun(fallback)) return planOne(run, command(fallback));\\n    }\\n  }\\n  const preparedPull = preparedPullReference(messages);\\n  if (preparedPull !== null && preparedPull !== target && !progress.attemptedFetchOf(preparedPull) && fetch) {\\n    return planOne(fetch, workItemFetchArguments(preparedPull));\\n  }\\n  return null;\\n}\\n\\nfunction preparedPullReference(messages) {\\n  const user = [...messages].reverse().find((message) => message.role.toLowerCase() === 'user');\\n  if (!user) return null;\\n  for (const token of splitWhitespace(plainText(user.content))) {\\n    const reference = repositoryWorkReference(token);\\n    if (reference !== null && reference.split('/').reverse()[1] === 'pull') return reference;\\n  }\\n  return null;\\n}\\n\\nfunction workItemFetchArguments(target) {\\n  return jsonText({ url: target, format: 'text', prompt: fill('issue_fetch_prompt', []) });\\n}\\n\\n/** Mirrors `fn issue_view_command`. @param {string} target */\\nexport function issueViewCommand(target) {\\n  const kind = trimEndMatches(target, charIn('/')).split('/').reverse()[1] === 'pull' ? 'pr' : 'issue';\\n  return fill('issue_view_command', [['{kind}', kind], ['{target}', shellQuote(target)]]);\\n}\\n\\nfunction restSegments(target) {\\n  const segments = trimEndMatches(target, charIn('/')).split('/').reverse();\\n  if (segments.length < 4) return null;\\n  const [number, kindSegment, repo, owner] = segments;\\n  let kind;\\n  if (kindSegment === 'issue' || kindSegment === 'issues') kind = 'issues';\\n  else if (kindSegment === 'pull' || kindSegment === 'pulls') kind = 'pulls';\\n  else return null;\\n  if (!number || !Array.from(number).every(isAsciiDigit)) return null;\\n  return [owner, repo, kind, number];\\n}\\n\\nfunction restCommand(key, target) {\\n  const segments = restSegments(target);\\n  if (!segments) return null;\\n  const [owner, repo, kind, number] = segments;\\n  return fill(key, [['{owner}', owner], ['{repo}', repo], ['{kind}', kind], ['{number}', number]]);\\n}\\n\\nfunction issueRestReadCommand(target) {\\n  return restCommand('issue_rest_read_command', target);\\n}\\n\\nfunction issueApiReadCommand(target) {\\n  return restCommand('issue_api_read_command', target);\\n}\\n\\nfunction workItemReadFailureReport(plan, progress) {\\n  if (!progress.failedWorkItemReadOf(plan.target)) return null;\\n  const attempts = progress.workItemReadAttempts(plan.target);\\n  if (!attempts.length) return null;\\n  return fill('read_failed_report', [['{target}', plan.target], ['{attempts}', attempts.join('\\\\n')]]);\\n}\\n\\nfunction repositoryWorkItemObjective(plan, progress) {\\n  const found = prog