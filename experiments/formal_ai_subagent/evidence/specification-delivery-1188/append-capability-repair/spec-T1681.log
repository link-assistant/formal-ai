e_line_moved_end_en\n    intent line_moved_end\n    language en\n    text \"Moved `{old}` to the end of `{path}` and observed the result.\"\n  response response_line_moved_end_ru\n    intent line_moved_end\n    language ru\n    text \"Строка `{old}` перемещена в конец `{path}`, результат проверен.\"\n  response response_line_moved_end_hi\n    intent line_moved_end\n    language hi\n    text \"`{old}` को `{path}` के अंत में ले जाया और परिणाम सत्यापित किया।\"\n  response response_line_moved_end_zh\n    intent line_moved_end\n    language zh\n    text \"已将 `{old}` 移到 `{path}` 的末尾并验证了结果。\"\n  response response_line_moved_end_es\n    intent line_moved_end\n    language es\n    text \"Se movió `{old}` al final de `{path}` y se verificó el resultado.\"\n  response response_line_moved_after_en\n    intent line_moved_after\n    language en\n    text \"Moved `{old}` after `{anchor}` in `{path}` and observed the result.\"\n  response response_line_moved_after_ru\n    intent line_moved_after\n    language ru\n    text \"В `{path}` строка `{old}` перемещена после `{anchor}`, результат проверен.\"\n  response response_line_moved_after_hi\n    intent line_moved_after\n    language hi\n    text \"`{path}` में `{old}` को `{anchor}` के बाद ले जाया और परिणाम सत्यापित किया।\"\n  response response_line_moved_after_zh\n    intent line_moved_after\n    language zh\n    text \"已在 `{path}` 中将 `{old}` 移到 `{anchor}` 之后并验证了结果。\"\n  response response_line_moved_after_es\n    intent line_moved_after\n    language es\n    text \"Se movió `{old}` después de `{anchor}` en `{path}` y se verificó el resultado.\"\n  response response_line_moved_before_en\n    intent line_moved_before\n    language en\n    text \"Moved `{old}` before `{anchor}` in `{path}` and observed the result.\"\n  response response_line_moved_before_ru\n    intent line_moved_before\n    language ru\n    text \"В `{path}` строка `{old}` перемещена перед `{anchor}`, результат проверен.\"\n  response response_line_moved_before_hi\n  