composeGeneralChangePlan(request);\\n  const step = planGeneralChangeStep([{ role: 'user', content: request }], ['write'], plan);\\n  assert.equal(step.kind, 'final');\\n  assert.match(step.answer, /not executed/u);\\n});\\n\"\n    command \"cat rust/tests/web/general-plan-event-append.test.mjs\"\n  verification_command \"cat rust/tests/web/general-plan-event-append.test.mjs\"\ngeneral_change_plan\n  id \"general_change_plan_4235e733bcd8f7c1\"\n  execution_mode \"literal_file\"\n  terminal_state \"executed\"\n  goal \"Create changelog.d/20261009_233000_shared-rename-reasons.md with exactly this content: «---\\nbump: patch\\n---\\n\\nState a common rename reason once on its tree and inherit it for each record. Per-record reasons override the shared value, and a new tree resets it. This preserves rename provenance while removing eight duplicate metadata fields. Twelve focused rename-rule checks pass; the metadata repeated-field ratchet returns from 81 to 80.\\n»\"\n  target \"changelog.d/20261009_233000_shared-rename-reasons.md\"\n  step 1\n    capability \"Write\"\n    action \"append the composed plan to .formal-ai/general-change-plan.lino\"\n    expected_evidence \"written plan event impulse_fef20fe3c909d7f1\"\n  step 2\n    capability \"Write\"\n    action \"write the requested content to changelog.d/20261009_233000_shared-rename-reasons.md\"\n    expected_evidence \"workspace file changelog.d/20261009_233000_shared-rename-reasons.md\"\n  step 3\n    capability \"Run\"\n    action \"run the request-derived verification command\"\n    expected_evidence \"---\\nbump: patch\\n---\\n\\nState a common rename reason once on its tree and inherit it for each record. Per-record reasons override the shared value, and a new tree resets it. This preserves rename provenance while removing eight duplicate metadata fields. Twelve focused rename-rule checks pass; the metadata repeated-field ratchet returns from 81 to 80.\\n\"\n    command \"cat changelog.d/20261009_233000_shared-