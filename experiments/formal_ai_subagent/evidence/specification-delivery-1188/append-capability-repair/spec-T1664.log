   00425| 
   00426| /// A **read** request must never compose a write plan (found by the issue-#671
   00427| /// matrix on the `opencode` leg).
   00428| ///
   00429| /// `formal-ai with opencode "read the file alpha.txt and print its contents"`
   00430| /// planned `write(alpha.txt)` and overwrote the fixture with a stray quote
   00431| /// character before "verifying" it with `cat alpha.txt`. The marker-led branch
   00432| /// of the write recogniser accepted `file alpha.txt` (a positional target cue)
   00433| /// plus the trailing content lead `contents`, with no write action cue anywhere
   00434| /// in the request — so a request whose only verbs were `read` and `print`
   00435| /// destroyed the file it was asked to read. Codex escaped only because its
   00436| /// toolset advertises no plain write tool, which is exactly the "inferred from
   00437| /// the shared adapters" reasoning issue #671 exists to reject.
   00438| #[test]
   00439| fn agentic_general_planner_never_claims_a_read_request() {
   00440|     for request in [
   00441|         "read the file alpha.txt and print its contents",
   00442|         "\"read the file alpha.txt and print its contents\"",
   00443|         "show me the contents of the file beta.md",
   00444|         "print the contents of subdir/nested.log",
   00445|     ] {
   00446|         assert!(
   00447|             compose_general_change_plan(request).is_none(),
   00448|             "a read request must not compose a write plan: {request}",
   00449|         );
   00450|     }
   00451| }
   00452| 
   00453| /// Content recovered from a request has to be *content*. The `opencode` leg's
   00454| /// overwrite payload was a single `"` — the tail left over after the trailing
   00455| /// content-lead marker in a quoted prompt. A payload with nothing to say is a
   00456| /// mis-parse, not a write.
   00457| #[test]
   00458| fn agentic_general_planner_rejects_punctuation_only_payload() {
   00459|     for request in [
   00460|         "write file notes/empty.txt containing \"",
   00461|         "create file notes/dots.txt with text ...",
   00462|     ] {
   00463|         assert!(
   00464|             compose_general_change_plan(request).is_none(),
   00465|             "a payload with no word characters must not compose a write: {request}",
   00466|         );
   00467|     }
   00468| }
   00469| 
   00470| /// A multi-line payload is written whole, whichever line the marker ends on.
   00471| ///
   00472| /// The content lead alone on its line already introduced the whole block below
   00473| /// it. The same request with the payload starting on the marker's own line means
   00474| /// exactly the same thing, but the sentence bound cut it at the first line: a
   00475| /// 1478-byte document was written as its 58-byte title, and `alpha\nbeta\ngamma`
   00476| /// was written as `alpha`. Nothing in the request said the rest would be
   00477| /// dropped, and the write reported success, so the self-authoring loop produced
   00478| /// one-line stubs of the documents it was handed and looked broken for a reason
   00479| /// that was never in its own logs.
   00480| ///
   00481| /// Both spellings are pinned to the identical result, so neither can drift back
   00482| /// into truncating the other. The one-line payload keeps the sentence bound --
   00483| /// "write the following: hello to `x.txt`" must still stop at the clause.
   00484| #[test]
   00485| fn a_multi_line_payload_survives_a_marker_that_shares_its_line() {
   00486|     let body = "alpha\nbeta\ngamma";
   00487|     let inline = compose_general_change_plan(&format!(
   00488|         "Create a file out.md with exactly this content: {body}"
   00489|     ))
   00490|     .expect("an inline multi-line payload must compose a plan");
   00491|     let own_line = compose_general_change_plan(&format!(
   00492|         "Create a file out.md with exactly this content:\n{body}"
   00493|     ))
   00494|     .expect("a marker-led block must compose a plan");
   00495| 
   00496|     assert_eq!(
   00497|         inline.content, body,
   00498|         "the payload must survive whole when the marker shares its first line"
   00499|     );
   00500|     assert_eq!(
   00501|         inline.content, own_line.content,
   00502|         "the two spellings of one request must deliver the same bytes"
   00503|     );
   00504| 
   00505|     // A payload that never leaves its line is unaffected: there is no
   00506|     // continuation to widen to, so it still stops where it always did.
   00507|     let bounded = compose_general_change_plan(EN_TASK)
   00508|         .expect("a single-line payload must still compose a plan");
   00509|     assert_eq!(
   00510|         bounded.content, "planner fallback works",
   00511|         "a payload that stays on one line is bounded exactly as before"
   00512|     );
   00513| }
