   00066| #[test]
   00067| fn compound_github_work_item_routes_to_agentic_planning_before_project_lookup() {
   00068|     let messages = vec![ChatMessage::user(ISSUE_698_WORK_ITEM)];
   00069|     let tools = ["web_search", "web_fetch", "write_file", "run_command"];
   00070|     let AgenticPlan::ToolCalls(calls) =
   00071|         plan_chat_step(&messages, &tools).expect("compound work item must have an agentic plan")
   00072|     else {
   00073|         panic!("the first work-item step must read the work item")
   00074|     };
   00075| 
   00076|     assert_eq!(calls.len(), 1);
   00077|     // A work item names an issue, and an issue URL names no artifact, so the
   00078|     // run reads the work item before deciding what it can execute (issue #904,
   00079|     // follow-up). A protocol-hosted fetch tool runs the read server-side
   00080|     // (issue #1133), so it comes first when the client has one; the structured
   00081|     // `gh` read is the path for shell-only clients. The plan record is still
   00082|     // written; it is no longer the first and only thing the run does.
   00083|     assert_eq!(calls[0].tool, "web_fetch");
   00084|     assert!(calls[0].arguments.contains("issues/698"), "{calls:?}");
   00085| 
   00086|     // A client with a shell but no fetch tool reads the work item through
   00087|     // `gh issue view` before anything is recorded (issue #1133).
   00088|     let write_only = plan_chat_step(&messages, &["write_file", "run_command"]);
   00089|     let Some(AgenticPlan::ToolCalls(write_only)) = write_only else {
   00090|         panic!("a write-only client still reads the work item")
   00091|     };
   00092|     assert_eq!(write_only[0].tool, "run_command");
   00093|     assert!(
   00094|         write_only[0].arguments.contains("gh issue view"),
   00095|         "{write_only:?}"
   00096|     );
   00097|     // An empty read is a failed read (issue #1155): the REST fallbacks are
   00098|     // walked next, and once every route has answered nothing the run closes
   00099|     // with the reads it tried instead of spending its write on a plan record
   00100|     // for an issue it never saw.
   00101|     let mut after_read = messages;
   00102|     let mut planned = vec![write_only[0].clone()];
   00103|     let report = loop {
   00104|         let step = planned.len();
   00105|         let call = &planned[step - 1];
   00106|         after_read.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00107|             format!("c{step}"),
   00108|             call.tool.clone(),
   00109|             call.arguments.clone(),
   00110|         )]));
   00111|         after_read.push(ChatMessage::tool_result(format!("c{step}"), &call.tool, ""));
   00112|         match plan_chat_step(&after_read, &["write_file", "run_command"]) {
   00113|             Some(AgenticPlan::ToolCalls(calls)) if step < 6 => planned.push(calls[0].clone()),
   00114|             Some(AgenticPlan::Final(report)) => break report,
   00115|             other => panic!("the exhausted read closes with a report, got {other:?}"),
   00116|         }
   00117|     };
   00118|     assert!(
   00119|         planned
   00120|             .iter()
   00121|             .any(|call| call.tool == "run_command" && call.arguments.contains("curl -fsSL")),
   00122|         "the credential-free REST read is a fallback: {planned:?}"
   00123|     );
   00124|     assert!(
   00125|         planned
   00126|             .iter()
   00127|             .all(|call| call.tool == "run_command" && !call.arguments.contains(PLAN_PATH)),
   00128|         "no plan record is written for an unread work item: {planned:?}"
   00129|     );
   00130|     assert!(report.contains("could not be read"), "{report}");
   00131| 
   00132|     let outcome = run_agentic_task(ISSUE_698_WORK_ITEM).expect("Agent CLI work-item replay");
   00133|     assert!(!outcome.hit_turn_cap);
   00134|     // Two steps: the run reads the work item through its hosted fetch and
   00135|     // records it. Issue #904 removed the `cat .formal-ai/general-change-plan.lino`
   00136|     // step, which verified nothing but the write the same run had just
   00137|     // performed, and that step has not come back; the hosted-fetch read also
   00138|     // replaced the `gh` plan the driver's default-deny sandbox refused.
   00139|     assert_eq!(
   00140|         outcome
   00141|             .steps
   00142|             .iter()
   00143|             .map(|step| step.tool.as_str())
   00144|             .collect::<Vec<_>>(),
   00145|         ["web_fetch", "write_file"]
   00146|     );
   00147|     assert!(outcome.steps[1].arguments.contains(PLAN_PATH));
   00148|     assert!(outcome.final_answer.contains("Planned, not executed"));
   00149|     assert!(!outcome.final_answer.contains("project lookup"));
   00150| }
