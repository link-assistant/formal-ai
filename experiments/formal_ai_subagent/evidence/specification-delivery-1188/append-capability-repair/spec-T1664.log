   00408| #[test]
   00409| fn general_change_plan_fixture_pins_the_shape() {
   00410|     let fixture = include_str!("../../../../data/meta/general-change-plan.lino");
   00411|     for field in [
   00412|         "goal",
   00413|         "ordered_steps",
   00414|         "capability",
   00415|         "expected_evidence",
   00416|         "verification_command",
   00417|         "append_before_execute",
   00418|         "terminal_state",
   00419|         "no_self_verification",
   00420|         "planned_not_executed",
   00421|     ] {
   00422|         assert!(fixture.contains(field), "missing {field}");
