   00328| fn compose_repository_work_plan(request: &str) -> Option<GeneralChangePlan> {
   00329|     let target = repository_work_reference(request)?;
   00330|     // Hive Mind's objective field (`Issue to solve: <url>`, then the prepared
   00331|     // branch and "Proceed.") carries its verb in the delimiter, which
   00332|     // `objective_text` has already stripped. An objective that opens with the
   00333|     // work-item reference itself is therefore that field: the reference is
   00334|     // the request (issues #1154 and #1155 replay this exact prompt).
   00335|     let opens_with_reference = request
   00336|         .split_whitespace()
   00337|         .next()
   00338|         .and_then(repository_work_reference)
   00339|         .is_some();
   00340|     if !opens_with_reference && !mentions_bare_role(request, seed::ROLE_SOFTWARE_AUTHORING_ACTION) {
   00341|         return None;
   00342|     }
   00343|     let response_language = language(request);
   00344|     let intent = formalize_intent(request, response_language, None);
   00345|     Some(GeneralChangePlan {
   00346|         id: stable_id(
   00347|             "repository_work_item_plan",
   00348|             &format!("{}:{target}", intent.impulse_id),
   00349|         ),
   00350|         mode: GeneralPlanMode::RepositoryWorkItem,
   00351|         goal: intent.source_text,
   00352|         target: target.clone(),
   00353|         content: String::new(),
   00354|         // A work item names an issue, not an artifact, so step one reads the
   00355|         // issue — that text is where the artifact is named, and planning
   00356|         // without it would fabricate one (issue #904, follow-up). Recording the
   00357|         // reference stays step two, and the plan still names no verification
   00358|         // command: reading back the record this run wrote observes only its own
   00359|         // write.
   00360|         steps: vec![
   00361|             work_item_step(Capability::Fetch, "read", response_language, &target),
   00362|             work_item_step(Capability::Write, "action", response_language, PLAN_PATH),
   00363|         ],
   00364|         verification_command: String::new(),
   00365|         terminal_state: PlanTerminalState::PlannedNotExecuted,
   00366|     })
   00367| }
   00368| /// One step of a repository work-item plan, with its seeded action and
   00369| /// evidence. `slug` is `read` (the fetch of the work item) or `action` (the
   00370| /// record written afterwards).
   00371| fn work_item_step(capability: Capability, slug: &str, lang: &str, target: &str) -> GeneralPlanStep {
   00372|     let evidence = if slug == "read" {
   00373|         "general_plan_repository_read_evidence"
   00374|     } else {
   00375|         "general_plan_repository_evidence"
   00376|     };
   00377|     GeneralPlanStep {
   00378|         capability,
   00379|         action: command_plan_text(&format!("general_plan_repository_{slug}"), lang, target),
   00380|         expected_evidence: command_plan_text(evidence, lang, target),
   00381|         command: None,
   00382|     }
   00383| }
   00384| /// Extract a concrete GitHub issue or pull-request URL structurally.
   00385| ///
   00386| /// The software action itself comes from the multilingual seed. URL host/path
   00387| /// segments are protocol identifiers, not natural-language routing phrases.
   00388| pub(super) fn repository_work_reference(request: &str) -> Option<String> {
   00389|     request.split_whitespace().find_map(|token| {
   00390|         // Sentence punctuation in any registered script: a URL that ends a
   00391|         // Chinese sentence carries `。` the way an English one carries `.`.
   00392|         let url = token.trim_matches(|character: char| {
   00393|             matches!(
   00394|                 character,
   00395|                 '<' | '>'
   00396|                     | '('
   00397|                     | ')'
   00398|                     | '['
   00399|                     | ']'
   00400|                     | '{'
   00401|                     | '}'
   00402|                     | ','
   00403|                     | ';'
   00404|                     | '.'
   00405|                     | '"'
   00406|                     | '\''
   00407|                     | '。'
   00408|                     | '，'
   00409|                     | '、'
   00410|                     | '；'
   00411|                     | '：'
   00412|                     | '（'
   00413|                     | '）'
   00414|                     | '「'
   00415|                     | '」'
   00416|                     | '«'
   00417|                     | '»'
   00418|                     | '।'
   00419|             )
   00420|         });
   00421|         let path = url
   00422|             .strip_prefix("https://github.com/")
   00423|             .or_else(|| url.strip_prefix("http://github.com/"))?;
   00424|         let segments: Vec<&str> = path.split('/').collect();
   00425|         (segments.len() == 4
   00426|             && !segments[0].is_empty()
   00427|             && !segments[1].is_empty()
   00428|             && matches!(segments[2], "issues" | "pull")
   00429|             && segments[3]
   00430|                 .chars()
   00431|                 .all(|character| character.is_ascii_digit()))
   00432|         .then(|| url.to_owned())
   00433|     })
   00434| }
   00435| /// Recover a command-output file request from a structural, seed-backed frame.
   00436| ///
   00437| /// The command must immediately follow a seed-defined run verb and be enclosed
   00438| /// in single quotes, double quotes, or backticks. The suffix must name a
   00439| /// seed-defined command-output reference, a file-write action, and a safe target
   00440| /// introduced by a write target/destination cue. Requiring every element keeps
   00441| /// an incidental quoted phrase or filename from becoming executable.
   00442| fn parse_command_output_request(request: &str) -> Option<(String, String)> {
