   00444|     let run_verbs = seed::terminal_command_vocabulary().run_verbs;
   00445|     let actions = bare_surfaces(seed::ROLE_FILE_WRITE_ACTION_CUE);
   00446|     let targets = bare_surfaces(seed::ROLE_FILE_WRITE_TARGET_CUE);
   00447|     let destinations = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);
   00448|     for run in toks
   00449|         .iter()
   00450|         .filter(|token| run_verbs.contains(&clean_cue_token(token.text)))
   00451|     {
   00452|         let tail = request.get(run.end..)?;
   00453|         let leading = tail.len() - tail.trim_start().len();
   00454|         let quoted = tail.get(leading..)?;
   00455|         let quote = quoted.chars().next()?;
   00456|         if !matches!(quote, '\'' | '"' | '`') {
   00457|             continue;
   00458|         }
   00459|         let body = quoted.get(quote.len_utf8()..)?;
   00460|         let Some(close) = body.find(quote) else {
   00461|             continue;
   00462|         };
   00463|         let command = body.get(..close)?.trim();
   00464|         if command.is_empty() || command.contains(['\n', '\r', '\0']) {
   00465|             continue;
   00466|         }
   00467|         let suffix_offset = run.end + leading + quote.len_utf8() + close + quote.len_utf8();
   00468|         let suffix = request.get(suffix_offset..)?;
   00469|         if !mentions_bare_role(suffix, seed::ROLE_FILE_WRITE_COMMAND_OUTPUT_REFERENCE) {
   00470|             continue;
   00471|         }
   00472|         let suffix_tokens = tokens(suffix);
   00473|         let has_write_action = suffix_tokens
   00474|             .iter()
   00475|             .any(|token| actions.contains(&clean_cue_token(token.text)));
   00476|         if !has_write_action {
   00477|             continue;
   00478|         }
   00479|         let target = suffix_tokens.iter().enumerate().find_map(|(index, token)| {
   00480|             let cleaned = clean_path_token(token.text);
   00481|             let looks_like_file = looks_like_file_path(cleaned);
   00482|             let previous = index
   00483|                 .checked_sub(1)
   00484|                 .map(|position| &suffix_tokens[position])?;
   00485|             let cue = clean_cue_token(previous.text);
   00486|             (looks_like_file
   00487|                 && safe_relative_path(cleaned)
   00488|                 && (targets.contains(&cue) || destinations.contains(&cue)))
   00489|             .then(|| cleaned.to_owned())
   00490|         });
   00491|         if let Some(target) = target {
   00492|             return Some((target, command.to_owned()));
   00493|         }
   00494|     }
   00495|     None
   00496| }
   00497| pub(super) fn mentions_bare_role(text: &str, role: &str) -> bool {
   00498|     let lower = text.to_lowercase();
   00499|     seed::lexicon()
   00500|         .role_word_forms(role)
   00501|         .iter()
   00502|         .filter(|form| form.slot() == Slot::Bare)
   00503|         .any(|form| {
   00504|             let needle = form.text.to_lowercase();
   00505|             let Some(start) = lower.find(&needle) else {
   00506|                 return false;
   00507|             };
   00508|             if !needle.is_ascii() {
   00509|                 return true;
   00510|             }
   00511|             let end = start + needle.len();
   00512|             let before_ok = start == 0
   00513|                 || lower[..start]
   00514|                     .chars()
   00515|                     .next_back()
   00516|                     .is_some_and(|character| !character.is_alphanumeric());
   00517|             let after_ok = end == lower.len()
   00518|                 || lower[end..]
   00519|                     .chars()
   00520|                     .next()
   00521|                     .is_some_and(|character| !character.is_alphanumeric());
   00522|             before_ok && after_ok
   00523|         })
   00524| }
   00525| pub(super) fn shell_quote(value: &str) -> String {
   00526|     format!("'{}'", value.replace('\'', "'\\''"))
   00527| }
   00528| fn command_plan_text(intent: &str, language: &str, target: &str) -> String {
   00529|     seed::localized_response(intent, language)
   00530|         .unwrap_or_else(|| intent.to_owned())
   00531|         .replace(TARGET_PLACEHOLDER, target)
   00532| }
   00533| /// Whether `lower` (an already-lowercased request) is a file **write / create**
   00534| /// intent — a write verb applied to something file-shaped. This is the single
   00535| /// signal the router uses to keep a file-creation request from ever being
   00536| /// misrouted to the file-read recipe (issue #681): a request to *produce* a file
   00537| /// is a write, never a read of the not-yet-existing target.
   00538| ///
   00539| /// This is intentionally the same structural parse used to compose the eventual
   00540| /// write plan. A request is classified as a write only when the seed-defined
   00541| /// action/target/content roles yield a safe target and non-empty payload. One
   00542| /// parser for classification and composition cannot drift into claiming an
   00543| /// operation that the planner is unable to execute.
   00544| #[must_use]
   00545| pub(crate) fn has_file_write_intent(lower: &str) -> bool {
   00546|     parse_write_request(lower).is_some()
   00547| }
   00548| /// Whether a request explicitly marks its recovered payload as authoritative
   00549| /// literal bytes rather than a description of another workspace operation.
   00550| ///
   00551| /// The marker is seed-backed and multilingual. Requiring both the narrow marker
   00552| /// role and a successfully composed literal-file plan prevents arbitrary prose
   00553| /// containing "exactly" from changing planner precedence.
   00554| pub(super) fn has_authoritative_literal_write(request: &str) -> bool {
   00555|     let normalized = request.to_lowercase();
   00556|     let authoritative = first_prefix_lead_end(
   00557|         &normalized,
   00558|         seed::ROLE_FILE_WRITE_AUTHORITATIVE_CONTENT_LEAD,
   00559|     )
   00560|     .is_some()
   00561|         || literal_payload(request).is_some();
   00562|     authoritative
   00563|         && compose_general_change_plan(request)
   00564|             .is_some_and(|plan| plan.mode == GeneralPlanMode::LiteralFile)
   00565| }
   00566| /// Recover the `(target, content)` of a write request from its wording.
   00567| ///
   00568| /// The recogniser is entirely seed-driven (issue #680). It locates the target
   00569| /// file by a `file_write_target_cue`/`file_write_destination_cue` that directly
   00570| /// precedes a file-looking, safe relative path, then recovers the content two
   00571| /// ways:
   00572| ///
   00573| /// * **Marker-led** — a `file_write_content_lead` phrase ("containing", "with
   00574| ///   the following", …) introduces the payload. The content is the span after
   00575| ///   the marker (when the file precedes it) or the span between the marker and
   00576| ///   the file clause (when the content precedes the file).
   00577| /// * **Destination-led** — the "write CONTENT to FILE" shape, where a
   00578| ///   `file_write_action_cue` opens the request and a *destination* cue (not a
   00579| ///   positional target cue) routes the preceding span into the file.
   00580| /// * **Action-led** — the "write FILE saying CONTENT" shape, where a
   00581| ///   `file_write_action_cue` ("write"/"create"/"save"/…) directly names the file
   00582| ///   and a content-lead marker introduces the payload after it. An action cue
   00583| ///   licenses the file just like a target cue, but only marker-led content is
   00584| ///   accepted for it, so a bare "create app.rs" (no content) still falls through
   00585| ///   to the ordinary solver rather than fabricating an empty file.
   00586| ///
   00587| /// Both byte offsets index the lowercased copy, which is byte-length preserving
   00588| /// for en/ru/hi/zh, so the same offsets slice the original request and the
   00589| /// recovered content keeps its case and punctuation.
   00590| fn parse_write_request(request: &str) -> Option<(String, String)> {
   00591|     let toks = tokens(request);
   00592|     if let Some(literal) = literal_payload(request) {
   00593|         // A closed whole-file payload supplies the content. Only target cues
   00594|         // before it bind the file; its internal prose is authored data.
   00595|         if let Some(binding) = ranked_bindings(&toks).into_iter().find(|candidate| {
   00596|             toks[candidate.index].end <= literal.start && candidate.cue_end <= literal.start
   00597|         }) {
   00598|             return Some((
   00599|                 binding.path,
   00600|                 clean_content(&request[literal.start..literal.end]).unwrap_or(literal.text),
   00601|             ));
   00602|         }
   00603|     }
   00604|     // A cue between two file-shaped tokens can belong to either of them, and the
   00605|     // ranking only says which reading to try first. The reading that recovers a
   00606|     // payload is the one the sentence supports, so the candidates are taken in
   00607|     // order and the first that parses is the answer. A sentence that offers one
   00608|     // candidate reaches exactly the branch it always did.
   00609|     ranked_bindings(&toks)
   00610|         .into_iter()
   00611|         .find_map(|binding| parse_write_request_bound(request, &toks, &binding))
   00612| }
   00613| 
   00614| /// Read `request` as a write delivered through one particular binding.
   00615| fn parse_write_request_bound(
   00616|     request: &str,
   00617|     toks: &[Token<'_>],
   00618|     binding: &WriteBinding,
   00619| ) -> Option<(String, String)> {
   00620|     let lowered = request.to_lowercase();
   00621|     let dest_cues = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);
   00622|     let file_index = binding.index;
   00623|     let target = binding.path.clone();
   00624|     // The clause is the cue and its path together, so it begins at whichever of
   00625|     // them the language puts first.
   00626|     let clause_start = if binding.cue_precedes {
   00627|         binding.cue_start
   00628|     } else {
   00629|         toks[file_index].start
   00630|     };
   00631|     let cue_is_destination = binding.family == CueFamily::Destination;
   00632|     // Marker-led content. The payload sits after the marker, bounded by the file
   00633|     // clause when the marker comes first ("write the following: hello to x.txt")
   00634|     // and running to the end when the clause comes first ("store file x.txt
   00635|     // containing hello").
   00636|     //
   00637|     // A marker that *precedes* the clause additionally needs a write verb, which
   00638|     // is the same rule the destination-led and assignment-shaped branches below
   00639|     // already apply — without it a read request whose object happens to be a
   00640|     // content-lead surface claims a write. The issue-#671 matrix caught
   00641|     // `show me the contents of the file beta.md` planning
   00642|     // `write(beta.md, "of the")`, destroying the fixture it was asked to read.
   00643|     // A marker inside a sentence that specifies a document to compose introduces
   00644|     // that document's structure, not its bytes; see
   00645|     // [`super::note_composition::composed_document_specification_span`]. Reading
   00646|     // it as a literal payload is what wrote "the selected tree level, node
   00647|     // outcomes, test results, and session id." into the ladder's final proof
   00648|     // file (issue #1066), and it claimed the request too, so the note the caller
   00649|     // asked for was never composed.
   00650|     let specification = super::note_composition::composed_document_specification_span(request);
   00651|     if let Some((_, marker_end)) = first_content_lead_end(&lowered)
   00652|         && !specification.is_some_and(|span| span.contains(&marker_end))
   00653|         && positions_share_statement(request, marker_end, clause_start)
   00654|     {
   00655|         let marker_leads = marker_end <= clause_start;
   00656|         let statement_end = if marker_leads {
   00657|             end_of_statement(request, marker_end, clause_start)
   00658|         } else {
   00659|             end_of_statement(request, marker_end, request.len())
   00660|         };
   00661|         // A circumfix marker states where its payload ends as well as where it
   00662|         // begins, and the closing literal is grammar rather than bytes: the
   00663|         // Hindi "जिसमें Gemfile.lock हो" would otherwise write the verb into the
   00664|         // file with the content.
   00665|         let payload_end = content_lead_close(&lowered, marker_end)
   00666|             .map_or(statement_end, |close| close.min(statement_end));
   00667|         let marker_span = request.get(marker_end..payload_end);
   00668|         if (!marker_leads || first_action_cue_end(toks).is_some())
   00669|             && let Some(content) = marker_span.and_then(clean_content).filter(|content| {
   00670|                 is_literal_content(content)
   00671|                     && (!names_deferred_work_product(content)
   00672|                         || first_prefix_lead_end(
   00673|                             &lowered,
   00674|                             seed::ROLE_FILE_WRITE_AUTHORITATIVE_CONTENT_LEAD,
   00675|                         )
   00676|                         .is_some()
   00677|                         || literal_payload(request).is_some())
   00678|             })
   00679|         {
   00680|             return Some((target, content));
   00681|         }
   00682|     }
   00683|     let content_span = if cue_is_destination && binding.cue_precedes {
   00684|         let action_end = first_action_cue_end(toks)?;
   00685|         (action_end <= clause_start && positions_share_statement(request, action_end, clause_start))
   00686|             .then(|| request.get(action_end..clause_start))?
   00687|     } else if cue_is_destination {
   00688|         // The same shape read from the other side. A language that marks its
   00689|         // destination with a postposition and closes the clause with the verb —
   00690|         // "notes/attribution.md में Gemfile.lock लिखो" — states the payload
   00691|         // between the two, exactly as the prepositional wording states it
   00692|         // between the verb and the preposition.
   00693|         let action_start = action_cue_start_after(toks, binding.cue_end)?;
   00694|         (binding.cue_end <= action_start
   00695|             && positions_share_statement(request, binding.cue_end, action_start))
   00696|         .then(|| request.get(binding.cue_end..action_start))?
   00697|     } else if let Some(value_lead) = toks
   00698|         .iter()
   00699|         .skip(file_index + 1)
   00700|         .find(|token| dest_cues.contains(&clean_cue_token(token.text)))
   00701|     {
   00702|         // Assignment shape: "set the contents of FILE to VALUE". The target
   00703|         // cue identifies the file object and a following destination cue
   00704|         // introduces its literal value. Requiring a write action before the
   00705|         // file keeps an unrelated "contents of FILE" read request out.
   00706|         let action_end = first_action_cue_end(toks)?;
   00707|         (action_end <= clause_start
   00708|             && positions_share_statement(request, action_end, clause_start)
   00709|             && positions_share_statement(request, clause_start, value_lead.start))
   00710|         .then(|| request.get(value_lead.end..))?
   00711|     } else {
   00712|         None
   00713|     };
   00714|     let content = clean_content(content_span?)?;
   00715|     // A recovered payload that is *only* a non-referential subject ("save it to
   00716|     // FILE", "write this to FILE") names no literal content — the pronoun points
   00717|     // back at content the request expects the recipe to still compose. Treating
   00718|     // it as a literal write both fabricates the wrong file (the string "it") and
   00719|     // steals the request from the keyword recipe that would author the real
   00720|     // artifact, so fall through instead (issue #663).
   00721|     //
   00722|     // The same is true of a payload that names the *work product* rather than
   00723|     // supplying it: "save the answer to FILE" states where an answer goes, not
   00724|     // what it says (issue #1066).
   00725|     if is_non_referential_content(&content)
   00726|         || names_deferred_work_product(&content)
   00727|         || !is_literal_content(&content)
   00728|     {
   00729|         return None;
   00730|     }
   00731|     Some((target, content))
   00732| }
   00733| /// Where the statement that begins at `from` ends, never past `limit`.
   00734| ///
   00735| /// A literal payload is something the request *states*, and a statement ends
   00736| /// where its sentence does. Bounding the span by the file clause alone reads
   00737| /// across every sentence in between: "Draft a handover memo containing the
   00738| /// migration status, the outstanding blockers, and the on-call owner. Leave the
   00739| /// memo in `handover/2026-q3.md`" put the marker in the first sentence and the
   00740| /// clause in the second, so the recovered payload ended with the words *Leave
   00741| /// the memo* and the caller's memo opened by instructing them to leave it
   00742| /// (issue #1066).
   00743| ///
   00744| /// The clause bound still applies inside the sentence, because "write the
   00745| /// following: hello to `x.txt`" states marker, payload and clause in one
   00746| /// breath. This only refuses to look further than the sentence the marker is in.
   00747| ///
   00748| /// A marker that says nothing more on its own line is the exception, because
   00749| /// there the payload is a *block* rather than a phrase: "Create file
   00750| /// `rules.lino` containing\n<three lines of lino>" leaves the marker with an
   00751| /// empty tail, and a newline ends a sentence, so the sentence bound would
   00752| /// recover nothing at all. When the marker's own line has no word left on it,
   00753| /// the statement is the block that follows and runs to `limit`, which is what
   00754| /// this route always did for block payloads.
   00755| ///
   00756| /// The sentence is the one *prose* reads, so a semicolon inside the payload
   00757| /// joins its two halves instead of ending it. Reading the payload at the scope
   00758| /// shell routing reads at cut issue #918's minimal-core invariant in half at
   00759| /// its semicolon.
   00760| fn end_of_statement(request: &str, from: usize, limit: usize) -> usize {
   00761|     let Some(sentence) = prose_sentences(request)
   00762|         .into_iter()
   00763|         .find(|sentence| sentence.span.contains(&from))
   00764|     else {
   00765|         return limit;
   00766|     };
   00767|     if let Some(literal) = crate::normal_markov::quoted_segment_spans(request)
   00768|         .into_iter()
   00769|         .find(|segment| {
   00770|             segment.start >= from
   00771|                 && segment.start < sentence.span.end
   00772|                 && segment.end > sentence.span.end
   00773|         })
   00774|     {
   00775|         return literal.end.min(limit);
   00776|     }
   00777|     let says_more = request
   00778|         .get(from..sentence.span.end)
   00779|         .is_some_and(|tail| tail.chars().any(char::is_alphanumeric));
   00780|     if says_more && !payload_continues_past_its_first_line(request, from, sentence.span.end) {
   00781|         sentence.span.end.min(limit)
   00782|     } else {
   00783|         limit
   00784|     }
   00785| }
   00786| /// Whether two write-request cues belong to one prose statement.
   00787| ///
   00788| /// Literal-write roles are structural only inside the statement that relates
   00789| /// them. Without this check, a content lead in one issue-description paragraph
   00790| /// can pair with an incidental file-shaped token in a later paragraph and turn
   00791| /// repository policy prose into an executable write (issue #1069).
   00792| ///
   00793| /// [`end_of_statement`] deliberately lets a marker-only line introduce the
   00794| /// block below it. Reusing that boundary here preserves that supported block
   00795| /// shape while rejecting ordinary completed sentences between the two cues.
   00796| fn positions_share_statement(request: &str, left: usize, right: usize) -> bool {
   00797|     let (from, limit) = if left <= right {
   00798|         (left, right)
   00799|     } else {
   00800|         (right, left)
   00801|     };
   00802|     from == limit || end_of_statement(request, from, limit) == limit
   00803| }
   00804| /// Whether a recovered payload says anything at all. A span of nothing but
   00805| /// punctuation is what a mis-parse leaves behind — the `opencode` leg of the
   00806| /// issue-#671 matrix recovered a single `"`, the tail of a quoted prompt after
   00807| /// its trailing content-lead marker — and writing it would replace real file
   00808| /// bytes with a stray delimiter.
   00809| fn is_literal_content(content: &str) -> bool {
   00810|     content.chars().any(char::is_alphanumeric)
   00811| }
   00812| /// Whether a recovered write payload is nothing but a non-referential subject —
   00813| /// a bare pronoun/function word ("it", "this", "that", …) that refers back to
   00814| /// context rather than naming literal content. The surfaces carry the
   00815| /// [`seed::ROLE_NON_REFERENTIAL_SUBJECT`] role; only whole-word
   00816| /// ([`Slot::Bare`]) forms are rejected, so legitimate content that merely
   00817| /// *begins* with such a word ("to be or not to be") is still accepted.
   00818| fn is_non_referential_content(content: &str) -> bool {
   00819|     let lower = content.to_lowercase();
   00820|     seed::lexicon()
   00821|         .role_word_forms(seed::ROLE_NON_REFERENTIAL_SUBJECT)
   00822|         .iter()
   00823|         .any(|form| form.slot() == Slot::Bare && lower == form.text)
   00824| }
   00825| /// Whether a recovered write payload names the result of work the same request
   00826| /// asks for, instead of supplying bytes (issue #1066).
   00827| ///
   00828| /// "Save the answer to `out/e.md`" and "leave observable evidence to
   00829| /// `out/e.md`" have the destination-led shape of a literal write -- a write
   00830| /// verb, a span, a destination cue, a path -- and supply no literal. Taking the
   00831| /// span at face value wrote the words *the answer* into the file and, worse,
   00832| /// claimed the request as finished, so the investigation that would have
   00833| /// produced the real bytes never ran.
   00834| ///
   00835| /// The surfaces carry [`seed::ROLE_FILE_WRITE_DEFERRED_CONTENT_REFERENCE`] as
   00836| /// [`Slot::Suffix`] forms, because the head noun is what defers and the
   00837| /// modifiers in front of it ("observable", "final") are the caller's, not the
   00838| /// lexicon's.
   00839| ///
   00840| /// Applied to marker-led content too: “with the observed result” uses a content
   00841| /// marker syntactically, but still names work that has not happened. Explicit
   00842| /// bytes remain expressible through the authoritative-content marker, whose
   00843| /// distinct role is routed before derived-delivery planning.
   00844| fn names_deferred_work_product(content: &str) -> bool {
   00845|     let lower = content
   00846|         .trim()
   00847|         .trim_end_matches(['.', '!', '?', '。', '！', '？'])
   00848|         .trim_end()
   00849|         .to_lowercase();
   00850|     seed::lexicon()
   00851|         .role_word_forms(seed::ROLE_FILE_WRITE_DEFERRED_CONTENT_REFERENCE)
   00852|         .iter()
   00853|         .any(|form| match form.slot() {
   00854|             Slot::Bare => lower == form.text,
   00855|             Slot::Suffix => ends_with_head_noun(&lower, form.after_slot().trim_start()),
   00856|             Slot::Prefix | Slot::Circumfix => false,
   00857|         })
   00858| }
   00859| /// Whether `content` ends with `noun` standing as its own word.
   00860| ///
   00861| /// English and Russian separate a head noun from its modifiers with a space, so
   00862| /// the character before the match settles it. Chinese writes the same phrase
   00863| /// with no separator at all, which is why the boundary is stated as "not an
   00864| /// ASCII alphanumeric" rather than "whitespace": demanding a space would never
   00865| /// match 结论, and demanding nothing would match the tail of an unrelated
   00866| /// English word.
   00867| fn ends_with_head_noun(content: &str, noun: &str) -> bool {
   00868|     !noun.is_empty()
   00869|         && content.strip_suffix(noun).is_some_and(|before| {
   00870|             before
   00871|                 .chars()
   00872|                 .next_back()
   00873|                 .is_none_or(|character| !character.is_ascii_alphanumeric())
   00874|         })
   00875| }
   00876| /// Resolve an edit target named in a request through the workspace self-AST
   00877| /// census (issue #673).
   00878| ///
   00879| /// Before the census existed, the planner could only edit a file the request spelt
   00880| /// out in full, and its own self-inspection was pinned to a single hardcoded module
   00881| /// (`src/agentic_coding/planner.rs`). Now any `path`, `path:symbol`, unambiguous
   00882| /// module suffix, or uniquely-declared item name resolves to the real module path
   00883| /// through [`crate::self_ast_census`], so the planner can address every module of
   00884| /// the workspace by the same mechanism.
   00885| ///
   00886| /// The token must *address* the workspace to be resolved: it has to carry a
   00887| /// directory component (`agentic_coding/source_links.rs`) or a `path:symbol`
   00888| /// pair (`self_ast_census.rs:resolve_census_target`). A bare file name such as
   00889| /// `main.rs` is left exactly as the request spelt it, because the request may be
   00890| /// about the *client's* working directory rather than this workspace, and an
   00891| /// ordinary word that happens to match an item name is never mistaken for an edit
   00892| /// target. The census itself fails closed on anything ambiguous.
   00893| #[must_use]
   00894| pub fn resolve_census_target(reference: &str) -> Option<CensusResolution> {
   00895|     let addresses_workspace =
   00896|         reference.contains('/') || (reference.contains(':') && !reference.contains("://"));
   00897|     if !addresses_workspace {
   00898|         return None;
   00899|     }
   00900|     self_ast_census::workspace().resolve(reference)
   00901| }
   00902| /// Whether `text` carries a software-authoring verb (implement, resolve,
   00903| /// develop, …) in any seeded language.
   00904| #[must_use]
   00905| pub fn mentions_software_authoring(text: &str) -> bool {
   00906|     mentions_bare_role(text, seed::ROLE_SOFTWARE_AUTHORING_ACTION)
   00907| }
   00908| const fn capability_slug(capability: Capability) -> &'static str {
   00909|     match capability {
   00910|         Capability::Search => "Search",
   00911|         Capability::Fetch => "Fetch",
   00912|         Capability::Read => "Read",
   00913|         Capability::Write => "Write",
   00914|         Capability::Edit => "Edit",
   00915|         Capability::Run => "Run",
   00916|         Capability::Grep => "Grep",
   00917|         Capability::Glob => "Glob",
   00918|         Capability::ListDir => "ListDir",
   00919|         Capability::Todo => "Todo",
   00920|         Capability::Subagent => "Subagent",
   00921|         Capability::ReadMany => "ReadMany",
   00922|         Capability::MultiEdit => "MultiEdit",
   00923|         Capability::AskUser => "AskUser",
   00924|     }
   00925| }
   00926| fn language(request: &str) -> &'static str {
   00927|     crate::language::detect(request).slug()
