sRun(fallback)) return planOne(run, command(fallback));\n    }\n  }\n  const preparedPull = preparedPullReference(messages);\n  if (preparedPull !== null && preparedPull !== target && !progress.attemptedFetchOf(preparedPull) && fetch) {\n    return planOne(fetch, workItemFetchArguments(preparedPull));\n  }\n  return null;\n}\n\nfunction preparedPullReference(messages) {\n  const user = [...messages].reverse().find((message) => message.role.toLowerCase() === 'user');\n  if (!user) return null;\n  for (const token of splitWhitespace(plainText(user.content))) {\n    const reference = repositoryWorkReference(token);\n    if (reference !== null && reference.split('/').reverse()[1] === 'pull') return reference;\n  }\n  return null;\n}\n\nfunction workItemFetchArguments(target) {\n  return jsonText({ url: target, format: 'text', prompt: fill('issue_fetch_prompt', []) });\n}\n\n/** Mirrors `fn issue_view_command`. @param {string} target */\nexport function issueViewCommand(target) {\n  const kind = trimEndMatches(target, charIn('/')).split('/').reverse()[1] === 'pull' ? 'pr' : 'issue';\n  return fill('issue_view_command', [['{kind}', kind], ['{target}', shellQuote(target)]]);\n}\n\nfunction restSegments(target) {\n  const segments = trimEndMatches(target, charIn('/')).split('/').reverse();\n  if (segments.length < 4) return null;\n  const [number, kindSegment, repo, owner] = segments;\n  let kind;\n  if (kindSegment === 'issue' || kindSegment === 'issues') kind = 'issues';\n  else if (kindSegment === 'pull' || kindSegment === 'pulls') kind = 'pulls';\n  else return null;\n  if (!number || !Array.from(number).every(isAsciiDigit)) return null;\n  return [owner, repo, kind, number];\n}\n\nfunction restCommand(key, target) {\n  const segments = restSegments(target);\n  if (!segments) return null;\n  const [owner, repo, kind, number] = segments;\n  return fill(key, [['{owner}', owner], ['{repo}', repo], ['{kind}', kind], ['{number}', number]]);\n}\n\nfunction issueRestReadCommand(target) {\n  return restCommand('issue_rest_read_command', target);\n}\n\nfunction issueApiReadCommand(target) {\n  return restCommand('issue_api_read_command', target);\n}\n\nfunction workItemReadFailureReport(plan, progress) {\n  if (!progress.failedWorkItemReadOf(plan.target)) return null;\n  const attempts = progress.workItemReadAttempts(plan.target);\n  if (!attempts.length) return null;\n  return fill('read_failed_report', [['{target}', plan.target], ['{attempts}', attempts.join('\\n')]]);\n}\n\nfunction repositoryWorkItemObjective(plan, progress) {\n  const found = progress.fetched_pages.find(([url]) => url === plan.target);\n  if (!found || trim(found[1]) === '') return null;\n  return found[1];\n}\n\n// Exact declared literal data is evidence, even when its words describe failures.\n// Explicit harness errors and nonzero exit status still veto completion.\nfunction literalVerificationMatches(plan, output) {\n  return plan.mode === GeneralPlanMode.LiteralFile && output !== null && output !== undefined\n    && !harnessReportedFailure(output) && [null, 0].includes(reportedExitCode(output))\n    && trim(output) === trim(plan.content);\n}\n\nfunction finishGeneralChange(plan, progress, resolvedFromWorkItem) {\n  if (plan.mode === GeneralPlanMode.RepositoryWorkItem) return finalAnswer(plannedNotExecutedAnswer(plan));\n  const latest = progress.latestRunOutputFor(plan.verification_command);\n  const report = latest === null || latest === undefined || literalVerificationMatches(plan, latest)\n    ? null\n    : failedVerification([latest], plan.verification_command, plan.goal);\n  if (report !== null && report !== undefined) return finalAnswer(report);\n  if (progress.successfulRunCountFor(plan.verification_command) === 0) return finalAnswer(generalPlanUnverified(plan));\n  if (plan.mode === GeneralPlanMode.LiteralFile) {\n    const output = progress.latestSuccessfulRunOutputFor(plan.verification_command);\n    const observed = output === null || output === undefined ? null : observedPayload(output);\n    if (!literalVerificationMatches(plan, output)\n      && (observed === null || observed === undefined || trim(observed) !== trim(plan.content))) {\n      return finalAnswer(generalPlanMismatch(plan, observed ?? ''));\n    }\n  }\n  if (resolvedFromWorkItem && plan.mode === GeneralPlanMode.LiteralFile) {\n    return finalAnswer(workItemCompletion(plan, progress));\n  }\n  return finalAnswer(generalPlanCompleted(plan));\n}\n\nfunction workItemCompletion(plan, progress) {\n  const recipe = {\n    language: 'text',\n    source: plan.content,\n    path: plan.target,\n    supporting_files: [],\n    commands: [plan.verification_command],\n  };\n  const output = progress.latestSuccessfulRunOutputFor(plan.verification_command);\n  return executionRecipeFinalAnswer(recipe, output === null || output === undefined ? [] : [output], null);\n}\n\nfunction generalPlanCompleted(plan) {\n  const language = detect(plan.goal);\n  return (localizedResponse('general_plan_completed', language) ?? '')\n    .split('{target}').join(plan.target)\n    .split('{command}').join(plan.verification_command)\n    .split('{plan_path}').join(PLAN_PATH)\n    .split('{plan}').join(fencedBlock(LINO_FENCE_LANGUAGE, planLinksNotation(plan)));\n}\n\nfunction toolArgumentPath(args) {\n  let value;\n  try {\n    value = JSON.parse(args);\n  } catch {\n    return null;\n  }\n  if (!value || typeof value !== 'object') return null;\n  for (const key of ['path', 'filePath', 'file_path']) {\n    if (typeof value[key] === 'string') return value[key];\n  }\n  return null;\n}\n\nfunction readArguments(path) {\n  return jsonText({ path, filePath: path, file_path: path });\n}\n\nconst CAPABILITY_LABELS = Object.freeze({\n  search: 'search', fetch: 'fetch', read: 'read', write: 'write', edit: 'edit', run: 'run', grep: 'grep',\n  glob: 'glob', list_dir: 'list directory', todo: 'todo', subagent: 'subagent', read_many: 'read many',\n  multi_edit: 'multi-edit', ask_user: 'ask user',\n});\n\nfunction capabilityLabel(capability) {\n  return CAPABILITY_LABELS[capability];\n}\n\nfunction generalPlanMismatch(plan, observed) {\n  const language = detect(plan.goal);\n  const expected = plan.mode === GeneralPlanMode.RepositoryWorkItem ? planLinksNotation(plan) : plan.content;\n  return (localizedResponse('general_plan_verification_mismatch', language) ?? '')\n    .split('{target}').join(plan.target)\n    .split('{expected}').join(trim(expected))\n    .split('{observed}').join(trim(observed));\n}\n\nfunction generalPlanUnverified(plan) {\n  const language = detect(plan.goal);\n  return (localizedResponse('general_plan_unverified', language) ?? '')\n    .split('{target}').join(plan.target)\n    .split('{command}').join(plan.verification_command);\n}\n"
