undefined ? null : observedPayload(output);\n    if (!literalVerificationMatches(plan, output)\n      && (observed === null || observed === undefined || trim(observed) !== trim(plan.content))) {\n      return finalAnswer(generalPlanMismatch(plan, observed ?? ''));\n    }\n  }\n  if (resolvedFromWorkItem && plan.mode === GeneralPlanMode.LiteralFile) {\n    return finalAnswer(workItemCompletion(plan, progress));\n  }\n  return finalAnswer(generalPlanCompleted(plan));\n}\n\nfunction workItemCompletion(plan, progress) {\n  const recipe = {\n    language: 'text',\n    source: plan.content,\n    path: plan.target,\n    supporting_files: [],\n    commands: [plan.verification_command],\n  };\n  const output = progress.latestSuccessfulRunOutputFor(plan.verification_command);\n  return executionRecipeFinalAnswer(recipe, output === null || output === undefined ? [] : [output], null);\n}\n\nfunction generalPlanCompleted(plan) {\n  const language = detect(plan.goal);\n  return (localizedResponse('general_plan_completed', language) ?? '')\n    .split('{target}').join(plan.target)\n    .split('{command}').join(plan.verification_command)\n    .split('{plan_path}').join(PLAN_PATH)\n    .split('{plan}').join(fencedBlock(LINO_FENCE_LANGUAGE, planLinksNotation(plan)));\n}\n\nfunction toolArgumentPath(args) {\n  let value;\n  try {\n    value = JSON.parse(args);\n  } catch {\n    return null;\n  }\n  if (!value || typeof value !== 'object') return null;\n  for (const key of ['path', 'filePath', 'file_path']) {\n    if (typeof value[key] === 'string') return value[key];\n  }\n  return null;\n}\n\nfunction readArguments(path) {\n  return jsonText({ path, filePath: path, file_path: path });\n}\n\nconst CAPABILITY_LABELS = Object.freeze({\n  search: 'search', fetch: 'fetch', read: 'read', write: 'write', edit: 'edit', run: 'run', grep: 'grep',\n  glob: 'glob', list_dir: 'list directory', todo: 'todo', subagent: 'subagent', read_many: 'read many',\n  multi_edit: 'multi-edit', ask_user: 'ask 