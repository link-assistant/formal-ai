stSuccessfulRunOutputFor(append);\\n  const observed = raw === null ? null : observedPayload(raw);\\n  return observed !== null && observed.includes(event) ? null : unverifiedPlanEvent(plan);\\n}\\n\\n/**\\n * Mirrors `fn plan_work_item_execution`.\\n *\\n * Partial: rust/src/solver.rs `UniversalSolver::default().solve` is consulted\\n * only for the `execution_recipe` its answer carries. The solver's first\\n * recipe-bearing arm, `coding::program_contract::answer`, is ported\\n * (crate/coding_program_contract.mjs) and used here; the later catalog\\n * `write_program` recipe arm is native-only, so a work item only that arm\\n * would answer falls through to the literal-file composer.\\n */\\nfunction planWorkItemExecution(objective, messages, toolNames) {\\n  const answer = workItemSolverAnswer(objective);\\n  if (answer && answer.execution_recipe && requestedIn(objective)) attach(answer.execution_recipe);\\n  const step = answer ? planSymbolicCommandReroute(messages, toolNames, answer) : null;\\n  if (step) return step;\\n  const executable = composeGeneralChangePlan(objective);\\n  if (!executable || executable.mode === GeneralPlanMode.RepositoryWorkItem) return null;\\n  return planWorkItemChangeStep(messages, toolNames, executable);\\n}\\n\\nfunction workItemSolverAnswer(objective) {\\n  return programContractAnswer(objective);\\n}\\n\\nfunction planWorkItemRead(messages, toolNames, target, progress) {\\n  const fetch = toolFor(toolNames, Capability.Fetch);\\n  if (fetch && isHostedResearchTool(fetch)) {\\n    return progress.attemptedFetchOf(target) ? null : planOne(fetch, workItemFetchArguments(target));\\n  }\\n  const run = shellCommandTool(toolNames);\\n  if (!progress.attemptedWorkItemReadOf(target) && run) return planOne(run, command(issueViewCommand(target)));\\n  if (!progress.attemptedFetchOf(target) && fetch) return planOne(fetch, workItemFetchArguments(target));\\n  if (run) {\\n    for (const fallback of [issueRestReadCommand(target), issueApiReadCommand(target)]) {\\n      if (fallback !== null && !progress.hasRun(fallback)) return planOne(run, command(fallback));\\n    }\\n  }\\n  const preparedPull = preparedPullReference(messages);\\n  if (preparedPull !== null && preparedPull !== target && !progress.attemptedFetchOf(preparedPull) && fetch) {\\n    return planOne(fetch, workItemFetchArguments(preparedPull));\\n  }\\n  return null;\\n}\\n\\nfunction preparedPullReference(messages) {\\n  const user = [...messages].reverse().find((message) => message.role.toLowerCase() === 'user');\\n  if (!user) return null;\\n  for (const token of splitWhitespace(plainText(user.content))) {\\n    const reference = repositoryWorkReference(token);\\n    if (reference !== null && reference.split('/').reverse()[1] === 'pull') return reference;\\n  }\\n  return null;\\n}\\n\\nfunction workItemFetchArguments(target) {\\n  return jsonText({ url: target, format: 'text', prompt: fill('issue_fetch_prompt', []) });\\n}\\n\\n/** Mirrors `fn issue_view_command`. @param {string} target */\\nexport function issueViewCommand(target) {\\n  const kind = trimEndMatches(target, charIn('/')).split('/').reverse()[1] === 'pull' ? 'pr' : 'issue';\\n  return fill('issue_view_command', [['{kind}', kind], ['{target}', shellQuote(target)]]);\\n}\\n\\nfunction restSegments(target) {\\n  const segments = trimEndMatches(target, charIn('/')).split('/').reverse();\\n  if (segments.length < 4) return null;\\n  const [number, kindSegment, repo, owner] = segments;\\n  let kind;\\n  if (kindSegment === 'issue' || kindSegment === 'issues') kind = 'issues';\\n  else if (kindSegment === 'pull' || kindSegment === 'pulls') kind = 'pulls';\\n  else return null;\\n  if (!number || !Array.from(number).every(isAsciiDigit)) return null;\\n  return [owner, repo, kind, number];\\n}\\n\\nfunction restCommand(key, target) {\\n  const segments = restSegments(target);\\n  if (!segments) return null;\\n  const [owner, repo, kind, number] = segments;\\n  return fill(key, [['{owner}', owner], ['{repo}', repo], ['{kind}', kind], ['{number}', number]]);\\n}\\n\\nfunction issueRestReadCommand(target) {\\n  return restCommand('issue_rest_read_command', target);\\n}\\n\\nfunction issueApiReadCommand(target) {\\n  return restCommand('issue_api_read_command', target);\\n}\\n\\nfunction workItemReadFailureReport(plan, progress) {\\n  if (!progress.failedWorkItemReadOf(plan.target)) return null;\\n  const attempts = progress.workItemReadAttempts(plan.target);\\n  if (!attempts.length) return null;\\n  return fill('read_failed_report', [['{target}', plan.target], ['{attempts}', attempts.join('\\\\n')]]);\\n}\\n\\nfunction repositoryWorkItemObjective(plan, progress) {\\n  const found = progress.fetched_pages.find(([url]) => url === plan.target);\\n  if (!found || trim(found[1]) === '') return null;\\n  return found[1];\\n}\\n\\n// Exact declared literal data is evidence, even when its words describe failures.\\n// Explicit harness errors and nonzero exit status still veto completion.\\nfunction literalVerificationMatches(plan, output) {\\n  return plan.mode === GeneralPlanMode.LiteralFile && output !== null && output !== undefined\\n    && !harnessReportedFailure(output) && [null, 0].includes(reportedExitCode(output))\\n    && trim(output) === trim(plan.content);\\n}\\n\\nfunction finishGeneralChange(plan, progress, resolvedFromWorkItem) {\\n  if (plan.mode === GeneralPlanMode.RepositoryWorkItem) return finalAnswer(plannedNotExecutedAnswer(plan));\\n  const latest = progress.latestRunOutputFor(plan.verification_command);\\n  const report = latest === null || latest === undefined || literalVerificationMatches(plan, latest)\\n    ? null\\n    : failedVerification([latest], plan.verification_command, plan.goal);\\n  if (report !== null && report !== undefined) return finalAnswer(report);\\n  if (progress.successfulRunCountFor(plan.verification_command) === 0) return finalAnswer(generalPlanUnverified(plan));\\n  if (plan.mode === GeneralPlanMode.Litera