path ?? 'write', failure.detail, plan.goal));\n    }\n    if (failure.capability === Capability.Run) {\n      const output = progress.latestRunOutputFor(plan.verification_command);\n      const report = output === null || output === undefined\n        ? null\n        : failedVerification([output], plan.verification_command, plan.goal);\n      if (report !== null && report !== undefined) return finalAnswer(report);\n    }\n    const previous = progress.previousAttempt();\n    const recoveringMissingWrite = failure.capability === Capability.Read\n      && Boolean(previous) && previous.capability === Capability.Write && !previous.succeeded;\n    if (!recoveringMissingWrite) {\n      return finalAnswer(renderFailure(capabilityLabel(failure.capability), failure.detail, plan.goal));\n    }\n  }\n  const previous = progress.previousAttempt();\n  const recoveringWrite = progress.last() === Capability.Read\n    && Boolean(previous) && previous.capability === Capability.Write && !previous.succeeded;\n  if (recoveringWrite) {\n    const tool = toolFor(toolNames, Capability.Write);\n    const args = previous.arguments;\n    if (tool && args !== null && args !== undefined) return planOne(tool, args);\n  }\n  if (plan.mode === GeneralPlanMode.RepositoryWorkItem) {\n    const fetched = repositoryWorkItemObjective(plan, progress);\n    if (fetched !== null) {\n      const step = planWorkItemExecution(fetched, messages, toolNames);\n      if (step) return step;\n    } else {\n      const step = planWorkItemRead(messages, toolNames, plan.target, progress);\n      if (step) return step;\n    }\n    const report = workItemReadFailureReport(plan, progress);\n    if (report !== null) return finalAnswer(report);\n  }\n  const writeTool = toolFor(toolNames, Capability.Write);\n  if (writeTool) {\n    const planAttempted = progress.attemptedWriteFor(PLAN_PATH);\n    const planWritten = progress.successfulWriteFor(PLAN_PATH);\n    if (!planAttempted) return planOne(writeTool, writeArguments(