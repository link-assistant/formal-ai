nse_statement_audit_unknown_stance_ru\n    intent statement_audit_unknown_stance\n    language ru\n    text \"содержит неизвестную позицию\"\n  response response_statement_audit_unknown_stance_hi\n    intent statement_audit_unknown_stance\n    language hi\n    text \"एक अज्ञात रुख शामिल है\"\n  response response_statement_audit_unknown_stance_zh\n    intent statement_audit_unknown_stance\n    language zh\n    text \"包含未知立场\"\n  response response_statement_audit_unknown_stance_es\n    intent statement_audit_unknown_stance\n    language es\n    text \"contiene una postura desconocida\"\n  response response_statement_audit_invalid_temperature_ru\n    intent statement_audit_invalid_temperature\n    language ru\n    text \"недопустимая температура: {error}\"\n  response response_statement_audit_invalid_temperature_hi\n    intent statement_audit_invalid_temperature\n    language hi\n    text \"अमान्य तापमान: {error}\"\n  response response_statement_audit_invalid_temperature_zh\n    intent statement_audit_invalid_temperature\n    language zh\n    text \"无效的温度：{error}\"\n  response response_statement_audit_invalid_temperature_es\n    intent statement_audit_invalid_temperature\n    language es\n    text \"temperatura no válida: {error}\"\n  response response_statement_audit_temperature_range_ru\n    intent statement_audit_temperature_range\n    language ru\n    text \"температура должна быть конечной и больше нуля\"\n  response response_statement_audit_temperature_range_hi\n    intent statement_audit_temperature_range\n    language hi\n    text \"तापमान सीमित और शून्य से अधिक होना चाहिए\"\n  response response_statement_audit_temperature_range_zh\n    intent statement_audit_temperature_range\n    language zh\n    text \"温度必须是有限数且大于零\"\n  response response_statement_audit_temperature_range_es\n    intent statement_audit_temperature_range\n    language es\n    text \"la temperatura debe ser finita y mayor que cero\"\n  response response_learn_from_source_browser_summary_en\n    intent learn_from_source_browser_summary\n    language en\n    text \"I recognized {source} as a declared data source I can learn from ({capability}). The loop that learns from it runs in the native engine: it replays the source prompts through the local links rules and sends the ones they leave unanswered to the human-gated self-improvement loop. This browser worker records the source but does not run that loop, so nothing was learned here.\"\n  response response_learn_from_source_browser_summary_ru\n    intent learn_from_source_browser_summary\n    language ru\n    text \"Я распознал {source} как объявленный источник данных, на котором могу учиться ({capability}). Цикл обучения на нём работает в нативном движке: он прогоняет запросы источника через локальные правила связей и передаёт оставшиеся без ответа в цикл самоулучшения под контролем человека. Этот браузерный воркер записывает источник, но не запускает этот цикл, поэтому здесь ничему не научился.\"\n  response response_learn_from_source_browser_summary_hi\n    intent learn_from_source_browser_summary\n    language hi\n    text \"मैंने {source} को एक घोषित डेटा स्रोत के रूप में पहचाना, जिससे मैं सीख सकता हूँ ({capability})। इससे सीखने वाला लूप नेटिव इंजन में चलता है: वह स्रोत के प्रॉम्प्ट को स्थानीय लिंक नियमों से दोबारा चलाता है और जिनका उत्तर नहीं मिलता उन्हें मानव-नियंत्रित आत्म-सुधार लूप को भेजता है। यह ब्राउज़र वर्कर स्रोत को दर्ज करता है, पर वह लूप नहीं चलाता, इसलिए यहाँ कुछ नहीं सीखा गया।\"\n  response response_learn_from_source_browser_summary_zh\n    intent learn_from_source_browser_summary\n    language zh\n    text \"我已将 {source} 识别为可供学习的已声明数据源（{capability}）。从中学习的循环在原生引擎中运行：它通过本地链接规则重放该来源的提示，并把仍未得到回答的提示交给需人工把关的自我改进循环。此浏览器工作线程只记录该来源，不运行该循环，因此这里没有学到任何东西。\"\n  response response_learn_from_source_browser_summary_es\n    intent learn_from_source_browser_summary\n    language es\n    text \"Reconocí {source} como una fuente de datos declarada de la que puedo aprender ({capability}). El ciclo que aprende de ella se ejecuta en el motor nativo: reproduce las solicitudes de la fuente con las reglas de enlaces locales y envía las que quedan sin respuesta al ciclo de automejora supervisado por humanos. Este worker del navegador registra la fuente pero no ejecuta ese ciclo, así que aquí no se aprendió nada.\"\n  response response-project-lookup-promoted-en\n    intent project-lookup-promoted\n    language en\n    text \"In the {promoted-orgs} repository context, `{display-name}` should first mean [{repo-slug}]({project-url}) — {description}\\n\\nOther repositories and entities found online are shown by the browser demo through a web search for `{display-name}`. Providers: {provider-summary}. Combined ranking: reciprocal rank fusion (k = {reciprocal-rank-constant}). Associative repository promotion can be switched off; then the answer follows the generic GitHub, GitLab, and Bitbucket project lookup path.\"\n  response response-project-lookup-promoted-ru\n    intent project-lookup-promoted\n    language ru\n    text \"В контексте репозиториев {promoted-orgs} под `{display-name}` я прежде всего имею в виду [{repo-slug}]({project-url}) — {description}\\n\\nДругие найденные в интернете репозитории и сущности должна показывать браузерная демо-версия через поиск по запросу `{display-name}`. Провайдеры: {provider-summary}. Ранжирование: reciprocal rank fusion (k = {reciprocal-rank-constant}). Продвижение ассоциативных репозиториев можно отключить, тогда ответ пойдет по обычному поиску GitHub, GitLab и Bitbucket.\"\n  response response-project-lookup-promoted-hi\n    intent project-lookup-promoted\n    language hi\n    text \"{promoted-orgs} repository context में `{display-name}` से मेरा पहला मतलब [{repo-slug}]({project-url}) है — {description}\\n\\nदूसरे matching repositories और entities browser demo में `{display-name}` web search से दिखाए जाते हैं. Providers: {provider-summary}. Combined ranking: reciprocal rank fusion (k = {reciprocal-rank-constant}). Associative repository promotion बंद करने पर जवाब generic GitHub, GitLab, और Bitbucket project lookup path से जाता है.\"\n  response response-project-lookup-promoted-zh\n    intent project-lookup-promoted\n    language zh\n    text \"在 {promoted-orgs} 仓库上下文中，`{display-name}` 首先指 [{repo-slug}]({project-url}) — {description}\\n\\n浏览器 demo 会通过 `{display-name}` 的网页搜索显示其他匹配的仓库和实体。Providers: {provider-summary}. Combined ranking: reciprocal rank fusion (k = {reciprocal-rank-constant}). 关闭 associative repository promotion 后，回答会走通用 GitHub、GitLab 和 Bitbucket project lookup 路径。\"\n  response response-project-lookup-promoted-es\n    intent project-lookup-promoted\n    language es\n    text \"In the {promoted-orgs} repository context, `{display-name}` should first mean [{repo-slug}]({project-url}) — {description}\\n\\nOther repositories and entities found online are shown by the browser demo through a web search for `{display-name}`. Providers: {provider-summary}. Combined ranking: reciprocal rank fusion (k = {reciprocal-rank-constant}). Associative repository promotion can be switched off; then the answer follows the generic GitHub, GitLab, and Bitbucket project lookup path.\"\n"
       command "cat data/seed/multilingual-responses-parity.lino"
     verification_command "cat data/seed/multilingual-responses-parity.lino"
   
>> write {"content":"# Five-language parity completions split from multilingual-responses.lino.\n# This shard is loaded through the shared seed registry on every surface.\nmultilingual_responses\n  response response_agentic_report_target_question_es\n    intent agentic_report_target_question\n    language es\n    text \"¿Qué quieres informar? Selecciona una o más opciones.\"\n  response response_agentic_report_target_options_es\n    intent agentic_report_target_options\n    language es\n    text (\"Registro del agente\" \"Exportar el registro completo del cliente agéntico.\" \"Registro del servidor\" \"Exportar el registro correspondiente del servidor Formal AI.\" \"Incidencia de GitHub\" \"Crear una incidencia con el contexto completo.\" \"Informar a Formal AI\" \"Guardar el informe para que esta instancia pueda aprender.\")\n  response response_agentic_report_contents_question_es\n    intent agentic_report_contents_question\n    language es\n    text \"¿Qué contexto debe incluir la incidencia de GitHub?\"\n  response response_agentic_report_contents_options_es\n    intent agentic_report_contents_options\n    language es\n    text (\"Ambos registros\" \"Incluir los registros del agente y del servidor; adjuntar una vista previa recortada y enlazar el contexto completo si es demasiado grande.\" \"Registro del agente\" \"Incluir solo la conversación completa del agente.\" \"Registro del servidor\" \"Incluir solo el registro completo del servidor correspondiente.\")\n  response response_agentic_report_exported_es\n    intent agentic_report_exported\n    language es\n    text \"Se exportó el contexto del informe.\"\n  response response_mcp_instructions_es\n    intent mcp_instructions\n    language es\n    text \"Llama a formal_ai_chat para cada solicitud del usuario y devuelve su respuesta al usuario.\"\n  response response_mcp_tool_description_es\n    intent mcp_tool_description\n    language es\n    text \"Pide al servidor local de razonamiento de Formal AI que responda a la solicitud del usuario.\"\n  response response_mcp_prompt_description_es\n    intent mcp_prompt_description\n    language es\n    text \"La solicitud completa del usuario que se debe responder.\"\n  response response_greeting_es\n    intent greeting\n    language es\n    text \"¡Hola! ¿En qué puedo ayudarte?\"\n  response response_wellbeing_es\n    intent wellbeing\n    language es\n    text \"Estoy muy bien, ¡gracias por preguntar! Estoy listo para ayudar; ¿qué te gustaría hacer?\"\n  response response_farewell_es\n    intent farewell\n    language es\n    text \"¡Adiós! Puedes volver cuando quieras.\"\n  response response_test_status_es\n    intent test_status\n    language es\n    text \"La prueba se superó. Estoy aquí.\"\n  response response_courtesy_response_es\n    intent courtesy_response\n    language es\n    text \"Me alegra saberlo. ¿Qué te gustaría hacer ahora?\"\n  response response_identity_es\n    intent identity\n    language es\n    text \"Soy formal-ai, una implementación de IA simbólica determinista que responde a partir de reglas locales en Links Notation y formatos de API compatibles con OpenAI. En esta demostración no realizo inferencia neuronal.\"\n  response response_assistant_name_es\n    intent assistant_name\n    language es\n    text \"Soy Formal AI y actualmente no tengo nombre. Puedes ponerme el nombre que prefieras.\"\n  response response_meta_explanation_es\n    intent meta_explanation\n    language es\n    text \"Trabajo comparando tu solicitud con reglas deterministas de Links Notation almacenadas en memoria. Cada regla asigna un patrón reconocido a una respuesta fija. Cuando ninguna regla coincide, informo intent: unknown. No hay inferencia neuronal: cada respuesta se puede rastrear por completo hasta una regla simbólica.\"\n  response response-inappropriate-content-es\n    intent inappropriate-content\n    language es\n    text \"Ese mensaje contiene contenido inapropiado. Mantén una conversación respetuosa.\"\n  response response_clarification_es\n    intent clarification\n    language es\n    text \"Lamento la confusión. Soy formal-ai, una IA simbólica determinista. Puedo responder saludos, preguntas de identidad, consultas de conceptos (¿qué es X?), operaciones aritméticas y programas Hello World. Si quieres preguntar algo específico, prueba una de esas opciones o añade un hecho en Links Notation.\"\n  response response_capabilities_es\n    intent capabilities\n    language es\n    text \"Soy formal-ai, una IA simbólica determinista. Esto es lo que puedo hacer:\\n\\n- **Saludos**: responder a «Hola» y expresiones similares.\\n- **Hello World**: generar programas en Rust, Python, JavaScript, Go, C y más lenguajes.\\n- **Búsqueda web**: buscar en internet mediante DuckDuckGo, Wikipedia y Wikidata cuando estén disponibles.\\n- **Consulta de conceptos**: explicar términos; prueba «¿Qué es Wikipedia?».\\n- **Aritmética**: evaluar expresiones; prueba «¿Cuánto es 2 + 2?».\\n- **Traducción**: traducir frases entre idiomas.\\n- **Memoria**: recordar el contexto de la sesión actual.\\n- **Reglas de comportamiento**: envía `List behavior rules` para ver las reglas de enrutamiento integradas y `Show behavior rule unknown` para leer una en Links Notation.\\n- **Enseñar este diálogo**: envía «When I say `your prompt`, answer `your answer`» para añadir una regla local a la conversación actual.\\n- **Hechos sobre mí**: envía `List all facts you know about yourself` para ver lo que sé sobre mí.\\n- **Informar de una regla ausente**: usa el botón **Report issue** de la barra superior; los mensajes sobre solicitudes desconocidas incluyen un enlace a la traza de diagnóstico para los mantenedores.\\n- **Ajustes y acciones**: configura los diagnósticos, el modo de demostración, el modo Agente, el tema, el idioma, el estilo del chat y la importación o exportación de memoria desde los mensajes.\\n\\nFunciono con reglas simbólicas locales, sin inferencia de redes neuronales.\"\n  response response_capabilities_more_es\n    intent capabilities_more\n    language es\n    text \"Además de la capacidad ya comentada, también puedo:\\n\\n- **Aritmética**: evaluar expresiones como `2 + 2`.\\n- **Traducción**: traducir frases cortas entre los idiomas compatibles.\\n- **Consulta de conceptos**: explicar términos como `What is Wikipedia?`.\\n- **Hello World**: generar pequeños programas en Rust, Python, JavaScript, Go, C y más lenguajes.\\n- **Memoria de conversación**: usar mensajes anteriores de la sesión actual.\\n- **Reglas de comportamiento**: mostrar las reglas integradas con `List behavior rules` y `Show behavior rule unknown`.\\n- **Ajustes y acciones**: configurar los diagnósticos, el modo de demostración, el modo Agente, el tema, el idioma, el estilo del chat y la importación o exportación de memoria.\"\n  response response_unknown_es\n    intent unknown\n    language es\n    text \"Todavía no sé cómo responder a eso. Aún no puedo responderlo a partir de las reglas locales de enlaces. Para revisar lo que puedo hacer, envía `List behavior rules` y luego `Show behavior rule unknown`. Para enseñar una respuesta a este diálogo, envía: When I say `your prompt`, answer `your answer`. Si después de esas comprobaciones sigue haciendo falta un hecho semilla compartido o una regla de enlaces en Links Notation, usa Report issue con la traza de razonamiento, o exporta la memoria para conservar una regla local del diálogo.\"\n  response response_unknown_reasoning_question_es\n    intent unknown_reasoning_question\n    language es\n    text \"No pude determinar `{focus}` a partir de la memoria local de Links Notation, el conocimiento público en caché ni la caché de fuentes, y no puedo inferir una respuesta verificada. ¿Qué fuente o hecho ausente debo usar?\\n\\nSi el razonamiento sigue sin resolverlo y hace falta un hecho semilla compartido o una regla de enlaces en Links Notation, usa Report issue con la traza. Para conservar una regla local del diálogo, exporta la memoria o enséñala con `When I say ... answer ...`; revisa las rutas con `List behavior rules` y `Show behavior rule unknown`.\"\n  response response_unknown_reasoning_trace_es\n    intent unknown_reasoning_trace\n    language es\n    text \"No pude determinar `{focus}` a partir de la memoria local de Links Notation, el conocimiento público en caché ni la caché de fuentes, y no puedo inferir una respuesta verificada. Registré en la traza los intentos fallidos de recopilación.\\n\\nSi el razonamiento sigue sin resolverlo y hace falta un hecho semilla compartido o una regla de enlaces en Links Notation, usa Report issue con la traza. Para conservar una regla local del diálogo, exporta la memoria o enséñala con `When I say ... answer ...`; revisa las rutas con `List behavior rules` y `Show behavior rule unknown`.\"\n  response response_concept_lookup_in_context_es\n    intent concept_lookup_in_context\n    language es\n    text \"En el contexto de «{context}» ({context_label}), {term} ({category}) significa: {summary}\\n\\nFuente: {source} ({source_kind}).\"\n  response response_concept_lookup_in_context_no_alias_es\n    intent concept_lookup_in_context_no_alias\n    language es\n    text \"En el contexto de {context_label}, {term} ({category}) significa: {summary}\\n\\nFuente: {source} ({source_kind}).\"\n  response response_physical_action_question_es\n    intent physical_action_question\n    language es\n    text \"No. No tengo un cuerpo físico.\"\n  response response_kupi_slona_es\n    intent kupi_slona\n    language es\n    text \"«Compra un elefante» es un conocido juego verbal infantil ruso. Respondas lo que respondas, la réplica es: todos dicen eso, ¡pero tú compra un elefante! La respuesta ganadora tradicional es: todos tienen un elefante, pero yo no.\"\n  response response_agent_suggestion_es\n    intent agent_suggestion\n    language es\n    text 'Parece que quieres ejecutar un comando de terminal: `{command}`.\\n\\nLa ejecución de comandos de shell requiere el modo Agente. En el modo Chat solo razono sobre tu solicitud y no ejecuto comandos.\\n\\n¿Quieres cambiar al modo Agente y conceder la capacidad `shell` para que pueda ejecutar `{command}`? Usa el selector de modo de la barra de herramientas y elige \"Agent\" (o \"Full Auto\" para ejecutar comandos automáticamente).'\n  response response_agent_suggestion_active_es\n    intent agent_suggestion_active\n    language es\n    text \"Parece que quieres ejecutar un comando de terminal: `{command}`.\\n\\nEl modo Agente está activo. Si se ha concedido la capacidad `shell`, puedo ejecutar `{command}`. De lo contrario, concede la capacidad `shell` en los ajustes.\"\n  response response_github_repository_traffic_es\n    intent github_repository_traffic\n    language es\n    text \"En parte. Para un repositorio de GitHub como {repository}, GitHub puede mostrar tráfico agregado a las personas con acceso de push o escritura: visualizaciones, visitantes únicos, clones, sitios de referencia y contenido popular durante el periodo reciente. No muestra la identidad de cada visitante. Consulta GitHub Insights > Traffic o los endpoints REST de tráfico: {traffic-ui-docs}; {traffic-api-docs}.\"\n  response response_document_originality_check_sample_present_es\n    intent document_originality_check_sample_present\n    language es\n    text \"Se reconoció una comprobación de originalidad y plagio para `{target}`.\\n\\nFlujo de trabajo: leer el texto proporcionado, seleccionar pasajes estables, ejecutar búsquedas web exactas de esos pasajes y comparar las fuentes encontradas con el documento para detectar solapamientos, citas y reutilización sospechosa. No afirmaré un porcentaje de originalidad hasta encontrar y comparar las fuentes coincidentes.\\n\\nMuestra de texto del cliente: presente.\"\n  response response_document_originality_check_sample_missing_es\n    intent document_originality_check_sample_missing\n    language es\n    text \"Se reconoció una comprobación de originalidad y plagio para `{target}`.\\n\\nFlujo de trabajo: leer el texto proporcionado, seleccionar pasajes estables, ejecutar búsquedas web exactas de esos pasajes y comparar las fuentes encontradas con el documento para detectar solapamientos, citas y reutilización sospechosa. No afirmaré un porcentaje de originalidad hasta encontrar y comparar las fuentes coincidentes.\\n\\nMuestra de texto del cliente: leída del archivo adjunto.\"\n  response response_learn_from_source_es\n    intent learn_from_source\n    language es\n    text \"Gracias; me estás indicando una fuente de datos de la que puedo aprender.\"\n  response response_tool_result_completed_es\n    intent tool_result_completed\n    language es\n    text \"El comando `{tool}` se completó. Salida:\\n\\n```{format}\\n{payload}\\n```\"\n  response response_tool_result_failed_es\n    intent tool_result_failed\n    language es\n    text \"El comando falló: {error}\"\n  response response_tool_result_empty_list_es\n    intent tool_result_empty_list\n    language es\n    text \"Esta carpeta está vacía.\"\n  response response_tool_result_empty_search_es\n    intent tool_result_empty_search\n    language es\n    text \"No se encontraron coincidencias.\"\n  response response_tool_result_empty_local_path_search_es\n    intent tool_result_empty_local_path_search\n    language es\n    text \"No se encontró ningún archivo ni carpeta coincidente en la ubicación solicitada. Comprueba el nombre o pídeme que busque en una ubicación más amplia.\"\n  response response_tool_result_empty_generic_es\n    intent tool_result_empty_generic\n    language es\n    text \"El comando se completó correctamente sin producir salida.\"\n  response response_lexeme_import_refused_batch_es\n    intent lexeme_import_refused_batch\n    language es\n    text \"se rechazaron {count} concepto(s); los fragmentos existentes no se modificaron; eventos: {events}\"\n  response response_lexeme_import_duplicate_slug_es\n    intent lexeme_import_duplicate_slug\n    language es\n    text \"slug duplicado (también {other})\"\n  response response_lexeme_import_duplicate_qid_es\n    intent lexeme_import_duplicate_qid\n    language es\n    text \"qid duplicado (también {other})\"\n  response response_lexeme_import_cache_unreadable_es\n    intent lexeme_import_cache_unreadable\n    language es\n    text \"no se puede leer la caché {path}: {error}\"\n  response response_lexeme_import_cache_invalid_json_es\n    intent lexeme_import_cache_invalid_json\n    language es\n    text \"la caché {path} contiene JSON no válido: {error}\"\n  response response_lexeme_import_cache_miss_offline_es\n    intent lexeme_import_cache_miss_offline\n    language es\n    text \"no hay entrada de caché para {qid} y el modo sin conexión está activo (define FORMAL_AI_LIVE_API para llenarla)\"\n  response response_lexeme_import_cache_budget_reached_es\n    intent lexeme_import_cache_budget_reached\n    language es\n    text \"se alcanzó el límite de caché {budget} ({cached}); se omite {qid} para respetar la política de caché acotada\"\n  response response_lexeme_import_qid_absent_from_cache_es\n    intent lexeme_import_qid_absent_from_cache\n    language es\n    text \"{qid} no está en la caché\"\n  response response_lexeme_import_no_labels_in_cache_es\n    intent lexeme_import_no_labels_in_cache\n    language es\n    text \"{qid} no tiene etiquetas en la caché\"\n  response response_lexeme_import_missing_cached_label_es\n    intent lexeme_import_missing_cached_label\n    language es\n    text \"falta la etiqueta {language} de {qid} en la caché\"\n  response response_lexeme_import_no_clean_alias_es\n    intent lexeme_import_no_clean_alias\n    language es\n    text \"la etiqueta {language} `{label}` de {qid} no coincide con la escritura de su idioma y no existe un alias válido\"\n  response response_lexeme_import_fetch_failed_es\n    intent lexeme_import_fetch_failed\n    language es\n    text \"falló la obtención de {qid}: {error}\"\n  response response_lexeme_import_fetch_invali