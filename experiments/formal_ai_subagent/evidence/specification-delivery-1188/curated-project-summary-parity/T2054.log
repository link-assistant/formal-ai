e subject\"\n  response response_statement_audit_claim_predicate_ru\n    intent statement_audit_claim_predicate\n    language ru\n    text \"для claim требуется predicate\"\n  response response_statement_audit_claim_predicate_hi\n    intent statement_audit_claim_predicate\n    language hi\n    text \"claim के लिए predicate आवश्यक है\"\n  response response_statement_audit_claim_predicate_zh\n    intent statement_audit_claim_predicate\n    language zh\n    text \"claim 需要 predicate\"\n  response response_statement_audit_claim_predicate_es\n    intent statement_audit_claim_predicate\n    language es\n    text \"claim requiere predicate\"\n  response response_statement_audit_selector_required_ru\n    intent statement_audit_selector_required\n    language ru\n    text \"требуется statement либо subject и predicate\"\n  response response_statement_audit_selector_required_hi\n    intent statement_audit_selector_required\n    language hi\n    text \"statement या subject और predicate आवश्यक हैं\"\n  response response_statement_audit_selector_required_zh\n    intent statement_audit_selector_required\n    language zh\n    text \"需要 statement，或者同时需要 subject 和 predicate\"\n  response response_statement_audit_selector_required_es\n    intent statement_audit_selector_required\n    language es\n    text \"requiere statement o bien subject y predicate\"\n  response response_statement_audit_unknown_tier_ru\n    intent statement_audit_unknown_tier\n    language ru\n    text \"содержит неизвестный уровень источника\"\n  response response_statement_audit_unknown_tier_hi\n    intent statement_audit_unknown_tier\n    language hi\n    text \"एक अज्ञात स्रोत स्तर शामिल है\"\n  response response_statement_audit_unknown_tier_zh\n    intent statement_audit_unknown_tier\n    language zh\n    text \"包含未知的来源层级\"\n  response response_statement_audit_unknown_tier_es\n    intent statement_audit_unknown_tier\n    language es\n    text \"contiene un nivel de fuente desconocido\"\n  response response_s