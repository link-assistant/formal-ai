edencia de la fuente {language} no identifica un campo compatible en {qid}\"\n  response response_lexeme_import_block_parse_failed_es\n    intent lexeme_import_block_parse_failed\n    language es\n    text \"no se pudo analizar el bloque generado para {slug}\"\n  response response_lexeme_import_grounding_lost_es\n    intent lexeme_import_grounding_lost\n    language es\n    text \"{slug} perdió su fundamentación durante el análisis\"\n  response response_lexeme_import_wrong_genus_es\n    intent lexeme_import_wrong_genus\n    language es\n    text \"{slug} no está definido por {defined_by}\"\n  response response_lexeme_import_lexeme_lost_es\n    intent lexeme_import_lexeme_lost\n    language es\n    text \"{slug} perdió su lexema {language}\"\n  response response_lexeme_import_surface_missing_es\n    intent lexeme_import_surface_missing\n    language es\n    text \"el lexema {language} de {slug} no tiene ninguna superficie\"\n  response response_lexeme_import_surface_changed_es\n    intent lexeme_import_surface_changed\n    language es\n    text \"la superficie {language} de {slug} cambió durante el análisis\"\n  response response_lexeme_import_denotation_lost_es\n    intent lexeme_import_denotation_lost\n    language es\n    text \"la superficie {language} de {slug} ya no denota su significado\"\n  response response_lexeme_import_part_of_speech_lost_es\n    intent lexeme_import_part_of_speech_lost\n    language es\n    text \"la superficie {language} de {slug} perdió su part_of_speech\"\n  response response_lexeme_import_number_lost_es\n    intent lexeme_import_number_lost\n    language es\n    text \"la superficie {language} de {slug} perdió su grammatical_number\"\n  response response_lexeme_import_cannot_stage_es\n    intent lexeme_import_cannot_stage\n    language es\n    text \"no se puede preparar {path}: {error}\"\n  response response_lexeme_import_cannot_install_es\n    intent lexeme_import_cannot_install\n    language es\n    text \"no se puede instalar {file}: {error}\"\n  response response_lexeme_import_cannot_list_es\n    intent lexeme_import_cannot_list\n    language es\n    text \"no se puede enumerar {path}: {error}\"\n  response response_lexeme_import_cannot_inspect_es\n    intent lexeme_import_cannot_inspect\n    language es\n    text \"no se puede inspeccionar la salida: {error}\"\n  response response_lexeme_import_cannot_remove_stale_es\n    intent lexeme_import_cannot_remove_stale\n    language es\n    text \"no se puede eliminar el archivo obsoleto {file}: {error}\"\n  response response_requirement_contradiction_es\n    intent requirement_contradiction\n    language es\n    text \"Advertencia: dos de tus requisitos se contradicen.\\n- Afirmación 1 (peso {prior_weight}): «{prior}»\\n- Afirmación 2 (peso {current_weight}): «{current}»\\nImponen exigencias opuestas sobre el mismo sujeto ({subject}), por lo que no pueden cumplirse a la vez.\\nResolución propuesta: conserva una y retira la otra enviando un requisito que la sustituya. La red de requisitos es de solo adición, por lo que la retirada registra un evento nuevo sin borrar el historial. Como alternativa, separa los significados o limita cada requisito a un contexto distinto.\"\n  response response_shared_dialog_capture_parse_failed_es\n    intent shared_dialog_capture_parse_failed\n    language es\n    text \"no se pudo analizar el JSON de shared-dialog de web-capture: {error}\"\n  response response_shared_dialog_capture_unsupported_es\n    intent shared_dialog_capture_unsupported\n    language es\n    text \"el proveedor web-capture {provider} informó {reason}: {message}\"\n  response response_budget_search_solution_es\n    intent budget_search_solution\n    language es\n    text \"Encontrado mediante búsqueda con presupuesto: {expression} = {target}.\\nNinguna parte ni regla reutilizable coincidió, así que el solucionador combinó los números dados con los operadores permitidos y puntuó cada candidato frente a las pruebas de igualdad generadas como función de aptitud.\\nPresupuesto de búsqueda: {budget} evaluaciones de candidatos; se encontró una composición satisfactoria tras {evaluations} evaluaciones.\\nRuta de búsqueda: {trace_id}\"\n  response response_statement_audit_invalid_json_ru\n    intent statement_audit_invalid_json\n    language ru\n    text \"недопустимый JSON доказательств: {error}\"\n  response response_statement_audit_invalid_json_hi\n    intent statement_audit_invalid_json\n    language hi\n    text \"अमान्य साक्ष्य JSON: {error}\"\n  response response_statement_audit_invalid_json_zh\n    intent statement_audit_invalid_json\n    language zh\n    text \"无效的证据 JSON：{error}\"\n  response response_statement_audit_invalid_json_es\n    intent statement_audit_invalid_json\n    language es\n    text \"JSON de evidencia no válido: {error}\"\n  response response_statement_audit_capture_field_ru\n    intent statement_audit_capture_field\n    language ru\n    text \"снимок {index}, поле {field}: {detail}\"\n  response response_statement_audit_capture_field_hi\n    intent statement_audit_capture_field\n    language hi\n    text \"कैप्चर {index} का फ़ील्ड {field}: {detail}\"\n  response response_statement_audit_capture_field_zh\n    intent statement_audit_capture_field\n    language zh\n    text \"捕获 {index} 的字段 {field}：{detail}\"\n  response response_statement_audit_capture_field_es\n    intent statement_audit_capture_field\n    language es\n    text \"captura {index}, campo {field}: {detail}\"\n  response response_statement_audit_nonempty_ru\n    intent statement_audit_nonempty\n    language ru\n    text \"не должно быть пустым\"\n  response response_statement_audit_nonempty_hi\n    intent statement_audit_nonempty\n    language hi\n    text \"खाली नहीं होना चाहिए\"\n  response response_statement_audit_nonempty_zh\n    intent statement_audit_nonempty\n    language zh\n    text \"不得为空\"\n  response response_statement_audit_nonempty_es\n    intent statement_audit_nonempty\n    language es\n    text \"no debe