   00136| /// One literal slot, with the byte span of the delimiters that produced it.
   00137| ///
   00138| /// `start` is the offset of the opening delimiter and `end` is the offset just
   00139| /// past the closing one, so `text[start..end]` is the slot *including* its
   00140| /// quotes while [`Self::text`] is the content between them.
   00141| #[derive(Debug, Clone, PartialEq, Eq)]
   00142| pub struct QuotedSegment {
   00143|     /// The content between the delimiters.
   00144|     pub text: String,
   00145|     /// Byte offset of the opening delimiter.
   00146|     pub start: usize,
   00147|     /// Byte offset just past the closing delimiter.
   00148|     pub end: usize,
   00149| }
   00150| 
   00151| /// Extract structurally delimited literal slots, including zero-length slots.
   00152| ///
   00153| /// The surrounding prose is deliberately irrelevant. Callers can vary natural
   00154| /// language freely while the literal old/new values remain explicit. ASCII,
   00155| /// typographic, guillemet, and CJK quote pairs plus Markdown backticks are
   00156| /// accepted. A fenced triple-backtick block is treated as one slot.
   00157| #[must_use]
   00158| pub fn quoted_segments(text: &str) -> Vec<String> {
   00159|     quoted_segment_spans(text)
   00160|         .into_iter()
   00161|         .map(|segment| segment.text)
   00162|         .collect()
