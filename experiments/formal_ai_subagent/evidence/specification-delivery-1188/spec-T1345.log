   00164| 
   00165| /// [`quoted_segments`], keeping each slot's byte span.
   00166| ///
   00167| /// This is the single implementation behind every literal-slot reader. Callers
   00168| /// that only need the contents use [`quoted_segments`]; callers that must know
   00169| /// where a slot sat in the prose — to tell "replace X with Y in Z" from
   00170| /// "in Z replace X with Y" — use this.
   00171| #[must_use]
   00172| pub fn quoted_segment_spans(text: &str) -> Vec<QuotedSegment> {
   00173|     let mut result = Vec::new();
   00174|     let mut cursor = 0;
   00175|     while cursor < text.len() {
   00176|         let Some((open_at, open, close)) = next_delimiter(text, cursor) else {
   00177|             break;
   00178|         };
