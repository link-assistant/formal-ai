   00238|             && text[..close_at].ends_with('\\')
   00239|             && text[segment.end..]
   00240|                 .chars()
   00241|                 .next()
   00242|                 .is_some_and(|after| !after.is_whitespace() && !CLOSE_FOLLOWERS.contains(after))
   00243|         {
   00244|             faults.push(("escaped", close_at - 1));
   00245|         }
   00246|     }
