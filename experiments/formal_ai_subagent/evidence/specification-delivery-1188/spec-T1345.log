   00180|         let Some(content_end) = closing_delimiter(text, content_start, open, close) else {
   00181|             break;
   00182|         };
   00183|         let segment_end = content_end + close.len();
   00184|         result.push(QuotedSegment {
   00185|             text: text[content_start..content_end].to_owned(),
   00186|             start: open_at,
   00187|             end: segment_end,
   00188|         });
   00189|         cursor = segment_end;
   00190|     }
   00191|     result
   00192| }
