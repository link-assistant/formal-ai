   00001| //! Bounded execution for normal (Markov) string-rewrite algorithms.
   00002| //!
   00003| //! A program is an ordered list of substitutions. On every step the first rule
   00004| //! whose pattern occurs is selected, and its leftmost occurrence is replaced.
   00005| //! Evaluation restarts at rule zero after each non-terminal substitution. This
   00006| //! is the standard control model of a normal algorithm; terminal rules stop the
   00007| //! run immediately. Empty patterns and replacements are ordinary data, so the
   00008| //! same representation supports creation and deletion.
   00009| //!
   00010| //! Normal algorithms are computationally universal as an abstract model. This
   00011| //! executor intentionally adds a caller-selected step bound: universality is a
   00012| //! property of the representation, while a network-facing agent must not run an
   00013| //! untrusted non-terminating rewrite forever.
   00014| 
   00015| /// One ordered substitution in a normal algorithm.
   00016| #[derive(Debug, Clone, PartialEq, Eq)]
   00017| pub struct RewriteRule {
   00018|     /// The sequence to find. An empty pattern matches byte offset zero.
   00019|     pub pattern: String,
   00020|     /// The sequence that replaces the matched pattern. It may be empty.
   00021|     pub replacement: String,
   00022|     /// Whether applying this rule halts the program immediately.
   00023|     pub terminal: bool,
   00024| }
   00025| 
   00026| impl RewriteRule {
   00027|     /// Construct a non-terminal substitution.
   00028|     #[must_use]
   00029|     pub fn new(pattern: impl Into<String>, replacement: impl Into<String>) -> Self {
   00030|         Self {
   00031|             pattern: pattern.into(),
   00032|             replacement: replacement.into(),
   00033|             terminal: false,
   00034|         }
   00035|     }
   00036| 
   00037|     /// Mark this substitution as terminal.
   00038|     #[must_use]
   00039|     pub const fn terminal(mut self) -> Self {
   00040|         self.terminal = true;
   00041|         self
   00042|     }
   00043| }
   00044| 
   00045| /// An ordered normal algorithm with a resource bound.
   00046| #[derive(Debug, Clone, PartialEq, Eq)]
   00047| pub struct RewriteProgram {
   00048|     /// Rules in selection-priority order.
   00049|     pub rules: Vec<RewriteRule>,
   00050|     /// Maximum substitutions allowed in one execution.
   00051|     pub max_steps: usize,
   00052| }
   00053| 
   00054| impl RewriteProgram {
   00055|     /// Construct a program. A zero bound is valid and immediately yields
   00056|     /// [`RewriteHalt::StepLimit`].
   00057|     #[must_use]
   00058|     pub const fn new(rules: Vec<RewriteRule>, max_steps: usize) -> Self {
   00059|         Self { rules, max_steps }
   00060|     }
   00061| 
   00062|     /// Execute against `input` without mutating the caller's bytes.
   00063|     #[must_use]
   00064|     pub fn execute(&self, input: &str) -> RewriteOutcome {
   00065|         let mut output = input.to_owned();
   00066|         let mut trace = Vec::new();
   00067| 
   00068|         for _ in 0..self.max_steps {
   00069|             let Some((rule_index, byte_offset)) = self
   00070|                 .rules
   00071|                 .iter()
   00072|                 .enumerate()
   00073|                 .find_map(|(index, rule)| output.find(&rule.pattern).map(|at| (index, at)))
   00074|             else {
   00075|                 return RewriteOutcome {
   00076|                     output,
   00077|                     trace,
   00078|                     halt: RewriteHalt::NoApplicableRule,
   00079|                 };
   00080|             };
   00081|             let rule = &self.rules[rule_index];
   00082|             let end = byte_offset + rule.pattern.len();
   00083|             output.replace_range(byte_offset..end, &rule.replacement);
   00084|             trace.push(RewriteStep {
   00085|                 rule_index,
   00086|                 byte_offset,
   00087|             });
   00088|             if rule.terminal {
   00089|                 return RewriteOutcome {
   00090|                     output,
   00091|                     trace,
   00092|                     halt: RewriteHalt::TerminalRule(rule_index),
   00093|                 };
   00094|             }
   00095|         }
   00096| 
   00097|         RewriteOutcome {
   00098|             output,
   00099|             trace,
   00100|             halt: RewriteHalt::StepLimit,
   00101|         }
   00102|     }
   00103| }
