   00194| /// Where a request's quotes stop pairing (PR #1188 G71).
   00195| #[derive(Debug, Clone, PartialEq, Eq)]
   00196| pub struct QuoteFault {
   00197|     /// `escaped` for a backslash before a quote, `unpaired` for an opening
   00198|     /// quote that no literal holds.
