   00403| // A prompt is a capability question when one of the `feature_capability_question`
   00404| // interrogative cues occurs as a raw substring, checked in the prompt's own
   00405| // detected language only. A language the seed gives no cue reads as English,
   00406| // which also accepts a grammatical "is/are ... enabled/available" frame
   00407| // computed in code. Mirrors is_feature_capability_question in
   00408| // src/solver_handlers/feature_capability.rs (#386, R1188-U1).
   00409| function isFeatureCapabilityQuestion(normalized, language) {
   00410|   const mentions = (lang) =>
   00411|     mentionsRoleInLanguagesRaw(ROLE_FEATURE_CAPABILITY_QUESTION, normalized, [lang]);
   00412|   const cues = wordsForRoleInLanguages(ROLE_FEATURE_CAPABILITY_QUESTION, [language]);
   00413|   if (language !== "en" && cues.length > 0) return mentions(language);
   00414|   return mentions("en") || isEnglishAvailabilityQuestion(normalized);
   00415| }
