   00037| function detailQuery(prompt) {
   00038|   const lower = String(prompt || "").toLowerCase();
   00039|   const opening = wordsForRole(ROLE_RULE_DETAIL_REQUEST)
   00040|     .map((surface) => String(surface).toLowerCase())
   00041|     .filter((surface) => surface && lower.startsWith(surface))
   00042|     .sort((left, right) => right.length - left.length)[0];
   00043|   if (opening) return cleanRuleQuery(String(prompt || "").slice(opening.length));
   00044|   if (lower.includes("rule_unknown")) return "unknown";
   00045|   return "";
