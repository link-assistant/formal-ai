   00048| function findBehaviorRule(query) {
   00049|   const cleaned = cleanRuleQuery(query);
   00050|   const withoutPrefix = cleaned.startsWith("rule_") ? cleaned.slice(5) : cleaned;
   00051|   return behaviorRuleRecords().find(
   00052|     (rule) =>
   00053|       rule.id === cleaned ||
   00054|       rule.id === `rule_${withoutPrefix}` ||
   00055|       rule.intent === cleaned ||
   00056|       rule.intent === withoutPrefix ||
   00057|       rule.label.toLowerCase().includes(withoutPrefix),
   00058|   );
