   00084| const directRoleSurfacePresent = (role, lower) => roleWordForms(role).some((form) => form.text && lower.includes(form.text));
   00085| function looksLikeRuntimeRuleUpdate(text) {
   00086|   const raw = String(text || "");
   00087|   const lower = raw.toLowerCase();
   00088|   if (
   00089|     (directRoleSurfacePresent(ROLE_SKILL_TEACHING_TRIGGER_LEAD, lower) &&
   00090|       directRoleSurfacePresent(ROLE_SKILL_TEACHING_RESPONSE_VERB, lower)) ||
   00091|     directRoleSurfacePresent(ROLE_BEHAVIOR_RULE_EDIT_DIRECTIVE, lower)
   00092|   ) {
   00093|     return true;
   00094|   }
   00095|   for (const form of roleWordForms(ROLE_SKILL_WHEN_THEN_PAIR)) {
   00096|     if (form.slot !== "circumfix") continue;
   00097|     const head = form.before;
   00098|     const link = form.after;
   00099|     const headPos = lower.indexOf(head);
   00100|     if (headPos === -1) continue;
   00101|     const tail = lower.slice(headPos + head.length);
   00102|     const linkPos = tail.indexOf(link);
   00103|     if (linkPos === -1) continue;
   00104|     const absoluteLinkPos = headPos + head.length + linkPos;
   00105|     const beforeLink = raw.slice(headPos, absoluteLinkPos);
   00106|     const afterLink = raw.slice(absoluteLinkPos + link.length);
   00107|     if (beforeLink.includes("`") && afterLink.includes("`")) return true;
   00108|   }
   00109|   return false;
   00110| }
