   00112| function runtimeRuleFromText(text) {
   00113|   if (!looksLikeRuntimeRuleUpdate(text)) return null;
   00114|   const spans = codeSpans(text);
   00115|   let trigger = spans.length >= 2 ? spans[0].trim() : "";
   00116|   let answer = spans.length >= 2 ? spans[1].trim() : "";
   00117|   if (spans.length < 2) {
   00118|     const raw = String(text || "");
   00119|     const lower = raw.toLowerCase();
   00120|     for (const lead of roleWordForms(ROLE_SKILL_TEACHING_TRIGGER_LEAD)) {
   00121|       const leadText = String(lead.text || "");
   00122|       const leadPos = lower.indexOf(leadText);
   00123|       if (leadPos === -1) continue;
   00124|       const triggerStart = leadPos + leadText.length;
   00125|       const responseVerbs = roleWordForms(ROLE_SKILL_TEACHING_RESPONSE_VERB)
   00126|         .sort((left, right) => String(right.text || "").length - String(left.text || "").length);
   00127|       for (const responseVerb of responseVerbs) {
   00128|         const verb = String(responseVerb.text || "");
   00129|         const relativeVerbPos = lower.slice(triggerStart).indexOf(verb);
   00130|         if (relativeVerbPos === -1) continue;
   00131|         const verbPos = triggerStart + relativeVerbPos;
   00132|         trigger = raw.slice(triggerStart, verbPos).trim().replace(/^[`"':,\s]+|[`"':,\s]+$/gu, "");
   00133|         answer = raw
   00134|           .slice(verbPos + verb.length)
   00135|           .trim()
   00136|           .replace(/^[`"':,\s]+|[`"':,.!?\s]+$/gu, "");
   00137|         if (trigger && answer) break;
   00138|       }
   00139|       if (trigger && answer) break;
   00140|     }
   00141|   }
   00142|   if (!trigger || !answer) return null;
   00143|   return {
   00144|     id: stableBehaviorRuleId("behavior_rule_runtime", `${trigger}\n${answer}`),
   00145|     trigger,
   00146|     answer,
   00147|   };
   00148| }
