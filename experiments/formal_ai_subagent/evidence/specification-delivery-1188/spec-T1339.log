   00068| // Issue #144 / #386: recognize behavior-rule updates expressed as `When X then
   00069| // Y` (and translations) in addition to the explicit `When I say … answer …`
   00070| // grammar. No keyword is named here any more — every surface lives in the
   00071| // embedded meaning lexicon (data/seed/meanings-skill-compiler.lino) and is read
   00072| // by semantic role, mirroring explicit_teaching_form + looks_like_skill_description
   00073| // in src/skill_compiler.rs:
   00074| //   * a teaching trigger lead that co-occurs with a teaching response verb, or a
   00075| //     standalone behaviour-rule edit directive (the explicit teaching form); and
   00076| //   * a when-then frame whose circumfix surface brackets the trigger and answer —
   00077| //     the literal before the … (U+2026) is the head, the literal after it is the
   00078| //     link; both must appear in order, with a backtick on each side.
   00079| const ROLE_SKILL_TEACHING_TRIGGER_LEAD = "skill_teaching_trigger_lead";
   00080| const ROLE_SKILL_TEACHING_RESPONSE_VERB = "skill_teaching_response_verb";
   00081| const ROLE_BEHAVIOR_RULE_EDIT_DIRECTIVE = "behavior_rule_edit_directive";
   00082| const ROLE_SKILL_WHEN_THEN_PAIR = "skill_when_then_pair";
