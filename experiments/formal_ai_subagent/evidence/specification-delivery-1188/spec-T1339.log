   00353| // Issue #918: the features, their runtime switches and their localized labels
   00354| // and examples are data/seed/feature-capabilities.lino, read here as the
   00355| // native handler reads it; a language without an entry falls back to English.
   00356| function featureCapabilities() {
   00357|   const out = [];
   00358|   for (const root of codeTaskSeedRecords("feature-capabilities.lino")) {
   00359|     for (const node of codeTaskChildren(root, "feature")) {
   00360|       const localized = (kind) => {
   00361|         const group = codeTaskChildren(node, kind)[0];
   00362|         const table = {};
   00363|         for (const entry of (group && group.children) || []) table[entry.name] = String(entry.id || "");
   00364|         return table;
   00365|       };
   00366|       out.push({
   00367|         slug: String(node.id || "").replace(/^feature_capability_/u, ""),
   00368|         state: codeTaskChildValue(node, "state"),
   00369|         labels: localized("label"),
   00370|         examples: localized("example"),
   00371|       });
   00372|     }
   00373|   }
   00374|   return out;
   00375| }
