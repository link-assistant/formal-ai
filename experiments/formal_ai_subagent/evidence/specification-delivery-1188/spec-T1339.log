   00015|   const cleaned = normalizePrompt(normalized);
   00016|   const composed =
   00017|     lexiconMentionsRole(ROLE_KNOWLEDGE_INVENTORY_NOUN, cleaned) &&
   00018|     lexiconMentionsRole(ROLE_KNOWLEDGE_INVENTORY_INTERROGATIVE, cleaned) &&
   00019|     lexiconMentionsRole(ROLE_KNOWLEDGE_POSSESSION, cleaned);
   00020|   return (
   00021|     composed || lexiconMentionsRole(ROLE_KNOWLEDGE_INVENTORY_PHRASE, cleaned)
   00022|   );
   00023| }
