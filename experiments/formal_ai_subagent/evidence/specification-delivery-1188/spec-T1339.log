   00382| // Walk the `feature_capability_alias` meanings in seed declaration order — the
   00383| // historical FEATURE_CAPABILITIES priority — and return the first capability
   00384| // whose multilingual forms occur as a raw substring of `normalized`, checked in
   00385| // the prompt's own language plus English (English prompts check English only).
   00386| // The matched meaning's slug, minus its `feature_capability_` prefix, keys
   00387| // FEATURE_CAPABILITIES, so no surface alias is named here. Mirrors
   00388| // detect_feature_capability in src/solver_handlers/feature_capability.rs (#386).
   00389| function detectFeatureCapability(normalized, language) {
   00390|   const languages = language === "en" ? ["en"] : [language, "en"];
   00391|   const meaning = firstRoleMatchInLanguagesRaw(
   00392|     ROLE_FEATURE_CAPABILITY_ALIAS,
   00393|     normalized,
   00394|     languages,
   00395|   );
   00396|   if (!meaning) return null;
