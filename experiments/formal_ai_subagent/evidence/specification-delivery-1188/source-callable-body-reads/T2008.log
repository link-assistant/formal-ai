     goal "Set the contents of js/worker/formal_ai_worker_recurrence.js to exactly this content:\n````````````text\n// Trusted-source recurrence discovery for the browser worker.\n//\n// This module consumes a rebuildable cache generated from captured\n// Wikifunctions abstract definitions, testers, and Wikidata aliases. The cache\n// is procedure memory rather than semantic seed knowledge: deleting it and\n// running `cargo run --example generate_recurrence_source_cache -- --write`\n// reconstructs it byte-for-byte.\n\nlet cachedRecurrenceSourceRecords;\n\nasync function hydrateLinoSeedAndSourceCaches(raw) {\n  hydrateLinoSeedText(raw);\n  self.FORMAL_AI_RECURRENCE_SOURCE_CACHE_LINO = \"\";\n  try {\n    const response = await fetch(\n      withAssetVersion(\"source-cache/wikifunctions-recurrences.lino\"),\n    );\n    if (response && response.ok) {\n      self.FORMAL_AI_RECURRENCE_SOURCE_CACHE_LINO = await response.text();\n    }\n  } catch (_error) {\n    self.FORMAL_AI_RECURRENCE_SOURCE_CACHE_LINO = \"\";\n  }\n  cachedRecurrenceSourceRecords = undefined;\n}\n\nfunction recurrenceSourceRecords() {\n  if (cachedRecurrenceSourceRecords !== undefined) {\n    return cachedRecurrenceSourceRecords;\n  }\n  const root = parseLinoTree(\n    String(self.FORMAL_AI_RECURRENCE_SOURCE_CACHE_LINO || \"\"),\n  );\n  const catalog = root.children.find(\n    (node) => node.name === \"recurrence_source_cache\",\n  );\n  cachedRecurrenceSourceRecords = catalog\n    ? catalog.children.filter((node) => node.name === \"recurrence\")\n    : [];\n  return cachedRecurrenceSourceRecords;\n}\n\nfunction recurrenceFold(value) {\n  return String(value || \"\")\n    .toLowerCase()\n    .normalize(\"NFD\")\n    .replace(/\\p{M}/gu, \"\")\n    .replace(/[^\\p{L}\\p{N}!]+/gu, \" \")\n    .trim();\n}\n\nfunction recurrenceSourceMatch(prompt) {\n  const folded = recurrenceFold(prompt);\n  let best = null;\n  for (const record of recurrenceSourceRecords()) {\n    const forms = [codingChildValue(record, \"label\")].concat(\n      record.children\n        .filter((child) => child.name === \"alias\")\n        .map((alias) => codingChildValue(alias, \"text\")),\n    );\n    const matched = forms\n      .map(recurrenceFold)\n      .filter((form) => form.length >= 3 && folded.includes(form))\n      .sort((left, right) => right.length - left.length)[0];\n    if (matched && (!best || matched.length > best.length)) {\n      best = { record, length: matched.length };\n    }\n  }\n  return best ? best.record : null;\n}\n\nfunction recurrenceExpressionNode(record) {\n  const container = codingFindChild(record, \"expression\");\n  return container && container.children.length === 1\n    ? container.children[0]\n    : null;\n}\n\nfunction renderRecurrenceExpression(node, functionName) {\n  if (!node) return null;\n  const rendered = node.children.map((child) =>\n    renderRecurrenceExpression(child, functionName),\n  );\n  if (rendered.some((value) => value === null)) return null;\n  if (node.name === \"parameter\") return node.value;\n  if (node.name === \"literal\") return node.value;\n  if (node.name === \"recur\" && rendered.length === 1) {\n    const argument =\n      rendered[0].startsWith(\"(\") && rendered[0].endsWith(\")\")\n        ? rendered[0].slice(1, -1)\n        : rendered[0];\n    return `${functionName}(${argument})`;\n  }\n  if (node.name === \"conditional\" && rendered.length === 3) {\n    return `${rendered[1]} if ${rendered[0]} else ${rendered[2]}`;\n  }\n  const binary = {\n    less_equal: \"<=\",\n    equal: \"==\",\n    add: \"+\",\n    multiply: \"*\",\n    subtract: \"-\",\n  }[node.name];\n  if (binary && rendered.length === 2) {\n    return `(${rendered[0]} ${binary} ${rendered[1]})`;\n  }\n  if (node.name === \"subtract_one\" && rendered.length === 1) {\n    return `${rendered[0]} - 1`;\n  }\n  return null;\n}\n\nfunction evaluateRecurrenceExpression(node, root, parameter, value, depth) {\n  if (!node || depth > 10000) return null;\n  if (node.name === \"parameter\") return node.value === parameter ? value : null;\n  if (node.name === \"literal\") {\n    const literal = Number(node.value);\n    return Number.isFinite(literal) ? literal : null;\n  }\n  if (node.name === \"recur\" && node.children.length === 1) {\n    const argument = evaluateRecurrenceExpression(\n      node.children[0],\n      root,\n      parameter,\n      value,\n      depth + 1,\n    );\n    if (!Number.isInteger(argument) || argument < 0) return null;\n    return evaluateRecurrenceExpression(\n      root,\n      root,\n      parameter,\n      argument,\n      depth + 1,\n    );\n  }\n  if (node.name === \"conditional\" && node.children.length === 3) {\n    const condition = evaluateRecurrenceExpression(\n      node.children[0],\n      root,\n      parameter,\n      value,\n      depth + 1,\n    );\n    if (condition === null) return null;\n    return evaluateRecurrenceExpression(\n      condition ? node.children[1] : node.children[2],\n      root,\n      parameter,\n      value,\n      depth + 1,\n    );\n  }\n  const operands = node.children.map((child) =>\n    evaluateRecurrenceExpression(child, root, parameter, value, depth + 1),\n  );\n  if (operands.some((operand) => operand === null)) return null;\n  if (node.name === \"less_equal\" && operands.length === 2) {\n    return operands[0] <= operands[1];\n  }\n  if (node.name === \"equal\" && operands.length === 2) {\n    return operands[0] === operands[1];\n  }\n  if (node.name === \"add\" && operands.length === 2) {\n    return operands[0] + operands[1];\n  }\n  if (node.name === \"multiply\" && operands.length === 2) {\n    return operands[0] * operands[1];\n  }\n  if (node.name === \"subtract\" && operands.length === 2) {\n    return operands[0] - operands[1];\n  }\n  if (node.name === \"subtract_one\" && operands.length === 1) {\n    return operands[0] - 1;\n  }\n  return null;\n}\n\nfunction verifiedRecurrenceRecord(record) {\n  const root = recurrenceExpressionNode(record);\n  const parameter = codingChildValue(record, \"parameter\");\n  const tests = record.children.filter((child) => child.name === \"source_test\");\n  return (\n    root &&\n    parameter &&\n    tests.length > 0 &&\n    tests.every((test) => {\n      const argument = Number(codingChildValue(test, \"argument\"));\n      const expected = Number(codingChildValue(test, \"expected\"));\n      return (\n        Number.isFinite(argument) &&\n        Number.isFinite(expected) &&\n        evaluateRecurrenceExpression(root, root, parameter, argument, 0) === expected\n      );\n    })\n  );\n}\n\nfunction recurrenceObservation(prompt) {\n  const match = String(prompt || \"\").match(/\\b(\\d+)(?:st|nd|rd|th)?\\b/i);\n  // Shared policy for a bounded demonstration when no observation was asked.\n  return match ? Number(match[1]) : 10;\n}\n\nfunction readFormalParameterPositions(expression, formalParameters) {\n  if (!Array.isArray(formalParameters) || formalParameters.some((name) => typeof name !== 'string' || !name) || new Set(formalParameters).size !== formalParameters.length) return null;\n  const positions = new Map(formalParameters.map((name, position) => [name, position]));\n  const reads = new Set();\n  const visit = (node) => {\n    if (!node || typeof node.name !== 'string' || !Array.isArray(node.children)) return false;\n    if (node.name === 'parameter') {\n      if (node.children.length !== 0 || !positions.has(node.value)) return false;\n      reads.add(positions.get(node.value));\n      return true;\n    }\n    if (node.name === 'literal') return node.children.length === 0;\n    return node.children.every(visit);\n  };\n  return visit(expression) ? [...reads].sort((left, right) => left - right) : null;\n}\n\nfunction bindCallableReadCoverage(contract, taskSignature) {\n  if (!contract || !taskSignature || !['provisional', 'declared', 'observed'].includes(taskSignature.origin)) return null;\n  const readPositions = readFormalParameterPositions(contract.expression, contract.parameters);\n  if (readPositions === null || typeof contract.name !== 'string' || !contract.name) return null;\n  const declared = taskSignature.origin === 'declared';\n  const parameters = declared ? taskSignature.parameters : contract.parameters;\n  const name = taskSignature.origin === 'provisional' ? contract.name : taskSignature.name;\n  if (taskSignature.origin === 'observed' && taskSignature.arity !== contract.parameters.length) return null;\n  if (!Array.isArray(parameters) || parameters.length !== contract.parameters.length || parameters.some((parameter) => typeof parameter !== 'string' || !parameter) || new Set(parameters).size !== parameters.length || typeof name !== 'string' || !name) return null;\n  const names = new Map(contract.parameters.map((parameter, position) => [parameter, parameters[position]]));\n  const bind = (node) => ({ ...node, value: node.name === 'parameter' ? names.get(node.value) : node.value, children: node.children.map(bind) });\n  return { name, parameters: [...parameters], expression: bind(contract.expression), readParameterPositions: readPositions, referencedParameters: readPositions.length };\n}\n\nfunction sourceCallableRequestSignature(prompt) {\n  const text = String(prompt || \"\");\n  const name = extractPythonFunctionName(text);\n  if (!name) return { origin: \"provisional\" };\n  const declaration = new RegExp(\"(?:^|\\\\n)\\\\s*def\\\\s+\" + name + \"\\\\s*\\\\(([^()\\\\n]*)\\\\)\\\\s*(?:->\\\\s*([^:\\\\n]+))?\", \"u\").exec(text);\n  const inline = declaration || new RegExp(\"\\\\b\" + name + \"\\\\s*\\\\(([^()\\\\n]*)\\\\)\", \"u\").exec(text);\n  if (!inline) return null;\n  const parts = [];\n  let start = 0;\n  let depth = 0;\n  for (let position = 0; position < inline[1].length; position += 1) {\n    const character = inline[1][position];\n    if (\"[{\".includes(character)) depth += 1;\n    if (\"]}\".includes(character)) depth -= 1;\n    if (character === \",\" && depth === 0) {\n      parts.push(inline[1].slice(start, position).trim());\n      start = position + 1;\n    }\n  }\n  if (inline[1].trim()) parts.push(inline[1].slice(start).trim());\n  if (!declaration && new RegExp(\"\\\\bassert\\\\s+\" + name + \"\\\\s*\\\\(\", \"u\").test(text)) {\n    return { origin: \"observed\", name, arity: parts.length };\n  }\n  const parameters = parts.map(part => part.split(\":\")[0].trim());\n  if (depth !== 0 || parts.some(part => part.includes(\"=\") || part.startsWith(\"*\") || part === \"/\") || parameters.some(parameter => !/^[A-Za-z_][A-Za-z0-9_]*$/u.test(parameter))) return null;\n  const suffix = declaration && declaration[2] ? \" -> \" + declaration[2].trim() : \"\";\n  return { origin: \"declared\", name, parameters, declaration: \"def \" + name + \"(\" + inline[1] + \")\" + suffix + \":\" };\n}\n\nfunction trySourceRecurrenceSynthesis(prompt) {\n  const record = recurrenceSourceMatch(prompt);\n  if (!record || !verifiedRecurrenceRecord(record)) return null;\n  const signature = sourceCallableRequestSignature(prompt);\n  const contract = bindCallableReadCoverage({\n    name: codingChildValue(record, \"identifier\"),\n    parameters: [codingChildValue(record, \"parameter\")],\n    expression: recurrenceExpressionNode(record),\n  }, signature);\n  if (!contract) return null;\n  const functionName = contract.name;\n  const parameter = contract.parameters[0];\n  const root = contract.expression;\n  const expression = renderRecurrenceExpression(root, functionName);\n  if (!expression) return null;\n  const observation = recurrenceObservation(prompt);\n  const result = evaluateRecurrenceExpression(\n    root,\n    root,\n    parameter,\n    observation,\n    0,\n  );\n  if (result === null) return null;\n  const declaration = signature.origin === \"declared\" ? signature.declaration : `def ${functionName}(${parameter}):`;\n  const imports = String(prompt || \"\").split(\"\\n\").map(line => line.trim()).filter(line => /^(?:import\\s+|from\\s+\\S+\\s+import\\s+)/u.test(line)