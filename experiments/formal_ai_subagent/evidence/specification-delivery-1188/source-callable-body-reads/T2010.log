l(bound.referencedParameters, 0);\n});\n\ntest('repeated body reads are distinct positional inputs, never declaration counts', () => {\n  const body = { name: 'add', value: '', children: [parameter('right'), parameter('left'), parameter('right')] };\n  assert.deepEqual(readFormalParameterPositions(body, ['left', 'right']), [0, 1]);\n});\n\ntest('explicit signature binds AST parameters and recursive callable before actual execution', () => {\n  const bound = bindCallableReadCoverage(contract, { origin: 'declared', name: 'chosen', parameters: ['x'] });\n  const rendered = evaluate(worker, 'renderRecurrenceExpression(' + JSON.stringify(bound.expression) + ', ' + JSON.stringify(bound.name) + ')');\n  const source = 'def ' + bound.name + '(' + bound.parameters.join(', ') + '):\\n    return ' + rendered;\n  const script = 'import math\\n' + source + '\\nfor value in range(21):\\n    assert chosen(value) == math.factorial(value)\\n';\n  assert.equal(execFileSync('python3', ['-c', script], { encoding: 'utf8', timeout: 5000, env: { PATH: process.env.PATH } }), '');\n  assert.equal(contract.parameters[0], 'n');\n  assert.deepEqual(readFormalParameterPositions(expression, ['n']), [0]);\n});\n\ntest('explicit incompatible arity, duplicates and unresolved parameters reject honestly', () => {\n  assert.equal(bindCallableReadCoverage(contract, { origin: 'declared', name: 'chosen', parameters: ['x', 'y'] }), null);\n  assert.equal(readFormalParameterPositions(parameter('missing'), ['n']), null);\n  assert.equal(readFormalParameterPositions(parameter('n'), ['n', 'n']), null);\n  assert.equal(bindCallableReadCoverage(contract, { origin: 'declared', name: 'discovered_function', parameters: ['input'] }).name, 'discovered_function');\n});\n\ntest('actual source requests retain declared identity and reject unsupported signatures', () => {\n  const result = invoke('trySourceRecurrenceSynthesis', 'Write a Python function discovered_function(input) that returns the factorial of input');\n  assert.equal(result.intent, 'write_program');\n  assert.ok(result.content.includes('def discovered_function(input):'));\n  assert.ok(result.content.includes('input * discovered_function(input - 1)'));\n  assert.ok(result.evidence.includes('synthesis:callable_binding_origin:declared'));\n  const annotated = invoke('trySourceRecurrenceSynthesis', 'def chosen(x: int) -> int:\\n    \"\"\"Return the factorial of x.\"\"\"');\n  assert.ok(annotated.content.includes('def chosen(x: int) -> int:'));\n  for (const signature of ['chosen(x, y)', 'chosen(*x)', 'chosen(x=3)', 'chosen(x, /)']) {\n    assert.equal(invoke('trySourceRecurrenceSynthesis', 'def ' + signature + ':\\n    \"\"\"Return the factorial of x.\"\"\"'), null, signature);\n  }\n});\n\ntest('an assertion names the callable without turning its literal argument into a formal name', () => {\n  const result = invoke('trySourceRecurrenceSynthesis', 'Return the factorial.\\nassert chosen(3) == 6');\n  assert.ok(result.content.includes('def chosen(n):'));\n  assert.ok(result.content.includes('n * chosen(n - 1)'));\n  assert.ok(result.evidence.includes('synthesis:callable_binding_origin:observed'));\n});\n","filePath":"rust/tests/web/source-callable-read-contracts.test.mjs","file_path":"rust/tests/web/source-callable-read-contracts.test.mjs","path":"rust/tests/web/source-callable-read-contracts.test.mjs"}
