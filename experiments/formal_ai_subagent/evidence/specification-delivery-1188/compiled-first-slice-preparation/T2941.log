   00379|     /// Replay the package when `prompt` matches the compiled trigger.
   00380|     #[must_use]
   00381|     pub fn replay(&self, prompt: &str) -> Option<CompiledSkillReplay> {
   00382|         let normalized = normalize_prompt(prompt);
   00383|         if let Some(test) = self
   00384|             .expected_tests
   00385|             .iter()
   00386|             .find(|test| test.normalized_input == normalized)
   00387|         {
   00388|             return Some(CompiledSkillReplay {
   00389|                 package_id: self.id.clone(),
   00390|                 rule_id: test.trigger_id.clone(),
   00391|                 handler_id: test.handler_id.clone(),
   00392|                 answer: test.expected_output.clone(),
   00393|                 cache_hit: self.id.clone(),
   00394|             });
   00395|         }
   00396|         if normalized != self.normalized_trigger {
   00397|             return None;
   00398|         }
   00399|         Some(CompiledSkillReplay {
   00400|             package_id: self.id.clone(),
   00401|             rule_id: self.rule_id.clone(),
   00402|             handler_id: self.handler_id.clone(),
   00403|             answer: self.response.clone(),
   00404|             cache_hit: self.id.clone(),
   00405|         })
   00406|     }
