   00134| /// Error returned when a skill description cannot be lowered safely.
   00135| #[derive(Debug, Clone, PartialEq, Eq)]
   00136| pub enum SkillCompileError {
   00137|     /// The text did not match a supported deterministic skill shape.
   00138|     UnsupportedShape,
   00139|     /// The skill asks for nondeterministic or otherwise unsupported behavior.
   00140|     UnsupportedInstruction { reason: String },
