   00149|                 write!(formatter, "unsupported natural-language skill shape")
   00150|             }
   00151|             Self::UnsupportedInstruction { reason } => {
   00152|                 write!(
   00153|                     formatter,
   00154|                     "unsupported natural-language instruction: {reason}"
   00155|                 )
   00156|             }
   00157|             Self::PermissionRequired { capability } => {
   00158|                 write!(formatter, "skill requires explicit permission {capability}")
   00159|             }
   00160|         }
   00161|     }
