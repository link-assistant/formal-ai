   00618| fn extract_trigger_response(description: &str) -> Option<(String, String)> {
   00619|     if !looks_like_skill_description(description) {
   00620|         return None;
   00621|     }
   00622|     let spans = code_spans(description);
   00623|     if spans.len() >= 2 {
   00624|         let trigger = spans[0].trim();
   00625|         let response = spans[1].trim();
   00626|         if trigger.is_empty() || response.is_empty() {
   00627|             return None;
   00628|         }
   00629|         return Some((trigger.to_owned(), response.to_owned()));
   00630|     }
   00631|     extract_unquoted_explicit_rule(description)
   00632| }
   00633| 
   00634| /// Parse the same explicit teaching grammar when chat clients do not add code
   00635| /// spans, for example `When I say # answer with 42.`. Both separators come
   00636| /// from semantic roles in the seed; only surrounding prose is discarded.
   00637| fn extract_unquoted_explicit_rule(description: &str) -> Option<(String, String)> {
   00638|     let lower = description.to_lowercase();
   00639|     let lexicon = seed::lexicon();
   00640|     for lead in lexicon.role_word_forms(seed::ROLE_SKILL_TEACHING_TRIGGER_LEAD) {
   00641|         let lead_text = lead.text.as_str();
   00642|         let Some(lead_position) = lower.find(lead_text) else {
   00643|             continue;
   00644|         };
   00645|         let trigger_start = lead_position + lead_text.len();
   00646|         let mut response_verbs = lexicon.role_word_forms(seed::ROLE_SKILL_TEACHING_RESPONSE_VERB);
   00647|         response_verbs.sort_by_key(|form| std::cmp::Reverse(form.text.chars().count()));
   00648|         for response_verb in response_verbs {
   00649|             let verb = response_verb.text.as_str();
   00650|             let Some(relative_verb_position) = lower[trigger_start..].find(verb) else {
   00651|                 continue;
   00652|             };
   00653|             let verb_position = trigger_start + relative_verb_position;
   00654|             let trigger = clean_unquoted_rule_part(&description[trigger_start..verb_position]);
   00655|             let response_start = verb_position + verb.len();
   00656|             let response = clean_unquoted_rule_response(&description[response_start..]);
   00657|             if !trigger.is_empty() && !response.is_empty() {
   00658|                 return Some((trigger, response));
   00659|             }
   00660|         }
   00661|     }
   00662|     None
   00663| }
   00664| 
   00665| fn clean_unquoted_rule_part(value: &str) -> String {
   00666|     value
   00667|         .trim()
   00668|         .trim_matches(|character: char| matches!(character, '`' | '"' | '\'' | ':' | ','))
   00669|         .trim()
   00670|         .to_owned()
   00671| }
   00672| 
   00673| fn clean_unquoted_rule_response(value: &str) -> String {
   00674|     value
   00675|         .trim_matches(|character: char| {
   00676|             character.is_whitespace()
   00677|                 || matches!(character, '`' | '"' | '\'' | ':' | ',' | '.' | '!' | '?')
   00678|         })
   00679|         .to_owned()
   00680| }
   00681| 
   00682| /// True when `description` reads as a teachable skill — either an explicit
   00683| /// teaching form or a conditional when-then frame that quotes a trigger and reply.
   00684| ///
   00685| /// No keyword is named here. The explicit teaching form is read from the
   00686| /// [`skill_teaching_trigger_lead`](seed::ROLE_SKILL_TEACHING_TRIGGER_LEAD),
   00687| /// [`skill_teaching_response_verb`](seed::ROLE_SKILL_TEACHING_RESPONSE_VERB), and
   00688| /// [`behavior_rule_edit_directive`](seed::ROLE_BEHAVIOR_RULE_EDIT_DIRECTIVE) roles;
   00689| /// the when-then frames are read from the
   00690| /// [`skill_when_then_pair`](seed::ROLE_SKILL_WHEN_THEN_PAIR) role. Each frame is a
   00691| /// [`Slot::Circumfix`] surface whose literal before the ellipsis … (U+2026) is the
   00692| /// head clause and whose literal after it is the link clause. A description teaches
   00693| /// a skill when it contains a head, a link following that head, a backtick-quoted
   00694| /// trigger between them, and a backtick-quoted reply after the link — the same
   00695| /// byte test that once ran against a hardcoded keyword-pair table, now covering
   00696| /// every supported language from the data.
   00697| pub(crate) fn looks_like_skill_description(description: &str) -> bool {
   00698|     let lower = description.to_lowercase();
   00699|     if explicit_teaching_form(&lower) {
   00700|         return true;
   00701|     }
   00702|     seed::lexicon()
   00703|         .role_word_forms(seed::ROLE_SKILL_WHEN_THEN_PAIR)
   00704|         .into_iter()
   00705|         .filter(|form| form.slot() == Slot::Circumfix)
   00706|         .any(|form| {
   00707|             let head = form.before_slot();
   00708|             let link = form.after_slot();
   00709|             let Some(head_pos) = lower.find(head) else {
   00710|                 return false;
   00711|             };
   00712|             let Some(link_pos) = lower[head_pos + head.len()..].find(link) else {
   00713|                 return false;
   00714|             };
   00715|             let absolute_link_pos = head_pos + head.len() + link_pos;
   00716|             let before_link = &description[head_pos..absolute_link_pos];
   00717|             let after_link = &description[absolute_link_pos + link.len()..];
   00718|             before_link.contains('`') && after_link.contains('`')
   00719|         })
   00720| }
   00721| 
   00722| /// True when `lower` (an already-lower-cased description) is an explicit teaching
   00723| /// instruction — a trigger lead paired with a response verb, or a standalone
   00724| /// behaviour-rule edit directive.
   00725| ///
   00726| /// Every surface is read from the lexicon by meaning rather than named here. A
   00727| /// trigger lead ([`ROLE_SKILL_TEACHING_TRIGGER_LEAD`](seed::ROLE_SKILL_TEACHING_TRIGGER_LEAD))
   00728| /// teaches a skill only when it co-occurs with a response verb
   00729| /// ([`ROLE_SKILL_TEACHING_RESPONSE_VERB`](seed::ROLE_SKILL_TEACHING_RESPONSE_VERB));
   00730| /// an edit directive
   00731| /// ([`ROLE_BEHAVIOR_RULE_EDIT_DIRECTIVE`](seed::ROLE_BEHAVIOR_RULE_EDIT_DIRECTIVE))
   00732| /// is recognised on its own. Direct role surfaces are matched as raw substrings;
   00733| /// the caller has already lower-cased the description, so an inflectable stem
   00734| /// (the Russian "ответ") still folds its endings without walking `defined-by`
   00735| /// links into unrelated generic vocabulary.
   00736| fn explicit_teaching_form(lower: &str) -> bool {
   00737|     (direct_role_surface_present(seed::ROLE_SKILL_TEACHING_TRIGGER_LEAD, lower)
   00738|         && direct_role_surface_present(seed::ROLE_SKILL_TEACHING_RESPONSE_VERB, lower))
   00739|         || direct_role_surface_present(seed::ROLE_BEHAVIOR_RULE_EDIT_DIRECTIVE, lower)
   00740| }
   00741| 
   00742| /// Match only the surfaces declared directly by `role`, not the generic words
   00743| /// reached through its `defined-by` concepts. The latter include broad action
   00744| /// and relation vocabulary, which would make ordinary file edits look like
   00745| /// dialog-level behavior-rule declarations.
   00746| fn direct_role_surface_present(role: &str, lower: &str) -> bool {
   00747|     seed::lexicon()
   00748|         .role_word_forms(role)
   00749|         .into_iter()
   00750|         .any(|form| !form.text.is_empty() && lower.contains(&form.text))
   00751| }
   00752| 
   00753| fn code_spans(text: &str) -> Vec<String> {
   00754|     text.split('`')
   00755|         .enumerate()
   00756|         .filter_map(|(index, part)| {
   00757|             let trimmed = part.trim();
   00758|             if index % 2 == 1 && !trimmed.is_empty() {
   00759|                 Some(trimmed.to_owned())
   00760|             } else {
   00761|                 None
   00762|             }
   00763|         })
   00764|         .collect()
   00765| }
   00766| 
   00767| fn link_record(
   00768|     record_id: &str,
   00769|     record_type: &str,
   00770|     subtype: &str,
   00771|     source_id: &str,
   00772|     fields: &[(&str, &str)],
   00773| ) -> LinkRecord {
   00774|     let mut links = Vec::new();
   00775|     push_doublet(&mut links, record_id, "Type");
   00776|     push_doublet(&mut links, "Type", record_type);
   00777|     push_doublet(&mut links, record_type, "SubType");
   00778|     push_doublet(&mut links, "SubType", subtype);
   00779|     push_doublet(&mut links, subtype, "Value");
   00780|     push_doublet(&mut links, record_id, source_id);
   00781|     push_field(
   00782|         &mut links,
   00783|         record_id,
   00784|         "schema_version",
   00785|         KNOWLEDGE_SCHEMA_VERSION,
   00786|     );
   00787|     for (key, value) in fields {
   00788|         push_field(&mut links, record_id, key, value);
   00789|     }
   00790|     LinkRecord {
   00791|         stable_id: record_id.to_owned(),
   00792|         schema_version: String::from(KNOWLEDGE_SCHEMA_VERSION),
   00793|         record_type: record_type.to_owned(),
   00794|         source_id: source_id.to_owned(),
   00795|         links,
   00796|     }
   00797| }
   00798| 
   00799| fn push_field(links: &mut Vec<DoubletLink>, record_id: &str, key: &str, value: &str) {
   00800|     if value.is_empty() {
