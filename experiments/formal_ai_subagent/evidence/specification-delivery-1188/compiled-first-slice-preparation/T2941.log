   00408|     /// Export the compiled package as reviewable Links Notation.
   00409|     #[must_use]
   00410|     pub fn links_notation(&self) -> String {
   00411|         let mut out = String::new();
   00412|         push_lino_node(&mut out, 0, &self.id, None);
   00413|         push_lino_node(&mut out, 2, "type", Some("compiled_skill_package"));
   00414|         push_lino_node(
   00415|             &mut out,
   00416|             2,
   00417|             "schema_version",
   00418|             Some(KNOWLEDGE_SCHEMA_VERSION),
   00419|         );
   00420|         push_lino_node(&mut out, 2, "package_kind", Some("associative_package"));
   00421|         push_lino_node(&mut out, 2, "source", Some("natural_language_skill"));
   00422|         push_lino_node(
   00423|             &mut out,
   00424|             2,
   00425|             "source_description",
   00426|             Some(&self.source_description),
   00427|         );
   00428|         push_lino_node(&mut out, 2, "skill_name", Some(&self.skill_name));
   00429|         push_lino_node(&mut out, 2, "trigger_rule", Some(&self.rule_id));
   00430|         push_lino_node(&mut out, 2, "trigger", Some(&self.trigger));
   00431|         push_lino_node(
   00432|             &mut out,
   00433|             2,
   00434|             "normalized_trigger",
   00435|             Some(&self.normalized_trigger),
   00436|         );
   00437|         push_lino_node(&mut out, 2, "compiled_handler", Some(&self.handler_id));
   00438|         push_lino_node(&mut out, 2, "handler_kind", Some("deterministic_response"));
   00439|         push_lino_node(&mut out, 2, "response", Some(&self.response));
   00440|         push_lino_node(&mut out, 2, "replay_mode", Some("exact_normalized_prompt"));
   00441|         push_lino_node(
   00442|             &mut out,
   00443|             2,
   00444|             "legacy_behavior_rule_id",
   00445|             Some(&self.legacy_behavior_rule_id),
   00446|         );
   00447|         for input in &self.inputs {
   00448|             push_lino_node(&mut out, 2, "input", Some(&input.name));
   00449|             push_lino_node(&mut out, 4, "id", Some(&input.id));
   00450|             push_lino_node(&mut out, 4, "type", Some(&input.value_type));
   00451|         }
   00452|         for precondition in &self.preconditions {
   00453|             push_lino_node(&mut out, 2, "precondition", Some(&precondition.id));
   00454|             push_lino_node(&mut out, 4, "description", Some(&precondition.description));
   00455|         }
   00456|         for step in &self.steps {
   00457|             let order = step.order.to_string();
   00458|             push_lino_node(&mut out, 2, "step", Some(&step.id));
   00459|             push_lino_node(&mut out, 4, "order", Some(&order));
   00460|             push_lino_node(&mut out, 4, "description", Some(&step.description));
   00461|         }
   00462|         for effect in &self.effects {
   00463|             push_lino_node(&mut out, 2, "effect", Some(&effect.id));
   00464|             push_lino_node(&mut out, 4, "description", Some(&effect.description));
   00465|         }
   00466|         for test in &self.expected_tests {
   00467|             push_lino_node(&mut out, 2, "expected_test", Some(&test.id));
   00468|             push_lino_node(&mut out, 4, "input", Some(&test.input));
   00469|             push_lino_node(
   00470|                 &mut out,
   00471|                 4,
   00472|                 "normalized_input",
   00473|                 Some(&test.normalized_input),
   00474|             );
   00475|             push_lino_node(&mut out, 4, "expected_output", Some(&test.expected_output));
   00476|             push_lino_node(&mut out, 4, "trigger_rule", Some(&test.trigger_id));
   00477|             push_lino_node(&mut out, 4, "compiled_handler", Some(&test.handler_id));
   00478|         }
   00479|         for permission in &self.required_permissions {
   00480|             push_lino_node(&mut out, 2, "permission", Some(&permission.id));
   00481|             push_lino_node(&mut out, 4, "capability", Some(&permission.capability));
   00482|             push_lino_node(&mut out, 4, "description", Some(&permission.description));
   00483|         }
   00484|         for stub in &self.handler_stubs {
   00485|             push_lino_node(&mut out, 2, "handler_stub", Some(&stub.id));
   00486|             push_lino_node(&mut out, 4, "target", Some(&stub.target));
   00487|             push_lino_node(&mut out, 4, "signature", Some(&stub.signature));
   00488|             push_lino_node(&mut out, 4, "source_code", Some(&stub.source));
   00489|         }
   00490|         out.trim_end().to_owned()
   00491|     }
