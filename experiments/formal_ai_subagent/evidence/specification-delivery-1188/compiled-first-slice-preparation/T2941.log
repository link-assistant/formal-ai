   00166| /// Compile a natural-language skill into a reusable associative package.
   00167| ///
   00168| /// Supported shapes include `When I say "X", answer "Y"`, `If I ask "X",
   00169| /// reply "Y"`, and the multilingual `When "X" then "Y"` forms already used by
   00170| /// behavior-rule teaching.
   00171| pub fn compile_natural_language_skill(
   00172|     description: &str,
   00173| ) -> Result<CompiledSkillPackage, SkillCompileError> {
   00174|     if let Some(spec) = parse_structured_skill(description)? {
   00175|         return CompiledSkillPackage::from_structured(description, spec);
   00176|     }
   00177|     let Some((trigger, response)) = extract_trigger_response(description) else {
   00178|         return Err(SkillCompileError::UnsupportedShape);
   00179|     };
   00180|     Ok(CompiledSkillPackage::new(description, &trigger, &response))
   00181| }
