0079|     pub command: Option<String>,\n00080| }\n00081| /// A deterministic plan composed from a formalized, previously unrecognised request.\n00082| #[derive(Debug, Clone, PartialEq, Eq)]\n00083| pub struct GeneralChangePlan {\n00084|     pub id: String,\n00085|     pub mode: GeneralPlanMode,\n00086|     pub goal: String,\n00087|     pub target: String,\n00088|     pub content: String,\n00089|     pub steps: Vec<GeneralPlanStep>,\n00090|     /// The command that observes the requested artifact after the change.\n00091|     /// Empty when the plan can name no such command, which is the only honest\n00092|     /// answer for a plan that reaches [`PlanTerminalState::PlannedNotExecuted`].\n00093|     pub verification_command: String,\n00094|     pub terminal_state: PlanTerminalState,\n00095| }\n00096| impl GeneralChangePlan {\n00097|     /// Render the plan shape consumed by the driver and documented by the meta fixture.\n00098|     #[must_use]\n00099|     pub fn links_notation(&self) -> String {\n00100|         let mut out = String::from(\"general_change_plan\\n\");\n00101|         field(&mut out, \"id\", &self.id);\n00102|         field(&mut out, \"execution_mode\", self.mode.slug());\n00103|         field(&mut out, \"terminal_state\", self.terminal_state.slug());\n00104|         field(&mut out, \"goal\", &self.goal);\n00105|         field(&mut out, \"target\", &self.target);\n00106|         for (index, step) in self.steps.iter().enumerate() {\n00107|             let _ = writeln!(out, \"  step {}\", index + 1);\n00108|             field_nested(&mut out, \"capability\", capability_slug(step.capability));\n00109|             field_nested(&mut out, \"action\", &step.action);\n00110|             field_nested(&mut out, \"expected_evidence\", &step.expected_evidence);\n00111|             if let Some(command) = &step.command {\n00112|                 field_nested(&mut out, \"command\", command);\n00113|             }\n00114|         }\n00115|         if !self.verification_