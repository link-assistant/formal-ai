    .iter()\n00433|             .any(|token| actions.contains(&clean_cue_token(token.text)));\n00434|         if !has_write_action {\n00435|             continue;\n00436|         }\n00437|         let target = suffix_tokens.iter().enumerate().find_map(|(index, token)| {\n00438|             let cleaned = clean_path_token(token.text);\n00439|             let looks_like_file = looks_like_file_path(cleaned);\n00440|             let previous = index\n00441|                 .checked_sub(1)\n00442|                 .map(|position| &suffix_tokens[position])?;\n00443|             let cue = clean_cue_token(previous.text);\n00444|             (looks_like_file\n00445|                 && safe_relative_path(cleaned)\n00446|                 && (targets.contains(&cue) || destinations.contains(&cue)))\n00447|             .then(|| cleaned.to_owned())\n00448|         });\n00449|         if let Some(target) = target {\n00450|             return Some((target, command.to_owned()));\n00451|         }\n00452|     }\n00453|     None\n00454| }\n00455| pub(super) fn mentions_bare_role(text: &str, role: &str) -> bool {\n00456|     let lower = text.to_lowercase();\n00457|     seed::lexicon()\n00458|         .role_word_forms(role)\n00459|         .iter()\n00460|         .filter(|form| form.slot() == Slot::Bare)\n00461|         .any(|form| {\n00462|             let needle = form.text.to_lowercase();\n00463|             let Some(start) = lower.find(&needle) else {\n00464|                 return false;\n00465|             };\n00466|             if !needle.is_ascii() {\n00467|                 return true;\n00468|             }\n00469|             let end = start + needle.len();\n00470|             let before_ok = start == 0\n00471|                 || lower[..start]\n00472|                     .chars()\n00473|                     .next_back()\n00474|                     .is_some_and(|character| !character.is_alphanumeric());\n00475|             let after_ok = end == lower.len()\n00476|                 || lower[end..]\n00477|                     .chars()\n00478|                     .next()\n00479|                     .is_some_and(|character| !character.is_alphanumeric());\n00480|             before_ok && after_ok\n00481|         })\n00482| }\n00483| pub(super) fn shell_quote(value: &str) -> String {\n00484|     format!(\"'{}'\", value.replace('\\'', \"'\\\\''\"))\n00485| }\n00486| fn command_plan_text(intent: &str, language: &str, target: &str) -> String {\n00487|     seed::localized_response(intent, language)\n00488|         .unwrap_or_else(|| intent.to_owned())\n00489|         .replace(TARGET_PLACEHOLDER, target)\n00490| }\n00491| /// Whether `lower` (an already-lowercased request) is a file **write / create**\n00492| /// intent — a write verb applied to something file-shaped. This is the single\n00493| /// signal the router uses to keep a file-creation request from ever being\n00494| /// misrouted to the file-read recipe (issue #681): a request to *produce* a file\n00495| /// is a write, never a read of the not-yet-existing target.\n00496| ///\n00497| /// This is intentionally the same structural parse used to compose the eventual\n00498| /// write plan. A request is classified as a write only when the seed-defined\n00499| /// action/target/content roles yield a safe target and non-empty payload. One\n00500| /// parser for classification and composition cannot drift into claiming an\n00501| /// operation that the planner is unable to execute.\n00502| #[must_use]\n00503| pub(crate) fn has_file_write_intent(lower: &str) -> bool {\n00504|     parse_write_request(lower).is_some()\n00505| }\n00506| /// Whether a request explicitly marks its recovered payload as authoritative\n00507| /// literal bytes rather than a description of another workspace operation.\n00508| ///\n00509| /// The marker is seed-backed and multilingual. Requiring both the narrow marker\n00510| /// role and a successfully composed literal-file plan prevents arbitrary prose\n00511| /// containing