07|         // Hindi \"जिसमें Gemfile.lock हो\" would otherwise write the verb into the\n00608|         // file with the content.\n00609|         let payload_end = content_lead_close(&lowered, marker_end)\n00610|             .map_or(statement_end, |close| close.min(statement_end));\n00611|         let marker_span = request.get(marker_end..payload_end);\n00612|         if (!marker_leads || first_action_cue_end(toks).is_some())\n00613|             && let Some(content) = marker_span.and_then(clean_content).filter(|content| {\n00614|                 is_literal_content(content)\n00615|                     && (!names_deferred_work_product(content)\n00616|                         || first_prefix_lead_end(\n00617|                             &lowered,\n00618|                             seed::ROLE_FILE_WRITE_AUTHORITATIVE_CONTENT_LEAD,\n00619|                         )\n00620|                         .is_some())\n00621|             })\n00622|         {\n00623|             return Some((target, content));\n00624|         }\n00625|     }\n00626|     let content_span = if cue_is_destination && binding.cue_precedes {\n00627|         let action_end = first_action_cue_end(toks)?;\n00628|         (action_end <= clause_start && positions_share_statement(request, action_end, clause_start))\n00629|             .then(|| request.get(action_end..clause_start))?\n00630|     } else if cue_is_destination {\n00631|         // The same shape read from the other side. A language that marks its\n00632|         // destination with a postposition and closes the clause with the verb —\n00633|         // \"notes/attribution.md में Gemfile.lock लिखो\" — states the payload\n00634|         // between the two, exactly as the prepositional wording states it\n00635|         // between the verb and the preposition.\n00636|         let action_start = action_cue_start_after(toks, binding.cue_end)?;\n00637|         (binding.cue_end <= action_start\n00638|             && positions_share_statement(request, binding.cue_end, action_start))\n00639|         .then(|| request.get(binding.cue_end..action_start))?\n00640|     } else if let Some(value_lead) = toks\n00641|         .iter()\n00642|         .skip(file_index + 1)\n00643|         .find(|token| dest_cues.contains(&clean_cue_token(token.text)))\n00644|     {\n00645|         // Assignment shape: \"set the contents of FILE to VALUE\". The target\n00646|         // cue identifies the file object and a following destination cue\n00647|         // introduces its literal value. Requiring a write action before the\n00648|         // file keeps an unrelated \"contents of FILE\" read request out.\n00649|         let action_end = first_action_cue_end(toks)?;\n00650|         (action_end <= clause_start\n00651|             && positions_share_statement(request, action_end, clause_start)\n00652|             && positions_share_statement(request, clause_start, value_lead.start))\n00653|         .then(|| request.get(value_lead.end..))?\n00654|     } else {\n00655|         None\n00656|     };\n00657|     let content = clean_content(content_span?)?;\n00658|     // A recovered payload that is *only* a non-referential subject (\"save it to\n00659|     // FILE\", \"write this to FILE\") names no literal content — the pronoun points\n00660|     // back at content the request expects the recipe to still compose. Treating\n00661|     // it as a literal write both fabricates the wrong file (the string \"it\") and\n00662|     // steals the request from the keyword recipe that would author the real\n00663|     // artifact, so fall through instead (issue #663).\n00664|     //\n00665|     // The same is true of a payload that names the *work product* rather than\n00666|     // supplying it: \"save the answer to FILE\" states where an answer goes, not\n00667|     // what it says (issue #1066).\n00668|     if is_non_referential_content(&content)\n00669|         || names_deferred_work_product(&content)\n00670|         || !is_literal_content(&content)\n00671|     {\n00672|         return None;\n00673|     }\n00674|     Some((target, content))\n00675| }\n00676| /// Where the statement that begins at `from` ends, never past `limit`.\n00677| ///\n00678| /// A literal payload is something the request *states*, and a statement ends\n00679| /// where its sentence does. Bounding the span by the file clause alone reads\n00680| /// across every sentence in between: \"Draft a handover memo containing the\n00681| /// migration status, the outstanding blockers, and the on-call owner. Leave the\n00682| /// memo in `handover/2026-q3.md`\" put the marker in the first sentence and the\n00683| /// clause in the second, so the recovered payload ended with the words *Leave\n00684| /// the memo* and the caller's memo opened by instructing them to leave it\n00685| /// (issue #1066).\n00686| ///\n00687| /// The clause bound still applies inside the sentence, because \"write the\n00688| /// following: hello to `x.txt`\" states marker, payload and clause in one\n00689| /// breath. This only refuses to look further than the sentence the marker is in.\n00690| ///\n00691| /// A marker that says nothing more on its own line is the exception, because\n00692| /// there the payload is a *block* rather than a phrase: \"Create file\n00693| /// `rules.lino` containing\\n<three lines of lino>\" leaves the marker with an\n00694| /// empty tail, and a newline ends a sentence, so the sentence bound would\n00695| /// recover nothing at all. When the marker's own line has no word left on it,\n00696| /// the statement is the block that follows and runs to `limit`, which is what\n00697| /// this route always did for block payloads.\n00698| ///\n00699| /// The sentence is the one *prose* reads, so a semicolon inside the payload\n00700| /// joins its two halves instead of ending it. Reading the payload at the scope\n00701| /// shell routing reads at cut issue #918's minimal-core invariant in half at\n00702| /// its semicolon.\n00703| fn end_of_statement(request: &str, from: usize, limit: usize) -> usize {\n00704|     let Some(sentence) = prose_sentences(request)\n00705|         .into_iter()\n00706|         .find(|sentence| sentence.span.contains(&from))\n00707|     else {\n00708|         return limit;\n00709|     };\n00710|     if let Some(literal) = crate::normal_markov::quoted_segment_spans(request)\n00711|         .into_iter()\n00712|         .find(|segment| {\n00713|             segment.start >= from\n00714|                 && segment.start < sentence.span.end\n00715|                 && segment.end > sentence.span.end\n00716|         })\n00717|     {\n00718|         return literal.end.min(limit);\n00719|     }\n00720|     let says_more = request\n00721|         .get(from..sentence.span.end)\n00722|         .is_some_and(|tail| tail.chars().any(char::is_alphanumeric));\n00723|     if says_more && !payload_continues_past_its_first_line(request, from, sentence.span.end) {\n00724|         sentence.span.end.min(limit)\n00725|     } else {\n00726|         limit\n00727|     }\n00728| }\n00729| /// Whether two write-request cues belong to one prose statement.\n00730| ///\n00731| /// Literal-write roles are structural only inside the statement that relates\n00732| /// them. Without this check, a content lead in one issue-description paragraph\n00733| /// can pair with an incidental file-shaped token in a later paragraph and turn\n00734| /// repository policy prose into an executable write (issue #1069).\n00735| ///\n00736| /// [`end_of_statement`] deliberately lets a marker-only line introduce the\n00737| /// block below it. Reusing that boundary here preserves that supported block\n00738| /// shape while rejecting ordinary completed sentences between the two cues.\n00739| fn positions_share_statement(request: &str, left: usize, right: usize) -> bool {\n00740|     let (from, limit) = if left <= right {\n00741|         (left, right)\n00742|     } else {\n00743|         (right, left)\n00744|     };\n00745|     from == limit || end_of_statement(request, from, limit) == limit\n00746| }\n00747| /// Whether a recovered payload says anything at all. A span of nothing but\n00748| /// punctuation is what a mis-parse leaves behind — the `opencode` leg of the\n00749| /// issue-#671 matrix recovered a single `\"`, the tail of a quoted prompt after\n00750| /// its trailing content-lead marker — and writing it would replace real file\n00751| /// bytes with a stray delimiter.\n00752| fn is_literal_content(content: &str) -> bool {\n00753|     content.chars().any(char::is_alphanumeric)\n00754| }\n00755| /// Whether a recovered write payload is nothing but a non-referential subject —\n00756| /// a bare pronoun/function word (\"it\", \"this\", \"that\", …) that refers back to\n00757| /// context rather than naming literal content. The surfaces carry the\n00758| /// [`seed::ROLE_NON_REFERENTIAL_SUBJECT`] role; only whole-word\n00759| /// ([`Slot::Bare`]) forms are rejected, so legitimate content that merely\n00760| /// *begins* with such a word (\"to be or not to be\") is still accepted.\n00761| fn is_non_referential_content(content: &str) -> bool {\n00762|     let lower = content.to_lowercase();\n00763|     seed::lexicon()\n00764|         .role_word_forms(seed::ROLE_NON_REFERENTIAL_SUBJECT)\n00765|         .iter()\n00766|         .any(|form| form.slot() == Slot::Bare && lower == form.text)\n00767| }\n00768| /// Whether a recovered write payload names the result of work the same request\n00769| /// asks for, instead of supplying bytes (issue #1066).\n00770| ///\n00771| /// \"Save the answer to `out/e.md`\" and \"leave observable evidence to\n00772| /// `out/e.md`\" have the destination-led shape of a literal write -- a write\n00773| /// verb, a span, a destination cue, a path -- and supply no literal. Taking the\n00774| /// span at face value wrote the words *the answer* into the file and, worse,\n00775| /// claimed the request as finished, so the investigation that would have\n00776| /// produced the real bytes never ran.\n00777| ///\n00778| /// The surfaces carry [`seed::ROLE_FILE_WRITE_DEFERRED_CONTENT_REFERENCE`] as\n00779| /// [`Slot::Suffix`] forms, because the head noun is what defers and the\n00780| /// modifiers in front of it (\"observable\", \"final\") are the caller's, not the\n00781| /// lexicon's.\n00782| ///\n00783| /// Applied to marker-led content too: “with the observed result” uses a content\n00784| /// marker syntactically, but still names work that has not happened. Explicit\n00785| /// bytes remain expressible through the authoritative-content marker, whose\n00786| /// distinct role is routed before derived-delivery planning.\n00787| fn names_deferred_work_product(content: &str) -> bool {\n00788|     let lower = content\n00789|         .trim()\n00790|         .trim_end_matches(['.', '!', '?', '。', '！', '？'])\n00791|         .trim_end()\n00792|         .to_lowercase();\n00793|     seed::lexicon()\n00794|         .role_word_forms(seed::ROLE_FILE_WRITE_DEFERRED_CONTENT_REFERENCE)\n00795|         .iter()\n00796|         .any(|form| match form.slot() {\n00797|             Slot::Bare => lower == form.text,\n00798|             Slot::Suffix => ends_with_head_noun(&lower, form.after_slot().trim_start()),\n00799|             Slot::Prefix | Slot::Circumfix => false,\n00800|         })\n00801| }\n00802| /// Whether `content` ends with `noun` standing as its own word.\n00803| ///\n00804| /// English and Russian separate a head noun from its modifiers with a space, so\n00805| /// the character before the match settles it. Chinese writes the same phrase\n00806| /// with no separator at all, which is why the boundary is stated as \"not an\n00807| /// ASCII alphanumeric\" rather than \"whitespace\": demanding a space would never\n00808| /// match 结论, and demanding nothing would match the tail of an unrelated\n00809| /// English word.\n00810| fn ends_with_head_noun(content: &str, noun: &str) -> bool {\n00811|     !noun.is_empty()\n00812|         && content.strip_suffix(noun).is_some_and(|before| {\n00813|             before\n00814|                 .chars()\n00815|                 .next_back()\n00816|                 .is_none_or(|character| !character.is_ascii_alphanumeric())\n00817|         })\n00818| }\n00819| /// Resolve an edit target named in a request through the workspace self-AST\n00820| /// census (issue #673).\n00821| ///\n00822| /// Before the census existed, the planner could only edit a file the request spelt\n00823| /// out in full, and its own self-inspection was pinned to a single hardcoded module\n00824| /// (`src/agentic_coding/planner.rs`). Now any `path`, `path:symbol`, unambiguous\n00825| /// module suffix, or uniquely-declared item name resolves to the real module path\n00826| /// through [`crate::self_ast_census`], so the planner can address every module of\n00827| /// the workspace by the same mechanism.\n00828| ///\n00829| /// The token must *address* the workspace to be resolved: it has to carry a\n00830| /// directory component (`agentic_coding/source_links.rs`) or a `path:symbol`\n00831| /// pair (`self_ast_census.rs:resolve_census_target`). A bare file name such as\n00832| /// `main.rs` is left exactly as the request spelt it, because the request may be\n00833| /// about the *client's* working directory rather than this workspace, and an\n00834| /// ordinary word that happens to match an item name is never mistaken for an edit\n00835| /// target. The census itself fails closed on anything ambiguous.\n00836| #[must_use]\n00837| pub fn resolve_census_target(reference: &str) -> Option<CensusResolution> {\n00838|     let addresses_workspace =\n00839|         reference.contains('/') || (reference.contains(':') && !reference.contains(\"://\"));\n00840|     if !addresses_workspace {\n00841|         return None;\n00842|     }\n00843|     self_ast_census::workspace().resolve(reference)\n00844| }\n00845| /// Whether `text` carries a software-authoring verb (implement, resolve,\n00846| /// develop, …) in any seeded language.\n00847| #[must_use]\n00848| pub fn mentions_software_authoring(text: &str) -> bool {\n00849|     mentions_bare_role(text, seed::ROLE_SOFTWARE_AUTHORING_ACTION)\n00850| }\n00851| const fn capability_slug(capability: Capability) -> &'static str {\n00852|     match capability {\n00853|         Capability::Search => \"Search\",\n00854|         Capability::Fetch => \"Fetch\",\n00855|         Capability::Read => \"Read\",\n00856|         Capability::Write => \"Write\",\n00857|         Capability::Edit => \"Edit\",\n00858|         Capability::Run => \"Run\",\n00859|         Capability::Grep => \"Grep\",\n00860|         Capability::Glob => \"Glob\",\n00861|         Capability::ListDir => \"ListDir\",\n00862|         Capability::Todo => \"Todo\",\n00863|         Capability::Subagent => \"Subagent\",\n00864|         Capability::ReadMany => \"ReadMany\",\n00865|         Capability::MultiEdit => \"MultiEdit\",\n00866|         Capability::AskUser => \"AskUser\",\n00867|     }\n00868| }\n00869| fn language(request: &str) -> &'static str {\n00870|     crate::language::detect(request).slug()\n00871| }\n00872| fn escape(value: &str) -> String {\n00873|     value\n00874|         .replace('\\\\', \"\\\\\\\\\")\n00875|         .replace('\"', \"\\\\\\\"\")\n00876|         .replace('\\n', \"\\\\n\")\n00877| }\n00878| fn field(out: &mut String, name: &str, value: &str) {\n00879|     let _ = writeln!(out, \"  {name} \\\"{}\\\"\", escape(value));\n00880| }\n00881| fn field_nested(out: &mut String, name: &str, value: &str) {\n00882|     let _ = writeln!(out, \"    {name} \\\"{}\\\"\", escape(value));\n00883| }\n00884| \n\n(End of file - total 884 lines)\n</file>"
