// Both byte offsets index the lowercased copy, which is byte-length preserving\n00544| /// for en/ru/hi/zh, so the same offsets slice the original request and the\n00545| /// recovered content keeps its case and punctuation.\n00546| fn parse_write_request(request: &str) -> Option<(String, String)> {\n00547|     let toks = tokens(request);\n00548|     // A cue between two file-shaped tokens can belong to either of them, and the\n00549|     // ranking only says which reading to try first. The reading that recovers a\n00550|     // payload is the one the sentence supports, so the candidates are taken in\n00551|     // order and the first that parses is the answer. A sentence that offers one\n00552|     // candidate reaches exactly the branch it always did.\n00553|     ranked_bindings(&toks)\n00554|         .into_iter()\n00555|         .find_map(|binding| parse_write_request_bound(request, &toks, &binding))\n00556| }\n00557| \n00558| /// Read `request` as a write delivered through one particular binding.\n00559| fn parse_write_request_bound(\n00560|     request: &str,\n00561|     toks: &[Token<'_>],\n00562|     binding: &WriteBinding,\n00563| ) -> Option<(String, String)> {\n00564|     let lowered = request.to_lowercase();\n00565|     let dest_cues = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);\n00566|     let file_index = binding.index;\n00567|     let target = binding.path.clone();\n00568|     // The clause is the cue and its path together, so it begins at whichever of\n00569|     // them the language puts first.\n00570|     let clause_start = if binding.cue_precedes {\n00571|         binding.cue_start\n00572|     } else {\n00573|         toks[file_index].start\n00574|     };\n00575|     let cue_is_destination = binding.family == CueFamily::Destination;\n00576|     // Marker-led content. The payload sits after the marker, bounded by the file\n00577|     // clause when the marker comes first (\"write the following: hello to x.txt\")\n00578|     // and running