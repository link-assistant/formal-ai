   00279| /// Every cued target in token order, so a caller that has a further question to
   00280| /// ask about a candidate can go on to the next one instead of losing the
   00281| /// sentence with it.
   00282| pub(super) fn cued_write_targets(toks: &[Token<'_>]) -> Vec<(usize, String)> {
   00283|     write_bindings(toks)
   00284|         .into_iter()
   00285|         .filter(|binding| binding.cue_precedes)
   00286|         .map(|binding| (binding.index, binding.path))
   00287|         .collect()
   00288| }
