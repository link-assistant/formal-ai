   00230| /// The target file of a write, as `(token index, path)`.
   00231| ///
   00232| /// A sentence can offer more than one file-shaped token behind a cue, and which
   00233| /// one it *delivers to* is not the leftmost: "Write Gemfile.lock into
   00234| /// notes/attribution.md" names the content first, behind the bare action cue
   00235| /// *Write*, and the destination second, behind *into*. Binding the leftmost
   00236| /// bound the content as the target, the destination-led branch below then failed
   00237| /// its `action_end <= clause_start` test, and the whole clause composed to
   00238| /// nothing — in all five languages.
   00239| ///
   00240| /// So the candidates are ranked by what named them rather than by where they
   00241| /// stand: a path a *target* or *destination* cue points at outranks one only an
   00242| /// action cue stands beside, and a cue that follows its path (a postposition)
   00243| /// ranks last. A sentence that offers exactly one candidate is unaffected, which
   00244| /// is every sentence the earlier rule read correctly.
   00245| pub(super) fn cued_write_target(toks: &[Token<'_>]) -> Option<(usize, String)> {
   00246|     preferred_binding(toks).map(|binding| (binding.index, binding.path))
   00247| }
   00248| 
   00249| /// Every candidate binding, best first.
   00250| ///
   00251| /// A cue that stands *between* two file-shaped tokens could belong to either of
   00252| /// them, and no ranking settles that on its own: `notes/attribution.md में
   00253| /// Gemfile.lock लिखो` puts the destination postposition after the path it marks,
   00254| /// so the same rule that reads `into notes/attribution.md` correctly reads the
   00255| /// Hindi sentence backwards. The reading is settled by the rest of the sentence
   00256| /// instead — the caller takes these in order and keeps the first that yields a
   00257| /// payload — so the ranking only has to decide which reading is *tried* first.
   00258| pub(super) fn ranked_bindings(toks: &[Token<'_>]) -> Vec<WriteBinding> {
   00259|     let mut bindings = write_bindings(toks);
   00260|     bindings.sort_by_key(binding_rank);
   00261|     bindings
   00262| }
   00263| 
   00264| /// The binding a write request is read through: the highest-ranked candidate.
   00265| pub(super) fn preferred_binding(toks: &[Token<'_>]) -> Option<WriteBinding> {
   00266|     ranked_bindings(toks).into_iter().next()
   00267| }
   00268| 
   00269| /// Lower ranks are preferred. Token order breaks a tie, which `min_by_key`
   00270| /// preserves because the bindings are produced in token order.
   00271| const fn binding_rank(binding: &WriteBinding) -> u8 {
   00272|     match (binding.cue_precedes, binding.family) {
   00273|         (true, CueFamily::Target | CueFamily::Destination) => 0,
   00274|         (true, CueFamily::Action) => 1,
   00275|         (false, _) => 2,
   00276|     }
   00277| }
