   00122| /// Where the payload a circumfix content marker opened has to stop.
   00123| ///
   00124| /// "जिसमें Gemfile.lock हो" states its content between two literals, and so does
   00125| /// "把 Gemfile.lock 写入": the closing literal is a grammatical boundary, not
   00126| /// part of the bytes. Returns [`None`] when the marker that ended at `from` was
   00127| /// not a circumfix one, which is every marker in the languages that put their
   00128| /// content last.
   00129| pub(super) fn content_lead_close(lowered: &str, from: usize) -> Option<usize> {
   00130|     seed::lexicon()
   00131|         .role_word_forms(seed::ROLE_FILE_WRITE_CONTENT_LEAD)
   00132|         .iter()
   00133|         .filter(|form| form.slot() == Slot::Circumfix)
   00134|         .filter_map(|form| {
   00135|             let opener = form.before_slot().trim().to_lowercase();
   00136|             let closer = form.after_slot().trim().to_lowercase();
   00137|             if opener.is_empty()
   00138|                 || closer.is_empty()
   00139|                 || !lowered.get(..from)?.trim_end().ends_with(&opener)
   00140|             {
   00141|                 return None;
   00142|             }
   00143|             lowered
   00144|                 .get(from..)?
   00145|                 .find(&closer)
   00146|                 .map(|relative| from + relative)
   00147|         })
