   00363| /// The span of a cue standing at the *end* of `token`, if one does.
   00364| ///
   00365| /// An unspaced script writes the cue and the word before it as one token —
   00366| /// `创建文件` is "create" and "file" with nothing between them — so for a cue in
   00367| /// such a script the token's tail is the boundary the language actually has.
   00368| fn trailing_cue(token: &Token<'_>, cues: &[String], fused: bool) -> Option<(usize, usize)> {
   00369|     let cleaned = clean_cue_token(token.text);
   00370|     cues.iter().find_map(|cue| {
   00371|         if cleaned == *cue {
   00372|             return Some((token.start, token.end));
   00373|         }
   00374|         (fused && is_unspaced_surface(cue) && cleaned.ends_with(cue.as_str()))
   00375|             .then(|| (token.end.saturating_sub(cue.len()), token.end))
   00376|     })
   00377| }
   00378| 
   00379| /// The span of a cue standing at the *start* of `token`, if one does.
   00380| fn leading_cue(token: &Token<'_>, cues: &[String], fused: bool) -> Option<(usize, usize)> {
   00381|     let cleaned = clean_cue_token(token.text);
   00382|     cues.iter().find_map(|cue| {
   00383|         if cleaned == *cue {
   00384|             return Some((token.start, token.end));
   00385|         }
   00386|         (fused && is_unspaced_surface(cue) && cleaned.starts_with(cue.as_str()))
   00387|             .then(|| (token.start, token.start + cue.len()))
   00388|     })
   00389| }
