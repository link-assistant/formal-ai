   00016| /// Split whitespace and ideographic punctuation while retaining byte spans.
   00017| /// Without punctuation boundaries, an unspaced clause can become one path token.
   00018| pub(super) fn tokens(request: &str) -> Vec<Token<'_>> {
   00019|     let mut out = Vec::new();
   00020|     let mut start: Option<usize> = None;
   00021|     for (index, character) in request.char_indices() {
   00022|         if character.is_whitespace() || is_ideographic_punctuation(character) {
   00023|             if let Some(from) = start.take() {
   00024|                 out.push(Token {
   00025|                     text: &request[from..index],
   00026|                     start: from,
   00027|                     end: index,
   00028|                     request,
   00029|                 });
   00030|             }
   00031|             continue;
   00032|         }
   00033|         if start.is_none() {
   00034|             start = Some(index);
   00035|         }
   00036|     }
   00037|     if let Some(from) = start {
   00038|         out.push(Token {
   00039|             text: &request[from..],
   00040|             start: from,
   00041|             end: request.len(),
   00042|             request,
   00043|         });
   00044|     }
   00045|     out
   00046| }
