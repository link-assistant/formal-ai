   00397| /// Whether a token is written as a double-quoted literal.
   00398| ///
   00399| /// A path is *mentioned* -- bare, or set in the backticks this repository's
   00400| /// prose uses for code -- whereas a double-quoted token is a *value* the
   00401| /// sentence is handing to something else: the member "add \"bun.lock\" to the
   00402| /// `IGNORE_FILES` list" inserts, the marker the ladder asks a record to contain.
   00403| /// Both can be file-shaped, and `clean_path_token` peels either quoting away, so
   00404| /// the distinction has to be read before the peeling.
   00405| fn quoted_as_value(word: &str) -> bool {
   00406|     let bare = peel_sentence_punctuation(word, |token| token.trim_end_matches([',', ':', ';']));
   00407|     bare.len() >= 2 && bare.starts_with('"') && bare.ends_with('"')
   00408| }
   00409| /// The path a request names as the destination of a write, whether or not it
   00410| /// also spells the bytes out.
   00411| ///
   00412| /// [`parse_write_request`] answers a narrower question — it recovers a write it
   00413| /// can execute verbatim — and deliberately declines a request whose payload has
   00414| /// still to be *composed*. The evidence-record route needs the target of
   00415| /// exactly that declined shape ("record what you find in FILE"), so the target
   00416| /// half of the parse is exposed on its own rather than duplicated (issue #1066).
   00417| pub(super) fn stated_write_target(request: &str) -> Option<String> {
   00418|     cued_write_target(&tokens(request)).map(|(_, target)| target)
   00419| }
   00420| /// Bind a source destination using the ordinary cue/path safety rules, with
   00421| /// the language's artifact type as a further constraint. Output operands and
   00422| /// workflow paths do not become source destinations by appearing first.
   00423| pub fn typed_write_target(request: &str, extension: &str) -> Option<String> {
   00424|     cued_write_targets(&tokens(request))
   00425|         .into_iter()
   00426|         .map(|(_, path)| path)
   00427|         .find(|path| {
   00428|             std::path::Path::new(path)
   00429|                 .extension()
   00430|                 .and_then(|value| value.to_str())
   00431|                 == Some(extension)
   00432|         })
   00433| }
