   00009| /// One whitespace token together with its byte span in the original request.
   00010| pub(super) struct Token<'a> {
   00011|     pub(super) text: &'a str,
   00012|     pub(super) start: usize,
   00013|     pub(super) end: usize,
   00014|     pub(super) request: &'a str,
