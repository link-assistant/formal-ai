   00150| pub(super) fn first_prefix_lead_end(lowered: &str, role: &str) -> Option<(usize, usize)> {
   00151|     let markers: Vec<(String, String)> = seed::lexicon()
   00152|         .role_word_forms(role)
   00153|         .iter()
   00154|         .filter(|form| matches!(form.slot(), Slot::Prefix | Slot::Circumfix))
   00155|         .map(|form| {
   00156|             (
   00157|                 form.before_slot().trim().to_lowercase(),
   00158|                 form.after_slot().trim().to_lowercase(),
   00159|             )
   00160|         })
   00161|         .filter(|(marker, _)| !marker.is_empty())
   00162|         .collect();
   00163|     let mut best: Option<(usize, usize)> = None;
   00164|     for (marker, closer) in &markers {
   00165|         let mut from = 0;
   00166|         while let Some(relative) = lowered[from..].find(marker.as_str()) {
   00167|             let start = from + relative;
   00168|             let end = start + marker.len();
   00169|             let cjk = !marker.contains(' ') && !marker.is_ascii();
   00170|             let before_ok = cjk
   00171|                 || start == 0
   00172|                 || lowered[..start]
   00173|                     .chars()
   00174|                     .next_back()
   00175|                     .is_some_and(char::is_whitespace);
   00176|             let after_ok = cjk
   00177|                 || end == lowered.len()
   00178|                 || lowered[end..]
   00179|                     .chars()
   00180|                     .next()
   00181|                     .is_some_and(|c| c.is_whitespace() || c.is_ascii_punctuation());
   00182|             // A circumfix form holds its subject *between* two literals, so its
   00183|             // opener means nothing on its own: "把" opens a Chinese object
   00184|             // phrase only when the verb that closes it follows. Requiring the
   00185|             // closer keeps a one-character opener from claiming every sentence
   00186|             // that happens to contain it.
   00187|             let closed = closer.is_empty() || lowered[end..].contains(closer.as_str());
   00188|             if before_ok && after_ok && closed {
   00189|                 if best.is_none_or(|(best_start, best_end)| {
   00190|                     start < best_start || (start == best_start && end > best_end)
   00191|                 }) {
   00192|                     best = Some((start, end));
   00193|                 }
   00194|                 break;
   00195|             }
   00196|             from = end;
   00197|         }
   00198|     }
   00199|     best
   00200| }
