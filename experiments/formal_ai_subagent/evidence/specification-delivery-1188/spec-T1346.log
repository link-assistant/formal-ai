   00391| /// Whether a surface belongs to a script that does not separate its words with
   00392| /// spaces, so a token boundary is not where the word ends.
   00393| fn is_unspaced_surface(surface: &str) -> bool {
   00394|     crate::coding::catalog::contains_cjk(surface)
   00395| }
