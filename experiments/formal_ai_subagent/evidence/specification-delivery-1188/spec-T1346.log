   00436| /// Used with [`stated_write_target`] to tell "record it in FILE" (a write whose
   00437| /// content is composed) from "read the first line in FILE" (a read that merely
   00438| /// mentions a file after a positional cue).
   00439| pub(super) fn states_write_action(request: &str) -> bool {
   00440|     first_action_cue_end(&tokens(request)).is_some()
