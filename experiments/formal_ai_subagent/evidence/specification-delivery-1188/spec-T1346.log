   00048| /// Whether a character is one of the ideographic punctuation marks that
   00049| /// separate words and clauses in a script written without spaces.
   00050| const fn is_ideographic_punctuation(character: char) -> bool {
   00051|     matches!(character,
   00052|         '\u{3001}'..='\u{3003}'
   00053|             | '\u{3008}'..='\u{3011}'
   00054|             | '\u{3014}'..='\u{301f}'
   00055|             | '\u{ff01}'
   00056|             | '\u{ff08}'
   00057|             | '\u{ff09}'
   00058|             | '\u{ff0c}'
   00059|             | '\u{ff1a}'
   00060|             | '\u{ff1b}'
   00061|             | '\u{ff1f}')
   00062| }
