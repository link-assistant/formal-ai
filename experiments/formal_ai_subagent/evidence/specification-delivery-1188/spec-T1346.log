   00290| /// Every path a cue binds, in token order.
   00291| ///
   00292| /// A cue stands before its path in the languages that put it there and after it
   00293| /// in the languages that do not: Hindi writes `notes/attribution.md फ़ाइल` and
   00294| /// `notes/attribution.md में`, so a reader that only ever looks one token back
   00295| /// finds no target in a Hindi request at all. A postposition is therefore read
   00296| /// too, but only for the target and destination families — an action cue after a
   00297| /// path closes the clause rather than naming the file — and only when the path
   00298| /// has no cue in front of it.
   00299| fn write_bindings(toks: &[Token<'_>]) -> Vec<WriteBinding> {
   00300|     let target_cues = bare_surfaces(seed::ROLE_FILE_WRITE_TARGET_CUE);
   00301|     let dest_cues = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);
   00302|     let action_cues = bare_surfaces(seed::ROLE_FILE_WRITE_ACTION_CUE);
   00303|     // The fused reading is for the nouns and particles that a script without
   00304|     // spaces writes against their neighbour — `创建文件` is "create" and "file",
   00305|     // `文件` is the cue. A verb is not read that way: `输出内容 sample.txt` opens
   00306|     // with the write verb `输出` and means "output the contents of", a read, and
   00307|     // reading the verb out of the fused token claimed the file the request asked
   00308|     // to be shown.
   00309|     let families = [
   00310|         (CueFamily::Destination, &dest_cues, true),
   00311|         (CueFamily::Target, &target_cues, true),
   00312|         (CueFamily::Action, &action_cues, false),
   00313|     ];
   00314|     let quoted =
   00315|         crate::normal_markov::quoted_segment_spans(toks.first().map_or("", |token| token.request));
   00316|     toks.iter()
   00317|         .enumerate()
   00318|         .filter_map(|(index, token)| {
   00319|             let cleaned = clean_path_token(token.text);
   00320|             if !looks_like_file_path(cleaned) || !safe_relative_path(cleaned) {
   00321|                 return None;
   00322|             }
   00323|             let path = cleaned.to_owned();
   00324|             if let Some(previous) = index.checked_sub(1).map(|before| &toks[before])
   00325|                 && let Some((family, cue_start, cue_end)) =
   00326|                     families.iter().find_map(|(family, cues, fused)| {
   00327|                         trailing_cue(previous, cues, *fused).map(|span| (*family, span.0, span.1))
   00328|                     })
   00329|             {
   00330|                 return Some(WriteBinding {
   00331|                     index,
   00332|                     path,
   00333|                     cue_start,
   00334|                     cue_end,
   00335|                     family,
   00336|                     cue_precedes: true,
   00337|                 });
   00338|             }
   00339|             let next = toks.get(index + 1)?;
   00340|             families
   00341|                 .iter()
   00342|                 .take(2)
   00343|                 .find_map(|(family, cues, fused)| {
   00344|                     leading_cue(next, cues, *fused).map(|span| (*family, span.0, span.1))
   00345|                 })
   00346|                 .map(|(family, cue_start, cue_end)| WriteBinding {
   00347|                     index,
   00348|                     path,
   00349|                     cue_start,
   00350|                     cue_end,
   00351|                     family,
   00352|                     cue_precedes: false,
   00353|                 })
   00354|         })
   00355|         .filter(|binding| {
   00356|             !quoted
   00357|                 .iter()
   00358|                 .any(|segment| binding.cue_start < segment.end && binding.cue_end > segment.start)
   00359|         })
   00360|         .collect()
   00361| }
