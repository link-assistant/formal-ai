   00443| /// The path a sentence names as the *destination* of a write it states.
   00444| ///
   00445| /// [`stated_write_target`] answers a weaker question -- which path a cue points
   00446| /// at -- and a sentence can point a cue at a path it is not delivering to,
   00447| /// because the same cues introduce the file the work is done *in*. Both of these
   00448| /// name a path after a target cue and state a write action:
   00449| ///
   00450| /// > In the file `src/solver_handlers/document_request.rs`, add "toward " to the
   00451| /// > TARGET_MARKERS list.
   00452| ///
   00453| /// > Then create `agent-ladder-effects/node-1.1.2.2.1.lino` recording what you
   00454| /// > changed.
   00455| ///
   00456| /// Only the second is somewhere to put an answer. In the first the thing being
   00457| /// added goes into a list *inside* the file, and reading it as a delivery
   00458| /// destroys the file it was asked to edit -- the planner writes its own status
   00459| /// line over the source and the write reports success.
   00460| ///
   00461| /// What separates them is order, the same adjacency principle
   00462| /// [`cued_write_target`] already uses to bind a cue to a path. A delivery
   00463| /// composes something and then says where to put it, so its path *follows* the
   00464| /// action; a sentence that says where the work happens states the place first
   00465| /// and the action afterwards.
   00466| ///
   00467| /// Measured over the 1 118 request sentences this repository records that name a
   00468| /// file and carry a cue (`experiments/issue_1069_paths_in_prose/cue-order-survey.py`),
   00469| /// the path follows the action in 21.56% of them, precedes it in 65.74%, and in
   00470| /// the remaining 12.70% there is no write cue at all -- an edit, which is never a
   00471| /// delivery. So this reads roughly a fifth of them as destinations, where the
   00472| /// weaker "cues a path and states a write" test reads all 1 118.
   00473| ///
   00474| /// The rule that suggests itself first is the cue family: the seed declares a
   00475| /// second family for edits, so a sentence mentioning one could be doing work
   00476| /// rather than delivering. That fails on this corpus. Thirty of the sentences
   00477| /// carry both families, and the ladder's own delivery sentence is one of them --
   00478| /// "Then create `agent-ladder-effects/node-1.1.2.2.1.lino` … followed by at
   00479| /// least four words that state the **change** you made" -- so the family rule
   00480| /// discards the record the node exists to produce. Position separates what
   00481| /// mention cannot.
   00482| ///
   00483| /// Position alone still admits a value that merely *looks* like a path, because
   00484| /// the operand of an insertion follows the action too: "Edit `scripts/metric.rs`:
   00485| /// add \"bun.lock\" to the `IGNORE_FILES` list" names the file before the action
   00486| /// and the member after it. So the candidates are taken in order and a
   00487| /// double-quoted one is skipped rather than accepted -- see [`quoted_as_value`].
   00488| /// The same survey measures what that costs: of the 241 sentences the position
   00489| /// rule admits, 2 (0.83%) quote their path, and both are member insertions of
   00490| /// exactly this shape. No delivery destination in the corpus is double-quoted.
   00491| pub(super) fn delivered_write_target(sentence: &str) -> Option<String> {
   00492|     let toks = tokens(sentence);
   00493|     let action = first_action_cue_start(&toks)?;
   00494|     cued_write_targets(&toks)
   00495|         .into_iter()
   00496|         .find(|(index, _)| toks[*index].start > action && !quoted_as_value(toks[*index].text))
   00497|         .map(|(_, path)| path)
   00498| }
   00499| 
   00500| /// Whether `request` names `path` as the destination of a write it states.
   00501| ///
   00502| /// The read routes need this to keep from opening the file they were asked to
   00503| /// create. "Leave observable evidence in `.agent-ladder/node-1.2-proof.md`. The
   00504| /// first line must be exactly `node_path=1.2`" names one path and one read cue
   00505| /// -- *first line* -- and the two belong to different obligations: the path is
   00506| /// where the answer goes, the cue describes how it has to open. Read the prompt
   00507| /// as a whole and the cue captures the path, and the run opens the file it was
   00508| /// supposed to write.
   00509| ///
   00510| /// Scoped to a sentence, for the same reason [`super::evidence_record`] scopes
   00511| /// its own split: "Read the file `Cargo.toml`. Record what you find in
   00512| /// `notes/report.md`." states a write of the second path only, and the first
   00513| /// must stay readable.
   00514| pub(super) fn is_stated_write_target(request: &str, path: &str) -> bool {
   00515|     sentences(request).into_iter().any(|sentence| {
   00516|         states_write_action(sentence.text)
   00517|             && stated_write_target(sentence.text).is_some_and(|target| target == path)
   00518|     })
   00519| }
   00520| 
   00521| /// The opening line a sentence pins, read through
   00522| /// [`seed::ROLE_FILE_LEADING_LINE_CONSTRAINT_LEAD`].
   00523| ///
   00524| /// The lowercased copy is byte-length preserving for every supported language,
   00525| /// so the marker's end offset slices the original sentence and the recovered
   00526| /// line keeps its case.
   00527| pub(super) fn pinned_first_line(sentence: &str) -> Option<String> {
   00528|     let lowered = sentence.to_lowercase();
   00529|     let (_, end) = first_prefix_lead_end(&lowered, seed::ROLE_FILE_LEADING_LINE_CONSTRAINT_LEAD)?;
   00530|     let raw = sentence
   00531|         .get(end..)?
   00532|         .trim()
   00533|         .trim_start_matches([':', '-', '\u{2014}', '\u{2013}'])
   00534|         .trim();
   00535|     let line = delimited_first_line(raw)
   00536|         .or_else(|| unquoted_machine_first_line(raw))
   00537|         .unwrap_or(raw)
   00538|         .trim_matches(['`', '"', '\'']);
   00539|     (!line.is_empty()).then(|| line.to_owned())
   00540| }
   00541| 
   00542| /// An explicitly delimited opening line, without the presentation delimiters.
   00543| ///
   00544| /// The closing delimiter is also a grammatical boundary: in "exactly `id=7`
   00545| /// and the body ...", the coordinated body constraint is not part of the
   00546| /// machine-readable header.
   00547| fn delimited_first_line(raw: &str) -> Option<&str> {
   00548|     let delimiter = raw.chars().next()?;
   00549|     if !matches!(delimiter, '`' | '"' | '\'') {
   00550|         return None;
   00551|     }
   00552|     let after_open = raw.get(delimiter.len_utf8()..)?;
   00553|     let close = after_open.find(delimiter)?;
   00554|     after_open.get(..close)
   00555| }
   00556| 
   00557| /// Stop an unquoted machine header before a coordinated second requirement.
   00558| ///
   00559| /// Natural-language lines such as "ready and waiting" remain whole. A compact
   00560| /// assignment/header token (`name=value`, `name:value`) followed by a
   00561| /// seed-defined procedure separator is unambiguous: the separator begins the
   00562| /// next clause, as it did in the live Agent ladder prompt.
   00563| fn unquoted_machine_first_line(raw: &str) -> Option<&str> {
   00564|     let lowered = raw.to_lowercase();
   00565|     bare_surfaces(seed::ROLE_SKILL_PROCEDURE_CLAUSE_SEPARATOR)
   00566|         .into_iter()
   00567|         .filter_map(|separator| {
   00568|             let marker = format!(" {separator} ");
   00569|             lowered.find(&marker).and_then(|boundary| {
   00570|                 let candidate = raw.get(..boundary)?.trim();
   00571|                 (!candidate.contains(char::is_whitespace) && candidate.contains(['=', ':']))
   00572|                     .then_some(candidate)
   00573|             })
   00574|         })
   00575|         .min_by_key(|candidate| candidate.len())
   00576| }
   00577| /// The opening line the request pins, wherever in the request it pins it.
   00578| ///
   00579| /// A pinned first line constrains the finished file, not the sentence that
   00580| /// happens to state it. [`super::evidence_record`] reads the constraint one
   00581| /// sentence at a time because it is separating delivery from work; a route that
   00582| /// only has to *obey* the constraint needs nothing more than its text.
   00583| pub(super) fn pinned_first_line_of_request(request: &str) -> Option<String> {
   00584|     sentences(request)
   00585|         .into_iter()
   00586|         .find_map(|sentence| pinned_first_line(sentence.text))
   00587| }
   00588| /// The same content, rewritten to open with the line `request` pinned.
   00589| ///
   00590| /// A literal write is only literal when it satisfies every stated constraint on
   00591| /// the file it writes, and a request can state two: what the file contains, and
   00592| /// how it begins. "Write `notes/x.md` containing alpha, beta and gamma. The
   00593| /// first line must be exactly `id=7`" reads as a literal write to the broad
   00594| /// content parser -- *containing* cues content -- and the bytes it recovers are
   00595| /// the prose that followed the cue, which neither open with the pinned line nor
   00596| /// leave the pinning sentence out. Writing them satisfies the sentence that was
   00597| /// parsed and violates the one that was not.
   00598| ///
   00599| /// Both corrections come out of a parse that has already happened -- the pinned
   00600| /// line, and which sentence pinned it -- so the plan is repaired rather than
   00601| /// dropped. Dropping it was the earlier fix, and it moved the failure instead of
   00602| /// removing it: a request that states every byte it wants and no work to do has
   00603| /// no other route to reach, so declining sent the plainest write there is to the
   00604| /// open-web routers.
   00605| ///
   00606| /// The pinning sentence leaves the body with it. It was recovered only because
   00607| /// the content lead swept up the rest of the prose; the caller stated it as a
   00608| /// constraint on the file, never as something to put inside the file.
   00609| ///
   00610| /// Returns `None` when there is nothing to repair -- `request` pins no line, or
   00611| /// `content` already opens with it (issue #1066).
   00612| pub(super) fn honouring_pinned_first_line(request: &str, content: &str) -> Option<String> {
   00613|     let line = pinned_first_line_of_request(request)?;
   00614|     if content.starts_with(&line) {
   00615|         return None;
   00616|     }
   00617|     let body = without_pinning_sentences(content);
   00618|     Some(if body.is_empty() {
   00619|         format!("{line}\n")
   00620|     } else {
   00621|         format!("{line}\n\n{body}\n")
   00622|     })
   00623| }
   00624| 
   00625| /// `content` without any sentence that is itself a leading-line constraint.
   00626| fn without_pinning_sentences(content: &str) -> String {
   00627|     sentences(content)
   00628|         .into_iter()
   00629|         .filter(|sentence| pinned_first_line(sentence.text).is_none())
   00630|         .map(|sentence| content[sentence.span].trim())
   00631|         .filter(|kept| !kept.is_empty())
   00632|         .collect::<Vec<_>>()
   00633|         .join(" ")
   00634| }
   00635| /// The span of the first `file_write_action_cue` in the request.
   00636| fn first_action_cue(toks: &[Token<'_>]) -> Option<(usize, usize)> {
   00637|     let actions = bare_surfaces(seed::ROLE_FILE_WRITE_ACTION_CUE);
   00638|     toks.iter()
   00639|         .find_map(|token| leading_cue(token, &actions, false))
   00640| }
   00641| /// The byte offset just past the first `file_write_action_cue` token.
   00642| pub(super) fn first_action_cue_end(toks: &[Token<'_>]) -> Option<usize> {
   00643|     first_action_cue(toks).map(|(_, end)| end)
   00644| }
   00645| /// Where the first `file_write_action_cue` at or after `from` begins.
   00646| ///
   00647| /// A language that closes its clause with the verb states the action *after* the
   00648| /// destination it was given, so the payload is what stands between them. The
   00649| /// prepositional shape reads the same span from the other side — see
   00650| /// `parse_write_request`.
   00651| pub(super) fn action_cue_start_after(toks: &[Token<'_>], from: usize) -> Option<usize> {
   00652|     let actions = bare_surfaces(seed::ROLE_FILE_WRITE_ACTION_CUE);
   00653|     toks.iter()
   00654|         .filter(|token| token.start >= from)
   00655|         .find_map(|token| leading_cue(token, &actions, false))
   00656|         .map(|(start, _)| start)
   00657| }
   00658| /// The byte offset at which the first `file_write_action_cue` begins.
   00659| ///
   00660| /// [`first_action_cue_end`] answers where a payload may start; this answers
   00661| /// where the delivery clause does, and the two questions have different callers.
   00662| /// A sentence can carry both halves of a request -- "Break the customer import
   00663| /// rewrite into sub-tasks and record what you work out in `import-split.md`"
   00664| /// states the work and then, mid-sentence, says where its result goes -- so a
   00665| /// reader that hands the whole sentence to delivery throws the work away with
   00666| /// it (issue #1066).
   00667| pub(super) fn first_action_cue_start(toks: &[Token<'_>]) -> Option<usize> {
   00668|     first_action_cue(toks).map(|(start, _)| start)
   00669| }
   00670| /// Trim a recovered content span down to its literal payload, dropping the
   00671| /// leading clause separator ("… the following: hello") and any surrounding
   00672| /// quoting. A delimiter is removed only when the entire payload has a matching
   00673| /// opening and closing delimiter. This matters for generated source and Links
   00674| /// Notation: a lone terminal quote is data, not presentation punctuation.
   00675| /// Returns [`None`] when nothing is left.
   00676| pub(super) fn clean_content(raw: &str) -> Option<String> {
   00677|     let led = strip_clause_lead(raw);
   00678|     if led.len() >= 6 && led.starts_with("```") && led.ends_with("```") {
   00679|         let body = super::markdown_section::fenced_body(&led[3..led.len() - 3]);
   00680|         return (!body.is_empty()).then(|| body.to_owned());
   00681|     }
   00682|     // One quoted literal, in any pair of quotes (`'a'`, «a», “a”; PR #1188 G100),
   00683|     // is the content; the sentence's closing mark after it is the sentence's:
   00684|     // `containing 'hello'.` writes `hello`, not `'hello'.`.
   00685|     let closed = led
   00686|         .strip_suffix([
   00687|             '.', '!', '?', '\u{0964}', '\u{3002}', '\u{ff01}', '\u{ff1f}',
   00688|         ])
   00689|         .map_or(led, str::trim);
   00690|     if let [only] = crate::normal_markov::quoted_segment_spans(closed).as_slice()
   00691|         && only.start == 0
   00692|         && only.end == closed.len()
   00693|     {
   00694|         let text = &only.text;
   00695|         return (!text.is_empty()).then(|| text.to_owned());
   00696|     }
   00697|     let bytes = led.as_bytes();
   00698|     let quoted = led.len() >= 2
   00699|         && bytes[0] == bytes[led.len() - 1]
   00700|         && matches!(bytes[0], b'`' | b'"' | b'\'');
   00701|     let result = if quoted {
   00702|         led[1..led.len() - 1].trim()
   00703|     } else {
   00704|         led
   00705|     };
   00706|     (!result.is_empty()).then(|| result.to_owned())
   00707| }
   00708| /// Strip everything a recovered span carries *before* its literal payload: the
   00709| /// clause separators, and the seed-defined adverbs that qualify the requirement
   00710| /// rather than naming content.
   00711| ///
   00712| /// "…containing exactly: Hello World" delimits the content with `exactly:`, so
   00713| /// slicing after the content lead captured `exactly: Hello World` as the bytes
   00714| /// to write and as the evidence to verify against — the file would never have
   00715| /// matched (issue #905 §3).
   00716| fn strip_clause_lead(raw: &str) -> &str {
   00717|     let qualifiers = bare_surfaces(seed::ROLE_FILE_WRITE_CONTENT_QUALIFIER);
   00718|     let mut led = raw.trim();
   00719|     loop {
   00720|         let separated = led.trim_start_matches([':', '-', '—', '–']).trim();
   00721|         let shortened = strip_leading_qualifier(separated, &qualifiers);
   00722|         if shortened.len() == led.len() {
   00723|             return led;
   00724|         }
   00725|         led = shortened;
   00726|     }
   00727| }
   00728| /// Drop one leading qualifier, but only when a clause separator follows it. The
   00729| /// separator is what marks the adverb as introducing the payload rather than
   00730| /// opening it, so content that genuinely starts with "exactly what I asked for"
   00731| /// keeps its first word.
   00732| fn strip_leading_qualifier<'a>(text: &'a str, qualifiers: &[String]) -> &'a str {
   00733|     let lowered = text.to_lowercase();
   00734|     qualifiers
   00735|         .iter()
   00736|         .filter(|qualifier| lowered.starts_with(qualifier.as_str()))
   00737|         .filter_map(|qualifier| {
   00738|             let rest = text.get(qualifier.len()..)?.trim_start();
   00739|             rest.starts_with([':', '-', '—', '–']).then_some(rest)
   00740|         })
   00741|         .min_by_key(|rest| rest.len())
   00742|         .unwrap_or(text)
   00743| }
   00744| pub(super) fn safe_relative_path(path: &str) -> bool {
   00745|     !path.starts_with('/')
   00746|         && !path.starts_with('-')
   00747|         && !path.split('/').any(|part| part == ".." || part.is_empty())
   00748|         && path
   00749|             .chars()
   00750|             .all(|c| c.is_alphanumeric() || matches!(c, '/' | '.' | '_' | '-'))
   00751| }
   00752| 
   00753| /// Recover the `(target, old, new)` of a file-edit request from its wording.
   00754| ///
   00755| /// Every cue comes from the seed lexicon. A target may be a safe relative path
   00756| /// or an unambiguous self-AST census reference; ambiguous spans fail closed.
   00757| #[must_use]
   00758| pub fn compose_edit_request(request: &str) -> Option<(String, String, String)> {
   00759|     compose_edit_clauses(request).map(|clauses| clauses.edit)
   00760| }
   00761| 
   00762| /// The `(target, old, new)` of an edit request and the spans its clauses take.
   00763| pub(super) struct EditClauses {
   00764|     /// What [`compose_edit_request`] returns.
   00765|     pub(super) edit: (String, String, String),
   00766|     /// The file clause, then the action through the new text, in bytes.
   00767|     ///
   00768|     /// `None` for a positional insert or lines under the request.
   00769|     pub(super) spans: Option<[(usize, usize); 2]>,
   00770| }
   00771| 
   00772| /// [`compose_edit_request`] with the spans of its clauses.
   00773| ///
   00774| /// Mirrors `composeEditClauses`.
   00775| pub(super) fn compose_edit_clauses(raw: &str) -> Option<EditClauses> {
   00776|     // `everywhere`, `all occurrences`: no part of the old or new text (G84).
   00777|     let blanked = super::edit_scope::without_all_occurrence_cues(raw);
   00778|     let request = blanked.as_str();
   00779|     if let Some(edit) = super::positional_edit::compose_positional_insert(request) {
   00780|         return Some(EditClauses { edit, spans: None });
   00781|     }
   00782|     // `Replace the line 'x' with these three lines in f:` followed by lines: a
   00783|     // new clause that only describes lines (the seeded `line` meaning,
   00784|     // unquoted) stands for the lines under the request (PR #1188 G22).
   00785|     if let Some(block) = super::positional_edit::introduced_block(request)
   00786|         && let Some((target, old, new)) = compose_edit_request(block.head)
   00787|         && describes_lines(block.head, &new)
   00788|     {
   00789|         return Some(EditClauses {
   00790|             edit: (target, old, block.text),
   00791|             spans: None,
   00792|         });
   00793|     }
   00794|     let toks = tokens(request);
   00795|     let action_cues = bare_surfaces(seed::ROLE_FILE_EDIT_ACTION_CUE);
   00796|     let new_leads = bare_surfaces(seed::ROLE_FILE_EDIT_NEW_LEAD_CUE);
   00797|     let target_cues = bare_surfaces(seed::ROLE_FILE_EDIT_TARGET_CUE);
   00798|     let is_target_cue = |index: usize| target_cues.contains(&clean_cue_token(toks[index].text));
   00799|     let is_action_cue = |index: usize| action_cues.contains(&clean_cue_token(toks[index].text));
   00800|     let unquoted: Vec<usize> = super::positional_edit::unquoted_path_tokens(request)
   00801|         .iter()
   00802|         .map(|token| token.start)
   00803|         .collect();
   00804|     // A path the request leaves unquoted names the file before a literal that
   00805|     // is exactly a path does: in "Replace 'a' with 'data/x.lino' in f.mjs" the
   00806|     // quoted path is the new text, and the cue after it does not make it the
   00807|     // target.
   00808|     let segments = crate::normal_markov::quoted_segment_spans(request);
   00809|     let is_quoted = |token: &Token<'_>| {
   00810|         segments
   00811|             .iter()
   00812|             .any(|segment| token.start >= segment.start && token.end <= segment.end)
   00813|     };
   00814|     let is_path_candidate = |token: &Token<'_>| {
   00815|         let cleaned = clean_path_token(token.text);
   00816|         unquoted.contains(&token.start)
   00817|             && (super::general_planner::resolve_census_target(cleaned).is_some()
   00818|                 || (looks_like_file_path(cleaned) && safe_relative_path(cleaned)))
   00819|     };
   00820|     let candidate = |quoted_pass: bool| {
   00821|         toks.iter().enumerate().find_map(|(index, token)| {
   00822|             let cleaned = clean_path_token(token.text);
   00823|             if !unquoted.contains(&token.start) || is_quoted(token) != quoted_pass {
   00824|                 return None;
   00825|             }
   00826|             let resolved = super::general_planner::resolve_census_target(cleaned);
   00827|             if resolved.is_none()
   00828|                 && (!looks_like_file_path(cleaned) || !safe_relative_path(cleaned))
   00829|             {
   00830|                 return None;
   00831|             }
   00832|             let prev_is_cue = index
   00833|                 .checked_sub(1)
   00834|                 .is_some_and(|previous| is_target_cue(previous) || is_action_cue(previous));
   00835|             let next_is_cue =
   00836|                 (index + 1 < toks.len()) && (is_target_cue(index + 1) || is_action_cue(index + 1));
   00837|             // A cue between two paths introduces the later one: in "…`p.lino``
   00838|             // in req.md" the payload's last span is no target (PR #1188 G63).
   00839|             let cue_introduces_next =
   00840|                 !prev_is_cue && next_is_cue && toks.get(index + 2).is_some_and(is_path_candidate);
   00841|             let target = resolved.map_or_else(|| cleaned.to_owned(), |census| census.module_path);
   00842|             ((prev_is_cue || next_is_cue) && !cue_introduces_next).then_some((index, target))
   00843|         })
   00844|     };
   00845|     let (file_index, target) = candidate(false).or_else(|| candidate(true))?;
   00846|     // The file clause runs back over target cues and the seeded function words
   00847|     // between them (`in the file f.txt`) to its first cue (PR #1188 G98); a cue
   00848|     // word inside a quoted literal is payload ("… the named file.'").
   00849|     let function_words = bare_surfaces(FUNCTION_WORD_ROLE);
   00850|     let joins_clause = |index: usize| {
   00851|         !is_quoted(&toks[index])
   00852|             && (is_target_cue(index) || function_words.contains(&clean_cue_token(toks[index].text)))
   00853|     };
   00854|     let mut clause_start_index = file_index;
   00855|     for index in (0..file_index)
   00856|         .rev()
   00857|         .take_while(|&index| joins_clause(index))
   00858|     {
   00859|         if is_target_cue(index) {
   00860|             clause_start_index = index;
   00861|         }
   00862|     }
   00863|     let file_clause_start = toks[clause_start_index].start;
   00864|     // A cue word quoted whole is payload too: `replace 'with' with ','`.
   00865|     let is_cue = |token: &Token<'_>, cues: &[String]| {
   00866|         unquoted.contains(&token.start)
   00867|             && !is_quoted(token)
   00868|             && cues.contains(&clean_cue_token(token.text))
   00869|     };
   00870|     let action = toks
   00871|         .iter()
   00872|         .filter(|token| is_cue(token, &action_cues))
   00873|         .find(|token| token.start > toks[file_index].end)
   00874|         .or_else(|| toks.iter().find(|token| is_cue(token, &action_cues)))?;
   00875|     let action_end = action.end;
   00876|     let new_lead = toks
   00877|         .iter()
