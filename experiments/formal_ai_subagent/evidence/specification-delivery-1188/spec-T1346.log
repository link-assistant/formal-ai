   00064| pub(super) fn bare_surfaces(role: &str) -> Vec<String> {
   00065|     seed::lexicon()
   00066|         .role_word_forms(role)
   00067|         .iter()
   00068|         .filter(|form| form.slot() == Slot::Bare)
   00069|         .map(|form| form.text.to_lowercase())
   00070|         .collect()
   00071| }
   00072| /// Trim the quoting/edge punctuation from a token that may be a file path,
   00073| /// preserving the interior dots that make it look like a file. Trailing sentence
   00074| /// punctuation is stripped too, so a plain word that merely *ends a sentence*
   00075| /// ("… add the plural to томат.") is not mistaken for a file whose only dot is the
   00076| /// terminal period — a real filename never ends in a bare `.`/`!`/`?`.
   00077| pub(super) fn clean_path_token(word: &str) -> &str {
   00078|     peel_sentence_punctuation(word, |token| {
   00079|         token
   00080|             .trim_matches(|c: char| matches!(c, '`' | '"' | '\'' | ',' | ':' | ';'))
   00081|             .trim_end_matches(['!', '?'])
   00082|     })
   00083| }
   00084| /// Whether a safe-looking token names a file rather than merely using the
   00085| /// conventional `./` prefix for a directory.
   00086| ///
   00087| /// Checking the whole token for a dot made policy prose such as "keep examples
   00088| /// in ./examples" file-shaped. When a later sentence contained a write-content
   00089| /// marker, the generic planner consequently tried to overwrite that directory.
   00090| /// File shape belongs to the final path component; dots in parent components or
   00091| /// in the relative-path prefix do not make the target a file. A component that
   00092| /// is nothing but dots (`.`, `..`) names a directory, never a file: the full
   00093| /// stop after a closing quote (`… with ''.`) is not a file to read (issue #715).
   00094| pub(super) fn looks_like_file_path(path: &str) -> bool {
   00095|     !path.contains("://")
   00096|         && !is_dotted_number(path)
   00097|         && path.rsplit('/').next().is_some_and(|file_name| {
   00098|             file_name.contains('.') && file_name.chars().any(|character| character != '.')
   00099|         })
   00100| }
   00101| /// Lowercase a token stripped of edge punctuation, for cue/action comparison.
   00102| ///
   00103| /// The Devanagari full stop `।` ends a Hindi sentence exactly as `.` ends an
   00104| /// English one, so a cue that closes a clause — `लिखो।` — is the same cue as
   00105| /// `लिखो`. Without it the verb of every sentence-final Hindi request went
   00106| /// unrecognised.
   00107| pub(super) fn clean_cue_token(word: &str) -> String {
   00108|     word.trim_matches(|c: char| {
   00109|         matches!(
   00110|             c,
   00111|             '`' | '"' | '\'' | ',' | ':' | ';' | '.' | '!' | '?' | '\u{0964}' | '\u{0965}'
   00112|         )
   00113|     })
   00114|     .to_lowercase()
   00115| }
