   00046| /// The branch named right after a branch cue: "on branch issue-1-abc",
   00047| /// "в ветке issue-1-abc", "分支 issue-1-abc".
   00048| pub(super) fn named_branch(request: &str) -> Option<String> {
   00049|     let cues = bare_surfaces(seed::ROLE_GIT_BRANCH_CUE);
   00050|     let toks = tokens(request);
   00051|     toks.windows(2).find_map(|pair| {
   00052|         let word = clean_cue_token(pair[0].text);
   00053|         let is_cue = cues
   00054|             .iter()
   00055|             .any(|cue| *cue == word || (!cue.is_ascii() && word.ends_with(cue.as_str())));
   00056|         if !is_cue {
   00057|             return None;
   00058|         }
