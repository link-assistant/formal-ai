   00159|   if (!impulse) return null;
   00160|   const log = new EventLog();
   00161|   for (const event of events) log.append(String(event.kind), String(event.payload ?? ''));
   00162|   const response = log.lastOf(RESPONSE_KIND);
   00163|   const responseLink = response ? response.payload : `${RESPONSE_KIND}:${String(intent ?? 'unknown')}`;
