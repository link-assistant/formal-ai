      "result": "<file>\n00001| //! Deliver only conclusive observed findings to an explicitly bound evidence file.\n00002| //!\n00003| //! Recursive investigation retains typed provenance; authoring operands are not\n00004| //! evidence destinations, and clarifications, gaps and failures remain chat answers.\n00005| \n00006| use std::cell::RefCell;\n00007| use std::collections::HashMap;\n00008| \n00009| use super::capability_router::tool_for;\n00010| use super::final_result::{FinalDisposition, FinalPayloadRole, FinalResult, record};\n00011| use super::general_planner::compose_general_change_plan;\n00012| use super::planner::{\n00013|     AgenticPlan, Capability, plan_chat_step_resolved, plan_one, plan_settled_routes, trace_route,\n00014|     write_arguments,\n00015| };\n00016| use super::progress::Progress;\n00017| use super::shell_command::carries_authoring_task;\n00018| use super::shell_command_policy::sentences;\n00019| use super::write_request::{\n00020|     bare_surfaces, delivered_write_target, first_action_cue_start, pinned_first_line, tokens,\n00021| };\n00022| use crate::obligation_ledger::ObligationOutcome;\n00023| use crate::protocol::{ChatMessage, MessageContent, ToolCall};\n00024| \n00025| /// The delivery half of a request, separated from the work it asks for.\n00026| struct DeliveryBinding {\n00027|     /// The path the answer has to be written to.\n00028|     target: String,\n00029|     /// The exact opening line the caller pinned, when it pinned one.\n00030|     first_line: Option<String>,\n00031|     /// Exact `key=value` lines declared in the delivery sentence.\n00032|     field_lines: Vec<String>,\n00033|     /// Everything the request says that is not about delivery.\n00034|     residual: String,\n00035| }\n00036| \n00037| /// `text` with every quoted segment that holds whitespace replaced, delimiters\n00038| /// included, by as many `x` as it has bytes, so spans still index the\n00039| /// original.\n00040| ///\n00041| /// A single-token quote