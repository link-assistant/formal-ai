 to tell a command that is named from one that\n00080| /// is ordered (issue #907).\n00081| ///\n00082| /// A sentence that asks for an artifact to be authored is never the delivery\n00083| /// half, however write-shaped it looks. \"Today's date is Sunday. Create a file\n00084| /// `main.py` that prints Hello, world!\" applies a write action to a cued path,\n00085| /// and reading it as delivery inverts the request: the caller's work becomes the\n00086| /// destination and their passing statement becomes the investigation, so the\n00087| /// Python file was written with prose about the date. The authoring test is\n00088| /// [`super::shell_command::carries_authoring_task`], the one requirement 3 of\n00089| /// issue #907 already states in exactly these terms.\n00090| ///\n00091| /// Declines when the residual is empty: a request whose every sentence is about\n00092| /// delivery states no work to do, so there is nothing to record.\n00093| /// A call-shaped authoring request binds its path as a code operand.\n00094| fn names_callable_artifact(sentence: &str, target: &str) -> bool {\n00095|     let normalized = crate::engine::normalize_prompt(sentence);\n00096|     let lexicon = crate::seed::lexicon();\n00097|     let operand = normalized.split_whitespace().find(|word| {\n00098|         lexicon.mentions_role(\"coding-source-artifact-kind\", word)\n00099|             || lexicon.mentions_role(\"evidence-report-artifact-kind\", word)\n00100|     });\n00101|     if operand.is_some_and(|word| lexicon.mentions_role(\"coding-source-artifact-kind\", word))\n00102|         && (lexicon.mentions_role(\"coding_request_verb\", &normalized)\n00103|             || lexicon.mentions_role(\"coding_member_add_action\", &normalized))\n00104|     {\n00105|         return true;\n00106|     }\n00107|     let Some(call) = super::module_function::signature(sentence) else {\n00108|         return false;\n00109|     };\n00110|     if !super::module_function::paths_in(&sentence[call.at..])\n00111|         .iter()\n00112|         .any(|path| path == target)\n00113|     {\n00114|         return false;\n00115|     }\n00116|     let prefix = crate::engine::normalize_prompt(&sentence[..call.at]);\n00117|     let lexicon = crate::seed::lexicon();\n00118|     lexicon.mentions_role(\"coding_request_verb\", &prefix)\n00119|         || lexicon.mentions_role(\"coding_member_add_action\", &prefix)\n00120| }\n00121| \n00122| fn parse_obligation(request: &str) -> Option<DeliveryBinding> {\n00123|     let mut target = None;\n00124|     let mut first_line = None;\n00125|     let mut field_lines = Vec::new();\n00126|     let mut residual = String::new();\n00127|     let mut later_obligation = false;\n00128|     // Sentences and delivery cues are read with every multi-word quoted\n00129|     // payload masked: `Append \"/// Append an empty line to notes.txt.\" to\n00130|     // src/lib.rs.` is one sentence about src/lib.rs, not a delivery to the\n00131|     // notes.txt its payload mentions (PR #1188 sub-agent gap 2). The pinned\n00132|     // line, field lines and the work before the delivery are read from the\n00133|     // request itself, where the quoted text is intact.\n00134|     let masked = masked_multi_word_quotes(request);\n00135|     for sentence in sentences(&masked) {\n00136|         let start = masked[sentence.span.clone()]\n00137|             .find(sentence.text)\n00138|             .map_or(sentence.span.start, |at| sentence.span.start + at);\n00139|         let text = request\n00140|             .get(start..start + sentence.text.len())\n00141|             .unwrap_or(sentence.text);\n00142|         if let Some(line) = pinned_first_line(text) {\n00143|             if target.is_some() && !later_obligation {\n00144|                 first_line = first_line.or(Some(line));\n00145|                 continue;\n00146|             }\n00147|             residual.push_str(&request[sentence.span]);\n00148|             continue;\n00149|         }\n00150|         // A sentence states the work rather than a place to put it when it\n00151|         // asks for an artifact to be authored, or when the path it names is\n00152|         // where the work happens rather than where an answer goes. Both make\n00153|         // that path an operand, and reading either as a delivery is\n00154|         // destructive: the ladder's leaf says \"Edit the tracked file\n00155|         // `src/engine_responses.rs`: add \\\"Good morning\\\" to the\n00156|         // GREETING_EXAMPLES list\", so delivery wrote its own status line over\n00157|         // the source, the write returned success, and the node reported done\n00158|         // having deleted the file it was asked to edit.\n00159|         let delivered = (!carries_authoring_task(&crate::engine::normalize_prompt(sentence.text)))\n00160|             .then(|| delivered_write_target(sentence.text))\n00161|             .flatten()\n00162|             .filter(|target| {\n00163|                 !names_callable_artifact(text, target)\n00164|                     && super::function_expectation::test_expectation_question(text, &mut None)\n00165|                         .is_none()\n00166|             });\n00167|         if let Some(named) = delivered {\n00168|             if target.is_none() {\n00169|                 field_lines = exact_field_lines(text, &named);\n00170|                 target = Some(named);\n00171|                 if let Some(work) = work_before_delivery(text) {\n00172|                     residual.push_str(work);\n00173|                     residual.push_str(\". \");\n00174|                 }\n00175|                 continue;\n00176|             }\n00177|             // A constraint in the next sentence belongs to this later output,\n00178|             // not to the first output selected by this recursive pass. Leave\n00179|             // both sentences in the residual so the nested pass sees them\n00180|             // together and can bind them correctly.\n00181|             later_obligation = true;\n00182|         }\n00183|         residual.push_str(&request[sentence.span]);\n00184|     }\n00185|     let residual = residual.trim().to_owned();\n00186|     (!residual.is_empty())\n00187|         .then_some(())\n00188|         .and(target)\n00189|         .map(|target| DeliveryBinding {\n00190|             target,\n00191|             first_line,\n00192|             field_lines,\n00193|             residual,\n00194|         })\n00195| }\n00196| \n00197| /// Literal `key=value` field constraints carried by one delivery sentence.\n00198| fn exact_field_lines(sentence: &str, target: &str) -> Vec<String> {\n00199|     let fields = sentence\n00200|         .split('`')\n00201|         .enumerate()\n00202|         .filter(|(index, _)| index % 2 == 1)\n00203|         .map(|(_, quoted)| quoted.trim())\n00204|         .filter(|quoted| *quoted != target)\n00205|         .filter(|quoted| !quoted.chars().any(char::is_whitespace))\n00206|         .filter(|quoted| {\n00207|             quoted.split_once('=').is_some_and(|(key, _)| {\n00208|                 key.chars()\n00209|                     .next()\n00210|                     .is_some_and(|character| character.is_ascii_alphabetic())\n00211|                     && key\n00212|                         .chars()\n00213|                         .all(|character| character.is_ascii_alphanumeric() || character == '_')\n00214|             })\n00215|         })\n00216|         .map(str::to_owned)\n00217|         .collect::<Vec<_>>();\n00218| \n00219|     // A field may be quoted once as a source reference and again as the output\n00220|     // field the caller declares: \"`left_result=` followed by the child's\n00221|     // `result=` value, and `result=` followed by the composition\". The final\n00222|     // occurrence is the declaration's position in the output list. Keep that\n00223|     // occurrence only, so the source reference cannot create an extra field or\n00224|     // move the aggregate ahead of later child fields.\n00225|     fields\n00226|         .iter()\n00227|         .enumerate()\n00228|         .filter(|(index, field)| !fields[index + 1..].contains(field))\n00229|         .map(|(_, field)| field.clone())\n00230|         .collect()\n00231| }\n00232| \n00233| /// The part of a delivery sentence that is not about delivery.\n00234| ///\n00235| /// Two sentences are the tidy way to ask for work and its delivery, and the\n00236| /// ladder's own nodes are written that way. English does not require it: \"Break\n00237| /// the customer import rewrite into sub-tasks and record what you work out in\n00238| /// `import-split.md`\" coordinates both halves into one sentence, and the\n00239| /// delivery half starts at the write action cue. Reading the sentence as\n00240| /// delivery and stopping there drops the work along with it, the residual comes\n00241| /// out empty, and the request is answered in the transcript with nothing\n00242| /// written -- which is the same silence issue #1066 is about, arrived at from\n00243| /// the other side.\n00244| ///\n00245| /// Returns [`None`] when the sentence opens with its cue, which is the shape\n00246| /// where there is genuinely no work in front of the delivery.\n00247| fn work_before_delivery(sentence: &str) -> Option<&str> {\n00248|     let start = first_action_cue_start(&tokens(sentence))?;\n00249|     let work = without_trailing_separator(sentence.get(..start)?.trim());\n00250|     work.chars().any(char::is_alphanumeric).then_some(work)\n00251| }\n00252| \n00253| /// `work` with the connective that introduced the delivery clause removed.\n00254| ///\n00255| /// The connective belongs to the clause it opens, so it is delivery's, not the\n00256| /// work's. Which words those are is not a fact about writing files: it is the\n00257| /// vocabulary that ends one clause and starts the next, which the seed already\n00258| /// spells out in every registered language under\n00259| /// [`crate::seed::ROLE_SKILL_PROCEDURE_CLAUSE_SEPARATOR`].\n00260| ///\n00261| /// The separator has to be a whole word. \"Run the import command record it in\n00262| /// `x.md`\" ends its work on *command*, and a match on the last three letters\n00263| /// would hand back \"Run the import comm\".\n00264| fn without_trailing_separator(work: &str) -> &str {\n00265|     let lowered = work.to_lowercase();\n00266|     bare_surfaces(crate::seed::ROLE_SKILL_PROCEDURE_CLAUSE_SEPARATOR)\n00267|         .iter()\n00268|         .filter(|separator| lowered.ends_with(separator.as_str()))\n00269|         .filter_map(|separator| work.get(..work.len() - separator.len()))\n00270|         .filter(|kept| kept.ends_with(char::is_whitespace))\n00271|         .map(str::trim_end)\n00272|         .min_by_key(|kept| kept.len())\n00273|         .unwrap_or(work)\n00274| }\n00275| \n00276| /// Plan the next step of a \"find this out and record it at PATH\" request.\n00277| ///\n00278| /// Three states, in the order they occur:\n00279| ///\n00280| /// * the write has already been attempted — report what happened, truthfully;\n00281| /// * the router still wants tool calls for the residual — pass them through, so\n00282| ///   the investigation runs under the ordinary routes;\n00283| /// * the router has an answer — write it to the named path, under the pinned\n00284| ///   first line when the caller pinned one.\n00285| pub(super) fn plan_evidence_record_step(\n00286|     task: &str,\n00287|     messages: &[ChatMessage],\n00288|     tool_names: &[&str],\n00289|     result: &mut Option<FinalResult>,\n00290| ) -> Option<AgenticPlan> {\n00291|     let obligation = parse_obligation(task)?;\n00292|     // A later producer of the same target owns its bytes.\n00293|     if let Some(reason) = later_route_delivering(task, &obligation, tool_names) {\n00294|         trace_route(\"evidence_record\", reason);\n00295|         return None;\n00296|     }\n00297|     let write_tool = tool_for(tool_names, Capability::Write)?;\n00298|     let progress = Progress::scan(messages);\n00299|     match super::task_obligations::observed_file_outcome(task, &obligation.target, messages) {\n00300|         ObligationOutcome::Satisfied { .. } => {\n00301|             trace_route(\"evidence_record\", \"already_written\");\n00302|             return Some(record(\n00303|                 AgenticPlan::Final(\n00304|                     progress\n00305|                         .successful_write_content_for(&obligation.target)\n00306|                         .map(|content| written_observation(&obligation, &content))\n00307|                         .filter(|answer| !answer.is_empty())\n00308|                         .unwrap_or_else(|| {\n00309|                             format!(\"Recorded the findings in `{}`.\", obligation.target)\n00310|                         }),\n00311|                 ),\n00312|                 FinalDisposition::Finding,\n00313|                 \"evidence_record_observed\",\n00314|                 result,\n00315|             ));\n00316|         }\n00317|         ObligationOutcome::Refuted { .. } | ObligationOutcome::Unsatisfiable { .. } => {\n00318|             trace_route(\"evidence_record\", \"write_not_observed\");\n00319|             return Some(record(\n00320|                 AgenticPlan::Final(format!(\n00321|                     \"The findings could not be recorded in `{}`: the write step failed.\",\n00322|                     obligation.target\n00323|                 )),\n00324|                 FinalDisposition::Failure,\n00325|                 \"evidence_record_write_failed\",\n00326|                 result,\n00327|             ));\n00328|         }\n00329|         ObligationOutcome::Unattempted => {}\n00330|     }\n00331|     // A successful checkout inspection is already the grounded answer this\n00332|     // delivery exists to persist. Optional research prose elsewhere in a\n00333|     // harness must not reopen the question on the web before the result is\n00334|     // written. Preserve recursive delivery ordering, though: when the residual\n00335|     // names another output, let that inner obligation consume the observation\n00336|     // first so one result still reaches every requested artifact.\n00337|     let observed = parse_obligation(&obligation.residual)\n00338|         .is_none()\n00339|         .then(|| {\n00340|             super::workspace_inspection::workspace_inspection_search_for_task(&obligation.residual)\n00341|         })\n00342|         .flatten()\n00343|         .and_then(|_| progress.latest_successful_output(Capability::Grep))\n00344|         .filter(|answer| !substantive_result_line(answer, &obligation.residual).is_empty())\n00345|         .map(str::to_owned);\n00346|     let residual_messages = with_residual_request(messages, &obligation.residual)?;\n00347|     let is_workspace_observation = observed.is_some();\n00348|     let answer = match observed {\n00349|         Some(answer) => answer,\n00350|         None => {\n00351|             if let Some(resolved) = plan_chat_step_resolved(&residual_messages, tool_names) {\n00352|                 if !resolved.can_deliver() {\n00353|                     trace_route(\"evidence_record\", \"residual_not_finding\");\n00354|                     return Some(resolved.into_plan(result));\n00355|                 }\n00356|                 let AgenticPlan::Final(answer) = resolved.plan else {\n00357|                     unreachable!()\n00358|                 };\n00359|                 if progress.latest_failure().is_some() {\n00360|                     return Some(record(\n00361|                         AgenticPlan::Final(answer),\n00362|                         FinalDisposition::Failure,\n00363|                         \"evidence_record_residual_failed\",\n00364|                         result,\n00365|                     ));\n00366|                 }\n00367|                 answer\n00368|             } else {\n00369|                 trace_route(\"evidence_record\", \"symbolic_residual\");\n00370|                 symbolic_answer(&obligation.residual)?.text\n00371|             }\n00372|         }\n00373|     };\n00374|     trace_route(\"evidence_record\", &obligation.target);\n00375|     let delivered_answer = if is_workspace_observation {\n00376|         substantive_result_line(&answer, &obligation.residual)\n00377|     } else {\n00378|         &answer\n00379|     };\n00380|     let content = render_obligation(&obligation, delivered_answer);\n00381|     Some(plan_one(\n00382|         write_tool,\n00383|         write_arguments(&obligation.target, &content),\n00384|     ))\n00385| }\n00386| \n00387| /// How far the probe below follows a route before concluding it delivers\n00388| /// nothing.\n00389| ///\n00390| /// A route reaches the file the caller named early or not at all: the recipes\n00391| /// write their artifact first, and the literal-file composer records its plan\n00392| /// and then writes it. The bound is what keeps a routing question from costing\n00393| /// a whole run.\n00394| const DELIVERY_PROBE_TURNS: usize = 4;\n00395| \n00396| /// How a route below this one already produces `target` from the whole request,\n00397| /// or `None` when none of them does.\n00398| ///\n00399| /// A composed change plan states the file it was compiled for, so asking it is\n00400| /// exact and costs nothing -- and it is the only one of the two that sees a file\n00401| /// a shell *redirect* produces, since \"Run 'printf learned-output' and write its\n00402| /// exact stdout to reports/learned.txt\" is delivered by `>` and never by a write\n00403| /// call at all.\n00404| ///\n00405| /// Everything else is asked by running it rather than by listing it: plan the\n00406| /// request through the routes below, answer each planned call with a bare\n00407| /// success, and see whether `target` is among the files they write. That is what\n00408| /// reaches the recipes, which declare nothing and are recognised from the\n00409| /// artifact they write. A route's own state machine is what decides --\n00410| /// `plan_general_change_step` records its plan before writing the file the\n00411| /// caller named, so a first step alone would report that nobody owns\n00412| /// `policy/retention.md`, and a table of routes that \"own an artifact\" would\n00413| /// have to carry that knowledge secondhand and go stale.\n00414| ///\n00415| /// The probe starts from a conversation holding the request and nothing else, so\n00416| /// the answer depends on the request alone and does not drift as the real run\n00417| /// accumulates results: a recipe that owns a destination owns it on every turn,\n00418| /// and its mid-run plan to read the file back would otherwise look like nobody\n00419| /// owning it.\n00420| fn later_route_delivering(\n00421|     task: &str,\n00422|     obligation: &DeliveryBinding,\n00423|     tool_names: &[&str],\n00424| ) -> Option<&'static str> {\n00425|     // A schema or opening-line declaration constrains bytes that still have to\n00426|     // be derived from the residual investigation; it is not itself the file's\n00427|     // payload. The broad literal parser can nevertheless recover the words\n00428|     // after \"with\"/\"exactly\" as content. Do not let that lossy interpretation\n00429|     // displace the evidence transaction. A true literal write has no residual\n00430|     // finding to derive, so it never reaches this function.\n00431|     let derived_delivery = obligation.first_line.is_some() || !obligation.field_lines.is_empty();\n00432|     if derived_delivery {\n00433|         return None;\n00434|     }\n00435|     if let Some(plan) = compose_general_change_plan(task)\n00436|         && plan.target == obligation.target\n00437|     {\n00438|         return Some(\"declined_composed_target\");\n00439|     }\n00440|     settled_route_delivers(task, &obligation.target, tool_names).then_some(\"declined_settled_route\")\n00441| }\n00442| \n00443| /// Whether planning the whole request through the routes below this one walks\n00444| /// into a call that writes `target`.\n00445| fn settled_route_delivers(task: &str, target: &str, tool_names: &[&str]) -> bool {\n00446|     let key = (\n00447|         task.to_owned(),\n00448|         target.to_owned(),\n00449|         tool_names.join(\"\\u{1f}\"),\n00450|     );\n00451|     if let Some(known) = DELIVERY_PROBE_ANSWERS.with_borrow(|answers| answers.get(&key).copied()) {\n00452|         return known;\n00453|     }\n00454|     let answer = probe_settled_routes(task, target, tool_names);\n00455|     DELIVERY_PROBE_ANSWERS.with_borrow_mut(|answers| {\n00456|         // The router is consulted once per turn with the same request, and a\n00457|         // long-lived server sees many requests. Recomputing per turn made the\n00458|         // issue #1028 ladder suite ten times slower; keeping every answer it\n00459|         // ever gave would trade that for unbounded memory. Start over instead --\n00460|         // the answers are derived, so losing them costs one recomputation.\n00461|         if answers.len() >= DELIVERY_PROBE_MEMO_CAPACITY {\n00462|             answers.clear();\n00463|         }\n00464|         answers.insert(key, answer);\n00465|     });\n00466|     answer\n00467| }\n00468| \n00469| thread_local! {\n00470|     /// Probe answers already computed on this thread, keyed by the inputs they\n00471|     /// were computed from.\n00472|     static DELIVERY_PROBE_ANSWERS: RefCell<HashMap<(String, String, String), bool>> =\n00473|         RefCell::new(HashMap::new());\n00474| }\n00475| \n00476| /// How many probe answers one thread remembers before starting over.\n00477| const DELIVERY_PROBE_MEMO_CAPACITY: usize = 512;\n00478| \n00479| fn probe_settled_routes(task: &str, target: &str, tool_names: &[&str]) -> bool {\n00480|     let mut probe = vec![ChatMessage::user(task)];\n00481|     for turn in 0..DELIVERY_PROBE_TURNS {\n00482|         let Some(AgenticPlan::ToolCalls(calls)) =\n00483|             plan_settled_routes(task, &probe, tool_names, &mut None)\n00484|         else {\n00485|             return false;\n00486|         };\n00487|         for (index, call) in calls.iter().enumerate() {\n00488|             if planned_destination(&call.arguments).is_some_and(|path| path == target) {\n00489|                 return true;\n00490|             }\n00491|             let id = format!(\"delivery-probe-{turn}-{index}\");\n00492|             probe.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(\n00493|                 &id,\n00494|                 &call.tool,\n00495|                 call.arguments.clone(),\n00496|             )]));\n00497|             probe.push(ChatMessage::tool_result(id, &call.tool, \"ok\"));\n00498|         }\n00499|     }\n00500|     false\n00501| }\n00502| \n00503| /// The file a planned call names as its destination, whether the call writes\n00504| /// those bytes itself or runs a command that writes them.\n00505| fn planned_destination(arguments: &str) -> Option<String> {\n00506|     planned_write_path(arguments).or_else(|| planned_command_output_path(arguments))\n00507| }\n00508| \n00509| /// The destination a planned command names for its own output.\n00510| ///\n00511| /// A command carries its destination in the option that names it, exactly as a\n00512| /// write call carries it in `path`, and `formal-ai statement-audit --root .\n00513| /// --output statement-audit.lino` produces that file as surely as a write would.\n00514| /// A delivery that cannot see it peels \"and write statement-audit.lino\" off the\n00515| /// request and records its own status line over the report the command had just\n00516| /// written -- which is what issue #1069's agent-CLI audit run did, on the turn\n00517| /// after the audit succeeded.\n00518| fn planned_command_output_path(arguments: &str) -> Option<String> {\n00519|     let command = super::tool_result::command_argument(arguments)?;\n00520|     let parts = command.split_whitespace().collect::<Vec<_>>();\n00521|     let index = parts.iter().position(|part| *part == OUTPUT_OPTION)?;\n00522|     parts.get(index + 1).map(|path| (*path).to_owned())\n00523| }\n00524| \n00525| /// The option a command names its output destination with.\n00526| const OUTPUT_OPTION: &str = \"--output\";\n00527| \n00528| /// The file a planned call writes, under whichever key its client expects.\n00529| fn planned_write_path(arguments: &str) -> Option<String> {\n00530|     let value = serde_json::from_str::<serde_json::Value>(arguments).ok()?;\n00531|     [\"path\", \"filePath\", \"file_path\", \"absolute_path\"]\n00532|         .iter()\n00533|         .find_map(|key| {\n00534|             value\n00535|                 .get(*key)\n00536|                 .and_then(serde_json::Value::as_str)\n00537|                 .map(str::to_owned)\n00538|         })\n00539| }\n00540| \n00541| /// Render an answer under the constraints attached to its destination.\n00542| fn render_obligation(obligation: &DeliveryBinding, answer: &str) -> String {\n00543|     if !obligation.field_lines.is_empty() {\n00544|         let result = substantive_result_line(answer, &obligation.residual);\n00545|         let observed_results = exact_field_values(answer, \"result\");\n00546|         let mut next_observed = observed_results.iter();\n00547|         let mut rendered = String::new();\n00548|         for field in &obligation.field_lines {\n00549|             rendered.push_str(field);\n00550|             if field.ends_with('=') {\n00551|                 if field == \"result=\" {\n00552|                     let combined = combined_observation(&observed_results, &obligation.residual)\n00553|                         .unwrap_or_else(|| result.to_owned());\n00554|                     rendered.push_str(&non_hollow_result(&combined, &obligation.residual));\n00555|                 } else {\n00556|                     rendered.push_str(next_observed.next().map_or(result, String::as_str));\n00557|                 }\n00558|             }\n00559|             rendered.push('\\n');\n00560|         }\n00561|         return rendered;\n00562|     }\n00563|     let answer = non_hollow_result(answer, &obligation.residual);\n00564|     obligation.first_line.as_ref().map_or_else(\n00565|         || format!(\"{}\\n\", answer.trim_end()),\n00566|         |line| format!(\"{line}\\n\\n{}\\n\", answer.trim_end()),\n00567|     )\n00568| }\n00569| \n00570| /// Values carried on exact machine-readable lines in an observation.\n00571| ///\n00572| /// Multi-file reads deliberately render one bare `key=value` line per input so\n00573| /// a later delivery can preserve those bytes. Display headings and prose are\n00574| /// ignored; only a line whose prefix is exact participates.\n00575| fn exact_field_values(answer: &str, key: &str) -> Vec<String> {\n00576|     let prefix = format!(\"{key}=\");\n00577|     answer\n00578|         .lines()\n00579|         .map(str::trim)\n00580|         .filter_map(|line| line.strip_prefix(&prefix))\n00581|         .map(str::to_owned)\n00582|         .collect()\n00583| }\n00584| \n00585| /// State how multiple exact observations compose while retaining each value.\n00586| fn combined_observation(values: &[String], request: &str) -> Option<String> {\n00587|     match values {\n00588|         [] => None,\n00589|         [only] => Some(only.clone()),\n00590|         many => {\n00591|             let values = many.join(\"; \");\n00592|             let language = crate::language::detect(request);\n00593|             crate::seed::render_response(\n00594|                 \"evidence_exact_composition\",\n00595|                 language.slug(),\n00596|                 &[(\"values\", &values)],\n00597|             )\n00598|             .or(Some(values))\n00599|         }\n00600|     }\n00601| }\n00602| \n00603| /// Keep a terse but decisive source token machine-checkable as a concrete result.\n00604| ///\n00605| /// Structured result consumers reasonably distinguish an observation from a\n00606| /// placeholder by requiring a short natural-language statement. A source line\n00607| /// can still answer the question completely with only a path and one sentinel,\n00608| /// so retain it verbatim and add context instead of discarding or paraphrasing\n00609| /// the evidence.\n00610| fn non_hollow_result(result: &str, task: &str) -> String {\n00611|     let result = result.trim_end();\n00612|     let language = crate::language::detect(task).slug();\n00613|     let intent = if result.ends_with(':') || result.ends_with('：') {\n00614|         \"coding_repository_source_observation\"\n00615|     } else if result.split_whitespace().count() >= 4 {\n00616|         return result.to_owned();\n00617|     } else {\n00618|         \"coding_repository_result_observation\"\n00619|     };\n00620|     crate::seed::render_response(intent, language, &[(\"result\", result)])\n00621|         .unwrap_or_else(|| result.to_owned())\n00622| }\n00623| \n00624| /// The observation carried by a successfully written evidence artifact.\n00625| ///\n00626| /// Remove only the destination's machine header. The remaining bytes are the\n00627| /// grounded answer the nested delivery wrote and can feed another artifact.\n00628| fn written_observation(obligation: &DeliveryBinding, content: &str) -> String {\n00629|     let mut lines = content.lines();\n00630|     if obligation.first_line.as_deref().is_some_and(|first_line| {\n00631|         lines\n00632|             .clone()\n00633|             .next()\n00634|             .is_some_and(|line| line.trim() == first_line)\n00635|     }) {\n00636|         lines.next();\n00637|     }\n00638|     lines.collect::<Vec<_>>().join(\"\\n\").trim().to_owned()\n00639| }\n00640| \n00641| /// The concrete line of an answer that best addresses the requested fact.\n00642| ///\n00643| /// Grouped grep output is transport-ordered, not relevance-ordered. Release\n00644| /// notes can therefore precede the source declaration a workspace question\n00645| /// asked for. Rank otherwise substantive lines by overlap with the request's\n00646| /// seed-derived fact terms. The final fact term is the requested property, and\n00647| /// a declaration answers a storage/representation question more directly than\n00648| /// a later method that happens to use that property.\n00649| fn substantive_result_line<'a>(answer: &'a str, task: &str) -> &'a str {\n00650|     let mut current_source_authority = 0;\n00651|     let mut candidates = Vec::new();\n00652|     for raw_line in answer.lines() {\n00653|         let line = raw_line.trim();\n00654|         if looks_like_result_path_heading(line) {\n00655|             current_source_authority = source_authority(line);\n00656|             continue;\n00657|         }\n00658|         if !line.is_empty()\n00659|             && line != \"```text\"\n00660|             && line != \"```\"\n00661|             && !line.ends_with(\"command completed. Output:\")\n00662|             && !is_match_count(line)\n00663|         {\n00664|             candidates.push((line, current_source_authority.max(source_authority(line))));\n00665|         }\n00666|     }\n00667|     let terms = super::workspace_inspection::workspace_inspection_terms_for_task(task);\n00668|     let lexicon = crate::seed::lexicon();\n00669|     let condition_requested =\n00670|         lexicon.mentions_role(crate::seed::ROLE_CODING_CONDITION_SUBJECT_KIND, task);\n00671|     let implementation_requested = lexicon.mentions_role(\n00672|         crate::seed::ROLE_CODING_SOURCE_IMPLEMENTATION_SUBJECT_KIND,\n00673|         task,\n00674|     );\n00675|     let serialized_relationship = super::workspace_inspection::serialized_relationship_term(task);\n00676|     trace_route(\n00677|         \"evidence_record_relationship\",\n00678|         serialized_relationship.as_deref().unwrap_or(\"none\"),\n00679|     );\n00680|     trace_route(\"evidence_record_terms\", &terms.join(\",\"));\n00681|     let Some(&(mut selected, selected_authority)) = candidates.first() else {\n00682|         return \"\";\n00683|     };\n00684|     let mut selected_score = relevance_score(\n00685|         selected,\n00686|         &terms,\n00687|         condition_requested,\n00688|         implementation_requested,\n00689|         serialized_relationship.as_deref(),\n00690|         selected_authority,\n00691|     );\n00692|     for (candidate, authority) in candidates.into_iter().skip(1) {\n00693|         let score = relevance_score(\n00694|             candidate,\n00695|             &terms,\n00696|             condition_requested,\n00697|             implementation_requested,\n00698|             serialized_relationship.as_deref(),\n00699|             authority,\n00700|         );\n00701|         if score > selected_score {\n00702|             selected = candidate;\n00703|             selected_score = score;\n00704|         }\n00705|     }\n00706|     trace_route(\"evidence_record_selected\", selected);\n00707|     selected\n00708| }\n00709| \n00710| fn relevance_score(\n00711|     line: &str,\n00712|     terms: &[String],\n00713|     condition_requested: bool,\n00714|     implementation_requested: bool,\n00715|     serialized_relationship: Option<&str>,\n00716|     source_authority: usize,\n00717| ) -> (\n00718|     usize,\n00719|     usize,\n00720|     usize,\n00721|     usize,\n00722|     usize,\n00723|     usize,\n00724|     usize,\n00725|     usize,\n00726|     usize,\n00727|     usize,\n00728| ) {\n00729|     let words = line\n00730|         .split(|character: char| !character.is_ascii_alphanumeric())\n00731|         .filter(|word| !word.is_empty())\n00732|         .map(str::to_ascii_lowercase)\n00733|         .collect::<Vec<_>>();\n00734|     let matches = |term: &str| {\n00735|         words.iter().any(|word| word == term)\n00736|             || term\n00737|                 .split('_')\n00738|                 .all(|part| words.iter().any(|word| word == part))\n00739|     };\n00740|     let overlap = terms.iter().filter(|term| matches(term)).count();\n00741|     let requested_property = usize::from(terms.last().is_some_and(|term| matches(term)));\n00742|     let declaration_shape = if looks_like_declaration(line) {\n00743|         1 + usize::from(!looks_like_local_binding(line))\n00744|             + usize::from(looks_like_exposed_declaration(line))\n00745|     } else {\n00746|         0\n00747|     };\n00748|     let bound_requested = terms\n00749|         .iter()\n00750|         .any(|term| crate::seed::lexicon().mentions_role(crate::seed::ROLE_CODING_BOUND_CUE, term));\n00751|     let semantic_overlap = usize::from(\n00752|         bound_requested\n00753|             && words.iter().any(|word| {\n00754|                 crate::seed::lexicon().mentions_role(crate::seed::ROLE_CODING_BOUND_CUE, word)\n00755|             }),\n00756|     );\n00757|     let code_shape = usize::from(line.contains(['{', '}', '(', ')', ';', '=', '<', '>']));\n00758|     let direct_serialized_identity =\n00759|         usize::from(serialized_relationship.is_some_and(|relationship| {\n00760|             words\n00761|                 .windows(2)\n00762|                 .any(|pair| pair[0] == relationship && pair[1] == \"id\")\n00763|         }));\n00764|     (\n00765|         usize::from(implementation_requested && !is_quoted_or_commented_source(source_text(line))),\n00766|         direct_serialized_identity,\n00767|         requested_property,\n00768|         usize::from(condition_requested && looks_like_condition(line)),\n00769|         source_authority,\n00770|         usize::from(condition_requested && looks_like_instance_condition(line)),\n00771|         declaration_shape,\n00772|         semantic_overlap,\n00773|         overlap,\n00774|         code_shape,\n00775|     )\n00776| }\n00777| \n00778| /// Whether a source quotation is shaped as a boolean decision.\n00779| ///\n00780| /// This intentionally recognises syntax classes rather than identifiers: a\n00781| /// condition may begin with a control-flow keyword or continue a compound\n00782| /// expression on its own line. Calls and declarations without a decision\n00783| /// operator remain ordinary source facts.\n00784| fn looks_like_condition(line: &str) -> bool {\n00785|     let source = source_text(line);\n00786|     if is_quoted_or_commented_source(source) {\n00787|         return false;\n00788|     }\n00789|     [\"if \", \"while \", \"match \", \"when \"]\n00790|         .iter()\n00791|         .any(|prefix| source.starts_with(prefix))\n00792|         || [\"&&\", \"||\", \"==\", \"!=\", \">=\", \"<=\"]\n00793|             .iter()\n00794|             .any(|operator| source.contains(operator))\n00795|         || source.starts_with('!')\n00796| }\n00797| \n00798| /// An instance-qualified predicate describes the invariant of the inspected\n00799| /// object more directly than a construction-time check of a similarly named\n00800| /// local value. Recognize common member-access syntax without depending on a\n00801| /// project identifier or a particular natural-language request.\n00802| fn looks_like_instance_condition(line: &str) -> bool {\n00803|     let source = source_text(line);\n00804|     [\"self.\", \"this.\", \"self->\", \"this->\", \"$this->\"]\n00805|         .iter()\n00806|         .any(|receiver| source.contains(receiver))\n00807| }\n00808| \n00809| /// Local bindings can repeat the type of the model field a representation\n00810| /// question asks about. They are declarations, but a public/type-level\n00811| /// declaration is the more authoritative description when both are present.\n00812| fn looks_like_local_binding(line: &str) -> bool {\n00813|     let source = source_text(line);\n00814|     [\"let \", \"var \", \"auto \", \"local \"]\n00815|         .iter()\n00816|         .any(|prefix| source.starts_with(prefix))\n00817| }\n00818| \n00819| /// An exposed declaration describes the model's supported representation more\n00820| /// authoritatively than an unqualified function parameter with the same name\n00821| /// and type.\n00822| fn looks_like_exposed_declaration(line: &str) -> bool {\n00823|     let source = source_text(line);\n00824|     source.split_whitespace().next().is_some_and(|keyword| {\n00825|         matches!(keyword, \"pub\" | \"public\" | \"export\" | \"exported\") || keyword.starts_with(\"pub(\")\n00826|     })\n00827| }\n00828| \n00829| /// Recognize a source declaration without assuming a particular language.\n00830| ///\n00831| /// Grep renders matches as `Line N: source`; discard that transport prefix,\n00832| /// then recognize an identifier-bearing left side followed by a single colon.\n00833| /// Namespace/generic punctuation such as `sum::<usize>()` is deliberately not\n00834| /// a declaration.\n00835| fn looks_like_declaration(line: &str) -> bool {\n00836|     let source = source_text(line);\n00837|     if is_quoted_or_commented_source(source) {\n00838|         return false;\n00839|     }\n00840|     let Some((left, right)) = source.split_once(':') else {\n00841|         return false;\n00842|     };\n00843|     !right.starts_with(':')\n00844|         && !left.contains(['(', ')', '=', '+'])\n00845|         && left.split_whitespace().next_back().is_some_and(|name| {\n00846|             !name.is_empty()\n00847|                 && name\n00848|                     .chars()\n00849|                     .all(|character| character.is_ascii_alphanumeric() || character == '_')\n00850|         })\n00851| }\n00852| \n00853| fn source_text(line: &str) -> &str {\n00854|     line.split_once(\": \")\n00855|         .map_or(line, |(_, source)| source)\n00856|         .trim()\n00857| }\n00858| \n00859| fn is_quoted_or_commented_source(source: &str) -> bool {\n00860|     source.starts_with(\"//\")\n00861|         || source.starts_with(\"/*\")\n00862|         || source.starts_with('*')\n00863|         || source.starts_with('#')\n00864|         || source.starts_with(\"<!--\")\n00865|         || source\n00866|             .chars()\n00867|             .next()\n00868|             .is_some_and(|character| matches!(character, '\"' | '\\'' | '`'))\n00869| }\n00870| \n00871| fn is_match_count(line: &str) -> bool {\n00872|     line.strip_prefix(\"Found \")\n00873|         .and_then(|rest| rest.strip_suffix(\" matches\"))\n00874|         .is_some_and(|count| count.chars().all(|character| character.is_ascii_digit()))\n00875| }\n00876| \n00877| fn looks_like_result_path_heading(line: &str) -> bool {\n00878|     line.ends_with(':') && (line.starts_with('/') || line.starts_with(\"./\"))\n00879| }\n00880| \n00881| /// Prefer a production source fact when an otherwise equivalent test merely\n00882| /// asserts that fact. If every match is outside `src`, the ordinary semantic\n00883| /// ranking remains decisive.\n00884| fn source_authority(path_or_line: &str) -> usize {\n00885|     usize::from(\n00886|         path_or_line\n00887|             .trim_end_matches(':')\n00888|             .split(['/', '\\\\'])\n00889|             .any(|component| component == \"src\"),\n00890|     )\n00891| }\n00892| \n00893| /// What Formal AI answers about the residual, when it reaches a conclusion.\n00894| ///\n00895| /// The layering is the one [`super::general_execution`] already uses: the\n00896| /// agentic planner is a client of the symbolic engine, not a replacement for\n00897| /// it. Declining on an inconclusive answer is what keeps the delivery honest --\n00898| /// the caller asked for what was found out, and \"nothing was\" is not something\n00899| /// to write to a file and call evidence.\n00900| ///\n00901| /// An answer that defers to the open web\n00902| /// ([`crate::engine::SymbolicAnswer::defers_to_the_open_web`]) is declined for\n00903| /// the same reason, and it is the sharper of the two cases because the text\n00904| /// reads like prose about the subject. \"Today's date is Sunday. Create a file\n00905| /// `main.py` that prints Hello, world!\" put the first sentence to the engine,\n00906| /// which described the search it would run for it; delivering that description\n00907| /// wrote a paragraph about `DuckDuckGo` into the caller's Python file. Where the\n00908| /// engine would search, this route has nothing to record and stands aside, and\n00909| /// the request goes on to the routes that recognise it.\n00910| ///\n00911| /// An answer that announces an enumeration and enumerates nothing\n00912| /// ([`crate::engine::SymbolicAnswer::announces_a_list_it_does_not_make`]) is\n00913| /// declined last, and it is the case this whole route is most exposed to: the\n00914| /// text is non-empty, so it survives every check made of the file afterwards,\n00915| /// and a harness reading the file finds a heading with no list and calls the\n00916| /// node proved.\n00917| fn symbolic_answer(residual: &str) -> Option<FinalResult> {\n00918|     // Any gap (`capability_gap`, `write_program_skill_gap`) is such a refusal\n00919|     // (PR #1188 G102).\n00920|     let answer = crate::engine::FormalAiEngine.answer(residual);\n00921|     // A gap refusal is a definite statement about the surface, not a finding\n00922|     // to record: left through, the delivery wrote the refusal into the file\n00923|     // the caller named (issue #1138).\n00924|     if answer.intent.ends_with(GAP_INTENT_SUFFIX)\n00925|         || answer.is_inconclusive()\n00926|         || answer.defers_to_the_open_web()\n00927|         || answer.announces_a_list_it_does_not_make()\n00928|     {\n00929|         return None;\n00930|     }\n00931|     let text = answer.answer.trim().to_owned();\n00932|     (!text.is_empty()).then_some(FinalResult {\n00933|         text,\n00934|         disposition: FinalDisposition::Finding,\n00935|         origin: answer.intent,\n00936|         payload_role: FinalPayloadRole::Finding,\n00937|         artifact: None,\n00938|     })\n00939| }\n00940| \n00941| /// The suffix of an intent that reports a gap: a refusal, never content.\n00942| const GAP_INTENT_SUFFIX: &str = \"_gap\";\n00943| \n00944| /// The same conversation with the served request reduced to `residual`.\n00945| ///\n00946| /// Only the request text changes: every tool result the investigation has\n00947| /// already collected stays in place, so the residual is re-planned with the\n00948| /// progress it has actually made rather than from scratch. The turn reduced is\n00949| /// the request the run is serving -- the last user message that is not a\n00950| /// continuation cue. Reducing the cue itself (issue #1138) put the residual at\n00951| /// the end of the transcript, where every evidence window opened after it and\n00952| /// the investigation re-read what it had already read, forever.\n00953| fn with_residual_request(messages: &[ChatMessage], residual: &str) -> Option<Vec<ChatMessage>> {\n00954|     let index = messages.iter().rposition(|message| {\n00955|         message.role == \"user\"\n00956|             && !super::planner::is_continuation_cue(&message.content.plain_text())\n00957|     })?;\n00958|     let mut residual_messages = messages.to_vec();\n00959|     residual_messages[index].content = MessageContent::Text(residual.to_owned());\n00960|     // Every user message after the served request is a continuation ping\n00961|     // (the rposition above makes it so). Dropping them -- while keeping every\n00962|     // assistant turn and tool result in between -- leaves the residual as the\n00963|     // transcript's last user message. Left in place, the ping resumed the\n00964|     // standing task through its summary envelope, which re-entered this peel\n00965|     // with an identical residual and overflowed the stack (issue #1069).\n00966|     residual_messages.truncate(index + 1);\n00967|     residual_messages.extend(\n00968|         messages[index + 1..]\n00969|             .iter()\n00970|             .filter(|message| !message.role.eq_ignore_ascii_case(\"user\"))\n00971|             .cloned(),\n00972|     );\n00973|     Some(residual_messages)\n00974| }\n00975| \n\n(End of file - total 975 lines)\n</file>"
