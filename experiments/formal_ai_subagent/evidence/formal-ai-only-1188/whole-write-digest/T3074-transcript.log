t' && !Array.isArray(value) ? value : null;\n01110|   } catch {\n01111|     return null;\n01112|   }\n01113| }\n01114| \n01115| const stringField = (value, key) => (typeof value[key] === 'string' ? value[key] : null);\n01116| \n01117| export function resultForPath(messages, capability, path, expectedContent) {\n01118|   return matchingResult(messages, (name, args) => {\n01119|     if (classifyTool(name) !== capability) return false;\n01120|     const value = parseObject(args);\n01121|     if (!value) return false;\n01122|     return argumentMatchesPath(value, path) && (expectedContent === null || stringField(value, 'content') === expectedContent);\n01123|   });\n01124| }\n01125| \n01126| export function resultForEdit(messages, path, old, next) {\n01127|   return matchingResult(messages, (name, args) => {\n01128|     if (classifyTool(name) !== Capability.Edit) return false;\n01129|     const value = parseObject(args);\n01130|     return value !== null && argumentMatchesPath(value, path)\n01131|       && ['oldString', 'old_string', 'old_str', 'old'].some((key) => stringField(value, key) === old)\n01132|       && ['newString', 'new_string', 'new_str', 'new'].some((key) => stringField(value, key) === next);\n01133|   });\n01134| }\n01135| \n01136| function argumentMatchesPath(value, expected) {\n01137|   return ['path', 'filePath', 'file_path'].some((key) => {\n01138|     const observed = stringField(value, key);\n01139|     return observed !== null && workspacePathMatches(expected, observed);\n01140|   });\n01141| }\n01142| \n01143| function components(path) {\n01144|   return path.split('/').filter((part, index) => part !== '' && (part !== '.' || index === 0));\n01145| }\n01146| \n01147| function workspacePathMatches(expected, observed) {\n01148|   if (observed === expected) return true;\n01149|   if (expected.startsWith('/') || !observed.startsWith('/')) return false;\n01150|   const want = components(expected);\n01151|   const have = components(observed);\n01152|   return want.length <= have.length && want.every((part, index) => have[have.length - want.length + index] === part);\n01153| }\n01154| \n01155| export function resultForCommand(messages, command) {\n01156|   return commandResult(messages, command);\n01157| }\n01158| \n01159| function matchingResult(messages, matches) {\n01160|   for (let index = messages.length - 1; index >= 0; index -= 1) {\n01161|     const message = messages[index];\n01162|     if (!eqIgnoreAsciiCase(message.role, 'tool')) continue;\n01163|     const id = message.tool_call_id;\n01164|     if (id === null || id === undefined) continue;\n01165|     let call = null;\n01166|     for (let prior = index - 1; prior >= 0 && call === null; prior -= 1) {\n01167|       const calls = messages[prior].tool_calls || [];\n01168|       for (let at = calls.length - 1; at >= 0; at -= 1) {\n01169|         if (calls[at].id === id) {\n01170|           call = calls[at];\n01171|           break;\n01172|         }\n01173|       }\n01174|     }\n01175|     if (call === null) continue;\n01176|     if (matches(call.function.name, call.function.arguments)) return plainText(message.content);\n01177|   }\n01178|   return null;\n01179| }\n01180| \n01181| export function readArguments(path) {\n01182|   return jsonText({ path, filePath: path, file_path: path });\n01183| }\n01184| \n01185| /**\n01186|  * `Append the line third to notes.txt`: no quoted text, one path, and the\n01187|  * seeded `file_edit_line_lead`; the line is the words after the lead up to\n01188|  * the last destination cue before the path (`go to bed to notes.txt` keeps\n01189|  * `go to bed`). A request without a lead is declined, never guessed.\n01190|  */\n01191| \n01192| /**\n01193|  * `Append an empty line to notes.txt`: the seeded `file_edit_blank_line` and\n01194|  * one named path, with no quoted text, adds one empty line at the named end.\n01195|  */\n01196| function linePayloadAndPath(task) {\n01197|   if (quotedSegmentSpans(task).length > 0) return null;\n01198|   const toks = tokens(task);\n01199|   const pathIndices = toks.map((token, index) => [index, cleanPathToken(token.text)])\n01200|     .filter(([, path]) => looksLikeFilePath(path) && safeRelativePath(path));\n01201|   if (new Set(pathIndices.map(([, path]) => path)).size !== 1) return null;\n01202|   const [pathIndex, target] = pathIndices[0];\n01203|   const leads = wordsForRole('file_edit_line_lead').map((lead) => splitWhitespace(lead.toLowerCase()))\n01204|     .filter((words) => words.length > 0).sort((left, right) => right.length - left.length);\n01205|   let leadEnd = -1;\n01206|   for (let index = 0; index < pathIndex && leadEnd < 0; index += 1) {\n01207|     const lead = leads.find((words) => words.every((word, offset) => index + offset < pathIndex\n01208|       && cleanCueToken(toks[index + offset].text) === word));\n01209|     if (lead) leadEnd = index + lead.length;\n01210|   }\n01211|   if (leadEnd < 0) return null;\n01212|   const destinations = bareSurfaces('file_write_destination_cue');\n01213|   let end = -1;\n01214|   for (let index = leadEnd; index < pathIndex; index += 1) {\n01215|     if (destinations.includes(cleanCueToken(toks[index].text))) end = index;\n01216|   }\n01217|   if (end <= leadEnd) return null;\n01218|   return { target, text: task.slice(toks[leadEnd].start, toks[end - 1].end) };\n01219| }\n01220| \n01221| /**\n01222|  * Mirrors `fn appended_block`: lines under an append request, at the\n01223|  * indentation they were given when the file already has lines indented\n01224|  * exactly so (a `.lino` table appended among its siblings), else at the\n01225|  * file's top level -- the indentation of lines written under a request is\n01226|  * otherwise only the request's layout (PR #1188 G16).\n01227|  */\n01228| function appendedBlock(source, block) {\n01229|   if (block.verbatim || !indentsLinesAt(source, block.indentation)) return block.text;\n01230|   return rebasedBlock(block.text, block.indentation);\n01231| }\n01232|