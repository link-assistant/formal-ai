nction workspacePathMatches(expected, observed) {\n01152|   if (observed === expected) return true;\n01153|   if (expected.startsWith('/') || !observed.startsWith('/')) return false;\n01154|   const want = components(expected);\n01155|   const have = components(observed);\n01156|   return want.length <= have.length && want.every((part, index) => have[have.length - want.length + index] === part);\n01157| }\n01158| \n01159| export function resultForCommand(messages, command) {\n01160|   return commandResult(messages, command);\n01161| }\n01162| \n01163| function planDigestVerification(task, currentTurn, toolNames, change) {\n01164|   const command = `sha256sum -- ${change.target}`;\n01165|   const observed = resultForCommand(currentTurn, command);\n01166|   if (observed === null) return planWithTool(toolNames, Capability.Run, jsonText({ command }));\n01167|   if (!observedDigestMatches(observed, sha256Hex(change.expected))) return failed(task, change.target);\n01168|   return finalOrNull(renderSeededChange(change.intent, task, change.target, change.slots),\n01169|     FinalDisposition.Finding, change.intent);\n01170| }\n01171| \n01172| function matchingResult(messages, matches) {\n01173|   for (let index = messages.length - 1; index >= 0; index -= 1) {\n01174|     const message = messages[index];\n01175|     if (!eqIgnoreAsciiCase(message.role, 'tool')) continue;\n01176|     const id = message.tool_call_id;\n01177|     if (id === null || id === undefined) continue;\n01178|     let call = null;\n01179|     for (let prior = index - 1; prior >= 0 && call === null; prior -= 1) {\n01180|       const calls = messages[prior].tool_calls || [];\n01181|       for (let at = calls.length - 1; at >= 0; at -= 1) {\n01182|         if (calls[at].id === id) {\n01183|           call = calls[at];\n01184|           break;\n01185|         }\n01186|       }\n01187|     }\n01188|     if (call === null) continue;\n01189|     if (matches(call.function.name, call.function.arguments)) return pl