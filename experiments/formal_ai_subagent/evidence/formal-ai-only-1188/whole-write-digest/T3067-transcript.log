n01228|     if (destinations.includes(cleanCueToken(toks[index].text))) end = index;\n01229|   }\n01230|   if (end <= leadEnd) return null;\n01231|   return { target, text: task.slice(toks[leadEnd].start, toks[end - 1].end) };\n01232| }\n01233| \n01234| /**\n01235|  * Mirrors `fn appended_block`: lines under an append request, at the\n01236|  * indentation they were given when the file already has lines indented\n01237|  * exactly so (a `.lino` table appended among its siblings), else at the\n01238|  * file's top level -- the indentation of lines written under a request is\n01239|  * otherwise only the request's layout (PR #1188 G16).\n01240|  */\n01241| function appendedBlock(source, block) {\n01242|   if (block.verbatim || !indentsLinesAt(source, block.indentation)) return block.text;\n01243|   return rebasedBlock(block.text, block.indentation);\n01244| }\n01245| \n01246| /**\n01247|  * Mirrors `fn block_payload_and_path`: the one path a colon-ended request\n01248|  * line names, with nothing else quoted, and the lines under it.\n01249|  */\n01250| function blockPayloadAndPath(block) {\n01251|   const paths = [...new Set(unquotedPathTokens(block.head).map((token) => cleanPathToken(token.text))\n01252|     .filter((path) => looksLikeFilePath(path) && safeRelativePath(path)))];\n01253|   if (paths.length !== 1 || quotedSegmentSpans(block.head).some((segment) => segment.text !== paths[0])) return null;\n01254|   return { target: paths[0], text: block.text };\n01255| }\n01256| \n01257| function blankLineAndPath(task) {\n01258|   if (quotedSegmentSpans(task).length > 0 || !mentionsRole('file_edit_blank_line', task.toLowerCase())) return null;\n01259|   const paths = [...new Set(unquotedPathTokens(task).map((token) => cleanPathToken(token.text))\n01260|     .filter((path) => looksLikeFilePath(path) && safeRelativePath(path)))];\n01261|   return paths.length === 1 ? { target: paths[0], text: '' } : null;\n01262| }\n01263| \n\n(End of file - total 1263 lines)\n</file>"
