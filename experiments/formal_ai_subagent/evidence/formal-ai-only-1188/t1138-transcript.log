   00066|         self.events.iter().find(|event| event.kind == kind)
   00067|     }
   00068| 
   00069|     /// Returns the most recent event of the given kind, if any.
   00070|     #[must_use]
   00071|     pub fn last_of(&self, kind: &str) -> Option<&Event> {
   00072|         self.events.iter().rev().find(|event| event.kind == kind)
