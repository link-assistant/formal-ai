   00222|     /// A leaf step at the top level.
   00223|     Normal,
   00224|     /// A composite step that owns the following [`StepRole::Child`] steps.
   00225|     Parent,
   00226|     /// A sub-step nested under the most recent [`StepRole::Parent`].
   00227|     Child,
   00228| }
