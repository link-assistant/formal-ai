   00355| /// Collapse any run of whitespace (including newlines) into single spaces so a
   00356| /// multi-line answer renders as one concrete `deformalize` detail.
   00357| fn collapse_thinking_whitespace(value: &str) -> String {
   00358|     value.split_whitespace().collect::<Vec<_>>().join(" ")
