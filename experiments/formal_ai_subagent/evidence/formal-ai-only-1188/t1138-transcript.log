   00187|     /// Replay every in-process event into a durable link store projection.
   00188|     ///
   00189|     /// This is additive: the original event log remains in-process, while
   00190|     /// the target store receives memory records that can be exported as
   00191|     /// `.lino` or reduced to doublets by the active backend.
   00192|     pub fn append_to_link_store<S: LinkStore>(
   00193|         &self,
   00194|         store: &mut S,
   00195|     ) -> Result<usize, LinkStoreError> {
   00196|         for event in &self.events {
   00197|             store.append_memory_event(MemoryEvent {
   00198|                 id: event.id.clone(),
   00199|                 kind: Some(event.kind.to_owned()),
   00200|                 content: Some(event.payload.clone()),
   00201|                 evidence: vec![format!("{}:{}", event.kind, event.id)],
   00202|                 ..MemoryEvent::default()
   00203|             })?;
   00204|         }
   00205|         Ok(self.events.len())
   00206|     }
   00207| }
