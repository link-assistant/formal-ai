   00361| /// Curate a single raw solver event into a clean, concrete thinking step, or
   00362| /// `None` when the event is internal bookkeeping that should not surface to the
   00363| /// user.
   00364| ///
   00365| /// This is an **allowlist**: only events that carry meaningful reasoning are
   00366| /// kept, and each is reduced to concrete content (a search term, a route, a
   00367| /// looked-up entity, the composed answer). Unknown kinds are dropped so the
   00368| /// default view stays concrete — the lossless trace remains in the evidence
   00369| /// links for maintainers.
   00370| fn curate_thinking_event(
   00371|     kind: &'static str,
   00372|     payload: &str,
   00373|     final_answer: &str,
   00374| ) -> Option<PlannedThinkingStep> {
   00375|     let detail = payload.trim();
   00376|     let keep = |step: &'static str, detail: &str, level: &'static str| {
   00377|         Some(PlannedThinkingStep::normal(
   00378|             step,
   00379|             detail.to_owned(),
   00380|             level,
   00381|             kind,
   00382|         ))
   00383|     };
   00384|     match kind {
   00385|         // ---- Universal-algorithm phases (high level / minimum granularity) ----
   00386|         "impulse" => keep("impulse", detail, "high"),
   00387|         "language" | "language_from" => keep("detect_language", detail, "high"),
   00388|         "language_to" => keep("resolve_response_language", detail, "high"),
   00389|         "intent_formalization:route" => keep("formalize", detail, "high"),
   00390|         "intent" | "legacy_intent" => keep("dispatch_handler", detail, "high"),
   00391|         "program_plan" | "program_parameters" => keep("program_plan", detail, "high"),
   00392|         "response" => {
   00393|             let value = if final_answer.is_empty() {
   00394|                 detail
   00395|             } else {
   00396|                 final_answer
   00397|             };
   00398|             keep("deformalize", value, "high")
   00399|         }
   00400| 
   00401|         // ---- Concrete detailed reasoning ----
   00402|         "concept_lookup:request" | "procedural_how_to:request" => {
   00403|             keep("scan_memory", detail, "detailed")
   00404|         }
   00405|         "concept_lookup:hit"
   00406|         | "fact_query:relation"
   00407|         | "fact_query:subject"
   00408|         | "fact_lookup:hit"
   00409|         // The timeline an answer was computed from is part of the lookup, so it
   00410|         // shows up in the reasoning trace next to the fact it answered.
   00411|         | "release_timeline:hit" => keep("lookup_fact", detail, "detailed"),
   00412|         "web_search:request" | "http_fetch:request" | "url_navigate:request" => {
   00413|             keep("http_chat", detail, "detailed")
   00414|         }
   00415|         "tool_call" | "tool_result" => keep("invoke_tool", detail, "detailed"),
   00416|         "coreference" | "program_coreference" => keep("coreference_binding", "", "detailed"),
   00417|         "modifier_detection" | "program_modifiers" => keep("modifier_detection", "", "detailed"),
   00418|         "rule_construction" => keep("rule_construction", "", "detailed"),
   00419|         // The validation payload is an internal acceptance reason
   00420|         // (`accepted_without_extra_constraints`); surface a clean verification
   00421|         // step without the meta-language token.
   00422|         "validation" => keep("rule_verification", "", "detailed"),
   00423|         _ if kind.starts_with("tool_") => keep("invoke_tool", detail, "detailed"),
   00424|         _ if kind.starts_with("agent_mode") || kind == "action_log" => {
   00425|             keep("agent_plan", detail, "detailed")
   00426|         }
   00427| 
   00428|         // ---- Everything else: internal bookkeeping, dropped from the view ----
   00429|         _ => None,
   00430|     }
   00431| }
