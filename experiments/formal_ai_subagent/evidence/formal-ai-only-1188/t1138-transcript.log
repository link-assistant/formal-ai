   00015| /// A single event in the append-only log.
   00016| #[derive(Debug, Clone, PartialEq, Eq)]
   00017| pub struct Event {
   00018|     pub id: String,
   00019|     pub kind: &'static str,
   00020|     pub payload: String,
   00021| }
