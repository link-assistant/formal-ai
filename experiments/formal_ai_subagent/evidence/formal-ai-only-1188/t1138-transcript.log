   00035|     /// Append a new event with content-addressed id.
   00036|     ///
   00037|     /// The id is derived from the kind, the payload, and the current log
   00038|     /// length so that repeated events produce stable, distinct ids.
   00039|     pub fn append(&mut self, kind: &'static str, payload: impl Into<String>) -> String {
   00040|         let payload = payload.into();
   00041|         let seed = format!("{kind}:{}:{payload}", self.events.len());
   00042|         let id = stable_id(kind, &seed);
   00043|         self.events.push(Event {
   00044|             id: id.clone(),
   00045|             kind,
   00046|             payload,
   00047|         });
   00048|         id
   00049|     }
   00050| 
   00051|     /// Append a machine-addressable payload without hand-building a textual
   00052|     /// key/value record at every call site.
   00053|     pub fn append_fields(&mut self, kind: &'static str, fields: &[(&str, &str)]) -> String {
   00054|         let payload = render_fields(fields);
   00055|         self.append(kind, payload)
   00056|     }
