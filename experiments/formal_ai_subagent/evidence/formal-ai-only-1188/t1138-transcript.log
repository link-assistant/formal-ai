   00085|     /// Build a Links Notation `steps` block listing every event in order.
   00086|     /// Used by trace serialization in [`crate::solver`].
   00087|     #[must_use]
   00088|     pub fn steps_block(&self) -> String {
   00089|         use std::fmt::Write as _;
