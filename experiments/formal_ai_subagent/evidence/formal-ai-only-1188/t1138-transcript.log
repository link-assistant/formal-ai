   00433| /// Build the evidence links array for a symbolic answer.
   00434| ///
   00435| /// Translates each log event into a typed link, appending `response_link` at
   00436| /// the end when it is not already present.
   00437| #[must_use]
   00438| pub fn build_evidence_links(prompt: &str, log: &EventLog, response_link: &str) -> Vec<String> {
   00439|     let mut links: Vec<String> = Vec::new();
   00440|     links.push(format!("prompt:{}", stable_id("prompt", prompt)));
   00441|     for event in log.events() {
   00442|         let evidence = match event.kind {
   00443|             "trace:execution_failure" => format!("trace:execution_failure:{}", event.id),
   00444|             "language" => format!("language:{}", event.payload),
   00445|             "language_from" => format!("language_from:{}", event.payload),
   00446|             "language_to" => format!("language_to:{}", event.payload),
   00447|             "definition_merge:language" => format!("definition_merge:language:{}", event.payload),
   00448|             "definition_merge:source_declared" => {
   00449|                 format!("definition_merge:source_declared:{}", event.payload)
   00450|             }
   00451|             "meaning" => format!("meaning:{}", event.payload),
   00452|             "translation_gap" => format!("translation_gap:{}", event.payload),
   00453|             "wikidata" => format!("wikidata:{}", event.payload),
   00454|             "formalization" => format!("formalization:{}", event.id),
   00455|             "formalization:subject_q" => {
   00456|                 format!("formalization:subject_q:{}", event.payload)
   00457|             }
   00458|             "formalization:predicate_p" => {
   00459|                 format!("formalization:predicate_p:{}", event.payload)
   00460|             }
   00461|             "formalization:object_q" => {
   00462|                 format!("formalization:object_q:{}", event.payload)
   00463|             }
   00464|             "formalization:item_q" => format!("formalization:item_q:{}", event.payload),
   00465|             "formalization:property_p" => {
   00466|                 format!("formalization:property_p:{}", event.payload)
   00467|             }
   00468|             "formalization:fallback" => {
   00469|                 format!("formalization:fallback:{}", event.payload)
   00470|             }
   00471|             "formalization:raw" => format!("formalization:raw:{}", event.payload),
   00472|             "formalization_unresolved" => {
   00473|                 format!("formalization_unresolved:{}", event.payload)
   00474|             }
   00475|             // Issue #661 (R384): each accepted interpretation's posterior weight,
   00476|             // surfaced verbatim (`formalization:<i> weight=<p> <summary>`) so a
   00477|             // consumer can read every formalized statement as a weighted claim and
   00478|             // verify the weights sum to 1 across candidates. Trace-only.
   00479|             "statement_weight" => format!("statement_weight:{}", event.payload),
   00480|             // Issue #661 (R384): a detected clash between a new formalized
   00481|             // requirement and a retained one. The id keys back to the event whose
   00482|             // payload names both statements, the shared subject, and their weights.
   00483|             "requirement_contradiction" => {
   00484|                 format!("requirement_contradiction:{}", event.id)
   00485|             }
   00486|             "intent_formalization" => format!("intent_formalization:{}", event.id),
   00487|             "intent_formalization_cache" => {
   00488|                 format!(
   00489|                     "intent_formalization_cache:{}",
   00490|                     event.payload.replace(' ', ":")
   00491|                 )
   00492|             }
   00493|             "intent_formalization:kind" => {
   00494|                 format!("intent_formalization:kind:{}", event.payload)
   00495|             }
   00496|             "intent_formalization:route" => {
   00497|                 format!("intent_formalization:route:{}", event.payload)
   00498|             }
   00499|             "intent_formalization:relevant" => {
   00500|                 format!("intent_formalization:relevant:{}", event.payload)
   00501|             }
   00502|             // Structured fact_query trace events (Issue #127): preserve the
   00503|             // payload verbatim so memory consumers can render the parsed
   00504|             // relation, subject, and cache decision (rather than a hash id).
   00505|             "fact_query:request" => format!("fact_query:request:{}", event.id),
   00506|             "fact_query:relation" => format!("fact_query:relation:{}", event.payload),
   00507|             "fact_query:subject" => format!("fact_query:subject:{}", event.payload),
   00508|             "fact_query:cache:hit" => format!("fact_query:cache:hit:{}", event.payload),
   00509|             "fact_query:cache:miss" => String::from("fact_query:cache:miss"),
   00510|             "fact_query:cache:bypass" => String::from("fact_query:cache:bypass"),
   00511|             "fact_query:force_fresh" => String::from("fact_query:force_fresh"),
