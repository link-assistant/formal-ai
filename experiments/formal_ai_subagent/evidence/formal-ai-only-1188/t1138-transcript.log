   00102|     /// Project raw solver events into user-readable, ordered thinking steps.
   00103|     ///
   00104|     /// This is the *curated* projection introduced for issue #488. Instead of a
   00105|     /// noisy 1:1 dump of every internal event, it keeps only the meaningful
   00106|     /// reasoning milestones, cleans each `detail` down to concrete content,
   00107|     /// folds the calculator's reduction trace into one composite `compute` step
   00108|     /// with detailed children, de-duplicates consecutive repeats, and labels the
   00109|     /// universal-algorithm phases `high` so the minimum granularity surfaces only
   00110|     /// the high-level direction.
   00111|     ///
   00112|     /// The raw, lossless trace stays available to maintainers through
   00113|     /// [`EventLog::steps_block`] and [`EventLog::evidence_links`].
   00114|     #[must_use]
   00115|     pub fn thinking_steps(&self) -> Vec<ThinkingStep> {
   00116|         self.thinking_steps_for_answer("")
   00117|     }
   00118| 
   00119|     /// Like [`EventLog::thinking_steps`], but substitutes the actual composed
   00120|     /// answer for the opaque `response:<route>` payload of the closing
   00121|     /// `deformalize` step so the final reasoning step is concrete (issue #488).
   00122|     #[must_use]
   00123|     pub fn thinking_steps_for_answer(&self, final_answer: &str) -> Vec<ThinkingStep> {
   00124|         let answer = collapse_thinking_whitespace(final_answer);
   00125| 
   00126|         // Phase 1 — curate raw events into a clean plan, folding the
   00127|         // calculator's reduction trace into one composite parent + children.
   00128|         let mut plan: Vec<PlannedThinkingStep> = Vec::new();
   00129|         let mut calculation = CalculationCluster::default();
   00130|         for event in &self.events {
   00131|             if event.kind == "calculation" || event.kind.starts_with("calculation:") {
   00132|                 calculation.absorb(event.kind, &event.payload);
   00133|                 continue;
   00134|             }
   00135|             if calculation.has_data() {
   00136|                 calculation.drain_into(&mut plan);
   00137|             }
   00138|             if let Some(step) = curate_thinking_event(event.kind, &event.payload, &answer) {
   00139|                 plan.push(step);
   00140|             }
   00141|         }
   00142|         if calculation.has_data() {
   00143|             calculation.drain_into(&mut plan);
   00144|         }
   00145| 
   00146|         // Phase 2 — de-duplicate consecutive repeats, assign order and parent
   00147|         // ids (so composite steps render as recursively nested thinking).
   00148|         let mut steps: Vec<ThinkingStep> = Vec::new();
   00149|         let mut order: u32 = 0;
   00150|         let mut previous_key: Option<String> = None;
   00151|         let mut current_parent: Option<String> = None;
   00152|         for planned in plan {
   00153|             let key = format!("{}\u{1f}{}", planned.step, planned.detail);
   00154|             let is_child = planned.role == StepRole::Child;
   00155|             if !is_child && previous_key.as_deref() == Some(key.as_str()) {
   00156|                 continue;
   00157|             }
   00158|             previous_key = Some(key);
   00159|             let mut step = ThinkingStep::new(
   00160|                 order,
   00161|                 planned.step,
   00162|                 planned.detail,
   00163|                 planned.level,
   00164|                 planned.source,
   00165|             );
   00166|             match planned.role {
   00167|                 StepRole::Parent => current_parent = Some(step.id.clone()),
   00168|                 StepRole::Child => {
   00169|                     if let Some(parent) = current_parent.clone() {
   00170|                         step = step.with_parent(parent);
   00171|                     }
   00172|                 }
   00173|                 StepRole::Normal => current_parent = None,
   00174|             }
   00175|             steps.push(step);
   00176|             order += 1;
   00177|         }
   00178| 
   00179|         // Phase 3 — narrate the finished trace in the language of the answer
   00180|         // (issue #889). A single step cannot know that language while the trace
   00181|         // is still being built, because the language is itself one of the steps.
   00182|         let language = crate::thinking::thinking_answer_language(&steps);
   00183|         crate::thinking::localize_thinking_steps(&mut steps, &language);
   00184|         steps
   00185|     }
