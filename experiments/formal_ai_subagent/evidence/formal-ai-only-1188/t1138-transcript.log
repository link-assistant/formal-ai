   00280| /// Accumulates the calculator's `calculation:*` trace so it can be rendered as a
   00281| /// single composite `compute` step (parent) with detailed children (issue #488,
   00282| /// requirement R11 — recursively composite / fractal steps).
   00283| #[derive(Default)]
   00284| struct CalculationCluster {
   00285|     request: Option<String>,
   00286|     engine: Option<String>,
   00287|     expression: Option<String>,
   00288|     steps: Option<String>,
   00289|     result: Option<String>,
   00290| }
   00291| 
   00292| impl CalculationCluster {
   00293|     fn absorb(&mut self, kind: &str, payload: &str) {
   00294|         let value = payload.trim().to_owned();
   00295|         match kind {
   00296|             "calculation" => self.result = Some(value),
   00297|             "calculation:request" => self.request = Some(value),
   00298|             "calculation:engine" => self.engine = Some(value),
   00299|             "calculation:lino" => self.expression = Some(value),
   00300|             "calculation:steps" => self.steps = Some(value),
   00301|             // `calculation:rate_basis` and any other detail kinds stay in the raw
   00302|             // evidence trace but are not surfaced in the curated view.
   00303|             _ => {}
   00304|         }
   00305|     }
   00306| 
   00307|     const fn has_data(&self) -> bool {
   00308|         self.result.is_some()
   00309|             || self.request.is_some()
   00310|             || self.engine.is_some()
   00311|             || self.expression.is_some()
   00312|             || self.steps.is_some()
   00313|     }
   00314| 
   00315|     fn drain_into(&mut self, plan: &mut Vec<PlannedThinkingStep>) {
   00316|         let parent_detail = self
   00317|             .result
   00318|             .clone()
   00319|             .or_else(|| self.request.clone())
   00320|             .unwrap_or_default();
   00321|         plan.push(PlannedThinkingStep::parent(
   00322|             "compute",
   00323|             parent_detail,
   00324|             "high",
   00325|             "calculation",
   00326|         ));
   00327|         if let Some(engine) = self.engine.take() {
   00328|             plan.push(PlannedThinkingStep::child(
   00329|                 "compute_engine",
   00330|                 engine,
   00331|                 "detailed",
   00332|                 "calculation:engine",
   00333|             ));
   00334|         }
   00335|         if let Some(expression) = self.expression.take() {
   00336|             plan.push(PlannedThinkingStep::child(
   00337|                 "compute_expression",
   00338|                 expression,
   00339|                 "detailed",
   00340|                 "calculation:lino",
   00341|             ));
   00342|         }
   00343|         if let Some(steps) = self.steps.take() {
   00344|             plan.push(PlannedThinkingStep::child(
   00345|                 "compute_steps",
   00346|                 steps,
   00347|                 "detailed",
   00348|                 "calculation:steps",
   00349|             ));
   00350|         }
   00351|         *self = Self::default();
   00352|     }
   00353| }
