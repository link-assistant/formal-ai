      "result": "<file>\n00001| //! Recover statement-bound literal writes without executing source prose.\n00002| use super::literal_payload;\n00003| use crate::agentic_coding::shell_command_policy::prose_sentences;\n00004| use crate::agentic_coding::write_request::{\n00005|     CueFamily, Token, WriteBinding, action_cue_start_after, bare_surfaces, clean_content,\n00006|     clean_cue_token, content_lead_close, first_action_cue_end, first_action_cue_start,\n00007|     first_content_lead_end, first_prefix_lead_end, payload_continues_past_its_first_line,\n00008|     ranked_bindings, tokens,\n00009| };\n00010| use crate::seed::{self, Slot};\n00011| \n00012| /// A write cue cannot authorize a target in another statement or a preceding read request.\n00013| fn binding_has_write_instruction(\n00014|     request: &str,\n00015|     toks: &[Token<'_>],\n00016|     binding: &WriteBinding,\n00017| ) -> bool {\n00018|     let clause_start = if binding.cue_precedes {\n00019|         binding.cue_start\n00020|     } else {\n00021|         toks[binding.index].start\n00022|     };\n00023|     let scoped = statement_scope(request);\n00024|     let Some(sentence) = prose_sentences(&scoped)\n00025|         .into_iter()\n00026|         .find(|sentence| sentence.span.contains(&clause_start))\n00027|     else {\n00028|         return false;\n00029|     };\n00030|     let Some(statement) = scoped.get(sentence.span.clone()) else {\n00031|         return false;\n00032|     };\n00033|     let action_start =\n00034|         first_action_cue_start(&tokens(statement)).map(|start| sentence.span.start + start);\n00035|     let Some(before) =\n00036|         request.get(sentence.span.start..action_start.unwrap_or(toks[binding.index].start))\n00037|     else {\n00038|         return false;\n00039|     };\n00040|     !seed::lexicon().mentions_role(\n00041|         \"file_read_action_cue\",\n00042|         &crate::engine::normalize_prompt(before),\n00043|     )\n00044| }\n00045| \n00046| /// Recover the `(target, content)` of a write request from its wording.\n00047| ///\n00048| /// The recogniser is entirely seed-driven (issue #680). It locates the target\n00049| /// file by a `file_write_target_cue`/`file_write_destination_cue` that directly\n00050| /// precedes a file-looking, safe relative path, then recovers the content two\n00051| /// ways:\n00052| ///\n00053| /// * **Marker-led** — a `file_write_content_lead` phrase (\"containing\", \"with\n00054| ///   the following\", …) introduces the payload. The content is the span after\n00055| ///   the marker (when the file precedes it) or the span between the marker and\n00056| ///   the file clause (when the content precedes the file).\n00057| /// * **Destination-led** — the \"write CONTENT to FILE\" shape, where a\n00058| ///   `file_write_action_cue` opens the request and a *destination* cue (not a\n00059| ///   positional target cue) routes the preceding span into the file.\n00060| /// * **Action-led** — the \"write FILE saying CONTENT\" shape, where a\n00061| ///   `file_write_action_cue` (\"write\"/\"create\"/\"save\"/…) directly names the file\n00062| ///   and a content-lead marker introduces the payload after it. An action cue\n00063| ///   licenses the file just like a target cue, but only marker-led content is\n00064| ///   accepted for it, so a bare \"create app.rs\" (no content) still falls through\n00065| ///   to the ordinary solver rather than fabricating an empty file.\n00066| ///\n00067| /// Both byte offsets index the lowercased copy, which is byte-length preserving\n00068| /// for en/ru/hi/zh, so the same offsets slice the original request and the\n00069| /// recovered content keeps its case and punctuation.\n00070| pub(super) fn parse_write_request(request: &str) -> Option<(String, String)> {\n00071|     let toks = tokens(request);\n00072|     if let Some(literal) = literal_payload(request) {\n00073|         // A closed whole-file payload supplies the content. Only target cues\n00074|         // before it bind the file; its internal prose is authored data.\n00075|         if let Some(binding) = ranked_bindings(&toks).into_iter().find(|candidate| {\n00076|             toks[candidate.index].end <= literal.start\n00077|                 && candidate.cue_end <= literal.start\n00078|                 && binding_has_write_instruction(request, &toks, candidate)\n00079|         }) {\n00080|             return Some((\n00081|                 binding.path,\n00082|                 clean_content(&request[literal.start..literal.end]).unwrap_or(literal.text),\n00083|             ));\n00084|         }\n00085|     }\n00086|     // A cue between two file-shaped tokens can belong to either of them, and the\n00087|     // ranking only says which reading to try first. The reading that recovers a\n00088|     // payload is the one the sentence supports, so the candidates are taken in\n00089|     // order and the first that parses is the answer. A sentence that offers one\n00090|     // candidate reaches exactly the branch it always did.\n00091|     ranked_bindings(&toks)\n00092|         .into_iter()\n00093|         .find_map(|binding| parse_write_request_bound(request, &toks, &binding))\n00094| }\n00095| \n00096| /// Read `request` as a write delivered through one particular binding.\n00097| fn parse_write_request_bound(\n00098|     request: &str,\n00099|     toks: &[Token<'_>],\n00100|     binding: &WriteBinding,\n00101| ) -> Option<(String, String)> {\n00102|     if !binding_has_write_instruction(request, toks, binding) {\n00103|         return None;\n00104|     }\n00105|     let lowered = request.to_lowercase();\n00106|     let dest_cues = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);\n00107|     let file_index = binding.index;\n00108|     let target = binding.path.clone();\n00109|     // The clause is the cue and its path together, so it begins at whichever of\n00110|     // them the language puts first.\n00111|     let clause_start = if binding.cue_precedes {\n00112|         binding.cue_start\n00113|     } else {\n00114|         toks[file_index].start\n00115|     };\n00116|     let cue_is_destination = binding.family == CueFamily::Destination;\n00117|     // Marker-led content. The payload sits after the marker, bounded by the file\n00118|     // clause when the marker comes first (\"write the following: hello to x.txt\")\n00119|     // and running to the end when the clause comes first (\"store file x.txt\n00120|     // containing hello\").\n00121|     //\n00122|     // A marker that *precedes* the clause additionally needs a write verb, which\n00123|     // is the same rule the destination-led and assignment-shaped branches below\n00124|     // already apply — without it a read request whose object happens to be a\n00125|     // content-lead surface claims a write. The issue-#671 matrix caught\n00126|     // `show me the contents of the file beta.md` planning\n00127|     // `write(beta.md, \"of the\")`, destroying the fixture it was asked to read.\n00128|     // A marker inside a sentence that specifies a document to compose introduces\n00129|     // that document's structure, not its bytes; see\n00130|     // [`crate::agentic_coding::note_composition::composed_document_specification_span`]. Reading\n00131|     // it as a literal payload is what wrote \"the selected tree level, node\n00132|     // outcomes, test results, and session id.\" into the ladder's final proof\n00133|     // file (issue #1066), and it claimed the request too, so the note the caller\n00134|     // asked for was never composed.\n00135|     let specification =\n00136|         crate::agentic_coding::note_composition::composed_document_specification_span(request);\n00137|     if let Some((marker_start, marker_end)) = first_content_lead_end(&lowered)\n00138|         && !specification.is_some_and(|span| span.contains(&marker_end))\n00139|         && positions_share_statement(request, marker_end, clause_start)\n00140|     {\n00141|         let marker_leads