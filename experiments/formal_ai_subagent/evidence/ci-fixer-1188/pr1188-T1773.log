   00017| fn repository_file(path: &str) -> String {
   00018|     fs::read_to_string(format!("{}/../{path}", env!("CARGO_MANIFEST_DIR")))
   00019|         .unwrap_or_else(|error| panic!("failed to read {path}: {error}"))
   00020|         .replace("\r\n", "\n")
   00021| }
   00022| 
   00023| fn workflow_files() -> Vec<(String, String)> {
   00024|     let dir = format!("{}/../.github/workflows", env!("CARGO_MANIFEST_DIR"));
   00025|     let mut files: Vec<(String, String)> = fs::read_dir(&dir)
   00026|         .expect("workflows directory")
   00027|         .map(|entry| entry.expect("workflow entry").path())
   00028|         .filter(|path| {
   00029|             path.extension()
   00030|                 .is_some_and(|ext| ext == "yml" || ext == "yaml")
   00031|         })
   00032|         .map(|path| {
   00033|             let name = path.file_name().unwrap().to_string_lossy().into_owned();
   00034|             let body = fs::read_to_string(&path)
   00035|                 .expect("workflow body")
   00036|                 .replace("\r\n", "\n");
   00037|             (name, body)
   00038|         })
   00039|         .collect();
   00040|     files.sort();
   00041|     assert!(!files.is_empty(), "no workflow files found");
   00042|     files
   00043| }
