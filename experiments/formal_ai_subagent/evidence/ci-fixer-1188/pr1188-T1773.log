   00440| /// Issue #1131: the token decides Docker Hub publishing, not the image.
   00441| ///
   00442| /// Every release since Docker Hub publishing was added skipped it and still
   00443| /// reported success, because `DOCKERHUB_IMAGE` was the switch and nothing ever
   00444| /// set it. Now that the image and the username carry defaults, only the secret
   00445| /// separates a repository that can push from a fork that cannot.
   00446| #[test]
   00447| fn dockerhub_publishing_is_decided_by_the_token() {
   00448|     let root = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00449|     let script = format!("{root}/scripts/configure-dockerhub-publishing.sh");
   00450| 
   00451|     let run = |image: &str, username: &str, token: &str, dockerfile: bool| {
   00452|         let workspace = std::env::temp_dir().join(format!(
   00453|             "formal-ai-dockerhub-{}-{}",
   00454|             std::process::id(),
   00455|             u64::from(dockerfile) + image.len() as u64 * 2 + token.len() as u64 * 4
   00456|         ));
   00457|         std::fs::create_dir_all(&workspace).expect("workspace");
   00458|         let output_file = workspace.join("github-output.txt");
   00459|         std::fs::write(&output_file, "").expect("output file");
   00460|         if dockerfile {
   00461|             std::fs::write(workspace.join("Dockerfile"), "FROM scratch\n").expect("Dockerfile");
   00462|         } else {
   00463|             let _ = std::fs::remove_file(workspace.join("Dockerfile"));
   00464|         }
   00465|         let output = std::process::Command::new("bash")
   00466|             .arg(&script)
   00467|             .current_dir(&workspace)
   00468|             .env("GITHUB_OUTPUT", &output_file)
   00469|             .env("DOCKERHUB_IMAGE", image)
   00470|             .env("DOCKERHUB_USERNAME", username)
   00471|             .env("DOCKERHUB_TOKEN", token)
   00472|             .output()
   00473|             .expect("the configure script runs");
   00474|         let written = std::fs::read_to_string(&output_file).unwrap_or_default();
   00475|         let _ = std::fs::remove_dir_all(&workspace);
   00476|         (output.status.success(), written)
   00477|     };
   00478| 
   00479|     // A fork inherits the defaults but holds no token: quiet, green, disabled.
   00480|     let (ok, written) = run("konard/formal-ai", "konard", "", true);
   00481|     assert!(ok, "a fork without the token still gets a green release");
   00482|     assert!(
   00483|         written.contains("enabled=false"),
   00484|         "no token disables publishing: {written}"
   00485|     );
   00486| 
   00487|     // This repository: token held, defaults in place.
   00488|     let (ok, written) = run("konard/formal-ai", "konard", "dckr_pat_example", true);
   00489|     assert!(ok, "a configured repository publishes");
   00490|     assert!(
