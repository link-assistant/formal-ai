   00279|     );
   00280|     assert!(
   00281|         script.contains("::error::Pipeline has cancelled jobs on main"),
   00282|         "a cancellation on main must be an error annotation"
   00283|     );
   00284|     assert!(
   00285|         script.contains("::warning::Cancelled jobs:"),
   00286|         "a cancellation on another ref is an ordinary supersede: warn only"
   00287|     );
