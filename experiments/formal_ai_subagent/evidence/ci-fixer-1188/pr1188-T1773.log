   00301| /// Assert on the gate's actual behaviour, not just its text: run it against a
   00302| /// success, a timeout-shaped cancellation on and off `main`, and a failure.
   00303| #[test]
   00304| fn gate_script_behaves_correctly_for_every_conclusion() {
   00305|     let root = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00306| 
   00307|     // jq is preinstalled on GitHub-hosted runners; the script relies on it.
   00308|     // Off CI a missing `jq` means "this machine cannot run the case", not "the
   00309|     // gate is broken" -- but on CI its absence must be loud, or this test would
   00310|     // silently stop checking anything.
   00311|     let has_jq = std::process::Command::new("jq")
   00312|         .arg("--version")
   00313|         .output()
   00314|         .is_ok_and(|out| out.status.success());
   00315|     if !has_jq {
   00316|         assert!(
   00317|             std::env::var_os("CI").is_none(),
   00318|             "jq is required by scripts/check-pipeline-status.sh and must be \
   00319|              present on CI"
   00320|         );
   00321|         eprintln!(
   00322|             "skipping: jq is not installed; install it to run this test locally \
   00323|              (it is preinstalled on GitHub-hosted runners)"
   00324|         );
   00325|         return;
   00326|     }
   00327| 
   00328|     let all_ok = r#"{"lint":{"result":"success"},"test":{"result":"skipped"}}"#;
   00329|     let timed_out = r#"{"lint":{"result":"success"},"auto-release":{"result":"cancelled"}}"#;
   00330|     let failed = r#"{"lint":{"result":"failure"}}"#;
   00331| 
   00332|     let cases = [
   00333|         ("success and skipped", all_ok, "true", true),
   00334|         // The case this whole issue is about.
   00335|         ("cancelled on main is a timeout", timed_out, "true", false),
   00336|         (
   00337|             "cancelled elsewhere is a supersede",
   00338|             timed_out,
   00339|             "false",
   00340|             true,
   00341|         ),
   00342|         ("outright failure", failed, "false", false),
   00343|     ];
   00344| 
   00345|     for (label, needs_json, is_main, should_pass) in cases {
   00346|         let output = std::process::Command::new("bash")
   00347|             .arg("scripts/check-pipeline-status.sh")
   00348|             .current_dir(root)
   00349|             .env("NEEDS_JSON", needs_json)
   00350|             .env("IS_MAIN", is_main)
   00351|             .env("GITHUB_OUTPUT", "/dev/null")
   00352|             .output()
   00353|             .expect("run check-pipeline-status.sh");
   00354| 
   00355|         assert_eq!(
   00356|             output.status.success(),
   00357|             should_pass,
   00358|             "{label}: expected the gate to {}\nstdout: {}",
   00359|             if should_pass { "pass" } else { "fail" },
   00360|             String::from_utf8_lossy(&output.stdout)
   00361|         );
   00362|     }
   00363| }
