   00060| fn playwright_setup_never_uses_the_unbounded_with_deps_shortcut() {
   00061|     for (name, body) in workflow_files() {
   00062|         // Comments are allowed to name the flag -- they explain why it is gone.
   00063|         let executable: String = body
   00064|             .lines()
   00065|             .filter(|line| !line.trim_start().starts_with('#'))
   00066|             .collect::<Vec<_>>()
   00067|             .join("\n");
   00068| 
   00069|         assert!(
   00070|             !executable.contains("playwright install --with-deps"),
   00071|             "{name} still runs `playwright install --with-deps`; split the \
   00072|              system-deps install into its own bounded, non-fatal step so a slow \
   00073|              Ubuntu mirror cannot consume the whole job budget (issue #977)"
   00074|         );
   00075|     }
   00076| }
