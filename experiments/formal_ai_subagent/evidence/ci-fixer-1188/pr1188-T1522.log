   00001| //! The generated system diagrams (issue #538, R382).
   00002| //!
   00003| //! `docs/diagrams/{system-overview,solver-handlers,cli-subcommands,http-routes}.md`
   00004| //! are rendered from live data by `formal_ai::agentic_coding::system_diagram`
   00005| //! (twin of `js/agentic/system_diagram.mjs`, whose driver
   00006| //! `scripts/generate-system-diagrams.mjs --check` is the CI drift gate). These
   00007| //! tests pin the Rust twin to the committed parts byte for byte, and pin that
   00008| //! every handler, promotion, route and CLI subcommand the live sources declare
   00009| //! appears in its part — the CLI list read from `rust/src/main.rs` is also held
   00010| //! to what the built `formal-ai --help` prints.
   00011| 
   00012| use std::path::{Path, PathBuf};
   00013| 
   00014| use formal_ai::agentic_coding::system_diagram::{
   00015|     CONFIG_PATH, DIAGRAM_DIR, cli_definition, render_system_diagrams, route_rows,
   00016| };
   00017| 
   00018| fn repository_root() -> PathBuf {
   00019|     Path::new(env!("CARGO_MANIFEST_DIR"))
   00020|         .parent()
   00021|         .expect("the repository root sits above the crate")
   00022|         .to_path_buf()
   00023| }
   00024| 
   00025| fn read_repo(relative: &str) -> Option<String> {
   00026|     std::fs::read_to_string(repository_root().join(relative)).ok()
   00027| }
   00028| 
   00029| fn rendered() -> Vec<(String, String)> {
   00030|     render_system_diagrams(read_repo).expect("the live sources render")
   00031| }
   00032| 
   00033| fn part(file: &str) -> String {
   00034|     rendered()
   00035|         .into_iter()
   00036|         .find(|(name, _)| name == file)
   00037|         .map_or_else(|| panic!("no generated part {file}"), |(_, text)| text)
   00038| }
   00039| 
   00040| #[test]
   00041| fn committed_parts_are_the_generated_parts() {
   00042|     let parts = rendered();
   00043|     let files: Vec<&str> = parts.iter().map(|(file, _)| file.as_str()).collect();
   00044|     assert_eq!(
   00045|         files,
   00046|         [
   00047|             "system-overview.md",
   00048|             "solver-handlers.md",
   00049|             "cli-subcommands.md",
   00050|             "http-routes.md"
   00051|         ]
   00052|     );
   00053|     for (file, text) in &parts {
   00054|         let committed = read_repo(&format!("{DIAGRAM_DIR}/{file}"))
   00055|             .unwrap_or_else(|| panic!("{DIAGRAM_DIR}/{file} is committed"));
   00056|         assert_eq!(
   00057|             &committed, text,
   00058|             "{DIAGRAM_DIR}/{file} drifted; run node scripts/generate-system-diagrams.mjs --write"
   00059|         );
   00060|     }
   00061| }
