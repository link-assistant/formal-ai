   00063| #[test]
   00064| fn every_handler_appears_in_precedence_order() {
   00065|     let text = part("solver-handlers.md");
   00066|     let precedence = formal_ai::seed::handler_precedence();
   00067|     assert!(precedence.len() > 50, "{}", precedence.len());
   00068|     let mut last = 0;
   00069|     for name in precedence {
   00070|         let node = format!("h_{name}[\"");
   00071|         let at = text
   00072|             .find(&node)
   00073|             .unwrap_or_else(|| panic!("handler {name} is drawn"));
   00074|         assert!(at > last, "handler {name} is drawn in precedence order");
   00075|         last = at;
   00076|         assert!(text.contains(&format!("| `{name}` |")), "{name} is tabled");
   00077|     }
   00078|     for name in formal_ai::seed::browser_only_handlers() {
