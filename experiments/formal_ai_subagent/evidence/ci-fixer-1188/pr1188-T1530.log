   00147| /// Every `.lino` file below `directory`.
   00148| fn lino_files(directory: &Path, files: &mut Vec<PathBuf>) {
   00149|     for entry in fs::read_dir(directory)
   00150|         .expect("metadata gap directory")
   00151|         .filter_map(Result::ok)
   00152|     {
   00153|         let path = entry.path();
   00154|         if path.is_dir() {
   00155|             lino_files(&path, files);
   00156|         } else if path.extension().is_some_and(|value| value == "lino") {
   00157|             files.push(path);
   00158|         }
   00159|     }
   00160| }
   00161| 
   00162| /// The committed gaps: one file per seed source below
   00163| /// `data/meta/seed-metadata-gaps/` (R1188-U5). A file states its source once,
   00164| /// and the missing fields most of its gaps share once as the file default
   00165| /// (R1188-U7); a gap states `missing` only where it differs.
   00166| fn committed_gaps(root: &Path) -> BTreeMap<(String, String), String> {
   00167|     let mut paths = Vec::new();
   00168|     lino_files(&root.join("data/meta/seed-metadata-gaps"), &mut paths);
   00169|     paths.sort();
   00170|     assert!(!paths.is_empty(), "the metadata gap audit writes gap files");
   00171| 
   00172|     let mut gaps = BTreeMap::new();
   00173|     for path in paths {
   00174|         let text = fs::read_to_string(&path).expect("metadata gap file");
   00175|         assert!(
   00176|             text.lines().count() <= 1_500,
   00177|             "{} exceeds the data-file line limit",
   00178|             path.display()
   00179|         );
   00180|         let source = text
   00181|             .lines()
   00182|             .find_map(|line| line.strip_prefix("  source "))
   00183|             .map(|value| value.trim_matches('"').to_owned())
   00184|             .expect("a gap file states its source");
   00185|         let shared_missing = text
   00186|             .lines()
   00187|             .find_map(|line| line.strip_prefix("  missing "))
   00188|             .map_or_else(String::new, |value| value.trim_matches('"').to_owned());
   00189|         let mut entries: Vec<(String, String, String)> = Vec::new();
   00190|         for line in text.lines() {
   00191|             if let Some(id) = line.strip_prefix("  gap ") {
   00192|                 assert!(
   00193|                     id.starts_with("seed-metadata-gap-") && id.len() == 34,
   00194|                     "gap identifier should be a stable 64-bit hash: {id}"
   00195|                 );
   00196|                 entries.push((id.to_owned(), String::new(), shared_missing.clone()));
   00197|             } else if let Some(value) = line.strip_prefix("    record ") {
   00198|                 value
   00199|                     .trim_matches('"')
   00200|                     .clone_into(&mut entries.last_mut().expect("gap record").1);
   00201|             } else if let Some(value) = line.strip_prefix("    missing ") {
   00202|                 value.trim_matches('"').clone_into(&mut entries.last_mut().expect("gap missing").2);
   00203|             }
   00204|         }
   00205|         for (_, record, missing) in entries {
   00206|             assert!(
   00207|                 !missing.is_empty(),
   00208|                 "{record} in {source} names no missing field"
   00209|             );
   00210|             assert!(
   00211|                 gaps.insert((source.clone(), record), missing).is_none(),
   00212|                 "each seed record has at most one gap entry"
   00213|             );
   00214|         }
   00215|     }
   00216|     gaps
   00217| }
