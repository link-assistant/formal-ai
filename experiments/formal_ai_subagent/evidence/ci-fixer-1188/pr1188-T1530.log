   00298| #[test]
   00299| fn generic_interpreter_components_are_registered_outside_the_census() {
   00300|     // Issue #1138 B9, plan 09 leaf 17: the migration families need compiled
   00301|     // homes that are not themselves handler debt. A `component` block in the
   00302|     // ledger names one such file outside the census, the boundary category it
   00303|     // was promoted under, and the reason it passes the promotion test. The
   00304|     // test reads the ledger through the gate's own parser so the gate and the
   00305|     // suite cannot disagree about what a component is.
   00306|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00307|         .parent()
   00308|         .expect("the repository root sits one level above the crate");
   00309|     let ledger_text = fs::read_to_string(root.join("data/meta/core-boundary-ledger.lino"))
   00310|         .expect("issue #918 must provide the source-file core-boundary ledger");
   00311|     let ledger = check_minimal_core_boundary::parse_ledger(&ledger_text)
   00312|         .expect("the boundary ledger parses, components included");
   00313|     let census = handler_sources();
   00314|     assert!(
   00315|         !ledger.components.is_empty(),
   00316|         "the migration families register their generic interpreters as components"
   00317|     );
   00318|     let mut names = BTreeSet::new();
   00319|     for record in &ledger.components {
   00320|         assert!(
   00321|             names.insert(record.name.as_str()),
   00322|             "component names are unique: {}",
   00323|             record.name
   00324|         );
   00325|         assert_eq!(
   00326|             record.kind, "Generic interpreter",
   00327|             "component {} is registered under the boundary document's interpreter category",
   00328|             record.name
   00329|         );
   00330|         assert!(
   00331|             !record.reason.is_empty(),
   00332|             "component {} explains the promotion decision",
   00333|             record.name
   00334|         );
   00335|         assert!(
   00336|             !census.contains(&record.file),
   00337|             "component {} file {} must sit outside the handler census",
   00338|             record.name,
   00339|             record.file
   00340|         );
   00341|         assert!(
   00342|             root.join(&record.file).is_file(),
   00343|             "component {} file {} must exist",
   00344|             record.name,
   00345|             record.file
   00346|         );
   00347|     }
   00348|     assert!(
   00349|         names.contains("retrieval_method_interpreter"),
   00350|         "the M2 retrieval family's interpreter is registered"
   00351|     );
   00352| }
