   00034| #[derive(Default)]
   00035| struct LedgerEntry {
   00036|     path: String,
   00037|     disposition: String,
   00038|     core_component: String,
   00039|     reason: String,
   00040| }
   00041| 
   00042| fn ledger_entries(ledger: &str) -> Vec<LedgerEntry> {
   00043|     let mut entries = Vec::new();
   00044|     let mut current: Option<LedgerEntry> = None;
   00045|     for line in ledger.lines() {
   00046|         if let Some(path) = line.strip_prefix("  source ") {
   00047|             if let Some(entry) = current.take() {
   00048|                 entries.push(entry);
   00049|             }
   00050|             current = Some(LedgerEntry {
   00051|                 path: path.to_owned(),
   00052|                 ..LedgerEntry::default()
   00053|             });
   00054|         } else if let Some(entry) = current.as_mut() {
   00055|             let trimmed = line.trim();
   00056|             if let Some(value) = trimmed.strip_prefix("disposition ") {
   00057|                 value.clone_into(&mut entry.disposition);
   00058|             } else if let Some(value) = trimmed.strip_prefix("core_component ") {
   00059|                 value.clone_into(&mut entry.core_component);
   00060|             } else if let Some(value) = trimmed.strip_prefix("reason ") {
   00061|                 value.trim_matches('"').clone_into(&mut entry.reason);
   00062|             }
   00063|         }
   00064|     }
   00065|     if let Some(entry) = current {
   00066|         entries.push(entry);
   00067|     }
   00068|     entries
   00069| }
