   00376| #[test]
   00377| fn coding_path_has_complete_metadata_and_every_other_gap_is_data() {
   00378|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00379|         .parent()
   00380|         .expect("the repository root sits one level above the crate");
   00381|     let schema_text = fs::read_to_string(root.join("data/meta/seed-metadata-schema.lino"))
   00382|         .expect("seed metadata schema");
   00383|     let required = required_metadata(&schema_text);
   00384|     assert_eq!(
   00385|         required,
   00386|         ["role", "precondition", "effect", "unit", "example"]
   00387|     );
   00388|     for external_shape in ["FrameNet", "Wikidata:Data_model", "typed property value"] {
   00389|         assert!(
   00390|             schema_text.contains(external_shape),
   00391|             "schema must cite {external_shape}"
   00392|         );
   00393|     }
   00394|     let complete_sources = schema_text
   00395|         .lines()
   00396|         .filter_map(|line| line.strip_prefix("  complete_source "))
   00397|         .map(|value| value.trim_matches('"').to_owned())
   00398|         .collect::<BTreeSet<_>>();
   00399|     assert_eq!(complete_sources.len(), 3);
   00400|     let registered_languages = formal_ai::language::registered_languages();
   00401|     assert!(!registered_languages.is_empty(), "language registry");
   00402| 
   00403|     let mut expected_gaps = BTreeMap::new();
   00404|     let mut coding_records = 0;
   00405|     let seed_root = root.join("data/seed");
   00406|     for path in lino_files_below(&seed_root) {
   00407|         let source = path
   00408|             .strip_prefix(root)
   00409|             .expect("relative seed path")
   00410|             .to_string_lossy()
   00411|             .replace('\\', "/");
   00412|         let text = fs::read_to_string(&path).expect("seed file");
   00413|         for (source, record, fields) in meaning_records(&source, &text) {
   00414|             let missing = required
   00415|                 .iter()
   00416|                 .filter(|field| !fields.contains(field.as_str()))
   00417|                 .cloned()
   00418|                 .collect::<Vec<_>>();
   00419|             if complete_sources.contains(&source) {
   00420|                 coding_records += 1;
   00421|                 for language in &registered_languages {
   00422|                     assert!(
   00423|                         missing.is_empty(),
   00424|                         "{source}:{record} is missing language-neutral metadata {missing:?} for {}",
   00425|                         language.slug()
   00426|                     );
   00427|                 }
   00428|             } else if !missing.is_empty() {
   00429|                 expected_gaps.insert((source, record), missing.join(","));
   00430|             }
   00431|         }
   00432|     }
   00433|     // Scala and Kotlin joined the coding catalog for the hive-mind#2158
   00434|     // language matrix (issue #921), and PHP followed them under issue #1021, so
   00435|     // the complete-source floor rises with each: 27 catalog records + 15 task
   00436|     // records. The fifteenth task is `program_task_copy_stdin_to_stdout`, the
   00437|     // task issue #863 reported (see `tests/unit/issue_1021_behaviour_range.rs`);
   00438|     // the twenty-seventh catalog record is `program_language_laravel`, the
   00439|     // framework issue #723 asked for, which is a catalog row of its own rather
   00440|     // than an alias surface of PHP. Either way a new target is a new
   00441|     // complete-source record, never a new gap. Three later additions are not
   00442|     // language targets at all: `workspace_inspection_examine`,
   00443|     // `workspace_inspection_verify` and `workspace_inspection_identify` are the
   00444|     // vocabulary that lets a request to *look at* the repository route to a
   00445|     // workspace search instead of an open-web one (issue #1066). They land in
   00446|     // the same complete source as the coding tasks and carry the same five
   00447|     // fields, so they raise the floor rather than the gap count -- which is the
   00448|     // point of the floor: new agent capability arrives as described data.
   00449|     // Issue #1069 first added 29 complete workspace-search records, moving the
   00450|     // floor from 45 to 74. Its verified ladder then supplied 18 leaf-first
   00451|     // decomposition and proof facts, moving the floor from 74 to 92. Its
   00452|     // change-shaped delegation work added the three member-list kinds --
   00453|     // `coding_member_list_sequence`, `coding_member_list_set` and
   00454|     // `coding_member_list_group` -- that let a request name the collection it
   00455|     // edits in words the file never has to repeat, moving the floor from 92 to
   00456|     // 95. Issue #1131 added `coding_member_add`, the verb that says a member
   00457|     // list should grow, moving the floor from 95 to 96: the nouns alone had
   00458|     // been routing whole-file rewrites into member insertion. Issue #1133
   00459|     // added five more records from the three Hive Mind runs that produced no
   00460|     // solution -- `git_branch_cue` and `git_commit_request` (where a work
   00461|     // item's result lands, and the request to land it), `ci_workflow_request`
   00462|     // (the workflow an issue asks for beside the program) and the two
   00463|     // `file_edit_position_*` cues of an additive edit -- moving the floor
   00464|     // from 96 to 101: each was a hardcoded English sentence or a missing route
   00465|     // before it was data. None is allowed to become a metadata gap.
   00466|     // Issue #1138 moved five repository-workflow meanings out of the coding
   00467|     // task source into their own complete domain source, then added four
   00468|     // language-neutral repository-target meanings here. Recounted 2026-09-22,
   00469|     // the three complete coding sources carry 5 (config) + 28 (catalog) +
   00470|     // 68 (tasks) = 101 records: the #1138 net-floor line said 100 and shipped
   00471|     // unverified, masked by a run whose census-freshness step died before the
   00472|     // unit tests executed. The floor is 101; none of the nine records became
   00473|     // an unreviewed metadata gap.
   00474|     // Issue #1167 added `program_language_swift` and `program_language_r` to
   00475|     // the catalog, each with role, precondition, effect, unit and example, so
   00476|     // the catalog carries 30 and the floor moves from 101 to 103.
   00477|     // The agentic edit verbs then added three task records, each with all
   00478|     // five fields: `coding_text_remove` (remove quoted text from a file),
   00479|     // `setting` (the key of a configuration file whose value changes) and
   00480|     // `typo` (a misspelling whose correction is discovered, not stated), so
   00481|     // the floor moves from 103 to 106.
   00482|     // PR #1188 then added seven, each with all five fields: the edit composer's
   00483|     // `coding_declaration` and `function_declaration` (a function named by
   00484|     // identifier is removed whole), `function_call` (the undefined-call
   00485|     // routing claim), `coding_bug_fix_request` and `coding_expectation_cue`
   00486|     // (a stated expectation drives the fix), and `module_export_question` and
   00487|     // `module_export_marker` (what a module exports), so the floor moves from
   00488|     // 106 to 113.
   00489|     // PR #1188 round 18 moved the decomposition-tree and Agent-CLI ladder
   00490|     // records out of the tasks source to keep it under 1500 lines, and the
   00491|     // schema did not follow, so the floor read 77. Their new file is a
   00492|     // complete source too: 33 (catalog) + 10 (config) + 34 (tasks) + 38
