   00001| //! Regression coverage for issue #918's minimal-core and seed-metadata audit.
   00002| 
   00003| use std::collections::{BTreeMap, BTreeSet};
   00004| use std::fs;
   00005| use std::path::{Path, PathBuf};
   00006| 
   00007| /// The CI gate itself, compiled into the suite.
   00008| ///
   00009| /// The census below and `rust-script scripts/check-minimal-core-boundary.rs`
   00010| /// must agree on which files are handler debt. Walking the directory twice made
   00011| /// that a coincidence; reading it through the gate's own `source_files` makes it
   00012| /// a fact -- issue #991 added an exclusion for generated `mod` lists, and one
   00013| /// edit taught both.
   00014| #[path = "../../../scripts/check-minimal-core-boundary.rs"]
   00015| mod check_minimal_core_boundary;
   00016| 
   00017| /// Every handler source the boundary gate counts, with its line count, relative
   00018| /// to the repository root.
   00019| fn handler_source_lines() -> BTreeMap<String, usize> {
   00020|     check_minimal_core_boundary::source_files(
   00021|         Path::new(env!("CARGO_MANIFEST_DIR"))
   00022|             .parent()
   00023|             .expect("the repository root sits one level above the crate"),
   00024|     )
   00025|     .expect("the boundary gate should enumerate the handler sources")
   00026| }
   00027| 
   00028| /// Every handler source the boundary gate counts, relative to the repository
   00029| /// root.
   00030| fn handler_sources() -> BTreeSet<String> {
   00031|     handler_source_lines().into_keys().collect()
   00032| }
