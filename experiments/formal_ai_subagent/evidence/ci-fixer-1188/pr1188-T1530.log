   00099| fn meaning_records(source: &str, text: &str) -> Vec<(String, String, BTreeSet<String>)> {
   00100|     if text.lines().find(|line| !line.trim().is_empty()) != Some("meanings") {
   00101|         return Vec::new();
   00102|     }
   00103|     let mut records = Vec::new();
   00104|     let mut current: Option<(String, String, BTreeSet<String>)> = None;
   00105|     for line in text.lines().skip(1) {
   00106|         // A `#` line documents the records around it, as in the audit script
   00107|         // (`scripts/audit-seed-metadata.rs`); it is never a record itself.
   00108|         if line.trim_start().starts_with('#') {
   00109|             continue;
   00110|         }
   00111|         let indentation = line.bytes().take_while(|byte| *byte == b' ').count();
   00112|         if indentation == 2 {
   00113|             if let Some(record) = current.take() {
   00114|                 records.push(record);
   00115|             }
   00116|             current = Some((
   00117|                 source.to_owned(),
   00118|                 line.split_whitespace()
   00119|                     .next()
   00120|                     .expect("meaning name")
   00121|                     .to_owned(),
   00122|                 BTreeSet::new(),
   00123|             ));
   00124|         } else if indentation == 4 {
   00125|             let trimmed = line.trim();
   00126|             if let (Some(record), Some(value_offset)) =
   00127|                 (current.as_mut(), trimmed.find(char::is_whitespace))
   00128|             {
   00129|                 let field = &trimmed[..value_offset];
   00130|                 let raw_value = trimmed[value_offset..].trim();
   00131|                 let value = raw_value
   00132|                     .strip_prefix('"')
   00133|                     .and_then(|value| value.strip_suffix('"'))
   00134|                     .unwrap_or(raw_value);
   00135|                 if !value.trim().is_empty() {
   00136|                     record.2.insert(field.to_owned());
   00137|                 }
   00138|             }
   00139|         }
   00140|     }
   00141|     if let Some(record) = current {
   00142|         records.push(record);
   00143|     }
   00144|     records
   00145| }
