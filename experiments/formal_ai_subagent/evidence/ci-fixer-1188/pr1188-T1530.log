   00071| fn lino_files_below(directory: &Path) -> Vec<PathBuf> {
   00072|     fn visit(directory: &Path, paths: &mut Vec<PathBuf>) {
   00073|         for entry in fs::read_dir(directory).expect("data directory") {
   00074|             let path = entry.expect("data entry").path();
   00075|             if path.is_dir() {
   00076|                 visit(&path, paths);
   00077|             } else if path
   00078|                 .extension()
   00079|                 .is_some_and(|extension| extension == "lino")
   00080|             {
   00081|                 paths.push(path);
   00082|             }
   00083|         }
   00084|     }
   00085|     let mut paths = Vec::new();
   00086|     visit(directory, &mut paths);
   00087|     paths.sort();
   00088|     paths
   00089| }
