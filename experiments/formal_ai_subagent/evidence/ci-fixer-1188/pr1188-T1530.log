   00219| #[test]
   00220| fn minimal_core_ledger_covers_every_recursive_handler_source() {
   00221|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00222|         .parent()
   00223|         .expect("the repository root sits one level above the crate");
   00224|     let actual = handler_sources();
   00225|     let ledger = fs::read_to_string(root.join("data/meta/core-boundary-ledger.lino"))
   00226|         .expect("issue #918 must provide the source-file core-boundary ledger");
   00227|     let entries = ledger_entries(&ledger);
   00228|     let active = entries
   00229|         .iter()
   00230|         .filter(|entry| entry.disposition != "delete")
   00231|         .map(|entry| entry.path.clone())
   00232|         .collect::<BTreeSet<_>>();
   00233| 
   00234|     assert_eq!(active, actual);
   00235|     // The census history (46 before issue #1085, the plan 09 leaf 1 corrected
   00236|     // undercount, the plan 08 and URL-parsing promotions, the plan 16 L1
   00237|     // re-measure, the PR #1188 interpreters) lives in the ledger's `note` rows.
   00238|     // Restating the totals here froze 53 / 51 / 2 long after the ledger moved
   00239|     // on, so the expected counts are the ledger's own reviewed ceilings: the
   00240|     // gate proves those equal to the tree, and this test proves the rows agree.
   00241|     let ceiling = |field: &str| -> usize {
   00242|         ledger
   00243|             .lines()
   00244|             .find_map(|line| line.trim().strip_prefix(field))
   00245|             .and_then(|value| value.trim().parse().ok())
   00246|             .unwrap_or_else(|| panic!("the ledger records {field}"))
   00247|     };
   00248|     let source_files = ceiling("source_file_count_max ");
   00249|     let outside_core_files = ceiling("outside_core_file_count_max ");
   00250|     assert_eq!(actual.len(), source_files);
   00251|     assert_eq!(
   00252|         entries
   00253|             .iter()
   00254|             .filter(|entry| entry.disposition == "migrate")
   00255|             .count(),
   00256|         outside_core_files
   00257|     );
   00258|     assert_eq!(
   00259|         entries
   00260|             .iter()
   00261|             .filter(|entry| entry.disposition == "promote")
   00262|             .count(),
   00263|         source_files - outside_core_files,
   00264|         "every active row is either migration debt or a promoted interpreter"
   00265|     );
   00266|     for entry in entries
   00267|         .iter()
   00268|         .filter(|entry| entry.disposition == "promote")
   00269|     {
   00270|         assert!(
   00271|             !entry.core_component.is_empty(),
   00272|             "{} promotion must name its core component",
   00273|             entry.path
   00274|         );
   00275|         assert!(
   00276|             !entry.reason.is_empty(),
   00277|             "{} promotion must explain the boundary decision",
   00278|             entry.path
   00279|         );
   00280|     }
   00281|     for disposition in entries.iter().map(|entry| entry.disposition.as_str()) {
   00282|         assert!(matches!(disposition, "migrate" | "promote" | "delete"));
   00283|     }
   00284|     // The ledger's ceiling is the measurement itself: the gate fails when it sits
   00285|     // above *or* below the real count, so migration debt can only ratchet down.
   00286|     // Restating the number here would freeze a value that every handler edit moves
   00287|     // into a second shared file -- the conflict shape issue #991 removes -- so the
   00288|     // expected total is summed from the same sources the gate measures.
   00289|     let lines = handler_source_lines();
   00290|     let outside_core_lines: usize = entries
   00291|         .iter()
   00292|         .filter(|entry| entry.disposition == "migrate")
   00293|         .map(|entry| lines[&entry.path])
   00294|         .sum();
   00295|     assert!(ledger.contains(&format!("outside_core_lines_max {outside_core_lines}")));
   00296| }
