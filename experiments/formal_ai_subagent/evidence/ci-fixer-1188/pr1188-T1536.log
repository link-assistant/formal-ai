   00428| /// R1012-5 and R1012-7: the audit record names its reports and its analysis.
   00429| ///
   00430| /// The README carries the timeline, the requirement inventory, the
   00431| /// finding-by-finding root causes, the alternatives, the research and the two
   00432| /// template reports with the canonical upstream issues they defer to.
   00433| #[test]
   00434| fn audit_record_carries_its_analysis_and_upstream_reports() {
   00435|     let record = repository_file(&format!("{ARCHIVE}/README.md"));
   00436|     for section in [
   00437|         "## Timeline reconstructed from independent timestamps",
   00438|         "## Requirements inventory",
   00439|         "## Finding-by-finding root cause analysis",
   00440|         "## Complete template comparison",
   00441|         "## Online research and reusable components",
   00442|         "## Alternatives and solution plans",
   00443|         "## Upstream reports",
   00444|         "## Tests and verification record",
   00445|     ] {
   00446|         assert!(record.contains(section), "missing {section:?}");
   00447|     }
