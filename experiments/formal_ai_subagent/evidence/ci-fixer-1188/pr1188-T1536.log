   00361| /// The canonical archive of issue #1012 / pull request #1013.
   00362| const ARCHIVE: &str = "dev/log/issues/1012/pulls/1013";
   00363| 
   00364| fn archive_entries(directory: &str, prefix: &str, suffix: &str) -> usize {
   00365|     let path = format!("{}/../{ARCHIVE}/{directory}", env!("CARGO_MANIFEST_DIR"));
   00366|     fs::read_dir(&path)
   00367|         .unwrap_or_else(|error| panic!("read {path}: {error}"))
   00368|         .filter_map(Result::ok)
   00369|         .filter(|entry| {
   00370|             entry
   00371|                 .file_name()
   00372|                 .to_str()
   00373|                 .is_some_and(|name| name.starts_with(prefix) && name.ends_with(suffix))
   00374|         })
   00375|         .count()
   00376| }
