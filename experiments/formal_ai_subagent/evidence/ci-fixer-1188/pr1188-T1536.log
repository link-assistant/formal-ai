   00115|         "{}/../scripts/run-with-budget-warning.sh",
   00116|         env!("CARGO_MANIFEST_DIR")
   00117|     );
   00118|     // Issue #1017 made the wrapper enforce the budget it warns about, so the
   00119|     // command has to stay inside it for this case to be about the warning
   00120|     // alone: warn at 30% of 4s, finish at 2s. Enforcement has its own coverage
   00121|     // in `step_budgets_within_job_clocks::budget_wrapper_terminates_the_overrun_and_reports_it_as_an_error`.
   00122|     let output = Command::new("bash")
   00123|         .arg(script)
   00124|         .env("TEST_WARN_RATIO_PERCENT", "30")
   00125|         .args(["4", "Slow regression test", "bash", "-c", "sleep 2"])
   00126|         .output()
   00127|         .expect("run budget warning wrapper");
   00128| 
   00129|     assert!(output.status.success());
   00130|     let stderr = String::from_utf8_lossy(&output.stderr);
   00131|     assert!(
   00132|         stderr.contains("::warning title=Slow regression test is approaching its timeout::"),
   00133|         "warning should be emitted while the wrapped command is still alive: {stderr}"
   00134|     );
