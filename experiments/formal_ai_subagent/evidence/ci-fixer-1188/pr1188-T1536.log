   00137| #[test]
   00138| fn download_artifact_deprecation_is_suppressed_only_on_affected_steps() {
   00139|     // Issue #1039 replaced the macOS slice's `download-artifact` step with
   00140|     // `scripts/download-artifact-with-retry.sh`, so that workflow no longer
   00141|     // uses the action at all and is not listed here. The rule this test pins is
   00142|     // "every v8 step suppresses DEP0005", not "every workflow has a v8 step" --
   00143|     // a workflow that stops using the action cannot regress the warning.
   00144|     // `release.yml` no longer names the action directly: issue #1051 moved its
   00145|     // downloads into a composite action, which the sweep below still covers.
   00146|     for path in [
   00147|         ".github/workflows/agentic-cli-matrix.yml",
   00148|         ".github/workflows/desktop-release.yml",
   00149|     ] {
   00150|         let workflow = repository_file(path);
   00151|         let steps = action_step(&workflow, "actions/download-artifact@v8");
   00152|         assert!(
   00153|             !steps.is_empty(),
   00154|             "{path} should exercise download-artifact v8"
   00155|         );
   00156|         for step in steps {
   00157|             assert!(
   00158|                 step.contains("NODE_OPTIONS: --disable-warning=DEP0005"),
   00159|                 "{path} has an unsuppressed download-artifact v8 step:\n{step}"
   00160|             );
   00161|         }
   00162|     }
   00163| 
   00164|     // The rule still applies to every *other* workflow, including the ones not
   00165|     // listed above. Dropping macos-core-tests.yml from the list must not create
   00166|     // a blind spot if a v8 step comes back to it later.
   00167|     for entry in fs::read_dir(format!(
   00168|         "{}/../.github/workflows",
   00169|         env!("CARGO_MANIFEST_DIR")
   00170|     ))
   00171|     .expect("read .github/workflows")
   00172|     {
   00173|         let path = entry.expect("read a workflow").path();
   00174|         if path.extension().is_none_or(|extension| extension != "yml") {
   00175|             continue;
   00176|         }
   00177|         let workflow = fs::read_to_string(&path)
   00178|             .unwrap_or_else(|error| panic!("failed to read {}: {error}", path.display()))
   00179|             .replace("\r\n", "\n");
   00180|         for step in action_step(&workflow, "actions/download-artifact@v8") {
   00181|             assert!(
   00182|                 step.contains("NODE_OPTIONS: --disable-warning=DEP0005"),
   00183|                 "{} has an unsuppressed download-artifact v8 step:\n{step}",
   00184|                 path.display()
   00185|             );
   00186|         }
   00187|     }
   00188| }
