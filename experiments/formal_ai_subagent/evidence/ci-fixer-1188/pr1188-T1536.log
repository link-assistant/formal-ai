   00021| #[test]
   00022| fn macos_core_tests_are_sliced_and_warn_before_the_job_timeout() {
   00023|     let workflow = release_workflow();
   00024|     let test = job_block(&workflow, "test");
   00025|     let macos_call = job_block(&workflow, "macos-core-tests");
   00026|     let macos = repository_file(".github/workflows/macos-core-tests.yml");
   00027| 
   00028|     assert_eq!(test.matches("os: macos-15-intel").count(), 1);
   00029|     assert!(test.contains("test-suite: specification"));
   00030|     assert!(macos_call.contains("uses: ./.github/workflows/macos-core-tests.yml"));
   00031|     // Issue #1059: macOS runs only the tests whose behaviour can differ from
   00032|     // Linux -- 139 of 2895, about ten seconds. Sharding that multiplies
   00033|     // checkout, toolchain and a 916MB artifact download across machines for no
   00034|     // gain, so one partition is the whole matrix now.
   00035|     assert!(
   00036|         macos.contains("- { partition: 1 }"),
   00037|         "the macOS lane runs on one runner"
   00038|     );
   00039|     assert!(
   00040|         !macos.contains("- { partition: 2 }"),
   00041|         "sharding ten seconds of tests costs more than it saves"
   00042|     );
   00043|     assert_eq!(
   00044|         macos
   00045|             .matches("cargo nextest --manifest-path rust/Cargo.toml archive")
   00046|             .count(),
   00047|         1
   00048|     );
   00049|     assert!(
   00050|         macos.contains("plan-test-partition.rs --macos-platform"),
   00051|         "the lane selects platform-sensitive modules, not a slice of everything"
   00052|     );
   00053|     // Issue #1055 raised the archive cap 30m -> 35m so its budget could grow to
   00054|     // 1400s for a cold rebuild while staying at 66% of the cap; issue #1017's
   00055|     // gate allows 70%.
   00056|     //
   00057|     // Issue #1081 made this a floor too, and the cap moved to 45m: the doc
   00058|     // tests in the same job stopped being unbudgeted, so the 70% share is now
   00059|     // measured against 1400 + 400 = 1800s rather than 1400s alone. An equality
   00060|     // here would have made giving a step its budget look like a regression.
   00061|     let archive_cap: u64 = job_block(&macos, "build-archive")
   00062|         .lines()
   00063|         .find_map(|line| line.trim().strip_prefix("timeout-minutes:"))
   00064|         .and_then(|value| value.trim().parse().ok())
   00065|         .expect("the archive job declares a plain-number timeout-minutes");
   00066|     assert!(
   00067|         archive_cap >= 35,
   00068|         "the archive job's cap is {archive_cap}m, but issue #1055's cold \
   00069|          rebuild alone needs 35m of backstop behind it"
   00070|     );
   00071|     // Issue #1039 raised the slice cap from 15 to 25 minutes to make room for a
   00072|     // retrying artifact download. `artifact_download_retry::the_download_retry_is_bounded_to
   00073|     // _fit_the_job_cap` checks the arithmetic that justifies it, so this only
   00074|     // pins that the cap is still declared as a plain number and never falls
   00075|     // back below what that arithmetic needed.
   00076|     //
   00077|     // Issue #1081 made this a floor rather than an equality, and the cap moved
   00078|     // to 30m the same day: an equality is what stops a backstop from growing,
   00079|     // which is exactly what issue #1055 hit when the archive budget went 1200s
   00080|     // -> 1400s. The cap grew so the job's two step budgets stay under the 70%
   00081|     // share of it that `tests/unit/ci-cd/job_budget_fit.rs` enforces everywhere.
   00082|     let slice_cap: u64 = job_block(&macos, "test-archive")
   00083|         .lines()
   00084|         .find_map(|line| line.trim().strip_prefix("timeout-minutes:"))
   00085|         .and_then(|value| value.trim().parse().ok())
   00086|         .expect("the slice job declares a plain-number timeout-minutes");
   00087|     assert!(
   00088|         slice_cap >= 25,
   00089|         "the slice job's cap is {slice_cap}m, but issue #1039's download retry \
   00090|          alone needs 25m of backstop behind it"
   00091|     );
   00092|     assert!(!macos.contains("2100"));
   00093|     assert!(macos.contains("taiki-e/install-action@nextest"));
   00094|     assert!(macos.contains("scripts/run-with-budget-warning.sh"));
   00095| }
