   00008| fn repository_file(path: &str) -> String {
   00009|     fs::read_to_string(format!("{}/../{path}", env!("CARGO_MANIFEST_DIR")))
   00010|         .unwrap_or_else(|error| panic!("read {path}: {error}"))
   00011|         .replace("\r\n", "\n")
   00012| }
