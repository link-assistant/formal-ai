   00014| fn action_step<'a>(workflow: &'a str, action: &str) -> Vec<&'a str> {
   00015|     workflow
   00016|         .split("\n      - ")
   00017|         .filter(|step| step.contains(&format!("uses: {action}")))
   00018|         .collect()
   00019| }
