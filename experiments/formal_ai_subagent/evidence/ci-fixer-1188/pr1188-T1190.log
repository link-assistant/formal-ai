   00349| /// The seeded role of the words that name the line an anchor follows.
   00350| const ANCHOR_CONTEXT_CUE: &str = "file_edit_anchor_context_cue";
   00351| /// The seeded role of the words that join listed lines or clauses.
   00352| const JOINER_CUE: &str = "file_edit_joiner_cue";
   00353| 
   00354| /// The literal a seeded anchor context names, and the span naming it.
   00355| ///
   00356| /// `that follows 'z'`: `(start, end, text)`, the span from the cue through the
   00357| /// literal (the literal through the cue, in a postpositional language).
   00358| pub(super) fn anchor_context(sentence: &str) -> Option<(usize, usize, String)> {
   00359|     let contexts = cue_occurrences(sentence, ANCHOR_CONTEXT_CUE);
   00360|     if contexts.is_empty() {
   00361|         return None;
   00362|     }
   00363|     let literals = quoted_literals(sentence);
   00364|     let indices: Vec<usize> = (0..literals.len()).collect();
   00365|     let literal = &literals[governed_literal(&contexts, &literals, &indices)?];
   00366|     // The cue that governs the literal: the nearest on its language's side.
   00367|     let (cue_start, cue_end, postpositional) = contexts
   00368|         .iter()
   00369|         .copied()
   00370|         .filter_map(|cue @ (cue_start, cue_end, postpositional)| {
   00371|             let distance = if postpositional {
   00372|                 cue_start.checked_sub(literal.end)
   00373|             } else {
   00374|                 literal.start.checked_sub(cue_end)
   00375|             };
   00376|             distance.map(|distance| (distance, cue))
   00377|         })
   00378|         .min_by_key(|(distance, _)| *distance)?
   00379|         .1;
   00380|     let (start, end) = if postpositional {
   00381|         (literal.start, cue_end)
   00382|     } else {
   00383|         (cue_start, literal.end)
   00384|     };
   00385|     Some((start, end, unescape_prose_newlines(&literal.text)))
   00386| }
