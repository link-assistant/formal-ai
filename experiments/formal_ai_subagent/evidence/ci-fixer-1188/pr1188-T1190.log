   00043| /// `the heading '# Title'`: one quoted literal led only by the words that say
   00044| /// what it is stands for the literal.
   00045| fn described_literal(span: &str) -> Option<String> {
   00046|     let [segment]: [_; 1] = quoted_segment_spans(span).try_into().ok()?;
   00047|     let described = span[segment.end..].trim().is_empty()
   00048|         && span[..segment.start]
   00049|             .chars()
   00050|             .all(|character| character.is_alphabetic() || character.is_whitespace());
   00051|     described.then_some(segment.text)
   00052| }
