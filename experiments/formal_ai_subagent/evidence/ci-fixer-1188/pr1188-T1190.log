   00316| /// `text` with `indentation` before each of its non-empty lines.
   00317| ///
   00318| /// Lines given with their shared indentation removed, set as siblings of a
   00319| /// line indented by `indentation` (PR #1188 G16).
   00320| pub(super) fn rebased_block(text: &str, indentation: &str) -> String {
   00321|     text.split('\n')
   00322|         .map(|line| {
   00323|             if line.is_empty() {
   00324|                 String::new()
   00325|             } else {
   00326|                 [indentation, line].concat()
   00327|             }
   00328|         })
   00329|         .collect::<Vec<_>>()
   00330|         .join("\n")
   00331| }
