   00467| /// The request's quoted literals other than `target`, one line each.
   00468| ///
   00469| /// Only when there are several and only seeded joiners and commas separate
   00470| /// them (`Append the lines 'a', 'b' to f`, PR #1188 G54); an escape inside
   00471| /// one is content (G53).
   00472| pub(super) fn joined_literal_lines(request: &str, target: &str) -> Option<String> {
   00473|     let literals = quoted_literals(request);
   00474|     let lines: Vec<&QuotedLiteral> = literals
   00475|         .iter()
   00476|         .filter(|literal| literal.text != target)
   00477|         .collect();
   00478|     (lines.len() >= 2 && joined_only(request, &lines)).then(|| {
   00479|         lines
   00480|             .iter()
   00481|             .map(|literal| literal.text.as_str())
   00482|             .collect::<Vec<_>>()
   00483|             .join("\n")
   00484|     })
   00485| }
   00486| 
   00487| /// Whether listed literals are joined only by joiners.
   00488| ///
   00489| /// Consecutive inserted literals may be separated by nothing but whitespace,
   00490| /// commas and seeded joiners (`'a' and 'b'`).
   00491| fn joined_only(sentence: &str, literals: &[&QuotedLiteral]) -> bool {
   00492|     let joiners = bare_surfaces(JOINER_CUE);
   00493|     literals.windows(2).all(|pair| {
   00494|         sentence[pair[0].end..pair[1].start]
   00495|             .split_whitespace()
   00496|             .map(clean_cue_token)
   00497|             .all(|word| word.is_empty() || joiners.contains(&word))
   00498|     })
   00499| }
   00500| 
   00501| /// A cue's byte span in a sentence and whether its language is postpositional.
   00502| type CueOccurrence = (usize, usize, bool);
   00503| 
   00504| /// Every surface of `role` in `sentence` outside its quoted literals.
   00505| ///
   00506| /// Each comes with the side its own language's adposition governs, because
   00507| /// the side a cue governs is a fact of *its* language and a mixed prompt
   00508| /// (`config.yml में … "on:" के बाद`) cannot be trusted to detect as one
   00509| /// (`languages.lino`, `adposition`).
   00510| fn cue_occurrences(sentence: &str, role: &str) -> Vec<CueOccurrence> {
   00511|     let lowered = sentence.to_lowercase();
   00512|     // A cue word inside a quoted literal is payload ("Insert the line «… before
   00513|     // …» after …"), never the position the request asks for.
   00514|     let literals = quoted_literals(sentence);
   00515|     let inside_literal = |start: usize| {
   00516|         literals
   00517|             .iter()
   00518|             .any(|literal| start >= literal.start && start < literal.end)
   00519|     };
   00520|     let mut occurrences = Vec::new();
   00521|     for meaning in seed::lexicon().meanings_with_role(role) {
   00522|         for lexeme in &meaning.lexemes {
   00523|             let postpositional = crate::language::uses_postpositions(&lexeme.language);
   00524|             for word in &lexeme.words {
   00525|                 let surface = word.text.to_lowercase();
   00526|                 if surface.is_empty() {
   00527|                     continue;
   00528|                 }
   00529|                 occurrences.extend(
   00530|                     lowered
   00531|                         .match_indices(surface.as_str())
   00532|                         .filter(|(start, _)| !inside_literal(*start))
   00533|                         .map(|(start, matched)| (start, start + matched.len(), postpositional)),
   00534|                 );
   00535|             }
   00536|         }
   00537|     }
   00538|     occurrences
   00539| }
   00540| 
   00541| /// Which of the `candidates` (literal indices) a cue governs.
   00542| ///
   00543| /// The nearest on the side its language's adposition faces -- a preposition
   00544| /// the literal after it, a postposition the literal before it -- and a later
   00545| /// one on a tie. A cue that occurs only on the far side of every candidate
   00546| /// places none ("… renders "x" before it reads the list" is a time, not a
   00547| /// position: issue #1069); with no cue at all, the last candidate (the
   00548| /// prepositional default).
   00549| fn governed_literal(
   00550|     occurrences: &[CueOccurrence],
   00551|     literals: &[QuotedLiteral],
   00552|     candidates: &[usize],
   00553| ) -> Option<usize> {
   00554|     let gap = |literal: &QuotedLiteral| {
   00555|         occurrences
   00556|             .iter()
   00557|             // `checked_sub` is the guard as well as the arithmetic: a cue on
   00558|             // the wrong side of the literal yields `None` rather than a
   00559|             // subtraction that underflows.
   00560|             .filter_map(|&(cue_start, cue_end, postpositional)| {
   00561|                 if postpositional {
   00562|                     cue_start.checked_sub(literal.end)
   00563|                 } else {
   00564|                     literal.start.checked_sub(cue_end)
   00565|                 }
   00566|             })
   00567|             .min()
   00568|     };
   00569|     let mut governed: Option<(usize, usize)> = None;
   00570|     for &index in candidates {
   00571|         if let Some(distance) = gap(&literals[index])
   00572|             && governed.is_none_or(|(_, nearest)| distance <= nearest)
   00573|         {
   00574|             governed = Some((index, distance));
   00575|         }
   00576|     }
   00577|     governed.map(|(index, _)| index).or_else(|| {
   00578|         candidates
   00579|             .last()
   00580|             .copied()
   00581|             .filter(|_| occurrences.is_empty())
   00582|     })
   00583| }
   00584| 
   00585| /// The lines under a request whose first line ends in a colon.
   00586| pub(super) struct IntroducedBlock<'a> {
   00587|     /// The first line: the request itself.
   00588|     pub(super) head: &'a str,
   00589|     /// The lines, less their shared indentation (or verbatim).
   00590|     pub(super) text: String,
   00591|     /// A fenced block or one quoted literal, kept as written.
   00592|     pub(super) verbatim: bool,
   00593|     /// The indentation the lines shared.
   00594|     pub(super) indentation: &'a str,
   00595| }
   00596| 
   00597| /// Where the instruction of `request` ends.
   00598| ///
   00599| /// At the end of its first line when that line ends in a colon and lines
   00600| /// follow it, since those lines are the payload whatever they say (PR #1188
   00601| /// G94, G95); else at the end of the request (mirrors `instructionEnd`).
   00602| pub(super) fn instruction_end(request: &str) -> usize {
   00603|     introduced_block(request).map_or(request.len(), |block| block.head.len())
   00604| }
   00605| 
   00606| /// A request whose first line ends in a colon and is followed by lines: that
   00607| /// first line, and the lines with their shared indentation removed (one quoted
   00608| /// literal stands for itself; a fenced block keeps its own).
   00609| pub(super) fn introduced_block(request: &str) -> Option<IntroducedBlock<'_>> {
   00610|     let (head, rest) = request.split_once('\n')?;
   00611|     let head = head.trim_end();
   00612|     if !head.ends_with(':') {
   00613|         return None;
   00614|     }
   00615|     let mut lines: Vec<&str> = rest.split('\n').map(str::trim_end).collect();
   00616|     while lines.first().is_some_and(|line| line.is_empty()) {
   00617|         lines.remove(0);
   00618|     }
   00619|     while lines.last().is_some_and(|line| line.is_empty()) {
   00620|         lines.pop();
   00621|     }
   00622|     let indent_of = |line: &str| line.len() - line.trim_start().len();
   00623|     // A fenced block (```` ``` ```` lines around it) is kept as written, less
   00624|     // the fence's own indentation: its indentation is the text's.
   00625|     let fenced = lines.len() >= 2
   00626|         && lines[0].trim_start().starts_with(FENCE)
   00627|         && lines[lines.len() - 1].trim() == FENCE;
   00628|     let (body, shared) = if fenced {
   00629|         (&lines[1..lines.len() - 1], indent_of(lines[0]))
   00630|     } else {
   00631|         let shared = lines
   00632|             .iter()
   00633|             .copied()
   00634|             .filter(|line| !line.is_empty())
   00635|             .map(indent_of)
   00636|             .min()?;
   00637|         (lines.as_slice(), shared)
   00638|     };
   00639|     let text = body
   00640|         .iter()
   00641|         .copied()
   00642|         .map(|line| &line[shared.min(indent_of(line))..])
   00643|         .collect::<Vec<_>>()
   00644|         .join("\n");
   00645|     let quoted = if fenced { None } else { quoted_verbatim(&text) };
   00646|     let verbatim = fenced || quoted.is_some();
   00647|     let indentation = if fenced {
   00648|         ""
   00649|     } else {
   00650|         lines
   00651|             .iter()
   00652|             .find(|line| !line.is_empty())
   00653|             .map_or("", |line| &line[..shared])
   00654|     };
   00655|     Some(IntroducedBlock {
   00656|         head,
   00657|         text: quoted.unwrap_or(text),
   00658|         verbatim,
   00659|         indentation,
   00660|     })
   00661| }
   00662| 
   00663| /// The line that opens and closes a fenced block.
   00664| const FENCE: &str = "```";
   00665| 
   00666| /// One quoted span of a request and where it sits.
   00667| struct QuotedLiteral {
   00668|     start: usize,
   00669|     end: usize,
   00670|     text: String,
   00671| }
   00672| 
   00673| /// The delimited literal slots of `request`, verbatim: a quoted line keeps its
   00674| /// indentation. Every quote pair [`quoted_segment_spans`] reads counts —
   00675| /// `'single'` quotes included — so `Insert 'x' after the line 'y'` places the
   00676| /// line exactly as its double-quoted form does.
   00677| fn quoted_literals(request: &str) -> Vec<QuotedLiteral> {
   00678|     quoted_segment_spans(request)
   00679|         .into_iter()
   00680|         .map(|segment| QuotedLiteral {
   00681|             start: segment.start,
   00682|             end: segment.end,
   00683|             text: segment.text,
   00684|         })
   00685|         .collect()
   00686| }
   00687| 
   00688| /// A span that is one quoted literal, kept byte for byte: the author who
   00689| /// quoted `"  schedule:"` quoted its indentation on purpose (issue #1116).
   00690| fn quoted_verbatim(span: &str) -> Option<String> {
   00691|     let trimmed = span.trim().trim_start_matches([':', '-', '—', '–']).trim();
   00692|     // One quoted literal of any delimiter (single quotes included) is verbatim.
   00693|     if let [segment] = quoted_segment_spans(trimmed).as_slice()
   00694|         && segment.start == 0
   00695|         && segment.end == trimmed.len()
   00696|     {
   00697|         return Some(segment.text.clone());
   00698|     }
   00699|     let mut chars = trimmed.chars();
   00700|     let (first, last) = (chars.next()?, chars.next_back()?);
   00701|     (first == last && matches!(first, '"' | '`') && trimmed.len() >= 2)
   00702|         .then(|| trimmed[1..trimmed.len() - 1].to_owned())
   00703|         .filter(|inner| !inner.contains(first))
   00704| }
   00705| 
   00706| /// The request's tokens outside every quoted literal; a literal that is
   00707| /// exactly one path still names the file (mirrors `unquotedPathTokens`).
   00708| pub(super) fn unquoted_path_tokens(request: &str) -> Vec<super::write_request::Token<'_>> {
   00709|     let segments = quoted_segment_spans(request);
   00710|     tokens(request)
   00711|         .into_iter()
   00712|         .filter(|token| {
   00713|             !segments.iter().any(|segment| {
   00714|                 token.start >= segment.start
   00715|                     && token.end <= segment.end
   00716|                     && clean_path_token(token.text) != segment.text
   00717|             })
   00718|         })
   00719|         .collect()
   00720| }
   00721| 
   00722| /// The words a request says itself.
   00723| ///
   00724| /// The head of an edit request whose lines follow it (the lines are its
   00725| /// payload); otherwise the whole request.
   00726| pub(super) fn own_text(request: &str) -> &str {
   00727|     match introduced_block(request) {
   00728|         Some(block) if names_local_edit(block.head) => block.head,
   00729|         _ => request,
   00730|     }
   00731| }
   00732| 
   00733| /// Whether `task` is an instruction to change a named local file: an edit or
   00734| /// insert action beside a workspace path. Such a request is never a web
   00735| /// question, whatever else the router makes of it (issues #1115, #1133).
   00736| #[must_use]
   00737| pub(super) fn names_local_edit(task: &str) -> bool {
   00738|     let lexicon = seed::lexicon();
   00739|     let normalized = crate::engine::normalize_prompt(task);
   00740|     let edits = lexicon.mentions_role(seed::ROLE_FILE_EDIT_ACTION_CUE, &normalized)
   00741|         || lexicon.mentions_role(seed::ROLE_CODING_MEMBER_ADD_ACTION, &normalized);
   00742|     edits && local_edit_path(task).is_some()
   00743| }
   00744| 
   00745| /// The first workspace path the request names.
   00746| fn local_edit_path(task: &str) -> Option<String> {
   00747|     tokens(task).iter().find_map(|token| {
   00748|         let candidate = clean_path_token(token.text);
   00749|         (looks_like_file_path(candidate) && safe_relative_path(candidate))
   00750|             .then(|| candidate.to_owned())
   00751|     })
   00752| }
   00753| 
   00754| /// The file a request leading with the add verb names when it quotes no text.
   00755| ///
   00756| /// "add hello to config.txt" (PR #1188 G69): its words may be the text or
   00757| /// describe it, so the request earns a question, never a write. In "Create a
   00758| /// test for add in t.mjs" `add` is a name, not the action.
   00759| pub(super) fn unquoted_addition_path(task: &str) -> Option<String> {
   00760|     if !quoted_segment_spans(task).is_empty() {
   00761|         return None;
   00762|     }
   00763|     let normalized = crate::engine::normalize_prompt(task);
   00764|     let lead = normalized.split(' ').next().unwrap_or_default();
   00765|     if !seed::lexicon().mentions_role(seed::ROLE_CODING_MEMBER_ADD_ACTION, lead) {
   00766|         return None;
   00767|     }
   00768|     local_edit_path(task)
   00769| }
   00770| 
   00771| /// A newline an author spelled as `\n` inside prose means a newline in the
   00772| /// file (issue #1116); the edit tool would otherwise write the two characters.
   00773| pub(super) fn unescape_prose_newlines(text: &str) -> String {
   00774|     text.replace("\\n", "\n").replace("\\t", "\t")
   00775| }
   00776| 
   00777| /// One insert as `(start, old, new)` over `source`.
   00778| ///
   00779| /// `old` is the whole lines from the anchor context (or the anchor) through
   00780| /// the anchor, `new` those lines with the inserted text beside the anchor's
   00781| /// line; `None` unless the context (with none, the anchor) occurs once and the
   00782| /// anchor occurs after it.
   00783| fn insert_edit(source: &str, given: &PositionalInsert) -> Option<(usize, String, String, String)> {
   00784|     let resolved = if given.spans {
   00785|         Some(unquoted_anchor::resolved_spans(source, given)?)
   00786|     } else {
   00787|         unquoted_anchor::written_escapes(source, given)
   00788|     };
   00789|     let insert = resolved.as_ref().unwrap_or(given);
   00790|     let anchor = insert.anchor.as_str();
   00791|     let lead = insert.context.as_deref().unwrap_or(anchor);
   00792|     let mut leads: Vec<usize> = source.match_indices(lead).map(|(at, _)| at).collect();
   00793|     // A lead found inside other lines too names the one line it is by itself.
   00794|     if leads.len() > 1 {
   00795|         leads = lone_line_occurrences(source, lead);
   00796|     }
   00797|     let [lead_at]: [usize; 1] = leads.try_into().ok()?;
   00798|     if anchor.is_empty() {
   00799|         return None;
   00800|     }
   00801|     // After a context, a line that is exactly the anchor outranks one that only
   00802|     // contains it (`text set` is not `text setting`).
   00803|     let at = if insert.context.is_some() {
   00804|         let from = lead_at + lead.len();
   00805|         let whole = |index: usize| {
   00806|             (index == 0 || source.as_bytes()[index - 1] == b'\n')
   00807|                 && (anchor.ends_with('\n')
   00808|                     || source
   00809|                         .as_bytes()
   00810|                         .get(index + anchor.len())
   00811|                         .is_none_or(|byte| *byte == b'\n'))
   00812|         };
   00813|         let found: Vec<usize> = source[from..]
   00814|             .match_indices(anchor)
   00815|             .map(|(index, _)| from + index)
   00816|             .collect();
   00817|         found
   00818|             .iter()
   00819|             .copied()
   00820|             .find(|index| whole(*index))
   00821|             .or_else(|| found.first().copied())?
   00822|     } else {
   00823|         lead_at
   00824|     };
   00825|     let line_start = |index: usize| source[..index].rfind('\n').map_or(0, |newline| newline + 1);
   00826|     let start = line_start(lead_at);
   00827|     let tail = at + anchor.len();
   00828|     let end = if anchor.ends_with('\n') {
   00829|         tail - 1
   00830|     } else {
   00831|         source[tail..]
   00832|             .find('\n')
   00833|             .map_or(source.len(), |newline| tail + newline)
   00834|     };
   00835|     let old = &source[start..end];
   00836|     let anchor_line = line_start(at);
   00837|     let inserted = inserted_text(source, anchor_line, insert);
   00838|     let new = if insert.after {
   00839|         [old, "\n", inserted.as_str()].concat()
   00840|     } else {
   00841|         [
   00842|             &source[start..anchor_line],
   00843|             inserted.as_str(),
   00844|             "\n",
   00845|             &source[anchor_line..end],
   00846|         ]
   00847|         .concat()
   00848|     };
   00849|     // The edit tool needs its old text once in the file: a line that also ends
   00850|     // another line (`];`) is widened back over the lines before it (PR #1188 G73).
   00851|     let from = unique_from(source, start, end)?;
   00852|     Some((
   00853|         from,
   00854|         source[from..end].to_owned(),
   00855|         [&source[from..start], new.as_str()].concat(),
   00856|         inserted,
   00857|     ))
   00858| }
   00859| 
   00860| /// Where `text` occurs in `source` as a whole line but for its indentation.
   00861| ///
   00862| /// `the line 'b'` is the line `b`, not the `b` inside `table a`.
   00863| fn lone_line_occurrences(source: &str, text: &str) -> Vec<usize> {
   00864|     source
   00865|         .match_indices(text)
   00866|         .map(|(index, _)| index)
   00867|         .filter(|&index| {
   00868|             let line_start = source[..index].rfind('\n').map_or(0, |newline| newline + 1);
   00869|             let tail = index + text.len();
   00870|             let line_end = source[tail..]
   00871|                 .find('\n')
   00872|                 .map_or(source.len(), |newline| tail + newline);
   00873|             source[line_start..index].trim().is_empty()
   00874|                 && (text.ends_with('\n') || source[tail..line_end].trim().is_empty())
   00875|         })
   00876|         .collect()
   00877| }
   00878| 
   00879| /// The lines an insert puts beside the anchor's line.
   00880| ///
   00881| /// An unfenced block keeps the indentation it was given when the file already
   00882| /// indents lines so (G93, as appended lines do); otherwise it is rebased on
   00883| /// the anchor line's indentation, so it lands as its siblings (PR #1188 G16).
   00884| fn inserted_text(source: &str, anchor_line: usize, insert: &PositionalInsert) -> String {
   00885|     let Some(given) = insert.rebase.as_deref() else {
   00886|         return insert.inserted.clone();
   00887|     };
   00888|     if indents_lines_at(source, given) {
   00889|         return rebased_block(&insert.inserted, given);
   00890|     }
   00891|     let line_end = source[anchor_line..]
   00892|         .find('\n')
   00893|         .map_or(source.len(), |newline| anchor_line + newline);
   00894|     rebased_block(
   00895|         &insert.inserted,
   00896|         leading_indentation(&source[anchor_line..line_end]),
   00897|     )
   00898| }
   00899| 
   00900| /// The sentence stating an insert; an empty line is stated in its own words.
   00901| pub(super) const fn insert_intent(after: bool, inserted: &str) -> &'static str {
   00902|     if inserted.is_empty() {
   00903|         BLANK_LINE
   00904|     } else if after {
   00905|         "file_edit_position_after"
   00906|     } else {
   00907|         "file_edit_position_before"
   00908|     }
   00909| }
   00910| 
   00911| /// Make a request's inserts one anchored edit at a time.
   00912| ///
   00913| /// Each file is read once; each insert is its own anchored edit over the file
   00914| /// as the earlier inserts left it; then every file's digest is checked and
   00915| /// every insert stated.
   00916| pub(super) fn plan_insert_sequence_step(
   00917|     task: &str,
   00918|     current_turn: &[ChatMessage],
   00919|     tool_names: &[&str],
   00920|     inserts: &[PositionalInsert],
   00921| ) -> Option<AgenticPlan> {
   00922|     let edit_tool = tool_for(tool_names, Capability::Edit)?;
   00923|     let mut expected: Vec<(&str, String)> = Vec::new();
   00924|     let mut stated = Vec::new();
   00925|     for insert in inserts {
   00926|         let target = insert.target.as_str();
   00927|         if !expected.iter().any(|(path, _)| *path == target) {
   00928|             let Some(read) = result_for_path(current_turn, Capability::Read, target, None) else {
   00929|                 let tool = tool_for(tool_names, Capability::Read)?;
   00930|                 return Some(plan_one(tool, read_arguments(target)));
   00931|             };
   00932|             expected.push((target, source_from_read_result(&read)));
   00933|         }
   00934|         let index = expected.iter().position(|(path, _)| *path == target)?;
   00935|         let source = expected[index].1.as_str();
   00936|         let Some((start, lines, widened, inserted)) = insert_edit(source, insert) else {
   00937|             // An anchor line found more than once names no one place: the
   00938|             // answer says so instead of a failed verification (PR #1188 G72).
   00939|             if let Some(occurrences) = repeated_anchor_count(source, insert) {
   00940|                 let lead = insert.context.as_deref().unwrap_or(&insert.anchor);
   00941|                 return render_seeded_change(
   00942|                     "file_edit_anchor_repeated",
   00943|                     task,
   00944|                     target,
   00945|                     &[
   00946|                         ("{anchor}", lead.trim_end_matches('\n')),
   00947|                         (COUNT_SLOT, &occurrences.to_string()),
   00948|                     ],
   00949|                 )
   00950|                 .map(AgenticPlan::Final);
   00951|             }
   00952|             return Some(AgenticPlan::Final(render_seeded_outcome(
   00953|                 "coding_workspace_verification_failed",
   00954|                 task,
   00955|                 target,
   00956|             )?));
   00957|         };
   00958|         if result_for_edit(current_turn, target, &lines, &widened).is_none() {
   00959|             return Some(plan_one(
   00960|                 edit_tool,
   00961|                 edit_arguments(target, &lines, &widened),
   00962|             ));
   00963|         }
   00964|         let updated = [
   00965|             &source[..start],
   00966|             widened.as_str(),
   00967|             &source[start + lines.len()..],
   00968|         ]
   00969|         .concat();
   00970|         expected[index].1 = updated;
