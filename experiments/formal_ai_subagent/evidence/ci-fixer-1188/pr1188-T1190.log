   00388| /// The request cut into insert clauses.
   00389| ///
   00390| /// A cut falls before every repeated add action that a seeded joiner or a
   00391| /// clause mark leads -- after it, in a postpositional language, whose verb
   00392| /// closes its clause.
   00393| fn insert_clauses(request: &str) -> Vec<&str> {
   00394|     let segments = quoted_segment_spans(request);
   00395|     let toks = tokens(request);
   00396|     let quoted = |token: &super::write_request::Token<'_>| {
   00397|         segments
   00398|             .iter()
   00399|             .any(|segment| token.start < segment.end && token.end > segment.start)
   00400|     };
   00401|     let joiners = bare_surfaces(JOINER_CUE);
   00402|     let joins = |token: Option<&super::write_request::Token<'_>>| {
   00403|         token.is_some_and(|token| !quoted(token) && joiners.contains(&clean_cue_token(token.text)))
   00404|     };
   00405|     let closes =
   00406|         |token: &super::write_request::Token<'_>| token.text.ends_with([',', ';', '\u{0964}']);
   00407|     let mut actions: Vec<(String, bool)> = Vec::new();
   00408|     for meaning in seed::lexicon().meanings_with_role(seed::ROLE_CODING_MEMBER_ADD_ACTION) {
   00409|         for lexeme in &meaning.lexemes {
   00410|             let postpositional = crate::language::uses_postpositions(&lexeme.language);
   00411|             for word in &lexeme.words {
   00412|                 actions.push((word.text.to_lowercase(), postpositional));
   00413|             }
   00414|         }
   00415|     }
   00416|     // Only a repeated action opens a clause: the first one (the last, where the
   00417|     // verb closes its clause) belongs to the clause before it.
   00418|     let verbs: Vec<(usize, bool)> = toks
   00419|         .iter()
   00420|         .enumerate()
   00421|         .filter(|(_, token)| !quoted(token))
   00422|         .filter_map(|(index, token)| {
   00423|             let cleaned = clean_cue_token(token.text);
   00424|             actions
   00425|                 .iter()
   00426|                 .rev()
   00427|                 .find(|(surface, _)| *surface == cleaned)
   00428|                 .map(|&(_, postpositional)| (index, postpositional))
   00429|         })
   00430|         .collect();
   00431|     let mut cuts: Vec<(usize, usize)> = Vec::new();
   00432|     for (at, &(index, postpositional)) in verbs.iter().enumerate() {
   00433|         let token = &toks[index];
   00434|         if !postpositional && at > 0 {
   00435|             let previous = &toks[index - 1];
   00436|             if joins(Some(previous)) {
   00437|                 cuts.push((previous.start, previous.end));
   00438|             } else if closes(previous) {
   00439|                 cuts.push((token.start, token.start));
   00440|             }
   00441|         } else if postpositional && at + 1 < verbs.len() {
   00442|             if joins(toks.get(index + 1)) {
   00443|                 cuts.push((toks[index + 1].start, toks[index + 1].end));
   00444|             } else if closes(token) {
   00445|                 cuts.push((token.end, token.end));
   00446|             }
   00447|         }
   00448|     }
   00449|     let mut clauses = Vec::new();
   00450|     let mut from = 0;
   00451|     for (start, end) in cuts {
   00452|         // Two verbs may claim one joiner; the second claim is already made.
   00453|         if start < from {
   00454|             continue;
   00455|         }
   00456|         clauses.push(&request[from..start]);
   00457|         from = end;
   00458|     }
   00459|     clauses.push(&request[from..]);
   00460|     clauses
   00461|         .into_iter()
   00462|         .map(str::trim)
   00463|         .filter(|clause| !clause.is_empty())
   00464|         .collect()
   00465| }
