   00290| /// The workspace paths `sentence` names, in order.
   00291| ///
   00292| /// Those it leaves unquoted, or, when it leaves none, the quoted literals that
   00293| /// are exactly one path. In `Insert the line 'foo' after the line
   00294| /// 'js/ocr.bundle.js' in paths.txt.` the quoted path is the anchor and
   00295| /// `paths.txt` the file (PR #1188 G21).
   00296| fn named_paths(sentence: &str) -> Vec<&str> {
   00297|     let segments = quoted_segment_spans(sentence);
   00298|     let paths: Vec<(bool, &str)> = unquoted_path_tokens(sentence)
   00299|         .iter()
   00300|         .map(|token| {
   00301|             let quoted = segments
   00302|                 .iter()
   00303|                 .any(|segment| token.start < segment.end && token.end > segment.start);
   00304|             (quoted, clean_path_token(token.text))
   00305|         })
   00306|         .filter(|(_, path)| looks_like_file_path(path) && safe_relative_path(path))
   00307|         .collect();
   00308|     let bare = paths.iter().any(|(quoted, _)| !quoted);
   00309|     paths
   00310|         .into_iter()
   00311|         .filter(|(quoted, _)| !bare || !quoted)
   00312|         .map(|(_, path)| path)
   00313|         .collect()
   00314| }
