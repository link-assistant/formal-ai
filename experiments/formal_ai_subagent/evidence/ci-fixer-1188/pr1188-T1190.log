   00338| /// Whether `source` has a non-blank line indented by exactly `indentation`.
   00339| ///
   00340| /// Never for the empty indentation: lines given flush left say nothing about
   00341| /// where they belong (PR #1188 G16, G93).
   00342| pub(super) fn indents_lines_at(source: &str, indentation: &str) -> bool {
   00343|     !indentation.is_empty()
   00344|         && source
   00345|             .split('\n')
   00346|             .any(|line| !line.trim().is_empty() && leading_indentation(line) == indentation)
