   00054| /// An additive edit as `(target, anchor, replacement)`.
   00055| ///
   00056| /// "add a line X directly after the line Y in F", "insert X before Y in F"
   00057| /// (issue #1115). The anchor line is the text replaced, and the replacement is
   00058| /// the anchor with the new line beside it, so the edit tool's exact-match
   00059| /// contract holds without a separate insert primitive. Only one insert in one
   00060| /// clause, at an anchor named by itself, composes this way.
   00061| pub(super) fn compose_positional_insert(request: &str) -> Option<(String, String, String)> {
   00062|     let inserts = positional_inserts(request)?;
   00063|     let [insert]: [PositionalInsert; 1] = inserts.try_into().ok()?;
   00064|     if insert.context.is_some() {
   00065|         return None;
   00066|     }
   00067|     let new = if insert.after {
   00068|         [insert.anchor.as_str(), insert.inserted.as_str()].join("\n")
   00069|     } else {
   00070|         [insert.inserted.as_str(), insert.anchor.as_str()].join("\n")
   00071|     };
   00072|     Some((insert.target, insert.anchor, new))
   00073| }
