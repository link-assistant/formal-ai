   00034| /// The bytes a quoted or clause-led span of edit prose stands for.
   00035| pub(super) fn literal_text(span: &str) -> Option<String> {
   00036|     quoted_verbatim(span)
   00037|         .or_else(|| insert_lines::listed_lines(span))
   00038|         .or_else(|| described_literal(span))
   00039|         .or_else(|| clean_content(span))
   00040|         .map(|text| unescape_prose_newlines(&text))
   00041| }
