   00140| /// One clause's insert, with its target apart.
   00141| ///
   00142| /// The target is `None` when the clause names no file. The anchor is the
   00143| /// literal the position cue governs; a seeded anchor context (`the line 'y'
   00144| /// that follows 'z'`) names a literal the anchor comes after; every other
   00145| /// literal is a line inserted, in order, and those lines may be separated only
   00146| /// by seeded joiners and commas.
   00147| fn clause_insert(
   00148|     sentence: &str,
   00149|     block_text: Option<&str>,
   00150| ) -> Option<(Option<String>, PositionalInsert)> {
   00151|     let lexicon = seed::lexicon();
   00152|     let normalized = crate::engine::normalize_prompt(sentence);
   00153|     // The position is the request's, not the payload's: a cue inside a quoted
   00154|     // literal ("Insert the line «… before …» after …") is text being inserted.
   00155|     let outside = crate::engine::normalize_prompt(
   00156|         &quoted_segment_spans(sentence)
   00157|             .iter()
   00158|             .rev()
   00159|             .fold(sentence.to_owned(), |text, segment| {
   00160|                 [&text[..segment.start], " ", &text[segment.end..]].concat()
   00161|             }),
   00162|     );
   00163|     let after = lexicon.mentions_role(seed::ROLE_FILE_EDIT_POSITION_AFTER, &outside);
   00164|     let before = lexicon.mentions_role(seed::ROLE_FILE_EDIT_POSITION_BEFORE, &outside);
   00165|     if after == before || !lexicon.mentions_role(seed::ROLE_CODING_MEMBER_ADD_ACTION, &normalized) {
   00166|         return None;
   00167|     }
   00168|     let target = named_paths(sentence).first().map(|path| (*path).to_owned());
   00169|     let literals: Vec<QuotedLiteral> = quoted_literals(sentence)
   00170|         .into_iter()
   00171|         .filter(|literal| target.as_deref() != Some(literal.text.as_str()))
   00172|         .collect();
   00173|     let contexts = cue_occurrences(sentence, ANCHOR_CONTEXT_CUE);
   00174|     let role = if after {
   00175|         seed::ROLE_FILE_EDIT_POSITION_AFTER
   00176|     } else {
   00177|         seed::ROLE_FILE_EDIT_POSITION_BEFORE
   00178|     };
   00179|     // A position word inside the context cue ("के बाद आने वाली") is the
   00180|     // context's, not the anchor's.
   00181|     let positions: Vec<CueOccurrence> = cue_occurrences(sentence, role)
   00182|         .into_iter()
   00183|         .filter(|&(start, _, _)| {
   00184|             !contexts
   00185|                 .iter()
   00186|                 .any(|&(from, to, _)| start >= from && start < to)
   00187|         })
   00188|         .collect();
   00189|     // One literal is the anchor: `the following lines` speaks of the block
   00190|     // (PR #1188 G16). Without a block, the seeded blank line is the line
   00191|     // inserted beside it (G31). With a block and a seeded anchor context, a
   00192|     // second literal is the line the anchor follows (G51).
