   00194|         block_text.is_none()
   00195|             && literals.len() == 1
   00196|             && contexts.is_empty()
   00197|             && lexicon.mentions_role(BLANK_LINE, &outside);
   00198|     if let Some(text) = block_text
   00199|         && literals.is_empty()
   00200|     {
   00201|         return unquoted_anchor::unquoted_anchor_insert(
   00202|             sentence, &positions, &contexts, target, text, after,
   00203|         );
   00204|     }
   00205|     if let Some(text) = block_text.or_else(|| blank.then_some("")) {
   00206|         let (anchor_at, context_at) = match (literals.len(), contexts.is_empty()) {
   00207|             // A context cue then names no second line: `the following lines`
   00208|             // speaks of the block (G16).
   00209|             (1, _) => (0, None),
   00210|             (2, false) if block_text.is_some() => {
   00211|                 let anchor_at = governed_literal(&positions, &literals, &[0, 1])?;
   00212|                 let context_at = governed_literal(&contexts, &literals, &[1 - anchor_at])?;
   00213|                 (anchor_at, Some(context_at))
   00214|             }
   00215|             _ => return None,
   00216|         };
   00217|         let insert = PositionalInsert {
   00218|             target: String::new(),
   00219|             anchor: unescape_prose_newlines(&literals[anchor_at].text),
   00220|             inserted: text.to_owned(),
   00221|             after,
   00222|             context: context_at.map(|index| unescape_prose_newlines(&literals[index].text)),
   00223|             rebase: None,
   00224|             spans: false,
   00225|         };
   00226|         return Some((target, insert));
   00227|     }
   00228|     if literals.len() < 2 {
   00229|         return None;
   00230|     }
   00231|     let indices: Vec<usize> = (0..literals.len()).collect();
   00232|     let anchor_at = governed_literal(&positions, &literals, &indices)?;
   00233|     let context_at = if contexts.is_empty() {
   00234|         None
   00235|     } else {
   00236|         let rest: Vec<usize> = indices
   00237|             .into_iter()
   00238|             .filter(|index| *index != anchor_at)
   00239|             .collect();
