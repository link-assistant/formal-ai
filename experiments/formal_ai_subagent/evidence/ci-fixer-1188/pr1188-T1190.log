   00267|         .into_iter()
   00268|         .map(|(start, _, _)| start)
   00269|         .min();
   00270|     let inserted = match first_blank {
   00271|         None => lines,
   00272|         Some(blank) if blank < inserted[0].start => ["\n", lines.as_str()].concat(),
   00273|         Some(_) => [lines.as_str(), "\n"].concat(),
   00274|     };
   00275|     let insert = PositionalInsert {
   00276|         target: String::new(),
   00277|         anchor: unescape_prose_newlines(&literals[anchor_at].text),
   00278|         inserted,
   00279|         after,
   00280|         context: context_at.map(|index| unescape_prose_newlines(&literals[index].text)),
   00281|         rebase: None,
   00282|         spans: false,
   00283|     };
