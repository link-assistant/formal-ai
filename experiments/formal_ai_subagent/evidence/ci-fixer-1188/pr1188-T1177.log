   00078| #[test]
   00079| fn numbered_lines_are_removed() {
   00080|     let range = drive("Delete lines 2-3 from f.txt.", SIX, "f.txt");
   00081|     assert_eq!(range.tools, ["read", "edit", "bash"]);
   00082|     assert_eq!(range.file, "one\nfour\nfive\nsix\n");
   00083|     assert_eq!(
   00084|         range.answer.as_deref(),
   00085|         Some("Deleted line(s) 2-3 of `f.txt` and observed the result.")
   00086|     );
   00087|     assert_eq!(
   00088|         drive("Delete lines 2 to 3 from f.txt.", SIX, "f.txt").file,
   00089|         "one\nfour\nfive\nsix\n"
   00090|     );
   00091|     assert_eq!(
   00092|         drive(
   00093|             "Remove line 6 from f.txt.",
   00094|             "one\ntwo\nthree\nfour\nfive\nsix",
   00095|             "f.txt"
   00096|         )
   00097|         .file,
   00098|         "one\ntwo\nthree\nfour\nfive"
   00099|     );
   00100| }
