   00331| async function liveWiktionaryTranslate(surface, source, target) {
   00332|   // Run the direct page fetch and the OpenSearch lemma resolution in
   00333|   // parallel. For inflected forms (e.g. `помидоры`) the direct fetch
   00334|   // 404s, and chaining the lemma lookup sequentially after it added a
   00335|   // third sequential round-trip that pushed CI past the 5s expect cap.
   00336|   const [direct, lemma] = await Promise.all([
   00337|     fetchWiktionaryWikitext(surface, source),
   00338|     resolveWiktionaryLemma(surface, source),
   00339|   ]);
   00340|   let main = direct;
   00341|   if (!main && lemma) {
   00342|     main = await fetchWiktionaryWikitext(lemma, source);
   00343|   }
   00344|   if (!main) return null;
   00345|   let wikitext = main;
   00346|   if (/\{\{see translation subpage\|/i.test(main)) {
   00347|     const subpage = await fetchWiktionaryWikitext(`${surface}/translations`, source);
   00348|     if (subpage) wikitext = `${subpage}\n${main}`;
   00349|   }
   00350|   return roundTripSurface(surface, source, target, extractWiktionaryCandidates(wikitext, target));
   00351| }
