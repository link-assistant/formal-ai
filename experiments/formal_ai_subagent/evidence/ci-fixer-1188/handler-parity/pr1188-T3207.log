   00863| // Issue #529: natural-language *writes* to the entire associative memory. This
   00864| // is the browser mirror of src/solver_handlers/conversation_memory/memory_write.rs
   00865| // — the write half of the Turing-complete memory primitive (a recall reads, an
   00866| // append extends, a substitution rewrites). Both recognisers are driven by the
   00867| // seed lexicon (ROLE_MEMORY_*), so they extend to every supported language
   00868| // automatically. The actual persistence happens in the app (main.jsx applies the
   00869| // returned memoryOperation to IndexedDB); the worker stays pure by computing the
   00870| // substitution count over a memory snapshot the app passes in.
   00871| 
   00872| // Recognise a "remember …" append directive in any language. The surfaces are
   00873| // Slot::Prefix forms (trailing …), so each form's literal-before-the-slot is the
   00874| // matchable prefix. Matching runs on a lowercased copy of the raw prompt and
   00875| // longer prefixes win first, so "remember that X" beats "remember X". Mirrors
   00876| // recognize_memory_append.
   00877| function recognizeMemoryAppend(prompt) {
   00878|   const trimmed = String(prompt || "").replace(/^\s+/, "");
   00879|   const lowered = trimmed.toLowerCase();
   00880|   const prefixes = roleWordForms(ROLE_MEMORY_APPEND_DIRECTIVE)
   00881|     .filter((form) => form.slot === "prefix")
   00882|     .map((form) => form.before)
   00883|     .filter((prefix) => prefix.length > 0);
   00884|   prefixes.sort((a, b) => b.length - a.length);
   00885|   for (const prefix of prefixes) {
   00886|     if (lowered.startsWith(prefix)) {
   00887|       const statement = cleanMemoryWriteText(trimmed.slice(prefix.length));
   00888|       if (statement) return statement;
   00889|     }
   00890|   }
   00891|   return null;
   00892| }
