   00258| function stripCombiningMarks(value) {
   00259|   // Russian Wiktionary entries are stored with combining stress marks
   00260|   // (U+0301) so readers can see where the accent falls. The surface
   00261|   // form must drop them so the result matches the lemma (помидо́р →
   00262|   // помидор) and downstream substring assertions still hit.
   00263|   return typeof value === "string" && value.normalize
   00264|     ? value.normalize("NFD").replace(/[̀-ͯ]/g, "").normalize("NFC")
   00265|     : value;
   00266| }
