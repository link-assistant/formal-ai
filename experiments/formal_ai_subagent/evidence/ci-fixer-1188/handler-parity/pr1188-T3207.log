   00894| // Recognise a memory substitution (a read+write transform) in any language. A
   00895| // bare "replace X with Y" is an ordinary coding request, so a memory *scope*
   00896| // phrase must be present to claim the prompt. We then strip the scope and the
   00897| // substitution directive (position-independent: SVO languages lead, Hindi
   00898| // trails) and split the operand span on the connector to recover (old, new).
   00899| // Mirrors recognize_memory_substitution.
   00900| function recognizeMemorySubstitution(normalized) {
   00901|   if (!lexiconMentionsRole(ROLE_MEMORY_SCOPE, normalized)) return null;
   00902|   const withoutScope = stripFirstMemorySurface(normalized, ROLE_MEMORY_SCOPE);
   00903|   if (withoutScope === null) return null;
   00904|   const operands = stripFirstMemorySurface(
   00905|     withoutScope,
   00906|     ROLE_MEMORY_SUBSTITUTION_DIRECTIVE,
   00907|   );
   00908|   if (operands === null) return null;
   00909|   const split = splitOnceMemorySurface(
   00910|     operands,
   00911|     ROLE_MEMORY_SUBSTITUTION_CONNECTOR,
   00912|   );
   00913|   if (!split) return null;
   00914|   const oldValue = cleanMemoryWriteText(split[0]);
   00915|   const newValue = cleanMemoryWriteText(split[1]);
   00916|   if (!oldValue || !newValue) return null;
   00917|   return { oldValue, newValue };
   00918| }
   00919| 
   00920| // Total substring occurrences of `old` across every searchable value in the
   00921| // memory snapshot. Mirrors MemoryStore::apply_substitution's count, which sums
   00922| // replace_counting over each event's content/inputs/outputs/title/label and
   00923| // every evidence entry. The app builds the snapshot from those same fields, so
   00924| // the worker's reported count matches the rewrite the app applies to IndexedDB.
   00925| function countMemoryOccurrences(memory, old) {
   00926|   if (!old) return 0;
   00927|   const values = Array.isArray(memory) ? memory : [];
   00928|   let count = 0;
   00929|   for (const value of values) {
   00930|     const text = String(value || "");
   00931|     if (!text.includes(old)) continue;
   00932|     count += text.split(old).length - 1;
   00933|   }
   00934|   return count;
   00935| }
   00936| 
   00937| function renderMemoryAppendAnswer(statement, language) {
   00938|   if (language === "ru") return `Запомнил: ${statement}`;
   00939|   if (language === "zh") return `已记住:${statement}`;
   00940|   if (language === "hi") return `स्मृति में सहेजा गया: ${statement}`;
   00941|   return `Recorded memory: ${statement}`;
   00942| }
   00943| 
   00944| function renderMemorySubstitutionAnswer(oldValue, newValue, applied, language) {
   00945|   if (language === "ru") {
   00946|     return `Заменил "${oldValue}" на "${newValue}" в памяти (обновлено вхождений: ${applied}).`;
   00947|   }
   00948|   if (language === "zh") {
   00949|     return `已在记忆中将"${oldValue}"替换为"${newValue}"(更新 ${applied} 处)。`;
   00950|   }
   00951|   if (language === "hi") {
   00952|     return `स्मृति में "${oldValue}" को "${newValue}" से बदला (${applied})।`;
   00953|   }
   00954|   return `Replaced "${oldValue}" with "${newValue}" in memory (${applied} occurrence(s) updated).`;
   00955| }
   00956| 
   00957| // Recognise a natural-language memory write and return an answer carrying a
   00958| // structured `memoryOperation` for the app to persist. Substitution is tried
   00959| // before append because a substitution prompt also begins with a directive verb.
   00960| // Mirrors try_memory_write + recognize_memory_write.
   00961| function tryMemoryWrite(prompt, normalized, memory) {
   00962|   const substitution = recognizeMemorySubstitution(normalized);
   00963|   if (substitution) {
   00964|     const language = detectLanguage(prompt);
   00965|     const applied = countMemoryOccurrences(memory, substitution.oldValue);
   00966|     return {
   00967|       intent: "memory_substitution",
   00968|       content: renderMemorySubstitutionAnswer(
   00969|         substitution.oldValue,
   00970|         substitution.newValue,
   00971|         applied,
   00972|         language,
   00973|       ),
   00974|       confidence: 0.9,
   00975|       evidence: [
   00976|         "memory_substitution",
   00977|         "substitution_event:update",
   00978|         `substitution:applied=${applied}`,
   00979|         "response:memory_substitution",
   00980|       ],
   00981|       memoryOperation: {
   00982|         action: "substitute",
   00983|         oldValue: substitution.oldValue,
   00984|         newValue: substitution.newValue,
   00985|         applied,
   00986|       },
   00987|     };
   00988|   }
   00989|   const statement = recognizeMemoryAppend(prompt);
   00990|   if (statement) {
   00991|     const language = detectLanguage(prompt);
   00992|     return {
   00993|       intent: "memory_write",
   00994|       content: renderMemoryAppendAnswer(statement, language),
   00995|       confidence: 0.9,
   00996|       evidence: [
   00997|         "memory_write",
   00998|         "memory_write:natural_language",
   00999|         "response:memory_write",
   01000|       ],
   01001|       memoryOperation: { action: "append", statement },
   01002|     };
   01003|   }
   01004|   return null;
   01005| }
   01006| 
   01007| // Issue #27: deterministic, logical summarisation — no neural net. We
   01008| // project the conversation onto a small set of features (turn counts, intents,
   01009| // concepts, languages, unanswered questions) and render them as a structured
   01010| // Markdown report. Every value is derived directly from the append-only event
   01011| // log so reruns on the same input produce byte-identical output.
   01012| function trySummarizeConversation(history) {
   01013|   if (!Array.isArray(history) || history.length === 0) return null;
   01014|   const turns = history.filter((turn) => turn && turn.content);
   01015|   if (turns.length === 0) return null;
   01016| 
   01017|   let userCount = 0;
   01018|   let assistantCount = 0;
   01019|   const intentCounts = new Map();
   01020|   const languages = new Map();
   01021|   const concepts = new Set();
   01022|   const calculations = [];
   01023|   const programTemplates = new Set();
   01024|   const unanswered = [];
   01025|   let lastUser = null;
   01026| 
   01027|   for (const turn of turns) {
   01028|     const role = turn.role || "assistant";
   01029|     const language = detectLanguage(turn.content);
   01030|     languages.set(language, (languages.get(language) || 0) + 1);
   01031|     if (role === "user") {
   01032|       userCount += 1;
   01033|       lastUser = turn.content;
   01034|     } else {
   01035|       assistantCount += 1;
   01036|       if (lastUser) {
   01037|         lastUser = null;
   01038|       }
   01039|       const intent = String(turn.intent || "unknown");
   01040|       intentCounts.set(intent, (intentCounts.get(intent) || 0) + 1);
   01041|       if (intent === "calculation" && typeof turn.content === "string") {
   01042|         const match = turn.content.match(/^([^=]+=\s*[^\n]+)/);
   01043|         if (match) calculations.push(match[1].trim());
   01044|       }
   01045|       if (intent === "write_program") {
   01046|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01047|         const languageEvidence = evidence.find((item) =>
   01048|           String(item || "").startsWith("program_parameter:language:"),
   01049|         );
   01050|         const taskEvidence = evidence.find((item) =>
   01051|           String(item || "").startsWith("program_parameter:task:"),
   01052|         );
   01053|         const generatedLanguage = languageEvidence
   01054|           ? String(languageEvidence).slice("program_parameter:language:".length)
   01055|           : "unknown";
   01056|         const generatedTask = taskEvidence
   01057|           ? String(taskEvidence).slice("program_parameter:task:".length)
   01058|           : "program";
   01059|         programTemplates.add(`${generatedTask}/${generatedLanguage}`);
   01060|       }
   01061|       if (intent.startsWith("hello_world_")) {
   01062|         programTemplates.add(`hello_world/${intent.slice("hello_world_".length)}`);
   01063|       }
   01064|       if (intent.startsWith("concept_lookup")) {
   01065|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01066|         for (const item of evidence) {
   01067|           if (typeof item !== "string") continue;
   01068|           const conceptMatch = item.match(/^concept_lookup:request:(.+)$/);
   01069|           if (conceptMatch) concepts.add(conceptMatch[1]);
   01070|         }
   01071|       }
   01072|     }
   01073|   }
   01074|   if (lastUser) {
   01075|     unanswered.push(lastUser);
   01076|   }
   01077| 
   01078|   const lines = [];
   01079|   lines.push("## Conversation summary");
   01080|   lines.push("");
   01081|   lines.push(
   01082|     `- ${turns.length} turn(s): ${userCount} user, ${assistantCount} assistant`,
   01083|   );
   01084|   if (languages.size > 0) {
   01085|     const list = Array.from(languages.entries())
   01086|       .sort((a, b) => b[1] - a[1])
   01087|       .map(([lang, count]) => `${lang} (${count})`)
   01088|       .join(", ");
   01089|     lines.push(`- Languages: ${list}`);
   01090|   }
   01091|   if (intentCounts.size > 0) {
   01092|     const list = Array.from(intentCounts.entries())
   01093|       .sort((a, b) => b[1] - a[1])
   01094|       .map(([intent, count]) => `${intent} (${count})`)
   01095|       .join(", ");
   01096|     lines.push(`- Intents: ${list}`);
   01097|   }
   01098|   if (concepts.size > 0) {
   01099|     lines.push(`- Concepts looked up: ${Array.from(concepts).join(", ")}`);
   01100|   }
   01101|   if (calculations.length > 0) {
   01102|     lines.push(`- Calculations: ${calculations.join("; ")}`);
   01103|   }
   01104|   if (programTemplates.size > 0) {
   01105|     lines.push(
   01106|       `- Program templates generated: ${Array.from(programTemplates).join(", ")}`,
   01107|     );
   01108|   }
   01109|   if (unanswered.length > 0) {
   01110|     lines.push(`- Unanswered: ${unanswered.join(" | ")}`);
   01111|   }
   01112| 
   01113|   const evidence = [
   01114|     "summarize_conversation",
   01115|     `turns:${turns.length}`,
   01116|     `users:${userCount}`,
   01117|     `assistants:${assistantCount}`,
   01118|   ];
   01119|   if (intentCounts.size > 0) {
   01120|     evidence.push(`intents:${Array.from(intentCounts.keys()).join("|")}`);
   01121|   }
   01122|   return {
   01123|     intent: "summarize_conversation",
   01124|     content: lines.join("\n"),
   01125|     confidence: 0.9,
   01126|     evidence,
   01127|   };
   01128| }
   01129| 
   01130| // Issue #918: the compound-interest row holds no vocabulary, prose or rate.
   01131| // The cue words are the finance and currency meanings of the seed lexicon; the
   01132| // wording is the seeded compound_interest_* responses; the periods per
   01133| // compounding meaning, the frequency labels, the default exchange rates and
   01134| // the final-amount marker are the `policy compound_interest` block of
   01135| // data/seed/handler-rules.lino. Mirrors src/solver_handlers/compound_interest.rs.
   01136| // A function, not a const array, so the ROLE_* consts stay out of the TDZ.
   01137| function compoundCurrencies() {
   01138|   return [
   01139|     [ROLE_CURRENCY_EUR_REFERENCE, "EUR"],
   01140|     [ROLE_CURRENCY_USD_REFERENCE, "USD"],
   01141|     [ROLE_CURRENCY_RUB_REFERENCE, "RUB"],
   01142|   ];
   01143| }
   01144| const COMPOUND_PRINCIPAL_CURRENCY = "USD";
   01145| 
   01146| function compoundPolicy(key) {
   01147|   return handlerRulesPolicy("compound_interest", key) || "";
   01148| }
   01149| 
   01150| function compoundResponse(intent, values = {}) {
   01151|   let text = answerFor(intent, "en");
   01152|   for (const [name, value] of Object.entries(values)) text = text.split(`{${name}}`).join(String(value));
   01153|   return text;
   01154| }
   01155| 
   01156| function tryCompoundInterest(prompt, normalized, history) {
   01157|   const request = parseCompoundInterestRequest(prompt, normalized);
   01158|   if (request) return answerCompoundInterest(request);
   01159| 
   01160|   const conversion = parseFinalAmountConversionRequest(normalized, history);
   01161|   if (conversion) return answerFinalAmountConversion(conversion);
   01162| 
   01163|   return null;
   01164| }
   01165| 
   01166| function answerCompoundInterest(request) {
   01167|   const annualRate = request.annualRatePercent / 100;
   01168|   const periodsPerYear = request.compoundsPerYear;
   01169|   const periodicRate = annualRate / periodsPerYear;
   01170|   const periods = periodsPerYear * request.years;
   01171|   const finalAmount =
   01172|     request.principal * Math.pow(1 + periodicRate, periods);
   01173| 
   01174|   const evidence = [
   01175|     `calculation:compound_interest:P=${formatCompoundNumber(request.principal)};r=${formatCompoundRate(annualRate)};n=${periodsPerYear};t=${formatCompoundNumber(request.years)}`,
   01176|     "calculation:formula:A=P(1+r/n)^(n*t)",
   01177|   ];
   01178|   let content = compoundResponse("compound_interest_report", {
   01179|     principal: formatCompoundNumber(request.principal),
   01180|     rate: formatCompoundRate(annualRate),
   01181|     percent: formatCompoundNumber(request.annualRatePercent),
   01182|     periods_per_year: periodsPerYear,
   01183|     frequency: compoundPolicy(`label-${periodsPerYear}`) || compoundPolicy("label-other"),
   01184|     years: formatCompoundNumber(request.years),
   01185|     periodic_rate: formatCompoundRate(periodicRate),
   01186|     periods: formatCompoundNumber(periods),
   01187|     final_amount: formatCompoundMoney(finalAmount),
   01188|   });
   01189| 
   01190|   if (request.targetCurrency) {
   01191|     content += compoundConversion(
   01192|       evidence,
   01193|       finalAmount,
   01194|       COMPOUND_PRINCIPAL_CURRENCY,
   01195|       request.targetCurrency,
   01196|       request.asksForWebRate,
   01197|     );
   01198|   }
   01199| 
   01200|   return {
   01201|     intent: "calculation",
   01202|     content,
   01203|     confidence: 1.0,
   01204|     evidence,
   01205|   };
   01206| }
   01207| 
   01208| function answerFinalAmountConversion(conversion) {
   01209|   const evidence = ["calculation:final_amount_conversion"];
   01210|   const content =
   01211|     compoundResponse("compound_interest_final_amount_conversion", {
   01212|       amount: formatCompoundMoney(conversion.amount),
   01213|       source: conversion.sourceCurrency,
   01214|     }) +
   01215|     compoundConversion(
   01216|       evidence,
   01217|       conversion.amount,
   01218|       conversion.sourceCurrency,
   01219|       conversion.targetCurrency,
   01220|       conversion.asksForWebRate,
   01221|     );
   01222|   return {
   01223|     intent: "calculation",
   01224|     content,
   01225|     confidence: 1.0,
   01226|     evidence,
   01227|   };
   01228| }
   01229| 
   01230| // The conversion paragraph appended to a report: the seeded default rate,
   01231| // the converted amount, and the rate detail; or the honest no-rate sentence.
   01232| function compoundConversion(evidence, amount, source, target, asksForWebRate) {
   01233|   const rate = compoundDefaultRate(source, target);
   01234|   if (rate === null) {
   01235|     evidence.push(`calculation:currency_conversion:error:${source}->${target}`);
   01236|     return `\n\n${compoundResponse("compound_interest_rate_unavailable", { source, target })}`;
   01237|   }
   01238|   const displayedAmount = roundCompoundMoney(amount);
   01239|   const converted = displayedAmount * rate;
   01240|   evidence.push(
   01241|     `calculation:currency_conversion:${formatCompoundMoney(displayedAmount)} ${source} to ${target} at ${formatCompoundRate(rate)}`,
   01242|   );
   01243|   const expression = compoundPolicy("rate-expression").split("{source}").join(source).split("{target}").join(target);
   01244|   let text = `\n\n${compoundResponse("compound_interest_conversion", {
   01245|     source,
   01246|     target,
   01247|     expression,
   01248|     rate: formatCompoundRate(rate),
   01249|     amount: formatCompoundMoney(displayedAmount),
   01250|     converted: formatCompoundMoney(converted),
   01251|   })}`;
   01252|   text += `\n${compoundResponse("compound_interest_rate_detail", { source, target, rate: formatCompoundRate(rate) })}`;
   01253|   if (asksForWebRate) text += `\n${compoundResponse("compound_interest_live_rate_note")}`;
   01254|   return text;
   01255| }
   01256| 
   01257| // The seeded default rate from `source` to `target`: the direct pair, or the
   01258| // inverse of the reverse pair.
   01259| function compoundDefaultRate(source, target) {
   01260|   const direct = compoundRateNumber(compoundPolicy(`rate_${source}_${target}`));
   01261|   if (direct !== null) return direct;
   01262|   const reverse = compoundRateNumber(compoundPolicy(`rate_${target}_${source}`));
   01263|   return reverse === null || reverse === 0 ? null : 1 / reverse;
   01264| }
   01265| 
   01266| function compoundRateNumber(text) {
   01267|   return /^\d+(?:\.\d+)?$/.test(text) ? Number(text) : null;
   01268| }
   01269| 
   01270| function parseCompoundInterestRequest(prompt, normalized) {
   01271|   // The investment / interest / compounding cues are language-independent
   01272|   // meanings carried by the finance lexicon, matched as raw substrings of the
   01273|   // normalized prompt. Mirrors parse_compound_interest_request.
   01274|   if (
   01275|     !lexiconMentionsRoleSubstring(ROLE_INVESTMENT_CUE, normalized) ||
   01276|     !lexiconMentionsRoleSubstring(ROLE_INTEREST_CUE, normalized) ||
   01277|     !lexiconMentionsRoleSubstring(ROLE_COMPOUNDING_ACTION_CUE, normalized)
   01278|   ) {
   01279|     return null;
   01280|   }
   01281|   const principal = parseCompoundCurrencyAmount(prompt);
   01282|   const annualRatePercent = parseCompoundPercentBeforeSymbol(prompt);
   01283|   const compoundsPerYear = parseCompoundsPerYear(normalized);
   01284|   const years = parseCompoundYears(normalized);
   01285|   if (
   01286|     principal === null ||
   01287|     annualRatePercent === null ||
   01288|     compoundsPerYear === null ||
   01289|     years === null
   01290|   ) {
   01291|     return null;
   01292|   }
   01293|   return {
   01294|     principal,
   01295|     annualRatePercent,
   01296|     compoundsPerYear,
   01297|     years,
   01298|     targetCurrency: targetCurrencyFromText(normalized, COMPOUND_PRINCIPAL_CURRENCY),
   01299|     asksForWebRate: asksForWebRate(normalized),
   01300|   };
   01301| }
   01302| 
   01303| function parseFinalAmountConversionRequest(normalized, history) {
   01304|   // "convert" and "final amount" are themselves meanings: a conversion action
   01305|   // applied to the final-amount reference produced by a prior turn. Mirrors
   01306|   // parse_final_amount_conversion_request.
   01307|   if (
   01308|     !lexiconMentionsRoleSubstring(ROLE_CONVERSION_ACTION_CUE, normalized) ||
   01309|     !lexiconMentionsRoleSubstring(ROLE_FINAL_AMOUNT_REFERENCE, normalized)
   01310|   ) {
   01311|     return null;
   01312|   }
   01313|   const prior = priorFinalAmount(history);
   01314|   if (!prior) return null;
   01315|   const targetCurrency = targetCurrencyFromText(normalized, prior.currency);
   01316|   if (!targetCurrency) return null;
   01317|   return {
   01318|     amount: prior.amount,
   01319|     sourceCurrency: prior.currency,
   01320|     targetCurrency,
   01321|     asksForWebRate: asksForWebRate(normalized),
   01322|   };
   01323| }
   01324| 
   01325| function priorFinalAmount(history) {
   01326|   if (!Array.isArray(history)) return null;
   01327|   for (let index = history.length - 1; index >= 0; index -= 1) {
   01328|     const turn = history[index];
   01329|     if (!turn || turn.role !== "assistant") continue;
   01330|     const parsed = parseFinalAmountFromText(String(turn.content || ""));
   01331|     if (parsed) return parsed;
   01332|   }
   01333|   return null;
   01334| }
   01335| 
   01336| // The amount and currency an earlier report states after the seeded
   01337| // final-amount marker. Mirrors parse_final_amount_from_text.
   01338| function parseFinalAmountFromText(text) {
   01339|   const marker = compoundPolicy("final-amount-marker");
   01340|   const lower = String(text || "").toLowerCase();
   01341|   const at = marker ? lower.indexOf(marker) : -1;
   01342|   if (at < 0) return null;
   01343|   const match = /^[ \t\n\f\r]*([\d.,]*)[ \t\n\f\r]*(\p{L}*)/u.exec(lower.slice(at + marker.length));
   01344|   const amount = parseCompoundNumberText(match[1]);
   01345|   const entry = compoundCurrencies().find(([role]) => wordsForRole(role).includes(match[2]));
   01346|   return amount === null || !entry ? null : { amount, currency: entry[1] };
   01347| }
   01348| 
   01349| function parseCompoundCurrencyAmount(prompt) {
   01350|   const text = String(prompt || "");
   01351|   const dollarIndex = text.indexOf("$");
   01352|   if (dollarIndex >= 0) return parseCompoundNumberRight(text, dollarIndex + 1);
   01353|   // The spelled-out US-dollar markers are the English surfaces of
   01354|   // currency_usd_reference, scanned as space-prefixed tokens with the amount
   01355|   // to their left. Mirrors parse_currency_amount.
   01356|   const lower = text.toLowerCase();
   01357|   for (const word of wordsForRoleInLanguages(ROLE_CURRENCY_USD_REFERENCE, ["en"])) {
   01358|     const index = lower.indexOf(` ${word}`);
   01359|     if (index < 0) continue;
   01360|     const amount = parseCompoundNumberLeft(lower, index);
   01361|     if (amount !== null) return amount;
   01362|   }
   01363|   return null;
   01364| }
   01365| 
   01366| function parseCompoundPercentBeforeSymbol(prompt) {
   01367|   const text = String(prompt || "");
   01368|   const percentIndex = text.indexOf("%");
   01369|   return percentIndex >= 0 ? parseCompoundNumberLeft(text, percentIndex) : null;
   01370| }
   01371| 
   01372| function parseCompoundYears(normalized) {
   01373|   // The duration unit is a meaning (year_unit_cue); read the number to the
   01374|   // left of the earliest of its surface forms that has one, so the "year" in
   01375|   // "compounded yearly" is skipped. Mirrors years_in_prompt.
   01376|   const text = String(normalized || "");
   01377|   const positions = [];
   01378|   for (const word of wordsForRole(ROLE_YEAR_UNIT_CUE)) {
   01379|     if (!word) continue;
   01380|     for (let index = text.indexOf(word); index >= 0; index = text.indexOf(word, index + 1)) positions.push(index);
   01381|   }
   01382|   positions.sort((left, right) => left - right);
   01383|   for (const index of positions) {
   01384|     const years = parseCompoundNumberLeft(text, index);
   01385|     if (years !== null) return years;
   01386|   }
   01387|   return null;
   01388| }
   01389| 
   01390| function parseCompoundsPerYear(normalized) {
   01391|   // The compounding frequency is a cluster of meanings listed in priority
   01392|   // order in the finance lexicon; the first whose surface appears in the
   01393|   // prompt names its periods per year in the seeded policy. Mirrors
   01394|   // parse_compounds_per_year.
   01395|   const meaning = meaningsWithRole(ROLE_COMPOUNDING_FREQUENCY_CUE).find((candidate) =>
   01396|     candidate.words.some((word) => normalized.includes(word)),
   01397|   );
