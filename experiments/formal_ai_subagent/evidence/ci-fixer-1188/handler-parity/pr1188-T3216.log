   00591|     if (!turn || turn.role !== "user") continue;
   00592|     const antecedent = matchingCoreferenceAntecedent(String(turn.content || "").toLowerCase());
   00593|     if (antecedent) return { antecedent, previous: normalizePrompt(String(turn.content || "")) };
   00594|   }
   00595|   return null;
   00596| }
