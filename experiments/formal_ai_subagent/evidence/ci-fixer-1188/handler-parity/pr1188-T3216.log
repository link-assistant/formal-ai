   00638|   if (antecedent.wikidata) evidence.push(`wikidata:${antecedent.wikidata}`);
   00639|   const solverEvents = [{ kind: "coreference:resolved", payload: `${pronoun.token}=${antecedent.displayName}` }];
   00640|   if (antecedent.wikidata) solverEvents.push({ kind: "wikidata", payload: antecedent.wikidata });
