   00012|     const lastChar = Array.from(sourceTrimmed).pop();
   00013|     if (TRANSLATION_TERMINAL_PUNCTUATION.includes(lastChar)) sourceTerminal = lastChar;
   00014|   }
   00015|   let targetNoTerminal = targetTrimmed;
   00016|   while (
   00017|     targetNoTerminal.length > 0 &&
   00018|     TRANSLATION_TERMINAL_PUNCTUATION.includes(Array.from(targetNoTerminal).pop())
   00019|   ) {
   00020|     const lastChar = Array.from(targetNoTerminal).pop();
   00021|     targetNoTerminal = targetNoTerminal.slice(0, targetNoTerminal.length - lastChar.length);
   00022|   }
   00023|   const withTerminal = sourceTerminal ? targetNoTerminal + sourceTerminal : targetNoTerminal;
