   00621|       solverEvents: [
   00622|         { kind: "coreference:resolved", payload: `${pronoun.token}=${subject}` },
   00623|         ...(antecedent.wikidata ? [{ kind: "wikidata", payload: antecedent.wikidata }] : []),
   00624|         { kind: "coreference:rewrite", payload: rewritten },
   00625|         ...(Array.isArray(hit.solverEvents) ? hit.solverEvents : []),
   00626|       ],
   00627|       evidence: [
   00628|         `coreference:resolved:${pronoun.token}=${subject}`,
   00629|         `coreference:rewrite:${rewritten}`,
   00630|         ...(Array.isArray(hit.evidence) ? hit.evidence : []),
   00631|       ],
   00632|     });
   00633|   }
