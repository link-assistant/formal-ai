   00167| function detectLanguageSlug(text) {
   00168|   let latin = 0;
   00169|   let cyrillic = 0;
   00170|   let devanagari = 0;
   00171|   let cjk = 0;
   00172|   let other = 0;
   00173|   let firstScript = null;
   00174|   for (const character of String(text || "")) {
   00175|     const code = character.codePointAt(0);
   00176|     if (/[a-z]/i.test(character)) {
   00177|       latin += 1;
   00178|       if (!firstScript) firstScript = "latin";
   00179|     } else if (code >= 0x0400 && code <= 0x04ff) {
   00180|       cyrillic += 1;
   00181|       if (!firstScript) firstScript = "cyrillic";
   00182|     } else if (code >= 0x0900 && code <= 0x097f) {
   00183|       devanagari += 1;
   00184|       if (!firstScript) firstScript = "devanagari";
   00185|     } else if (code >= 0x4e00 && code <= 0x9fff) {
   00186|       cjk += 1;
   00187|       if (!firstScript) firstScript = "cjk";
   00188|     } else if (/\p{L}/u.test(character)) {
   00189|       other += 1;
   00190|       if (!firstScript) firstScript = "other";
   00191|     }
   00192|   }
   00193|   const total = latin + cyrillic + devanagari + cjk + other;
   00194|   if (total === 0) return "en";
   00195|   if (other > latin && other >= cyrillic && other >= devanagari && other >= cjk) {
   00196|     return "unknown";
   00197|   }
   00198|   if (latin > 0) {
   00199|     const markerLanguage = detectQuestionMarkerLanguage(text, { cyrillic, devanagari, cjk });
   00200|     if (markerLanguage) return markerLanguage;
   00201|     if (firstScript === "cyrillic" && cyrillic >= Math.max(devanagari, cjk)) return "ru";
   00202|     if (firstScript === "devanagari" && devanagari >= Math.max(cyrillic, cjk)) return "hi";
   00203|     if (firstScript === "cjk" && cjk >= Math.max(cyrillic, devanagari)) return "zh";
   00204|   }
   00205|   if (cyrillic >= Math.max(latin, devanagari, cjk) && cyrillic > 0) return "ru";
   00206|   if (devanagari >= Math.max(latin, cyrillic, cjk) && devanagari > 0) return "hi";
   00207|   if (cjk >= Math.max(latin, cyrillic, devanagari) && cjk > 0) return "zh";
   00208|   return "en";
   00209| }
