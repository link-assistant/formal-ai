   00106| function translateCompositionalSurface(surface, source, target) {
   00107|   const normalized = normalizeComposableSurface(surface);
   00108|   if (!normalized) return null;
   00109| 
   00110|   const direct =
   00111|     roleSurfaceTranslation(ROLE_COMPOSITIONAL_PHRASE, source, target, normalized) ||
   00112|     roleSurfaceTranslation(ROLE_COMPOSITIONAL_LEMMA, source, target, normalized);
   00113|   if (direct) return direct;
   00114| 
   00115|   if (source !== "ru" || target !== "en") return null;
   00116| 
   00117|   const phrase = roleSurfaceTranslation(ROLE_COMPOSITIONAL_PHRASE, "ru", "en", normalized);
   00118|   if (phrase) return phrase;
   00119| 
   00120|   const words = normalized.split(/\s+/u).filter(Boolean);
   00121|   if (words.length < 2 || words.length > 8) return null;
   00122|   return translateRussianWordSequence(words);
   00123| }
