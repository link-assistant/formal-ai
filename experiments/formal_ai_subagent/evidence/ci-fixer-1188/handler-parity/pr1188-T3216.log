   00866| // Issue #529: natural-language *writes* to the entire associative memory. This
   00867| // is the browser mirror of src/solver_handlers/conversation_memory/memory_write.rs
   00868| // — the write half of the Turing-complete memory primitive (a recall reads, an
   00869| // append extends, a substitution rewrites). Both recognisers are driven by the
   00870| // seed lexicon (ROLE_MEMORY_*), so they extend to every supported language
   00871| // automatically. The actual persistence happens in the app (main.jsx applies the
   00872| // returned memoryOperation to IndexedDB); the worker stays pure by computing the
   00873| // substitution count over a memory snapshot the app passes in.
   00874| 
   00875| // Recognise a "remember …" append directive in any language. The surfaces are
   00876| // Slot::Prefix forms (trailing …), so each form's literal-before-the-slot is the
   00877| // matchable prefix. Matching runs on a lowercased copy of the raw prompt and
   00878| // longer prefixes win first, so "remember that X" beats "remember X". Mirrors
   00879| // recognize_memory_append.
   00880| function recognizeMemoryAppend(prompt) {
   00881|   const trimmed = String(prompt || "").replace(/^\s+/, "");
   00882|   const lowered = trimmed.toLowerCase();
   00883|   const prefixes = roleWordForms(ROLE_MEMORY_APPEND_DIRECTIVE)
   00884|     .filter((form) => form.slot === "prefix")
   00885|     .map((form) => form.before)
   00886|     .filter((prefix) => prefix.length > 0);
   00887|   prefixes.sort((a, b) => b.length - a.length);
   00888|   for (const prefix of prefixes) {
   00889|     if (lowered.startsWith(prefix)) {
   00890|       const statement = cleanMemoryWriteText(trimmed.slice(prefix.length));
   00891|       if (statement) return statement;
   00892|     }
   00893|   }
   00894|   return null;
   00895| }
   00896| 
   00897| // Recognise a memory substitution (a read+write transform) in any language. A
   00898| // bare "replace X with Y" is an ordinary coding request, so a memory *scope*
   00899| // phrase must be present to claim the prompt. We then strip the scope and the
   00900| // substitution directive (position-independent: SVO languages lead, Hindi
   00901| // trails) and split the operand span on the connector to recover (old, new).
   00902| // Mirrors recognize_memory_substitution.
   00903| function recognizeMemorySubstitution(normalized) {
   00904|   if (!lexiconMentionsRole(ROLE_MEMORY_SCOPE, normalized)) return null;
   00905|   const withoutScope = stripFirstMemorySurface(normalized, ROLE_MEMORY_SCOPE);
   00906|   if (withoutScope === null) return null;
   00907|   const operands = stripFirstMemorySurface(
   00908|     withoutScope,
   00909|     ROLE_MEMORY_SUBSTITUTION_DIRECTIVE,
   00910|   );
   00911|   if (operands === null) return null;
   00912|   const split = splitOnceMemorySurface(
   00913|     operands,
   00914|     ROLE_MEMORY_SUBSTITUTION_CONNECTOR,
   00915|   );
   00916|   if (!split) return null;
   00917|   const oldValue = cleanMemoryWriteText(split[0]);
   00918|   const newValue = cleanMemoryWriteText(split[1]);
   00919|   if (!oldValue || !newValue) return null;
   00920|   return { oldValue, newValue };
   00921| }
   00922| 
   00923| // Total substring occurrences of `old` across every searchable value in the
   00924| // memory snapshot. Mirrors MemoryStore::apply_substitution's count, which sums
   00925| // replace_counting over each event's content/inputs/outputs/title/label and
   00926| // every evidence entry. The app builds the snapshot from those same fields, so
   00927| // the worker's reported count matches the rewrite the app applies to IndexedDB.
   00928| function countMemoryOccurrences(memory, old) {
   00929|   if (!old) return 0;
   00930|   const values = Array.isArray(memory) ? memory : [];
   00931|   let count = 0;
   00932|   for (const value of values) {
   00933|     const text = String(value || "");
   00934|     if (!text.includes(old)) continue;
   00935|     count += text.split(old).length - 1;
   00936|   }
   00937|   return count;
   00938| }
   00939| 
   00940| function renderMemoryAppendAnswer(statement, language) {
   00941|   if (language === "ru") return `Запомнил: ${statement}`;
   00942|   if (language === "zh") return `已记住:${statement}`;
   00943|   if (language === "hi") return `स्मृति में सहेजा गया: ${statement}`;
   00944|   return `Recorded memory: ${statement}`;
   00945| }
   00946| 
   00947| function renderMemorySubstitutionAnswer(oldValue, newValue, applied, language) {
   00948|   if (language === "ru") {
   00949|     return `Заменил "${oldValue}" на "${newValue}" в памяти (обновлено вхождений: ${applied}).`;
   00950|   }
   00951|   if (language === "zh") {
   00952|     return `已在记忆中将"${oldValue}"替换为"${newValue}"(更新 ${applied} 处)。`;
   00953|   }
   00954|   if (language === "hi") {
   00955|     return `स्मृति में "${oldValue}" को "${newValue}" से बदला (${applied})।`;
   00956|   }
   00957|   return `Replaced "${oldValue}" with "${newValue}" in memory (${applied} occurrence(s) updated).`;
   00958| }
   00959| 
   00960| // Recognise a natural-language memory write and return an answer carrying a
   00961| // structured `memoryOperation` for the app to persist. Substitution is tried
   00962| // before append because a substitution prompt also begins with a directive verb.
   00963| // Mirrors try_memory_write + recognize_memory_write.
   00964| function tryMemoryWrite(prompt, normalized, memory) {
   00965|   const substitution = recognizeMemorySubstitution(normalized);
   00966|   if (substitution) {
   00967|     const language = detectLanguage(prompt);
   00968|     const applied = countMemoryOccurrences(memory, substitution.oldValue);
   00969|     return {
   00970|       intent: "memory_substitution",
   00971|       content: renderMemorySubstitutionAnswer(
   00972|         substitution.oldValue,
   00973|         substitution.newValue,
   00974|         applied,
   00975|         language,
   00976|       ),
   00977|       confidence: 0.9,
   00978|       evidence: [
   00979|         "memory_substitution",
   00980|         "substitution_event:update",
   00981|         `substitution:applied=${applied}`,
   00982|         "response:memory_substitution",
   00983|       ],
   00984|       memoryOperation: {
   00985|         action: "substitute",
   00986|         oldValue: substitution.oldValue,
   00987|         newValue: substitution.newValue,
   00988|         applied,
   00989|       },
   00990|     };
   00991|   }
   00992|   const statement = recognizeMemoryAppend(prompt);
   00993|   if (statement) {
   00994|     const language = detectLanguage(prompt);
   00995|     return {
   00996|       intent: "memory_write",
   00997|       content: renderMemoryAppendAnswer(statement, language),
   00998|       confidence: 0.9,
   00999|       evidence: [
   01000|         "memory_write",
   01001|         "memory_write:natural_language",
   01002|         "response:memory_write",
   01003|       ],
   01004|       memoryOperation: { action: "append", statement },
   01005|     };
   01006|   }
   01007|   return null;
   01008| }
   01009| 
   01010| // Issue #27: deterministic, logical summarisation — no neural net. We
   01011| // project the conversation onto a small set of features (turn counts, intents,
   01012| // concepts, languages, unanswered questions) and render them as a structured
   01013| // Markdown report. Every value is derived directly from the append-only event
   01014| // log so reruns on the same input produce byte-identical output.
   01015| function trySummarizeConversation(history) {
   01016|   if (!Array.isArray(history) || history.length === 0) return null;
   01017|   const turns = history.filter((turn) => turn && turn.content);
   01018|   if (turns.length === 0) return null;
   01019| 
   01020|   let userCount = 0;
   01021|   let assistantCount = 0;
   01022|   const intentCounts = new Map();
   01023|   const languages = new Map();
   01024|   const concepts = new Set();
   01025|   const calculations = [];
   01026|   const programTemplates = new Set();
   01027|   const unanswered = [];
   01028|   let lastUser = null;
   01029| 
   01030|   for (const turn of turns) {
   01031|     const role = turn.role || "assistant";
   01032|     const language = detectLanguage(turn.content);
   01033|     languages.set(language, (languages.get(language) || 0) + 1);
   01034|     if (role === "user") {
   01035|       userCount += 1;
   01036|       lastUser = turn.content;
   01037|     } else {
   01038|       assistantCount += 1;
   01039|       if (lastUser) {
   01040|         lastUser = null;
   01041|       }
   01042|       const intent = String(turn.intent || "unknown");
   01043|       intentCounts.set(intent, (intentCounts.get(intent) || 0) + 1);
   01044|       if (intent === "calculation" && typeof turn.content === "string") {
   01045|         const match = turn.content.match(/^([^=]+=\s*[^\n]+)/);
   01046|         if (match) calculations.push(match[1].trim());
   01047|       }
   01048|       if (intent === "write_program") {
   01049|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01050|         const languageEvidence = evidence.find((item) =>
   01051|           String(item || "").startsWith("program_parameter:language:"),
   01052|         );
   01053|         const taskEvidence = evidence.find((item) =>
   01054|           String(item || "").startsWith("program_parameter:task:"),
   01055|         );
   01056|         const generatedLanguage = languageEvidence
   01057|           ? String(languageEvidence).slice("program_parameter:language:".length)
   01058|           : "unknown";
   01059|         const generatedTask = taskEvidence
   01060|           ? String(taskEvidence).slice("program_parameter:task:".length)
   01061|           : "program";
   01062|         programTemplates.add(`${generatedTask}/${generatedLanguage}`);
   01063|       }
   01064|       if (intent.startsWith("hello_world_")) {
   01065|         programTemplates.add(`hello_world/${intent.slice("hello_world_".length)}`);
   01066|       }
   01067|       if (intent.startsWith("concept_lookup")) {
   01068|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01069|         for (const item of evidence) {
   01070|           if (typeof item !== "string") continue;
   01071|           const conceptMatch = item.match(/^concept_lookup:request:(.+)$/);
   01072|           if (conceptMatch) concepts.add(conceptMatch[1]);
   01073|         }
   01074|       }
   01075|     }
   01076|   }
   01077|   if (lastUser) {
   01078|     unanswered.push(lastUser);
   01079|   }
   01080| 
   01081|   const lines = [];
   01082|   lines.push("## Conversation summary");
   01083|   lines.push("");
   01084|   lines.push(
   01085|     `- ${turns.length} turn(s): ${userCount} user, ${assistantCount} assistant`,
   01086|   );
   01087|   if (languages.size > 0) {
   01088|     const list = Array.from(languages.entries())
   01089|       .sort((a, b) => b[1] - a[1])
   01090|       .map(([lang, count]) => `${lang} (${count})`)
   01091|       .join(", ");
   01092|     lines.push(`- Languages: ${list}`);
   01093|   }
   01094|   if (intentCounts.size > 0) {
   01095|     const list = Array.from(intentCounts.entries())
   01096|       .sort((a, b) => b[1] - a[1])
   01097|       .map(([intent, count]) => `${intent} (${count})`)
   01098|       .join(", ");
   01099|     lines.push(`- Intents: ${list}`);
   01100|   }
   01101|   if (concepts.size > 0) {
   01102|     lines.push(`- Concepts looked up: ${Array.from(concepts).join(", ")}`);
   01103|   }
   01104|   if (calculations.length > 0) {
   01105|     lines.push(`- Calculations: ${calculations.join("; ")}`);
   01106|   }
   01107|   if (programTemplates.size > 0) {
   01108|     lines.push(
   01109|       `- Program templates generated: ${Array.from(programTemplates).join(", ")}`,
   01110|     );
   01111|   }
   01112|   if (unanswered.length > 0) {
   01113|     lines.push(`- Unanswered: ${unanswered.join(" | ")}`);
   01114|   }
   01115| 
   01116|   const evidence = [
   01117|     "summarize_conversation",
   01118|     `turns:${turns.length}`,
   01119|     `users:${userCount}`,
   01120|     `assistants:${assistantCount}`,
   01121|   ];
   01122|   if (intentCounts.size > 0) {
   01123|     evidence.push(`intents:${Array.from(intentCounts.keys()).join("|")}`);
   01124|   }
   01125|   return {
   01126|     intent: "summarize_conversation",
   01127|     content: lines.join("\n"),
   01128|     confidence: 0.9,
   01129|     evidence,
   01130|   };
   01131| }
   01132| 
   01133| // Issue #918: the compound-interest row holds no vocabulary, prose or rate.
   01134| // The cue words are the finance and currency meanings of the seed lexicon; the
   01135| // wording is the seeded compound_interest_* responses; the periods per
   01136| // compounding meaning, the frequency labels, the default exchange rates and
   01137| // the final-amount marker are the `policy compound_interest` block of
   01138| // data/seed/handler-rules.lino. Mirrors src/solver_handlers/compound_interest.rs.
   01139| // A function, not a const array, so the ROLE_* consts stay out of the TDZ.
   01140| function compoundCurrencies() {
   01141|   return [
   01142|     [ROLE_CURRENCY_EUR_REFERENCE, "EUR"],
   01143|     [ROLE_CURRENCY_USD_REFERENCE, "USD"],
   01144|     [ROLE_CURRENCY_RUB_REFERENCE, "RUB"],
   01145|   ];
   01146| }
   01147| const COMPOUND_PRINCIPAL_CURRENCY = "USD";
   01148| 
   01149| function compoundPolicy(key) {
   01150|   return handlerRulesPolicy("compound_interest", key) || "";
   01151| }
   01152| 
   01153| function compoundResponse(intent, values = {}) {
   01154|   let text = answerFor(intent, "en");
   01155|   for (const [name, value] of Object.entries(values)) text = text.split(`{${name}}`).join(String(value));
   01156|   return text;
   01157| }
   01158| 
   01159| function tryCompoundInterest(prompt, normalized, history) {
   01160|   const request = parseCompoundInterestRequest(prompt, normalized);
   01161|   if (request) return answerCompoundInterest(request);
   01162| 
   01163|   const conversion = parseFinalAmountConversionRequest(normalized, history);
   01164|   if (conversion) return answerFinalAmountConversion(conversion);
   01165| 
   01166|   return null;
   01167| }
   01168| 
   01169| function answerCompoundInterest(request) {
   01170|   const annualRate = request.annualRatePercent / 100;
   01171|   const periodsPerYear = request.compoundsPerYear;
   01172|   const periodicRate = annualRate / periodsPerYear;
   01173|   const periods = periodsPerYear * request.years;
   01174|   const finalAmount =
   01175|     request.principal * Math.pow(1 + periodicRate, periods);
   01176| 
   01177|   const evidence = [
   01178|     `calculation:compound_interest:P=${formatCompoundNumber(request.principal)};r=${formatCompoundRate(annualRate)};n=${periodsPerYear};t=${formatCompoundNumber(request.years)}`,
   01179|     "calculation:formula:A=P(1+r/n)^(n*t)",
   01180|   ];
   01181|   let content = compoundResponse("compound_interest_report", {
   01182|     principal: formatCompoundNumber(request.principal),
   01183|     rate: formatCompoundRate(annualRate),
   01184|     percent: formatCompoundNumber(request.annualRatePercent),
   01185|     periods_per_year: periodsPerYear,
   01186|     frequency: compoundPolicy(`label-${periodsPerYear}`) || compoundPolicy("label-other"),
   01187|     years: formatCompoundNumber(request.years),
   01188|     periodic_rate: formatCompoundRate(periodicRate),
   01189|     periods: formatCompoundNumber(periods),
   01190|     final_amount: formatCompoundMoney(finalAmount),
   01191|   });
   01192| 
   01193|   if (request.targetCurrency) {
   01194|     content += compoundConversion(
   01195|       evidence,
   01196|       finalAmount,
   01197|       COMPOUND_PRINCIPAL_CURRENCY,
   01198|       request.targetCurrency,
   01199|       request.asksForWebRate,
   01200|     );
   01201|   }
   01202| 
   01203|   return {
   01204|     intent: "calculation",
   01205|     content,
   01206|     confidence: 1.0,
   01207|     evidence,
   01208|   };
   01209| }
   01210| 
   01211| function answerFinalAmountConversion(conversion) {
   01212|   const evidence = ["calculation:final_amount_conversion"];
   01213|   const content =
   01214|     compoundResponse("compound_interest_final_amount_conversion", {
   01215|       amount: formatCompoundMoney(conversion.amount),
   01216|       source: conversion.sourceCurrency,
   01217|     }) +
   01218|     compoundConversion(
   01219|       evidence,
   01220|       conversion.amount,
   01221|       conversion.sourceCurrency,
   01222|       conversion.targetCurrency,
   01223|       conversion.asksForWebRate,
   01224|     );
   01225|   return {
   01226|     intent: "calculation",
   01227|     content,
   01228|     confidence: 1.0,
   01229|     evidence,
   01230|   };
   01231| }
   01232| 
   01233| // The conversion paragraph appended to a report: the seeded default rate,
   01234| // the converted amount, and the rate detail; or the honest no-rate sentence.
   01235| function compoundConversion(evidence, amount, source, target, asksForWebRate) {
   01236|   const rate = compoundDefaultRate(source, target);
   01237|   if (rate === null) {
   01238|     evidence.push(`calculation:currency_conversion:error:${source}->${target}`);
   01239|     return `\n\n${compoundResponse("compound_interest_rate_unavailable", { source, target })}`;
   01240|   }
   01241|   const displayedAmount = roundCompoundMoney(amount);
   01242|   const converted = displayedAmount * rate;
   01243|   evidence.push(
   01244|     `calculation:currency_conversion:${formatCompoundMoney(displayedAmount)} ${source} to ${target} at ${formatCompoundRate(rate)}`,
   01245|   );
   01246|   const expression = compoundPolicy("rate-expression").split("{source}").join(source).split("{target}").join(target);
   01247|   let text = `\n\n${compoundResponse("compound_interest_conversion", {
   01248|     source,
   01249|     target,
   01250|     expression,
   01251|     rate: formatCompoundRate(rate),
   01252|     amount: formatCompoundMoney(displayedAmount),
   01253|     converted: formatCompoundMoney(converted),
   01254|   })}`;
   01255|   text += `\n${compoundResponse("compound_interest_rate_detail", { source, target, rate: formatCompoundRate(rate) })}`;
   01256|   if (asksForWebRate) text += `\n${compoundResponse("compound_interest_live_rate_note")}`;
   01257|   return text;
   01258| }
   01259| 
   01260| // The seeded default rate from `source` to `target`: the direct pair, or the
   01261| // inverse of the reverse pair.
   01262| function compoundDefaultRate(source, target) {
   01263|   const direct = compoundRateNumber(compoundPolicy(`rate_${source}_${target}`));
   01264|   if (direct !== null) return direct;
   01265|   const reverse = compoundRateNumber(compoundPolicy(`rate_${target}_${source}`));
   01266|   return reverse === null || reverse === 0 ? null : 1 / reverse;
   01267| }
   01268| 
   01269| function compoundRateNumber(text) {
   01270|   return /^\d+(?:\.\d+)?$/.test(text) ? Number(text) : null;
   01271| }
   01272| 
   01273| function parseCompoundInterestRequest(prompt, normalized) {
   01274|   // The investment / interest / compounding cues are language-independent
   01275|   // meanings carried by the finance lexicon, matched as raw substrings of the
   01276|   // normalized prompt. Mirrors parse_compound_interest_request.
   01277|   if (
   01278|     !lexiconMentionsRoleSubstring(ROLE_INVESTMENT_CUE, normalized) ||
   01279|     !lexiconMentionsRoleSubstring(ROLE_INTEREST_CUE, normalized) ||
   01280|     !lexiconMentionsRoleSubstring(ROLE_COMPOUNDING_ACTION_CUE, normalized)
   01281|   ) {
   01282|     return null;
   01283|   }
   01284|   const principal = parseCompoundCurrencyAmount(prompt);
   01285|   const annualRatePercent = parseCompoundPercentBeforeSymbol(prompt);
   01286|   const compoundsPerYear = parseCompoundsPerYear(normalized);
   01287|   const years = parseCompoundYears(normalized);
   01288|   if (
   01289|     principal === null ||
   01290|     annualRatePercent === null ||
   01291|     compoundsPerYear === null ||
   01292|     years === null
   01293|   ) {
   01294|     return null;
   01295|   }
   01296|   return {
   01297|     principal,
   01298|     annualRatePercent,
   01299|     compoundsPerYear,
   01300|     years,
   01301|     targetCurrency: targetCurrencyFromText(normalized, COMPOUND_PRINCIPAL_CURRENCY),
   01302|     asksForWebRate: asksForWebRate(normalized),
   01303|   };
   01304| }
   01305| 
   01306| function parseFinalAmountConversionRequest(normalized, history) {
   01307|   // "convert" and "final amount" are themselves meanings: a conversion action
   01308|   // applied to the final-amount reference produced by a prior turn. Mirrors
   01309|   // parse_final_amount_conversion_request.
   01310|   if (
   01311|     !lexiconMentionsRoleSubstring(ROLE_CONVERSION_ACTION_CUE, normalized) ||
   01312|     !lexiconMentionsRoleSubstring(ROLE_FINAL_AMOUNT_REFERENCE, normalized)
   01313|   ) {
   01314|     return null;
   01315|   }
   01316|   const prior = priorFinalAmount(history);
   01317|   if (!prior) return null;
   01318|   const targetCurrency = targetCurrencyFromText(normalized, prior.currency);
   01319|   if (!targetCurrency) return null;
   01320|   return {
   01321|     amount: prior.amount,
   01322|     sourceCurrency: prior.currency,
   01323|     targetCurrency,
   01324|     asksForWebRate: asksForWebRate(normalized),
   01325|   };
   01326| }
   01327| 
   01328| function priorFinalAmount(history) {
   01329|   if (!Array.isArray(history)) return null;
   01330|   for (let index = history.length - 1; index >= 0; index -= 1) {
   01331|     const turn = history[index];
   01332|     if (!turn || turn.role !== "assistant") continue;
   01333|     const parsed = parseFinalAmountFromText(String(turn.content || ""));
   01334|     if (parsed) return parsed;
   01335|   }
   01336|   return null;
   01337| }
   01338| 
   01339| // The amount and currency an earlier report states after the seeded
   01340| // final-amount marker. Mirrors parse_final_amount_from_text.
   01341| function parseFinalAmountFromText(text) {
   01342|   const marker = compoundPolicy("final-amount-marker");
   01343|   const lower = String(text || "").toLowerCase();
   01344|   const at = marker ? lower.indexOf(marker) : -1;
   01345|   if (at < 0) return null;
   01346|   const match = /^[ \t\n\f\r]*([\d.,]*)[ \t\n\f\r]*(\p{L}*)/u.exec(lower.slice(at + marker.length));
   01347|   const amount = parseCompoundNumberText(match[1]);
   01348|   const entry = compoundCurrencies().find(([role]) => wordsForRole(role).includes(match[2]));
   01349|   return amount === null || !entry ? null : { amount, currency: entry[1] };
   01350| }
   01351| 
   01352| function parseCompoundCurrencyAmount(prompt) {
   01353|   const text = String(prompt || "");
   01354|   const dollarIndex = text.indexOf("$");
   01355|   if (dollarIndex >= 0) return parseCompoundNumberRight(text, dollarIndex + 1);
   01356|   // The spelled-out US-dollar markers are the English surfaces of
   01357|   // currency_usd_reference, scanned as space-prefixed tokens with the amount
   01358|   // to their left. Mirrors parse_currency_amount.
   01359|   const lower = text.toLowerCase();
   01360|   for (const word of wordsForRoleInLanguages(ROLE_CURRENCY_USD_REFERENCE, ["en"])) {
   01361|     const index = lower.indexOf(` ${word}`);
   01362|     if (index < 0) continue;
   01363|     const amount = parseCompoundNumberLeft(lower, index);
   01364|     if (amount !== null) return amount;
   01365|   }
   01366|   return null;
   01367| }
   01368| 
   01369| function parseCompoundPercentBeforeSymbol(prompt) {
   01370|   const text = String(prompt || "");
   01371|   const percentIndex = text.indexOf("%");
   01372|   return percentIndex >= 0 ? parseCompoundNumberLeft(text, percentIndex) : null;
   01373| }
   01374| 
   01375| function parseCompoundYears(normalized) {
   01376|   // The duration unit is a meaning (year_unit_cue); read the number to the
   01377|   // left of the earliest of its surface forms that has one, so the "year" in
   01378|   // "compounded yearly" is skipped. Mirrors years_in_prompt.
   01379|   const text = String(normalized || "");
   01380|   const positions = [];
   01381|   for (const word of wordsForRole(ROLE_YEAR_UNIT_CUE)) {
   01382|     if (!word) continue;
   01383|     for (let index = text.indexOf(word); index >= 0; index = text.indexOf(word, index + 1)) positions.push(index);
   01384|   }
   01385|   positions.sort((left, right) => left - right);
   01386|   for (const index of positions) {
   01387|     const years = parseCompoundNumberLeft(text, index);
   01388|     if (years !== null) return years;
   01389|   }
   01390|   return null;
   01391| }
   01392| 
   01393| function parseCompoundsPerYear(normalized) {
   01394|   // The compounding frequency is a cluster of meanings listed in priority
   01395|   // order in the finance lexicon; the first whose surface appears in the
