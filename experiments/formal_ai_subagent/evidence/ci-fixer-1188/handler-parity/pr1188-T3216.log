   00610|     const alias = matchingAntecedentFactAlias(record, antecedent, previous);
   00611|     if (!alias) continue;
   00612| 
   00613|     const rewritten = replaceBoundedToken(normalized, pronoun.token, alias);
   00614|     if (!rewritten) continue;
   00615| 
   00616|     const hit = tryFactLookup(prompt, rewritten);
