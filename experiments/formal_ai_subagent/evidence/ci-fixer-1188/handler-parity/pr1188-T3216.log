   00542| function matchingCoreferencePronoun(normalized) {
   00543|   const pronouns = Array.isArray(COREFERENCE_SEEDS && COREFERENCE_SEEDS.pronouns)
   00544|     ? COREFERENCE_SEEDS.pronouns
   00545|     : [];
   00546|   return pronouns.find((pronoun) => {
   00547|     const contexts = Array.isArray(pronoun && pronoun.contexts)
   00548|       ? pronoun.contexts
   00549|       : [];
   00550|     const startsWith = Array.isArray(pronoun && pronoun.startsWith)
   00551|       ? pronoun.startsWith
   00552|       : [];
   00553|     return contexts.some((context) => surfacePresent(normalized, normalizePrompt(context))) ||
   00554|       startsWith.some((prefix) => {
   00555|         const surface = normalizePrompt(prefix);
   00556|         return normalized.startsWith(surface) && surfacePresent(normalized, surface);
   00557|       });
   00558|   }) || null;
   00559| }
