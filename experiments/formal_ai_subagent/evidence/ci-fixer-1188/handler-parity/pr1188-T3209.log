   00001| // Apply the native agent-mode gate before the browser's actual JavaScript executor.
   00002| // Requested source stays visible on refusal; execution events describe observed results.
   00003| function tryJavaScriptToolRequest(prompt, preferences) {
   00004|   const program = extractJavaScriptProgram(prompt);
   00005|   if (program === null) return null;
   00006|   if (preferences && preferences.agentMode) return tryJavaScriptExecution(prompt);
   00007|   const capability = "tool:javascript_execution";
   00008|   const denial = nlToolText("nl_tool_agent_mode_required", detectLanguage(prompt), { capability });
   00009|   const refusal = nlToolRefusal(nlToolText("nl_tool_requested_source", "en", { denial, program }), [
   00010|     "policy:agent_mode_required_for_tools:" + capability,
   00011|     "execution_status:javascript:refused",
   00012|     "execution_environment:agent-permission-gate",
   00013|   ]);
   00014|   refusal.solverEvents = [{ kind: "policy:agent_mode_required_for_tools", payload: capability }];
   00015|   return refusal;
   00016| }
