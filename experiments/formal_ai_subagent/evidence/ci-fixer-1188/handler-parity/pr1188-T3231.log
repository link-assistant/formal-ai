   00018|         first.intent
   00019|     );
   00020| 
   00021|     let history = [
   00022|         ConversationTurn::user("What is Rust?"),
   00023|         ConversationTurn::assistant(first.answer),
   00024|     ];
   00025|     let response = solver.solve_with_history("Who created it?", &history);
   00026| 
   00027|     assert_eq!(response.intent, "fact_lookup");
   00028|     assert!(
   00029|         response.answer.contains("Graydon Hoare"),
   00030|         "creator answer should name Graydon Hoare, got: {}",
   00031|         response.answer
   00032|     );
   00033|     assert!(
   00034|         response.answer.contains("Mozilla"),
   00035|         "creator answer should include the Mozilla context, got: {}",
   00036|         response.answer
   00037|     );
   00038|     assert!(
   00039|         response
   00040|             .evidence_links
   00041|             .iter()
   00042|             .any(|link| link == "wikidata:Q575650"),
   00043|         "Rust follow-up should keep the Rust Wikidata anchor, got: {:?}",
   00044|         response.evidence_links
