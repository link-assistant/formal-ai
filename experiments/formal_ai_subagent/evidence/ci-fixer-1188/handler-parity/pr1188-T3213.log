   00775| // Mirror probable_local_file_name in src/solver_handlers/web_search_intent.rs.
   00776| // A schemeless attachment/path such as report.txt is a local object, not an
   00777| // HTTPS host. Explicit http(s) URLs still take the authoritative branch below.
   00778| function probableLocalFileName(candidate) {
   00779|   const extension = String(candidate || "").split(".").pop().toLowerCase();
   00780|   return [
   00781|     "txt", "md", "json", "yaml", "yml", "toml", "rs", "py", "js", "ts",
   00782|     "tsx", "jsx", "css", "html", "xml", "csv", "lino", "log", "sh",
   00783|   ].includes(extension);
