   00786| function normalizeUrlCandidate(candidate) {
   00787|   const text = String(candidate || "").trim();
   00788|   if (!text || /\s/.test(text) || text.includes("@")) return null;
   00789|   const lower = text.toLowerCase();
   00790|   let url = "";
   00791|   if (lower.startsWith("http://") || lower.startsWith("https://")) {
   00792|     url = text;
   00793|   } else {
   00794|     const hostCandidate = text.split(/[/?#]/, 1)[0] || "";
   00795|     if (
   00796|       !probableLocalFileName(hostCandidate) &&
   00797|       (lower.startsWith("www.") || looksLikeHostname(hostCandidate))
   00798|     ) {
   00799|       url = `https://${text}`;
   00800|     }
   00801|   }
   00802|   if (!url) return null;
   00803|   let parsed;
   00804|   try {
   00805|     parsed = new URL(url);
   00806|   } catch (_error) {
   00807|     return null;
   00808|   }
   00809|   if (!looksLikeHostname(parsed.hostname)) return null;
   00810|   return parsed.href.replace(/\/$/, "");
