   01182| // Sentence-ending punctuation that can introduce a follow-up instruction
   01183| // clause — ASCII plus the fullwidth/ideographic forms a CJK prompt uses.
   01184| // Mirrors is_sentence_boundary.
   01185| const SEARCH_SENTENCE_BOUNDARY = new Set([
   01186|   ".",
   01187|   "?",
   01188|   "!",
   01189|   ";",
   01190|   ":",
   01191|   "\u3002",
   01192|   "\uff1f",
   01193|   "\uff01",
   01194|   "\uff1b",
   01195|   "\uff1a",
   01196| ]);
   01197| 
   01198| // ASCII-only lowercase: folds A–Z and nothing else, so the result keeps the same
   01199| // length (in UTF-16 code units) as the input and computed offsets stay aligned.
   01200| // Mirrors Rust str::to_ascii_lowercase (a full toLowerCase could change length,
   01201| // e.g. 'İ' -> 'i̇', and misalign the cut offsets).
   01202| function asciiLowercase(value) {
   01203|   return String(value || "").replace(/[A-Z]/g, (character) =>
   01204|     String.fromCharCode(character.charCodeAt(0) + 32),
   01205|   );
   01206| }
   01207| 
   01208| // Is the single Unicode code point `code` a letter or number? Mirrors Rust
   01209| // char::is_alphanumeric closely enough for token-boundary detection.
   01210| function isSearchAlnum(code) {
   01211|   return /[\p{L}\p{N}]/u.test(String.fromCodePoint(code));
   01212| }
   01213| 
   01214| // Does `index` begin a token in `text` (the preceding code point is non-
   01215| // alphanumeric, or there is none)? Surrogate-pair aware. Mirrors is_token_start.
   01216| function isSearchTokenStart(text, index) {
   01217|   if (index <= 0) return true;
   01218|   const i = index - 1;
   01219|   let code = text.charCodeAt(i);
   01220|   if (code >= 0xdc00 && code <= 0xdfff && i > 0) {
   01221|     const high = text.charCodeAt(i - 1);
   01222|     if (high >= 0xd800 && high <= 0xdbff) {
   01223|       code = (high - 0xd800) * 0x400 + (code - 0xdc00) + 0x10000;
   01224|     }
   01225|   }
   01226|   return !isSearchAlnum(code);
   01227| }
   01228| 
   01229| // Does `index` end a token in `text` (the following code point is non-
   01230| // alphanumeric, or there is none)? Mirrors is_token_end.
   01231| function isSearchTokenEnd(text, index) {
   01232|   if (index >= text.length) return true;
   01233|   return !isSearchAlnum(text.codePointAt(index));
   01234| }
   01235| 
   01236| // Whether `haystack` ends with `marker` as a whole token. CJK markers match as
   01237| // bare substrings; space-delimited markers need a preceding whitespace (or for
   01238| // the whole string to be exactly the marker). Mirrors ends_with_token.
   01239| function searchEndsWithToken(haystack, marker) {
   01240|   if (containsCjk(marker)) return haystack.endsWith(marker);
   01241|   if (haystack === marker) return true;
   01242|   if (!haystack.endsWith(marker)) return false;
   01243|   const head = haystack.slice(0, haystack.length - marker.length);
   01244|   return /\s$/u.test(head);
   01245| }
   01246| 
   01247| // If the text immediately before `verbStart` is a follow-up boundary, return the
   01248| // code-unit offset at which to cut (the start of the boundary run); otherwise
   01249| // null. Mirrors boundary_before.
   01250| function searchBoundaryBefore(text, verbStart, markers) {
   01251|   const head = text.slice(0, verbStart).trimEnd();
   01252|   if (head.length === 0) return null;
   01253|   if (SEARCH_SENTENCE_BOUNDARY.has(head[head.length - 1])) return head.length;
   01254|   // Walk back over a run of clause-continuation markers ("and", "then",
   01255|   // "and then"); the cut falls at the start of the run.
   01256|   let cursor = head;
   01257|   let matched = false;
   01258|   for (;;) {
   01259|     const trimmed = cursor.trimEnd();
   01260|     let rest = null;
   01261|     for (const marker of markers.continuationMarkers) {
   01262|       if (searchEndsWithToken(trimmed, marker)) {
   01263|         rest = trimmed.slice(0, trimmed.length - marker.length);
   01264|         break;
   01265|       }
   01266|     }
   01267|     if (rest === null) break;
   01268|     cursor = rest;
   01269|     matched = true;
   01270|   }
   01271|   return matched ? cursor.trimEnd().length : null;
   01272| }
