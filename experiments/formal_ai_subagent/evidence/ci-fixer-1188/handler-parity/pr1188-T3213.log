   01168| function stripSearchNoisePrefix(value, prefix) {
   01169|   const text = cleanSearchQuery(value);
   01170|   return text.toLowerCase().startsWith(prefix)
   01171|     ? cleanSearchQuery(text.slice(prefix.length))
   01172|     : text;
   01173| }
   01174| 
   01175| function stripSearchNoiseSuffix(value, suffix) {
   01176|   const text = cleanSearchQuery(value);
   01177|   return text.toLowerCase().endsWith(suffix)
   01178|     ? cleanSearchQuery(text.slice(0, text.length - suffix.length))
   01179|     : text;
   01180| }
