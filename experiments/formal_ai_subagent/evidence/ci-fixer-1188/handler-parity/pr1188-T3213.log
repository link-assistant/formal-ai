   01116|     trailingNoise: suffixLiterals(ROLE_WEB_SEARCH_QUERY_TRAILING_NOISE),
   01117|     sourceOnly: sourceLiterals(ROLE_WEB_SEARCH_SOURCE_ONLY),
   01118|     sourceMarkers: bareLiterals(ROLE_WEB_SEARCH_SOURCE_ONLY),
   01119|     sourceMediumMarkers: bareLiterals(ROLE_WEB_MEDIUM),
   01120|     informationMarkers: bareLiterals(ROLE_WEB_SEARCH_SIGNAL).filter(
