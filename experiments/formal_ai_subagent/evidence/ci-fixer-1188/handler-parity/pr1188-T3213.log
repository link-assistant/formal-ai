   00586| // The draft table: the seeded intro, a topic column and one column per
   00587| // criterion with the seeded, source-dependent cell instruction in the request's
   00588| // language. Mirrors render_comparison_table in
   00589| // src/solver_handlers/research_table.rs; no topic fact is ever written here.
   00590| function renderResearchComparisonTable(topics, criteria, language) {
   00591|   const procedure = researchTableProcedure();
   00592|   const tableText = procedure.tableTexts.find((entry) => entry.language === language) ||
   00593|     procedure.tableTexts.find((entry) => entry.language === "en") || null;
   00594|   const columnText = (criterion, field) => {
   00595|     const column = researchTableColumn(criterion);
   00596|     return (column && researchLocalizedValue(column[field], language)) || criterion;
   00597|   };
   00598|   let body = `${tableText ? tableText.intro : ""}\n\n| ${tableText ? tableText.topicLabel : ""} |`;
   00599|   for (const criterion of criteria) body += ` ${columnText(criterion, "labels")} |`;
   00600|   body += `\n| --- |${criteria.map(() => " --- |").join("")}\n`;
   00601|   for (const topic of topics) {
   00602|     body += `| ${escapeResearchTableCell(topic)} |`;
   00603|     for (const criterion of criteria) {
   00604|       body += ` ${escapeResearchTableCell(columnText(criterion, "instructions"))} |`;
   00605|     }
