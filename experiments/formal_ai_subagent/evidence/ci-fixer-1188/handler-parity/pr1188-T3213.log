   00349| function tryRecapConversation(history) {
   00350|   if (!Array.isArray(history)) return null;
   00351|   let userIndex = -1;
   00352|   for (let index = history.length - 1; index >= 0; index -= 1) {
   00353|     if (history[index]?.role === "user" && history[index]?.content) {
   00354|       userIndex = index;
   00355|       break;
   00356|     }
   00357|   }
   00358|   if (userIndex < 0) return null;
   00359|   const sentences = [recapPlainSentence(history[userIndex].content)].filter(Boolean);
   00360|   for (let index = history.length - 1; index > userIndex; index -= 1) {
   00361|     if (history[index]?.role !== "assistant" || !history[index]?.content) continue;
   00362|     const status = recapPlainSentence(history[index].content);
   00363|     if (status && status.toLowerCase() !== sentences[0]?.toLowerCase())
   00364|       sentences.push(status);
   00365|     break;
   00366|   }
   00367|   const words = sentences.slice(0, 2).join(" ").split(/\s+/u).filter(Boolean);
   00368|   let content = words.slice(0, 39).join(" ");
   00369|   if (words.length > 39) content = `${content.replace(/[.,;:!?。！？]+$/u, "")}.`;
   00370|   if (!content) return null;
   00371|   return {
   00372|     intent: "summarize_conversation",
   00373|     content,
   00374|     confidence: 0.9,
   00375|     evidence: [
   00376|       "summarize_conversation",
   00377|       "summarization:format:plain",
   00378|       "max_words:39",
   00379|       "max_sentences:2",
   00380|     ],
   00381|   };
   00382| }
