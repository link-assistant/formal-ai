   00384| function tryHistorical(prompt, history) {
   00385|   const normalized = normalizePrompt(prompt);
   00386|   // Issue #386: a conversation-summary request is recognised by composing
   00387|   // meaning roles (see isSummarizePrompt) across every supported language, so
   00388|   // we test it before the empty-normalized bail-out below. Issue #858 selects
   00389|   // the returning-user recap's bounded plain format before the detailed report.
   00390|   if (isReturnRecapPrompt(normalized)) {
   00391|     return tryRecapConversation(history);
   00392|   }
   00393|   if (isSummarizePrompt(normalized)) {
   00394|     return trySummarizeConversation(history);
   00395|   }
   00396|   if (!normalized) return null;
   00397|   // Issue #676: set/recall the assistant's own name from dialog-local history so
   00398|   // "Now your name is Ineffa" is acknowledged and later recalled, instead of
   00399|   // falling through to the unknown opener. Mirrors try_assistant_name in the
   00400|   // Rust conversation-memory handler and runs before the user-name recall below.
   00401|   const assistantName = tryAssistantName(prompt, normalized, history);
   00402|   if (assistantName) return assistantName;
   00403|   if (normalized === "what is my name" || normalized === "what s my name") {
   00404|     const hit = tryRecallName(history);
   00405|     if (hit) return hit;
   00406|   }
   00407|   if (lexiconMentionsRole(ROLE_CONVERSATION_RECALL_PREVIOUS_USER_MESSAGE, normalized)) {
   00408|     return tryRecallLastQuestion(prompt, history);
   00409|   }
   00410|   // Issue #529: recognise "what was written in the previous message?" across
   00411|   // every supported language via the conversation_recall_previous_message seed
   00412|   // role after the user-message recall above, so "what did I ask in the
   00413|   // previous message" targets the user's prior turn rather than the assistant's.
   00414|   const previousMessage = tryRecallPreviousMessage(prompt, history);
   00415|   if (previousMessage) return previousMessage;
   00416|   return null;
   00417| }
