   01054| // The literal lead-in (form.before, the text before the … slot) of every
   01055| // prefix-slot form of a role, in lexicon declaration order. A meaning's roles
   01056| // apply to all its forms, so keep only the slot we asked for. Mirrors
   01057| // prefix_literals.
   01058| function prefixLiterals(role) {
   01059|   return roleWordForms(role)
   01060|     .filter((form) => form.slot === "prefix")
   01061|     .map((form) => form.before);
   01062| }
   01063| // The literal tail (form.after) of every suffix-slot form of a role. Mirrors
   01064| // suffix_literals.
   01065| function suffixLiterals(role) {
   01066|   return roleWordForms(role)
   01067|     .filter((form) => form.slot === "suffix")
   01068|     .map((form) => form.after);
   01069| }
   01070| // The literal pair around every circumfix-slot form of a role. Mirrors
   01071| // circumfix_literals.
   01072| function circumfixLiterals(role) {
   01073|   return roleWordForms(role)
   01074|     .filter((form) => form.slot === "circumfix")
   01075|     .map((form) => ({ before: form.before, after: form.after }));
   01076| }
   01077| // The surface text of every bare-slot form of a role (drop any prefix/suffix
   01078| // surfaces the same meaning also owns). Mirrors bare_literals.
   01079| function bareLiterals(role) {
   01080|   return roleWordForms(role)
   01081|     .filter((form) => form.slot === "bare")
   01082|     .map((form) => form.text);
   01083| }
   01084| // The distinct surface words of a role, trimmed + lowercased for equality
   01085| // comparison against a cleaned query. Mirrors source_literals (words_for_role).
   01086| function sourceLiterals(role) {
   01087|   const seen = new Set();
   01088|   const out = [];
   01089|   for (const form of roleWordForms(role)) {
   01090|     const key = form.text.trim().toLowerCase();
   01091|     if (!seen.has(key)) {
   01092|       seen.add(key);
   01093|       out.push(key);
   01094|     }
   01095|   }
   01096|   return out;
   01097| }
