   00508|   const text = seedRawText(SEED_RAW, "research-table-procedure.lino");
   00509|   const root = text
   00510|     ? parseLinoTree(text).children.find((node) => node.name === "research_table_procedure")
   00511|     : null;
   00512|   const records = root ? root.children : [];
   00513|   const localized = (node, name) => linoChildValues(node, name).map((raw) => {
   00514|     const value = String(raw || "");
   00515|     const space = value.search(/\s/u);
   00516|     if (space < 0) return null;
   00517|     const text = value.slice(space).trim().replace(/^"+|"+$/gu, "").split('""').join('"');
   00518|     return { language: value.slice(0, space), text };
   00519|   }).filter(Boolean);
   00520|   const named = (name) => records.filter((node) => node.name === name);
   00521|   const procedure = {
   00522|     statuses: named("status").map((node) => ({
   00523|       slug: node.value,
   00524|       markers: linoChildValues(node, "marker").map((marker) => String(marker).toLowerCase()),
   00525|     })),
   00526|     tableTexts: named("table_text").map((node) => ({
   00527|       language: node.value,
   00528|       intro: childValue(node, "intro"),
   00529|       topicLabel: childValue(node, "topic_label"),
   00530|     })),
   00531|     criteria: named("criterion").map((node) => ({
   00532|       slug: node.value,
   00533|       labels: localized(node, "label"),
   00534|       instructions: localized(node, "instruction"),
   00535|     })),
   00536|     followupRequests: named("followup_request").map((node) => String(node.value).toLowerCase()),
   00537|   };
   00538|   if (text) cachedResearchTableProcedure = procedure;
   00539|   return procedure;
   00540| }
