   00419| // Issue #386 research comparison-table roles — mirror the ROLE_COMPARISON_*
   00420| // and ROLE_RESEARCH_* consts in src/seed/roles.rs. The strong trigger, the weak
   00421| // table-noun/difference-cue pair, the research-prompt signals (bare markers plus
   00422| // prefix surfaces), and the per-column criterion words all live in
   00423| // data/seed/meanings-research-table.lino (loaded into MEANINGS_LINO), so
   00424| // the handler references the concepts, not raw words in one language.
   00425| const ROLE_COMPARISON_TABLE_TRIGGER = "comparison_table_trigger";
   00426| const ROLE_COMPARISON_TABLE_NOUN = "comparison_table_noun";
   00427| const ROLE_COMPARISON_DIFFERENCE_CUE = "comparison_difference_cue";
   00428| const ROLE_RESEARCH_PROMPT_SIGNAL = "research_prompt_signal";
   00429| const ROLE_RESEARCH_CRITERION = "research_criterion";
   00430| 
   00431| // True when the prompt asks for a comparison drawn as a table: a strong
   00432| // comparison_table_trigger, or the weak pair of a comparison_table_noun and a
   00433| // comparison_difference_cue — each token-bounded across every supported
   00434| // language. Mirrors is_comparison_table_request in
   00435| // src/solver_handlers/research_table.rs.
   00436| function isComparisonTableRequest(normalized) {
   00437|   return (
   00438|     lexiconMentionsRole(ROLE_COMPARISON_TABLE_TRIGGER, normalized) ||
   00439|     (lexiconMentionsRole(ROLE_COMPARISON_TABLE_NOUN, normalized) &&
   00440|       lexiconMentionsRole(ROLE_COMPARISON_DIFFERENCE_CUE, normalized))
   00441|   );
   00442| }
