   00015|     // Issue #386: the inverse of reverse_sort — cancel the descending order
   00016|     // over the same program-output target.
   00017|     return {
   00018|       operation: "cancel",
   00019|       operationModifier: "reverse_sort",
   00020|       target: "program:last.output_order",
   00021|       targetKind: "program_output",
   00022|     };
   00023|   }
   00024|   if (modifier === "path_argument") {
   00025|     return {
   00026|       operation: "accept",
   00027|       operationModifier: "path_argument",
   00028|       target: "program:last.input",
   00029|       targetKind: "program_input",
