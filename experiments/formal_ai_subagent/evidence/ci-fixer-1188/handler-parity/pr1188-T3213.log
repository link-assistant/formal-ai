   01107|     explicitCircumfixes: circumfixLiterals(ROLE_WEB_SEARCH_EXPLICIT_PREFIX),
   01108|     actionMarkers: bareLiterals(ROLE_WEB_SEARCH_ACTION),
   01109|     strongActionMarkers: bareLiterals(ROLE_WEB_SEARCH_STRONG_ACTION),
   01110|     strongImperativeLeadMarkers: prefixLiterals(ROLE_WEB_SEARCH_STRONG_ACTION),
   01111|     signalMarkers: bareLiterals(ROLE_WEB_SEARCH_SIGNAL),
   01112|     topicAfterMarkers: prefixLiterals(ROLE_WEB_SEARCH_TOPIC_MARKER),
   01113|     topicBeforeMarkers: suffixLiterals(ROLE_WEB_SEARCH_TOPIC_MARKER),
   01114|     imperativeLeadMarkers: prefixLiterals(ROLE_WEB_SEARCH_IMPERATIVE_LEAD),
