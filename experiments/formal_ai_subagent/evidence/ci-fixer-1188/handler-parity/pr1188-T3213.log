   00681| // Issue #386: a conversation-summary request is recognised by composing
   00682| // meaning roles, not by matching raw words per language. The universal
   00683| // algorithm is identical for every language: the prompt either carries a
   00684| // complete standalone conversation-summary phrasing, an objectless courtesy
   00685| // frame ("can you summarize", "подведи итог"), a summary directive together
   00686| // with an explicit conversation reference, or it is itself a bare summary
   00687| // directive. The prompt is re-normalised first so the boundary-aware matcher
   00688| // sees punctuation collapsed to spaces (idempotent here, since `normalized`
   00689| // is already normalised). Mirror of asks_for_conversation_summary in
   00690| // src/solver_handlers/mod.rs.
   00691| function isSummarizePrompt(normalized) {
   00692|   const cleaned = normalizePrompt(normalized);
   00693|   return (
   00694|     isReturnRecapPrompt(cleaned) ||
   00695|     lexiconMentionsRole(ROLE_CONVERSATION_SUMMARY_PHRASE, cleaned) ||
   00696|     (lexiconMentionsRole(ROLE_CONVERSATION_SUMMARY_COURTESY, cleaned) &&
   00697|       courtesyFrameLeavesNoObject(cleaned)) ||
   00698|     (lexiconMentionsRole(ROLE_CONVERSATION_SUMMARY_DIRECTIVE, cleaned) &&
   00699|       lexiconMentionsRole(ROLE_CONVERSATION_REFERENCE, cleaned)) ||
   00700|     summaryDirectiveLeads(cleaned)
   00701|   );
   00702| }
   00703| 
   00704| // The courtesy frames are frames, not owners: "can you summarize" opens a
   00705| // request whose object, when one follows, belongs to whichever handler
   00706| // summarizes that object. Stripping every courtesy and directive surface
   00707| // from the prompt must leave nothing — "can you summarize" alone summarizes
   00708| // the running conversation, "can you summarize Rust" names a topic. Longest
   00709| // surfaces strip first so a frame that prefixes another ("подведи итог"
   00710| // inside "подведи итоги") leaves no orphan letters. Mirror of
   00711| // courtesy_frame_leaves_no_object in
   00712| // src/solver_handlers/conversation_memory/conversation_summary.rs.
   00713| function courtesyFrameLeavesNoObject(cleaned) {
   00714|   const surfaces = [
   00715|     ...wordsForRole(ROLE_CONVERSATION_SUMMARY_COURTESY),
   00716|     ...wordsForRole(ROLE_CONVERSATION_SUMMARY_DIRECTIVE),
   00717|   ]
   00718|     .filter(Boolean)
   00719|     .sort((a, b) => b.length - a.length);
   00720|   let remainder = cleaned;
   00721|   for (const surface of surfaces) {
   00722|     remainder = remainder.split(surface).join(" ");
   00723|   }
   00724|   // Whitespace and ASCII punctuation are the only leftovers an objectless
   00725|   // frame may show ("can you summarize?", "summarize!").
   00726|   return !remainder.replace(
   00727|     /[\s\x21-\x2f\x3a-\x40\x5b-\x60\x7b-\x7e]/gu,
   00728|     "",
   00729|   );
   00730| }
   00731| 
   00732| function isReturnRecapPrompt(normalized) {
   00733|   return lexiconMentionsRole(
   00734|     ROLE_CONVERSATION_RETURN_RECAP,
   00735|     normalizePrompt(normalized),
   00736|   );
   00737| }
