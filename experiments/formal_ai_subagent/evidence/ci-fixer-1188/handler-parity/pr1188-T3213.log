   01156| function containsSearchMarker(normalized, marker) {
   01157|   const text = String(normalized || "");
   01158|   if (marker.startsWith(" ") || marker.endsWith(" ")) {
   01159|     return ` ${text} `.includes(marker);
   01160|   }
   01161|   return text.includes(marker);
   01162| }
   01163| 
   01164| function containsAnySearchMarker(normalized, markers) {
   01165|   return markers.some((marker) => containsSearchMarker(normalized, marker));
   01166| }
