   00335| function recapPlainSentence(text) {
   00336|   let plain = String(text || "")
   00337|     .replace(/```[\s\S]*?```|~~~[\s\S]*?~~~/gu, " ")
   00338|     .replace(/^\s*(?:#{1,6}|[-+>*])\s*/gmu, " ")
   00339|     .replace(/[#`*]/gu, "")
   00340|     .replace(/\s+/gu, " ")
   00341|     .trim()
   00342|     .split(/\s+[—–]\s+/u)[0];
   00343|   const sentence = plain.match(/^.*?(?:[.!?](?=\s|$)|[。！？])/u);
   00344|   if (sentence) plain = sentence[0];
   00345|   if (plain && !/[.!?。！？]$/u.test(plain)) plain += ".";
   00346|   return plain;
   00347| }
