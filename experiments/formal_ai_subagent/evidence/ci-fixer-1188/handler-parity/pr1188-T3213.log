   00758| function looksLikeHostname(value) {
   00759|   const host = String(value || "").trim();
   00760|   if (!host.includes(".") || host.startsWith(".") || host.endsWith(".")) {
   00761|     return false;
   00762|   }
   00763|   const labels = host.split(".");
   00764|   if (labels.some((label) => !label)) return false;
   00765|   const tld = labels[labels.length - 1] || "";
   00766|   if (tld.length < 2) return false;
   00767|   return labels.every(
   00768|     (label) =>
   00769|       /^[a-z0-9-]+$/i.test(label) &&
   00770|       !label.startsWith("-") &&
   00771|       !label.endsWith("-"),
   00772|   );
