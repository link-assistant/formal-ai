   00118|     `  candidate ${candidateId}`,
   00119|     "  fixture list_files_output_order",
   00120|     "  input a.txt,b.txt,c.txt",
   00121|     `  expected_order ${expectedOrder}`,
   00122|     `  lowering_check ${planCheck ? "passed" : "failed"}`,
   00123|     `  render_check ${renderCheck ? "passed" : "failed"}`,
   00124|     `  status ${passed ? "passed" : "failed"}`,
