   00855| // Issue #529: natural-language *writes* to the entire associative memory. This
   00856| // is the browser mirror of src/solver_handlers/conversation_memory/memory_write.rs
   00857| // — the write half of the Turing-complete memory primitive (a recall reads, an
   00858| // append extends, a substitution rewrites). Both recognisers are driven by the
   00859| // seed lexicon (ROLE_MEMORY_*), so they extend to every supported language
   00860| // automatically. The actual persistence happens in the app (main.jsx applies the
   00861| // returned memoryOperation to IndexedDB); the worker stays pure by computing the
   00862| // substitution count over a memory snapshot the app passes in.
   00863| 
   00864| // Recognise a "remember …" append directive in any language. The surfaces are
   00865| // Slot::Prefix forms (trailing …), so each form's literal-before-the-slot is the
   00866| // matchable prefix. Matching runs on a lowercased copy of the raw prompt and
   00867| // longer prefixes win first, so "remember that X" beats "remember X". Mirrors
   00868| // recognize_memory_append.
   00869| function recognizeMemoryAppend(prompt) {
   00870|   const trimmed = String(prompt || "").replace(/^\s+/, "");
   00871|   const lowered = trimmed.toLowerCase();
   00872|   const prefixes = roleWordForms(ROLE_MEMORY_APPEND_DIRECTIVE)
   00873|     .filter((form) => form.slot === "prefix")
   00874|     .map((form) => form.before)
   00875|     .filter((prefix) => prefix.length > 0);
   00876|   prefixes.sort((a, b) => b.length - a.length);
   00877|   for (const prefix of prefixes) {
   00878|     if (lowered.startsWith(prefix)) {
   00879|       const statement = cleanMemoryWriteText(trimmed.slice(prefix.length));
   00880|       if (statement) return statement;
   00881|     }
   00882|   }
   00883|   return null;
   00884| }
