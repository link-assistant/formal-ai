   00025|   const sourceFirstLetter = Array.from(sourceTrimmed).find((character) =>
   00026|     /\p{L}/u.test(character),
   00027|   );
   00028|   if (!sourceFirstLetter) return withTerminal;
   00029|   const targetChars = Array.from(withTerminal);
   00030|   const targetFirstIdx = targetChars.findIndex((character) => /\p{L}/u.test(character));
   00031|   if (targetFirstIdx === -1) return withTerminal;
   00032|   const targetFirstLetter = targetChars[targetFirstIdx];
   00033|   const sourceLower = sourceFirstLetter.toLowerCase() === sourceFirstLetter
   00034|     && sourceFirstLetter.toUpperCase() !== sourceFirstLetter;
   00035|   const sourceUpper = sourceFirstLetter.toUpperCase() === sourceFirstLetter
   00036|     && sourceFirstLetter.toLowerCase() !== sourceFirstLetter;
   00037|   const targetLower = targetFirstLetter.toLowerCase() === targetFirstLetter
   00038|     && targetFirstLetter.toUpperCase() !== targetFirstLetter;
   00039|   const targetUpper = targetFirstLetter.toUpperCase() === targetFirstLetter
   00040|     && targetFirstLetter.toLowerCase() !== targetFirstLetter;
   00041|   if (sourceLower && targetUpper) {
   00042|     targetChars[targetFirstIdx] = targetFirstLetter.toLowerCase();
   00043|     return targetChars.join("");
   00044|   }
   00045|   if (sourceUpper && targetLower) {
   00046|     targetChars[targetFirstIdx] = targetFirstLetter.toUpperCase();
   00047|     return targetChars.join("");
   00048|   }
   00049|   return withTerminal;
   00050| }
