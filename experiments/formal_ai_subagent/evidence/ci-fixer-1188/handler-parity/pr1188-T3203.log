   00892| function recognizeMemorySubstitution(normalized) {
   00893|   if (!lexiconMentionsRole(ROLE_MEMORY_SCOPE, normalized)) return null;
   00894|   const withoutScope = stripFirstMemorySurface(normalized, ROLE_MEMORY_SCOPE);
   00895|   if (withoutScope === null) return null;
   00896|   const operands = stripFirstMemorySurface(
   00897|     withoutScope,
   00898|     ROLE_MEMORY_SUBSTITUTION_DIRECTIVE,
   00899|   );
   00900|   if (operands === null) return null;
   00901|   const split = splitOnceMemorySurface(
   00902|     operands,
   00903|     ROLE_MEMORY_SUBSTITUTION_CONNECTOR,
   00904|   );
   00905|   if (!split) return null;
   00906|   const oldValue = cleanMemoryWriteText(split[0]);
   00907|   const newValue = cleanMemoryWriteText(split[1]);
   00908|   if (!oldValue || !newValue) return null;
   00909|   return { oldValue, newValue };
   00910| }
   00911| 
   00912| // Total substring occurrences of `old` across every searchable value in the
   00913| // memory snapshot. Mirrors MemoryStore::apply_substitution's count, which sums
   00914| // replace_counting over each event's content/inputs/outputs/title/label and
   00915| // every evidence entry. The app builds the snapshot from those same fields, so
   00916| // the worker's reported count matches the rewrite the app applies to IndexedDB.
   00917| function countMemoryOccurrences(memory, old) {
   00918|   if (!old) return 0;
   00919|   const values = Array.isArray(memory) ? memory : [];
   00920|   let count = 0;
   00921|   for (const value of values) {
   00922|     const text = String(value || "");
   00923|     if (!text.includes(old)) continue;
   00924|     count += text.split(old).length - 1;
   00925|   }
   00926|   return count;
   00927| }
   00928| 
   00929| function renderMemoryAppendAnswer(statement, language) {
   00930|   if (language === "ru") return `Запомнил: ${statement}`;
   00931|   if (language === "zh") return `已记住:${statement}`;
   00932|   if (language === "hi") return `स्मृति में सहेजा गया: ${statement}`;
   00933|   return `Recorded memory: ${statement}`;
   00934| }
   00935| 
   00936| function renderMemorySubstitutionAnswer(oldValue, newValue, applied, language) {
   00937|   if (language === "ru") {
   00938|     return `Заменил "${oldValue}" на "${newValue}" в памяти (обновлено вхождений: ${applied}).`;
   00939|   }
   00940|   if (language === "zh") {
   00941|     return `已在记忆中将"${oldValue}"替换为"${newValue}"(更新 ${applied} 处)。`;
   00942|   }
   00943|   if (language === "hi") {
   00944|     return `स्मृति में "${oldValue}" को "${newValue}" से बदला (${applied})।`;
   00945|   }
   00946|   return `Replaced "${oldValue}" with "${newValue}" in memory (${applied} occurrence(s) updated).`;
   00947| }
   00948| 
   00949| // Recognise a natural-language memory write and return an answer carrying a
   00950| // structured `memoryOperation` for the app to persist. Substitution is tried
   00951| // before append because a substitution prompt also begins with a directive verb.
   00952| // Mirrors try_memory_write + recognize_memory_write.
   00953| function tryMemoryWrite(prompt, normalized, memory) {
   00954|   const substitution = recognizeMemorySubstitution(normalized);
   00955|   if (substitution) {
   00956|     const language = detectLanguage(prompt);
   00957|     const applied = countMemoryOccurrences(memory, substitution.oldValue);
   00958|     return {
   00959|       intent: "memory_substitution",
   00960|       content: renderMemorySubstitutionAnswer(
   00961|         substitution.oldValue,
   00962|         substitution.newValue,
   00963|         applied,
   00964|         language,
   00965|       ),
   00966|       confidence: 0.9,
   00967|       evidence: [
   00968|         "memory_substitution",
   00969|         "substitution_event:update",
   00970|         `substitution:applied=${applied}`,
   00971|         "response:memory_substitution",
   00972|       ],
   00973|       memoryOperation: {
   00974|         action: "substitute",
   00975|         oldValue: substitution.oldValue,
   00976|         newValue: substitution.newValue,
   00977|         applied,
   00978|       },
   00979|     };
   00980|   }
   00981|   const statement = recognizeMemoryAppend(prompt);
   00982|   if (statement) {
   00983|     const language = detectLanguage(prompt);
   00984|     return {
   00985|       intent: "memory_write",
   00986|       content: renderMemoryAppendAnswer(statement, language),
   00987|       confidence: 0.9,
   00988|       evidence: [
   00989|         "memory_write",
   00990|         "memory_write:natural_language",
   00991|         "response:memory_write",
   00992|       ],
   00993|       memoryOperation: { action: "append", statement },
   00994|     };
   00995|   }
   00996|   return null;
   00997| }
