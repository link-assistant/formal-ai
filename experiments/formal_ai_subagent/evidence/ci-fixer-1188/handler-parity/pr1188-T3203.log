   00081| function translateRussianWordSequence(words) {
   00082|   const translated = [];
   00083|   for (let index = 0; index < words.length; index += 1) {
   00084|     const word = words[index];
   00085|     const next = words[index + 1];
   00086|     if (
   00087|       next &&
   00088|       roleListsSurface(ROLE_COMPOSITIONAL_GENITIVE_HEAD, "ru", word) &&
   00089|       roleActionSurfaceTranslation(ROLE_COMPOSITIONAL_LEMMA, "genitive", "ru", "en", next)
   00090|     ) {
   00091|       translated.push(
   00092|         roleSurfaceTranslation(ROLE_COMPOSITIONAL_LEMMA, "ru", "en", word),
   00093|         "of",
   00094|         roleActionSurfaceTranslation(ROLE_COMPOSITIONAL_LEMMA, "genitive", "ru", "en", next),
   00095|       );
   00096|       index += 1;
   00097|       continue;
   00098|     }
   00099|     const surface = roleSurfaceTranslation(ROLE_COMPOSITIONAL_LEMMA, "ru", "en", word);
   00100|     if (!surface) return null;
   00101|     translated.push(surface);
   00102|   }
   00103|   return capitalizeAsciiFirst(translated.join(" "));
   00104| }
