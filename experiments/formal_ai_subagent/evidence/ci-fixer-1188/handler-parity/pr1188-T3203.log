   00151| function detectQuestionMarkerLanguage(text, counts) {
   00152|   const normalized = String(text || "").toLocaleLowerCase();
   00153|   let best = null;
   00154|   for (const candidate of [
   00155|     { slug: "ru", count: counts.cyrillic },
   00156|     { slug: "hi", count: counts.devanagari },
   00157|     { slug: "zh", count: counts.cjk },
   00158|   ]) {
   00159|     if (candidate.count <= 0) continue;
   00160|     const markers = QUESTION_LANGUAGE_MARKERS[candidate.slug] || [];
   00161|     if (!markers.some((marker) => normalized.includes(marker))) continue;
   00162|     if (!best || candidate.count > best.count) best = candidate;
   00163|   }
   00164|   return best ? best.slug : null;
   00165| }
