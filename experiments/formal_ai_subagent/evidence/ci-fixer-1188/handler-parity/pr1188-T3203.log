   00999| // Issue #27: deterministic, logical summarisation — no neural net. We
   01000| // project the conversation onto a small set of features (turn counts, intents,
   01001| // concepts, languages, unanswered questions) and render them as a structured
   01002| // Markdown report. Every value is derived directly from the append-only event
   01003| // log so reruns on the same input produce byte-identical output.
   01004| function trySummarizeConversation(history) {
   01005|   if (!Array.isArray(history) || history.length === 0) return null;
   01006|   const turns = history.filter((turn) => turn && turn.content);
   01007|   if (turns.length === 0) return null;
   01008| 
   01009|   let userCount = 0;
   01010|   let assistantCount = 0;
   01011|   const intentCounts = new Map();
   01012|   const languages = new Map();
   01013|   const concepts = new Set();
   01014|   const calculations = [];
   01015|   const programTemplates = new Set();
   01016|   const unanswered = [];
   01017|   let lastUser = null;
   01018| 
   01019|   for (const turn of turns) {
   01020|     const role = turn.role || "assistant";
   01021|     const language = detectLanguage(turn.content);
   01022|     languages.set(language, (languages.get(language) || 0) + 1);
   01023|     if (role === "user") {
   01024|       userCount += 1;
   01025|       lastUser = turn.content;
   01026|     } else {
   01027|       assistantCount += 1;
   01028|       if (lastUser) {
   01029|         lastUser = null;
   01030|       }
   01031|       const intent = String(turn.intent || "unknown");
   01032|       intentCounts.set(intent, (intentCounts.get(intent) || 0) + 1);
   01033|       if (intent === "calculation" && typeof turn.content === "string") {
   01034|         const match = turn.content.match(/^([^=]+=\s*[^\n]+)/);
   01035|         if (match) calculations.push(match[1].trim());
   01036|       }
   01037|       if (intent === "write_program") {
   01038|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01039|         const languageEvidence = evidence.find((item) =>
   01040|           String(item || "").startsWith("program_parameter:language:"),
   01041|         );
   01042|         const taskEvidence = evidence.find((item) =>
   01043|           String(item || "").startsWith("program_parameter:task:"),
   01044|         );
   01045|         const generatedLanguage = languageEvidence
   01046|           ? String(languageEvidence).slice("program_parameter:language:".length)
   01047|           : "unknown";
   01048|         const generatedTask = taskEvidence
   01049|           ? String(taskEvidence).slice("program_parameter:task:".length)
   01050|           : "program";
   01051|         programTemplates.add(`${generatedTask}/${generatedLanguage}`);
   01052|       }
   01053|       if (intent.startsWith("hello_world_")) {
   01054|         programTemplates.add(`hello_world/${intent.slice("hello_world_".length)}`);
   01055|       }
   01056|       if (intent.startsWith("concept_lookup")) {
   01057|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01058|         for (const item of evidence) {
   01059|           if (typeof item !== "string") continue;
   01060|           const conceptMatch = item.match(/^concept_lookup:request:(.+)$/);
   01061|           if (conceptMatch) concepts.add(conceptMatch[1]);
   01062|         }
   01063|       }
   01064|     }
   01065|   }
   01066|   if (lastUser) {
   01067|     unanswered.push(lastUser);
   01068|   }
   01069| 
   01070|   const lines = [];
   01071|   lines.push("## Conversation summary");
   01072|   lines.push("");
   01073|   lines.push(
   01074|     `- ${turns.length} turn(s): ${userCount} user, ${assistantCount} assistant`,
   01075|   );
   01076|   if (languages.size > 0) {
   01077|     const list = Array.from(languages.entries())
   01078|       .sort((a, b) => b[1] - a[1])
   01079|       .map(([lang, count]) => `${lang} (${count})`)
   01080|       .join(", ");
   01081|     lines.push(`- Languages: ${list}`);
   01082|   }
   01083|   if (intentCounts.size > 0) {
   01084|     const list = Array.from(intentCounts.entries())
   01085|       .sort((a, b) => b[1] - a[1])
   01086|       .map(([intent, count]) => `${intent} (${count})`)
   01087|       .join(", ");
   01088|     lines.push(`- Intents: ${list}`);
   01089|   }
   01090|   if (concepts.size > 0) {
   01091|     lines.push(`- Concepts looked up: ${Array.from(concepts).join(", ")}`);
   01092|   }
   01093|   if (calculations.length > 0) {
   01094|     lines.push(`- Calculations: ${calculations.join("; ")}`);
   01095|   }
   01096|   if (programTemplates.size > 0) {
   01097|     lines.push(
   01098|       `- Program templates generated: ${Array.from(programTemplates).join(", ")}`,
   01099|     );
   01100|   }
   01101|   if (unanswered.length > 0) {
   01102|     lines.push(`- Unanswered: ${unanswered.join(" | ")}`);
   01103|   }
   01104| 
   01105|   const evidence = [
   01106|     "summarize_conversation",
   01107|     `turns:${turns.length}`,
   01108|     `users:${userCount}`,
   01109|     `assistants:${assistantCount}`,
   01110|   ];
   01111|   if (intentCounts.size > 0) {
   01112|     evidence.push(`intents:${Array.from(intentCounts.keys()).join("|")}`);
   01113|   }
   01114|   return {
   01115|     intent: "summarize_conversation",
   01116|     content: lines.join("\n"),
   01117|     confidence: 0.9,
   01118|     evidence,
   01119|   };
   01120| }
   01121| 
   01122| // Issue #918: the compound-interest row holds no vocabulary, prose or rate.
   01123| // The cue words are the finance and currency meanings of the seed lexicon; the
   01124| // wording is the seeded compound_interest_* responses; the periods per
   01125| // compounding meaning, the frequency labels, the default exchange rates and
   01126| // the final-amount marker are the `policy compound_interest` block of
   01127| // data/seed/handler-rules.lino. Mirrors src/solver_handlers/compound_interest.rs.
   01128| // A function, not a const array, so the ROLE_* consts stay out of the TDZ.
   01129| function compoundCurrencies() {
   01130|   return [
   01131|     [ROLE_CURRENCY_EUR_REFERENCE, "EUR"],
   01132|     [ROLE_CURRENCY_USD_REFERENCE, "USD"],
   01133|     [ROLE_CURRENCY_RUB_REFERENCE, "RUB"],
   01134|   ];
   01135| }
   01136| const COMPOUND_PRINCIPAL_CURRENCY = "USD";
   01137| 
   01138| function compoundPolicy(key) {
   01139|   return handlerRulesPolicy("compound_interest", key) || "";
   01140| }
   01141| 
   01142| function compoundResponse(intent, values = {}) {
   01143|   let text = answerFor(intent, "en");
   01144|   for (const [name, value] of Object.entries(values)) text = text.split(`{${name}}`).join(String(value));
   01145|   return text;
   01146| }
   01147| 
   01148| function tryCompoundInterest(prompt, normalized, history) {
   01149|   const request = parseCompoundInterestRequest(prompt, normalized);
   01150|   if (request) return answerCompoundInterest(request);
   01151| 
   01152|   const conversion = parseFinalAmountConversionRequest(normalized, history);
   01153|   if (conversion) return answerFinalAmountConversion(conversion);
   01154| 
   01155|   return null;
   01156| }
   01157| 
   01158| function answerCompoundInterest(request) {
   01159|   const annualRate = request.annualRatePercent / 100;
   01160|   const periodsPerYear = request.compoundsPerYear;
   01161|   const periodicRate = annualRate / periodsPerYear;
   01162|   const periods = periodsPerYear * request.years;
   01163|   const finalAmount =
   01164|     request.principal * Math.pow(1 + periodicRate, periods);
   01165| 
   01166|   const evidence = [
   01167|     `calculation:compound_interest:P=${formatCompoundNumber(request.principal)};r=${formatCompoundRate(annualRate)};n=${periodsPerYear};t=${formatCompoundNumber(request.years)}`,
   01168|     "calculation:formula:A=P(1+r/n)^(n*t)",
   01169|   ];
   01170|   let content = compoundResponse("compound_interest_report", {
   01171|     principal: formatCompoundNumber(request.principal),
   01172|     rate: formatCompoundRate(annualRate),
   01173|     percent: formatCompoundNumber(request.annualRatePercent),
   01174|     periods_per_year: periodsPerYear,
   01175|     frequency: compoundPolicy(`label-${periodsPerYear}`) || compoundPolicy("label-other"),
   01176|     years: formatCompoundNumber(request.years),
   01177|     periodic_rate: formatCompoundRate(periodicRate),
   01178|     periods: formatCompoundNumber(periods),
   01179|     final_amount: formatCompoundMoney(finalAmount),
   01180|   });
   01181| 
   01182|   if (request.targetCurrency) {
   01183|     content += compoundConversion(
   01184|       evidence,
   01185|       finalAmount,
   01186|       COMPOUND_PRINCIPAL_CURRENCY,
   01187|       request.targetCurrency,
   01188|       request.asksForWebRate,
   01189|     );
   01190|   }
   01191| 
   01192|   return {
   01193|     intent: "calculation",
   01194|     content,
   01195|     confidence: 1.0,
   01196|     evidence,
   01197|   };
   01198| }
   01199| 
   01200| function answerFinalAmountConversion(conversion) {
   01201|   const evidence = ["calculation:final_amount_conversion"];
   01202|   const content =
   01203|     compoundResponse("compound_interest_final_amount_conversion", {
   01204|       amount: formatCompoundMoney(conversion.amount),
   01205|       source: conversion.sourceCurrency,
   01206|     }) +
   01207|     compoundConversion(
   01208|       evidence,
   01209|       conversion.amount,
   01210|       conversion.sourceCurrency,
   01211|       conversion.targetCurrency,
   01212|       conversion.asksForWebRate,
   01213|     );
   01214|   return {
   01215|     intent: "calculation",
   01216|     content,
   01217|     confidence: 1.0,
   01218|     evidence,
   01219|   };
   01220| }
   01221| 
   01222| // The conversion paragraph appended to a report: the seeded default rate,
   01223| // the converted amount, and the rate detail; or the honest no-rate sentence.
   01224| function compoundConversion(evidence, amount, source, target, asksForWebRate) {
   01225|   const rate = compoundDefaultRate(source, target);
   01226|   if (rate === null) {
   01227|     evidence.push(`calculation:currency_conversion:error:${source}->${target}`);
   01228|     return `\n\n${compoundResponse("compound_interest_rate_unavailable", { source, target })}`;
   01229|   }
   01230|   const displayedAmount = roundCompoundMoney(amount);
   01231|   const converted = displayedAmount * rate;
   01232|   evidence.push(
   01233|     `calculation:currency_conversion:${formatCompoundMoney(displayedAmount)} ${source} to ${target} at ${formatCompoundRate(rate)}`,
   01234|   );
   01235|   const expression = compoundPolicy("rate-expression").split("{source}").join(source).split("{target}").join(target);
   01236|   let text = `\n\n${compoundResponse("compound_interest_conversion", {
   01237|     source,
   01238|     target,
   01239|     expression,
   01240|     rate: formatCompoundRate(rate),
   01241|     amount: formatCompoundMoney(displayedAmount),
   01242|     converted: formatCompoundMoney(converted),
   01243|   })}`;
   01244|   text += `\n${compoundResponse("compound_interest_rate_detail", { source, target, rate: formatCompoundRate(rate) })}`;
   01245|   if (asksForWebRate) text += `\n${compoundResponse("compound_interest_live_rate_note")}`;
   01246|   return text;
   01247| }
   01248| 
   01249| // The seeded default rate from `source` to `target`: the direct pair, or the
   01250| // inverse of the reverse pair.
   01251| function compoundDefaultRate(source, target) {
   01252|   const direct = compoundRateNumber(compoundPolicy(`rate_${source}_${target}`));
   01253|   if (direct !== null) return direct;
   01254|   const reverse = compoundRateNumber(compoundPolicy(`rate_${target}_${source}`));
   01255|   return reverse === null || reverse === 0 ? null : 1 / reverse;
   01256| }
   01257| 
   01258| function compoundRateNumber(text) {
   01259|   return /^\d+(?:\.\d+)?$/.test(text) ? Number(text) : null;
   01260| }
   01261| 
   01262| function parseCompoundInterestRequest(prompt, normalized) {
   01263|   // The investment / interest / compounding cues are language-independent
   01264|   // meanings carried by the finance lexicon, matched as raw substrings of the
   01265|   // normalized prompt. Mirrors parse_compound_interest_request.
   01266|   if (
   01267|     !lexiconMentionsRoleSubstring(ROLE_INVESTMENT_CUE, normalized) ||
   01268|     !lexiconMentionsRoleSubstring(ROLE_INTEREST_CUE, normalized) ||
   01269|     !lexiconMentionsRoleSubstring(ROLE_COMPOUNDING_ACTION_CUE, normalized)
   01270|   ) {
   01271|     return null;
   01272|   }
   01273|   const principal = parseCompoundCurrencyAmount(prompt);
   01274|   const annualRatePercent = parseCompoundPercentBeforeSymbol(prompt);
   01275|   const compoundsPerYear = parseCompoundsPerYear(normalized);
   01276|   const years = parseCompoundYears(normalized);
   01277|   if (
   01278|     principal === null ||
   01279|     annualRatePercent === null ||
   01280|     compoundsPerYear === null ||
   01281|     years === null
   01282|   ) {
   01283|     return null;
   01284|   }
   01285|   return {
   01286|     principal,
   01287|     annualRatePercent,
   01288|     compoundsPerYear,
   01289|     years,
   01290|     targetCurrency: targetCurrencyFromText(normalized, COMPOUND_PRINCIPAL_CURRENCY),
   01291|     asksForWebRate: asksForWebRate(normalized),
   01292|   };
   01293| }
   01294| 
   01295| function parseFinalAmountConversionRequest(normalized, history) {
   01296|   // "convert" and "final amount" are themselves meanings: a conversion action
   01297|   // applied to the final-amount reference produced by a prior turn. Mirrors
   01298|   // parse_final_amount_conversion_request.
   01299|   if (
   01300|     !lexiconMentionsRoleSubstring(ROLE_CONVERSION_ACTION_CUE, normalized) ||
   01301|     !lexiconMentionsRoleSubstring(ROLE_FINAL_AMOUNT_REFERENCE, normalized)
   01302|   ) {
   01303|     return null;
   01304|   }
   01305|   const prior = priorFinalAmount(history);
   01306|   if (!prior) return null;
   01307|   const targetCurrency = targetCurrencyFromText(normalized, prior.currency);
   01308|   if (!targetCurrency) return null;
   01309|   return {
   01310|     amount: prior.amount,
   01311|     sourceCurrency: prior.currency,
   01312|     targetCurrency,
   01313|     asksForWebRate: asksForWebRate(normalized),
   01314|   };
   01315| }
   01316| 
   01317| function priorFinalAmount(history) {
   01318|   if (!Array.isArray(history)) return null;
   01319|   for (let index = history.length - 1; index >= 0; index -= 1) {
   01320|     const turn = history[index];
   01321|     if (!turn || turn.role !== "assistant") continue;
   01322|     const parsed = parseFinalAmountFromText(String(turn.content || ""));
   01323|     if (parsed) return parsed;
   01324|   }
   01325|   return null;
   01326| }
   01327| 
   01328| // The amount and currency an earlier report states after the seeded
   01329| // final-amount marker. Mirrors parse_final_amount_from_text.
   01330| function parseFinalAmountFromText(text) {
   01331|   const marker = compoundPolicy("final-amount-marker");
   01332|   const lower = String(text || "").toLowerCase();
   01333|   const at = marker ? lower.indexOf(marker) : -1;
   01334|   if (at < 0) return null;
   01335|   const match = /^[ \t\n\f\r]*([\d.,]*)[ \t\n\f\r]*(\p{L}*)/u.exec(lower.slice(at + marker.length));
   01336|   const amount = parseCompoundNumberText(match[1]);
   01337|   const entry = compoundCurrencies().find(([role]) => wordsForRole(role).includes(match[2]));
   01338|   return amount === null || !entry ? null : { amount, currency: entry[1] };
   01339| }
   01340| 
   01341| function parseCompoundCurrencyAmount(prompt) {
   01342|   const text = String(prompt || "");
   01343|   const dollarIndex = text.indexOf("$");
   01344|   if (dollarIndex >= 0) return parseCompoundNumberRight(text, dollarIndex + 1);
   01345|   // The spelled-out US-dollar markers are the English surfaces of
   01346|   // currency_usd_reference, scanned as space-prefixed tokens with the amount
   01347|   // to their left. Mirrors parse_currency_amount.
   01348|   const lower = text.toLowerCase();
   01349|   for (const word of wordsForRoleInLanguages(ROLE_CURRENCY_USD_REFERENCE, ["en"])) {
   01350|     const index = lower.indexOf(` ${word}`);
   01351|     if (index < 0) continue;
   01352|     const amount = parseCompoundNumberLeft(lower, index);
   01353|     if (amount !== null) return amount;
   01354|   }
   01355|   return null;
   01356| }
   01357| 
   01358| function parseCompoundPercentBeforeSymbol(prompt) {
   01359|   const text = String(prompt || "");
   01360|   const percentIndex = text.indexOf("%");
   01361|   return percentIndex >= 0 ? parseCompoundNumberLeft(text, percentIndex) : null;
   01362| }
   01363| 
   01364| function parseCompoundYears(normalized) {
   01365|   // The duration unit is a meaning (year_unit_cue); read the number to the
   01366|   // left of the earliest of its surface forms that has one, so the "year" in
   01367|   // "compounded yearly" is skipped. Mirrors years_in_prompt.
   01368|   const text = String(normalized || "");
   01369|   const positions = [];
   01370|   for (const word of wordsForRole(ROLE_YEAR_UNIT_CUE)) {
   01371|     if (!word) continue;
   01372|     for (let index = text.indexOf(word); index >= 0; index = text.indexOf(word, index + 1)) positions.push(index);
   01373|   }
   01374|   positions.sort((left, right) => left - right);
   01375|   for (const index of positions) {
   01376|     const years = parseCompoundNumberLeft(text, index);
   01377|     if (years !== null) return years;
   01378|   }
   01379|   return null;
   01380| }
   01381| 
   01382| function parseCompoundsPerYear(normalized) {
   01383|   // The compounding frequency is a cluster of meanings listed in priority
   01384|   // order in the finance lexicon; the first whose surface appears in the
   01385|   // prompt names its periods per year in the seeded policy. Mirrors
   01386|   // parse_compounds_per_year.
   01387|   const meaning = meaningsWithRole(ROLE_COMPOUNDING_FREQUENCY_CUE).find((candidate) =>
   01388|     candidate.words.some((word) => normalized.includes(word)),
   01389|   );
   01390|   const periods = meaning ? compoundPolicy(`periods_${meaning.slug}`) : "";
   01391|   return /^\d+$/.test(periods) ? Number(periods) : null;
   01392| }
   01393| 
   01394| // The currency a conversion request names, skipping `source`: the first
   01395| // currency meaning the prompt mentions as a whole token, in the priority of
   01396| // compoundCurrencies(); the € glyph is a typographic symbol for the euro.
   01397| // Mirrors target_currency.
