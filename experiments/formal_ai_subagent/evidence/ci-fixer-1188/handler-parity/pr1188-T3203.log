   00268| // Every target surface the wikitext offers, in page order (the Rust
   00269| // pipeline's Wiktionary candidates); the chat route picks among them by the
   00270| // round trip (roundTripSurface, R1188-U19).
   00271| function extractWiktionaryCandidates(wikitext, targetLang) {
   00272|   if (!wikitext || !targetLang) return [];
   00273|   // English-edition templates: {{t|<lang>|...}}, {{t+|<lang>|...}},
   00274|   // {{tt|<lang>|...}}, {{tt+|<lang>|...}}.
   00275|   const enPattern = new RegExp(
   00276|     `\\{\\{tt?\\+?\\|${targetLang}\\|([^|}\\n]+)`,
   00277|     "gi",
   00278|   );
   00279|   const candidates = [];
   00280|   for (const enMatch of wikitext.matchAll(enPattern)) {
   00281|     const surface = stripCombiningMarks(String(enMatch[1] || "").trim());
   00282|     if (surface && !candidates.includes(surface)) candidates.push(surface);
   00283|   }
   00284|   if (candidates.length > 0) return candidates;
   00285|   // Russian-edition translation blocks: `{{перев-блок|...|<lang>=[[surface]]\n|...}}`.
   00286|   // The language code may appear at the very start (no leading newline)
   00287|   // or after `\n|`; the surface can be inside `[[...]]`, optionally
   00288|   // followed by transliteration in parentheses we drop.
   00289|   const ruPattern = new RegExp(
   00290|     `[|\\n]${targetLang}\\s*=\\s*(?:\\[\\[([^\\]|]+)(?:\\|[^\\]]+)?\\]\\]|([^\\n|}]+))`,
   00291|     "i",
   00292|   );
   00293|   const ruMatch = ruPattern.exec(wikitext);
   00294|   if (ruMatch) {
   00295|     const raw = (ruMatch[1] || ruMatch[2] || "").trim();
   00296|     const surface = stripCombiningMarks(raw.replace(/\s*\([^)]*\)\s*$/, "").trim());
   00297|     if (surface) return [surface];
   00298|   }
   00299|   return [];
   00300| }
