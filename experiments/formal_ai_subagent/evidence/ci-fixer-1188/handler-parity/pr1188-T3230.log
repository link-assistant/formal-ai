   00353| async function translateSurface(surface, source, target) {
   00354|   if (source === target) {
   00355|     return { surface: String(surface || ""), gap: false };
   00356|   }
   00357|   const token = formalizeSurface(surface, source);
   00358|   if (token) {
   00359|     const primary = deformalizeMeaning(token, target, surface, source);
   00360|     if (primary) return { surface: primary, gap: false };
   00361|   }
   00362|   const compositional = translateCompositionalSurface(surface, source, target);
   00363|   if (compositional) return { surface: compositional, gap: false };
   00364|   if (surface) {
   00365|     const live = await liveWiktionaryTranslate(surface, source, target);
   00366|     if (live) return { surface: live, gap: false };
   00367|   }
