   01232| }
   01233| 
   01234| function parseCompoundCurrencyAmount(prompt) {
   01235|   const text = String(prompt || "");
   01236|   const dollarIndex = text.indexOf("$");
   01237|   if (dollarIndex >= 0) return parseCompoundNumberRight(text, dollarIndex + 1);
   01238|   // The spelled-out US-dollar markers are the English surfaces of
   01239|   // currency_usd_reference, scanned as space-prefixed tokens with the amount
   01240|   // to their left. Mirrors parse_currency_amount.
   01241|   const lower = text.toLowerCase();
   01242|   for (const word of wordsForRoleInLanguages(ROLE_CURRENCY_USD_REFERENCE, ["en"])) {
   01243|     const index = lower.indexOf(` ${word}`);
   01244|     if (index < 0) continue;
   01245|     const amount = parseCompoundNumberLeft(lower, index);
   01246|     if (amount !== null) return amount;
   01247|   }
   01248|   return null;
   01249| }
   01250| 
   01251| function parseCompoundPercentBeforeSymbol(prompt) {
   01252|   const text = String(prompt || "");
   01253|   const percentIndex = text.indexOf("%");
   01254|   return percentIndex >= 0 ? parseCompoundNumberLeft(text, percentIndex) : null;
   01255| }
   01256| 
   01257| function parseCompoundYears(normalized) {
   01258|   // The duration unit is a meaning (year_unit_cue); read the number to the
   01259|   // left of the earliest of its surface forms that has one, so the "year" in
   01260|   // "compounded yearly" is skipped. Mirrors years_in_prompt.
   01261|   const text = String(normalized || "");
   01262|   const positions = [];
   01263|   for (const word of wordsForRole(ROLE_YEAR_UNIT_CUE)) {
   01264|     if (!word) continue;
   01265|     for (let index = text.indexOf(word); index >= 0; index = text.indexOf(word, index + 1)) positions.push(index);
   01266|   }
   01267|   positions.sort((left, right) => left - right);
   01268|   for (const index of positions) {
   01269|     const years = parseCompoundNumberLeft(text, index);
   01270|     if (years !== null) return years;
   01271|   }
   01272|   return null;
   01273| }
   01274| 
   01275| function parseCompoundsPerYear(normalized) {
   01276|   // The compounding frequency is a cluster of meanings listed in priority
   01277|   // order in the finance lexicon; the first whose surface appears in the
   01278|   // prompt names its periods per year in the seeded policy. Mirrors
   01279|   // parse_compounds_per_year.
   01280|   const meaning = meaningsWithRole(ROLE_COMPOUNDING_FREQUENCY_CUE).find((candidate) =>
   01281|     candidate.words.some((word) => normalized.includes(word)),
   01282|   );
