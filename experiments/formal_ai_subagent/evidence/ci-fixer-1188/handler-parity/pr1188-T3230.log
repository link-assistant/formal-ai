   01015| // Issue #918: the compound-interest row holds no vocabulary, prose or rate.
   01016| // The cue words are the finance and currency meanings of the seed lexicon; the
   01017| // wording is the seeded compound_interest_* responses; the periods per
   01018| // compounding meaning, the frequency labels, the default exchange rates and
   01019| // the final-amount marker are the `policy compound_interest` block of
   01020| // data/seed/handler-rules.lino. Mirrors src/solver_handlers/compound_interest.rs.
   01021| // A function, not a const array, so the ROLE_* consts stay out of the TDZ.
   01022| function compoundCurrencies() {
   01023|   return [
   01024|     [ROLE_CURRENCY_EUR_REFERENCE, "EUR"],
   01025|     [ROLE_CURRENCY_USD_REFERENCE, "USD"],
   01026|     [ROLE_CURRENCY_RUB_REFERENCE, "RUB"],
   01027|   ];
   01028| }
   01029| const COMPOUND_PRINCIPAL_CURRENCY = "USD";
   01030| 
   01031| function compoundPolicy(key) {
   01032|   return handlerRulesPolicy("compound_interest", key) || "";
   01033| }
   01034| 
   01035| function compoundResponse(intent, values = {}) {
   01036|   let text = answerFor(intent, "en");
   01037|   for (const [name, value] of Object.entries(values)) text = text.split(`{${name}}`).join(String(value));
   01038|   return text;
   01039| }
   01040| 
   01041| function tryCompoundInterest(prompt, normalized, history) {
   01042|   const request = parseCompoundInterestRequest(prompt, normalized);
   01043|   if (request) return answerCompoundInterest(request);
   01044| 
   01045|   const conversion = parseFinalAmountConversionRequest(normalized, history);
   01046|   if (conversion) return answerFinalAmountConversion(conversion);
   01047| 
   01048|   return null;
   01049| }
   01050| 
   01051| function answerCompoundInterest(request) {
   01052|   const annualRate = request.annualRatePercent / 100;
   01053|   const periodsPerYear = request.compoundsPerYear;
   01054|   const periodicRate = annualRate / periodsPerYear;
   01055|   const periods = periodsPerYear * request.years;
   01056|   const finalAmount =
   01057|     request.principal * Math.pow(1 + periodicRate, periods);
   01058| 
   01059|   const evidence = [
   01060|     `calculation:compound_interest:P=${formatCompoundNumber(request.principal)};r=${formatCompoundRate(annualRate)};n=${periodsPerYear};t=${formatCompoundNumber(request.years)}`,
   01061|     "calculation:formula:A=P(1+r/n)^(n*t)",
   01062|   ];
   01063|   let content = compoundResponse("compound_interest_report", {
   01064|     principal: formatCompoundNumber(request.principal),
   01065|     rate: formatCompoundRate(annualRate),
   01066|     percent: formatCompoundNumber(request.annualRatePercent),
   01067|     periods_per_year: periodsPerYear,
   01068|     frequency: compoundPolicy(`label-${periodsPerYear}`) || compoundPolicy("label-other"),
   01069|     years: formatCompoundNumber(request.years),
   01070|     periodic_rate: formatCompoundRate(periodicRate),
   01071|     periods: formatCompoundNumber(periods),
   01072|     final_amount: formatCompoundMoney(finalAmount),
   01073|   });
   01074| 
   01075|   if (request.targetCurrency) {
   01076|     content += compoundConversion(
   01077|       evidence,
   01078|       finalAmount,
   01079|       COMPOUND_PRINCIPAL_CURRENCY,
   01080|       request.targetCurrency,
   01081|       request.asksForWebRate,
   01082|     );
   01083|   }
   01084| 
   01085|   return {
   01086|     intent: "calculation",
   01087|     content,
   01088|     confidence: 1.0,
   01089|     evidence,
   01090|   };
   01091| }
   01092| 
   01093| function answerFinalAmountConversion(conversion) {
   01094|   const evidence = ["calculation:final_amount_conversion"];
   01095|   const content =
   01096|     compoundResponse("compound_interest_final_amount_conversion", {
   01097|       amount: formatCompoundMoney(conversion.amount),
   01098|       source: conversion.sourceCurrency,
   01099|     }) +
   01100|     compoundConversion(
   01101|       evidence,
   01102|       conversion.amount,
   01103|       conversion.sourceCurrency,
   01104|       conversion.targetCurrency,
   01105|       conversion.asksForWebRate,
   01106|     );
   01107|   return {
   01108|     intent: "calculation",
   01109|     content,
   01110|     confidence: 1.0,
   01111|     evidence,
   01112|   };
   01113| }
