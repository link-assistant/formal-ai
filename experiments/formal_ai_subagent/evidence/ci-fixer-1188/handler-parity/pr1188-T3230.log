   01296| 
   01297| function asksForWebRate(normalized) {
   01298|   // "fetch the live/current rate from the web" is the live_rate_freshness_cue
   01299|   // meaning, matched as raw substrings. Mirrors asks_for_web_rate.
   01300|   return lexiconMentionsRoleSubstring(ROLE_LIVE_RATE_FRESHNESS_CUE, normalized);
