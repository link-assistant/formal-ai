   01115| // The conversion paragraph appended to a report: the seeded default rate,
   01116| // the converted amount, and the rate detail; or the honest no-rate sentence.
   01117| function compoundConversion(evidence, amount, source, target, asksForWebRate) {
   01118|   const rate = compoundDefaultRate(source, target);
   01119|   if (rate === null) {
   01120|     evidence.push(`calculation:currency_conversion:error:${source}->${target}`);
   01121|     return `\n\n${compoundResponse("compound_interest_rate_unavailable", { source, target })}`;
   01122|   }
   01123|   const displayedAmount = roundCompoundMoney(amount);
   01124|   const converted = displayedAmount * rate;
   01125|   evidence.push(
   01126|     `calculation:currency_conversion:${formatCompoundMoney(displayedAmount)} ${source} to ${target} at ${formatCompoundRate(rate)}`,
   01127|   );
   01128|   const expression = compoundPolicy("rate-expression").split("{source}").join(source).split("{target}").join(target);
   01129|   let text = `\n\n${compoundResponse("compound_interest_conversion", {
   01130|     source,
   01131|     target,
   01132|     expression,
   01133|     rate: formatCompoundRate(rate),
   01134|     amount: formatCompoundMoney(displayedAmount),
   01135|     converted: formatCompoundMoney(converted),
   01136|   })}`;
   01137|   text += `\n${compoundResponse("compound_interest_rate_detail", { source, target, rate: formatCompoundRate(rate) })}`;
   01138|   if (asksForWebRate) text += `\n${compoundResponse("compound_interest_live_rate_note")}`;
   01139|   return text;
   01140| }
   01141| 
   01142| // The seeded default rate from `source` to `target`: the direct pair, or the
   01143| // inverse of the reverse pair.
   01144| function compoundDefaultRate(source, target) {
   01145|   const direct = compoundRateNumber(compoundPolicy(`rate_${source}_${target}`));
   01146|   if (direct !== null) return direct;
   01147|   const reverse = compoundRateNumber(compoundPolicy(`rate_${target}_${source}`));
   01148|   return reverse === null || reverse === 0 ? null : 1 / reverse;
   01149| }
   01150| 
   01151| function compoundRateNumber(text) {
   01152|   return /^\d+(?:\.\d+)?$/.test(text) ? Number(text) : null;
   01153| }
   01154| 
   01155| function parseCompoundInterestRequest(prompt, normalized) {
   01156|   // The investment / interest / compounding cues are language-independent
   01157|   // meanings carried by the finance lexicon, matched as raw substrings of the
   01158|   // normalized prompt. Mirrors parse_compound_interest_request.
   01159|   if (
   01160|     !lexiconMentionsRoleSubstring(ROLE_INVESTMENT_CUE, normalized) ||
   01161|     !lexiconMentionsRoleSubstring(ROLE_INTEREST_CUE, normalized) ||
   01162|     !lexiconMentionsRoleSubstring(ROLE_COMPOUNDING_ACTION_CUE, normalized)
   01163|   ) {
   01164|     return null;
   01165|   }
   01166|   const principal = parseCompoundCurrencyAmount(prompt);
   01167|   const annualRatePercent = parseCompoundPercentBeforeSymbol(prompt);
   01168|   const compoundsPerYear = parseCompoundsPerYear(normalized);
   01169|   const years = parseCompoundYears(normalized);
   01170|   if (
   01171|     principal === null ||
   01172|     annualRatePercent === null ||
   01173|     compoundsPerYear === null ||
   01174|     years === null
   01175|   ) {
   01176|     return null;
   01177|   }
   01178|   return {
   01179|     principal,
   01180|     annualRatePercent,
   01181|     compoundsPerYear,
   01182|     years,
   01183|     targetCurrency: targetCurrencyFromText(normalized, COMPOUND_PRINCIPAL_CURRENCY),
   01184|     asksForWebRate: asksForWebRate(normalized),
   01185|   };
   01186| }
   01187| 
   01188| function parseFinalAmountConversionRequest(normalized, history) {
   01189|   // "convert" and "final amount" are themselves meanings: a conversion action
   01190|   // applied to the final-amount reference produced by a prior turn. Mirrors
   01191|   // parse_final_amount_conversion_request.
   01192|   if (
   01193|     !lexiconMentionsRoleSubstring(ROLE_CONVERSION_ACTION_CUE, normalized) ||
   01194|     !lexiconMentionsRoleSubstring(ROLE_FINAL_AMOUNT_REFERENCE, normalized)
   01195|   ) {
   01196|     return null;
   01197|   }
   01198|   const prior = priorFinalAmount(history);
   01199|   if (!prior) return null;
   01200|   const targetCurrency = targetCurrencyFromText(normalized, prior.currency);
   01201|   if (!targetCurrency) return null;
   01202|   return {
   01203|     amount: prior.amount,
   01204|     sourceCurrency: prior.currency,
   01205|     targetCurrency,
   01206|     asksForWebRate: asksForWebRate(normalized),
   01207|   };
   01208| }
   01209| 
   01210| function priorFinalAmount(history) {
   01211|   if (!Array.isArray(history)) return null;
   01212|   for (let index = history.length - 1; index >= 0; index -= 1) {
   01213|     const turn = history[index];
   01214|     if (!turn || turn.role !== "assistant") continue;
   01215|     const parsed = parseFinalAmountFromText(String(turn.content || ""));
   01216|     if (parsed) return parsed;
   01217|   }
   01218|   return null;
   01219| }
   01220| 
   01221| // The amount and currency an earlier report states after the seeded
   01222| // final-amount marker. Mirrors parse_final_amount_from_text.
   01223| function parseFinalAmountFromText(text) {
   01224|   const marker = compoundPolicy("final-amount-marker");
   01225|   const lower = String(text || "").toLowerCase();
   01226|   const at = marker ? lower.indexOf(marker) : -1;
   01227|   if (at < 0) return null;
   01228|   const match = /^[ \t\n\f\r]*([\d.,]*)[ \t\n\f\r]*(\p{L}*)/u.exec(lower.slice(at + marker.length));
   01229|   const amount = parseCompoundNumberText(match[1]);
   01230|   const entry = compoundCurrencies().find(([role]) => wordsForRole(role).includes(match[2]));
