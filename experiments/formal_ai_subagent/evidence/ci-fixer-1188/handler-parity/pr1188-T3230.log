   00892| // Issue #27: deterministic, logical summarisation — no neural net. We
   00893| // project the conversation onto a small set of features (turn counts, intents,
   00894| // concepts, languages, unanswered questions) and render them as a structured
   00895| // Markdown report. Every value is derived directly from the append-only event
   00896| // log so reruns on the same input produce byte-identical output.
   00897| function trySummarizeConversation(history) {
   00898|   if (!Array.isArray(history) || history.length === 0) return null;
   00899|   const turns = history.filter((turn) => turn && turn.content);
   00900|   if (turns.length === 0) return null;
   00901| 
   00902|   let userCount = 0;
   00903|   let assistantCount = 0;
   00904|   const intentCounts = new Map();
   00905|   const languages = new Map();
   00906|   const concepts = new Set();
   00907|   const calculations = [];
   00908|   const programTemplates = new Set();
