   01303| // Number readers mirroring parse_number_left / parse_number_right: skip ASCII
   01304| // whitespace, then take the run of digits, dots and commas.
   01305| function parseCompoundNumberLeft(text, end) {
   01306|   const match = /([\d.,]*)[ \t\n\f\r]*$/.exec(String(text || "").slice(0, end));
   01307|   return parseCompoundNumberText(match[1]);
