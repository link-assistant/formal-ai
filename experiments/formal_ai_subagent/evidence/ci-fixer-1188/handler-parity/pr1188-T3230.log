   01315| // A lone comma followed by at most two digits is a decimal comma (8,5); any
   01316| // other comma groups thousands. Mirrors parse_number_slice.
   01317| function parseCompoundNumberText(value) {
   01318|   let cleaned = String(value || "").trim();
   01319|   if (!/\d/.test(cleaned)) return null;
   01320|   if (cleaned.includes(",") && !cleaned.includes(".")) {
   01321|     const parts = cleaned.split(",");
   01322|     cleaned =
   01323|       parts.length === 2 && parts[1].length <= 2
   01324|         ? `${parts[0]}.${parts[1]}`
   01325|         : parts.join("");
   01326|   } else {
   01327|     cleaned = cleaned.replace(/,/g, "");
   01328|   }
   01329|   const parsed = Number(cleaned);
