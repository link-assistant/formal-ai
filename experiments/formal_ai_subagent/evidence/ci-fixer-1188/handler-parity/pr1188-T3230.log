   00822| function renderMemoryAppendAnswer(statement, language) {
   00823|   if (language === "ru") return `Запомнил: ${statement}`;
   00824|   if (language === "zh") return `已记住:${statement}`;
   00825|   if (language === "hi") return `स्मृति में सहेजा गया: ${statement}`;
   00826|   return `Recorded memory: ${statement}`;
   00827| }
   00828| 
   00829| function renderMemorySubstitutionAnswer(oldValue, newValue, applied, language) {
   00830|   if (language === "ru") {
   00831|     return `Заменил "${oldValue}" на "${newValue}" в памяти (обновлено вхождений: ${applied}).`;
   00832|   }
   00833|   if (language === "zh") {
   00834|     return `已在记忆中将"${oldValue}"替换为"${newValue}"(更新 ${applied} 处)。`;
   00835|   }
   00836|   if (language === "hi") {
   00837|     return `स्मृति में "${oldValue}" को "${newValue}" से बदला (${applied})।`;
   00838|   }
