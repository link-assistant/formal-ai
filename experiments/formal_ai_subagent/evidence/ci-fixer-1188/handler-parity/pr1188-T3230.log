   00842| // Recognise a natural-language memory write and return an answer carrying a
   00843| // structured `memoryOperation` for the app to persist. Substitution is tried
   00844| // before append because a substitution prompt also begins with a directive verb.
   00845| // Mirrors try_memory_write + recognize_memory_write.
   00846| function tryMemoryWrite(prompt, normalized, memory) {
   00847|   const substitution = recognizeMemorySubstitution(normalized);
   00848|   if (substitution) {
   00849|     const language = detectLanguage(prompt);
   00850|     const applied = countMemoryOccurrences(memory, substitution.oldValue);
   00851|     return {
   00852|       intent: "memory_substitution",
   00853|       content: renderMemorySubstitutionAnswer(
   00854|         substitution.oldValue,
   00855|         substitution.newValue,
   00856|         applied,
   00857|         language,
   00858|       ),
   00859|       confidence: 0.9,
   00860|       evidence: [
   00861|         "memory_substitution",
   00862|         "substitution_event:update",
   00863|         `substitution:applied=${applied}`,
   00864|         "response:memory_substitution",
   00865|       ],
   00866|       memoryOperation: {
   00867|         action: "substitute",
   00868|         oldValue: substitution.oldValue,
   00869|         newValue: substitution.newValue,
   00870|         applied,
   00871|       },
   00872|     };
   00873|   }
   00874|   const statement = recognizeMemoryAppend(prompt);
   00875|   if (statement) {
   00876|     const language = detectLanguage(prompt);
   00877|     return {
   00878|       intent: "memory_write",
   00879|       content: renderMemoryAppendAnswer(statement, language),
   00880|       confidence: 0.9,
   00881|       evidence: [
   00882|         "memory_write",
   00883|         "memory_write:natural_language",
   00884|         "response:memory_write",
   00885|       ],
   00886|       memoryOperation: { action: "append", statement },
   00887|     };
   00888|   }
   00889|   return null;
   00890| }
