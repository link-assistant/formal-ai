   00748| // Issue #529: natural-language *writes* to the entire associative memory. This
   00749| // is the browser mirror of src/solver_handlers/conversation_memory/memory_write.rs
   00750| // — the write half of the Turing-complete memory primitive (a recall reads, an
   00751| // append extends, a substitution rewrites). Both recognisers are driven by the
   00752| // seed lexicon (ROLE_MEMORY_*), so they extend to every supported language
   00753| // automatically. The actual persistence happens in the app (main.jsx applies the
   00754| // returned memoryOperation to IndexedDB); the worker stays pure by computing the
   00755| // substitution count over a memory snapshot the app passes in.
   00756| 
   00757| // Recognise a "remember …" append directive in any language. The surfaces are
   00758| // Slot::Prefix forms (trailing …), so each form's literal-before-the-slot is the
   00759| // matchable prefix. Matching runs on a lowercased copy of the raw prompt and
   00760| // longer prefixes win first, so "remember that X" beats "remember X". Mirrors
   00761| // recognize_memory_append.
   00762| function recognizeMemoryAppend(prompt) {
   00763|   const trimmed = String(prompt || "").replace(/^\s+/, "");
   00764|   const lowered = trimmed.toLowerCase();
   00765|   const prefixes = roleWordForms(ROLE_MEMORY_APPEND_DIRECTIVE)
   00766|     .filter((form) => form.slot === "prefix")
   00767|     .map((form) => form.before)
   00768|     .filter((prefix) => prefix.length > 0);
   00769|   prefixes.sort((a, b) => b.length - a.length);
   00770|   for (const prefix of prefixes) {
   00771|     if (lowered.startsWith(prefix)) {
   00772|       const statement = cleanMemoryWriteText(trimmed.slice(prefix.length));
   00773|       if (statement) return statement;
   00774|     }
   00775|   }
   00776|   return null;
   00777| }
   00778| 
   00779| // Recognise a memory substitution (a read+write transform) in any language. A
   00780| // bare "replace X with Y" is an ordinary coding request, so a memory *scope*
   00781| // phrase must be present to claim the prompt. We then strip the scope and the
   00782| // substitution directive (position-independent: SVO languages lead, Hindi
   00783| // trails) and split the operand span on the connector to recover (old, new).
   00784| // Mirrors recognize_memory_substitution.
   00785| function recognizeMemorySubstitution(normalized) {
   00786|   if (!lexiconMentionsRole(ROLE_MEMORY_SCOPE, normalized)) return null;
   00787|   const withoutScope = stripFirstMemorySurface(normalized, ROLE_MEMORY_SCOPE);
   00788|   if (withoutScope === null) return null;
   00789|   const operands = stripFirstMemorySurface(
   00790|     withoutScope,
   00791|     ROLE_MEMORY_SUBSTITUTION_DIRECTIVE,
   00792|   );
   00793|   if (operands === null) return null;
   00794|   const split = splitOnceMemorySurface(
   00795|     operands,
   00796|     ROLE_MEMORY_SUBSTITUTION_CONNECTOR,
   00797|   );
   00798|   if (!split) return null;
   00799|   const oldValue = cleanMemoryWriteText(split[0]);
   00800|   const newValue = cleanMemoryWriteText(split[1]);
   00801|   if (!oldValue || !newValue) return null;
   00802|   return { oldValue, newValue };
   00803| }
   00804| 
   00805| // Total substring occurrences of `old` across every searchable value in the
   00806| // memory snapshot. Mirrors MemoryStore::apply_substitution's count, which sums
   00807| // replace_counting over each event's content/inputs/outputs/title/label and
   00808| // every evidence entry. The app builds the snapshot from those same fields, so
   00809| // the worker's reported count matches the rewrite the app applies to IndexedDB.
   00810| function countMemoryOccurrences(memory, old) {
   00811|   if (!old) return 0;
   00812|   const values = Array.isArray(memory) ? memory : [];
   00813|   let count = 0;
   00814|   for (const value of values) {
   00815|     const text = String(value || "");
   00816|     if (!text.includes(old)) continue;
   00817|     count += text.split(old).length - 1;
   00818|   }
   00819|   return count;
   00820| }
