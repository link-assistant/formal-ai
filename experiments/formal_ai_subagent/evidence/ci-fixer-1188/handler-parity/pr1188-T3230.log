   01309| 
   01310| function parseCompoundNumberRight(text, start) {
   01311|   const match = /^[ \t\n\f\r]*([\d.,]*)/.exec(String(text || "").slice(start));
   01312|   return parseCompoundNumberText(match[1]);
   01313| }
