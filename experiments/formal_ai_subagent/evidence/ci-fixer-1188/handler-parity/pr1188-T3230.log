   01286| 
   01287| // The currency a conversion request names, skipping `source`: the first
   01288| // currency meaning the prompt mentions as a whole token, in the priority of
   01289| // compoundCurrencies(); the € glyph is a typographic symbol for the euro.
   01290| // Mirrors target_currency.
   01291| function targetCurrencyFromText(normalized, source) {
