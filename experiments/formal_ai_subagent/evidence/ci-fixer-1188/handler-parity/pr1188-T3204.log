   00036|         derived_topic_summary(topic, language)
   00037|             .map(|(body, source)| (topic.display_name.clone(), body, source))
   00038|     });
   00039|     if derived.is_none() {
   00040|         log.append("summarization:refusal", "no seeded topic".to_owned());
   00041|     }
   00042|     let (topic, body, source) = derived.unwrap_or_else(|| {
   00043|         let label = prompt
   00044|             .trim_matches(|c: char| c.is_ascii_punctuation() || c.is_whitespace())
   00045|             .to_owned();
   00046|         let fallback = if seeds.fallback_response.is_empty() {
   00047|             "unknown"
   00048|         } else {
   00049|             seeds.fallback_response.as_str()
   00050|         };
   00051|         let body = seed::localized_response(fallback, language)
   00052|             .unwrap_or_else(|| crate::engine::unknown_answer().to_owned());
   00053|         (label, body, String::from("none"))
   00054|     });
   00055| 
   00056|     log.append("summarization:topic", topic);
   00057|     log.append("summarization:source", source);
   00058|     if let Some(label) = seeds.constraint_for(normalized) {
   00059|         log.append("summarization:constraint", label.to_owned());
   00060|     }
   00061| 
   00062|     Some(finalize_simple(
   00063|         prompt,
   00064|         log,
   00065|         "summarize_topic",
   00066|         "response:summarize_topic",
   00067|         &body,
   00068|         0.85,
   00069|     ))
