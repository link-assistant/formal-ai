   00353|     log.append(
   00354|         "coreference:resolved",
   00355|         format!("{}={}", pronoun.token, antecedent.display_name),
   00356|     );
   00357|     if !antecedent.wikidata.is_empty() {
   00358|         log.append("wikidata", antecedent.wikidata.clone());
   00359|     }
   00360| 
   00361|     if let Some(rewritten) = rewrite_coreference_prompt(normalized, antecedent, pronoun) {
   00362|         log.append("coreference:rewrite", rewritten.clone());
   00363|         if let Some(answer) = try_fact_lookup(prompt, &rewritten, log) {
   00364|             return Some(answer);
   00365|         }
   00366|     }
   00367| 
   00368|     Some(finalize_simple(
   00369|         prompt,
   00370|         log,
