   00346| ) -> Option<SymbolicAnswer> {
   00347|     let seeds = coreference_seed_data();
   00348|     let pronoun = matching_coreference_pronoun(seeds, normalized)?;
   00349| 
   00350|     let (antecedent, resolution) = resolve_coreference_antecedent(seeds, log)?;
   00351|     log.append("context_resolution", resolution.links_notation());
