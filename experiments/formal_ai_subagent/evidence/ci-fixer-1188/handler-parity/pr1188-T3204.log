   00456| fn rewrite_coreference_prompt(
   00457|     normalized: &str,
   00458|     antecedent: &Antecedent,
   00459|     pronoun: &Pronoun,
   00460| ) -> Option<String> {
   00461|     let replacement = antecedent
   00462|         .aliases
   00463|         .first()
   00464|         .filter(|alias| !alias.is_empty())
   00465|         .map_or_else(|| antecedent.display_name.to_lowercase(), Clone::clone);
   00466| 
   00467|     replace_token(normalized, pronoun.token.trim(), &replacement)
   00468| }
   00469| 
   00470| fn replace_token(text: &str, token: &str, replacement: &str) -> Option<String> {
   00471|     if token.is_empty() || replacement.is_empty() {
   00472|         return None;
   00473|     }
   00474| 
   00475|     let mut out = String::with_capacity(text.len() + replacement.len());
   00476|     let mut cursor = 0;
   00477|     let mut changed = false;
   00478| 
   00479|     while let Some(offset) = text[cursor..].find(token) {
   00480|         let start = cursor + offset;
   00481|         let end = start + token.len();
   00482|         let previous = text[..start].chars().next_back();
   00483|         let next = text[end..].chars().next();
   00484| 
   00485|         if token_boundary(previous) && token_boundary(next) {
   00486|             out.push_str(&text[cursor..start]);
   00487|             out.push_str(replacement);
   00488|             changed = true;
   00489|         } else {
   00490|             out.push_str(&text[cursor..end]);
   00491|         }
   00492|         cursor = end;
   00493|     }
   00494| 
   00495|     if !changed {
   00496|         return None;
   00497|     }
   00498|     out.push_str(&text[cursor..]);
   00499|     Some(out)
   00500| }
   00501| 
   00502| fn token_boundary(ch: Option<char>) -> bool {
   00503|     ch.is_none_or(|ch| !ch.is_alphanumeric() && ch != '_')
   00504| }
