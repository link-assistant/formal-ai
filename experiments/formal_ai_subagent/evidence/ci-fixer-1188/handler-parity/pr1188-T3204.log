   00432| /// Whether an earlier user turn names an antecedent a pronoun resolves to.
   00433| ///
   00434| /// The `coreference_antecedent` claim evidence of issue #1175 R3.
   00435| #[must_use]
   00436| pub fn names_coreference_antecedent(log: &EventLog) -> bool {
   00437|     resolve_coreference_antecedent(coreference_seed_data(), log).is_some()
   00438| }
