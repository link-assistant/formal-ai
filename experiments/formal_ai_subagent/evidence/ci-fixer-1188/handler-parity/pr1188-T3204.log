   00378| /// Resolve the nearest relevant user subject through the same nested-context
   00379| /// substrate used by dialogue/task/repository scopes.
   00380| ///
   00381| /// Every prior turn is a real context (assistant turns intentionally contribute
   00382| /// no subject), and the current impulse inherits the most recent turn. An
   00383| /// unrelated user message therefore does not erase a still-visible antecedent,
   00384| /// while a nearer recognized subject shadows an older one.
   00385| fn resolve_coreference_antecedent<'a>(
   00386|     seeds: &'a CoreferenceSeeds,
   00387|     log: &EventLog,
   00388| ) -> Option<(&'a Antecedent, ReferenceResolution)> {
   00389|     const REFERENCE: &str = "coreference_subject";
   00390|     let mut hierarchy = ContextHierarchy::new();
   00391|     hierarchy.insert(Context::new("conversation")).ok()?;
   00392| 
   00393|     let mut parent_id = String::from("conversation");
   00394|     let mut turn_index = 0_usize;
   00395|     for event in log
   00396|         .events()
   00397|         .iter()
   00398|         .filter(|event| event.kind.starts_with("prior_turn:"))
   00399|     {
   00400|         turn_index += 1;
   00401|         let context_id = format!("conversation:turn:{turn_index}");
   00402|         let mut context = Context::new(&context_id);
   00403|         if event.kind == "prior_turn:user"
   00404|             && let Some(antecedent) = seeds.pick_antecedent(&event.payload.to_lowercase())
   00405|         {
   00406|             context.assert_link(REFERENCE, &antecedent.display_name);
   00407|         }
   00408|         hierarchy
   00409|             .nest(context, &parent_id, InheritancePolicy::Full)
   00410|             .ok()?;
   00411|         parent_id = context_id;
   00412|     }
   00413| 
   00414|     hierarchy
   00415|         .nest(
   00416|             Context::new("conversation:current"),
   00417|             &parent_id,
   00418|             InheritancePolicy::Full,
   00419|         )
   00420|         .ok()?;
   00421|     let resolution = hierarchy
   00422|         .resolve("conversation:current", REFERENCE, ExternalLookup::Denied)
   00423|         .ok()?;
   00424|     let display_name = &resolution.links.first()?.to;
   00425|     let antecedent = seeds
   00426|         .antecedents
   00427|         .iter()
   00428|         .find(|antecedent| antecedent.display_name == *display_name)?;
   00429|     Some((antecedent, resolution))
   00430| }
