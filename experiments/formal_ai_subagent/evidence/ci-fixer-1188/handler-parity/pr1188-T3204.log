   00313| /// Render `slug` as of today, logging the snapshot provenance so the evidence
   00314| /// trail records *which* snapshot the answer came from and whether it is stale.
   00315| fn render_release_timeline(slug: &str, language: &str, log: &mut EventLog) -> Option<String> {
   00316|     let today = today_utc();
   00317|     let rendered = release_timeline::render(slug, language, &today)?;
   00318|     let timeline = seed::release_timelines().timeline(slug)?;
   00319|     log.append("release_timeline:hit", slug.to_owned());
   00320|     log.append("release_timeline:snapshot", timeline.retrieved_at.clone());
   00321|     log.append("release_timeline:source", timeline.source_url.clone());
   00322|     log.append("release_timeline:sha256", timeline.sha256.clone());
   00323|     log.append(
   00324|         "release_timeline:released",
   00325|         rendered.released.len().to_string(),
   00326|     );
   00327|     log.append(
   00328|         "release_timeline:announced",
   00329|         rendered.announced.len().to_string(),
   00330|     );
   00331|     if rendered.stale {
   00332|         log.append("release_timeline:stale", timeline.retrieved_at.clone());
   00333|     }
   00334|     Some(rendered.text)
   00335| }
