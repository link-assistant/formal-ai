   00176| /// Whether the committed fact store has a record for this prompt.
   00177| ///
   00178| /// The planner's open-web gate asks whether the symbolic engine can answer a
   00179| /// request before releasing it to the open web (issue #989). Concepts and
   00180| /// computations already answer there; a question the fact store's subject
   00181| /// gate admits -- the formalized subject's Q-id equals a record's
   00182| /// `subject_qid` (issue #1172 R2), with word-boundary alias matching only as
   00183| /// the last-resort hint for Q-id-less records, so an unseeded subject such as
   00184| /// Australia correctly falls through to `false`, exactly the dispatch the
   00185| /// solver's `fact_lookup` row runs -- is equally answerable, and planning a
   00186| /// web search for it would discard the answer the engine already owns
   00187| /// (issue #1138).
   00188| #[must_use]
   00189| pub fn fact_store_resolves(prompt: &str) -> bool {
   00190|     let normalized = crate::engine::normalize_prompt(prompt);
   00191|     super::factual_qa::gated_fact_record(prompt, &normalized).is_some()
   00192| }
