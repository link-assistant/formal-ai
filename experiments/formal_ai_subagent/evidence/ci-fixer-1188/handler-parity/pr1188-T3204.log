   00440| fn matching_coreference_pronoun<'a>(
   00441|     seeds: &'a CoreferenceSeeds,
   00442|     normalized: &str,
   00443| ) -> Option<&'a Pronoun> {
   00444|     seeds.pronouns.iter().find(|pronoun| {
   00445|         pronoun
   00446|             .contexts
   00447|             .iter()
   00448|             .any(|context| !context.is_empty() && normalized.contains(context.as_str()))
   00449|             || pronoun
   00450|                 .starts_with
   00451|                 .iter()
   00452|                 .any(|prefix| !prefix.is_empty() && normalized.starts_with(prefix.as_str()))
   00453|     })
   00454| }
