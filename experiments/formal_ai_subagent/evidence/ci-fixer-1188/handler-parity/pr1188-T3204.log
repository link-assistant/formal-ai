   00138| /// The number of items the user asked for: the value of the seed's
   00139| /// `count_cardinal` meaning when the prompt evidences it (in any supported
   00140| /// language), else the seed's `default_count`.
   00141| ///
   00142| /// The cardinal's integer value is read from its own numeral surface rather
   00143| /// than a literal, so the count stays language-independent and the policy
   00144| /// (which cardinal, which default) is the seed's, not this module's (issue
   00145| /// #918).
   00146| fn requested_brainstorm_count(seeds: &BrainstormSeeds, normalized: &str) -> usize {
   00147|     seed::lexicon()
   00148|         .meaning(&seeds.count_cardinal)
   00149|         .filter(|cardinal| cardinal.evidenced_in(normalized))
   00150|         .and_then(cardinal_value)
   00151|         .unwrap_or(seeds.default_count)
   00152| }
   00153| 
   00154| /// Read the integer value of a cardinal-number meaning from its own data.
   00155| ///
   00156| /// Each cardinal carries a numeral word form (e.g. `"10"`) — the
   00157| /// script-independent surface that spells the value — so the count is derived
   00158| /// from the seed rather than restated as a literal in code.
   00159| fn cardinal_value(meaning: &Meaning) -> Option<usize> {
   00160|     meaning
   00161|         .words()
   00162|         .find(|word| !word.is_empty() && word.bytes().all(|byte| byte.is_ascii_digit()))
   00163|         .and_then(|numeral| numeral.parse().ok())
   00164| }
   00165| 
   00166| fn numbered(items: &[String], count: usize) -> String {
   00167|     items
   00168|         .iter()
   00169|         .take(count)
   00170|         .enumerate()
   00171|         .map(|(index, item)| format!("{}. {item}", index + 1))
   00172|         .collect::<Vec<_>>()
   00173|         .join("\n")
   00174| }
