   00194| /// Detect which knowledge-base relation a prompt asks about.
   00195| ///
   00196| /// Issue #386: the relations are no longer a hardcoded per-language keyword
   00197| /// table. They are self-describing `fact_relation` meanings in
   00198| /// `data/seed/meanings-facts.lino` — each `defined_by` the `knowledge_relation`
   00199| /// concept and lexicalised in every supported language. We walk every meaning
   00200| /// carrying [`seed::ROLE_FACT_RELATION`] in declaration order and return the
   00201| /// first whose surface words appear in the prompt. Declaration order is
   00202| /// load-bearing: "написал"/"кто написал" evidence both `author_of_book` and
   00203| /// `painter_of_painting`, and `author_of_book` is declared first so it wins —
   00204| /// exactly as the former pattern table did. Matching is raw substring (not a
   00205| /// whitespace-token test) because several relations carry multi-word phrases
   00206| /// ("how many people", "official language", "who wrote", "speed of light", …).
   00207| /// The slugs match the JS worker's `FACT_RELATIONS` table so the two stacks
   00208| /// emit identical `fact_query:relation:*` evidence and route to the same
   00209| /// Wikidata property (e.g. P36 for `capital`).
   00210| fn detect_relation(normalized: &str) -> Option<&'static str> {
   00211|     seed::lexicon()
   00212|         .meanings_with_role(seed::ROLE_FACT_RELATION)
   00213|         .find(|meaning| {
   00214|             meaning
   00215|                 .words()
   00216|                 .any(|word| !word.is_empty() && normalized.contains(word))
   00217|         })
   00218|         .map(|meaning| meaning.slug.as_str())
   00219| }
   00220| 
   00221| /// Find the subject alias the prompt mentions, if any. Returns the alias
   00222| /// substring as it appears in `subject_aliases`.
   00223| ///
   00224| /// Issue #1172: the alias must match at word boundaries via
   00225| /// [`FactRecord::contains_word_sequence`] — the same comparison
   00226| /// [`FactRecord::matches_normalized`] gates on — so the `fact_query:subject`
   00227| /// evidence reports an alias that actually appears in the prompt as a whole
   00228| /// word (e.g. "usa" for "capital of usa"), never the substring coincidence
   00229| /// that used to fire (alias "us" inside "australia").
   00230| fn detect_subject_alias<'a>(record: &'a FactRecord, normalized: &str) -> Option<&'a str> {
   00231|     record
   00232|         .subject_aliases
   00233|         .iter()
   00234|         .find(|alias| FactRecord::contains_word_sequence(normalized, alias))
   00235|         .map(String::as_str)
   00236| }
