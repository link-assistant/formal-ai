   00525|                 log.append("wikidata", persona.wikidata.clone());
   00526|             }
   00527|             persona.display_name.as_str()
   00528|         },
   00529|     );
   00530|     log.append("roleplay:persona", persona_display.to_owned());
   00531| 
   00532|     let topic_body = seeds
   00533|         .pick_topic(normalized)
   00534|         .map_or(seeds.fallback_body.as_str(), |topic| topic.body.as_str());
   00535|     if seeds.pick_persona(normalized).is_none() && seeds.pick_topic(normalized).is_none() {
   00536|         log.append("roleplay:refusal", "no persona or topic".to_owned());
   00537|     }
   00538|     let body = seeds.render_body(persona_display, topic_body);
   00539| 
   00540|     Some(finalize_simple(
   00541|         prompt,
   00542|         log,
   00543|         "roleplay_explanation",
   00544|         "response:roleplay",
   00545|         &body,
   00546|         0.8,
   00547|     ))
   00548| }
