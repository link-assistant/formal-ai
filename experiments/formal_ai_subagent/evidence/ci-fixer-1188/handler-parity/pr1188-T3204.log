   00072| /// Resolve one typed topic reference into canonical knowledge, then select a
   00073| /// concise localized statement. The summary-topic file contains no prose body:
   00074| /// edits to the concept/project record immediately change this answer.
   00075| fn derived_topic_summary(topic: &SummaryTopic, language: &str) -> Option<(String, String)> {
   00076|     match topic.source_kind.as_str() {
   00077|         "concept" => {
   00078|             let record = seed::concepts()
   00079|                 .into_iter()
   00080|                 .find(|record| record.slug == topic.source_id)?;
   00081|             let localized = record.localized_for(language);
   00082|             let summary = localized
   00083|                 .map(|value| value.summary.as_str())
   00084|                 .filter(|value| !value.is_empty())
   00085|                 .unwrap_or(record.summary.as_str())
   00086|                 .to_owned();
   00087|             let source = localized
   00088|                 .map(|value| value.source.as_str())
   00089|                 .filter(|value| !value.is_empty())
   00090|                 .unwrap_or(record.source.as_str())
   00091|                 .to_owned();
   00092|             Some((summary, source))
   00093|         }
   00094|         "project" => {
   00095|             let registry = seed::projects_registry();
   00096|             let record = registry.by_slug(&topic.source_id)?;
   00097|             let statement = record
   00098|                 .statements_for(language)
   00099|                 .iter()
   00100|                 .max_by_key(|statement| statement.weight)?;
   00101|             Some((statement.text.clone(), record.url.clone()))
   00102|         }
   00103|         _ => None,
   00104|     }
   00105| }
