   00238| /// The `fact_lookup` row: a question over prompt-supplied text (issue #1172
   00239| /// R7) and a comparison of seeded subjects (R6) first, then the seeded record
   00240| /// the subject gate admits (R2).
   00241| pub fn try_fact_lookup(
   00242|     prompt: &str,
   00243|     normalized: &str,
   00244|     log: &mut EventLog,
   00245| ) -> Option<SymbolicAnswer> {
   00246|     if let Some(answer) = super::prompt_text_question::try_prompt_text_question(prompt, log)
   00247|         .or_else(|| super::factual_qa::try_fact_comparison(prompt, log))
   00248|     {
   00249|         return Some(answer);
   00250|     }
   00251|     let (record, gate) = super::factual_qa::gated_fact_record(prompt, normalized)?;
   00252| 
   00253|     log.append("fact_lookup:request", prompt.to_owned());
   00254|     log.append("fact_lookup:hit", record.slug.clone());
   00255|     log.append("fact_lookup:subject_gate", gate);
   00256| 
   00257|     // Structured fact_query trace events (Issue #127). When the matched record
   00258|     // declares a `relation`, surface the parsed (relation, subject) tuple so
   00259|     // memory consumers can render the structured reasoning trace identically
   00260|     // to the browser worker. Records without a `relation` still emit the
   00261|     // legacy `fact_lookup:*` events for backward compatibility.
   00262|     if !record.relation.is_empty() {
   00263|         let parsed_relation = detect_relation(normalized).unwrap_or(record.relation.as_str());
   00264|         let parsed_subject =
   00265|             detect_subject_alias(record, normalized).unwrap_or(record.subject_label.as_str());
   00266|         log.append("fact_query:request", prompt.to_owned());
   00267|         log.append("fact_query:relation", parsed_relation.to_owned());
   00268|         log.append("fact_query:subject", parsed_subject.to_owned());
   00269|         // Treat the seed entry as a pre-warmed cache hit, mirroring the JS
   00270|         // worker's `fact_query:cache:hit:seed` event.
   00271|         log.append("fact_query:cache:hit", "seed".to_owned());
   00272|         if !record.subject_qid.is_empty() {
   00273|             log.append("fact_query:subject_qid", record.subject_qid.clone());
   00274|         }
   00275|         if !record.value_qid.is_empty() {
   00276|             log.append("fact_query:value_qid", record.value_qid.clone());
   00277|         }
   00278|     }
   00279| 
   00280|     for qid in &record.wikidata {
   00281|         if !qid.is_empty() {
   00282|             log.append("wikidata", qid.clone());
   00283|         }
   00284|     }
   00285| 
   00286|     let language = detect_language(prompt).slug();
   00287|     let source = record.source_for(language);
   00288|     if !source.is_empty() {
   00289|         log.append("source", source.to_owned());
   00290|     }
   00291| 
   00292|     // A record backed by a release timeline has no frozen answer: the sentence
   00293|     // is built from the checked-in snapshot against today's date, so a title
   00294|     // that has not come out yet is reported as announced rather than released
   00295|     // (issue #892). Only a missing timeline falls back to the written summary.
   00296|     let summary = record
   00297|         .release_timeline
   00298|         .is_empty()
   00299|         .then(|| record.summary_for(language).to_owned())
   00300|         .or_else(|| render_release_timeline(&record.release_timeline, language, log))
   00301|         .unwrap_or_else(|| record.summary_for(language).to_owned());
   00302| 
   00303|     Some(finalize_simple(
   00304|         prompt,
   00305|         log,
   00306|         "fact_lookup",
   00307|         "response:fact_lookup",
   00308|         &summary,
   00309|         0.9,
   00310|     ))
   00311| }
