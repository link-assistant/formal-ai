   00889| // Recognise a memory substitution (a read+write transform) in any language. A
   00890| // bare "replace X with Y" is an ordinary coding request, so a memory *scope*
   00891| // phrase must be present to claim the prompt. We then strip the scope and the
   00892| // substitution directive (position-independent: SVO languages lead, Hindi
   00893| // trails) and split the operand span on the connector to recover (old, new).
   00894| // Mirrors recognize_memory_substitution.
   00895| function recognizeMemorySubstitution(normalized) {
   00896|   if (!lexiconMentionsRole(ROLE_MEMORY_SCOPE, normalized)) return null;
   00897|   const withoutScope = stripFirstMemorySurface(normalized, ROLE_MEMORY_SCOPE);
   00898|   if (withoutScope === null) return null;
   00899|   const operands = stripFirstMemorySurface(
   00900|     withoutScope,
   00901|     ROLE_MEMORY_SUBSTITUTION_DIRECTIVE,
   00902|   );
   00903|   if (operands === null) return null;
   00904|   const split = splitOnceMemorySurface(
   00905|     operands,
   00906|     ROLE_MEMORY_SUBSTITUTION_CONNECTOR,
   00907|   );
   00908|   if (!split) return null;
   00909|   const oldValue = cleanMemoryWriteText(split[0]);
   00910|   const newValue = cleanMemoryWriteText(split[1]);
   00911|   if (!oldValue || !newValue) return null;
   00912|   return { oldValue, newValue };
   00913| }
   00914| 
   00915| // Total substring occurrences of `old` across every searchable value in the
   00916| // memory snapshot. Mirrors MemoryStore::apply_substitution's count, which sums
   00917| // replace_counting over each event's content/inputs/outputs/title/label and
   00918| // every evidence entry. The app builds the snapshot from those same fields, so
   00919| // the worker's reported count matches the rewrite the app applies to IndexedDB.
   00920| function countMemoryOccurrences(memory, old) {
   00921|   if (!old) return 0;
   00922|   const values = Array.isArray(memory) ? memory : [];
   00923|   let count = 0;
   00924|   for (const value of values) {
   00925|     const text = String(value || "");
   00926|     if (!text.includes(old)) continue;
   00927|     count += text.split(old).length - 1;
   00928|   }
   00929|   return count;
   00930| }
   00931| 
   00932| function renderMemoryAppendAnswer(statement, language) {
   00933|   if (language === "ru") return `Запомнил: ${statement}`;
   00934|   if (language === "zh") return `已记住:${statement}`;
   00935|   if (language === "hi") return `स्मृति में सहेजा गया: ${statement}`;
   00936|   return `Recorded memory: ${statement}`;
   00937| }
   00938| 
   00939| function renderMemorySubstitutionAnswer(oldValue, newValue, applied, language) {
   00940|   if (language === "ru") {
   00941|     return `Заменил "${oldValue}" на "${newValue}" в памяти (обновлено вхождений: ${applied}).`;
   00942|   }
   00943|   if (language === "zh") {
   00944|     return `已在记忆中将"${oldValue}"替换为"${newValue}"(更新 ${applied} 处)。`;
   00945|   }
   00946|   if (language === "hi") {
   00947|     return `स्मृति में "${oldValue}" को "${newValue}" से बदला (${applied})।`;
   00948|   }
   00949|   return `Replaced "${oldValue}" with "${newValue}" in memory (${applied} occurrence(s) updated).`;
   00950| }
   00951| 
   00952| // Recognise a natural-language memory write and return an answer carrying a
   00953| // structured `memoryOperation` for the app to persist. Substitution is tried
   00954| // before append because a substitution prompt also begins with a directive verb.
   00955| // Mirrors try_memory_write + recognize_memory_write.
   00956| function tryMemoryWrite(prompt, normalized, memory) {
   00957|   const substitution = recognizeMemorySubstitution(normalized);
   00958|   if (substitution) {
   00959|     const language = detectLanguage(prompt);
   00960|     const applied = countMemoryOccurrences(memory, substitution.oldValue);
   00961|     return {
   00962|       intent: "memory_substitution",
   00963|       content: renderMemorySubstitutionAnswer(
   00964|         substitution.oldValue,
   00965|         substitution.newValue,
   00966|         applied,
   00967|         language,
   00968|       ),
   00969|       confidence: 0.9,
   00970|       evidence: [
   00971|         "memory_substitution",
   00972|         "substitution_event:update",
   00973|         `substitution:applied=${applied}`,
   00974|         "response:memory_substitution",
   00975|       ],
   00976|       memoryOperation: {
   00977|         action: "substitute",
   00978|         oldValue: substitution.oldValue,
   00979|         newValue: substitution.newValue,
   00980|         applied,
   00981|       },
   00982|     };
   00983|   }
   00984|   const statement = recognizeMemoryAppend(prompt);
   00985|   if (statement) {
   00986|     const language = detectLanguage(prompt);
   00987|     return {
   00988|       intent: "memory_write",
   00989|       content: renderMemoryAppendAnswer(statement, language),
   00990|       confidence: 0.9,
   00991|       evidence: [
   00992|         "memory_write",
   00993|         "memory_write:natural_language",
   00994|         "response:memory_write",
   00995|       ],
   00996|       memoryOperation: { action: "append", statement },
   00997|     };
   00998|   }
   00999|   return null;
   01000| }
   01001| 
   01002| // Issue #27: deterministic, logical summarisation — no neural net. We
   01003| // project the conversation onto a small set of features (turn counts, intents,
   01004| // concepts, languages, unanswered questions) and render them as a structured
   01005| // Markdown report. Every value is derived directly from the append-only event
   01006| // log so reruns on the same input produce byte-identical output.
   01007| function trySummarizeConversation(history) {
   01008|   if (!Array.isArray(history) || history.length === 0) return null;
   01009|   const turns = history.filter((turn) => turn && turn.content);
   01010|   if (turns.length === 0) return null;
   01011| 
   01012|   let userCount = 0;
   01013|   let assistantCount = 0;
   01014|   const intentCounts = new Map();
   01015|   const languages = new Map();
   01016|   const concepts = new Set();
   01017|   const calculations = [];
   01018|   const programTemplates = new Set();
   01019|   const unanswered = [];
   01020|   let lastUser = null;
   01021| 
   01022|   for (const turn of turns) {
   01023|     const role = turn.role || "assistant";
   01024|     const language = detectLanguage(turn.content);
   01025|     languages.set(language, (languages.get(language) || 0) + 1);
   01026|     if (role === "user") {
   01027|       userCount += 1;
   01028|       lastUser = turn.content;
   01029|     } else {
   01030|       assistantCount += 1;
   01031|       if (lastUser) {
   01032|         lastUser = null;
   01033|       }
   01034|       const intent = String(turn.intent || "unknown");
   01035|       intentCounts.set(intent, (intentCounts.get(intent) || 0) + 1);
   01036|       if (intent === "calculation" && typeof turn.content === "string") {
   01037|         const match = turn.content.match(/^([^=]+=\s*[^\n]+)/);
   01038|         if (match) calculations.push(match[1].trim());
   01039|       }
   01040|       if (intent === "write_program") {
   01041|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01042|         const languageEvidence = evidence.find((item) =>
   01043|           String(item || "").startsWith("program_parameter:language:"),
   01044|         );
   01045|         const taskEvidence = evidence.find((item) =>
   01046|           String(item || "").startsWith("program_parameter:task:"),
   01047|         );
   01048|         const generatedLanguage = languageEvidence
   01049|           ? String(languageEvidence).slice("program_parameter:language:".length)
   01050|           : "unknown";
   01051|         const generatedTask = taskEvidence
   01052|           ? String(taskEvidence).slice("program_parameter:task:".length)
   01053|           : "program";
   01054|         programTemplates.add(`${generatedTask}/${generatedLanguage}`);
   01055|       }
   01056|       if (intent.startsWith("hello_world_")) {
   01057|         programTemplates.add(`hello_world/${intent.slice("hello_world_".length)}`);
   01058|       }
   01059|       if (intent.startsWith("concept_lookup")) {
   01060|         const evidence = Array.isArray(turn.evidence) ? turn.evidence : [];
   01061|         for (const item of evidence) {
   01062|           if (typeof item !== "string") continue;
   01063|           const conceptMatch = item.match(/^concept_lookup:request:(.+)$/);
   01064|           if (conceptMatch) concepts.add(conceptMatch[1]);
   01065|         }
   01066|       }
   01067|     }
   01068|   }
   01069|   if (lastUser) {
   01070|     unanswered.push(lastUser);
   01071|   }
   01072| 
   01073|   const lines = [];
   01074|   lines.push("## Conversation summary");
   01075|   lines.push("");
   01076|   lines.push(
   01077|     `- ${turns.length} turn(s): ${userCount} user, ${assistantCount} assistant`,
   01078|   );
   01079|   if (languages.size > 0) {
   01080|     const list = Array.from(languages.entries())
   01081|       .sort((a, b) => b[1] - a[1])
   01082|       .map(([lang, count]) => `${lang} (${count})`)
   01083|       .join(", ");
   01084|     lines.push(`- Languages: ${list}`);
   01085|   }
   01086|   if (intentCounts.size > 0) {
   01087|     const list = Array.from(intentCounts.entries())
   01088|       .sort((a, b) => b[1] - a[1])
   01089|       .map(([intent, count]) => `${intent} (${count})`)
   01090|       .join(", ");
   01091|     lines.push(`- Intents: ${list}`);
   01092|   }
   01093|   if (concepts.size > 0) {
   01094|     lines.push(`- Concepts looked up: ${Array.from(concepts).join(", ")}`);
   01095|   }
   01096|   if (calculations.length > 0) {
   01097|     lines.push(`- Calculations: ${calculations.join("; ")}`);
   01098|   }
   01099|   if (programTemplates.size > 0) {
   01100|     lines.push(
   01101|       `- Program templates generated: ${Array.from(programTemplates).join(", ")}`,
   01102|     );
   01103|   }
   01104|   if (unanswered.length > 0) {
   01105|     lines.push(`- Unanswered: ${unanswered.join(" | ")}`);
   01106|   }
   01107| 
   01108|   const evidence = [
   01109|     "summarize_conversation",
   01110|     `turns:${turns.length}`,
   01111|     `users:${userCount}`,
   01112|     `assistants:${assistantCount}`,
   01113|   ];
   01114|   if (intentCounts.size > 0) {
   01115|     evidence.push(`intents:${Array.from(intentCounts.keys()).join("|")}`);
   01116|   }
   01117|   return {
   01118|     intent: "summarize_conversation",
   01119|     content: lines.join("\n"),
   01120|     confidence: 0.9,
   01121|     evidence,
   01122|   };
   01123| }
   01124| 
   01125| // Issue #918: the compound-interest row holds no vocabulary, prose or rate.
   01126| // The cue words are the finance and currency meanings of the seed lexicon; the
   01127| // wording is the seeded compound_interest_* responses; the periods per
   01128| // compounding meaning, the frequency labels, the default exchange rates and
   01129| // the final-amount marker are the `policy compound_interest` block of
   01130| // data/seed/handler-rules.lino. Mirrors src/solver_handlers/compound_interest.rs.
   01131| // A function, not a const array, so the ROLE_* consts stay out of the TDZ.
   01132| function compoundCurrencies() {
   01133|   return [
   01134|     [ROLE_CURRENCY_EUR_REFERENCE, "EUR"],
   01135|     [ROLE_CURRENCY_USD_REFERENCE, "USD"],
   01136|     [ROLE_CURRENCY_RUB_REFERENCE, "RUB"],
   01137|   ];
   01138| }
   01139| const COMPOUND_PRINCIPAL_CURRENCY = "USD";
   01140| 
   01141| function compoundPolicy(key) {
   01142|   return handlerRulesPolicy("compound_interest", key) || "";
   01143| }
   01144| 
   01145| function compoundResponse(intent, values = {}) {
   01146|   let text = answerFor(intent, "en");
   01147|   for (const [name, value] of Object.entries(values)) text = text.split(`{${name}}`).join(String(value));
   01148|   return text;
   01149| }
   01150| 
   01151| function tryCompoundInterest(prompt, normalized, history) {
   01152|   const request = parseCompoundInterestRequest(prompt, normalized);
   01153|   if (request) return answerCompoundInterest(request);
   01154| 
   01155|   const conversion = parseFinalAmountConversionRequest(normalized, history);
   01156|   if (conversion) return answerFinalAmountConversion(conversion);
   01157| 
   01158|   return null;
   01159| }
   01160| 
   01161| function answerCompoundInterest(request) {
   01162|   const annualRate = request.annualRatePercent / 100;
   01163|   const periodsPerYear = request.compoundsPerYear;
   01164|   const periodicRate = annualRate / periodsPerYear;
   01165|   const periods = periodsPerYear * request.years;
   01166|   const finalAmount =
   01167|     request.principal * Math.pow(1 + periodicRate, periods);
   01168| 
   01169|   const evidence = [
   01170|     `calculation:compound_interest:P=${formatCompoundNumber(request.principal)};r=${formatCompoundRate(annualRate)};n=${periodsPerYear};t=${formatCompoundNumber(request.years)}`,
   01171|     "calculation:formula:A=P(1+r/n)^(n*t)",
   01172|   ];
   01173|   let content = compoundResponse("compound_interest_report", {
   01174|     principal: formatCompoundNumber(request.principal),
   01175|     rate: formatCompoundRate(annualRate),
   01176|     percent: formatCompoundNumber(request.annualRatePercent),
   01177|     periods_per_year: periodsPerYear,
   01178|     frequency: compoundPolicy(`label-${periodsPerYear}`) || compoundPolicy("label-other"),
   01179|     years: formatCompoundNumber(request.years),
   01180|     periodic_rate: formatCompoundRate(periodicRate),
   01181|     periods: formatCompoundNumber(periods),
   01182|     final_amount: formatCompoundMoney(finalAmount),
   01183|   });
   01184| 
   01185|   if (request.targetCurrency) {
   01186|     content += compoundConversion(
   01187|       evidence,
   01188|       finalAmount,
   01189|       COMPOUND_PRINCIPAL_CURRENCY,
   01190|       request.targetCurrency,
   01191|       request.asksForWebRate,
   01192|     );
   01193|   }
   01194| 
   01195|   return {
   01196|     intent: "calculation",
   01197|     content,
   01198|     confidence: 1.0,
   01199|     evidence,
   01200|   };
   01201| }
   01202| 
   01203| function answerFinalAmountConversion(conversion) {
   01204|   const evidence = ["calculation:final_amount_conversion"];
   01205|   const content =
   01206|     compoundResponse("compound_interest_final_amount_conversion", {
   01207|       amount: formatCompoundMoney(conversion.amount),
   01208|       source: conversion.sourceCurrency,
   01209|     }) +
   01210|     compoundConversion(
   01211|       evidence,
   01212|       conversion.amount,
   01213|       conversion.sourceCurrency,
   01214|       conversion.targetCurrency,
   01215|       conversion.asksForWebRate,
   01216|     );
   01217|   return {
   01218|     intent: "calculation",
   01219|     content,
   01220|     confidence: 1.0,
   01221|     evidence,
   01222|   };
   01223| }
   01224| 
   01225| // The conversion paragraph appended to a report: the seeded default rate,
   01226| // the converted amount, and the rate detail; or the honest no-rate sentence.
   01227| function compoundConversion(evidence, amount, source, target, asksForWebRate) {
   01228|   const rate = compoundDefaultRate(source, target);
   01229|   if (rate === null) {
   01230|     evidence.push(`calculation:currency_conversion:error:${source}->${target}`);
   01231|     return `\n\n${compoundResponse("compound_interest_rate_unavailable", { source, target })}`;
   01232|   }
   01233|   const displayedAmount = roundCompoundMoney(amount);
   01234|   const converted = displayedAmount * rate;
   01235|   evidence.push(
   01236|     `calculation:currency_conversion:${formatCompoundMoney(displayedAmount)} ${source} to ${target} at ${formatCompoundRate(rate)}`,
   01237|   );
   01238|   const expression = compoundPolicy("rate-expression").split("{source}").join(source).split("{target}").join(target);
   01239|   let text = `\n\n${compoundResponse("compound_interest_conversion", {
   01240|     source,
   01241|     target,
   01242|     expression,
   01243|     rate: formatCompoundRate(rate),
   01244|     amount: formatCompoundMoney(displayedAmount),
   01245|     converted: formatCompoundMoney(converted),
   01246|   })}`;
   01247|   text += `\n${compoundResponse("compound_interest_rate_detail", { source, target, rate: formatCompoundRate(rate) })}`;
   01248|   if (asksForWebRate) text += `\n${compoundResponse("compound_interest_live_rate_note")}`;
   01249|   return text;
   01250| }
   01251| 
   01252| // The seeded default rate from `source` to `target`: the direct pair, or the
   01253| // inverse of the reverse pair.
   01254| function compoundDefaultRate(source, target) {
   01255|   const direct = compoundRateNumber(compoundPolicy(`rate_${source}_${target}`));
   01256|   if (direct !== null) return direct;
   01257|   const reverse = compoundRateNumber(compoundPolicy(`rate_${target}_${source}`));
   01258|   return reverse === null || reverse === 0 ? null : 1 / reverse;
   01259| }
   01260| 
   01261| function compoundRateNumber(text) {
   01262|   return /^\d+(?:\.\d+)?$/.test(text) ? Number(text) : null;
   01263| }
   01264| 
   01265| function parseCompoundInterestRequest(prompt, normalized) {
   01266|   // The investment / interest / compounding cues are language-independent
   01267|   // meanings carried by the finance lexicon, matched as raw substrings of the
   01268|   // normalized prompt. Mirrors parse_compound_interest_request.
   01269|   if (
   01270|     !lexiconMentionsRoleSubstring(ROLE_INVESTMENT_CUE, normalized) ||
   01271|     !lexiconMentionsRoleSubstring(ROLE_INTEREST_CUE, normalized) ||
   01272|     !lexiconMentionsRoleSubstring(ROLE_COMPOUNDING_ACTION_CUE, normalized)
   01273|   ) {
   01274|     return null;
   01275|   }
   01276|   const principal = parseCompoundCurrencyAmount(prompt);
   01277|   const annualRatePercent = parseCompoundPercentBeforeSymbol(prompt);
   01278|   const compoundsPerYear = parseCompoundsPerYear(normalized);
   01279|   const years = parseCompoundYears(normalized);
   01280|   if (
   01281|     principal === null ||
   01282|     annualRatePercent === null ||
   01283|     compoundsPerYear === null ||
   01284|     years === null
   01285|   ) {
   01286|     return null;
   01287|   }
   01288|   return {
   01289|     principal,
   01290|     annualRatePercent,
   01291|     compoundsPerYear,
   01292|     years,
   01293|     targetCurrency: targetCurrencyFromText(normalized, COMPOUND_PRINCIPAL_CURRENCY),
   01294|     asksForWebRate: asksForWebRate(normalized),
   01295|   };
   01296| }
   01297| 
   01298| function parseFinalAmountConversionRequest(normalized, history) {
   01299|   // "convert" and "final amount" are themselves meanings: a conversion action
   01300|   // applied to the final-amount reference produced by a prior turn. Mirrors
   01301|   // parse_final_amount_conversion_request.
   01302|   if (
   01303|     !lexiconMentionsRoleSubstring(ROLE_CONVERSION_ACTION_CUE, normalized) ||
   01304|     !lexiconMentionsRoleSubstring(ROLE_FINAL_AMOUNT_REFERENCE, normalized)
   01305|   ) {
   01306|     return null;
   01307|   }
   01308|   const prior = priorFinalAmount(history);
   01309|   if (!prior) return null;
   01310|   const targetCurrency = targetCurrencyFromText(normalized, prior.currency);
   01311|   if (!targetCurrency) return null;
   01312|   return {
   01313|     amount: prior.amount,
   01314|     sourceCurrency: prior.currency,
   01315|     targetCurrency,
   01316|     asksForWebRate: asksForWebRate(normalized),
   01317|   };
   01318| }
   01319| 
   01320| function priorFinalAmount(history) {
   01321|   if (!Array.isArray(history)) return null;
   01322|   for (let index = history.length - 1; index >= 0; index -= 1) {
   01323|     const turn = history[index];
   01324|     if (!turn || turn.role !== "assistant") continue;
   01325|     const parsed = parseFinalAmountFromText(String(turn.content || ""));
   01326|     if (parsed) return parsed;
   01327|   }
   01328|   return null;
   01329| }
   01330| 
   01331| // The amount and currency an earlier report states after the seeded
   01332| // final-amount marker. Mirrors parse_final_amount_from_text.
   01333| function parseFinalAmountFromText(text) {
   01334|   const marker = compoundPolicy("final-amount-marker");
   01335|   const lower = String(text || "").toLowerCase();
   01336|   const at = marker ? lower.indexOf(marker) : -1;
   01337|   if (at < 0) return null;
   01338|   const match = /^[ \t\n\f\r]*([\d.,]*)[ \t\n\f\r]*(\p{L}*)/u.exec(lower.slice(at + marker.length));
   01339|   const amount = parseCompoundNumberText(match[1]);
   01340|   const entry = compoundCurrencies().find(([role]) => wordsForRole(role).includes(match[2]));
   01341|   return amount === null || !entry ? null : { amount, currency: entry[1] };
   01342| }
   01343| 
   01344| function parseCompoundCurrencyAmount(prompt) {
   01345|   const text = String(prompt || "");
   01346|   const dollarIndex = text.indexOf("$");
   01347|   if (dollarIndex >= 0) return parseCompoundNumberRight(text, dollarIndex + 1);
   01348|   // The spelled-out US-dollar markers are the English surfaces of
   01349|   // currency_usd_reference, scanned as space-prefixed tokens with the amount
   01350|   // to their left. Mirrors parse_currency_amount.
   01351|   const lower = text.toLowerCase();
   01352|   for (const word of wordsForRoleInLanguages(ROLE_CURRENCY_USD_REFERENCE, ["en"])) {
   01353|     const index = lower.indexOf(` ${word}`);
   01354|     if (index < 0) continue;
   01355|     const amount = parseCompoundNumberLeft(lower, index);
   01356|     if (amount !== null) return amount;
   01357|   }
   01358|   return null;
   01359| }
   01360| 
   01361| function parseCompoundPercentBeforeSymbol(prompt) {
   01362|   const text = String(prompt || "");
   01363|   const percentIndex = text.indexOf("%");
   01364|   return percentIndex >= 0 ? parseCompoundNumberLeft(text, percentIndex) : null;
   01365| }
   01366| 
   01367| function parseCompoundYears(normalized) {
   01368|   // The duration unit is a meaning (year_unit_cue); read the number to the
   01369|   // left of the earliest of its surface forms that has one, so the "year" in
   01370|   // "compounded yearly" is skipped. Mirrors years_in_prompt.
   01371|   const text = String(normalized || "");
   01372|   const positions = [];
   01373|   for (const word of wordsForRole(ROLE_YEAR_UNIT_CUE)) {
   01374|     if (!word) continue;
   01375|     for (let index = text.indexOf(word); index >= 0; index = text.indexOf(word, index + 1)) positions.push(index);
   01376|   }
   01377|   positions.sort((left, right) => left - right);
   01378|   for (const index of positions) {
   01379|     const years = parseCompoundNumberLeft(text, index);
   01380|     if (years !== null) return years;
   01381|   }
   01382|   return null;
   01383| }
   01384| 
   01385| function parseCompoundsPerYear(normalized) {
   01386|   // The compounding frequency is a cluster of meanings listed in priority
   01387|   // order in the finance lexicon; the first whose surface appears in the
   01388|   // prompt names its periods per year in the seeded policy. Mirrors
   01389|   // parse_compounds_per_year.
   01390|   const meaning = meaningsWithRole(ROLE_COMPOUNDING_FREQUENCY_CUE).find((candidate) =>
   01391|     candidate.words.some((word) => normalized.includes(word)),
   01392|   );
   01393|   const periods = meaning ? compoundPolicy(`periods_${meaning.slug}`) : "";
   01394|   return /^\d+$/.test(periods) ? Number(periods) : null;
   01395| }
   01396| 
   01397| // The currency a conversion request names, skipping `source`: the first
   01398| // currency meaning the prompt mentions as a whole token, in the priority of
   01399| // compoundCurrencies(); the € glyph is a typographic symbol for the euro.
