   00858| // Issue #529: natural-language *writes* to the entire associative memory. This
   00859| // is the browser mirror of src/solver_handlers/conversation_memory/memory_write.rs
   00860| // — the write half of the Turing-complete memory primitive (a recall reads, an
   00861| // append extends, a substitution rewrites). Both recognisers are driven by the
   00862| // seed lexicon (ROLE_MEMORY_*), so they extend to every supported language
   00863| // automatically. The actual persistence happens in the app (main.jsx applies the
   00864| // returned memoryOperation to IndexedDB); the worker stays pure by computing the
   00865| // substitution count over a memory snapshot the app passes in.
   00866| 
   00867| // Recognise a "remember …" append directive in any language. The surfaces are
   00868| // Slot::Prefix forms (trailing …), so each form's literal-before-the-slot is the
   00869| // matchable prefix. Matching runs on a lowercased copy of the raw prompt and
   00870| // longer prefixes win first, so "remember that X" beats "remember X". Mirrors
   00871| // recognize_memory_append.
   00872| function recognizeMemoryAppend(prompt) {
   00873|   const trimmed = String(prompt || "").replace(/^\s+/, "");
   00874|   const lowered = trimmed.toLowerCase();
   00875|   const prefixes = roleWordForms(ROLE_MEMORY_APPEND_DIRECTIVE)
   00876|     .filter((form) => form.slot === "prefix")
   00877|     .map((form) => form.before)
   00878|     .filter((prefix) => prefix.length > 0);
   00879|   prefixes.sort((a, b) => b.length - a.length);
   00880|   for (const prefix of prefixes) {
   00881|     if (lowered.startsWith(prefix)) {
   00882|       const statement = cleanMemoryWriteText(trimmed.slice(prefix.length));
   00883|       if (statement) return statement;
   00884|     }
   00885|   }
   00886|   return null;
   00887| }
