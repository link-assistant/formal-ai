   00302| async function resolveWiktionaryLemma(surface, language) {
   00303|   // Inflected forms (e.g. Russian plural `помидоры`) are not always stored
   00304|   // as separate pages on the source-language Wiktionary. OpenSearch returns
   00305|   // the closest matching titles; the first hit is the dictionary lemma
   00306|   // (`помидор`) we want to look up next.
   00307|   if (typeof fetch !== "function" || !surface) return null;
   00308|   const host = WIKTIONARY_SEARCH_HOSTS[language] || WIKTIONARY_SEARCH_HOSTS.en;
   00309|   const url = `${host}?action=opensearch&search=${encodeURIComponent(
   00310|     surface,
   00311|   )}&limit=1&format=json&origin=*`;
   00312|   try {
   00313|     const response = await fetch(url, {
   00314|       headers: {
   00315|         accept: "application/json",
   00316|         "api-user-agent":
   00317|           "formal-ai-demo (https://github.com/link-assistant/formal-ai)",
   00318|       },
   00319|     });
   00320|     if (!response || !response.ok) return null;
   00321|     const data = await response.json();
   00322|     const titles = Array.isArray(data) && Array.isArray(data[1]) ? data[1] : [];
   00323|     const lemma = titles[0];
   00324|     if (typeof lemma !== "string" || !lemma || lemma === surface) return null;
   00325|     return lemma;
   00326|   } catch (_error) {
   00327|     return null;
   00328|   }
   00329| }
