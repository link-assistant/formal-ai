   00237|   if (typeof fetch !== "function" || !pageTitle) return null;
   00238|   const host = WIKTIONARY_SEARCH_HOSTS[language] || WIKTIONARY_SEARCH_HOSTS.en;
   00239|   const url = `${host}?action=parse&page=${encodeURIComponent(
   00240|     pageTitle,
   00241|   )}&prop=wikitext&format=json&origin=*`;
   00242|   try {
   00243|     const response = await fetch(url, {
   00244|       headers: {
   00245|         accept: "application/json",
   00246|         "api-user-agent":
   00247|           "formal-ai-demo (https://github.com/link-assistant/formal-ai)",
   00248|       },
   00249|     });
   00250|     if (!response || !response.ok) return null;
   00251|     const data = await response.json();
