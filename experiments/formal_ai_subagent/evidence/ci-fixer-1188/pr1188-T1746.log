   00138| /// The parts a prose directory-listing request is composed of.
   00139| ///
   00140| /// Issue #865 reported *"List me files here"* reaching web search: the listing
   00141| /// detector matched whole phrases, and no phrase had that word order. The parts
   00142| /// are declared separately so any request that combines a listing verb (or a
   00143| /// question word) with a file/directory object and a local scope is recognised,
   00144| /// in whatever order the user writes them.
   00145| #[derive(Debug, Clone, Default)]
   00146| pub struct DirectoryListingVocabulary {
   00147|     /// Verbs that ask for something to be listed or shown.
   00148|     pub verbs: Vec<String>,
   00149|     /// Question words that open a *which files are here?* request.
   00150|     pub questions: Vec<String>,
   00151|     /// Nouns naming what is listed: files, contents, a directory.
   00152|     pub objects: Vec<String>,
   00153|     /// Phrases that scope the request to the current place.
   00154|     pub scopes: Vec<String>,
   00155| }
