   00157| /// The semantic shell-intent vocabulary: the ordered intent table plus the
   00158| /// name-lead cue words that introduce a `NameLead` argument.
   00159| #[derive(Debug, Clone, Default)]
   00160| pub struct ShellIntentVocabulary {
   00161|     /// Name-lead cue words (*called*, *named*, …), lowercased, pooled across
   00162|     /// languages.
   00163|     pub name_leads: Vec<String>,
   00164|     /// Natural-language glue ignored while recovering path and search operands.
   00165|     pub argument_noise: Vec<String>,
   00166|     /// Words a speaker inserts inside a cue phrase without changing it
   00167|     /// (*"show **me** git status"*), lowercased, pooled across languages.
   00168|     pub cue_fillers: Vec<String>,
   00169|     /// Phrases that distinguish repository/file search from internet search.
   00170|     pub local_search_scopes: Vec<String>,
   00171|     /// Seed-defined portable command with root, predicate, and pattern slots.
   00172|     pub local_path_search_command_template: String,
   00173|     /// Verbs that ask to discover a path by name.
   00174|     pub local_path_search_actions: Vec<String>,
   00175|     /// Local filesystem scope phrases and the roots they map to.
   00176|     pub local_path_search_scopes: Vec<LocalPathSearchScope>,
   00177|     /// File/folder kind phrases and their `find` predicates.
   00178|     pub local_path_search_kinds: Vec<LocalPathSearchKind>,
   00179|     /// Workspace marker → test/install/build mappings in preference order.
   00180|     pub workspace_commands: Vec<WorkspaceCommands>,
   00181|     /// Nouns that name the filesystem object a path argument refers to.
   00182|     ///
   00183|     /// A cue carrying one of these (*"copy the file"*) says what its operands
   00184|     /// are, so a plain name (`build`) is a legitimate operand. A cue that
   00185|     /// carries none (*"copy"*) says nothing, so its operands must look like
