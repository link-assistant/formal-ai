   00086| /// One intent → command mapping: the command to emit, how to fill its argument, and
   00087| /// the multilingual cue phrases (lowercased) that signal the intent.
   00088| #[derive(Debug, Clone, Default)]
   00089| pub struct ShellIntent {
   00090|     /// The concrete command to emit, e.g. `pwd`, `df -h`, `wc -l`.
   00091|     pub command: String,
   00092|     /// How the command's argument (if any) is recovered from the prompt.
   00093|     pub argument: ShellIntentArgument,
   00094|     /// Cue phrases, pooled across languages and lowercased for substring matching.
   00095|     pub cues: Vec<String>,
   00096|     /// The pre/post conditions this intent's command must satisfy, empty for the
   00097|     /// read-only intents that only report what they observe.
   00098|     pub effect: ShellIntentEffect,
   00099|     /// `destructive true`: the command destroys its operand (`rm`, `rmdir`), so
   00100|     /// it is never composed for a request about text inside a file.
   00101|     pub destructive: bool,
   00102| }
