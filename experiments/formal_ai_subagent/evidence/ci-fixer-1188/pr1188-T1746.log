   00194| /// Parse `data/seed/shell-intents.lino` into the semantic shell-intent vocabulary.
   00195| #[must_use]
   00196| pub fn shell_intent_vocabulary() -> ShellIntentVocabulary {
   00197|     let tree = parse_lino(SHELL_INTENTS_LINO);
   00198|     let mut vocab = ShellIntentVocabulary::default();
   00199|     let Some(root) = tree.children.first() else {
   00200|         return vocab;
   00201|     };
   00202|     for group in &root.children {
   00203|         match group.name.as_str() {
   00204|             "name_leads" => vocab.name_leads = collect_language_values(group, "lead"),
   00205|             "argument_noise" => {
   00206|                 vocab.argument_noise = collect_language_values(group, "word");
   00207|             }
   00208|             "cue_fillers" => {
   00209|                 vocab.cue_fillers = collect_language_values(group, "word")
   00210|                     .into_iter()
   00211|                     .map(|word| word.to_lowercase())
   00212|                     .collect();
   00213|             }
   00214|             "local_search_scopes" => {
   00215|                 vocab.local_search_scopes = collect_language_values(group, "scope");
   00216|             }
   00217|             "local_path_search" => {
   00218|                 group
   00219|                     .find_child_value("command_template")
   00220|                     .clone_into(&mut vocab.local_path_search_command_template);
   00221|                 vocab.local_path_search_actions = group
   00222|                     .children
   00223|                     .iter()
   00224|                     .find(|child| child.name == "actions")
   00225|                     .map(|node| collect_language_values(node, "action"))
   00226|                     .unwrap_or_default();
   00227|                 vocab.local_path_search_scopes = group
   00228|                     .children
   00229|                     .iter()
   00230|                     .find(|child| child.name == "scopes")
   00231|                     .map(|node| {
   00232|                         node.children
   00233|                             .iter()
   00234|                             .filter(|child| child.name == "scope")
   00235|                             .map(|scope| LocalPathSearchScope {
   00236|                                 name: scope.id.clone(),
   00237|                                 root: scope.find_child_value("root").to_owned(),
   00238|                                 cues: collect_language_values(scope, "cue")
   00239|                                     .into_iter()
   00240|                                     .map(|cue| cue.to_lowercase())
   00241|                                     .collect(),
   00242|                             })
   00243|                             .collect()
   00244|                     })
   00245|                     .unwrap_or_default();
   00246|                 vocab.local_path_search_kinds = group
   00247|                     .children
   00248|                     .iter()
   00249|                     .find(|child| child.name == "kinds")
   00250|                     .map(|node| {
   00251|                         node.children
   00252|                             .iter()
   00253|                             .filter(|child| child.name == "kind")
   00254|                             .map(|kind| LocalPathSearchKind {
   00255|                                 predicate: kind.find_child_value("predicate").to_owned(),
   00256|                                 cues: collect_language_values(kind, "cue")
   00257|                                     .into_iter()
   00258|                                     .map(|cue| cue.to_lowercase())
   00259|                                     .collect(),
   00260|                             })
   00261|                             .collect()
   00262|                     })
   00263|                     .unwrap_or_default();
   00264|             }
   00265|             "workspace_commands" => {
   00266|                 vocab.workspace_commands = group
   00267|                     .children
   00268|                     .iter()
   00269|                     .filter(|child| child.name == "workspace")
   00270|                     .map(|node| WorkspaceCommands {
   00271|                         marker: node.find_child_value("marker").to_owned(),
   00272|                         test: node.find_child_value("test").to_owned(),
   00273|                         install: node.find_child_value("install").to_owned(),
   00274|                         build: node.find_child_value("build").to_owned(),
   00275|                     })
   00276|                     .collect();
   00277|             }
   00278|             "path_objects" => {
   00279|                 vocab.path_objects = collect_language_values(group, "object")
   00280|                     .into_iter()
   00281|                     .map(|object| object.to_lowercase())
   00282|                     .collect();
   00283|             }
   00284|             "directory_listing" => {
   00285|                 let part = |name: &str, child: &str| {
   00286|                     group
   00287|                         .children
   00288|                         .iter()
   00289|                         .find(|node| node.name == name)
   00290|                         .map(|node| {
   00291|                             collect_language_values(node, child)
   00292|                                 .into_iter()
   00293|                                 .map(|value| value.to_lowercase())
   00294|                                 .collect()
   00295|                         })
   00296|                         .unwrap_or_default()
   00297|                 };
   00298|                 vocab.directory_listing = DirectoryListingVocabulary {
   00299|                     verbs: part("verbs", "verb"),
   00300|                     questions: part("questions", "question"),
   00301|                     objects: part("objects", "object"),
   00302|                     scopes: part("scopes", "scope"),
   00303|                 };
   00304|             }
   00305|             "intents" => {
   00306|                 vocab.intents = group
   00307|                     .children
   00308|                     .iter()
   00309|                     .filter(|c| c.name == "intent")
   00310|                     .map(parse_intent)
   00311|                     .collect();
   00312|             }
   00313|             _ => {}
   00314|         }
   00315|     }
   00316|     vocab
   00317| }
