   00319| /// Parse a single `intent` node into a [`ShellIntent`].
   00320| fn parse_intent(node: &LinoNode) -> ShellIntent {
   00321|     ShellIntent {
   00322|         command: node.find_child_value("command").to_owned(),
   00323|         argument: match node.find_child_value("argument") {
   00324|             "path" => ShellIntentArgument::Path,
   00325|             "name_lead" => ShellIntentArgument::NameLead,
   00326|             "one_path" => ShellIntentArgument::OnePath,
   00327|             "two_paths" => ShellIntentArgument::TwoPaths,
   00328|             "remainder" => ShellIntentArgument::Remainder,
   00329|             "search_query" => ShellIntentArgument::SearchQuery,
   00330|             _ => ShellIntentArgument::None,
   00331|         },
   00332|         cues: collect_language_values(node, "cue")
   00333|             .into_iter()
   00334|             .map(|cue| cue.to_lowercase())
   00335|             .collect(),
   00336|         effect: node
   00337|             .children
   00338|             .iter()
   00339|             .find(|child| child.name == "effect")
   00340|             .map(parse_intent_effect)
   00341|             .unwrap_or_default(),
   00342|         destructive: node.find_child_value("destructive") == "true",
   00343|     }
   00344| }
   00345| 
   00346| /// Read the ordered `before` / `prepare` / `after` templates of one `effect` block.
   00347| fn parse_intent_effect(node: &LinoNode) -> ShellIntentEffect {
   00348|     let templates = |name: &str| -> Vec<String> {
   00349|         node.children
   00350|             .iter()
   00351|             .filter(|child| child.name == name)
   00352|             .map(|child| child.id.clone())
   00353|             .collect()
   00354|     };
   00355|     ShellIntentEffect {
   00356|         flags: templates("flag"),
   00357|         value_options: templates("value_option"),
   00358|         reuse_options: templates("reuse_option"),
   00359|         before_reuse: templates("before_reuse"),
   00360|         directory_targets: node.find_child_value("directory_targets") == "true",
   00361|         before: templates("before"),
   00362|         prepare: templates("prepare"),
   00363|         after: templates("after"),
   00364|     }
   00365| }
   00366| 
   00367| /// Collect every `<child_name>` id nested under the `language` children of `group`,
   00368| /// pooled across all languages (intent detection is language-agnostic).
   00369| fn collect_language_values(group: &LinoNode, child_name: &str) -> Vec<String> {
   00370|     group
   00371|         .children
   00372|         .iter()
   00373|         .filter(|c| c.name == "language")
   00374|         .flat_map(|lang| {
   00375|             lang.children
   00376|                 .iter()
   00377|                 .filter(|c| c.name == child_name)
   00378|                 .map(|c| c.id.clone())
   00379|         })
   00380|         .collect()
   00381| }
