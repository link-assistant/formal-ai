   00010| /// Everything CI executes for a pull request, workflow and gate registry as one
   00011| /// text.
   00012| ///
   00013| /// Issue #991 moved the `lint` job's checks into `data/meta/ci-gates/`, so a
   00014| /// test that asks "does CI run this check?" must read both files.
   00015| /// `crate::ci_gates` answers that for the whole suite; it is re-exported here
   00016| /// because these fixtures are where the workflow tests already look.
   00017| pub use crate::ci_gates::{ci_surface, release_workflow};
   00018| 
   00019| /// Issue #895: the two coverage denominators live in their own workflow. They
   00020| /// are a leaf of the release graph -- nothing `needs:` them -- so moving them
   00021| /// out of `release.yml` changed no ordering, and it keeps that file under the
   00022| /// 1500-line ceiling `scripts/check-file-size.rs` enforces.
   00023| pub fn coverage_workflow() -> String {
   00024|     fs::read_to_string(format!(
   00025|         "{}/../.github/workflows/coverage.yml",
   00026|         env!("CARGO_MANIFEST_DIR")
   00027|     ))
   00028|     .unwrap()
   00029|     .replace("\r\n", "\n")
   00030| }
