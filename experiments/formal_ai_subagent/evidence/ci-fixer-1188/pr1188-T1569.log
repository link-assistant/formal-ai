   00062| /// The same workflow with every run of whitespace collapsed to one space.
   00063| ///
   00064| /// Issue #1081: two gates pinned one line-wrapping of `links.yml`'s `if:`
   00065| /// expression as a literal, so folding a condition across lines to add a term
   00066| /// to it read to them as a deletion -- a true failure for a change that removed
   00067| /// nothing. A condition means the same thing however it is wrapped, so the
   00068| /// assertions that care about one ask it of this rather than of the raw file.
   00069| pub fn unwrapped(workflow: &str) -> String {
   00070|     workflow.split_whitespace().collect::<Vec<_>>().join(" ")
   00071| }
   00072| 
   00073| pub fn job_block<'a>(workflow: &'a str, job_name: &str) -> &'a str {
   00074|     let marker = format!("  {job_name}:\n");
   00075|     let start = workflow.find(&marker).unwrap();
   00076|     let body_start = start + marker.len();
   00077|     let rest = &workflow[body_start..];
   00078| 
   00079|     let next_job = rest
   00080|         .lines()
   00081|         .scan(0usize, |offset, line| {
   00082|             let current_offset = *offset;
   00083|             *offset += line.len() + 1;
   00084|             Some((current_offset, line))
   00085|         })
   00086|         .find_map(|(offset, line)| {
   00087|             let starts_at_job_indent = line.starts_with("  ") && !line.starts_with("    ");
   00088|             (starts_at_job_indent && line.trim_end().ends_with(':')).then_some(offset)
   00089|         });
   00090| 
   00091|     next_job.map_or_else(
   00092|         || &workflow[start..],
   00093|         |end| &workflow[start..body_start + end],
   00094|     )
   00095| }
   00096| 
   00097| pub fn workflow_step_block<'a>(job: &'a str, step_name: &str) -> &'a str {
   00098|     let marker = format!("      - name: {step_name}\n");
   00099|     let start = job.find(&marker).unwrap();
   00100|     let body_start = start + marker.len();
   00101|     let rest = &job[body_start..];
   00102| 
   00103|     let next_step = rest
   00104|         .lines()
   00105|         .scan(0usize, |offset, line| {
   00106|             let current_offset = *offset;
   00107|             *offset += line.len() + 1;
   00108|             Some((current_offset, line))
   00109|         })
   00110|         .find_map(|(offset, line)| line.starts_with("      - ").then_some(offset));
   00111| 
   00112|     next_step.map_or_else(|| &job[start..], |end| &job[start..body_start + end])
   00113| }
   00114| 
   00115| pub fn workflow_job_names(workflow: &str) -> Vec<&str> {
   00116|     let marker = "jobs:\n";
   00117|     let start = workflow.find(marker).unwrap() + marker.len();
   00118| 
   00119|     workflow[start..]
   00120|         .lines()
   00121|         .filter_map(|line| {
   00122|             let starts_at_job_indent = line.starts_with("  ") && !line.starts_with("    ");
   00123|             // A comment at job indentation is not a job. Issue #1017: a prose
   00124|             // line that happened to end in a colon was parsed as one, which
   00125|             // made every job-sweeping contract fail against a phantom job whose
   00126|             // "name" was the sentence -- an error that points at the wrong
   00127|             // thing entirely and takes a CI round trip to see.
   00128|             let is_comment = line.trim_start().starts_with('#');
   00129|             (starts_at_job_indent && !is_comment && line.trim_end().ends_with(':'))
   00130|                 .then(|| line.trim().trim_end_matches(':'))
   00131|         })
   00132|         .collect()
   00133| }
