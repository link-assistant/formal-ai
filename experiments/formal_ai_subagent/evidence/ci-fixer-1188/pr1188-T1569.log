   00135| /// The workflow files, and only those.
   00136| ///
   00137| /// Most callers parse what they get here as a workflow -- `jobs:`, job caps,
   00138| /// concurrency groups -- so a composite action, which has none of those, makes
   00139| /// them panic rather than fail with a reason. `ci_shell_files` is the list for
   00140| /// contracts about the shell CI runs, wherever it lives.
   00141| pub fn workflow_files() -> Vec<(String, String)> {
   00142|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00143|         .parent()
   00144|         .expect("the repository root sits one level above the crate");
   00145|     let mut files = Vec::new();
   00146|     collect_ci_files(
   00147|         &root.join(".github/workflows"),
   00148|         root,
   00149|         &mut files,
   00150|         &["yml", "yaml"],
   00151|     );
   00152|     files.sort();
   00153|     assert!(!files.is_empty(), "no workflow files found");
   00154|     files
   00155| }
