   00157| /// Everything CI executes as shell: the workflows, the composite actions, and
   00158| /// the scripts either of them runs.
   00159| ///
   00160| /// Issue #1085 moved the self-authored authoring loop into
   00161| /// `.github/actions/author-with-formal-ai/` so another repository can install
   00162| /// it. A contract about the shell -- no bare `git push`, no credentialed
   00163| /// checkout without a reason -- has to read this list, or moving a line one
   00164| /// directory across would move it out of review. The shell CI runs is the same
   00165| /// shell either way.
   00166| pub fn ci_shell_files() -> Vec<(String, String)> {
   00167|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00168|         .parent()
   00169|         .expect("the repository root sits one level above the crate");
   00170|     let mut files = Vec::new();
   00171|     collect_ci_files(
   00172|         &root.join(".github/workflows"),
   00173|         root,
   00174|         &mut files,
   00175|         &["yml", "yaml"],
   00176|     );
   00177|     collect_ci_files(
   00178|         &root.join(".github/actions"),
   00179|         root,
   00180|         &mut files,
   00181|         &["yml", "yaml", "sh"],
   00182|     );
   00183|     files.sort();
   00184|     assert!(!files.is_empty(), "no CI shell files found");
   00185|     files
   00186| }
   00187| 
   00188| fn collect_ci_files(
   00189|     dir: &Path,
   00190|     root: &Path,
   00191|     files: &mut Vec<(String, String)>,
   00192|     extensions: &[&str],
   00193| ) {
   00194|     let Ok(entries) = fs::read_dir(dir) else {
   00195|         return;
   00196|     };
   00197|     for entry in entries {
   00198|         let path = entry.expect("workflow entry").path();
   00199|         if path.is_dir() {
   00200|             collect_ci_files(&path, root, files, extensions);
   00201|             continue;
   00202|         }
   00203|         if !path
   00204|             .extension()
   00205|             .is_some_and(|ext| extensions.iter().any(|allowed| ext == *allowed))
   00206|         {
   00207|             continue;
   00208|         }
   00209|         let name = path
   00210|             .strip_prefix(root)
   00211|             .unwrap_or(&path)
   00212|             .to_string_lossy()
   00213|             .into_owned();
   00214|         let name = name
   00215|             .strip_prefix(".github/workflows/")
   00216|             .unwrap_or(&name)
   00217|             .to_owned();
   00218|         files.push((
   00219|             name,
   00220|             fs::read_to_string(&path).unwrap().replace("\r\n", "\n"),
   00221|         ));
   00222|     }
   00223| }
