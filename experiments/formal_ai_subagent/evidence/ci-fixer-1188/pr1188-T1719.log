   00001| //! Verified mutating filesystem actions (issues #824 and #944).
   00002| //!
   00003| //! Issue #824 reported a request to *move* a directory being refused outright.
   00004| //! The routing half of that was answered by the seed `mv` intent: the request
   00005| //! now lowers to a concrete `mv SOURCE DESTINATION`. What issue #944 asks for is
   00006| //! the other half — that the action be **verified** rather than merely issued.
   00007| //!
   00008| //! A read-only command answers by what it prints, so running it and reporting
   00009| //! its output is the whole job. A mutating command answers by what the workspace
   00010| //! *holds afterwards*, and a zero exit status is not that: `mv a b` exits zero
   00011| //! whether or not `b` was something the user wanted overwritten, and exits
   00012| //! non-zero for a missing parent directory that the request plainly implied
   00013| //! should exist. So the action is planned as an ordered recipe —
   00014| //!
   00015| //! 1. the preconditions the intent declares (the source is there, the
   00016| //!    destination is free),
   00017| //! 2. the preparation the intent declares (`mkdir -p` on the destination's
   00018| //!    parent, which is what makes a deep target path work at all),
   00019| //! 3. the action itself,
   00020| //! 4. the postconditions the intent declares (the destination is there, and for
   00021| //!    a move, the source is not),
   00022| //!
   00023| //! — with each step observed before the next is planned. A step that exits
   00024| //! non-zero ends the recipe and is reported as itself, so a blocked move says
   00025| //! which check blocked it and that nothing changed, instead of claiming a
   00026| //! completion the workspace would contradict.
   00027| //!
   00028| //! None of those predicates are written here. They are declared per intent in
   00029| //! `data/seed/shell-intents.lino` as [`crate::seed::ShellIntentEffect`], so a
   00030| //! maintainer teaches a new mutating verb its pre/post conditions by editing
   00031| //! seed data — the same rule every other trigger vocabulary on this project
   00032| //! follows, and the reason this module works for `cp` without naming `cp`.
   00033| 
   00034| use serde_json::json;
   00035| 
   00036| use super::planner::{plan_one, tool_for, AgenticPlan, Capability};
   00037| use super::progress::Progress;
   00038| use super::tool_result;
   00039| use crate::protocol::ChatMessage;
   00040| use crate::seed::{self, ShellIntentVocabulary};
   00041| 
   00042| const PATH_PLACEHOLDER: &str = concat!("{", "path", "}");
   00043| const SOURCE_PLACEHOLDER: &str = concat!("{", "source", "}");
   00044| const DESTINATION_PLACEHOLDER: &str = concat!("{", "destination", "}");
   00045| const DESTINATION_PARENT_PLACEHOLDER: &str = concat!("{", "destination_parent", "}");
   00046| const ACTION_PLACEHOLDER: &str = concat!("{", "action", "}");
   00047| const CHECK_PLACEHOLDER: &str = concat!("{", "check", "}");
   00048| const CHECKS_PLACEHOLDER: &str = concat!("{", "checks", "}");
   00049| const EXIT_CODE_PLACEHOLDER: &str = concat!("{", "exit_code", "}");
   00050| 
   00051| /// The directory component used when the destination names no directory at all.
   00052| const CURRENT_DIRECTORY: &str = ".";
