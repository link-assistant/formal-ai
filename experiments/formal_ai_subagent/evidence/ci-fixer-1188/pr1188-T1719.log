   00080| /// Expand `command` into its verified recipe, or `None` when no seed intent
   00081| /// declares an effect for it.
   00082| ///
   00083| /// The command was assembled by [`super::shell_command`] as the intent's own
   00084| /// command followed by its operands, so it is taken apart the same way: the
   00085| /// longest declared command that prefixes it wins, and the remainder must be
   00086| /// exactly the two operands a source/destination effect is written against.
   00087| pub(super) fn expand(command: &str) -> Option<VerifiedAction> {
   00088|     expand_with(command, &seed::shell_intent_vocabulary())
   00089| }
   00090| 
   00091| fn expand_with(command: &str, vocab: &ShellIntentVocabulary) -> Option<VerifiedAction> {
   00092|     let intent = vocab.intents.iter()
   00093|         .filter(|intent| intent.effect.is_declared())
   00094|         .filter(|intent| command.strip_prefix(intent.command.as_str()).is_some_and(|rest| rest.starts_with(' ')))
   00095|         .max_by_key(|intent| intent.command.len())?;
   00096|     let effect = &intent.effect;
   00097|     let (operands, flags) = effect_operands(&command[intent.command.len()..], effect)?;
   00098|     if operands.is_empty() { return None; }
   00099|     let before = if flags.iter().any(|flag| effect.reuse_options.contains(flag)) && !effect.before_reuse.is_empty() {
   00100|         &effect.before_reuse
   00101|     } else { &effect.before };
   00102|     let has_path = before.iter().chain(&effect.prepare).chain(&effect.after)
   00103|         .any(|template| template.contains(PATH_PLACEHOLDER));
   00104|     let bind = |template: &str, bindings: &[(&str, String)]| {
   00105|         bindings.iter().fold(template.to_owned(), |text, (key, value)| text.replace(key, value))
   00106|     };
   00107|     let mut groups: Vec<Vec<(&str, String)>> = Vec::new();
   00108|     let mut collection = None;
   00109|     if has_path {
   00110|         groups.extend(operands.iter().map(|path| vec![(PATH_PLACEHOLDER, (*path).to_owned())]));
   00111|     } else {
   00112|         if operands.len() < 2 || (operands.len() > 2 && !effect.directory_targets) { return None; }
   00113|         let destination = *operands.last()?;
   00114|         let sources = &operands[..operands.len() - 1];
   00115|         if effect.directory_targets && (sources.len() > 1 || sources.iter().any(|source| has_shell_expansion(source))
   00116|             || destination.trim_matches(['\'', '"']).ends_with('/')) {
   00117|             collection = Some((sources.join(" "), destination));
   00118|             groups.push(vec![(SOURCE_PLACEHOLDER, String::from("\"$formal_ai_source\"")),
   00119|                 (DESTINATION_PARENT_PLACEHOLDER, String::from("\"$formal_ai_parent\"")),
   00120|                 (DESTINATION_PLACEHOLDER, String::from("\"$formal_ai_destination\""))]);
   00121|         } else {
   00122|             groups.push(vec![(SOURCE_PLACEHOLDER, sources[0].to_owned()),
   00123|                 (DESTINATION_PARENT_PLACEHOLDER, parent_of(destination)),
   00124|                 (DESTINATION_PLACEHOLDER, destination.to_owned())]);
   00125|         }
   00126|     }
   00127|     let fill = |template: &String| -> Vec<String> {
   00128|         groups.iter().map(|bindings| {
   00129|             let check = bind(template, bindings);
   00130|             if let Some((sources, destination)) = &collection {
   00131|                 let setup = format!("formal_ai_destination={destination}; {}", concat!(
   00132|                     "if test -d \"$formal_ai_destination\" || [ \"${formal_ai_destination%/}\" != \"$formal_ai_destination\" ]; then ",
   00133|                     "formal_ai_leaf=\"${formal_ai_source%/}\"; formal_ai_destination=\"${formal_ai_destination%/}/${formal_ai_leaf##*/}\"; fi; ",
   00134|                     "formal_ai_parent=\"${formal_ai_destination%/*}\"; ",
   00135|                     "if [ \"$formal_ai_parent\" = \"$formal_ai_destination\" ]; then formal_ai_parent=.; fi; "));
   00136|                 format!("for formal_ai_source in {sources}; do {setup}{check} || exit $?; done")
   00137|             } else { check }
   00138|         }).collect()
   00139|     };
   00140|     let mut steps: Vec<String> = before.iter().flat_map(&fill).collect();
   00141|     steps.extend(effect.prepare.iter().flat_map(&fill));
   00142|     let action = steps.len();
   00143|     steps.push(command.to_owned());
   00144|     steps.extend(effect.after.iter().flat_map(&fill));
   00145|     Some(VerifiedAction { steps, action })
   00146| }
