   00148| /// Separate declared options from shell words while preserving operand quoting.
   00149| fn effect_operands<'a>(text: &'a str, effect: &seed::ShellIntentEffect) -> Option<(Vec<&'a str>, Vec<String>)> {
   00150|     let words = shell_words(text)?;
   00151|     let mut operands = Vec::new();
   00152|     let mut flags = Vec::new();
   00153|     let mut options = true;
   00154|     let mut index = 0;
   00155|     while index < words.len() {
   00156|         let raw = words[index];
   00157|         let word = raw.trim_matches(['\'', '"']);
   00158|         if options && word == "--" { options = false; }
   00159|         else if options && word.starts_with('-') && word != "-" {
   00160|             if let Some(option) = effect.value_options.iter().find(|option| word == option.as_str()
   00161|                 || word.strip_prefix(option.as_str()).is_some_and(|suffix| suffix.starts_with('=')
   00162|                     || (!option.starts_with("--") && !suffix.is_empty()))) {
   00163|                 if word == option { index += 1; if index >= words.len() { return None; } }
   00164|                 flags.push(option.clone());
   00165|             } else if effect.flags.iter().any(|flag| flag == word) { flags.push(word.to_owned()); }
   00166|             else if !word.starts_with("--") {
   00167|                 let bundled: Vec<String> = word[1..].chars().map(|letter| format!("-{letter}")).collect();
   00168|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) { return None; }
   00169|                 flags.extend(bundled);
   00170|             } else { return None; }
   00171|         } else { operands.push(raw); }
   00172|         index += 1;
   00173|     }
   00174|     Some((operands, flags))
   00175| }
   00176| 
   00177| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00178|     let mut words = Vec::new();
   00179|     let mut start = None;
   00180|     let mut quote = None;
   00181|     let mut escaped = false;
   00182|     for (index, character) in text.char_indices() {
   00183|         if start.is_none() && character.is_whitespace() { continue; }
   00184|         if start.is_none() { start = Some(index); }
   00185|         if escaped { escaped = false; continue; }
   00186|         if character == '\\' && quote != Some('\'') { escaped = true; continue; }
   00187|         if let Some(delimiter) = quote { if character == delimiter { quote = None; } continue; }
   00188|         if character == '"' || character == '\'' { quote = Some(character); continue; }
   00189|         if character.is_whitespace() { words.push(&text[start.take()?..index]); }
   00190|         else if ";|&<>()`".contains(character) { return None; }
   00191|     }
   00192|     if quote.is_some() || escaped { return None; }
   00193|     if let Some(start) = start { words.push(&text[start..]); }
   00194|     Some(words)
   00195| }
   00196| 
   00197| fn has_shell_expansion(word: &str) -> bool {
   00198|     let mut quote = None;
   00199|     let mut escaped = false;
   00200|     for character in word.chars() {
   00201|         if escaped { escaped = false; continue; }
   00202|         if character == '\\' && quote != Some('\'') { escaped = true; continue; }
   00203|         if let Some(delimiter) = quote { if character == delimiter { quote = None; } continue; }
   00204|         if character == '"' || character == '\'' { quote = Some(character); }
   00205|         else if "*?[$".contains(character) { return true; }
   00206|     }
   00207|     false
   00208| }
