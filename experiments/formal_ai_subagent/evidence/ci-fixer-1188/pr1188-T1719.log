   00210| /// The directory component of `path`, or `.` when it names no directory.
   00211| ///
   00212| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00213| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00214| /// happily hand back a `~` that the shell then declines to expand once it is no
   00215| /// longer the first character of the word.
   00216| fn parent_of(path: &str) -> String {
   00217|     if path.contains(['"', '\'', '\\']) {
   00218|         return format!("\"$(dirname -- {path})\"");
   00219|     }
   00220|     match path.rsplit_once('/') {
   00221|         Some(("", _)) => String::from("/"),
   00222|         Some((parent, _)) => parent.to_owned(),
   00223|         None => String::from(CURRENT_DIRECTORY),
   00224|     }
   00225| }
