   00227| /// Plan the next step of the verified recipe for `command`.
   00228| ///
   00229| /// Returns `None` when the command declares no effect (every read-only intent),
   00230| /// or when the client advertised no shell tool — in which case the caller's
   00231| /// single-shot path still produces the honest "I can run this when you give me a
   00232| /// shell" answer rather than this module inventing a second one.
   00233| pub(super) fn plan_step(
   00234|     command: &str,
   00235|     messages: &[ChatMessage],
   00236|     tool_names: &[&str],
   00237|     prompt: &str,
   00238| ) -> Option<AgenticPlan> {
   00239|     let recipe = expand(command)?;
   00240|     let tool = tool_for(tool_names, Capability::Run)?;
   00241|     let progress = Progress::scan(messages);
   00242|     let taken = progress.run_outputs.len();
   00243| 
   00244|     // The workspace gets the last word before anything else is planned: a step
   00245|     // that exited non-zero ends the recipe where it stopped.
   00246|     if let Some(index) = taken.checked_sub(1) {
   00247|         let observed = &progress.run_outputs[index];
   00248|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00249|             return Some(AgenticPlan::Final(blocked_report(
   00250|                 &recipe,
   00251|                 recipe.steps().get(index).map_or(command, String::as_str),
   00252|                 observed,
   00253|                 prompt,
   00254|                 index >= recipe.action,
   00255|             )));
   00256|         }
   00257|     }
   00258|     if let Some(step) = recipe.steps().get(taken) {
   00259|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00260|     }
   00261|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00262| }
   00263| 
   00264| /// The report for a recipe that stopped: which check stopped it, with what
   00265| /// status, and the fact that the action did not run.
   00266| ///
   00267| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00268| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00269| /// record of what a false completion claim costs; a recipe that names the check
   00270| /// it stopped on avoids both.
   00271| fn blocked_report(recipe: &VerifiedAction, check: &str, observed: &str, prompt: &str) -> String {
   00272|     let language = tool_result::response_language(prompt);
   00273|     let Some(mut answer) = seed::localized_response("mutating_action_blocked", language) else {
   00274|         return tool_result::render(check, observed, prompt);
   00275|     };
   00276|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00277|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00278|     answer = answer.replace(
   00279|         EXIT_CODE_PLACEHOLDER,
   00280|         &tool_result::reported_exit_code(observed).map_or_else(String::new, |code| code.to_string()),
   00281|     );
   00282|     answer
   00283| }
   00284| 
   00285| /// The report for a recipe that finished: the action that ran, and the checks
   00286| /// that were observed to hold afterwards.
   00287| ///
   00288| /// The claim rests on those checks and names them, because a claim the reader
   00289| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00290| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00291|     let language = tool_result::response_language(prompt);
   00292|     let checks = recipe
   00293|         .postconditions()
   00294|         .iter()
   00295|         .map(|check| format!("`{check}`"))
   00296|         .collect::<Vec<_>>()
   00297|         .join(", ");
   00298|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00299|         || recipe.action().to_owned(),
   00300|         |answer| {
   00301|             answer
   00302|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00303|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00304|         },
   00305|     )
   00306| }
   00307| 
   00308| /// The ordered steps `command` is carried out as.
   00309| ///
   00310| /// `None` when no seed intent declares an effect for it — every read-only
   00311| /// intent, and every mutating one whose operands are not the source/destination
   00312| /// pair the effect is written against.
   00313| ///
   00314| /// Read-only intents keep their single-shot path, which is why this is the same
   00315| /// question the planner asks: a caller that wants to know whether a command is
   00316| /// carried out as a recipe asks for the recipe.
   00317| #[must_use]
   00318| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00319|     expand(command).map(|recipe| recipe.steps)
   00320| }
