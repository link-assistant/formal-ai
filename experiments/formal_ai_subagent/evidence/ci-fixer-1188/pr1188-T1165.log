   00056| /// The template slots the seed sentences that state a rewrite fill.
   00057| const OLD_SLOT: &str = concat!("{", "old", "}");
   00058| const NEW_SLOT: &str = concat!("{", "new", "}");
   00059| const ANCHOR_SLOT: &str = concat!("{", "anchor", "}");
   00060| 
   00061| impl GroundedRewrite {
   00062|     /// The intent whose seed sentence states this change rather than merely
   00063|     /// reporting that the file was touched.
   00064|     const fn stated_intent(&self) -> &'static str {
   00065|         match self.stated {
   00066|             Some((intent, _)) => intent,
   00067|             None if self.renaming => "coding_identifier_renamed",
   00068|             None => "coding_text_replaced",
   00069|         }
   00070|     }
   00071| 
   00072|     /// The operands the seed sentence names, as template slots.
   00073|     fn stated_slots(&self) -> Vec<(&str, &str)> {
   00074|         match &self.stated {
   00075|             Some((_, slots)) => slots
   00076|                 .iter()
   00077|                 .map(|(slot, value)| (*slot, value.as_str()))
   00078|                 .collect(),
   00079|             None => vec![
   00080|                 (OLD_SLOT, self.pattern.as_str()),
   00081|                 (NEW_SLOT, self.replacement.as_str()),
   00082|             ],
   00083|         }
   00084|     }
   00085| }
