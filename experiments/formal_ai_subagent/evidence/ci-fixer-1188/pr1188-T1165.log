   00840| fn rust_paths(task: &str) -> Vec<String> {
   00841|     let mut paths = Vec::new();
   00842|     for (suffix, _) in task.match_indices(".rs") {
   00843|         let end = suffix + 3;
   00844|         let start = task[..end]
   00845|             .char_indices()
   00846|             .rev()
   00847|             .take_while(|(_, character)| {
   00848|                 character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00849|             })
   00850|             .last()
   00851|             .map_or(0, |(index, _)| index);
   00852|         let path = &task[start..end];
   00853|         if !path.is_empty()
   00854|             && !path.starts_with('/')
   00855|             && !path.split('/').any(|component| component == "..")
   00856|             && !paths.iter().any(|existing| existing == path)
   00857|         {
   00858|             paths.push(path.to_owned());
   00859|         }
   00860|     }
   00861|     paths
   00862| }
