   00788| fn repeated_identifier_rewrite_command(rewrite: &GroundedRewrite) -> Option<String> {
   00789|     if !shell_safe_identifier(&rewrite.pattern) || !shell_safe_identifier(&rewrite.replacement) {
   00790|         return None;
   00791|     }
   00792|     // The in-memory execution and the command the client runs have to agree on
   00793|     // what a match is, so a word-scoped rewrite asks for whole words too.
   00794|     let pattern = match rewrite.scope {
   00795|         RewriteScope::Substring => rewrite.pattern.clone(),
   00796|         RewriteScope::Word => format!("\\b{}\\b", rewrite.pattern),
   00797|     };
   00798|     // `perl -pi -e`, not `sed -i` (issue #1110). GNU and BSD sed disagree about
   00799|     // both halves of that command: BSD `-i` reads the script as its backup
   00800|     // suffix, and BSD sed has no `\b`. On macOS every rename therefore failed
   00801|     // with `bad flag in substitute command`, the file was left unchanged, and
   00802|     // Formal AI reported the mismatch as its own verification failure -- a
   00803|     // confident failure report instead of a rename. perl's `-pi -e` and `\b`
   00804|     // mean the same thing on both, and perl ships with macOS and the runners.
   00805|     // Both identifiers are `[A-Za-z0-9_]` by `shell_safe_identifier`, so
   00806|     // neither side can carry a regex or shell metacharacter.
   00807|     // Assembled from named parts rather than one template string: the prose
   00808|     // detector reads `perl -pi -e ...` as a multi-word phrase (two alphabetic
   00809|     // runs, one of three letters) and would have it live in `data/seed`, which
   00810|     // is the wrong home for a shell invocation. Naming the pieces says what
   00811|     // each is, and none of them reads as a sentence.
   00812|     let script = format!("'s/{pattern}/{}/g'", rewrite.replacement);
   00813|     Some(["perl", "-pi", "-e", &script, "--", &rewrite.target].join(" "))
   00814| }
   00815| 
   00816| fn shell_safe_identifier(identifier: &str) -> bool {
   00817|     !identifier.is_empty()
   00818|         && identifier
   00819|             .chars()
   00820|             .all(|character| character.is_ascii_alphanumeric() || character == '_')
   00821| }
   00822| 
   00823| pub(super) fn identifier_tokens(text: &str) -> impl DoubleEndedIterator<Item = &str> {
   00824|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00825|         .filter(|token| valid_identifier(token))
   00826| }
   00827| 
   00828| fn valid_identifier(identifier: &str) -> bool {
   00829|     let mut characters = identifier.chars();
   00830|     characters
   00831|         .next()
   00832|         .is_some_and(|first| first.is_ascii_alphabetic() || first == '_')
   00833|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00834|         && !seed::lexicon()
   00835|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00836|             .iter()
   00837|             .any(|reserved| reserved == identifier)
   00838| }
