   00939| pub(super) fn plan_digest_verification(
   00940|     task: &str,
   00941|     current_turn: &[ChatMessage],
   00942|     tool_names: &[&str],
   00943|     change: &VerifiedChange<'_>,
   00944| ) -> Option<AgenticPlan> {
   00945|     let command = ["sha256sum -- ", change.target].concat();
   00946|     let Some(observed) = result_for_command(current_turn, &command) else {
   00947|         let tool = tool_for(tool_names, Capability::Run)?;
   00948|         return Some(plan_one(tool, json!({"command": command}).to_string()));
   00949|     };
   00950|     let digest = crate::source_fetch::sha256_hex(change.expected.as_bytes());
   00951|     if observed.split_whitespace().next() != Some(digest.as_str()) {
   00952|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00953|             "coding_workspace_verification_failed",
   00954|             task,
   00955|             change.target,
   00956|         )?));
   00957|     }
   00958|     Some(AgenticPlan::Final(render_seeded_change(
   00959|         change.intent,
   00960|         task,
   00961|         change.target,
   00962|         change.slots,
   00963|     )?))
   00964| }
