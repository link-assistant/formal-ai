   00747| fn insert_registration(source: &str, registration: &str) -> String {
   00748|     if source
   00749|         .lines()
   00750|         .any(|line| line.trim() == registration.trim())
   00751|     {
   00752|         return source.to_owned();
   00753|     }
   00754|     let mut updated = source.to_owned();
   00755|     if !updated.is_empty() && !updated.ends_with('\n') {
   00756|         updated.push('\n');
   00757|     }
   00758|     updated.push_str(registration);
   00759|     updated
   00760| }
   00761| 
   00762| fn compact_registration_edit(source: &str, registration: &str) -> Option<(String, String)> {
   00763|     const MAX_SUFFIX_BYTES: usize = 4096;
   00764|     let mut starts = source
   00765|         .match_indices('\n')
   00766|         .map(|(index, _)| index + 1)
   00767|         .filter(|start| *start < source.len())
   00768|         .collect::<Vec<_>>();
   00769|     starts.insert(0, 0);
   00770|     for start in starts.into_iter().rev() {
   00771|         let suffix = &source[start..];
   00772|         if suffix.len() > MAX_SUFFIX_BYTES {
   00773|             break;
   00774|         }
   00775|         if source.match_indices(suffix).count() != 1 {
   00776|             continue;
   00777|         }
   00778|         let mut replacement = suffix.to_owned();
   00779|         if !replacement.ends_with('\n') {
   00780|             replacement.push('\n');
   00781|         }
   00782|         replacement.push_str(registration);
   00783|         return Some((suffix.to_owned(), replacement));
   00784|     }
   00785|     None
   00786| }
