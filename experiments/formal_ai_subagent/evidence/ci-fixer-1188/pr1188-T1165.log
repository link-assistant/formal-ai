   00186| /// `None` unless the request names a contents source and, restated, is an
   00187| /// additive edit the composers place.
   00188| fn sourced_request(task: &str, current_turn: &[ChatMessage]) -> Option<Sourced> {
   00189|     use super::contents_source::{contents_source, with_contents};
   00190|     let source = contents_source(task)?;
