   00903|         argument_matches_path(&value, path)
   00904|             && argument_matches(&value, &["oldString", "old_string", "old_str", "old"], old)
   00905|             && argument_matches(&value, &["newString", "new_string", "new_str", "new"], new)
   00906|     })
   00907| }
   00908| 
   00909| fn argument_matches_path(value: &Value, expected: &str) -> bool {
   00910|     ["path", "filePath", "file_path"].iter().any(|key| {
   00911|         value
   00912|             .get(key)
   00913|             .and_then(Value::as_str)
   00914|             .is_some_and(|observed| workspace_path_matches(expected, observed))
   00915|     })
   00916| }
   00917| 
   00918| fn argument_matches(value: &Value, keys: &[&str], expected: &str) -> bool {
   00919|     keys.iter()
   00920|         .any(|key| value.get(key).and_then(Value::as_str) == Some(expected))
   00921| }
   00922| 
   00923| fn workspace_path_matches(expected: &str, observed: &str) -> bool {
   00924|     if observed == expected {
   00925|         return true;
   00926|     }
   00927|     let expected = Path::new(expected);
   00928|     let observed = Path::new(observed);
   00929|     expected.is_relative() && observed.is_absolute() && observed.ends_with(expected)
   00930| }
