   00724| fn composite_module_change(task: &str) -> Option<CompositeModuleChange> {
   00725|     let lowered = task.to_lowercase();
   00726|     if !seed::lexicon().mentions_role(seed::ROLE_CODING_MODULE_REGISTRATION_ACTION, &lowered) {
   00727|         return None;
   00728|     }
   00729|     let generated = rust_source_for_task(task)?;
   00730|     let registration_path = rust_paths(task)
   00731|         .into_iter()
   00732|         .find(|path| path != &generated.path)?;
   00733|     let module = generated.path.rsplit('/').next()?.strip_suffix(".rs")?;
   00734|     if !valid_identifier(module) {
   00735|         return None;
   00736|     }
   00737|     let registration =
   00738|         render_rust_template("coding_source_module_registration", &[("{module}", module)])?;
   00739|     Some(CompositeModuleChange {
   00740|         source_path: generated.path,
   00741|         source: generated.content,
   00742|         registration_path,
   00743|         registration,
   00744|     })
   00745| }
