   00257|         // A replace asked again finds its old text gone: that is the answer (G87).
   00258|         let absent = super::replace_list::absent_text_answer(
   00259|             task,
   00260|             &rewrite.target,
   00261|             &source,
   00262|             &rewrite.pattern,
   00263|             Some(&rewrite.replacement),
   00264|         );
   00265|         return Some(AgenticPlan::Final(match absent {
   00266|             Some(answer) => answer,
   00267|             None => render_seeded_outcome(
   00268|                 "coding_workspace_verification_failed",
   00269|                 task,
   00270|                 &rewrite.target,
   00271|             )?,
   00272|         }));
   00273|     };
   00274| 
   00275|     let occurrences = match rewrite.scope {
   00276|         RewriteScope::Substring => source.match_indices(&rewrite.pattern).count(),
   00277|         RewriteScope::Word => word_scoped_matches(&source, &rewrite.pattern).len(),
   00278|     };
   00279|     if occurrences > 1
   00280|         && let Some(answer) = super::edit_scope::scoped_decline(task, &rewrite.target, &source)
   00281|     {
   00282|         return Some(AgenticPlan::Final(answer));
   00283|     }
   00284|     if occurrences == 1 {
   00285|         // The bare pattern when it is unique in the file; otherwise the
   00286|         // smallest unique run of changed lines -- the edit tool refuses an
   00287|         // `oldString` it finds twice, and `smal` also sits inside `small`.
