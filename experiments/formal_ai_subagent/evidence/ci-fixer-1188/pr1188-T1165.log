   00966| fn matching_result(
   00967|     messages: &[ChatMessage],
   00968|     matches: impl Fn(&str, &str) -> bool,
   00969| ) -> Option<String> {
   00970|     messages
   00971|         .iter()
   00972|         .enumerate()
   00973|         .rev()
   00974|         .find_map(|(index, message)| {
   00975|             if !message.role.eq_ignore_ascii_case("tool") {
   00976|                 return None;
   00977|             }
   00978|             let id = message.tool_call_id.as_deref()?;
   00979|             let call = messages[..index]
   00980|                 .iter()
   00981|                 .rev()
   00982|                 .flat_map(|prior| prior.tool_calls.iter().rev())
   00983|                 .find(|call| call.id == id)?;
   00984|             matches(&call.function.name, &call.function.arguments)
   00985|                 .then(|| message.content.plain_text())
   00986|         })
   00987| }
