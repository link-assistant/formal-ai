   00209| /// Whether `answer` is one of this module's seeded verification-failure
   00210| /// renderings for `task`'s targets.
   00211| ///
   00212| /// The rendering is deterministic in the task and the target, so equality
   00213| /// against it is a structural test with no phrase table: it recognises the
   00214| /// failure report in whatever language the seed rendered it. The delivery
   00215| /// route uses it to keep such prose out of the files it writes -- a report
   00216| /// that a check failed is chat, never the `result=` line of an effect file
   00217| /// (issue #1138: the binary-tree ladder's effect files carried the failure
   00218| /// template and every leaf read as an unverified result).
   00219| pub(super) fn is_verification_failure_answer(task: &str, answer: &str) -> bool {
   00220|     let task = unwrap_transport_quotes(task);
   00221|     let mut targets: Vec<String> = compose_edit_request(task)
   00222|         .map(|(target, _, _)| target)
   00223|         .into_iter()
   00224|         .chain(rust_paths(task))
   00225|         .collect();
   00226|     if let Some((target, _)) = super::workspace_line_operation::named_target_and_payloads(task)
   00227|         && !targets.contains(&target)
   00228|     {
   00229|         targets.push(target);
   00230|     }
   00231|     targets.iter().any(|target| {
   00232|         [
   00233|             "coding_workspace_verification_failed",
   00234|             "coding_workspace_fragment_refused",
   00235|         ]
   00236|         .iter()
   00237|         .any(|intent| {
   00238|             render_seeded_outcome(intent, task, target).is_some_and(|rendered| rendered == answer)
   00239|         })
   00240|     })
   00241| }
