   00484| /// The file after `rewrite`, or `None` when it cannot apply. A positional
   00485| /// insertion replaces its one anchor occurrence; an anchor found zero or
   00486| /// several times does not say where the line goes.
   00487| /// The rewrite as the request wrote it, when the file holds no unescaped
   00488| /// pattern but holds the pattern as written (source code quoting `'\n'`,
   00489| /// PR #1188 G65).
   00490| fn as_written(source: &str, rewrite: &GroundedRewrite) -> Option<GroundedRewrite> {
   00491|     let (pattern, replacement) = rewrite.verbatim.clone()?;
   00492|     if (rewrite.pattern != pattern && source.contains(&rewrite.pattern))
   00493|         || !source.contains(&pattern)
   00494|     {
   00495|         return None;
   00496|     }
   00497|     Some(GroundedRewrite {
   00498|         pattern,
   00499|         replacement,
   00500|         verbatim: None,
   00501|         ..rewrite.clone()
   00502|     })
   00503| }
   00504| 
   00505| fn rewritten_source(source: &str, rewrite: &GroundedRewrite) -> Option<String> {
   00506|     if rewrite.single_pass {
   00507|         return source
   00508|             .contains(rewrite.pattern.as_str())
   00509|             .then(|| source.replace(rewrite.pattern.as_str(), &rewrite.replacement));
   00510|     }
   00511|     if rewrite.unique {
   00512|         let (start, old, new) = anchored_lines(source, rewrite)?;
   00513|         return Some([&source[..start], new.as_str(), &source[start + old.len()..]].concat());
   00514|     }
   00515|     execute_scoped_workspace_rewrite(
   00516|         source,
   00517|         &rewrite.pattern,
   00518|         &rewrite.replacement,
   00519|         rewrite.scope,
   00520|     )
   00521|     .ok()
   00522|     .map(|execution| execution.output)
   00523| }
   00524| 
   00525| /// A positional insertion's one anchor occurrence widened to the whole lines
   00526| /// it sits on, as `(start, old_lines, new_lines)`, or `None` unless the anchor
   00527| /// occurs exactly once. The inserted text is a line, so an anchor that is only
   00528| /// part of a line (`after the line containing '| T20 |'`) must not split it.
   00529| fn anchored_lines(source: &str, rewrite: &GroundedRewrite) -> Option<(usize, String, String)> {
   00530|     let (pattern, replacement) = (rewrite.pattern.as_str(), rewrite.replacement.as_str());
   00531|     let mut found = source.match_indices(pattern).map(|(at, _)| at);
   00532|     let (Some(at), None) = (found.next(), found.next()) else {
   00533|         return None;
   00534|     };
   00535|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00536|     let tail = at + pattern.len();
   00537|     let end = if pattern.ends_with('\n') {
   00538|         tail - 1
   00539|     } else {
   00540|         source[tail..]
   00541|             .find('\n')
   00542|             .map_or(source.len(), |newline| tail + newline)
   00543|     };
   00544|     let old = &source[start..end];
   00545|     let new = replacement.strip_prefix(pattern).map_or_else(
   00546|         || [&replacement[..replacement.len() - pattern.len()], old].concat(),
   00547|         |rest| [old, rest].concat(),
   00548|     );
   00549|     Some((start, old.to_owned(), new))
   00550| }
   00551| 
   00552| /// The smallest run of whole lines holding every change from `source` to
   00553| /// `updated`, as an edit pair, when that run occurs once in `source`.
   00554| pub(super) fn changed_lines_edit(source: &str, updated: &str) -> Option<(String, String)> {
   00555|     const MAX_EDIT_BYTES: usize = 4096;
   00556|     let prefix = source
   00557|         .bytes()
   00558|         .zip(updated.bytes())
   00559|         .take_while(|(left, right)| left == right)
   00560|         .count();
   00561|     let limit = source.len().min(updated.len()) - prefix;
   00562|     let suffix = source
   00563|         .bytes()
   00564|         .rev()
   00565|         .zip(updated.bytes().rev())
   00566|         .take(limit)
   00567|         .take_while(|(left, right)| left == right)
   00568|         .count();
   00569|     // Byte positions only meet `\n`, so `start` and `end` fall on line -- and
   00570|     // therefore character -- boundaries even when the first or last differing
   00571|     // byte sits inside a multi-byte character.
   00572|     let bytes = source.as_bytes();
   00573|     let line_start = |before: usize| {
   00574|         bytes[..before]
   00575|             .iter()
   00576|             .rposition(|byte| *byte == b'\n')
   00577|             .map_or(0, |at| at + 1)
   00578|     };
   00579|     let mut start = line_start(prefix);
   00580|     let end = bytes[source.len() - suffix..]
   00581|         .iter()
   00582|         .position(|byte| *byte == b'\n')
   00583|         .map_or(source.len(), |at| source.len() - suffix + at);
   00584|     // Lines inserted between two lines change none: the line above carries
   00585|     // them.
   00586|     if start == end && start > 0 {
   00587|         start = line_start(start - 1);
   00588|     }
   00589|     let old = &source[start..end];
   00590|     let new = &updated[start..updated.len() - (source.len() - end)];
   00591|     (!old.is_empty() && old.len() <= MAX_EDIT_BYTES && source.matches(old).count() == 1)
   00592|         .then(|| (old.to_owned(), new.to_owned()))
   00593| }
   00594| 
   00595| /// `Insert 'x' after the line 'y' in f`: the anchor line, replaced once by the
   00596| /// anchor beside the new line, stated by the position meaning that placed it.
   00597| fn grounded_positional_insert(task: &str) -> Option<GroundedRewrite> {
   00598|     let (target, anchor, replacement) = super::positional_edit::compose_positional_insert(task)?;
   00599|     let after_anchor = [anchor.as_str(), "\n"].concat();
   00600|     let (after, inserted) = if let Some(inserted) = replacement.strip_prefix(&after_anchor) {
   00601|         (true, inserted.to_owned())
   00602|     } else {
   00603|         let before_anchor = ["\n", anchor.as_str()].concat();
   00604|         (false, replacement.strip_suffix(&before_anchor)?.to_owned())
   00605|     };
   00606|     let intent = super::positional_edit::insert_intent(after, &inserted);
   00607|     Some(GroundedRewrite {
   00608|         target,
   00609|         stated: Some((
   00610|             intent,
   00611|             vec![(NEW_SLOT, inserted), (ANCHOR_SLOT, anchor.clone())],
   00612|         )),
   00613|         pattern: anchor,
   00614|         replacement,
   00615|         scope: RewriteScope::Substring,
   00616|         renaming: false,
   00617|         unique: true,
   00618|         single_pass: false,
   00619|         verbatim: None,
   00620|     })
   00621| }
   00622| 
   00623| /// Every insert the request asks for, each its own anchored edit.
   00624| ///
   00625| /// Several clauses (`…, and insert …`), an anchor named by the line it
   00626| /// follows (T31, T34), lines rebased on the anchor (G16), or one insert whose
   00627| /// anchor is a whole line also found inside others (`the line 'b'`).
   00628| fn insert_sequence(task: &str) -> Option<Vec<PositionalInsert>> {
   00629|     super::positional_edit::positional_inserts(task)
   00630| }
   00631| 
   00632| fn grounded_rewrite(task: &str) -> Option<GroundedRewrite> {
   00633|     if let Some(positional) = grounded_positional_insert(task) {
   00634|         return Some(positional);
   00635|     }
   00636|     let (target, old_clause, new_clause) = compose_edit_request(task)?;
   00637|     let renaming = seed::lexicon().mentions_role(
   00638|         seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00639|         &task.to_lowercase(),
   00640|     );
   00641|     // A request that names a line replaces whole lines
   00642|     // (`grounded_line_replacement`).
   00643|     if !renaming && super::workspace_computed_change::names_line(task) {
   00644|         return None;
   00645|     }
   00646|     // Both operands have to be literals the request actually quoted, so prose
   00647|     // ("replace the old header with something clearer") is never rewritten as
   00648|     // bytes. What that cannot be is a count: requiring the request to hold
   00649|     // *exactly* two quoted segments made every other pair of delimiters in the
   00650|     // prompt disqualify the edit, and this repository's own prose backticks the
   00651|     // file it names. The issue #1028 ladder node "In the file
   00652|     // `src/protocol_memory.rs`, replace \"request_history\" with
   00653|     // \"conversation_history\"" quotes three things and states one replacement.
   00654|     // Asking whether each clause *is* quoted keeps the guarantee and drops the
   00655|     // arithmetic.
   00656|     // The edit request unescapes `\n` / `\t` in its literals, so the quoted
   00657|     // segments are compared unescaped too: a multi-line replacement written
   00658|     // with `\n` was otherwise not "quoted", and the general fallback wrote its
   00659|     // new text over the whole file (PR #1188 sub-agent gap 3).
   00660|     let quoted: Vec<String> = quoted_segments(task)
   00661|         .iter()
   00662|         .map(String::as_str)
   00663|         .map(super::positional_edit::unescape_prose_newlines)
   00664|         .collect();
   00665|     // A literal quoted whole counts even when backtick spans inside it pair
   00666|     // among themselves (PR #1188 G63).
   00667|     let is_quoted =
   00668|         |value: &String| quoted.contains(value) || crate::normal_markov::quotes_whole(task, value);
   00669|     let operands = if is_quoted(&old_clause) && is_quoted(&new_clause) {
   00670|         Some((old_clause, new_clause))
   00671|     } else if renaming {
   00672|         Some((
   00673|             identifier_tokens(&old_clause).next_back()?.to_owned(),
   00674|             identifier_tokens(&new_clause).next()?.to_owned(),
   00675|         ))
   00676|     } else {
   00677|         None
   00678|     }?;
   00679|     let (old, new) = operands;
   00680|     let as_quoted = |text: &str| {
   00681|         quoted_segments(task)
   00682|             .into_iter()
   00683|             .find(|raw| raw != text && super::positional_edit::unescape_prose_newlines(raw) == text)
   00684|             .unwrap_or_else(|| text.to_owned())
   00685|     };
   00686|     let verbatim = (as_quoted(&old) != old || as_quoted(&new) != new)
   00687|         .then(|| (as_quoted(&old), as_quoted(&new)));
   00688|     // A rename names a *word*, so the edit is word-scoped whichever way the
   00689|     // request spelled its operands. Without that scope the most ordinary rename
   00690|     // there is -- giving a name a prefix or a suffix -- has to be refused, since
   00691|     // an unanchored substring rewrite that reintroduces its own pattern never
   00692|     // terminates.
   00693|     //
   00694|     // A word replaced by a longer word that contains it (`smal` → `small`, a
   00695|     // typo fix) is only safe word by word for the same reason.
   00696|     let words = is_identifier_word(&old) && is_identifier_word(&new);
   00697|     let scope = if words && (renaming || new.contains(&old)) {
   00698|         RewriteScope::Word
   00699|     } else {
   00700|         RewriteScope::Substring
   00701|     };
   00702|     if old.is_empty() || old == new {
   00703|         return None;
   00704|     }
   00705|     // A new text holding the old one (`key 3` → `key 33`) is replaced in one
   00706|     // pass over the file, never rewritten again inside its own result (PR
   00707|     // #1188 G78).
   00708|     let single_pass = scope == RewriteScope::Substring && new.contains(&old);
   00709|     Some(GroundedRewrite {
   00710|         target,
   00711|         pattern: old,
   00712|         replacement: new,
   00713|         scope,
   00714|         renaming: renaming && scope == RewriteScope::Word,
   00715|         unique: false,
   00716|         single_pass,
   00717|         stated: None,
   00718|         verbatim,
   00719|     })
   00720| }
