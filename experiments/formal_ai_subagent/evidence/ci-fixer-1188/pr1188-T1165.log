   00864| pub(super) fn result_for_path(
   00865|     messages: &[ChatMessage],
   00866|     capability: Capability,
   00867|     path: &str,
   00868|     expected_content: Option<&str>,
   00869| ) -> Option<String> {
   00870|     matching_result(messages, |name, arguments| {
   00871|         if tool_capability(name) != Some(capability) {
   00872|             return false;
   00873|         }
   00874|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
   00875|             return false;
   00876|         };
   00877|         let matches_path = ["path", "filePath", "file_path"].iter().any(|key| {
   00878|             value
   00879|                 .get(key)
   00880|                 .and_then(Value::as_str)
   00881|                 .is_some_and(|observed| workspace_path_matches(path, observed))
   00882|         });
   00883|         matches_path
   00884|             && expected_content.is_none_or(|expected| {
   00885|                 value.get("content").and_then(Value::as_str) == Some(expected)
   00886|             })
   00887|     })
   00888| }
