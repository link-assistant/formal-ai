   00107| pub(super) fn plan_workspace_change_step(
   00108|     task: &str,
   00109|     messages: &[ChatMessage],
   00110|     tool_names: &[&str],
   00111| ) -> Option<AgenticPlan> {
   00112|     let task = unwrap_transport_quotes(task);
   00113|     // A continuation cue resumes this run rather than opening a new request,
   00114|     // so the read and write evidence gathered for it must survive the ping
   00115|     // (issue #1138): slicing at the last user message -- the cue itself --
   00116|     // restarted the read--write pair on every ping.
   00117|     let current_turn = &messages[super::planner::evidence_window_start(messages)..];
   00118|     // `Append the contents of a.txt to b.txt`: the source is read, and the
   00119|     // request is restated with its lines as the block placed (PR #1188 G50).
   00120|     let sourced = match sourced_request(task, current_turn) {
   00121|         Some(Sourced::Read(path)) => {
   00122|             let tool = tool_for(tool_names, Capability::Read)?;
   00123|             return Some(plan_one(tool, read_arguments(&path)));
   00124|         }
   00125|         Some(Sourced::Task(sourced)) => Some(sourced),
   00126|         None => None,
   00127|     };
   00128|     let task = sourced.as_deref().unwrap_or(task);
   00129| 
   00130|     if let Some(change) = composite_module_change(task) {
   00131|         return plan_composite_step(task, current_turn, tool_names, &change);
   00132|     }
   00133|     // Numbered lines moved to another file: placed there, then removed (G85).
   00134|     if let Some(order) = super::line_range_move::line_range_move(task) {
   00135|         return super::line_range_move::plan_line_range_move_step(
   00136|             task,
   00137|             current_turn,
   00138|             tool_names,
   00139|             &order,
   00140|         );
   00141|     }
   00142|     if let Some(change) = super::workspace_computed_change::grounded_line_change(task) {
   00143|         return super::workspace_computed_change::plan_computed_change_step(
   00144|             task,
   00145|             current_turn,
   00146|             tool_names,
   00147|             &change,
   00148|         );
   00149|     }
   00150|     if let Some(inserts) = insert_sequence(task) {
   00151|         return super::positional_edit::plan_insert_sequence_step(
   00152|             task,
   00153|             current_turn,
   00154|             tool_names,
   00155|             &inserts,
   00156|         );
   00157|     }
   00158|     // Several replacements asked in one sentence are made in order (G82).
   00159|     if let Some(change) = super::workspace_computed_change::grounded_replace_list(task) {
   00160|         return super::workspace_computed_change::plan_computed_change_step(
   00161|             task,
   00162|             current_turn,
   00163|             tool_names,
   00164|             &change,
   00165|         );
   00166|     }
   00167|     if let Some(rewrite) = grounded_rewrite(task) {
   00168|         return plan_rewrite_step(task, current_turn, tool_names, &rewrite);
   00169|     }
   00170|     let change = super::workspace_computed_change::grounded_computed_change(task)?;
   00171|     super::workspace_computed_change::plan_computed_change_step(
   00172|         task,
   00173|         current_turn,
   00174|         tool_names,
   00175|         &change,
   00176|     )
   00177| }
