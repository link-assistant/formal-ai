   00243| fn plan_rewrite_step(
   00244|     task: &str,
   00245|     current_turn: &[ChatMessage],
   00246|     tool_names: &[&str],
   00247|     rewrite: &GroundedRewrite,
   00248| ) -> Option<AgenticPlan> {
   00249|     let Some(read) = result_for_path(current_turn, Capability::Read, &rewrite.target, None) else {
   00250|         let tool = tool_for(tool_names, Capability::Read)?;
   00251|         return Some(plan_one(tool, read_arguments(&rewrite.target)));
   00252|     };
