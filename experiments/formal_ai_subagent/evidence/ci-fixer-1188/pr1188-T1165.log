   00031| #[derive(Debug, Clone, PartialEq, Eq)]
   00032| struct GroundedRewrite {
   00033|     target: String,
   00034|     pattern: String,
   00035|     replacement: String,
   00036|     /// How the pattern is allowed to match. Renaming an identifier is a
   00037|     /// word-scoped edit; replacing a quoted literal is a substring one -- or a
   00038|     /// word-scoped one when the new word contains the old (`smal` → `small`).
   00039|     scope: RewriteScope,
   00040|     /// Whether the request renamed a name (a word-scoped rename).
   00041|     renaming: bool,
   00042|     /// Whether the pattern must occur exactly once (a positional insertion's
   00043|     /// anchor), replaced once rather than everywhere.
   00044|     unique: bool,
   00045|     /// Whether the replacement holds the pattern, so it is applied in one
   00046|     /// pass rather than rewritten until no pattern is left (PR #1188 G78).
   00047|     single_pass: bool,
   00048|     /// The seed sentence that states the change, when it is not the
   00049|     /// rename/replace one (a positional insertion's).
   00050|     stated: Option<(&'static str, Vec<(&'static str, String)>)>,
   00051|     /// The pattern and replacement as the request wrote them, when it wrote
   00052|     /// `\n` / `\t` escapes the rewrite unescaped (see [`as_written`]).
   00053|     verbatim: Option<(String, String)>,
   00054| }
