   00890| pub(super) fn result_for_edit(
   00891|     messages: &[ChatMessage],
   00892|     path: &str,
   00893|     old: &str,
   00894|     new: &str,
   00895| ) -> Option<String> {
   00896|     matching_result(messages, |name, arguments| {
   00897|         if tool_capability(name) != Some(Capability::Edit) {
   00898|             return false;
   00899|         }
   00900|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
