   00146|         format!("Replace {open}{old}{close} with {open}{next}{ending} in {TARGET}.")
   00147|     } else {
   00148|         format!("In {TARGET} replace {open}{old}{close} with {open}{next}{ending}.")
   00149|     };
   00150|     (request, old, next)
   00151| }
