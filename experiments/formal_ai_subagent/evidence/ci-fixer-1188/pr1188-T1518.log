   00137| fn generate(random: &mut Generator) -> (String, String, String) {
   00138|     let (open, close) = STYLES[random.below(STYLES.len())];
   00139|     let old = payload(random);
   00140|     let mut next = payload(random);
   00141|     if next == old {
   00142|         next = format!("{next} beta");
   00143|     }
   00144|     let ending = if random.next() < 0.2 { "" } else { close };
