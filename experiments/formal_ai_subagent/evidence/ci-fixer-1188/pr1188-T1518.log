   00129| fn payload(random: &mut Generator) -> String {
   00130|     let count = 1 + random.below(3);
   00131|     (0..count)
   00132|         .map(|_| WORDS[random.below(WORDS.len())])
   00133|         .collect::<Vec<_>>()
