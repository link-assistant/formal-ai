   00176|             .iter()
   00177|             .find_map(|key| arguments[*key].as_str())
   00178|             .unwrap_or_default()
   00179|             .to_owned();
   00180|         let result = match call.tool.as_str() {
   00181|             "read" => files.get(&path).cloned().unwrap_or_default(),
   00182|             "write" => {
   00183|                 files.insert(
   00184|                     path,
   00185|                     arguments["content"].as_str().unwrap_or_default().to_owned(),
   00186|                 );
   00187|                 String::new()
   00188|             }
   00189|             "edit" => {
   00190|                 let old = arguments["oldString"].as_str().unwrap_or_default();
   00191|                 let new = arguments["newString"].as_str().unwrap_or_default();
   00192|                 let text = files.get(&path).cloned().unwrap_or_default();
   00193|                 if text.contains(old) {
   00194|                     files.insert(path, text.replacen(old, new, 1));
   00195|                 }
   00196|                 String::new()
   00197|             }
   00198|             "bash" => {
   00199|                 commands.push(arguments["command"].as_str().unwrap_or_default().to_owned());
   00200|                 String::new()
   00201|             }
   00202|             _ => String::new(),
   00203|         };
   00204|         let id = format!("call_{index}");
   00205|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00206|             id.clone(),
   00207|             call.tool.clone(),
   00208|             call.arguments.clone(),
   00209|         )]));
   00210|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00211|     }
   00212|     (files, commands)
   00213| }
