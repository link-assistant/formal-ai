   00646| /// A research harness that declares no MCP tool-call timeout makes the Agent
   00647| /// CLI compute its per-tool deadline as `NaN`, so a call the mock answers in
   00648| /// milliseconds aborts with `timed out after NaN seconds`. Run 32107664418
   00649| /// failed exactly that way: `run_issue_781.sh` ended after one fetch and
   00650| /// tripped its own `[ "$fetches" -ge 3 ]` assertion.
   00651| ///
   00652| /// Pinned for `run_issue_781.sh` only, which is where the fault was observed.
   00653| /// `run_issue_687.sh` and `run_issue_771.sh` look similarly exposed but have
   00654| /// never produced a `NaN` deadline, and adding the same keys to them broke
   00655| /// them -- so they are left as they are rather than "fixed" against a fault
   00656| /// they do not have.
   00657| ///
   00658| /// `mcp_defaults` is added for the Agent CLI only. `OpenCode` reads the same
   00659| /// file and validates it against its own schema, which rejects that key
   00660| /// outright ("Configuration is invalid ... Unrecognized key: `mcp_defaults`"),
   00661| /// so writing it unconditionally trades one red client for another.
   00662| #[test]
   00663| fn the_research_harness_declares_an_mcp_tool_call_timeout() {
   00664|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00665|     let harness = fs::read_to_string(format!(
   00666|         "{manifest_dir}/experiments/agent_cli_e2e/run_issue_781.sh"
   00667|     ))
   00668|     .expect("research E2E harness should be readable");
   00669| 
   00670|     assert!(
   00671|         harness.contains(r#""tool_call_timeout": 120000"#),
   00672|         "run_issue_781.sh must give its MCP server an explicit tool-call \
   00673|          timeout, or the Agent CLI computes it as NaN and aborts the call"
   00674|     );
   00675|     assert!(
   00676|         harness.contains("max_tool_call_timeout: 600000"),
   00677|         "run_issue_781.sh must declare mcp_defaults.max_tool_call_timeout"
   00678|     );
   00679|     assert!(
   00680|         harness.contains(r#"if [ "$for_client" = agent ]"#),
   00681|         "mcp_defaults must be written only for the Agent CLI: OpenCode reads \
   00682|          the same file and its schema rejects that key"
   00683|     );
   00684| }
