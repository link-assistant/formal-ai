   00392| /// Issue #812: both release jobs gated on `[lint, test, build]` alone, so a red
   00393| /// `Secrets Scan` or E2E suite on `main` did not stop the crate, the Docker
   00394| /// image and the GitHub Release from publishing.
   00395| #[test]
   00396| fn releases_do_not_publish_past_a_failing_secrets_scan_or_e2e_suite() {
   00397|     let workflow = release_workflow();
   00398| 
   00399|     for job_name in ["auto-release", "manual-release"] {
   00400|         let job = job_block(&workflow, job_name);
   00401|         let effective: String = job
   00402|             .lines()
   00403|             .filter(|line| !line.trim_start().starts_with('#'))
   00404|             .collect::<Vec<_>>()
   00405|             .join("\n");
   00406| 
   00407|         for gate in ["secrets-scan", "test-e2e-local", "test-agent-cli-e2e"] {
   00408|             // The acceptable results must be enumerated, not excluded. A job
   00409|             // killed by its own `timeout-minutes` reports as 'cancelled', which
   00410|             // a `!= 'failure'` guard would wave through -- run 29767811026 is
   00411|             // the observed instance of exactly that result value.
   00412|             assert!(
   00413|                 effective.contains(&format!(
   00414|                     "(needs.{gate}.result == 'success' || needs.{gate}.result == 'skipped')"
   00415|                 )),
   00416|                 "{job_name} must gate on {gate} being success-or-skipped, so a \
   00417|                  timed-out (cancelled) job cannot release (issue #812)"
   00418|             );
   00419|             assert!(
   00420|                 !effective.contains(&format!("needs.{gate}.result != 'failure'")),
   00421|                 "{job_name} must not use `!= 'failure'` for {gate}: a timeout \
   00422|                  reports as 'cancelled' and would pass that check (issue #812)"
   00423|             );
   00424|             assert!(
   00425|                 effective.contains(gate),
   00426|                 "{job_name} must declare {gate} in needs: (issue #812)"
   00427|             );
   00428|         }
   00429|     }
   00430| }
