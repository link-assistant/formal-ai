   00909|     let actual_jobs = workflow_job_names(&workflow);
   00910|     let expected_jobs = expected_timeouts
   00911|         .iter()
   00912|         .map(|(job_name, _)| *job_name)
   00913|         .collect::<Vec<_>>();
   00914|     assert_eq!(actual_jobs, expected_jobs);
   00915| 
   00916|     for (job_name, timeout_minutes) in expected_timeouts {
   00917|         let job = job_block(&workflow, job_name);
   00918|         if timeout_minutes == 0 {
   00919|             // A reusable call declares no cap of its own; the called workflow's
   00920|             // jobs own them. Read whichever workflow this job actually calls,
   00921|             // so a second delegating job cannot be checked against the first
   00922|             // one's file (issue #1017 added `base`).
   00923|             let called = job
   00924|                 .lines()
   00925|                 .find_map(|line| line.trim().strip_prefix("uses: ./"))
   00926|                 .unwrap_or_else(|| {
   00927|                     panic!("{job_name} is listed as delegating but calls no reusable workflow")
   00928|                 })
   00929|                 .trim();
   00930|             let reusable =
   00931|                 fs::read_to_string(format!("{}/../{called}", env!("CARGO_MANIFEST_DIR")))
   00932|                     .unwrap_or_else(|error| panic!("read {called}: {error}"));
   00933|             for inner_job in workflow_job_names(&reusable) {
   00934|                 assert!(
   00935|                     job_block(&reusable, inner_job).contains("    timeout-minutes:"),
   00936|                     "{inner_job} should declare an explicit timeout"
   00937|                 );
   00938|             }
   00939|             continue;
   00940|         }
   00941|         let expected = format!("    timeout-minutes: {timeout_minutes}\n");
   00942|         assert!(
   00943|             job.contains(&expected),
   00944|             "{job_name} should declare {expected:?}"
   00945|         );
   00946|     }
   00947| }
