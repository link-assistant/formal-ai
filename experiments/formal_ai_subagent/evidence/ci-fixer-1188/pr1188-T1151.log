   00230| fn pages_e2e_navigation_preserves_repository_subpath() {
   00231|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00232|     let pages_config = fs::read_to_string(format!(
   00233|         "{manifest_dir}/rust/tests/e2e/playwright.pages.config.js"
   00234|     ))
   00235|     .unwrap();
   00236|     let demo_spec =
   00237|         fs::read_to_string(format!("{manifest_dir}/rust/tests/e2e/tests/demo.spec.js")).unwrap();
   00238|     // The multilingual suite is split across `multilingual-*.spec.js`
   00239|     // (repository line budget); every part must keep the relative navigation.
   00240|     let multilingual_specs = [
   00241|         "multilingual-chat.spec.js",
   00242|         "multilingual-wikipedia.spec.js",
   00243|         "multilingual-memory-settings.spec.js",
   00244|         "multilingual-issue-27.spec.js",
   00245|     ]
   00246|     .map(|name| {
   00247|         let spec =
   00248|             fs::read_to_string(format!("{manifest_dir}/rust/tests/e2e/tests/{name}")).unwrap();
   00249|         (format!("tests/e2e/tests/{name}"), spec)
   00250|     });
   00251|     let connectivity_spec = fs::read_to_string(format!(
   00252|         "{manifest_dir}/rust/tests/e2e/tests/connectivity.spec.js"
   00253|     ))
   00254|     .unwrap();
   00255| 
   00256|     assert!(
   00257|         pages_config.contains("normalizeBaseUrl"),
   00258|         "Pages e2e should normalize PAGES_URL with a trailing slash so ./ resolves inside /formal-ai/"
   00259|     );
   00260|     assert!(
   00261|         pages_config.contains("https://link-assistant.github.io/formal-ai/"),
   00262|         "default Pages URL should include the repository subpath and trailing slash"
   00263|     );
   00264| 
   00265|     // The app moved to /app/ (issue #479), so the Pages baseURL targets /app/.
   00266|     // The app specs navigate with a relative './' (→ /app/), while connectivity
   00267|     // reaches its sibling harness with a relative '../tests/' (→ /tests/). Both
   00268|     // are relative, so the /formal-ai/ repository subpath is always preserved;
   00269|     // an absolute '/…' would drop it.
   00270|     let mut navigation_cases = vec![
   00271|         (
   00272|             "tests/e2e/tests/demo.spec.js",
   00273|             demo_spec.as_str(),
   00274|             "page.goto('./')",
   00275|         ),
   00276|         (
   00277|             "tests/e2e/tests/connectivity.spec.js",
   00278|             connectivity_spec.as_str(),
   00279|             "page.goto('../tests/')",
   00280|         ),
   00281|     ];
   00282|     for (path, spec) in &multilingual_specs {
   00283|         navigation_cases.push((path.as_str(), spec.as_str(), "page.goto('./')"));
   00284|     }
   00285|     for (path, spec, expected_nav) in navigation_cases {
   00286|         assert!(
   00287|             !spec.contains("page.goto('/');"),
   00288|             "{path} should not navigate to / because URL resolution drops the /formal-ai/ subpath"
   00289|         );
   00290|         assert!(
   00291|             spec.contains(expected_nav),
   00292|             "{path} should navigate with a relative {expected_nav} so Pages tests stay under the repository subpath"
   00293|         );
   00294|     }
   00295| }
