   00192| #[test]
   00193| fn wait_for_pages_deployment_is_marker_authoritative() {
   00194|     // Issue #479 (root cause, take 2): the live-Pages freshness probe used to
   00195|     // require the raw deploy SHA to appear in the served index BODY
   00196|     // (`grep -Fq "$expected_sha" "$index_file"`). That coupled the probe to every
   00197|     // root page embedding the commit SHA verbatim. When the issue #479 landing
   00198|     // page shipped at `/` WITHOUT cache-busted asset refs, the stamped index
   00199|     // never contained the SHA, so the probe ran the full 300s and timed out --
   00200|     // failing the whole pipeline and (via the desktop-release gate) suppressing
   00201|     // every desktop build. The probe is now marker-authoritative: GitHub Pages
   00202|     // deploys atomically, so deployment.json advertising "sha":"<expected_sha>"
   00203|     // is sufficient proof the matching stamped index is live.
   00204|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00205|     let wait_script = fs::read_to_string(format!(
   00206|         "{manifest_dir}/scripts/wait-for-pages-deployment.sh"
   00207|     ))
   00208|     .unwrap();
   00209| 
   00210|     // The marker SHA is the authoritative freshness signal.
   00211|     assert!(
   00212|         wait_script.contains("${expected_sha}") && wait_script.contains("\"$marker_file\""),
   00213|         "wait script should require the deployment.json marker to advertise the expected SHA"
   00214|     );
   00215|     // The brittle "index body must contain the SHA" requirement must be gone.
   00216|     assert!(
   00217|         !wait_script.contains("-Fq \"$expected_sha\" \"$index_file\""),
   00218|         "issue #479 regression: the probe must NOT hard-require the raw SHA in the index body -- \
   00219|          a valid root page without cache-busted asset refs would hang the probe for the full timeout"
   00220|     );
   00221|     // But the defensive placeholder guards (catch a half-run stamp step) remain.
   00222|     assert!(
   00223|         wait_script.contains("__FORMAL_AI_ASSET_VERSION__")
   00224|             && wait_script.contains("__FORMAL_AI_VERSION__"),
   00225|         "wait script should still reject an index that retains un-stamped placeholders"
   00226|     );
   00227| }
