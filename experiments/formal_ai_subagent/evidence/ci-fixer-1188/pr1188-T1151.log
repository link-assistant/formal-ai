   00559| /// Issue #812: nothing validated the pipeline definitions themselves, and
   00560| /// `cargo clippy` ran without `-D warnings` while every lint in `[lints.clippy]`
   00561| /// is set to `warn` -- so clippy printed findings and exited 0.
   00562| #[test]
   00563| fn lint_job_gates_on_workflow_shell_and_clippy_findings() {
   00564|     // Clippy and the shell lint are registered gates since issue #991.
   00565|     // actionlint left this job in issue #1076: as a bare binary it skips every
   00566|     // `run:` check and exits 0 when ShellCheck is absent, so it runs as the
   00567|     // Docker image in `workflows.yml` now. `issue_999` owns the assertion.
   00568|     let workflow = ci_surface();
   00569|     let lint = job_block(&workflow, "lint");
   00570| 
   00571|     assert!(
   00572|         lint.contains("cargo clippy --manifest-path rust/Cargo.toml --lib --bins --tests --all-features -- -D warnings"),
   00573|         "clippy must lint executable test targets and fail the job on findings"
   00574|     );
   00575|     assert!(
   00576|         lint.contains("cargo check --manifest-path rust/Cargo.toml --examples --all-features"),
   00577|         "examples must be compile-checked without linking every standalone binary (issue #534)"
   00578|     );
   00579|     assert!(
   00580|         !lint.contains("actionlint"),
   00581|         "workflow linting belongs to .github/workflows/workflows.yml since issue \
   00582|          #1076; a second copy here would drift from the Docker-image form that \
   00583|          guarantees ShellCheck is present"
   00584|     );
   00585|     assert!(
   00586|         lint.contains("scripts/lint-shell-scripts.sh"),
   00587|         "standalone shell scripts must be linted (issue #812)"
   00588|     );
   00589| 
   00590|     // Issue #977 moved the selector into a script; the empty-list guard is the
   00591|     // part that actually keeps the step from passing vacuously.
   00592|     let shell_lint = std::fs::read_to_string(format!(
   00593|         "{}/../scripts/lint-shell-scripts.sh",
   00594|         env!("CARGO_MANIFEST_DIR")
   00595|     ))
   00596|     .expect("lint-shell-scripts.sh");
   00597|     assert!(shell_lint.contains("shellcheck --severity=warning"));
   00598|     assert!(
   00599|         shell_lint.contains("the lint selector is broken"),
   00600|         "an empty selector must fail rather than lint nothing (issue #812)"
   00601|     );
   00602| }
