   00786| #[test]
   00787| fn release_workflow_jobs_have_explicit_timeouts() {
   00788|     let workflow = release_workflow();
   00789|     let expected_timeouts = [
   00790|         ("detect-changes", 5),
   00791|         ("changelog", 10),
   00792|         // Issue #808's evidence-check job now lives in
   00793|         // `.github/workflows/evidence-check.yml`; its timeout is asserted by
   00794|         // `evidence_check_workflow_caps_its_job_and_installs_rust_script_with_the_retry_wrapper`.
   00795|         ("docker-build", 30),
   00796|         ("secrets-scan", 10),
   00797|         ("version-check", 5),
   00798|         // Issue #1081 (D15): probes every publishing credential with a write
   00799|         // before the pipeline spends 90 minutes building what it cannot
   00800|         // publish. Five probes over HTTP against five registries; the cap is a
   00801|         // backstop for a hung TLS handshake, not a work budget.
   00802|         ("release-preflight", 5),
   00803|         // Issue #1017: resolves the base-branch commit once so `lint`, `test`
   00804|         // and the macOS lane all merge the same one instead of each resolving
   00805|         // the tip at its own start time. A reusable workflow, so it owns its
   00806|         // own cap -- and so `release.yml` does not pay lines for it against the
   00807|         // 1500-line band this same file pins below.
   00808|         ("base", 0),
   00809|         // Issue #812: raised from 10; the job grew from ~3.3 to ~7.8 minutes.
   00810|         // Issue #1076 (D5): raised from 15. Over 400 `main` runs the worst
   00811|         // case was 12.7 min, 84.4% of that cap and trending up (6.0 -> 12.7
   00812|         // across the window) -- the deadline, not the backstop, and a cap kills
   00813|         // as `cancelled`. No single step dominates here, so the cap is the only
   00814|         // mechanism available; 25 puts the same worst case at 50.7%.
   00815|         // Issue #1138: raised from 25. The gate set kept growing and run
   00816|         // 35806556194 consumed the full 25 minutes, killed mid-gate inside
   00817|         // repository_workspace_protocol and reported as `cancelled` -- the red
   00818|         // hidden behind a cancelled job, every gate that did run passing. The
   00819|         // measured demand of at least 25.2 min sits under 56% of 45, back
   00820|         // below the 70% warn line of check-job-headroom.rs.
   00821|         // PR #1188: instead of a fourth raise, the gates run as four parallel
   00822|         // lanes (`lane` in data/meta/ci-gates/); 30 holds the slowest (~15).
   00823|         ("lint", 30),
   00824|         // Issue #812: raised from 15 after run 29767811026 was killed 1.1 s
   00825|         // after the suite passed. See
   00826|         // `test_job_budget_exceeds_the_measured_suite_cost_and_warns_before_it_is_eaten`.
   00827|         // Issue #1012 partitions the macOS core suite so every slice retains
   00828|         // this baseline rather than extending a monolithic timeout.
   00829|         // Issue #1017 raised this from 25: 455s of the job runs outside the
   00830|         // budgeted step, so a 20-minute budget under a 25-minute cap could
   00831|         // never expire first.
   00832|         // Issue #1081 raised this from 35. The job is a matrix, and its two
   00833|         // legs are budgeted separately: the `full` leg now declares 2640s
   00834|         // across four steps and the `specification` leg 2460s across two, after
   00835|         // the compile that was 86% of `Run specification tests` was split into
   00836|         // a step of its own. One cap covers both legs, so it has to hold the
   00837|         // larger sum at or under the 70% share
   00838|         // `job_budget_fit::the_budgets_a_job_can_spend_together_fit_inside_its_cap`
   00839|         // enforces: 2640/3900 is 67.7%.
   00840|         // The same fix raised the cap from 65 to 90: the spec lane's worst
   00841|         // budgeted group is 3600s, and 3600/5400 leaves it at 66% of the cap
   00842|         // instead of 92% of the old one -- the budget, not the cap, stays the
   00843|         // real deadline.
   00844|         // Issue #1138 raised the full leg's `Run tests` budget from 1440 to
   00845|         // 2400 (measured demand ~1520s: unit 1251-1315s + integration ~200s),
   00846|         // which lifts that leg's sum to 3600s -- the same 66% of this cap.
   00847|         // PR #1188 (R1188-U9) lowered it to 30: both suites run prebuilt
   00848|         // executables in shards (full five, specification four), and each
   00849|         // budgeted group is 1080s, 60% of the cap.
   00850|         ("test", 30),
   00851|         // Issue #1014 compiles one nextest archive and fans it out to five
   00852|         // macOS runners. The reusable workflow owns both internal timeouts.
   00853|         ("macos-core-tests", 0),
   00854|         // Issue #896: raised from 10; the published web-search/web-capture
   00855|         // graphs moved the job from ~4-5 to 7.2 minutes, and a cold release
   00856|         // build after a Cargo.lock change hit the former cap.
   00857|         // Issue #1076 (D5): raised from 15. The run that missed its cargo
   00858|         // cache took 11.6 min, 77.0% of the cap; 20 puts it at 57.8%.
   00859|         ("build", 20),
   00860|         // R1015: the JavaScript server answers the parity corpus as the
