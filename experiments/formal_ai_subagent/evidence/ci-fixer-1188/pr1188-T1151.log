   00297| #[test]
   00298| fn test_job_skips_non_code_changes() {
   00299|     // Issue #442: the `test` job ran whenever the `changelog` job was *skipped*.
   00300|     // `changelog` is skipped precisely when there are no code changes (docs-only
   00301|     // commits, .gitkeep edits, changelog-fragment-only commits), so the
   00302|     // `needs.changelog.result == 'skipped'` clause turned "nothing relevant
   00303|     // changed" into "run the entire test suite". This regression guard pins the
   00304|     // corrected gating: `test` keys off the detect-changes outputs, exactly like
   00305|     // `lint` and `coverage`, and never resurrects the changelog-skip escape.
   00306|     let workflow = release_workflow();
   00307|     let test = job_block(&workflow, "test");
   00308| 
   00309|     assert!(
   00310|         !test.contains("needs.changelog.result == 'skipped'"),
   00311|         "test job must not run merely because the changelog check was skipped; \
   00312|          a skipped changelog means there were no code changes (issue #442)"
   00313|     );
   00314|     assert!(
   00315|         !test.contains("needs.changelog.result == 'success'"),
   00316|         "test job should be decoupled from the changelog check and gate on the \
   00317|          change detector instead (issue #442)"
   00318|     );
   00319|     // Issue #1017 added `base`, which resolves the base-branch commit once so
   00320|     // every gate merges the same one. Assert the dependency rather than the
   00321|     // exact list, so adding a dependency cannot break a contract that is about
   00322|     // `detect-changes`.
   00323|     assert!(
   00324|         test.contains("needs: [detect-changes")
   00325|             && test.lines().any(|line| {
   00326|                 line.trim().starts_with("needs:") && line.contains("detect-changes")
   00327|             }),
   00328|         "test job should depend on detect-changes so it can gate on its outputs"
   00329|     );
   00330|     assert!(
   00331|         test.contains("needs.detect-changes.outputs.any-code-changed == 'true'"),
   00332|         "test job should run when code files changed"
   00333|     );
   00334|     assert!(
   00335|         test.contains("needs.detect-changes.outputs.rs-changed == 'true'"),
   00336|         "test job should run when Rust sources changed"
   00337|     );
   00338|     assert!(
   00339|         test.contains("needs.detect-changes.outputs.toml-changed == 'true'"),
   00340|         "test job should run when Cargo manifests changed"
   00341|     );
   00342|     // Issue #1107: `workflow-changed` is true for any file under
   00343|     // `.github/workflows/`, so gating the compiled test matrix on it made an
   00344|     // edit to a scheduled benchmark pay for the whole suite. What the matrix
   00345|     // cares about is the pipeline it runs inside -- its own definition, a
   00346|     // composite action it calls, or a script those run.
   00347|     assert!(
   00348|         test.contains("needs.detect-changes.outputs.pipeline-changed == 'true'"),
   00349|         "test job should run when the pipeline it runs inside changed"
   00350|     );
   00351|     assert!(
   00352|         !test.contains("github.event_name == 'push'")
   00353|             && test.contains("github.event_name == 'workflow_dispatch'"),
   00354|         "issue #846 requires pushes to obey detect-changes while manual \
   00355|          dispatch remains unconditional"
   00356|     );
   00357|     assert!(
   00358|         // Issue #808 / CI-CD-BEST-PRACTICES.md section 10: `always()` also runs
   00359|         // the job when the *run* is cancelled, which is not what this gate wants.
   00360|         // `!cancelled()` is enough to stop a skipped `detect-changes` from
   00361|         // cascading -- any status-check function disables the auto-skip.
   00362|         test.contains("!cancelled()") && !test.contains("always()"),
   00363|         "test job needs !cancelled() so the skipped detect-changes dependency \
   00364|          does not cascade on workflow_dispatch"
   00365|     );
   00366| }
