   00949| /// Issue #479: the docs hub links to a Rust API reference at `/docs/api/`. The
   00950| /// deploy-pages job generates it with `cargo doc` and copies it into the Pages
   00951| /// artifact — and the copy must run *after* stamping (rustdoc HTML carries no
   00952| /// version placeholders, so copying post-stamp keeps the large generated tree
   00953| /// out of the placeholder scan).
   00954| #[test]
   00955| fn pages_deploy_generates_api_docs_and_copies_them_after_stamping() {
   00956|     let workflow = pages_artifact_workflow();
   00957|     let deploy = job_block(&workflow, "build");
   00958| 
   00959|     assert!(
   00960|         deploy.contains("bash scripts/install-rust-script.sh"),
   00961|         "the Pages build should install rust-script with the retry wrapper"
   00962|     );
   00963|     assert!(
   00964|         deploy.contains("bash scripts/build-rust-api-docs.sh"),
   00965|         "deploy-pages should invoke the API-docs builder"
   00966|     );
   00967|     assert!(
   00968|         deploy.contains("cp -R target/doc/. js/docs/api/"),
   00969|         "deploy-pages should copy the generated docs into js/docs/api/"
   00970|     );
   00971| 
   00972|     let stamp_pos = deploy
   00973|         .find("Stamp GitHub Pages artifact")
   00974|         .expect("deploy-pages should stamp the Pages artifact");
   00975|     let copy_pos = deploy
   00976|         .find("Copy Rust API docs into the Pages artifact")
   00977|         .expect("deploy-pages should copy the API docs");
   00978|     assert!(
   00979|         stamp_pos < copy_pos,
   00980|         "the API-docs copy must run after the stamp step so rustdoc HTML is not scanned for placeholders"
   00981|     );
   00982| 
   00983|     // cargo doc emits the crate root under target/doc/formal_ai/ (lib name
   00984|     // formal_ai); a redirect at the doc root keeps /docs/api/ from 404ing.
   00985|     let docs_script = std::fs::read_to_string(format!(
   00986|         "{}/../scripts/build-rust-api-docs.sh",
   00987|         env!("CARGO_MANIFEST_DIR")
   00988|     ))
   00989|     .expect("build-rust-api-docs.sh");
   00990|     assert!(
   00991|         docs_script.contains("cargo doc --no-deps --lib"),
   00992|         "the API-docs builder should run cargo doc"
   00993|     );
   00994|     assert!(
   00995|         docs_script.contains("url=formal_ai/index.html"),
   00996|         "a redirect should point /docs/api/ at the crate root"
   00997|     );
   00998| }
