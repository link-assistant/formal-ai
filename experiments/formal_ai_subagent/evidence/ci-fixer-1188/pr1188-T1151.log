   00432| /// Issue #812: run 29767811026 reported `Test (ubuntu-latest)` as failed with
   00433| /// every test passing -- the suite finished 1.1 s before `timeout-minutes: 15`
   00434| /// killed the job. The budget must exceed the measured cost, and the step must
   00435| /// say so out loud before the margin is eaten again.
   00436| #[test]
   00437| fn test_job_budget_exceeds_the_measured_suite_cost_and_warns_before_it_is_eaten() {
   00438|     let workflow = release_workflow();
   00439|     let test_job = job_block(&workflow, "test");
   00440| 
   00441|     // Issue #1017: the cap has to clear the budget by more than the job's
   00442|     // unbudgeted setup -- checkout, disk cleanup, the data-file and self-AST
   00443|     // census gates and the doc tests measured 455s on run 31937348472 -- or the
   00444|     // job clock still wins and the overrun is reported as `cancelled`.
   00445|     //
   00446|     // Issue #1081 replaced the two exact numbers this used to pin with floors,
   00447|     // and both moved the same day. Pinning an exact budget is what makes a
   00448|     // budget unable to grow when the work under it grows, which is how the
   00449|     // macOS specification shard reached 100.1% of its budget twice with no
   00450|     // warning; the arithmetic that decides what the numbers should be now
   00451|     // lives in `tests/unit/ci-cd/job_budget_fit.rs`, which recomputes the whole
   00452|     // job from the workflow instead of memorising one figure from it. What
   00453|     // this test still defends is the shape: a plain-number cap, a budget on
   00454|     // the suite, and the wrapper that makes the overrun red rather than grey.
   00455|     let cap_minutes: u64 = test_job
   00456|         .lines()
   00457|         .find_map(|line| line.trim().strip_prefix("timeout-minutes:"))
   00458|         .and_then(|value| value.trim().parse().ok())
   00459|         .expect("the test job declares a plain-number timeout-minutes");
   00460|     // PR #1188 (R1188-U9) runs the suite as five shards of prebuilt
   00461|     // executables, a fifth of it about 450s (run 37802763478), so the floors
   00462|     // are per shard: 15 minutes of shard work behind a 25-minute backstop.
   00463|     assert!(
   00464|         cap_minutes >= 25,
   00465|         "the test job's cap is {cap_minutes}m; a shard of the suite plus its \
   00466|          setup needs at least 25m of backstop behind it"
   00467|     );
   00468|     let suite_budget: u64 = workflow_step_block(test_job, "Run tests")
   00469|         .lines()
   00470|         .find_map(|line| line.trim().strip_prefix("TEST_BUDGET_SECONDS:"))
   00471|         .and_then(|value| value.trim().parse().ok())
   00472|         .expect("the full-suite step declares a plain-number execution budget");
   00473|     assert!(
   00474|         suite_budget >= 900,
   00475|         "the full suite's execution budget is {suite_budget}s, below the 900s \
   00476|          that twice a measured shard needs"
   00477|     );
   00478|     assert!(
   00479|         suite_budget <= cap_minutes * 60,
   00480|         "the full suite's {suite_budget}s budget cannot expire before the          {cap_minutes}m cap that is supposed to be its backstop"
   00481|     );
   00482|     assert!(
   00483|         test_job.contains("scripts/run-with-budget-warning.sh"),
   00484|         "creeping back toward the cap must be visible in the run summary rather \
   00485|          than resurfacing as a mystery cancellation (issue #812)"
   00486|     );
   00487| }
