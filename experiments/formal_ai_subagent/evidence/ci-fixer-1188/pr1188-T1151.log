   00368| #[test]
   00369| fn change_gated_jobs_never_depend_on_a_skipped_changelog() {
   00370|     // Generalises issue #442 across every change-gated job: none of them should
   00371|     // treat a *skipped* changelog/version check as a signal to run. A skipped
   00372|     // upstream check means "no code changed", which must never widen coverage.
   00373|     // The `coverage` job moved to `.github/workflows/coverage.yml` for issue
   00374|     // #895; `coverage_jobs_never_depend_on_a_skipped_upstream_check` in
   00375|     // `workflow_coverage.rs` pins this same property for it there.
   00376|     let workflow = release_workflow();
   00377|     for job_name in ["lint", "test", "test-e2e-local"] {
   00378|         let job = job_block(&workflow, job_name);
   00379|         // Inspect only effective YAML (skip `#` comment lines) so the rationale
   00380|         // comments that quote the old buggy clause don't trip the guard.
   00381|         let has_skip_dependency = job
   00382|             .lines()
   00383|             .filter(|line| !line.trim_start().starts_with('#'))
   00384|             .any(|line| line.contains("result == 'skipped'"));
   00385|         assert!(
   00386|             !has_skip_dependency,
   00387|             "{job_name} job must not run because an upstream check was skipped (issue #442)"
   00388|         );
   00389|     }
   00390| }
