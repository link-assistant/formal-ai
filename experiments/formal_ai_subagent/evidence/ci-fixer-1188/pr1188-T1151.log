   00686| /// Issue #534 forbids caching `target/` in CI, and the reason is disk rather
   00687| /// than taste: a hosted ubuntu runner ships ~14 GB free, seven jobs already run
   00688| /// `scripts/free-runner-disk.sh` to survive, and a job that exhausts `/` takes
   00689| /// the runner down with no failed step and no log to download. A cached target
   00690| /// tree measured 930 MB per job on top of that.
   00691| ///
   00692| /// The guard read three hand-listed files, so `agentic-cli-matrix.yml` and
   00693| /// `external-benchmarks.yml` cached it unnoticed. It now reads every workflow;
   00694| /// this test pins that it does, because a policy enforced over part of the tree
   00695| /// reports compliance it has not checked.
   00696| #[test]
   00697| fn the_disk_policy_reads_every_workflow_not_a_hand_listed_few() {
   00698|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00699|     let guard = fs::read_to_string(format!("{manifest_dir}/scripts/check-disk-usage-policy.rs"))
   00700|         .expect("disk usage policy guard should be readable");
   00701| 
   00702|     assert!(
   00703|         guard.contains(r#"fs::read_dir(".github/workflows")"#),
   00704|         "the disk policy must sweep the workflow directory, or a workflow it \
   00705|          does not list can cache the target tree unnoticed"
   00706|     );
   00707| 
   00708|     let dir = format!("{manifest_dir}/.github/workflows");
   00709|     let mut checked = 0;
   00710|     for entry in fs::read_dir(&dir).expect("workflow directory should be readable") {
   00711|         let path = entry.expect("directory entry").path();
   00712|         if path.extension().is_none_or(|ext| ext != "yml") {
   00713|             continue;
   00714|         }
   00715|         let workflow = fs::read_to_string(&path).expect("workflow should be readable");
   00716|         assert!(
   00717|             !workflow.lines().any(|line| line.trim() == "target"),
   00718|             "{} caches the target tree, which issue #534 forbids",
   00719|             path.display()
   00720|         );
   00721|         checked += 1;
   00722|     }
   00723|     assert!(checked > 0, "the sweep must actually find workflows");
   00724| }
