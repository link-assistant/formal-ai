   00049| #[test]
   00050| fn the_diagnostic_marker_is_a_seed_table_row() {
   00051|     assert_eq!(
   00052|         handler_table_rows("diagnostic_marker"),
   00053|         [("[diagnostic]".to_owned(), "section".to_owned())]
   00054|     );
   00055| }
