   00087|     let response = UniversalSolver::default().solve("[DIAGNOSTIC] Hi");
   00088|     assert!(
   00089|         !response
   00090|             .evidence_links
   00091|             .iter()
   00092|             .any(|link| link == "diagnostic_mode:active"),
