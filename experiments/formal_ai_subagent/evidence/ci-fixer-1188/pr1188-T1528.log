   00057| #[test]
   00058| fn a_marked_prompt_appends_its_trace_under_the_seeded_marker() {
   00059|     // The diagnostic row solves the unmarked prompt with a fresh solver of the
   00060|     // same configuration and appends its links, evidence and trace under the
   00061|     // marker, so the expected answer is assembled from that same solve.
   00062|     let inner = UniversalSolver::default().solve("Hi");
   00063|     let marked = UniversalSolver::default().solve("[diagnostic] Hi");
   00064|     let mut expected = format!(
   00065|         "{}\n\n[diagnostic]\n{}\n",
   00066|         inner.answer,
   00067|         inner.links_notation.trim_end()
   00068|     );
   00069|     for link in &inner.evidence_links {
   00070|         let _ = writeln!(expected, "evidence: {link}");
   00071|     }
   00072|     let _ = writeln!(expected, "trace: {}", inner.intent);
   00073|     assert_eq!(marked.intent, inner.intent);
   00074|     assert_eq!(marked.answer, expected);
   00075|     assert!(
   00076|         marked
   00077|             .evidence_links
   00078|             .iter()
   00079|             .any(|link| link == "diagnostic_mode:active")
   00080|     );
   00081| }
   00082| 
   00083| #[test]
   00084| fn an_upper_case_marker_is_not_the_seeded_marker() {
   00085|     // Recognition and stripping read the same exact seeded marker, so an
