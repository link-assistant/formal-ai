   00098| #[test]
   00099| fn a_pronoun_answers_the_seeded_body_of_the_nearest_antecedent() {
   00100|     let history = [
   00101|         ConversationTurn::user("I love Rust."),
   00102|         ConversationTurn::assistant("Rust is a systems programming language."),
   00103|         ConversationTurn::user("The weather is pleasant."),
   00104|         ConversationTurn::assistant("It is."),
   00105|     ];
   00106|     let response =
   00107|         UniversalSolver::default().solve_with_history("Why is it safer than C?", &history);
   00108|     assert_eq!(response.intent, "coreference_rust");
   00109|     assert_eq!(response.answer, RUST_BODY);
   00110|     // The native log keeps the resolution event by id; the browser spells its payload.
   00111|     for link in [
   00112|         "coreference:resolved:",
   00113|         "wikidata:Q575650",
   00114|         "response:coreference",
   00115|     ] {
   00116|         assert!(
   00117|             response
   00118|                 .evidence_links
   00119|                 .iter()
   00120|                 .any(|candidate| candidate.starts_with(link)),
   00121|             "{link} in {:?}",
   00122|             response.evidence_links
   00123|         );
   00124|     }
   00125| }
