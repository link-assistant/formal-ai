   00191| fn requested_rewrite(task: &str, artifact: &WorkspaceArtifact) -> Option<WorkspaceRewrite> {
   00192|     if let Some(program) = explicit_substitution_query(task) {
   00193|         return Some(WorkspaceRewrite {
   00194|             target: artifact.path.clone(),
   00195|             program,
   00196|         });
   00197|     }
   00198|     if task.contains('?') || task.contains('？') {
   00199|         return None;
   00200|     }
   00201|     let quoted = quoted_segments(task);
   00202|     let pairs = match quoted.as_slice() {
   00203|         [new] => vec![(last_string_literal(&artifact.content)?, new.clone())],
   00204|         values if !values.is_empty() && values.len() % 2 == 0 => values
   00205|             .as_chunks::<2>()
   00206|             .0
   00207|             .iter()
   00208|             .map(|[old, new]| (old.clone(), new.clone()))
   00209|             .collect(),
   00210|         _ => return None,
   00211|     };
   00212|     if pairs.iter().any(|(old, new)| old == new) {
   00213|         return None;
   00214|     }
   00215|     let single_substitution = pairs.len() == 1;
   00216|     let rules = pairs
   00217|         .into_iter()
   00218|         .map(|(old, new)| {
   00219|             let rule = RewriteRule::new(old.clone(), new);
   00220|             if single_substitution || old.is_empty() {
   00221|                 rule.terminal()
   00222|             } else {
   00223|                 rule
   00224|             }
   00225|         })
   00226|         .collect();
   00227|     Some(WorkspaceRewrite {
   00228|         target: artifact.path.clone(),
   00229|         program: RewriteProgram::new(rules, MAX_REWRITE_STEPS),
   00230|     })
   00231| }
