   00080|                     continue;
   00081|                 }
   00082|                 let _ = writeln!(
   00083|                     links,
   00084|                     "    applied rule={} byte_offset={}",
   00085|                     step.rule_index, step.byte_offset
   00086|                 );
   00087|             }
   00088|         }
