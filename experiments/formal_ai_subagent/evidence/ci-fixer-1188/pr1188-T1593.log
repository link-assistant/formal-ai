   00044|         // request was lowered to. Everything below it is that query expanded.
   00045|         link_field(
   00046|             &mut links,
   00047|             2,
   00048|             "substitution_query",
   00049|             &render_substitution_query(&self.program),
   00050|         );
   00051|         link_field(
   00052|             &mut links,
   00053|             2,
   00054|             "max_steps",
   00055|             &self.program.max_steps.to_string(),
   00056|         );
