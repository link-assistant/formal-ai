   00268|     messages
   00269|         .iter()
   00270|         .enumerate()
   00271|         .rev()
   00272|         .find_map(|(index, message)| {
   00273|             if !message.role.eq_ignore_ascii_case("tool") {
   00274|                 return None;
   00275|             }
   00276|             let call_id = message.tool_call_id.as_ref()?;
   00277|             let call = messages[..index]
   00278|                 .iter()
