   00102|     let latest_user = messages
   00103|         .iter()
   00104|         .rposition(|message| message.role.eq_ignore_ascii_case("user"))?;
   00105| 
   00106|     if let Some(artifact) = latest_workspace_artifact(&messages[..latest_user]) {
   00107|         let rewrite = requested_rewrite(task, &artifact)?;
   00108|         let current_messages = &messages[latest_user + 1..];
   00109|         if let Some(result) = latest_result(current_messages, Capability::Write) {
   00110|             let outcome = latest_result(current_messages, Capability::Read)
   00111|                 .map(|read| rewrite.program.execute(&source_from_read_result(&read)));
   00112|             return Some(AgenticPlan::Final(format!(
   00113|                 "Updated `{}` through the workspace file tools.\n\n{}\n{}",
   00114|                 artifact.path,
   00115|                 rewrite.links_notation(outcome.as_ref()),
   00116|                 result.trim()
   00117|             )));
   00118|         }
   00119|         if let Some(read_source) = latest_result(current_messages, Capability::Read) {
   00120|             let current_source = source_from_read_result(&read_source);
   00121|             let outcome = rewrite.program.execute(&current_source);
   00122|             if outcome.halt == RewriteHalt::StepLimit {
   00123|                 return Some(AgenticPlan::Final(format!(
   00124|                     "Rewrite of `{}` reached its {MAX_REWRITE_STEPS}-step safety bound; no partial bytes were written.\n\n{}",
   00125|                     artifact.path,
   00126|                     rewrite.links_notation(Some(&outcome))
   00127|                 )));
   00128|             }
