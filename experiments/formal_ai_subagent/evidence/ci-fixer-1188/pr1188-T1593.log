   00233| /// Accept the meta-language query itself as the request.
   00234| ///
   00235| /// Prose with quoted operands only ever composes old/new pairs, so this is the
   00236| /// only route to link-cli's `()` creation and deletion shorthands and to
   00237| /// terminal rules. The whole turn must be the query: requiring that keeps the
   00238| /// route unambiguous against ordinary prose that merely contains parentheses.
   00239| fn explicit_substitution_query(task: &str) -> Option<RewriteProgram> {
   00240|     let trimmed = task.trim();
   00241|     if !trimmed.starts_with('(') {
   00242|         return None;
   00243|     }
   00244|     let program = parse_substitution_query(trimmed, MAX_REWRITE_STEPS).ok()?;
   00245|     (!program.rules.is_empty()).then_some(program)
   00246| }
