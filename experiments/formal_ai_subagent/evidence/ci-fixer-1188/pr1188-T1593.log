   00065|             let _ = writeln!(links, "  execution");
   00066|             link_field(&mut links, 4, "halt", &format!("{:?}", outcome.halt));
   00067|             link_field(&mut links, 4, "steps", &outcome.trace.len().to_string());
   00068|             let omitted = outcome
   00069|                 .trace
   00070|                 .len()
   00071|                 .saturating_sub(RENDERED_TRACE_EDGE_STEPS * 2);
   00072|             for (index, step) in outcome.trace.iter().enumerate() {
   00073|                 if omitted > 0 && index == RENDERED_TRACE_EDGE_STEPS {
   00074|                     link_field(&mut links, 4, "omitted_steps", &omitted.to_string());
   00075|                 }
