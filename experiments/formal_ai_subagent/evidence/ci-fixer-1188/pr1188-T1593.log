   00248| fn latest_workspace_artifact(messages: &[ChatMessage]) -> Option<WorkspaceArtifact> {
   00249|     messages
   00250|         .iter()
   00251|         .rev()
   00252|         .flat_map(|message| message.tool_calls.iter().rev())
   00253|         .find_map(|call| {
   00254|             if tool_capability(&call.function.name) != Some(Capability::Write) {
   00255|                 return None;
   00256|             }
   00257|             let arguments: Value = serde_json::from_str(&call.function.arguments).ok()?;
   00258|             let path = argument_string(&arguments, &["path", "filePath", "file_path"])?;
   00259|             let content = argument_string(&arguments, &["content"])?;
   00260|             Some(WorkspaceArtifact {
   00261|                 path: path.to_owned(),
   00262|                 content: content.to_owned(),
   00263|             })
   00264|         })
   00265| }
