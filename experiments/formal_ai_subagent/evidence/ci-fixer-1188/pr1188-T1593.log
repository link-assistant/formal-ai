   00058|             let _ = writeln!(links, "  rewrite_rule \"{index}\"");
   00059|             link_field(&mut links, 4, "effect", substitution_effect(rule).as_str());
   00060|             link_field(&mut links, 4, "pattern", &rule.pattern);
   00061|             link_field(&mut links, 4, "replacement", &rule.replacement);
   00062|             link_field(&mut links, 4, "terminal", &rule.terminal.to_string());
   00063|         }
