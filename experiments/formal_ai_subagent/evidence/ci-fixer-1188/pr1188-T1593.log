   00286| /// Decode decorated source emitted by coding-agent read tools. `OpenCode` wraps
   00287| /// numbered lines in `<content>` while Agent wraps pipe-numbered lines in
   00288| /// `<file>`. Other CLIs return raw contents, which pass through byte-for-byte.
   00289| pub(super) fn source_from_read_result(result: &str) -> String {
   00290|     if let Some(decoded) = source_from_agent_read_result(result) {
   00291|         return decoded;
   00292|     }
   00293|     let Some((_, after_open)) = result.split_once("<content>\n") else {
   00294|         return result.to_owned();
   00295|     };
   00296|     let Some((content, _)) = after_open.rsplit_once("\n</content>") else {
   00297|         return result.to_owned();
   00298|     };
   00299|     let mut decoded = String::new();
   00300|     for line in content.lines() {
   00301|         if line.starts_with("(End of file - total ") {
   00302|             break;
   00303|         }
   00304|         let source_line = line
   00305|             .split_once(": ")
   00306|             .filter(|(number, _)| number.chars().all(|character| character.is_ascii_digit()))
   00307|             .map_or(line, |(_, source)| source);
   00308|         decoded.push_str(source_line);
   00309|         decoded.push('\n');
   00310|     }
   00311|     while decoded.ends_with("\n\n") {
   00312|         decoded.pop();
   00313|     }
   00314|     decoded
   00315| }
   00316| 
   00317| pub(super) fn source_from_agent_read_result(result: &str) -> Option<String> {
   00318|     let after_open = result.strip_prefix("<file>\n")?;
   00319|     let (numbered, footer) = after_open.rsplit_once("\n\n(End of file - total ")?;
   00320|     if !footer.ends_with("</file>") {
   00321|         return None;
   00322|     }
   00323|     numbered
   00324|         .lines()
   00325|         .map(|line| {
   00326|             let (number, source) = line.split_once("| ")?;
   00327|             number
   00328|                 .chars()
   00329|                 .all(|character| character.is_ascii_digit())
   00330|                 .then_some(source)
   00331|         })
   00332|         .collect::<Option<Vec<_>>>()
   00333|         .map(|lines| lines.join("\n"))
   00334| }
