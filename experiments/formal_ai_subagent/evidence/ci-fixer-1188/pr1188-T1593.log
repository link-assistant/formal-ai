   00136|                 write_tool,
   00137|                 write_arguments(&artifact.path, &outcome.output),
   00138|             ));
   00139|         }
   00140|         let read_tool = tool_for(tool_names, Capability::Read)?;
   00141|         return Some(plan_one(read_tool, read_arguments(&artifact.path)));
