   00178| fn generated_artifact(task: &str) -> Option<WorkspaceArtifact> {
   00179|     let normalized = task.to_lowercase();
   00180|     let language = program_language_by_alias(&normalized)?;
   00181|     let program_task = program_task_by_alias(&normalized)?;
   00182|     // Issue #1165 R1165-6: the file a documented program binds
   00183|     // (`HelloWorldApp.java`) is the one it is written to.
   00184|     let spec = program_spec(program_task.slug, language.slug)?;
   00185|     Some(WorkspaceArtifact {
   00186|         path: spec.language.save_as.to_string(),
   00187|         content: format!("{}\n", spec.template.code.trim_end()),
   00188|     })
   00189| }
