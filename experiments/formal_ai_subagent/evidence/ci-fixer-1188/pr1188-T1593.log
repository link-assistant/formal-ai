   00348| /// Write one `name value` link, quoted the way Links Notation quotes.
   00349| ///
   00350| /// The trace is published as the meta-language representation of the request,
   00351| /// so it has to be readable by a Links Notation reader, not merely look like
   00352| /// one. Notation escapes a quote by *doubling* it and picks a delimiter the
   00353| /// value does not already contain; a backslash escape leaves the quote visible
   00354| /// to the reader, which ends the string early and turns a code fragment's `(`
   00355| /// into an unclosed group. Delegating to the codec's own escaper is what keeps
   00356| /// the two definitions from drifting apart again.
   00357| fn link_field(out: &mut String, indent: usize, name: &str, value: &str) {
   00358|     let _ = writeln!(
   00359|         out,
   00360|         "{}{name} {}",
   00361|         " ".repeat(indent),
   00362|         escape_reference(value)
   00363|     );
   00364| }
