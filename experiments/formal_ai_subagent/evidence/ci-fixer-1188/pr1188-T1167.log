   00764| fn compact_registration_edit(source: &str, registration: &str) -> Option<(String, String)> {
   00765|     const MAX_SUFFIX_BYTES: usize = 4096;
   00766|     let mut starts = source
   00767|         .match_indices('\n')
   00768|         .map(|(index, _)| index + 1)
   00769|         .filter(|start| *start < source.len())
   00770|         .collect::<Vec<_>>();
   00771|     starts.insert(0, 0);
   00772|     for start in starts.into_iter().rev() {
   00773|         let suffix = &source[start..];
   00774|         if suffix.len() > MAX_SUFFIX_BYTES {
   00775|             break;
   00776|         }
   00777|         if source.match_indices(suffix).count() != 1 {
   00778|             continue;
   00779|         }
   00780|         let mut replacement = suffix.to_owned();
   00781|         if !replacement.ends_with('\n') {
   00782|             replacement.push('\n');
   00783|         }
   00784|         replacement.push_str(registration);
   00785|         return Some((suffix.to_owned(), replacement));
   00786|     }
   00787|     None
   00788| }
