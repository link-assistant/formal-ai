   00905|         argument_matches_path(&value, path)
   00906|             && argument_matches(&value, &["oldString", "old_string", "old_str", "old"], old)
   00907|             && argument_matches(&value, &["newString", "new_string", "new_str", "new"], new)
   00908|     })
   00909| }
   00910| 
   00911| fn argument_matches_path(value: &Value, expected: &str) -> bool {
   00912|     ["path", "filePath", "file_path"].iter().any(|key| {
   00913|         value
   00914|             .get(key)
   00915|             .and_then(Value::as_str)
   00916|             .is_some_and(|observed| workspace_path_matches(expected, observed))
   00917|     })
   00918| }
   00919| 
   00920| fn argument_matches(value: &Value, keys: &[&str], expected: &str) -> bool {
   00921|     keys.iter()
   00922|         .any(|key| value.get(key).and_then(Value::as_str) == Some(expected))
   00923| }
   00924| 
   00925| fn workspace_path_matches(expected: &str, observed: &str) -> bool {
   00926|     if observed == expected {
   00927|         return true;
   00928|     }
   00929|     let expected = Path::new(expected);
   00930|     let observed = Path::new(observed);
   00931|     expected.is_relative() && observed.is_absolute() && observed.ends_with(expected)
   00932| }
