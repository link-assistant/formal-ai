   00941| pub(super) fn plan_digest_verification(
   00942|     task: &str,
   00943|     current_turn: &[ChatMessage],
   00944|     tool_names: &[&str],
   00945|     change: &VerifiedChange<'_>,
   00946| ) -> Option<AgenticPlan> {
   00947|     let command = ["sha256sum -- ", change.target].concat();
   00948|     let Some(observed) = result_for_command(current_turn, &command) else {
   00949|         let tool = tool_for(tool_names, Capability::Run)?;
   00950|         return Some(plan_one(tool, json!({"command": command}).to_string()));
   00951|     };
   00952|     let digest = crate::source_fetch::sha256_hex(change.expected.as_bytes());
   00953|     if observed.split_whitespace().next() != Some(digest.as_str()) {
   00954|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00955|             "coding_workspace_verification_failed",
   00956|             task,
   00957|             change.target,
   00958|         )?));
   00959|     }
   00960|     Some(AgenticPlan::Final(render_seeded_change(
   00961|         change.intent,
   00962|         task,
   00963|         change.target,
   00964|         change.slots,
   00965|     )?))
   00966| }
