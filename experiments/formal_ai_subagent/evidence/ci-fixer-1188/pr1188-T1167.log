   00726| fn composite_module_change(task: &str) -> Option<CompositeModuleChange> {
   00727|     let lowered = task.to_lowercase();
   00728|     if !seed::lexicon().mentions_role(seed::ROLE_CODING_MODULE_REGISTRATION_ACTION, &lowered) {
   00729|         return None;
   00730|     }
   00731|     let generated = rust_source_for_task(task)?;
   00732|     let registration_path = rust_paths(task)
   00733|         .into_iter()
   00734|         .find(|path| path != &generated.path)?;
   00735|     let module = generated.path.rsplit('/').next()?.strip_suffix(".rs")?;
   00736|     if !valid_identifier(module) {
   00737|         return None;
   00738|     }
   00739|     let registration =
   00740|         render_rust_template("coding_source_module_registration", &[("{module}", module)])?;
   00741|     Some(CompositeModuleChange {
   00742|         source_path: generated.path,
   00743|         source: generated.content,
   00744|         registration_path,
   00745|         registration,
   00746|     })
   00747| }
