   00486| /// The file after `rewrite`, or `None` when it cannot apply. A positional
   00487| /// insertion replaces its one anchor occurrence; an anchor found zero or
   00488| /// several times does not say where the line goes.
   00489| /// The rewrite as the request wrote it, when the file holds no unescaped
   00490| /// pattern but holds the pattern as written (source code quoting `'\n'`,
   00491| /// PR #1188 G65).
   00492| fn as_written(source: &str, rewrite: &GroundedRewrite) -> Option<GroundedRewrite> {
   00493|     let (pattern, replacement) = rewrite.verbatim.clone()?;
   00494|     if (rewrite.pattern != pattern && source.contains(&rewrite.pattern))
   00495|         || !source.contains(&pattern)
   00496|     {
   00497|         return None;
   00498|     }
   00499|     Some(GroundedRewrite {
   00500|         pattern,
   00501|         replacement,
   00502|         verbatim: None,
   00503|         ..rewrite.clone()
   00504|     })
   00505| }
   00506| 
   00507| fn rewritten_source(source: &str, rewrite: &GroundedRewrite) -> Option<String> {
   00508|     if rewrite.single_pass {
   00509|         return source
   00510|             .contains(rewrite.pattern.as_str())
   00511|             .then(|| source.replace(rewrite.pattern.as_str(), &rewrite.replacement));
   00512|     }
   00513|     if rewrite.unique {
   00514|         let (start, old, new) = anchored_lines(source, rewrite)?;
   00515|         return Some([&source[..start], new.as_str(), &source[start + old.len()..]].concat());
   00516|     }
   00517|     execute_scoped_workspace_rewrite(
   00518|         source,
   00519|         &rewrite.pattern,
   00520|         &rewrite.replacement,
   00521|         rewrite.scope,
   00522|     )
   00523|     .ok()
   00524|     .map(|execution| execution.output)
   00525| }
   00526| 
   00527| /// A positional insertion's one anchor occurrence widened to the whole lines
   00528| /// it sits on, as `(start, old_lines, new_lines)`, or `None` unless the anchor
   00529| /// occurs exactly once. The inserted text is a line, so an anchor that is only
   00530| /// part of a line (`after the line containing '| T20 |'`) must not split it.
   00531| fn anchored_lines(source: &str, rewrite: &GroundedRewrite) -> Option<(usize, String, String)> {
   00532|     let (pattern, replacement) = (rewrite.pattern.as_str(), rewrite.replacement.as_str());
   00533|     let mut found = source.match_indices(pattern).map(|(at, _)| at);
   00534|     let (Some(at), None) = (found.next(), found.next()) else {
   00535|         return None;
   00536|     };
   00537|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00538|     let tail = at + pattern.len();
   00539|     let end = if pattern.ends_with('\n') {
   00540|         tail - 1
   00541|     } else {
   00542|         source[tail..]
   00543|             .find('\n')
   00544|             .map_or(source.len(), |newline| tail + newline)
   00545|     };
   00546|     let old = &source[start..end];
   00547|     let new = replacement.strip_prefix(pattern).map_or_else(
   00548|         || [&replacement[..replacement.len() - pattern.len()], old].concat(),
   00549|         |rest| [old, rest].concat(),
   00550|     );
   00551|     Some((start, old.to_owned(), new))
   00552| }
   00553| 
   00554| /// The smallest run of whole lines holding every change from `source` to
   00555| /// `updated`, as an edit pair, when that run occurs once in `source`.
   00556| pub(super) fn changed_lines_edit(source: &str, updated: &str) -> Option<(String, String)> {
   00557|     const MAX_EDIT_BYTES: usize = 4096;
   00558|     let prefix = source
   00559|         .bytes()
   00560|         .zip(updated.bytes())
   00561|         .take_while(|(left, right)| left == right)
   00562|         .count();
   00563|     let limit = source.len().min(updated.len()) - prefix;
   00564|     let suffix = source
   00565|         .bytes()
   00566|         .rev()
   00567|         .zip(updated.bytes().rev())
   00568|         .take(limit)
   00569|         .take_while(|(left, right)| left == right)
   00570|         .count();
   00571|     // Byte positions only meet `\n`, so `start` and `end` fall on line -- and
   00572|     // therefore character -- boundaries even when the first or last differing
   00573|     // byte sits inside a multi-byte character.
   00574|     let bytes = source.as_bytes();
   00575|     let line_start = |before: usize| {
   00576|         bytes[..before]
   00577|             .iter()
   00578|             .rposition(|byte| *byte == b'\n')
   00579|             .map_or(0, |at| at + 1)
   00580|     };
   00581|     let mut start = line_start(prefix);
   00582|     let end = bytes[source.len() - suffix..]
   00583|         .iter()
   00584|         .position(|byte| *byte == b'\n')
   00585|         .map_or(source.len(), |at| source.len() - suffix + at);
   00586|     // Lines inserted between two lines change none: the line above carries
   00587|     // them.
   00588|     if start == end && start > 0 {
   00589|         start = line_start(start - 1);
   00590|     }
   00591|     let old = &source[start..end];
   00592|     let new = &updated[start..updated.len() - (source.len() - end)];
   00593|     (!old.is_empty() && old.len() <= MAX_EDIT_BYTES && source.matches(old).count() == 1)
   00594|         .then(|| (old.to_owned(), new.to_owned()))
   00595| }
   00596| 
   00597| /// `Insert 'x' after the line 'y' in f`: the anchor line, replaced once by the
   00598| /// anchor beside the new line, stated by the position meaning that placed it.
   00599| fn grounded_positional_insert(task: &str) -> Option<GroundedRewrite> {
   00600|     let (target, anchor, replacement) = super::positional_edit::compose_positional_insert(task)?;
   00601|     let after_anchor = [anchor.as_str(), "\n"].concat();
   00602|     let (after, inserted) = if let Some(inserted) = replacement.strip_prefix(&after_anchor) {
   00603|         (true, inserted.to_owned())
   00604|     } else {
   00605|         let before_anchor = ["\n", anchor.as_str()].concat();
   00606|         (false, replacement.strip_suffix(&before_anchor)?.to_owned())
   00607|     };
   00608|     let intent = super::positional_edit::insert_intent(after, &inserted);
   00609|     Some(GroundedRewrite {
   00610|         target,
   00611|         stated: Some((
   00612|             intent,
   00613|             vec![(NEW_SLOT, inserted), (ANCHOR_SLOT, anchor.clone())],
   00614|         )),
   00615|         pattern: anchor,
   00616|         replacement,
   00617|         scope: RewriteScope::Substring,
   00618|         renaming: false,
   00619|         unique: true,
   00620|         single_pass: false,
   00621|         verbatim: None,
   00622|     })
   00623| }
   00624| 
   00625| /// Every insert the request asks for, each its own anchored edit.
   00626| ///
   00627| /// Several clauses (`…, and insert …`), an anchor named by the line it
   00628| /// follows (T31, T34), lines rebased on the anchor (G16), or one insert whose
   00629| /// anchor is a whole line also found inside others (`the line 'b'`).
   00630| fn insert_sequence(task: &str) -> Option<Vec<PositionalInsert>> {
   00631|     super::positional_edit::positional_inserts(task)
   00632| }
   00633| 
   00634| fn grounded_rewrite(task: &str) -> Option<GroundedRewrite> {
   00635|     if let Some(positional) = grounded_positional_insert(task) {
   00636|         return Some(positional);
   00637|     }
   00638|     let (target, old_clause, new_clause) = compose_edit_request(task)?;
   00639|     let renaming = seed::lexicon().mentions_role(
   00640|         seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00641|         &task.to_lowercase(),
   00642|     );
   00643|     // A request that names a line replaces whole lines
   00644|     // (`grounded_line_replacement`).
   00645|     if !renaming && super::workspace_computed_change::names_line(task) {
   00646|         return None;
   00647|     }
   00648|     // Both operands have to be literals the request actually quoted, so prose
   00649|     // ("replace the old header with something clearer") is never rewritten as
   00650|     // bytes. What that cannot be is a count: requiring the request to hold
   00651|     // *exactly* two quoted segments made every other pair of delimiters in the
   00652|     // prompt disqualify the edit, and this repository's own prose backticks the
   00653|     // file it names. The issue #1028 ladder node "In the file
   00654|     // `src/protocol_memory.rs`, replace \"request_history\" with
   00655|     // \"conversation_history\"" quotes three things and states one replacement.
   00656|     // Asking whether each clause *is* quoted keeps the guarantee and drops the
   00657|     // arithmetic.
   00658|     // The edit request unescapes `\n` / `\t` in its literals, so the quoted
   00659|     // segments are compared unescaped too: a multi-line replacement written
   00660|     // with `\n` was otherwise not "quoted", and the general fallback wrote its
   00661|     // new text over the whole file (PR #1188 sub-agent gap 3).
   00662|     let quoted: Vec<String> = quoted_segments(task)
   00663|         .iter()
   00664|         .map(String::as_str)
   00665|         .map(super::positional_edit::unescape_prose_newlines)
   00666|         .collect();
   00667|     // A literal quoted whole counts even when backtick spans inside it pair
   00668|     // among themselves (PR #1188 G63).
   00669|     let is_quoted =
   00670|         |value: &String| quoted.contains(value) || crate::normal_markov::quotes_whole(task, value);
   00671|     let operands = if is_quoted(&old_clause) && is_quoted(&new_clause) {
   00672|         Some((old_clause, new_clause))
   00673|     } else if renaming {
   00674|         Some((
   00675|             identifier_tokens(&old_clause).next_back()?.to_owned(),
   00676|             identifier_tokens(&new_clause).next()?.to_owned(),
   00677|         ))
   00678|     } else {
   00679|         None
   00680|     }?;
   00681|     let (old, new) = operands;
   00682|     let as_quoted = |text: &str| {
   00683|         quoted_segments(task)
   00684|             .into_iter()
   00685|             .find(|raw| raw != text && super::positional_edit::unescape_prose_newlines(raw) == text)
   00686|             .unwrap_or_else(|| text.to_owned())
   00687|     };
   00688|     let verbatim = (as_quoted(&old) != old || as_quoted(&new) != new)
   00689|         .then(|| (as_quoted(&old), as_quoted(&new)));
   00690|     // A rename names a *word*, so the edit is word-scoped whichever way the
   00691|     // request spelled its operands. Without that scope the most ordinary rename
   00692|     // there is -- giving a name a prefix or a suffix -- has to be refused, since
   00693|     // an unanchored substring rewrite that reintroduces its own pattern never
   00694|     // terminates.
   00695|     //
   00696|     // A word replaced by a longer word that contains it (`smal` → `small`, a
   00697|     // typo fix) is only safe word by word for the same reason.
   00698|     let words = is_identifier_word(&old) && is_identifier_word(&new);
   00699|     let scope = if words && (renaming || new.contains(&old)) {
   00700|         RewriteScope::Word
   00701|     } else {
   00702|         RewriteScope::Substring
   00703|     };
   00704|     if old.is_empty() || old == new {
   00705|         return None;
   00706|     }
   00707|     // A new text holding the old one (`key 3` → `key 33`) is replaced in one
   00708|     // pass over the file, never rewritten again inside its own result (PR
   00709|     // #1188 G78).
   00710|     let single_pass = scope == RewriteScope::Substring && new.contains(&old);
   00711|     Some(GroundedRewrite {
   00712|         target,
   00713|         pattern: old,
   00714|         replacement: new,
   00715|         scope,
   00716|         renaming: renaming && scope == RewriteScope::Word,
   00717|         unique: false,
   00718|         single_pass,
   00719|         stated: None,
   00720|         verbatim,
   00721|     })
   00722| }
