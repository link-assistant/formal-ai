   00243| fn plan_rewrite_step(
   00244|     task: &str,
   00245|     current_turn: &[ChatMessage],
   00246|     tool_names: &[&str],
   00247|     rewrite: &GroundedRewrite,
   00248| ) -> Option<AgenticPlan> {
