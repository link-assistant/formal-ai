   00892| pub(super) fn result_for_edit(
   00893|     messages: &[ChatMessage],
   00894|     path: &str,
   00895|     old: &str,
   00896|     new: &str,
   00897| ) -> Option<String> {
   00898|     matching_result(messages, |name, arguments| {
   00899|         if tool_capability(name) != Some(Capability::Edit) {
   00900|             return false;
   00901|         }
   00902|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
   00903|             return false;
