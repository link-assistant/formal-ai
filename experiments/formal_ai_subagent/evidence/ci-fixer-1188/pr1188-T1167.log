   00968| fn matching_result(
   00969|     messages: &[ChatMessage],
   00970|     matches: impl Fn(&str, &str) -> bool,
   00971| ) -> Option<String> {
   00972|     messages
   00973|         .iter()
   00974|         .enumerate()
   00975|         .rev()
   00976|         .find_map(|(index, message)| {
   00977|             if !message.role.eq_ignore_ascii_case("tool") {
   00978|                 return None;
   00979|             }
   00980|             let id = message.tool_call_id.as_deref()?;
   00981|             let call = messages[..index]
   00982|                 .iter()
   00983|                 .rev()
   00984|                 .flat_map(|prior| prior.tool_calls.iter().rev())
   00985|                 .find(|call| call.id == id)?;
   00986|             matches(&call.function.name, &call.function.arguments)
   00987|                 .then(|| message.content.plain_text())
   00988|         })
   00989| }
