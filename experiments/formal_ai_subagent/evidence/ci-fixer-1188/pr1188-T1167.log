   00842| fn rust_paths(task: &str) -> Vec<String> {
   00843|     let mut paths = Vec::new();
   00844|     for (suffix, _) in task.match_indices(".rs") {
   00845|         let end = suffix + 3;
   00846|         let start = task[..end]
   00847|             .char_indices()
   00848|             .rev()
   00849|             .take_while(|(_, character)| {
   00850|                 character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00851|             })
   00852|             .last()
   00853|             .map_or(0, |(index, _)| index);
   00854|         let path = &task[start..end];
   00855|         if !path.is_empty()
   00856|             && !path.starts_with('/')
   00857|             && !path.split('/').any(|component| component == "..")
   00858|             && !paths.iter().any(|existing| existing == path)
   00859|         {
   00860|             paths.push(path.to_owned());
   00861|         }
   00862|     }
   00863|     paths
   00864| }
