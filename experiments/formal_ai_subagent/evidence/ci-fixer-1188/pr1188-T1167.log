   00193|         && super::workspace_computed_change::grounded_end_insertion(&probe).is_none()
   00194|     {
   00195|         return None;
   00196|     }
   00197|     let Some(read) = result_for_path(current_turn, Capability::Read, &source.path, None) else {
   00198|         return Some(Sourced::Read(source.path));
   00199|     };
   00200|     if super::code_artifact::source_from_agent_read_result(&read).is_none()
   00201|         && super::tool_result::failure_message(&read, false, true).is_some()
   00202|     {
   00203|         return None;
   00204|     }
   00205|     let contents = source_from_read_result(&read);
   00206|     Some(Sourced::Task(with_contents(task, &source, &contents)))
