   00749| fn insert_registration(source: &str, registration: &str) -> String {
   00750|     if source
   00751|         .lines()
   00752|         .any(|line| line.trim() == registration.trim())
   00753|     {
   00754|         return source.to_owned();
   00755|     }
   00756|     let mut updated = source.to_owned();
   00757|     if !updated.is_empty() && !updated.ends_with('\n') {
   00758|         updated.push('\n');
   00759|     }
   00760|     updated.push_str(registration);
   00761|     updated
   00762| }
