   00790| fn repeated_identifier_rewrite_command(rewrite: &GroundedRewrite) -> Option<String> {
   00791|     if !shell_safe_identifier(&rewrite.pattern) || !shell_safe_identifier(&rewrite.replacement) {
   00792|         return None;
   00793|     }
   00794|     // The in-memory execution and the command the client runs have to agree on
   00795|     // what a match is, so a word-scoped rewrite asks for whole words too.
   00796|     let pattern = match rewrite.scope {
   00797|         RewriteScope::Substring => rewrite.pattern.clone(),
   00798|         RewriteScope::Word => format!("\\b{}\\b", rewrite.pattern),
   00799|     };
   00800|     // `perl -pi -e`, not `sed -i` (issue #1110). GNU and BSD sed disagree about
   00801|     // both halves of that command: BSD `-i` reads the script as its backup
   00802|     // suffix, and BSD sed has no `\b`. On macOS every rename therefore failed
   00803|     // with `bad flag in substitute command`, the file was left unchanged, and
   00804|     // Formal AI reported the mismatch as its own verification failure -- a
   00805|     // confident failure report instead of a rename. perl's `-pi -e` and `\b`
   00806|     // mean the same thing on both, and perl ships with macOS and the runners.
   00807|     // Both identifiers are `[A-Za-z0-9_]` by `shell_safe_identifier`, so
   00808|     // neither side can carry a regex or shell metacharacter.
   00809|     // Assembled from named parts rather than one template string: the prose
   00810|     // detector reads `perl -pi -e ...` as a multi-word phrase (two alphabetic
   00811|     // runs, one of three letters) and would have it live in `data/seed`, which
   00812|     // is the wrong home for a shell invocation. Naming the pieces says what
   00813|     // each is, and none of them reads as a sentence.
   00814|     let script = format!("'s/{pattern}/{}/g'", rewrite.replacement);
   00815|     Some(["perl", "-pi", "-e", &script, "--", &rewrite.target].join(" "))
   00816| }
   00817| 
   00818| fn shell_safe_identifier(identifier: &str) -> bool {
   00819|     !identifier.is_empty()
   00820|         && identifier
   00821|             .chars()
   00822|             .all(|character| character.is_ascii_alphanumeric() || character == '_')
   00823| }
   00824| 
   00825| pub(super) fn identifier_tokens(text: &str) -> impl DoubleEndedIterator<Item = &str> {
   00826|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00827|         .filter(|token| valid_identifier(token))
   00828| }
   00829| 
   00830| fn valid_identifier(identifier: &str) -> bool {
   00831|     let mut characters = identifier.chars();
   00832|     characters
   00833|         .next()
   00834|         .is_some_and(|first| first.is_ascii_alphabetic() || first == '_')
   00835|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00836|         && !seed::lexicon()
   00837|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00838|             .iter()
   00839|             .any(|reserved| reserved == identifier)
   00840| }
