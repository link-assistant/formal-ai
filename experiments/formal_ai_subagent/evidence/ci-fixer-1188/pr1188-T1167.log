   00289|             anchored_lines(&source, rewrite).map(|(_, old, new)| (old, new))
   00290|         } else if source.matches(rewrite.pattern.as_str()).count() == 1 {
   00291|             Some((rewrite.pattern.clone(), rewrite.replacement.clone()))
   00292|         } else {
   00293|             changed_lines_edit(&source, &updated)
   00294|         };
   00295|         if let Some(tool) = tool_for(tool_names, Capability::Edit)
   00296|             && let Some((old, new)) = edit
   00297|         {
   00298|             if result_for_edit(current_turn, &rewrite.target, &old, &new).is_none() {
   00299|                 return Some(plan_one(tool, edit_arguments(&rewrite.target, &old, &new)));
   00300|             }
   00301|             return plan_digest_verification(
   00302|                 task,
   00303|                 current_turn,
   00304|                 tool_names,
   00305|                 &VerifiedChange {
   00306|                     target: &rewrite.target,
   00307|                     expected: &updated,
   00308|                     intent: rewrite.stated_intent(),
   00309|                     slots: &rewrite.stated_slots(),
   00310|                     list_slots: &[],
   00311|                 },
   00312|             );
   00313|         }
   00314|     } else if tool_for(tool_names, Capability::Edit).is_some()
   00315|         && let Some(command) = repeated_identifier_rewrite_command(rewrite)
   00316|         && let Some(tool) = tool_for(tool_names, Capability::Run)
   00317|     {
   00318|         if result_for_command(current_turn, &command).is_none() {
   00319|             return Some(plan_one(tool, json!({"command": command}).to_string()));
   00320|         }
   00321|         return plan_digest_verification(
   00322|             task,
   00323|             current_turn,
   00324|             tool_names,
   00325|             &VerifiedChange {
   00326|                 target: &rewrite.target,
   00327|                 expected: &updated,
   00328|                 intent: rewrite.stated_intent(),
   00329|                 slots: &rewrite.stated_slots(),
   00330|                 list_slots: &[],
   00331|             },
   00332|         );
   00333|     }
