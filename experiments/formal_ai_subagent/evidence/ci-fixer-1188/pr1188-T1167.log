   00866| pub(super) fn result_for_path(
   00867|     messages: &[ChatMessage],
   00868|     capability: Capability,
   00869|     path: &str,
   00870|     expected_content: Option<&str>,
   00871| ) -> Option<String> {
   00872|     matching_result(messages, |name, arguments| {
   00873|         if tool_capability(name) != Some(capability) {
   00874|             return false;
   00875|         }
   00876|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
   00877|             return false;
   00878|         };
   00879|         let matches_path = ["path", "filePath", "file_path"].iter().any(|key| {
   00880|             value
   00881|                 .get(key)
   00882|                 .and_then(Value::as_str)
   00883|                 .is_some_and(|observed| workspace_path_matches(path, observed))
   00884|         });
   00885|         matches_path
   00886|             && expected_content.is_none_or(|expected| {
   00887|                 value.get("content").and_then(Value::as_str) == Some(expected)
   00888|             })
   00889|     })
   00890| }
