   00335|     if result_for_path(
   00336|         current_turn,
   00337|         Capability::Write,
   00338|         &rewrite.target,
   00339|         Some(&updated),
   00340|     )
   00341|     .is_none()
   00342|     {
   00343|         let tool = tool_for(tool_names, Capability::Write)?;
   00344|         return Some(plan_one(tool, write_arguments(&rewrite.target, &updated)));
   00345|     }
