   00295| fn extract_how_it_works_query(prompt: &str, _normalized: &str) -> Option<HowItWorksQuery> {
   00296|     let original = clean_mechanism_fragment(prompt);
   00297|     if original.is_empty() {
   00298|         return None;
   00299|     }
   00300|     let lower = original.to_lowercase();
   00301|     if is_bare_how_it_works(&lower) {
   00302|         return Some(HowItWorksQuery { subject: None });
   00303|     }
   00304|     extract_how_it_works_subject(&original, &lower).map(|subject| HowItWorksQuery {
   00305|         subject: Some(subject),
   00306|     })
   00307| }
