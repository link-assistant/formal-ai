   00518| /// Detect a procedural "how to X" request and split it into task/action/object.
   00519| ///
   00520| /// The prefixes are the slot-marked surface forms of the `procedural_request`
   00521| /// meaning (issue #386): every form is a [`seed::Slot::Prefix`] whose literal
   00522| /// (the text before the `…` marker) is the matchable prefix. A form may name
   00523| /// the canonical operation in its `action` field (do, perform, implement,
   00524| /// create, write); an empty action means the operation is taken from the task's
   00525| /// first word. The weak telegraphic form ("how order X") uses a separate seed
   00526| /// role and is accepted only when the first task word is an approved procedural
   00527| /// action. No per-language prefix list lives here — only the concept.
   00528| fn extract_procedural_how_to_task(normalized: &str) -> Option<ProceduralHowToTask> {
   00529|     let clean_prompt = clean_procedural_fragment(normalized);
   00530|     // Action-less forms first, action-carrying forms as fallback. A form
   00531|     // without an `action` leaves the verb in the task's own words — "how to
   00532|     // do X" keeps task "do X" with action "do" split from it — while a form
   00533|     // that names the canonical action consumes its verb into the prefix and
   00534|     // is only there for prompts whose remaining words carry none ("как
   00535|     // сделать X": the action is the form's, there is no verb left to keep).
   00536|     // Declaration order alone let "how to do …" shadow "how to …" and drop
   00537|     // the verb from the task text, the search query, and the wikiHow
   00538|     // candidate (issue #1138).
   00539|     for actionless_pass in [true, false] {
   00540|         for form in seed::lexicon().role_word_forms(seed::ROLE_PROCEDURAL_REQUEST) {
   00541|             if form.action.is_empty() != actionless_pass {
   00542|                 continue;
   00543|             }
   00544|             if let Some(rest) = clean_prompt.strip_prefix(form.before_slot()) {
   00545|                 let action_override = (!form.action.is_empty()).then_some(form.action.as_str());
   00546|                 return build_procedural_task(rest, action_override);
   00547|             }
   00548|         }
   00549|     }
   00550|     extract_elided_procedural_how_to_task(&clean_prompt)
   00551| }
   00552| 
   00553| fn extract_elided_procedural_how_to_task(clean_prompt: &str) -> Option<ProceduralHowToTask> {
   00554|     for form in seed::lexicon().role_word_forms(seed::ROLE_PROCEDURAL_REQUEST_ELIDED_LEAD) {
   00555|         let Some(rest) = clean_prompt.strip_prefix(form.before_slot()) else {
   00556|             continue;
   00557|         };
   00558|         let task = clean_procedural_fragment(rest);
   00559|         if task.is_empty() {
   00560|             continue;
   00561|         }
   00562|         let (task, corrections) = correct_common_procedural_typos(&task);
   00563|         let Some((action, object)) = split_known_procedural_action_object(&task) else {
   00564|             continue;
   00565|         };
   00566|         if object.is_empty() {
   00567|             continue;
   00568|         }
   00569|         return Some(ProceduralHowToTask {
   00570|             task,
   00571|             action,
   00572|             object,
   00573|             corrections,
   00574|         });
   00575|     }
   00576|     None
   00577| }
