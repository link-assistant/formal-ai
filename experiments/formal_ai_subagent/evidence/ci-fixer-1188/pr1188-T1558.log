   00803| /// Extract the first meaningful topic word/phrase from a prior assistant reply.
   00804| /// Looks for "Term (category):" patterns first, then the first capitalised token.
   00805| fn extract_topic_from_prior_reply(reply: &str) -> Option<String> {
   00806|     // Match "Term (category): description" — common in concept_lookup answers.
   00807|     let first_line = reply.lines().next().unwrap_or("").trim();
   00808|     if let Some(paren_pos) = first_line.find('(') {
   00809|         let candidate = first_line[..paren_pos].trim();
   00810|         if !candidate.is_empty() {
   00811|             return Some(candidate.to_lowercase());
   00812|         }
   00813|     }
   00814|     // Fallback: first capitalised token that is not a function word. The skip
   00815|     // list is the `topic_scan_stop_word` meaning's bare surface forms
   00816|     // (data/seed/meanings-how.lino): closed-class words (articles, prepositions,
   00817|     // conjunctions, pronouns) and the 'source' citation heading that name no
   00818|     // subject, compared case-insensitively. No per-language word list lives here
   00819|     // — only the concept "a function word that names no topic".
   00820|     let stop_words = seed::lexicon().role_word_forms(seed::ROLE_TOPIC_SCAN_STOP_WORD);
   00821|     for word in reply.split_whitespace() {
   00822|         let clean = word.trim_matches(|c: char| !c.is_alphanumeric());
   00823|         if clean.len() >= 2 && clean.chars().next().is_some_and(char::is_uppercase) {
   00824|             let lowered = clean.to_lowercase();
   00825|             if !stop_words.iter().any(|form| form.text == lowered) {
   00826|                 return Some(lowered);
   00827|             }
   00828|         }
   00829|     }
   00830|     None
   00831| }
