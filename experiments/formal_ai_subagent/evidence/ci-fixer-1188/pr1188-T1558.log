   00323| /// Is `lower` a bare "how it works" form — a fixed phrase carrying no subject?
   00324| ///
   00325| /// The bare phrases are the [`seed::Slot::Bare`] word forms of the
   00326| /// `mechanism_inquiry` meaning (issue #386): no hardcoded per-language list
   00327| /// lives here, only the language-independent concept. A prompt is the bare form
   00328| /// when it equals such a phrase or is that phrase followed by a space.
   00329| fn is_bare_how_it_works(lower: &str) -> bool {
   00330|     seed::lexicon()
   00331|         .role_word_forms(seed::ROLE_MECHANISM_INQUIRY)
   00332|         .into_iter()
   00333|         .filter(|form| form.slot() == seed::Slot::Bare)
   00334|         .any(|form| {
   00335|             let phrase = form.text.as_str();
   00336|             lower == phrase
   00337|                 || lower
   00338|                     .strip_prefix(phrase)
   00339|                     .is_some_and(|rest| rest.starts_with(' '))
   00340|         })
   00341| }
   00342| 
   00343| /// Extract the explicit subject from multilingual "how X works?" prompts.
   00344| /// Returns `None` when the prompt is the bare "how it works?" form.
   00345| ///
   00346| /// The affixes are the slot-marked surface forms of the `mechanism_inquiry`
   00347| /// meaning (issue #386): the position of the `…` (U+2026) marker classifies
   00348| /// each form, so the matching strategy is derived from the data, not from a
   00349| /// hardcoded per-language list. The mechanism order — prefix surfaces, then
   00350| /// circumfix, then suffix — and the within-bucket declaration order are
   00351| /// preserved so behaviour is identical to the prior inline arrays:
   00352| /// * [`seed::Slot::Prefix`] (`how does …`): the literal precedes the subject;
   00353| ///   `strip_mechanism_tail` then trims a trailing verb, and we return its
   00354| ///   result even when it is `None` (an early commit, as before).
   00355| /// * [`seed::Slot::Circumfix`] (`how … works`): the subject sits between the
   00356| ///   two literals.
   00357| /// * [`seed::Slot::Suffix`] (`… как работает`): the subject precedes the
   00358| ///   literal. Suffix surfaces are end-anchored and script-disjoint across
   00359| ///   languages, so their relative order across languages does not change which
   00360| ///   one matches a given prompt.
   00361| fn extract_how_it_works_subject(original: &str, lower: &str) -> Option<String> {
   00362|     let forms = seed::lexicon().role_word_forms(seed::ROLE_MECHANISM_INQUIRY);
   00363| 
   00364|     for form in forms.iter().filter(|f| f.slot() == seed::Slot::Prefix) {
   00365|         if let Some(subject) = subject_after_prefix(original, lower, form.before_slot()) {
   00366|             return strip_mechanism_tail(&subject);
   00367|         }
   00368|     }
   00369| 
   00370|     for form in forms.iter().filter(|f| f.slot() == seed::Slot::Circumfix) {
   00371|         if let Some(subject) =
   00372|             subject_between(original, lower, form.before_slot(), &[form.after_slot()])
   00373|         {
   00374|             return Some(subject);
   00375|         }
   00376|     }
   00377| 
   00378|     for form in forms.iter().filter(|f| f.slot() == seed::Slot::Suffix) {
   00379|         if let Some(subject) = subject_before_suffix(original, lower, form.after_slot()) {
   00380|             return Some(subject);
   00381|         }
   00382|     }
   00383| 
   00384|     None
   00385| }
   00386| 
   00387| fn subject_after_prefix(original: &str, lower: &str, prefix: &str) -> Option<String> {
   00388|     lower.strip_prefix(prefix)?;
   00389|     let rest = original.get(prefix.len()..)?;
   00390|     clean_mechanism_subject(rest)
   00391| }
   00392| 
   00393| fn subject_before_suffix(original: &str, lower: &str, suffix: &str) -> Option<String> {
   00394|     lower.strip_suffix(suffix)?;
   00395|     let end = original.len().checked_sub(suffix.len())?;
   00396|     clean_mechanism_subject(original.get(..end)?)
   00397| }
   00398| 
   00399| fn subject_between(original: &str, lower: &str, prefix: &str, suffixes: &[&str]) -> Option<String> {
   00400|     if !lower.starts_with(prefix) {
   00401|         return None;
   00402|     }
   00403|     for suffix in suffixes {
   00404|         if lower.ends_with(suffix) {
   00405|             let end = original.len().checked_sub(suffix.len())?;
   00406|             if end <= prefix.len() {
   00407|                 return None;
   00408|             }
   00409|             return clean_mechanism_subject(original.get(prefix.len()..end)?);
   00410|         }
   00411|     }
   00412|     None
   00413| }
   00414| 
   00415| /// Strip a trailing mechanism predicate ("work", "works", "structured", …) so a
   00416| /// prefix match such as "how does X work" yields the bare subject "X".
   00417| ///
   00418| /// The predicate tails carry the [`seed::ROLE_MECHANISM_PREDICATE`] role; each
   00419| /// is a [`seed::Slot::Suffix`] whose text after the `…` slot is the literal to
   00420| /// trim. They are tried in declaration order and the first match wins, mirroring
   00421| /// the original return-on-first-match loop. No per-language tail list lives here.
   00422| fn strip_mechanism_tail(subject: &str) -> Option<String> {
   00423|     let mut clean = clean_mechanism_subject(subject)?;
   00424|     let lower = clean.to_lowercase();
   00425|     for form in &seed::lexicon().role_word_forms(seed::ROLE_MECHANISM_PREDICATE) {
   00426|         let suffix = form.after_slot();
   00427|         if lower.ends_with(suffix) {
   00428|             let end = clean.len().checked_sub(suffix.len())?;
   00429|             clean.truncate(end);
   00430|             return clean_mechanism_subject(&clean);
   00431|         }
   00432|     }
   00433|     Some(clean)
   00434| }
   00435| 
   00436| fn clean_mechanism_fragment(value: &str) -> String {
   00437|     value
   00438|         .trim()
   00439|         .trim_matches(|character: char| {
   00440|             matches!(
   00441|                 character,
   00442|                 '`' | '"' | '\'' | '«' | '»' | '<' | '>' | '(' | ')' | '[' | ']' | '{' | '}'
   00443|             )
   00444|         })
   00445|         .trim_end_matches(['?', '？', '。', '.', '!', ',', ';', ':'])
   00446|         .trim()
   00447|         .to_owned()
   00448| }
   00449| 
   00450| /// Trim optional detail/politeness modifiers from a candidate subject and reject
   00451| /// it outright when it is a non-referential subject (a pronoun or bare function
   00452| /// word that names no real topic).
   00453| ///
   00454| /// The modifier tails carry the [`seed::ROLE_DETAIL_MODIFIER`] role; each is a
   00455| /// [`seed::Slot::Suffix`] stripped in declaration order, re-trimming after each,
   00456| /// so several modifiers can fall away in one pass. The rejection set carries the
   00457| /// [`seed::ROLE_NON_REFERENTIAL_SUBJECT`] role: [`seed::Slot::Bare`] surfaces
   00458| /// match the whole candidate exactly and [`seed::Slot::Prefix`] surfaces match a
   00459| /// candidate that begins with the literal before the `…` slot. No per-language
   00460| /// modifier or pronoun list lives here.
   00461| fn clean_mechanism_subject(value: &str) -> Option<String> {
   00462|     let mut clean = clean_mechanism_fragment(value);
   00463|     for form in &seed::lexicon().role_word_forms(seed::ROLE_DETAIL_MODIFIER) {
   00464|         let suffix = form.after_slot();
   00465|         let lower = clean.to_lowercase();
   00466|         if lower.ends_with(suffix) {
   00467|             let end = clean.len().checked_sub(suffix.len())?;
   00468|             clean.truncate(end);
   00469|             clean = clean_mechanism_fragment(&clean);
   00470|         }
   00471|     }
   00472|     let lower = clean.to_lowercase();
   00473|     let non_referential = seed::lexicon()
   00474|         .role_word_forms(seed::ROLE_NON_REFERENTIAL_SUBJECT)
   00475|         .iter()
   00476|         .any(|form| match form.slot() {
   00477|             seed::Slot::Bare => lower == form.text,
   00478|             seed::Slot::Prefix => lower.starts_with(form.before_slot()),
   00479|             _ => false,
   00480|         });
   00481|     if clean.is_empty() || non_referential {
   00482|         return None;
   00483|     }
   00484|     Some(clean)
   00485| }
