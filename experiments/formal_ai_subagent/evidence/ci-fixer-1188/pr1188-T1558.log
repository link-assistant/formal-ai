   00153| /// Handles follow-up requests for the concrete steps of an active procedure —
   00154| /// "Can you give me specific instructions?", "give me the exact steps", "step
   00155| /// by step", and their multilingual equivalents (issue #444). These prompts
   00156| /// carry no "how to" lead-in of their own, so without this handler the user's
   00157| /// natural follow-up after a how-to answer fell through to the unknown opener
   00158| /// (the exact symptom reported in the issue).
   00159| ///
   00160| /// The handler fires only when (a) the current prompt evidences the
   00161| /// `procedural_elaboration` meaning and (b) the prior user turn was itself a
   00162| /// procedural "how to X" request that the assistant answered. It then re-runs
   00163| /// the original discovery in the original language via [`try_how_to_procedure`],
   00164| /// so the elaboration rebinds to the recovered task instead of dead-ending. The
   00165| /// deeper "construct a full guide from collected sources" work tracked by the
   00166| /// issue is the browser worker's live-fetch path; this keeps the offline engine
   00167| /// and the worker in parity on the coreference fix.
   00168| pub fn try_procedural_how_to_followup(
   00169|     prompt: &str,
   00170|     normalized: &str,
   00171|     log: &mut EventLog,
   00172| ) -> Option<SymbolicAnswer> {
   00173|     // The dispatch loop passes a lightly-cleaned `prompt.to_lowercase()` whose
   00174|     // punctuation survives, so "Can you give me specific instructions?" keeps its
   00175|     // trailing "?" and a phrase surface would miss. Canonicalise first, exactly
   00176|     // as `try_software_project_followup` does, before matching the meaning.
   00177|     let canonical = normalize_prompt(prompt);
   00178|     let canonical = if canonical.is_empty() {
   00179|         normalized
   00180|     } else {
   00181|         canonical.as_str()
   00182|     };
   00183|     if !is_procedural_elaboration_request(canonical) {
   00184|         return None;
   00185|     }
   00186|     // The prior exchange must have been a how-to procedure: the previous user
   00187|     // turn re-parses as a procedural request and the assistant answered it.
   00188|     last_assistant_turn(log)?;
   00189|     let prior_user = last_user_turn(log)?.to_owned();
   00190|     let prior_normalized = normalize_prompt(&prior_user);
   00191|     let task = extract_procedural_how_to_task(&prior_normalized)?;
   00192|     log.append("procedural_how_to:followup", canonical.to_owned());
   00193|     log.append("procedural_how_to:followup_task", task.task);
   00194|     // Re-run the original discovery in the original language so the recovered
   00195|     // plan matches what the prior turn produced, now bound to the elaboration.
   00196|     try_how_to_procedure(&prior_user, &prior_normalized, log)
   00197| }
