   00030| /// Handles source-backed procedural requests such as "How to make tea?" and
   00031| /// "How can I prepare fried potatoes?". The offline Rust engine records the
   00032| /// same discovery plan that the browser worker can execute: local
   00033| /// decomposition first, Wikimedia/wikiHow candidates next, then web search
   00034| /// and recursive fetch checks only as the fallback path.
   00035| /// A request the legality catalogue flags is declined, so `legality_warning`
   00036| /// answers it even when the `procedural_how_to` promotion hoisted this row.
   00037| pub fn try_how_to_procedure(
   00038|     prompt: &str,
   00039|     normalized: &str,
   00040|     log: &mut EventLog,
   00041| ) -> Option<SymbolicAnswer> {
   00042|     if crate::legality_warning::assess(prompt, normalized).is_some() {
   00043|         return None;
   00044|     }
   00045|     let task = extract_procedural_how_to_task(normalized)?;
   00046|     for correction in &task.corrections {
   00047|         log.append(
   00048|             "spelling_correction",
   00049|             format!("{}->{}", correction.from, correction.to),
   00050|         );
   00051|     }
   00052|     let is_install_procedure = task.action == "install";
   00053|     let fallback_query = how_policy(
   00054|         "procedural_how_to",
   00055|         "fallback-query",
   00056|         &[("task", &task.task)],
   00057|     );
   00058|     let search_query = procedural_search_query(&task);
   00059|     let wikihow_candidate = wikihow_page_title(&task.task);
   00060|     let wikihow_api_url = format!(
   00061|         "https://www.wikihow.com/api.php?action=parse&page={wikihow_candidate}\
   00062|          &prop=text%7Csections%7Cdisplaytitle&format=json&origin=*"
   00063|     );
   00064| 
   00065|     // The request evidence records what was asked for. A specific verb names
   00066|     // the operation and stays in the request ("calibrate a torque wrench");
   00067|     // the generic light verb "do" names no operation — "how to do X" asks
   00068|     // for X — so the object alone is the request. The task text keeps the
   00069|     // verb either way, keeping the search query and the wikiHow candidate
   00070|     // faithful to the user's phrasing.
   00071|     let request = if task.action == "do" && !task.object.is_empty() {
   00072|         task.object.clone()
   00073|     } else {
   00074|         task.task.clone()
   00075|     };
   00076|     log.append("procedural_how_to:request", request);
   00077|     log.append("procedural_how_to:action", task.action.clone());
   00078|     if !task.object.is_empty() {
   00079|         log.append("procedural_how_to:object", task.object.clone());
   00080|     }
   00081|     if is_install_procedure {
   00082|         log.append(
   00083|             "procedural_how_to:stage",
   00084|             "official_documentation".to_owned(),
   00085|         );
   00086|         log.append(
   00087|             "procedural_how_to:source_gate",
   00088|             "official_documentation_first".to_owned(),
   00089|         );
   00090|     }
   00091|     log.append("procedural_how_to:stage", "wikipedia".to_owned());
   00092|     log.append("procedural_how_to:stage", "wikidata".to_owned());
   00093|     log.append("procedural_how_to:stage", "wikihow_api".to_owned());
   00094|     log.append(
   00095|         "procedural_how_to:wikihow_candidate",
   00096|         wikihow_candidate.clone(),
   00097|     );
   00098|     log.append("http_fetch:request", wikihow_api_url.clone());
   00099|     log.append("procedural_how_to:stage", "web_search".to_owned());
   00100|     log.append("web_search:request", search_query.clone());
   00101|     if is_install_procedure && search_query != fallback_query {
   00102|         log.append("web_search:request", fallback_query.clone());
   00103|     }
   00104|     for provider in WEB_SEARCH_PROVIDERS {
   00105|         log.append("web_search:provider_planned", (*provider).to_owned());
   00106|     }
   00107|     log.append(
   00108|         "web_search:fusion_planned",
   00109|         format!("rrf:k={WEB_SEARCH_RRF_K}"),
   00110|     );
   00111|     log.append(
   00112|         "procedural_how_to:stage",
   00113|         "recursive_fetch_check".to_owned(),
   00114|     );
   00115|     log.append(
   00116|         "procedural_how_to:source_gate",
   00117|         "explicit_steps_only".to_owned(),
   00118|     );
   00119| 
   00120|     let provider_summary = WEB_SEARCH_PROVIDERS.join(", ");
   00121|     let body = render_procedural_how_to_body(
   00122|         &task,
   00123|         &wikihow_candidate,
   00124|         &wikihow_api_url,
   00125|         &search_query,
   00126|         &fallback_query,
   00127|         &provider_summary,
   00128|         detect_language(prompt).slug(),
   00129|     );
   00130| 
   00131|     Some(finalize_simple(
   00132|         prompt,
   00133|         log,
   00134|         "procedural_how_to",
   00135|         "response:procedural_how_to",
   00136|         &body,
   00137|         0.78,
   00138|     ))
   00139| }
