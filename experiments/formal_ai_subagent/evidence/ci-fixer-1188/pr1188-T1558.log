   00595| fn split_known_procedural_action_object(task: &str) -> Option<(String, String)> {
   00596|     let mut forms = seed::lexicon().role_word_forms(seed::ROLE_PROCEDURAL_ACTION_VERB);
   00597|     forms.sort_by_key(|form| std::cmp::Reverse(form.text.chars().count()));
   00598|     for form in forms {
   00599|         let action_surface = form.text.trim();
   00600|         if action_surface.is_empty() {
   00601|             continue;
   00602|         }
   00603|         let Some(rest) = task.strip_prefix(action_surface) else {
   00604|             continue;
   00605|         };
   00606|         if !rest.is_empty()
   00607|             && !rest.chars().next().is_some_and(char::is_whitespace)
   00608|             && !crate::coding::contains_cjk(action_surface)
   00609|         {
   00610|             continue;
   00611|         }
   00612|         let action = if form.action.is_empty() {
   00613|             action_surface.to_owned()
   00614|         } else {
   00615|             form.action.clone()
   00616|         };
   00617|         return Some((action, clean_procedural_fragment(rest)));
   00618|     }
   00619|     None
   00620| }
