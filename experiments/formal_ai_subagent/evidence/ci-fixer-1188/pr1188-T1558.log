   00778| /// A seeded response with its `{name}` slots filled in one pass, so a value
   00779| /// that itself contains braces (a user's task text) is never re-filled.
   00780| /// Issue #918: the how-to and how-it-works wording is seed data the browser
   00781| /// twin renders too.
   00782| fn how_response(intent: &str, language: &str, values: &[(&str, &str)]) -> String {
   00783|     seed::render_localized_once(intent, language, values)
   00784| }
