   00710| fn wikihow_page_title(task: &str) -> String {
   00711|     task.split(|character: char| !is_word_character(character))
   00712|         .filter(|word| !word.is_empty())
   00713|         .map(capitalize_word)
   00714|         .collect::<Vec<_>>()
   00715|         .join("-")
   00716| }
   00717| 
   00718| /// Whether `character` may stand inside a word for the wikiHow candidate
   00719| /// slug.
   00720| ///
   00721| /// `char::is_alphanumeric` is not enough for abugida scripts: Devanagari
   00722| /// writes conjuncts with combining marks ("कनेक्ट" is letters joined by the
   00723| /// virama ्, a vowel sign sits on the letter before it), and a mark carries no
   00724| /// standalone sound, so splitting on it tears every conjunct apart
   00725| /// ("कनेक्ट" became "कनेक-ट", a word that does not exist). Marks therefore
   00726| /// join the word around them; only characters outside the letters and the
   00727| /// marks — spaces, punctuation, digits' neighbours in other scripts' ties —
   00728| /// bound a word.
   00729| fn is_word_character(character: char) -> bool {
   00730|     use unicode_general_category::GeneralCategory;
   00731|     character.is_alphanumeric()
   00732|         || matches!(
   00733|             unicode_general_category::get_general_category(character),
   00734|             GeneralCategory::NonspacingMark
   00735|                 | GeneralCategory::SpacingMark
   00736|                 | GeneralCategory::EnclosingMark
   00737|         )
   00738| }
