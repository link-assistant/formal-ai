   00795| fn capitalize_word(word: &str) -> String {
   00796|     let mut chars = word.chars();
   00797|     let Some(first) = chars.next() else {
   00798|         return String::new();
   00799|     };
   00800|     format!("{}{rest}", first.to_uppercase(), rest = chars.as_str())
   00801| }
