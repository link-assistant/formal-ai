   00786| /// A `policy <handler>` template of `data/seed/handler-rules.lino` (the
   00787| /// search-query and concept-query frames), filled in one pass.
   00788| fn how_policy(handler: &str, key: &str, values: &[(&str, &str)]) -> String {
   00789|     seed::fill_template_once(
   00790|         &crate::rule_interpreter::handler_policy(handler, key).unwrap_or_default(),
   00791|         values,
   00792|     )
   00793| }
