   00656| fn clean_procedural_fragment(value: &str) -> String {
   00657|     let mut clean = value
   00658|         .trim()
   00659|         .trim_matches(|character: char| matches!(character, '`' | '"' | '\'' | ' '))
   00660|         .trim_end_matches(['?', '!', '.', ',', ';', ':'])
   00661|         .trim()
   00662|         .to_owned();
   00663| 
   00664|     // The trailing "step by step" / politeness modifiers are the slot-marked
   00665|     // surface forms of the `procedural_task_modifier` meaning
   00666|     // (data/seed/meanings-how.lino): every form is a suffix whose text after the
   00667|     // … marker (`after_slot`) is the tail to strip, scanned in declaration order
   00668|     // so the longer Russian "напиши по шагам" still precedes its "по шагам" tail.
   00669|     // No per-language modifier list lives here — only the concept.
   00670|     for form in &seed::lexicon().role_word_forms(seed::ROLE_PROCEDURAL_TASK_MODIFIER) {
   00671|         if let Some(stripped) = clean.strip_suffix(form.after_slot()) {
   00672|             clean = stripped.trim().to_owned();
   00673|             break;
   00674|         }
   00675|     }
   00676|     clean
   00677| }
   00678| 
   00679| fn correct_common_procedural_typos(task: &str) -> (String, Vec<SpellingCorrection>) {
   00680|     // The misspelling -> correction pairs are the `common_typo` meaning's bare
   00681|     // surface forms (data/seed/meanings-how.lino): each form's text is the
   00682|     // misspelled token and its `action` child names the correct spelling. No
   00683|     // per-language typo table lives here — only the concept.
   00684|     let lexicon = seed::lexicon();
   00685|     let typos = lexicon.role_word_forms(seed::ROLE_COMMON_TYPO);
   00686| 
   00687|     let mut corrections: Vec<SpellingCorrection> = Vec::new();
   00688|     let corrected = task
   00689|         .split_whitespace()
   00690|         .map(|token| {
   00691|             for form in &typos {
   00692|                 if token == form.text {
   00693|                     if !corrections.iter().any(|seen| seen.from == form.text) {
   00694|                         corrections.push(SpellingCorrection {
   00695|                             from: form.text.clone(),
   00696|                             to: form.action.clone(),
   00697|                         });
   00698|                     }
   00699|                     return form.action.clone();
   00700|                 }
   00701|             }
   00702|             token.to_owned()
   00703|         })
   00704|         .collect::<Vec<_>>()
   00705|         .join(" ");
   00706| 
   00707|     (corrected, corrections)
   00708| }
