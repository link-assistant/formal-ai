   00579| fn procedural_search_query(task: &ProceduralHowToTask) -> String {
   00580|     if task.action == "install" {
   00581|         let target = if task.object.is_empty() {
   00582|             task.task.as_str()
   00583|         } else {
   00584|             task.object.as_str()
   00585|         };
   00586|         return how_policy("procedural_how_to", "install-query", &[("target", target)]);
   00587|     }
   00588|     how_policy(
   00589|         "procedural_how_to",
   00590|         "fallback-query",
   00591|         &[("task", &task.task)],
   00592|     )
   00593| }
