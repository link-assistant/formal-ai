   00199| /// Recognise a request for the concrete steps of an active procedure by
   00200| /// *meaning*, not a hardcoded per-language phrase table (issue #386 convention).
   00201| /// Each surface of the `procedural_elaboration` meaning lives in
   00202| /// `data/seed/meanings-how.lino`; this code knows only the concept. Matching is
   00203| /// whole-token/phrase for Latin scripts and substring for CJK, exactly as every
   00204| /// other lexicon recogniser, so "specific instructions" matches but "specifics"
   00205| /// does not.
   00206| fn is_procedural_elaboration_request(normalized: &str) -> bool {
   00207|     seed::lexicon()
   00208|         .meanings_with_role(seed::ROLE_PROCEDURAL_ELABORATION)
   00209|         .any(|meaning| meaning.evidenced_in(normalized))
   00210| }
