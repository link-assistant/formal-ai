   00622| fn build_procedural_task(
   00623|     raw_task: &str,
   00624|     action_override: Option<&str>,
   00625| ) -> Option<ProceduralHowToTask> {
   00626|     let task = clean_procedural_fragment(raw_task);
   00627|     if task.is_empty() {
   00628|         return None;
   00629|     }
   00630|     let (task, corrections) = correct_common_procedural_typos(&task);
   00631| 
   00632|     let (action, object) = if let Some(action) = action_override {
   00633|         (action.to_owned(), task.clone())
   00634|     } else {
   00635|         split_procedural_action_object(&task)?
   00636|     };
   00637| 
   00638|     Some(ProceduralHowToTask {
   00639|         task,
   00640|         action,
   00641|         object,
   00642|         corrections,
   00643|     })
   00644| }
   00645| 
   00646| fn split_procedural_action_object(task: &str) -> Option<(String, String)> {
   00647|     let mut parts = task.splitn(2, char::is_whitespace);
   00648|     let action = parts.next()?.trim();
   00649|     if action.is_empty() {
   00650|         return None;
   00651|     }
   00652|     let object = parts.next().unwrap_or("").trim();
   00653|     Some((action.to_owned(), object.to_owned()))
   00654| }
