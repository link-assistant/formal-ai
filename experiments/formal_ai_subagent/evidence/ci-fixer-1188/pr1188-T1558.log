   00212| /// Handles follow-up elaboration prompts such as "how it works?", "how does
   00213| /// it work?", or multilingual "how X works?" variants. When the prior
   00214| /// assistant turn mentioned a named concept the solver re-runs a concept lookup
   00215| /// for that topic. Explicit unknown subjects get a source-backed discovery plan
   00216| /// instead of falling through to the unknown fallback.
   00217| pub fn try_how_it_works(
   00218|     prompt: &str,
   00219|     normalized: &str,
   00220|     log: &mut EventLog,
   00221| ) -> Option<SymbolicAnswer> {
   00222|     let query = extract_how_it_works_query(prompt, normalized)?;
   00223|     log.append("followup:how_it_works", normalized.to_owned());
   00224| 
   00225|     // When a subject was explicit in the prompt, do a direct concept lookup.
   00226|     if let Some(ref term) = query.subject {
   00227|         log.append(
   00228|             "followup:subject",
   00229|             format!("inline:{}", term.to_lowercase()),
   00230|         );
   00231|         let concept_prompt = how_policy("how_it_works", "concept-query", &[("term", term)]);
   00232|         if let Some(concept_query) = extract_concept_query(&concept_prompt)
   00233|             && lookup_concept_query(&concept_query).is_some()
   00234|         {
   00235|             // Delegate to try_concept_lookup by synthesising a standard prompt.
   00236|             return try_concept_lookup(&concept_prompt, log);
   00237|         }
   00238|         record_mechanism_query(log, term);
   00239|         let body = render_mechanism_discovery_answer(term, detect_language(prompt).slug());
   00240|         return Some(finalize_simple(
   00241|             prompt,
   00242|             log,
   00243|             "how_it_works",
   00244|             "response:how_it_works",
   00245|             &body,
   00246|             0.68,
   00247|         ));
   00248|     }
   00249| 
   00250|     // No inline subject — look for the topic in the prior assistant reply.
   00251|     if let Some(prior) = last_assistant_turn(log).map(str::to_owned) {
   00252|         log.append("followup:prior_turn", "assistant".to_owned());
   00253|         // Extract the first capitalised noun phrase from the prior reply
   00254|         // (typically the term in "Term (category): …" format).
   00255|         if let Some(term) = extract_topic_from_prior_reply(&prior) {
   00256|             use crate::concepts::{extract_concept_query, lookup_concept_query};
   00257|             let concept_prompt = how_policy("how_it_works", "concept-query", &[("term", &term)]);
   00258|             if let Some(query) = extract_concept_query(&concept_prompt)
   00259|                 && lookup_concept_query(&query).is_some()
   00260|             {
   00261|                 log.append("followup:subject", format!("prior_reply:{term}"));
   00262|                 return try_concept_lookup(&concept_prompt, log);
   00263|             }
   00264|             // Topic is known from history but not in the concept corpus —
   00265|             // return a helpful explanation that names the topic.
   00266|             let body = how_response("how_it_works_prior_topic", "en", &[("term", &term)]);
   00267|             log.append("followup:subject", format!("prior_reply_no_record:{term}"));
   00268|             return Some(finalize_simple(
   00269|                 prompt,
   00270|                 log,
   00271|                 "concept_elaboration_missing",
   00272|                 "response:concept_elaboration_missing",
   00273|                 &body,
   00274|                 0.3,
   00275|             ));
   00276|         }
   00277|     }
   00278| 
   00279|     // No context at all — route to meta_explanation, the claim row's refusal lane.
   00280|     log.append(
   00281|         "how_it_works:refusal",
   00282|         "no subject and no prior reply".to_owned(),
   00283|     );
