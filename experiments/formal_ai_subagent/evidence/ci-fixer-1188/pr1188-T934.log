   00146| /// The seeded answer declining a request whose quotes do not pair (PR #1188
   00147| /// G71) or nest (G90), whose edit names several files (G91, G104), or whose
   00148| /// several edits hold one that is no replacement (G106); mirrors
   00149| /// `requestFaultAnswer` in `js/agentic/planner.mjs`.
   00150| ///
   00151| /// Steps joined by a sequence cue are each checked alone (G99).
   00152| pub(super) fn request_fault_answer(task: &str) -> Option<AgenticPlan> {
   00153|     let fault = crate::normal_markov::quote_fault(task)
   00154|         .map(|fault| (format!("request_quote_{}", fault.kind), fault.fragment))
   00155|         .or_else(|| {
   00156|             nested_quote_fault(task).map(|fault| (fault.intent.to_owned(), fault.fragment))
   00157|         });
   00158|     let answer = if let Some((intent, fragment)) = fault {
   00159|         code_task::render_seeded_change(&intent, task, "", &[(FRAGMENT_PLACEHOLDER, &fragment)])
   00160|     } else if super::request_sequence::sequence_steps(task).is_some() {
   00161|         return None;
   00162|     } else if let Some(targets) = super::replace_list::several_edit_targets(task) {
   00163|         code_task::render_seeded_change(
   00164|             "request_several_edit_targets",
   00165|             task,
   00166|             "",
   00167|             &[("{files}", &targets.join("`, `"))],
   00168|         )
   00169|     } else {
