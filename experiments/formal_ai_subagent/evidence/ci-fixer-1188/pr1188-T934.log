   00109| /// The first quoted text of a request naming a file whose closing mark opens
   00110| /// an inner quote and that the request's edit, if one can be read, does not
   00111| /// hold whole (mirrors `nestedQuoteFault`).
   00112| pub(super) fn nested_quote_fault(text: &str) -> Option<NestedQuote> {
   00113|     let edit = super::write_request::compose_edit_request(text);
   00114|     // A request naming a file whose edit cannot be read at all is declined too.
   00115|     if edit.is_none() && super::module_function::paths_in(text).is_empty() {
   00116|         return None;
   00117|     }
   00118|     for segment in quoted_segment_spans(text) {
   00119|         let opening = text[segment.start..].chars().next();
   00120|         if !opening.is_some_and(|mark| SAME_MARKS.contains(&mark))
   00121|             || text[segment.start..].starts_with(FENCE)
   00122|             || !opens_inner(text, segment.end)
   00123|         {
   00124|             continue;
   00125|         }
   00126|         let next = text[segment.end..].chars().next().map_or(0, char::len_utf8);
   00127|         let across = &text[segment.start + 1..segment.end + next];
   00128|         let held = edit
   00129|             .as_ref()
   00130|             .is_some_and(|(_, old, new)| old.contains(across) || new.contains(across));
   00131|         if held {
   00132|             continue;
   00133|         }
   00134|         let fragment: String = text[segment.start..]
   00135|             .chars()
   00136|             .take(FAULT_FRAGMENT_CHARS)
   00137|             .collect();
   00138|         return Some(NestedQuote {
   00139|             intent: NESTED_INTENT,
   00140|             fragment: fragment.trim_end().to_owned(),
   00141|         });
   00142|     }
   00143|     None
   00144| }
