   00001| //! A quoted text that holds its own quote mark (PR #1188 G90, G107), and the
   00002| //! request faults the planner declines before any arm reads a payload.
   00003| //!
   00004| //! With one mark for both ends (apostrophe, double quote or backtick), `Replace 'a('x')' with 'b' in
   00005| //! f.rs.` pairs the outer opening quote with the first inner one. A closing
   00006| //! mark is followed by a space, the end, or punctuation; one followed straight
   00007| //! away by a letter, a digit or another quote mark opened an inner quote
   00008| //! instead. When the inner spans pair among themselves and the payload closes
   00009| //! at the end of the instruction, the payload runs there, whatever sentences
   00010| //! it holds. When the edit read from the request still does not hold such a
   00011| //! quote whole, the request is declined, naming the quote, rather than
   00012| //! guessed. The Rust original of `js/agentic/quote_nesting.mjs`.
   00013| 
   00014| use super::code_task;
   00015| use super::planner::AgenticPlan;
   00016| use crate::normal_markov::{quoted_segment_spans, wrapped_in_quote_pair};
   00017| 
   00018| /// The quote marks that open and close a quoted text alike.
   00019| const SAME_MARKS: [char; 3] = ['\'', '"', '`'];
   00020| /// The mark of a fenced block, whose body may hold any quote.
   00021| const FENCE: &str = "```";
   00022| /// How many characters of the request the decline quotes.
   00023| const FAULT_FRAGMENT_CHARS: usize = 32;
   00024| /// What may stand right after a closing mark.
   00025| const CLOSE_FOLLOWERS: &str = ".,;:!?)]}'\"`»";
   00026| /// What may stand right before an opening mark.
   00027| const OPEN_LEADERS: &str = "([{";
   00028| /// The seeded answer to a quote that holds its own mark.
   00029| const NESTED_INTENT: &str = "request-quote-nested";
   00030| /// The seeded answer to a clause of several edits that is no replacement.
   00031| const FRAGMENT_PLACEHOLDER: &str = "{fragment}";
   00032| const CLAUSE_PLACEHOLDER: &str = "{clause}";
   00033| const UNPLANNED_CLAUSE_INTENT: &str = "request-edit-clause-unplanned";
   00034| 
   00035| /// A quoted text whose closing mark opens an inner quote.
   00036| pub(super) struct NestedQuote {
   00037|     /// The seeded answer that declines it.
   00038|     pub(super) intent: &'static str,
   00039|     /// Up to 32 characters of the request from `at`, trailing space trimmed.
   00040|     pub(super) fragment: String,
   00041| }
   00042| 
   00043| /// Whether the character at byte `at` opens an inner quote right after a
   00044| /// close.
   00045| fn opens_inner(text: &str, at: usize) -> bool {
   00046|     text.get(at..)
   00047|         .and_then(|rest| rest.chars().next())
   00048|         .is_some_and(|after| after.is_ascii_alphanumeric() || SAME_MARKS.contains(&after))
   00049| }
