   00051| /// Where a new text that starts at byte `from` ends, given the sentence end
   00052| /// `cut` (mirrors `wholePayloadEnd`).
   00053| ///
   00054| /// When the payload cut there is no whole literal, or its closing mark opens
   00055| /// an inner quote, its marks are read by their shape: a mark after a space or
   00056| /// an opening bracket and before a word opens an inner quote, a mark after a
   00057| /// word and before a space or punctuation closes one, and the payload ends
   00058| /// where its own opening mark is closed. `cut` when a mark has neither shape
   00059| /// or the payload never closes.
   00060| pub(super) fn whole_payload_end(request: &str, from: usize, cut: usize) -> usize {
   00061|     let Some(payload) = request.get(from..cut) else {
   00062|         return cut;
   00063|     };
   00064|     if wrapped_in_quote_pair(payload) && !opens_inner(request, cut) {
   00065|         return cut;
   00066|     }
   00067|     let rest = &request[from..];
   00068|     let open = from + (rest.len() - rest.trim_start().len());
   00069|     let Some(mark) = request[open..].chars().next() else {
   00070|         return cut;
   00071|     };
   00072|     if !SAME_MARKS.contains(&mark) || request[open..].starts_with(FENCE) {
   00073|         return cut;
   00074|     }
   00075|     let end = super::positional_edit::instruction_end(request);
   00076|     if end <= open + mark.len_utf8() {
   00077|         return cut;
   00078|     }
   00079|     let mut depth = 1_usize;
   00080|     let mut before = mark;
   00081|     let mut characters = request[open + mark.len_utf8()..end]
   00082|         .char_indices()
   00083|         .peekable();
   00084|     while let Some((offset, character)) = characters.next() {
   00085|         let previous = before;
   00086|         before = character;
   00087|         if character != mark {
   00088|             continue;
   00089|         }
   00090|         let after = characters.peek().map(|(_, next)| *next);
   00091|         let closes = !previous.is_whitespace()
   00092|             && after.is_none_or(|next| next.is_whitespace() || CLOSE_FOLLOWERS.contains(next));
   00093|         let opens = (previous.is_whitespace() || OPEN_LEADERS.contains(previous))
   00094|             && after.is_some_and(|next| !next.is_whitespace());
   00095|         if opens && !closes {
   00096|             depth += 1;
   00097|         } else if closes {
   00098|             depth -= 1;
   00099|         } else {
   00100|             return cut;
   00101|         }
   00102|         if depth == 0 {
   00103|             return open + mark.len_utf8() + offset + mark.len_utf8();
   00104|         }
   00105|     }
   00106|     cut
   00107| }
