   00046| /// The conversation after the user's request and, when given, one tool call
   00047| /// with its result.
   00048| fn conversation(prompt: &str, call: Option<(&str, &str, &str)>) -> Vec<ChatMessage> {
   00049|     let mut messages = vec![
   00050|         ChatMessage::new("system", "<env>\n  Working directory: /work/demo\n</env>"),
   00051|         ChatMessage::user(prompt),
   00052|     ];
   00053|     if let Some((tool, arguments, result)) = call {
   00054|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00055|             "c0",
   00056|             tool,
   00057|             arguments.to_owned(),
   00058|         )]));
   00059|         messages.push(ChatMessage::tool_result("c0", tool, result));
   00060|     }
   00061|     messages
   00062| }
   00063| 
   00064| /// The first planned call (tool, arguments) and the answer given after
   00065| /// `result` comes back.
   00066| fn search_once(prompt: &str, tools: &[&str], result: &str) -> (String, serde_json::Value, String) {
   00067|     let Some(AgenticPlan::ToolCalls(calls)) = plan_chat_step(&conversation(prompt, None), tools)
   00068|     else {
   00069|         panic!("{prompt} planned no tool call");
   00070|     };
   00071|     let call = calls[0].clone();
   00072|     let next = conversation(prompt, Some((&call.tool, &call.arguments, result)));
   00073|     let Some(AgenticPlan::Final(answer)) = plan_chat_step(&next, tools) else {
   00074|         panic!("{prompt} did not answer from the search result");
   00075|     };
   00076|     let arguments = serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00077|     (call.tool, arguments, answer)
   00078| }
