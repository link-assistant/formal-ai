   00408| /// Run `prompt` over the in-memory `files`; the tools act as the Agent CLI's
   00409| /// do. Returns each call (`tool path`, or a shell command) and the answer.
   00410| fn run_over(
   00411|     prompt: &str,
   00412|     files: &mut std::collections::BTreeMap<String, String>,
   00413| ) -> (Vec<String>, Option<String>) {
   00414|     let mut messages = conversation(prompt, None);
   00415|     let mut calls = Vec::new();
   00416|     for step in 0..6 {
   00417|         let planned = match plan_chat_step(&messages, &REDUCED_TOOLS) {
   00418|             Some(AgenticPlan::ToolCalls(planned)) => planned,
   00419|             Some(AgenticPlan::Final(answer)) => return (calls, Some(answer)),
   00420|             _ => break,
   00421|         };
   00422|         let call = planned[0].clone();
   00423|         let arguments: serde_json::Value =
   00424|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00425|         let path = arguments["filePath"]
   00426|             .as_str()
   00427|             .or_else(|| arguments["path"].as_str())
   00428|             .unwrap_or_default()
   00429|             .to_owned();
   00430|         let result = match call.tool.as_str() {
   00431|             "read" => files
   00432|                 .get(&path)
   00433|                 .cloned()
   00434|                 .unwrap_or_else(|| format!("Error: File not found: {path}")),
   00435|             "write" => {
   00436|                 let content = arguments["content"].as_str().unwrap_or_default();
   00437|                 files.insert(path.clone(), content.to_owned());
   00438|                 String::new()
   00439|             }
   00440|             "bash" => {
   00441|                 let command = arguments["command"].as_str().unwrap_or_default();
   00442|                 files
   00443|                     .get(command.trim_start_matches("cat "))
   00444|                     .cloned()
   00445|                     .unwrap_or_default()
   00446|             }
   00447|             _ => String::new(),
   00448|         };
   00449|         calls.push(if call.tool == "bash" {
   00450|             arguments["command"].as_str().unwrap_or_default().to_owned()
   00451|         } else {
   00452|             format!("{} {path}", call.tool)
   00453|         });
   00454|         let id = format!("w{step}");
   00455|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00456|             id.clone(),
   00457|             call.tool.clone(),
   00458|             call.arguments.clone(),
   00459|         )]));
   00460|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00461|     }
   00462|     (calls, None)
   00463| }
