   00330| /// Read returns the module, the shell returns `printed`: the calls (a shell
   00331| /// call by its command) and the final answer.
   00332| fn check(prompt: &str, printed: &str) -> (Vec<String>, Option<String>) {
   00333|     let mut messages = conversation(prompt, None);
   00334|     let mut calls = Vec::new();
   00335|     for step in 0..4 {
   00336|         let planned = match plan_chat_step(&messages, &REDUCED_TOOLS) {
   00337|             Some(AgenticPlan::ToolCalls(planned)) => planned,
   00338|             Some(AgenticPlan::Final(answer)) => return (calls, Some(answer)),
   00339|             _ => break,
   00340|         };
   00341|         let call = planned[0].clone();
   00342|         let arguments: serde_json::Value =
   00343|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00344|         calls.push(if call.tool == "bash" {
   00345|             arguments["command"].as_str().unwrap_or_default().to_owned()
   00346|         } else {
   00347|             call.tool.clone()
   00348|         });
   00349|         let result = if call.tool == "read" {
   00350|             BUGGY_MODULE
   00351|         } else {
   00352|             printed
   00353|         };
   00354|         let id = format!("e{step}");
   00355|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00356|             id.clone(),
   00357|             call.tool.clone(),
   00358|             call.arguments.clone(),
   00359|         )]));
   00360|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00361|     }
   00362|     (calls, None)
   00363| }
