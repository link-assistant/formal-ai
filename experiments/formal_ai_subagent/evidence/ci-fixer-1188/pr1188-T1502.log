   00084|         "Find all usages of add in this directory.",
   00085|         "Where is add used in this project?",
   00086|         "Search for add in the files of this directory.",
   00087|         "Grep for add.",
   00088|     ] {
   00089|         let (tool, arguments, answer) = search_once(prompt, &AGENT_CLI_TOOLS, GREP_HITS);
