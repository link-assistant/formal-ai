   00001| //! PR #1188 dogfooding (T90, gap G12): "Find all usages of add." searched the
   00002| //! web for the sentence, "Where is add used in this project?" grepped the
   00003| //! whole question, "Search for add in the files of this directory." listed
   00004| //! the directory and "Find all usages of add in this directory." looked for a
   00005| //! file named all-usages-of-add. Workspace content search now has its own
   00006| //! seeded vocabulary (`workspace_content_search_form`, every registered
   00007| //! language): the arm greps the named identifier or quoted literal -- the
   00008| //! client's grep tool when advertised, else `grep -rn` through the shell --
   00009| //! and answers with the file:line hits, or a seeded not-found naming the
   00010| //! pattern and the scope. Twin of
   00011| //! `rust/tests/web/pull-request-1188-workspace-search.test.mjs`.
   00012| 
   00013| use formal_ai::agentic_coding::{AgenticPlan, plan_chat_step};
   00014| use formal_ai::protocol::{ChatMessage, ToolCall};
   00015| 
   00016| const AGENT_CLI_TOOLS: [&str; 14] = [
   00017|     "bash",
   00018|     "batch",
   00019|     "codesearch",
   00020|     "edit",
   00021|     "glob",
   00022|     "grep",
   00023|     "list",
   00024|     "read",
   00025|     "task",
   00026|     "todoread",
   00027|     "todowrite",
   00028|     "webfetch",
   00029|     "websearch",
   00030|     "write",
   00031| ];
   00032| const REDUCED_TOOLS: [&str; 4] = ["read", "write", "edit", "bash"];
   00033| const GREP_HITS: &str = concat!(
   00034|     "Found 2 matches\n",
   00035|     "/work/demo/m.mjs:\n",
   00036|     "  Line 1: export function add(a, b) {\n",
   00037|     "\n",
   00038|     "/work/demo/m.test.mjs:\n",
   00039|     "  Line 6:   assert.strictEqual(add(1, 2), 3);",
   00040| );
   00041| const SHELL_HITS: &str =
   00042|     "./m.mjs:1:export function add(a, b) {\n./m.test.mjs:6:  assert.strictEqual(add(1, 2), 3);\n";
   00043| const LISTED: &str =
