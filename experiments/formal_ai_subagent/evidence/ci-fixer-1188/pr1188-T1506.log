   00042| /// Every stage of the served `What is 2 + 2?` turn: `(step, Rust emitter, JS emitter)`.
   00043| const TWO_PLUS_TWO: [(&str, &str, &str); 10] = [
   00044|     ("impulse", SOLVE_ENTRY, EVENT_LOG),
   00045|     ("detect_language", SOLVE_ENTRY, EVENT_LOG),
   00046|     ("formalize", INTENT_RECORD.0, INTENT_RECORD.1),
   00047|     ("compute", ARITHMETIC, CALCULATION_EVENTS),
   00048|     ("compute_engine", ARITHMETIC, CALCULATION_EVENTS),
   00049|     ("compute_expression", ARITHMETIC, CALCULATION_EVENTS),
   00050|     ("compute_steps", ARITHMETIC, CALCULATION_EVENTS),
   00051|     ("dispatch_handler", FINALIZE, EVENT_LOG),
   00052|     ("rule_verification", FINALIZE, EVENT_LOG),
   00053|     ("deformalize", FINALIZE, EVENT_LOG),
   00054| ];
