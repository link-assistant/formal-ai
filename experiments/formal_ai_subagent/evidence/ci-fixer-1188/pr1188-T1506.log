   00097| /// The repository the test runs in (`rust/` is the working directory).
   00098| fn repository() -> std::path::PathBuf {
   00099|     std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("..")
   00100| }
   00101| 
   00102| /// The located excerpt is the file's own text from the definition line on.
   00103| ///
   00104| /// A method's definition line is indented inside its `impl` block (the solve
   00105| /// entry `solve_with_history_probability_store_and_intent_cache` is one), so
   00106| /// the indentation is trimmed before the visibility, as the JavaScript twin's
   00107| /// unanchored `fn <symbol>(` pattern does.
   00108| fn assert_excerpt(source: &str, line: u64, excerpt: &str, definition: &str) {
   00109|     let file = source.rsplit_once(':').map_or(source, |(file, _)| file);
   00110|     let text = std::fs::read_to_string(repository().join(file)).expect("located file");
   00111|     let lines: Vec<&str> = text.split('\n').collect();
   00112|     let shown: Vec<&str> = excerpt.split('\n').collect();
   00113|     let start = usize::try_from(line).expect("line") - 1;
   00114|     assert!(
   00115|         lines[start]
   00116|             .trim_start()
   00117|             .trim_start_matches("pub(crate) ")
   00118|             .trim_start_matches("pub ")
   00119|             .trim_start_matches("export ")
   00120|             .starts_with(definition),
   00121|         "{}",
   00122|         lines[start]
   00123|     );
   00124|     assert_eq!(shown, lines[start..start + shown.len()]);
   00125|     assert!(shown.len() <= EXCERPT_LINES, "an excerpt is capped");
   00126| }
   00127| 
   00128| /// The text of a string field of an event, empty when absent.
   00129| fn text<'event>(event: &'event Value, field: &str) -> &'event str {
   00130|     event[field].as_str().unwrap_or("")
   00131| }
   00132| 
   00133| /// Every stage names its own emitters, located in the files they live in, and
   00134| /// the routed method stays a separate field (empty while nothing is routed).
   00135| fn assert_stage_sources(events: &[&Value], expected: &[(&str, &str, &str)]) {
   00136|     let named: Vec<(&str, &str, &str)> = events
   00137|         .iter()
   00138|         .map(|event| {
   00139|             (
   00140|                 text(event, "step"),
   00141|                 text(event, "rust_source"),
   00142|                 text(event, "js_source"),
   00143|             )
   00144|         })
   00145|         .collect();
   00146|     assert_eq!(named, expected);
   00147|     for event in events {
   00148|         for (runtime, keyword) in [("rust", "fn "), ("js", "function ")] {
   00149|             let source = text(event, &format!("{runtime}_source"));
   00150|             let symbol = source.rsplit_once(':').map_or("", |(_, symbol)| symbol);
   00151|             let line = event[format!("{runtime}_line")].as_u64().unwrap_or(0);
   00152|             let excerpt = text(event, &format!("{runtime}_excerpt"));
   00153|             assert_excerpt(source, line, excerpt, &format!("{keyword}{symbol}"));
   00154|         }
   00155|         let routed = text(event, "method") == "arithmetic";
   00156|         assert!(routed || text(event, "method").is_empty());
   00157|         assert_eq!(
   00158|             text(event, "method_rust_source"),
   00159|             if routed {
   00160|                 "rust/src/solver_dispatch.rs:handle_arithmetic"
   00161|             } else {
   00162|                 ""
   00163|             }
   00164|         );
   00165|         assert_eq!(
   00166|             text(event, "method_js_source"),
   00167|             if routed {
   00168|                 "js/worker/formal_ai_worker_arithmetic_and_numeric_lists.js:tryArithmetic"
   00169|             } else {
   00170|                 ""
   00171|             }
   00172|         );
   00173|     }
   00174| }
