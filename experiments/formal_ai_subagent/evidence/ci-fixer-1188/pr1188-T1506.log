   00630| /// The served route, end to end: a chat turn solved inside a connection scope
   00631| /// is held until its last stage is advanced through `POST /v1/debug/advance`.
   00632| #[test]
   00633| fn a_served_chat_turn_answers_only_after_its_last_stage() {
   00634|     let dir = std::env::temp_dir().join(format!("formal-ai-debug-session-{}", std::process::id()));
   00635|     let _ = std::fs::remove_dir_all(&dir);
   00636|     std::fs::create_dir_all(&dir).expect("temp dir");
   00637|     let memory = dir.join("memory.lino");
   00638|     let dialogs = dir.join("dialogs");
   00639|     temp_env::with_vars(
   00640|         [
   00641|             ("FORMAL_AI_MEMORY_PATH", Some(memory.as_os_str())),
   00642|             ("FORMAL_AI_DIALOG_LOG_DIR", Some(dialogs.as_os_str())),
   00643|             ("FORMAL_AI_RECORD_CHAT", Some(std::ffi::OsStr::new("0"))),
   00644|             (
   00645|                 "FORMAL_AI_DEBUG_SESSION_TOKEN",
   00646|                 Some(std::ffi::OsStr::new(TOKEN)),
   00647|             ),
   00648|         ],
   00649|         || {
   00650|             let session = enable_debug_session("127.0.0.1").expect("loopback");
   00651|             let auth = ApiAuthConfig::bearer_token(BEARER);
   00652|             let bearer = format!("Bearer {BEARER}");
   00653|             let headers = [("authorization", bearer.as_str())];
   00654|             let debug = |action: &str, body: &Value| {
   00655|                 handle_api_request_with_auth(
   00656|                     "POST",
   00657|                     &format!("/v1/debug/{action}"),
   00658|                     &headers,
   00659|                     &body.to_string(),
   00660|                     &auth,
   00661|                 )
   00662|             };
   00663|             // The record the turn's answer is persisted under, removed so the
   00664|             // held turn can be seen not to write it.
   00665|             let root = std::env::current_dir().expect("working directory");
   00666|             let record = store_path(&root, &formal_ai::solve("What is 2 + 2?").derivation_id())
   00667|                 .expect("record path");
   00668|             let _ = std::fs::remove_file(&record);
   00669|             assert_eq!(debug("pause", &json!({ "token": TOKEN })).status_code, 200);
   00670|             let chat = json!({
   00671|                 "model": "formal-ai",
   00672|                 "messages": [{ "role": "user", "content": "What is 2 + 2?" }],
   00673|             })
   00674|             .to_string();
   00675|             std::thread::scope(|scope| {
   00676|                 let answered = scope.spawn(|| {
   00677|                     with_connection_scope(
   00678|                         || true,
   00679|                         || {
   00680|                             handle_api_request_with_auth(
   00681|                                 "POST",
   00682|                                 "/v1/chat/completions",
   00683|                                 &headers,
   00684|                                 &chat,
   00685|                                 &auth,
   00686|                             )
   00687|                         },
   00688|                     )
   00689|                 });
   00690|                 // Stage 0 is truly suspended: only the prompt is known, the
   00691|                 // solver has not run, so nothing is routed yet.
   00692|                 let mut paused = paused_turn(session);
   00693|                 assert_eq!(
   00694|                     [
   00695|                         &paused["stage"],
   00696|                         &paused["stages"],
   00697|                         &paused["step"],
   00698|                         &paused["method"]
   00699|                     ],
   00700|                     [&json!(0), &json!(1), &json!("impulse"), &json!("")]
   00701|                 );
   00702|                 let first = json!({ "token": TOKEN, "turn": paused["turn"], "stage": 0 });
   00703|                 assert_eq!(debug("advance", &first).status_code, 200);
   00704|                 assert_eq!(debug("advance", &first).status_code, 409);
   00705|                 // Stages 1.. are revealed from the solved turn, held before it
   00706|                 // is persisted.
   00707|                 paused = paused_turn(session);
   00708|                 let total = paused["stages"].as_u64().expect("stage count");
   00709|                 assert_eq!(total, TWO_PLUS_TWO.len() as u64);
   00710|                 assert_eq!(paused["method"], "arithmetic");
