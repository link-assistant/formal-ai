   00191| /// Poll until a turn is paused, and return the paused entry.
   00192| fn paused_turn(session: &DebugSession) -> Value {
   00193|     for _ in 0..600 {
   00194|         let snapshot = session.snapshot(None);
   00195|         if let Some(paused) = snapshot["paused"]
   00196|             .as_array()
   00197|             .and_then(|paused| paused.first())
   00198|         {
   00199|             return paused.clone();
   00200|         }
   00201|         std::thread::sleep(Duration::from_millis(10));
   00202|     }
   00203|     panic!("no turn paused");
   00204| }
