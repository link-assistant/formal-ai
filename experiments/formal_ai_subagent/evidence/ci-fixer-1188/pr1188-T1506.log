   00757|             });
   00758|             let state = debug("session", &json!({ "token": TOKEN }));
   00759|             let snapshot: Value = serde_json::from_str(&state.body).expect("snapshot");
   00760|             let advanced: Vec<&Value> = snapshot["events"]
   00761|                 .as_array()
   00762|                 .expect("events")
