   00001| //! The step-through debug session (issue #667, R383).
   00002| //!
   00003| //! `serve --debug-session` binds loopback only, every debug request needs the
   00004| //! session token, a paused turn advances one stage per authenticated advance (a
   00005| //! repeated or stale advance answers 409 and records nothing), and a release or
   00006| //! a client disconnect never leaves a solve paused. Every stage event carries
   00007| //! the turn's recipe as Mermaid source with the stage highlighted, the
   00008| //! `path:symbol` locations, lines and excerpts of the code that emits that
   00009| //! stage in both runtimes (`rust/src/server/debug_stage_sources.rs` over the
   00010| //! generated `data/meta/debug-stage-sources.lino`), and the method-registry
   00011| //! method the turn's route resolves to with its handlers
   00012| //! (`rust/src/server/debug_stage.rs`); a held turn is neither persisted nor
   00013| //! answered. The JavaScript twin is
   00014| //! `rust/tests/web/server-debug-session.test.mjs`; the protocol is
   00015| //! `docs/vscode/debugger.md`.
   00016| 
   00017| use std::time::Duration;
   00018| 
   00019| use formal_ai::derivation::{answer_derivation_id, store_path};
   00020| use formal_ai::server::{
   00021|     DebugSession, DebugToken, EXCERPT_LINES, StageView, TurnView, debug_session_banner,
   00022|     describe_turn, enable_debug_session, handle_debug_request, is_loopback_host, stage_diagram,
   00023|     with_connection_scope,
   00024| };
   00025| use formal_ai::{ApiAuthConfig, ApiHttpResponse, ThinkingStep, handle_api_request_with_auth};
   00026| use serde_json::{Value, json};
   00027| 
   00028| const TOKEN: &str = "debug-session-test-token";
   00029| const BEARER: &str = "debug-session-bearer";
   00030| const SOLVE_ENTRY: &str =
   00031|     "rust/src/solver.rs:solve_with_history_probability_store_and_intent_cache";
   00032| const EVENT_LOG: &str = "js/worker/formal_ai_worker_solver_events.js:solverEventLog";
   00033| const ARITHMETIC: &str = "rust/src/solver_handlers/mod.rs:try_arithmetic";
   00034| const CALCULATION_EVENTS: &str =
   00035|     "js/worker/formal_ai_worker_solver_events.js:solverCalculationEvents";
   00036| const FINALIZE: &str = "rust/src/solver_handlers/mod.rs:finalize_simple";
   00037| const INTENT_RECORD: (&str, &str) = (
