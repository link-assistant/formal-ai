   00176| fn kinds(snapshot: &Value) -> Vec<String> {
   00177|     snapshot["events"]
   00178|         .as_array()
   00179|         .expect("events")
   00180|         .iter()
   00181|         .map(|event| {
   00182|             format!(
   00183|                 "{}:{}",
   00184|                 event["kind"].as_str().unwrap_or(""),
   00185|                 event["stage"]
   00186|             )
   00187|         })
   00188|         .collect()
   00189| }
