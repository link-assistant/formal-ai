   00328|         "function solverCalculationEvents(",
   00329|     );
   00330|     if let Some(fields) = paused.as_object_mut() {
   00331|         for field in ["js_excerpt", "js_line", "js_source"] {
   00332|             fields.remove(field);
   00333|         }
   00334|     }
   00335|     assert_eq!(
   00336|         paused,
   00337|         json!({
   00338|             "detail": "4", "id": "debug_event_3", "kind": "stage_paused", "method": "",
   00339|             "method_js_excerpt": "", "method_js_line": 0, "method_js_source": "",
   00340|             "method_rust_excerpt": "", "method_rust_line": 0, "method_rust_source": "",
   00341|             "mermaid": three_stage_diagram,
   00342|             "rust_excerpt": "", "rust_line": 0, "rust_source": "",
   00343|             "session": session.id(), "source": "calculation", "stage": 1,
   00344|             "stages": 3, "step": "compute", "turn": "turn_1",
   00345|         })
