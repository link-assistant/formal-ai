   00272| #[test]
   00273| fn each_advance_reveals_exactly_one_stage_and_a_repeat_records_nothing() {
   00274|     let session = session();
   00275|     session.pause();
   00276|     let stages = stages();
   00277|     std::thread::scope(|scope| {
   00278|         let held = scope.spawn(|| session.gate(&stages, &mut || true));
   00279|         let paused = paused_turn(&session);
   00280|         assert_eq!(paused["turn"], "turn_1");
   00281|         assert_eq!(paused["stage"], 0);
   00282|         assert!(!session.advance("turn_1", Some(1)), "stage 1 is not paused");
   00283|         assert!(!session.advance("turn_9", Some(0)), "an unknown turn");
   00284|         assert!(
   00285|             !session.advance("turn_1", None),
   00286|             "an advance names its stage"
   00287|         );
   00288|         assert!(session.advance("turn_1", Some(0)));
   00289|         assert!(!session.advance("turn_1", Some(0)), "stage 0 was advanced");
   00290|         assert!(session.advance("turn_1", Some(1)));
   00291|         assert!(!held.is_finished(), "held at the last stage");
   00292|         assert!(session.advance("turn_1", Some(2)));
   00293|         held.join().expect("the turn completes");
   00294|     });
   00295|     let snapshot = session.snapshot(None);
