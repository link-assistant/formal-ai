   00071| /// A turn routed to `arithmetic`, with a sub-stage under `compute`.
   00072| fn routed() -> Vec<ThinkingStep> {
   00073|     let compute = ThinkingStep::new(2, "compute", "2 + 2 = 4", "high", "calculation");
   00074|     let engine = ThinkingStep::new(
   00075|         3,
   00076|         "compute_engine",
   00077|         "link-calculator",
   00078|         "high",
   00079|         "calculation:engine",
   00080|     )
   00081|     .with_parent(compute.id.clone());
   00082|     vec![
   00083|         ThinkingStep::new(0, "impulse", "What is 2 + 2?", "high", "impulse"),
   00084|         ThinkingStep::new(
   00085|             1,
   00086|             "formalize",
   00087|             "arithmetic",
   00088|             "high",
   00089|             "intent_formalization:route",
   00090|         ),
   00091|         compute,
   00092|         engine,
   00093|         ThinkingStep::new(4, "deformalize", "2 + 2 = 4", "high", "response"),
   00094|     ]
