   00208| /// Report a change by naming it, not merely by naming the file it touched.
   00209| ///
   00210| /// [`render_seeded_outcome`] can only say *that* a path was written, because
   00211| /// `{path}` is all it substitutes. A caller who asked for the change and for a
   00212| /// record of it -- the issue #1028 ladder does, and its `verify-node.sh` demands
   00213| /// "at least four words that state the change you made" -- gets a status line
   00214| /// where the statement should be, and the record it verifies never mentions the
   00215| /// edit. A route that derived the new bytes already knows what it altered, so
   00216| /// the seed sentence takes that as further slots: which members went into a
   00217| /// list, or which name became which.
   00218| // `{path}` is replaced in seed-owned text rather than interpolated by Rust; so
   00219| // are the slots the caller names.
   00220| #[allow(clippy::literal_string_with_formatting_args)]
   00221| pub(super) fn render_seeded_change(
   00222|     intent: &str,
   00223|     task: &str,
   00224|     path: &str,
   00225|     slots: &[(&str, &str)],
   00226| ) -> Option<String> {
   00227|     let language = super::tool_result::response_language(task);
   00228|     let mut substitutions = vec![("{path}", path)];
   00229|     substitutions.extend_from_slice(slots);
   00230|     Some(render_template(
   00231|         seed::localized_response(intent, language)?,
   00232|         &substitutions,
   00233|     ))
   00234| }
   00235| 
   00236| /// Render an explicitly typed list slot; mirrors `renderSeededListChange`.
