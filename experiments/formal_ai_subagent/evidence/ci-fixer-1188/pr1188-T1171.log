   00324| fn requested_identifier(task: &str, path: &str, kind: RustItemKind) -> Option<String> {
   00325|     let normalized = task.to_lowercase();
   00326|     if kind != RustItemKind::Constant
   00327|         && let Some(name) = slot_identifier(&normalized, seed::ROLE_CODING_NAME_SLOT)
   00328|         && valid_identifier(&name)
   00329|     {
   00330|         return Some(name);
   00331|     }
   00332|     let without_path = task.replacen(path, "", 1);
   00333|     let mut candidates = identifier_tokens(&without_path)
   00334|         .filter(|candidate| valid_identifier(candidate))
   00335|         .collect::<Vec<_>>();
   00336|     if kind == RustItemKind::Constant {
   00337|         candidates.retain(|candidate| {
   00338|             candidate.chars().any(|character| character == '_')
   00339|                 && candidate
   00340|                     .chars()
   00341|                     .all(|character| character.is_ascii_uppercase() || character == '_')
   00342|         });
   00343|     } else {
   00344|         candidates.retain(|candidate| candidate.contains('_'));
   00345|     }
   00346|     candidates.into_iter().next().map(str::to_owned)
   00347| }
