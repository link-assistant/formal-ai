   00238|     intent: &str,
   00239|     task: &str,
   00240|     path: &str,
   00241|     slot: &str,
   00242|     values: &[String],
   00243| ) -> Option<String> {
   00244|     render_seeded_change_with_lists(intent, task, path, &[], &[(slot, values)])
   00245| }
   00246| 
   00247| /// Render scalar slots and explicitly typed lists without interpreting scalar text.
   00248| #[allow(clippy::literal_string_with_formatting_args)]
   00249| pub(super) fn render_seeded_change_with_lists(
   00250|     intent: &str,
   00251|     task: &str,
   00252|     path: &str,
   00253|     slots: &[(&str, &str)],
   00254|     lists: &[(&str, &[String])],
   00255| ) -> Option<String> {
   00256|     let language = super::tool_result::response_language(task);
   00257|     let mut template = seed::localized_response(intent, language)?.to_owned();
   00258|     for (slot, values) in lists {
   00259|         let rendered = values
   00260|             .iter()
   00261|             .map(|value| code_span_item(value))
   00262|             .collect::<Vec<_>>()
   00263|             .join(", ");
   00264|         template = template.replace(&format!("`{slot}`"), &rendered).replace(slot, &rendered);
   00265|     }
   00266|     let mut substitutions = vec![("{path}", path)];
   00267|     substitutions.extend_from_slice(slots);
   00268|     Some(render_template(&template, &substitutions))
   00269| }
