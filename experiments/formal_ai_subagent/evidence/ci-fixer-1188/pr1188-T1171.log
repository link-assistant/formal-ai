   00305| fn rust_path(task: &str) -> Option<String> {
   00306|     let end = task.find(".rs")?.checked_add(3)?;
   00307|     let start = task[..end]
   00308|         .char_indices()
   00309|         .rev()
   00310|         .take_while(|(_, character)| is_path_character(*character))
   00311|         .last()
   00312|         .map_or(0, |(index, _)| index);
   00313|     let path = task.get(start..end)?;
   00314|     (!path.is_empty()
   00315|         && !path.starts_with('/')
   00316|         && !path.split('/').any(|component| component == ".."))
   00317|     .then(|| path.to_owned())
   00318| }
   00319| 
   00320| const fn is_path_character(character: char) -> bool {
   00321|     character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00322| }
