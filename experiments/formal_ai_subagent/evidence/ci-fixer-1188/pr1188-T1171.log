   00349| fn slot_identifier(normalized: &str, role: &str) -> Option<String> {
   00350|     seed::lexicon()
   00351|         .role_word_forms(role)
   00352|         .into_iter()
   00353|         .find_map(|form| match form.slot() {
   00354|             Slot::Prefix => {
   00355|                 let prefix = form.before_slot().trim().to_lowercase();
   00356|                 let start = normalized.find(&prefix)?.checked_add(prefix.len())?;
   00357|                 identifier_tokens(normalized.get(start..)?)
   00358|                     .next()
   00359|                     .map(str::to_owned)
   00360|             }
   00361|             Slot::Suffix => {
   00362|                 let suffix = form.after_slot().trim().to_lowercase();
   00363|                 let end = normalized.find(&suffix)?;
   00364|                 identifier_tokens(normalized.get(..end)?)
   00365|                     .last()
   00366|                     .map(str::to_owned)
   00367|             }
   00368|             Slot::Circumfix => {
   00369|                 let before = form.before_slot().trim().to_lowercase();
   00370|                 let after = form.after_slot().trim().to_lowercase();
   00371|                 let start = normalized.find(&before)?.checked_add(before.len())?;
   00372|                 let remainder = normalized.get(start..)?;
   00373|                 let end = remainder.find(&after)?;
   00374|                 identifier_tokens(remainder.get(..end)?)
   00375|                     .next()
   00376|                     .map(str::to_owned)
   00377|             }
   00378|             Slot::Bare => None,
   00379|         })
   00380| }
   00381| 
   00382| fn identifier_tokens(text: &str) -> impl Iterator<Item = &str> {
   00383|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00384|         .filter(|token| !token.is_empty())
   00385| }
   00386| 
   00387| fn valid_identifier(identifier: &str) -> bool {
   00388|     let mut characters = identifier.chars();
   00389|     let Some(first) = characters.next() else {
   00390|         return false;
   00391|     };
   00392|     (first.is_ascii_alphabetic() || first == '_')
   00393|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00394|         && !seed::lexicon()
   00395|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00396|             .iter()
   00397|             .any(|reserved| reserved == identifier)
   00398| }
   00399| 
   00400| fn numeric_literals(text: &str) -> Vec<String> {
   00401|     let chars = text.char_indices().collect::<Vec<_>>();
   00402|     let mut values = Vec::new();
   00403|     let mut index = 0;
   00404|     while index < chars.len() {
   00405|         let (start, character) = chars[index];
   00406|         if !character.is_ascii_digit()
   00407|             || index
   00408|                 .checked_sub(1)
   00409|                 .is_some_and(|prior| chars[prior].1.is_ascii_alphabetic())
   00410|         {
   00411|             index += 1;
   00412|             continue;
   00413|         }
   00414|         let mut end_index = index + 1;
   00415|         while end_index < chars.len()
   00416|             && (chars[end_index].1.is_ascii_digit() || chars[end_index].1 == '.')
   00417|         {
   00418|             end_index += 1;
   00419|         }
   00420|         if end_index < chars.len() && chars[end_index].1.is_ascii_alphabetic() {
   00421|             index = end_index + 1;
   00422|             continue;
   00423|         }
   00424|         let end = chars
   00425|             .get(end_index)
   00426|             .map_or(text.len(), |(offset, _)| *offset);
   00427|         let value = text[start..end].trim_end_matches('.');
   00428|         if !value.is_empty() {
   00429|             values.push(value.to_owned());
   00430|         }
   00431|         index = end_index;
   00432|     }
   00433|     values
   00434| }
