   00271| /// A placeholder the seed sentence wraps in backticks becomes a `CommonMark`
   00272| /// code span: a value holding a backtick run gets a longer fence, padded when
   00273| /// it starts or ends with a backtick, so the inserted text reads back verbatim.
   00274| fn code_span_item(value: &str) -> String {
   00275|     let longest = value
   00276|         .split(|character| character != '`')
   00277|         .map(str::len)
   00278|         .max()
   00279|         .unwrap_or(0);
   00280|     if longest == 0 {
   00281|         return format!("`{value}`");
   00282|     }
   00283|     let fence = "`".repeat(longest + 1);
   00284|     let pad = if value.starts_with('`') || value.ends_with('`') {
   00285|         " "
   00286|     } else {
   00287|         ""
   00288|     };
   00289|     format!("{fence}{pad}{value}{pad}{fence}")
   00290| }
   00291| 
   00292| fn code_span(value: &str) -> String {
   00293|     code_span_item(value)
   00294| }
