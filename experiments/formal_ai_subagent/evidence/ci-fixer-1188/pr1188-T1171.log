   00031| pub(super) fn plan_generated_source_step(
   00032|     task: &str,
   00033|     messages: &[ChatMessage],
   00034|     tool_names: &[&str],
   00035| ) -> Option<AgenticPlan> {
   00036|     let task = unwrap_transport_quotes(task);
   00037|     // Issue #1096: "In the file src/x.rs, replace "A" with "B" ... keep it valid
   00038|     // Rust" is an edit of a tracked file, not a request to generate one. The
   00039|     // program-request cue ("valid Rust") made this path claim it, synthesise
   00040|     // its own artifact, and then verify the agent's correct edit against that
   00041|     // artifact -- seven ladder leaves failed on the resulting byte mismatch.
   00042|     // An edit request is recognised by the same reader the edit route uses, so
   00043|     // the two routes cannot disagree about what counts as one; this step
   00044|     // simply declines, and the edit step, later in the router, claims it.
   00045|     if super::general_planner::compose_edit_request(task).is_some() {
   00046|         return None;
   00047|     }
   00048|     let artifact = rust_source_for_task(task)?;
   00049|     let write_tool = tool_for(tool_names, Capability::Write)?;
   00050|     let latest_user = messages
   00051|         .iter()
   00052|         .rposition(|message| message.role.eq_ignore_ascii_case("user"))?;
   00053|     let current_turn = &messages[latest_user + 1..];
   00054| 
   00055|     if let Some(observed) = latest_result(current_turn, Capability::Run) {
   00056|         let outcome = if observed == artifact.content {
   00057|             "coding_workspace_effect_observed"
   00058|         } else {
   00059|             "coding_workspace_verification_failed"
   00060|         };
   00061|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00062|             outcome,
   00063|             task,
   00064|             &artifact.path,
   00065|         )?));
   00066|     }
   00067|     if latest_result(current_turn, Capability::Write).is_some() {
   00068|         return Some(match tool_for(tool_names, Capability::Run) {
   00069|             Some(run_tool) => plan_one(
   00070|                 run_tool,
   00071|                 json!({"command": format!("cat {}", artifact.path)}).to_string(),
   00072|             ),
   00073|             None => AgenticPlan::Final(render_seeded_outcome(
   00074|                 "coding_workspace_written_unverified",
   00075|                 task,
   00076|                 &artifact.path,
   00077|             )?),
   00078|         });
   00079|     }
   00080|     Some(plan_one(
   00081|         write_tool,
   00082|         write_arguments(&artifact.path, &artifact.content),
   00083|     ))
   00084| }
