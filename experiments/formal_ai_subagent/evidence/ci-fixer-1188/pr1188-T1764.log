   00261| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00262|     let mut words = Vec::new();
   00263|     let mut start = None;
   00264|     let mut quote = None;
   00265|     let mut escaped = false;
   00266|     for (index, character) in text.char_indices() {
   00267|         if start.is_none() && character.is_whitespace() {
   00268|             continue;
   00269|         }
   00270|         if start.is_none() {
   00271|             start = Some(index);
   00272|         }
   00273|         if escaped {
   00274|             escaped = false;
   00275|             continue;
   00276|         }
   00277|         if character == '\\' && quote != Some('\'') {
   00278|             escaped = true;
   00279|             continue;
   00280|         }
   00281|         if let Some(delimiter) = quote {
   00282|             if character == delimiter {
   00283|                 quote = None;
   00284|             }
   00285|             continue;
   00286|         }
   00287|         if character == '"' || character == '\'' {
   00288|             quote = Some(character);
   00289|             continue;
   00290|         }
   00291|         if character.is_whitespace() {
   00292|             words.push(&text[start.take()?..index]);
   00293|         } else if ";|&<>()`".contains(character) {
   00294|             return None;
   00295|         }
   00296|     }
   00297|     if quote.is_some() || escaped {
   00298|         return None;
   00299|     }
   00300|     if let Some(start) = start {
   00301|         words.push(&text[start..]);
   00302|     }
   00303|     Some(words)
   00304| }
