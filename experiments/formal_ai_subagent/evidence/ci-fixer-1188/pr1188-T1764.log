   00054| /// One mutating action expanded into the ordered steps that carry it out.
   00055| pub(super) struct VerifiedAction {
   00056|     /// Every step in order: preconditions, preparation, the action, postconditions.
   00057|     steps: Vec<String>,
   00058|     /// The index of the action itself within [`Self::steps`].
   00059|     action: usize,
   00060| }
