   00122|         groups.extend(
   00123|             operands
   00124|                 .iter()
   00125|                 .map(|path| vec![(PATH_PLACEHOLDER, (*path).to_owned())]),
   00126|         );
   00127|     } else {
   00128|         if operands.len() < 2 || (operands.len() > 2 && !effect.directory_targets) {
   00129|             return None;
   00130|         }
   00131|         let destination = *operands.last()?;
   00132|         let sources = &operands[..operands.len() - 1];
   00133|         if !effect.directory_targets && sources.iter().any(|source| has_shell_expansion(source)) {
   00134|             return None;
   00135|         }
   00136|         if effect.directory_targets
   00137|             && (sources.len() > 1
   00138|                 || sources.iter().any(|source| has_shell_expansion(source))
   00139|                 || destination.trim_matches(['\'', '"']).ends_with('/'))
   00140|         {
   00141|             collection = Some((sources.join(" "), destination));
   00142|             groups.push(vec![
   00143|                 (SOURCE_PLACEHOLDER, String::from("\"$formal_ai_source\"")),
   00144|                 (
   00145|                     DESTINATION_PARENT_PLACEHOLDER,
   00146|                     String::from("\"$formal_ai_parent\""),
   00147|                 ),
   00148|                 (
   00149|                     DESTINATION_PLACEHOLDER,
   00150|                     String::from("\"$formal_ai_destination\""),
   00151|                 ),
   00152|             ]);
   00153|         } else {
   00154|             groups.push(vec![
   00155|                 (SOURCE_PLACEHOLDER, sources[0].to_owned()),
   00156|                 (DESTINATION_PARENT_PLACEHOLDER, parent_of(destination)),
   00157|                 (DESTINATION_PLACEHOLDER, destination.to_owned()),
   00158|             ]);
   00159|         }
   00160|     }
   00161|     let fill = |template: &String| -> Vec<String> {
   00162|         groups
   00163|             .iter()
   00164|             .map(|bindings| {
   00165|                 let check = bind_template(template, bindings);
   00166|                 if let Some((sources, destination)) = &collection {
   00167|                     let setup = super::work_item_steps::fill(
   00168|                         "filesystem-collection-setup",
   00169|                         &[("{destination}", destination)],
   00170|                     );
   00171|                     super::work_item_steps::fill(
   00172|                         "filesystem-collection-check",
   00173|                         &[
   00174|                             ("{sources}", sources),
   00175|                             ("{setup}", &setup),
   00176|                             ("{check}", &check),
