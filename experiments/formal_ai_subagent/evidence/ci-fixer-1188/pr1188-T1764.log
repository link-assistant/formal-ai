   00333| /// The directory component of `path`, or `.` when it names no directory.
   00334| ///
   00335| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00336| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00337| /// happily hand back a `~` that the shell then declines to expand once it is no
   00338| /// longer the first character of the word.
   00339| fn parent_of(path: &str) -> String {
   00340|     if path.contains(['"', '\'', '\\']) {
   00341|         return format!("\"$(dirname -- {path})\"");
   00342|     }
   00343|     match path.rsplit_once('/') {
   00344|         Some(("", _)) => String::from("/"),
   00345|         Some((parent, _)) => parent.to_owned(),
   00346|         None => String::from(CURRENT_DIRECTORY),
   00347|     }
   00348| }
