   00387| /// The report for a recipe that stopped: which check stopped it, with what
   00388| /// status, and the fact that the action did not run.
   00389| ///
   00390| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00391| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00392| /// record of what a false completion claim costs; a recipe that names the check
   00393| /// it stopped on avoids both.
   00394| fn blocked_report(
   00395|     recipe: &VerifiedAction,
   00396|     check: &str,
   00397|     observed: &str,
   00398|     prompt: &str,
   00399|     attempted: bool,
   00400| ) -> String {
   00401|     let language = tool_result::response_language(prompt);
   00402|     let intent = if attempted {
   00403|         "mutating-action-observed-failure"
   00404|     } else {
   00405|         "mutating_action_blocked"
   00406|     };
   00407|     let Some(mut answer) = seed::localized_response(intent, language) else {
   00408|         return tool_result::render(check, observed, prompt);
   00409|     };
   00410|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00411|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00412|     answer = answer.replace(
   00413|         EXIT_CODE_PLACEHOLDER,
   00414|         &tool_result::reported_exit_code(observed)
   00415|             .map_or_else(String::new, |code| code.to_string()),
   00416|     );
   00417|     answer
   00418| }
   00419| 
   00420| /// The report for a recipe that finished: the action that ran, and the checks
   00421| /// that were observed to hold afterwards.
   00422| ///
   00423| /// The claim rests on those checks and names them, because a claim the reader
   00424| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00425| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00426|     let language = tool_result::response_language(prompt);
   00427|     let checks = recipe
   00428|         .postconditions()
   00429|         .iter()
   00430|         .map(|check| format!("`{check}`"))
   00431|         .collect::<Vec<_>>()
   00432|         .join(", ");
   00433|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00434|         || recipe.action().to_owned(),
   00435|         |answer| {
   00436|             answer
   00437|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00438|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00439|         },
   00440|     )
   00441| }
   00442| 
   00443| /// The ordered steps `command` is carried out as.
   00444| ///
   00445| /// `None` when no seed intent declares an effect for it — every read-only
   00446| /// intent, and every mutating one whose operands are not the source/destination
   00447| /// pair the effect is written against.
   00448| ///
   00449| /// Read-only intents keep their single-shot path, which is why this is the same
   00450| /// question the planner asks: a caller that wants to know whether a command is
   00451| /// carried out as a recipe asks for the recipe.
   00452| #[must_use]
   00453| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00454|     expand(command).map(|recipe| recipe.steps)
   00455| }
