   00306| fn has_shell_expansion(word: &str) -> bool {
   00307|     let mut quote = None;
   00308|     let mut escaped = false;
   00309|     for character in word.chars() {
   00310|         if escaped {
   00311|             escaped = false;
   00312|             continue;
   00313|         }
   00314|         if character == '\\' && quote != Some('\'') {
   00315|             escaped = true;
   00316|             continue;
   00317|         }
   00318|         if let Some(delimiter) = quote {
   00319|             if character == delimiter {
   00320|                 quote = None;
   00321|             }
   00322|             continue;
   00323|         }
   00324|         if character == '"' || character == '\'' {
   00325|             quote = Some(character);
   00326|         } else if "*?[$".contains(character) {
   00327|             return true;
   00328|         }
   00329|     }
   00330|     false
   00331| }
