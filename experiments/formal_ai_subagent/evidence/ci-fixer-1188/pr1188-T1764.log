   00350| /// Plan the next step of the verified recipe for `command`.
   00351| ///
   00352| /// Returns `None` when the command declares no effect (every read-only intent),
   00353| /// or when the client advertised no shell tool — in which case the caller's
   00354| /// single-shot path still produces the honest "I can run this when you give me a
   00355| /// shell" answer rather than this module inventing a second one.
   00356| pub(super) fn plan_step(
   00357|     command: &str,
   00358|     messages: &[ChatMessage],
   00359|     tool_names: &[&str],
   00360|     prompt: &str,
   00361| ) -> Option<AgenticPlan> {
   00362|     let recipe = expand(command)?;
   00363|     let tool = tool_for(tool_names, Capability::Run)?;
   00364|     let progress = Progress::scan(messages);
   00365|     let taken = progress.run_outputs.len();
   00366| 
   00367|     // The workspace gets the last word before anything else is planned: a step
   00368|     // that exited non-zero ends the recipe where it stopped.
   00369|     if let Some(index) = taken.checked_sub(1) {
   00370|         let observed = &progress.run_outputs[index];
   00371|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00372|             return Some(AgenticPlan::Final(blocked_report(
   00373|                 &recipe,
   00374|                 recipe.steps().get(index).map_or(command, String::as_str),
   00375|                 observed,
   00376|                 prompt,
   00377|                 index >= recipe.action,
   00378|             )));
   00379|         }
   00380|     }
   00381|     if let Some(step) = recipe.steps().get(taken) {
   00382|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00383|     }
   00384|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00385| }
