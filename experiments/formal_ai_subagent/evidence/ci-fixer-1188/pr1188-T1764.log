   00062| impl VerifiedAction {
   00063|     /// The steps in the order they are run.
   00064|     pub(super) fn steps(&self) -> &[String] {
   00065|         &self.steps
   00066|     }
   00067| 
   00068|     /// The mutating command itself, the one step that is not a check.
   00069|     pub(super) fn action(&self) -> &str {
   00070|         self.steps[self.action].as_str()
   00071|     }
   00072| 
   00073|     /// The checks that ran after the action, which is what the completion claim
   00074|     /// rests on.
   00075|     pub(super) fn postconditions(&self) -> &[String] {
   00076|         &self.steps[self.action + 1..]
