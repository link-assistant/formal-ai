   00210| /// Separate declared options from shell words while preserving operand quoting.
   00211| fn effect_operands<'a>(
   00212|     text: &'a str,
   00213|     effect: &seed::ShellIntentEffect,
   00214| ) -> Option<(Vec<&'a str>, Vec<String>)> {
   00215|     let words = shell_words(text)?;
   00216|     let mut operands = Vec::new();
   00217|     let mut flags = Vec::new();
   00218|     let mut options = true;
   00219|     let mut index = 0;
   00220|     while index < words.len() {
   00221|         let raw = words[index];
   00222|         let word = raw.trim_matches(['\'', '"']);
   00223|         if options && word == "--" {
   00224|             options = false;
   00225|         } else if options && word.starts_with('-') && word != "-" {
   00226|             if let Some(option) = effect.value_options.iter().find(|option| {
   00227|                 word == option.as_str()
   00228|                     || word.strip_prefix(option.as_str()).is_some_and(|suffix| {
   00229|                         suffix.starts_with('=') || (!option.starts_with("--") && !suffix.is_empty())
   00230|                     })
   00231|             }) {
   00232|                 if word == option.as_str() {
   00233|                     index += 1;
   00234|                     if index >= words.len() {
   00235|                         return None;
   00236|                     }
   00237|                 }
   00238|                 flags.push(option.clone());
   00239|             } else if effect.flags.iter().any(|flag| flag == word) {
   00240|                 flags.push(word.to_owned());
   00241|             } else if !word.starts_with("--") {
   00242|                 let bundled: Vec<String> = word[1..]
   00243|                     .chars()
   00244|                     .map(|letter| format!("-{letter}"))
   00245|                     .collect();
   00246|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) {
   00247|                     return None;
   00248|                 }
   00249|                 flags.extend(bundled);
   00250|             } else {
   00251|                 return None;
   00252|             }
   00253|         } else {
   00254|             operands.push(raw);
   00255|         }
   00256|         index += 1;
   00257|     }
   00258|     Some((operands, flags))
   00259| }
