   00149| #[derive(Debug, Clone, Default)]
   00150| pub struct ShellIntentVocabulary {
   00151|     /// Name-lead cue words (*called*, *named*, …), lowercased, pooled across
   00152|     /// languages.
   00153|     pub name_leads: Vec<String>,
   00154|     /// Natural-language glue ignored while recovering path and search operands.
   00155|     pub argument_noise: Vec<String>,
   00156|     /// Words a speaker inserts inside a cue phrase without changing it
   00157|     /// (*"show **me** git status"*), lowercased, pooled across languages.
   00158|     pub cue_fillers: Vec<String>,
