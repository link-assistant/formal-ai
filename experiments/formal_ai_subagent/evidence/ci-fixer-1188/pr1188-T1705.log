   00161|     /// Seed-defined portable command with root, predicate, and pattern slots.
   00162|     pub local_path_search_command_template: String,
   00163|     /// Verbs that ask to discover a path by name.
   00164|     pub local_path_search_actions: Vec<String>,
   00165|     /// Local filesystem scope phrases and the roots they map to.
   00166|     pub local_path_search_scopes: Vec<LocalPathSearchScope>,
   00167|     /// File/folder kind phrases and their `find` predicates.
   00168|     pub local_path_search_kinds: Vec<LocalPathSearchKind>,
   00169|     /// Workspace marker → test/install/build mappings in preference order.
   00170|     pub workspace_commands: Vec<WorkspaceCommands>,
