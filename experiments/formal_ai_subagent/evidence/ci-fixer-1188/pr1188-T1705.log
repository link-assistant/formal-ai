   00001| //! Semantic shell-intent vocabulary loaded from `data/seed/shell-intents.lino`
   00002| //! (issue #680).
   00003| //!
   00004| //! The terminal-command vocabulary in [`super::terminal_commands`] only reaches a
   00005| //! command when the prompt *names* it after a run verb (`run pwd`) or asks, in
   00006| //! prose, to list a directory. That leaves the common case the issue calls out —
   00007| //! *"Print the current working directory"*, *"How much disk space is free?"*,
   00008| //! *"What is my username?"* — unrouted: the user expresses an **intent** without
   00009| //! ever naming the command. This vocabulary maps each such intent to its concrete
   00010| //! command through multilingual cue phrases, so a request routes on meaning rather
   00011| //! than on the exact tool word.
   00012| //!
   00013| //! Like every other trigger vocabulary the natural language lives in seed data, not
   00014| //! in the planner, so a maintainer retunes coverage by editing a `.lino` file and
   00015| //! the project rule against hardcoded natural language in the solver is upheld. The
   00016| //! JavaScript worker loads the synced deployment copy through
   00017| //! `js/seed_loader.js`.
   00018| 
   00019| use super::SHELL_INTENTS_LINO;
   00020| use super::parser::{LinoNode, parse_lino};
   00021| 
   00022| /// How a matched intent recovers the command's argument from the prompt.
   00023| #[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
   00024| pub enum ShellIntentArgument {
   00025|     /// The command takes no argument (`pwd`, `whoami`, `df -h`).
   00026|     #[default]
   00027|     None,
   00028|     /// The command takes a file path recovered from a filename-looking token
   00029|     /// (`wc -l Cargo.toml`).
   00030|     Path,
   00031|     /// The command takes a name introduced by a name-lead cue such as
   00032|     /// *called*/*named* (`mkdir build`).
   00033|     NameLead,
   00034|     /// One path/name recovered from the request (`rm old.txt`).
   00035|     OnePath,
   00036|     /// Two path/name operands recovered in request order (`cp a.txt b.txt`).
   00037|     TwoPaths,
   00038|     /// The command takes the text after the matched intent cue (`rg QUERY .`).
   00039|     Remainder,
   00040|     /// A local-code search query, with local-scope words removed.
   00041|     SearchQuery,
   00042| }
   00043| 
   00044| /// The observable effect a mutating intent has on the filesystem, declared as
   00045| /// shell predicates rather than as branches in the planner (issues #824, #944).
   00046| ///
   00047| /// A command such as `mv` changes the workspace, so the interesting question is
   00048| /// not whether the process exited zero but whether the workspace now holds what
   00049| /// the request asked for. Each template is a `/bin/sh` predicate over the
   00050| /// operands: `{source}`, `{destination}`, and `{destination_parent}` (the
   00051| /// directory component of the destination, or `.` when it has none).
   00052| ///
   00053| /// The templates live here, in seed data, for the same reason every other
   00054| /// trigger vocabulary does: a maintainer teaches a new mutating verb its
   00055| /// pre/post conditions by editing a `.lino` file, and the planner keeps working
   00056| /// for verbs it has never heard of.
   00057| #[derive(Debug, Clone, Default)]
   00058| pub struct ShellIntentEffect {
   00059|     /// Predicates that must hold *before* the action runs, in order.
   00060|     pub before: Vec<String>,
   00061|     /// Commands that make the workspace ready for the action (`mkdir -p`).
   00062|     pub prepare: Vec<String>,
   00063|     /// Predicates that must hold *after* the action ran, in order.
   00064|     pub after: Vec<String>,
   00065| }
   00066| 
   00067| impl ShellIntentEffect {
   00068|     /// Whether this intent declared any effect at all. An intent with no
   00069|     /// declared effect is read-only as far as the planner is concerned.
   00070|     #[must_use]
   00071|     pub const fn is_declared(&self) -> bool {
   00072|         !self.before.is_empty() || !self.prepare.is_empty() || !self.after.is_empty()
   00073|     }
   00074| }
   00075| 
   00076| /// One intent → command mapping: the command to emit, how to fill its argument, and
   00077| /// the multilingual cue phrases (lowercased) that signal the intent.
   00078| #[derive(Debug, Clone, Default)]
   00079| pub struct ShellIntent {
   00080|     /// The concrete command to emit, e.g. `pwd`, `df -h`, `wc -l`.
   00081|     pub command: String,
   00082|     /// How the command's argument (if any) is recovered from the prompt.
   00083|     pub argument: ShellIntentArgument,
   00084|     /// Cue phrases, pooled across languages and lowercased for substring matching.
   00085|     pub cues: Vec<String>,
   00086|     /// The pre/post conditions this intent's command must satisfy, empty for the
   00087|     /// read-only intents that only report what they observe.
   00088|     pub effect: ShellIntentEffect,
   00089|     /// `destructive true`: the command destroys its operand (`rm`, `rmdir`), so
   00090|     /// it is never composed for a request about text inside a file.
   00091|     pub destructive: bool,
   00092| }
