   00309| /// Parse a single `intent` node into a [`ShellIntent`].
   00310| fn parse_intent(node: &LinoNode) -> ShellIntent {
   00311|     ShellIntent {
   00312|         command: node.find_child_value("command").to_owned(),
   00313|         argument: match node.find_child_value("argument") {
   00314|             "path" => ShellIntentArgument::Path,
   00315|             "name_lead" => ShellIntentArgument::NameLead,
   00316|             "one_path" => ShellIntentArgument::OnePath,
   00317|             "two_paths" => ShellIntentArgument::TwoPaths,
   00318|             "remainder" => ShellIntentArgument::Remainder,
   00319|             "search_query" => ShellIntentArgument::SearchQuery,
   00320|             _ => ShellIntentArgument::None,
   00321|         },
   00322|         cues: collect_language_values(node, "cue")
   00323|             .into_iter()
   00324|             .map(|cue| cue.to_lowercase())
   00325|             .collect(),
   00326|         effect: node
   00327|             .children
   00328|             .iter()
   00329|             .find(|child| child.name == "effect")
   00330|             .map(parse_intent_effect)
   00331|             .unwrap_or_default(),
   00332|         destructive: node.find_child_value("destructive") == "true",
   00333|     }
   00334| }
   00335| 
   00336| /// Read the ordered `before` / `prepare` / `after` templates of one `effect` block.
   00337| fn parse_intent_effect(node: &LinoNode) -> ShellIntentEffect {
   00338|     let templates = |name: &str| -> Vec<String> {
   00339|         node.children
   00340|             .iter()
   00341|             .filter(|child| child.name == name)
   00342|             .map(|child| child.id.clone())
   00343|             .collect()
   00344|     };
   00345|     ShellIntentEffect {
   00346|         before: templates("before"),
   00347|         prepare: templates("prepare"),
   00348|         after: templates("after"),
   00349|     }
   00350| }
   00351| 
   00352| /// Collect every `<child_name>` id nested under the `language` children of `group`,
   00353| /// pooled across all languages (intent detection is language-agnostic).
   00354| fn collect_language_values(group: &LinoNode, child_name: &str) -> Vec<String> {
   00355|     group
   00356|         .children
   00357|         .iter()
   00358|         .filter(|c| c.name == "language")
   00359|         .flat_map(|lang| {
   00360|             lang.children
   00361|                 .iter()
   00362|                 .filter(|c| c.name == child_name)
   00363|                 .map(|c| c.id.clone())
   00364|         })
   00365|         .collect()
   00366| }
