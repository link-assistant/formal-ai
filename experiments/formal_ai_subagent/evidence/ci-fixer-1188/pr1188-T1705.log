   00184| /// Parse `data/seed/shell-intents.lino` into the semantic shell-intent vocabulary.
   00185| #[must_use]
   00186| pub fn shell_intent_vocabulary() -> ShellIntentVocabulary {
   00187|     let tree = parse_lino(SHELL_INTENTS_LINO);
   00188|     let mut vocab = ShellIntentVocabulary::default();
   00189|     let Some(root) = tree.children.first() else {
   00190|         return vocab;
   00191|     };
   00192|     for group in &root.children {
   00193|         match group.name.as_str() {
   00194|             "name_leads" => vocab.name_leads = collect_language_values(group, "lead"),
   00195|             "argument_noise" => {
   00196|                 vocab.argument_noise = collect_language_values(group, "word");
   00197|             }
   00198|             "cue_fillers" => {
   00199|                 vocab.cue_fillers = collect_language_values(group, "word")
   00200|                     .into_iter()
   00201|                     .map(|word| word.to_lowercase())
   00202|                     .collect();
   00203|             }
   00204|             "local_search_scopes" => {
   00205|                 vocab.local_search_scopes = collect_language_values(group, "scope");
   00206|             }
   00207|             "local_path_search" => {
   00208|                 group
   00209|                     .find_child_value("command_template")
   00210|                     .clone_into(&mut vocab.local_path_search_command_template);
   00211|                 vocab.local_path_search_actions = group
   00212|                     .children
   00213|                     .iter()
   00214|                     .find(|child| child.name == "actions")
   00215|                     .map(|node| collect_language_values(node, "action"))
   00216|                     .unwrap_or_default();
   00217|                 vocab.local_path_search_scopes = group
   00218|                     .children
   00219|                     .iter()
   00220|                     .find(|child| child.name == "scopes")
   00221|                     .map(|node| {
   00222|                         node.children
   00223|                             .iter()
   00224|                             .filter(|child| child.name == "scope")
   00225|                             .map(|scope| LocalPathSearchScope {
   00226|                                 name: scope.id.clone(),
   00227|                                 root: scope.find_child_value("root").to_owned(),
   00228|                                 cues: collect_language_values(scope, "cue")
   00229|                                     .into_iter()
   00230|                                     .map(|cue| cue.to_lowercase())
   00231|                                     .collect(),
   00232|                             })
   00233|                             .collect()
   00234|                     })
   00235|                     .unwrap_or_default();
   00236|                 vocab.local_path_search_kinds = group
   00237|                     .children
   00238|                     .iter()
   00239|                     .find(|child| child.name == "kinds")
   00240|                     .map(|node| {
   00241|                         node.children
   00242|                             .iter()
   00243|                             .filter(|child| child.name == "kind")
   00244|                             .map(|kind| LocalPathSearchKind {
   00245|                                 predicate: kind.find_child_value("predicate").to_owned(),
   00246|                                 cues: collect_language_values(kind, "cue")
   00247|                                     .into_iter()
   00248|                                     .map(|cue| cue.to_lowercase())
   00249|                                     .collect(),
   00250|                             })
   00251|                             .collect()
   00252|                     })
   00253|                     .unwrap_or_default();
   00254|             }
   00255|             "workspace_commands" => {
   00256|                 vocab.workspace_commands = group
   00257|                     .children
   00258|                     .iter()
   00259|                     .filter(|child| child.name == "workspace")
   00260|                     .map(|node| WorkspaceCommands {
   00261|                         marker: node.find_child_value("marker").to_owned(),
   00262|                         test: node.find_child_value("test").to_owned(),
   00263|                         install: node.find_child_value("install").to_owned(),
   00264|                         build: node.find_child_value("build").to_owned(),
   00265|                     })
   00266|                     .collect();
   00267|             }
   00268|             "path_objects" => {
   00269|                 vocab.path_objects = collect_language_values(group, "object")
   00270|                     .into_iter()
   00271|                     .map(|object| object.to_lowercase())
   00272|                     .collect();
   00273|             }
   00274|             "directory_listing" => {
   00275|                 let part = |name: &str, child: &str| {
   00276|                     group
   00277|                         .children
   00278|                         .iter()
   00279|                         .find(|node| node.name == name)
   00280|                         .map(|node| {
   00281|                             collect_language_values(node, child)
   00282|                                 .into_iter()
   00283|                                 .map(|value| value.to_lowercase())
   00284|                                 .collect()
   00285|                         })
   00286|                         .unwrap_or_default()
   00287|                 };
   00288|                 vocab.directory_listing = DirectoryListingVocabulary {
   00289|                     verbs: part("verbs", "verb"),
   00290|                     questions: part("questions", "question"),
   00291|                     objects: part("objects", "object"),
   00292|                     scopes: part("scopes", "scope"),
   00293|                 };
   00294|             }
   00295|             "intents" => {
   00296|                 vocab.intents = group
   00297|                     .children
   00298|                     .iter()
   00299|                     .filter(|c| c.name == "intent")
   00300|                     .map(parse_intent)
   00301|                     .collect();
   00302|             }
   00303|             _ => {}
   00304|         }
   00305|     }
   00306|     vocab
   00307| }
