   00450| 
   00451| fn try_project_lookup_internal(
   00452|     prompt: &str,
   00453|     lookup_prompt: &str,
   00454|     log: &mut EventLog,
   00455|     promote_associative_repositories: bool,
   00456|     suppress_identity_route: bool,
   00457|     response_language: Option<&str>,
   00458| ) -> Option<SymbolicAnswer> {
   00459|     // A repository URL can be source material rather than the requested action.
   00460|     // Keep installation-guide/script transformations on their more specific
   00461|     // conversion path instead of treating the embedded clone URL as a lookup.
   00462|     if is_install_conversion_request(&lookup_prompt.to_lowercase()) {
   00463|         return None;
   00464|     }
   00465|     if is_text_url_extraction_prompt(lookup_prompt) {
   00466|         return None;
   00467|     }
   00468|     if let Some(repo) = repository_from_prompt(lookup_prompt) {
   00469|         if promote_associative_repositories
   00470|             && let Some(project) = promoted_project_by_repo(&repo.owner, &repo.name)
   00471|         {
   00472|             return Some(render_project_lookup(
   00473|                 prompt,
   00474|                 log,
   00475|                 project,
   00476|                 response_language,
   00477|             ));
   00478|         }
   00479|         return Some(render_generic_repository_lookup(
   00480|             prompt,
   00481|             log,
   00482|             Some(&repo),
   00483|             promote_associative_repositories,
   00484|             response_language,
   00485|         ));
   00486|     }
   00487|     if suppress_identity_route {
   00488|         return None;
   00489|     }
   00490| 
   00491|     let project = matched_project(lookup_prompt)?;
   00492|     if promote_associative_repositories && is_promoted_project(project) {
   00493|         return Some(render_project_lookup(
   00494|             prompt,
   00495|             log,
   00496|             project,
   00497|             response_language,
   00498|         ));
   00499|     }
   00500| 
   00501|     Some(render_generic_repository_lookup(
   00502|         prompt,
   00503|         log,
   00504|         None,
   00505|         promote_associative_repositories,
   00506|         response_language,
   00507|     ))
   00508| }
