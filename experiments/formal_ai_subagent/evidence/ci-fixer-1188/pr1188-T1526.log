   00273| /// Execute a recognized web-search request instead of describing one.
   00274| ///
   00275| /// Issue #1173 (E138) R2: this handler used to answer with the fixed
   00276| /// paragraph describing the browser demo's provider plan. It now runs the
   00277| /// executed search through the process source cache — captured sources
   00278| /// answer from their statements with citations, and anything else degrades
   00279| /// to the localized `web_search_unavailable` response. Live provider
   00280| /// fetches stay opt-in via `FORMAL_AI_LIVE_FETCH`, matching the combined
   00281| /// offline gate `solver_dispatch.rs` applies to its `web_search` route.
   00282| pub fn try_web_search(
   00283|     prompt: &str,
   00284|     normalized: &str,
   00285|     log: &mut EventLog,
   00286| ) -> Option<SymbolicAnswer> {
   00287|     let request = extract_web_search_request(prompt, normalized)?;
   00288|     // The native-handler table carries no runtime offline flag; the live-fetch
   00289|     // opt-in is applied inside `answer_web_search_query`.
   00290|     Some(answer_web_search_query(
   00291|         prompt,
   00292|         &request.query,
   00293|         request.kind,
   00294|         log,
   00295|         false,
   00296|     ))
   00297| }
