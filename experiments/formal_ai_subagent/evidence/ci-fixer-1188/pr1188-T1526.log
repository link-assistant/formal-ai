   00299| /// The web-search query the intent recogniser extracts from `prompt`, or [`None`]
   00300| /// when the prompt is not a web-search request.
   00301| ///
   00302| /// Exposes the *same* seed-backed recognition [`try_web_search`] uses, without
   00303| /// producing the descriptive answer, so the agentic planner (issue #687) can reuse
   00304| /// it to decide when to emit the client's web-search tool call instead of
   00305| /// re-deriving the intent independently.
   00306| pub fn detect_web_search_query(prompt: &str) -> Option<String> {
   00307|     let normalized = prompt.to_lowercase();
   00308|     extract_web_search_request(prompt, &normalized).map(|request| request.query)
   00309| }
