   00229| /// Match prompts that ask the assistant to navigate to or display a URL
   00230| /// without performing an HTTP request (e.g. `Navigate to github.com`,
   00231| /// `Go to github.com`, `Перейди на github.com`). The browser web app renders
   00232| /// an iframe preview only when CORS-readable frame-policy metadata does not
   00233| /// report blocking X-Frame-Options or CSP frame-ancestors headers.
   00234| pub fn try_url_navigate(
   00235|     prompt: &str,
   00236|     normalized: &str,
   00237|     log: &mut EventLog,
   00238| ) -> Option<SymbolicAnswer> {
   00239|     let url = extract_url_navigate_url(prompt, normalized)?;
   00240|     log.append("url_navigate:request", url.clone());
   00241|     log.append("url_preview:frame_policy_check", url.clone());
   00242|     log.append("url_preview:external_link", url.clone());
   00243|     // Issue #918: the wording is the seeded web_* responses the browser twin
   00244|     // (`tryUrlNavigate`, js/worker/formal_ai_worker_web_providers_and_wasm_calls.js) also renders.
   00245|     let body = format!(
   00246|         "{}\n\n{}",
   00247|         seed::render_response("web_open_in_new_tab", "en", &[("url", &url)]).unwrap_or_default(),
   00248|         seed::render_response("web_url_navigate_native_note", "en", &[]).unwrap_or_default(),
   00249|     );
   00250|     Some(finalize_simple(
   00251|         prompt,
   00252|         log,
   00253|         "url_navigate",
   00254|         "response:url_navigate",
   00255|         &body,
   00256|         0.95,
   00257|     ))
   00258| }
