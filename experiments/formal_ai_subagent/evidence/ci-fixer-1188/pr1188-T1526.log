   00072| fn answer_http_fetch_url(
   00073|     prompt: &str,
   00074|     url: &str,
   00075|     log: &mut EventLog,
   00076|     offline: bool,
   00077| ) -> SymbolicAnswer {
   00078|     if is_page_formalization_prompt(prompt, &normalize_prompt(prompt)) {
   00079|         let cache_root = crate::coding::synthesis_runtime::source_cache_root();
   00080|         let client =
   00081|             CachedSourceClient::new(&cache_root, CurlSourceTransport).with_online(!offline);
   00082|         return answer_page_formalization(prompt, url, log, &client);
   00083|     }
   00084|     log.append("http_fetch:request", url);
   00085|     if let Some(answer) = try_curated_http_fetch(prompt, url, log) {
   00086|         return answer;
   00087|     }
   00088|     if offline {
   00089|         log.append("policy:offline", url);
   00090|         let body = seed::response_for("lexeme_import_cache_miss_offline", "en")
   00091|             .unwrap_or_else(|| String::from("lexeme_import_cache_miss_offline"))
   00092|             .replace("{qid}", url);
   00093|         return finalize_simple(prompt, log, "http_fetch", "response:http_fetch", &body, 1.0);
   00094|     }
   00095|     let cache_dir =
   00096|         std::env::var("FORMAL_AI_SOURCE_CACHE_DIR").unwrap_or_else(|_| String::from("data"));
   00097|     let client = CachedSourceClient::new(cache_dir, CurlSourceTransport).with_online(true);
   00098|     let capture = match client.fetch(url) {
   00099|         Ok(capture) => capture,
   00100|         Err(error) => {
   00101|             log.append("error:fetch", error.to_string());
   00102|             let body = seed::response_for("lexeme_import_fetch_failed", "en")
   00103|                 .unwrap_or_else(|| String::from("lexeme_import_fetch_failed"))
   00104|                 .replace("{qid}", url)
   00105|                 .replace(&["{", "error", "}"].concat(), &error.to_string());
   00106|             return finalize_simple(
   00107|                 prompt,
   00108|                 log,
   00109|                 "http_fetch",
   00110|                 "response:http_fetch_failed",
   00111|                 &body,
   00112|                 0.0,
   00113|             );
   00114|         }
   00115|     };
   00116|     capture.record(log);
   00117|     let body = String::from_utf8_lossy(capture.bytes())
   00118|         .chars()
   00119|         .take(8_000)
   00120|         .collect::<String>();
   00121|     finalize_simple(prompt, log, "http_fetch", "response:http_fetch", &body, 1.0)
   00122| }
