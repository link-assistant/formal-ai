   00382| /// Lookup repository/project prompts. Runs *after* `concept_lookup` so
   00383| /// seed-backed concept terms (`Links Notation`, `Wikipedia`, `Rust`, …) keep
   00384| /// their existing intent.
   00385| ///
   00386| /// With promotion enabled (the default), known projects from Link Assistant,
   00387| /// Link Foundation, and `LinksPlatform` are listed first. With promotion
   00388| /// disabled, the same prompts stay on the generic repository lookup path.
   00389| pub fn try_project_lookup(
   00390|     prompt: &str,
   00391|     _normalized: &str,
   00392|     log: &mut EventLog,
   00393|     promote_associative_repositories: bool,
   00394|     suppress_identity_route: bool,
   00395| ) -> Option<SymbolicAnswer> {
   00396|     try_project_lookup_internal(
   00397|         prompt,
   00398|         prompt,
   00399|         log,
   00400|         promote_associative_repositories,
   00401|         suppress_identity_route,
   00402|         None,
   00403|     )
   00404| }
   00405| 
   00406| pub fn try_explicit_repository_lookup(
   00407|     prompt: &str,
   00408|     normalized: &str,
   00409|     log: &mut EventLog,
   00410|     promote_associative_repositories: bool,
   00411|     suppress_identity_route: bool,
   00412|     response_language: Option<&str>,
   00413| ) -> Option<SymbolicAnswer> {
   00414|     if is_text_url_extraction_prompt(normalized) {
   00415|         return None;
   00416|     }
   00417|     if extract_http_fetch_url(prompt, normalized).is_some()
   00418|         || extract_url_navigate_url(prompt, normalized).is_some()
   00419|     {
   00420|         return None;
   00421|     }
   00422|     repository_from_prompt(prompt)?;
   00423|     try_project_lookup_internal(
   00424|         prompt,
   00425|         prompt,
   00426|         log,
   00427|         promote_associative_repositories,
   00428|         suppress_identity_route,
   00429|         response_language,
   00430|     )
   00431| }
