   00711| /// Match the concept term against the curated project registry. Returns the
   00712| /// matching [`ProjectRecord`] or `None` when no curated project matches.
   00713| fn matched_project(prompt: &str) -> Option<&'static ProjectRecord> {
   00714|     let query = extract_concept_query(prompt)?;
   00715|     let term = normalize_concept_term(&query.term);
   00716|     if term.is_empty() {
   00717|         return None;
   00718|     }
   00719|     let registry = registry_static();
   00720|     if let Some(project) = registry.by_alias(&term) {
   00721|         return Some(project);
   00722|     }
   00723|     if term == "hivemind" {
   00724|         return registry.by_alias("hive mind");
   00725|     }
   00726|     None
   00727| }
   00728| 
   00729| fn promoted_project_by_repo(org: &str, name: &str) -> Option<&'static ProjectRecord> {
   00730|     let registry = registry_static();
   00731|     registry.projects.iter().find(|project| {
   00732|         is_promoted_project(project)
   00733|             && project.org.eq_ignore_ascii_case(org)
   00734|             && project.name.eq_ignore_ascii_case(name)
   00735|     })
   00736| }
   00737| 
   00738| fn is_promoted_project(project: &ProjectRecord) -> bool {
   00739|     PROMOTED_PROJECT_ORGS
   00740|         .iter()
   00741|         .any(|org| project.org.eq_ignore_ascii_case(org))
   00742| }
   00743| 
   00744| fn repository_from_prompt(prompt: &str) -> Option<RepositoryReference> {
   00745|     first_url_candidate(prompt)
   00746|         .and_then(|(_, url)| repository_from_url(&url))
   00747|         .or_else(|| repository_from_concept_term(prompt))
   00748| }
   00749| 
   00750| fn repository_from_concept_term(prompt: &str) -> Option<RepositoryReference> {
   00751|     let query = extract_concept_query(prompt)?;
   00752|     let term = query.term.trim();
   00753|     if term.contains("://") || looks_like_hostname(term) {
   00754|         return normalize_url_candidate(term).and_then(|url| repository_from_url(&url));
   00755|     }
   00756|     repository_from_slug(term)
   00757| }
   00758| 
   00759| fn repository_from_slug(term: &str) -> Option<RepositoryReference> {
   00760|     let trimmed = term
   00761|         .trim()
   00762|         .trim_matches(is_url_wrapper_punctuation)
   00763|         .trim_end_matches(is_url_trailing_punctuation);
   00764|     let mut segments = trimmed.split('/');
   00765|     let owner = clean_repository_segment(segments.next()?)?;
   00766|     let name = clean_repository_segment(segments.next()?)?;
   00767|     if segments.next().is_some() {
   00768|         return None;
   00769|     }
   00770|     if owner.chars().all(|ch| ch.is_ascii_digit()) && name.chars().all(|ch| ch.is_ascii_digit()) {
   00771|         return None;
   00772|     }
   00773|     Some(RepositoryReference {
   00774|         platform: RepositoryPlatform::GitHub,
   00775|         url: format!("https://github.com/{owner}/{name}"),
   00776|         owner,
   00777|         name,
   00778|     })
   00779| }
   00780| 
   00781| fn repository_from_url(url: &str) -> Option<RepositoryReference> {
   00782|     let after_scheme = url.split_once("://")?.1;
   00783|     let (host_port, path_with_suffix) = after_scheme.split_once('/')?;
   00784|     let host = host_port
   00785|         .split(':')
   00786|         .next()
   00787|         .unwrap_or_default()
   00788|         .trim_start_matches("www.")
   00789|         .to_ascii_lowercase();
   00790|     let platform = match host.as_str() {
   00791|         "github.com" => RepositoryPlatform::GitHub,
   00792|         "gitlab.com" => RepositoryPlatform::GitLab,
   00793|         "bitbucket.org" => RepositoryPlatform::Bitbucket,
   00794|         _ => return None,
   00795|     };
   00796|     let path = path_with_suffix
   00797|         .split(['?', '#'])
   00798|         .next()
   00799|         .unwrap_or_default();
   00800|     let mut segments = path.split('/').filter(|segment| !segment.is_empty());
   00801|     let owner = clean_repository_segment(segments.next()?)?;
   00802|     let name = clean_repository_segment(segments.next()?)?;
   00803|     Some(RepositoryReference {
   00804|         platform,
   00805|         url: format!("https://{}/{owner}/{name}", platform.host()),
   00806|         owner,
   00807|         name,
   00808|     })
   00809| }
   00810| 
   00811| /// Owner/name slugs a prompt names: a GitHub URL's owner and name, then each
   00812| /// bare `owner/name` run of the characters a repository slug is spelled with.
   00813| ///
   00814| /// Issue #1175 R3: the repository a traffic question names. Twin of
   00815| /// `repositorySlugCandidates` in `js/worker/formal_ai_worker_claim_operands.js`.
   00816| #[must_use]
   00817| pub fn repository_slug_candidates(prompt: &str) -> Vec<String> {
   00818|     let mut slugs = Vec::new();
   00819|     if let Some(repo) = first_url_candidate(prompt).and_then(|(_, url)| repository_from_url(&url))
   00820|         && repo.platform == RepositoryPlatform::GitHub
   00821|     {
   00822|         slugs.push(format!("{}/{}", repo.owner, repo.name));
   00823|     }
   00824|     let leads = |segment: &str| {
   00825|         segment
   00826|             .chars()
   00827|             .next()
   00828|             .is_some_and(|ch| ch.is_ascii_alphanumeric())
   00829|     };
   00830|     let digits = |segment: &str| segment.chars().all(|ch| ch.is_ascii_digit());
   00831|     for run in prompt
   00832|         .split(|ch: char| !(ch.is_ascii_alphanumeric() || matches!(ch, '.' | '_' | '/' | '-')))
   00833|     {
   00834|         let mut parts = run.trim_end_matches('.').split('/');
   00835|         let (Some(owner), Some(name), None) = (parts.next(), parts.next(), parts.next()) else {
   00836|             continue;
   00837|         };
   00838|         let (Some(owner), Some(name)) = (
   00839|             clean_repository_segment(owner),
   00840|             clean_repository_segment(name),
   00841|         ) else {
   00842|             continue;
   00843|         };
   00844|         if leads(&owner) && leads(&name) && !(digits(&owner) && digits(&name)) {
   00845|             slugs.push(format!("{owner}/{name}"));
   00846|         }
   00847|     }
   00848|     slugs
   00849| }
   00850| 
   00851| fn clean_repository_segment(segment: &str) -> Option<String> {
   00852|     let trimmed = segment.trim().trim_end_matches(".git");
   00853|     if trimmed.is_empty() {
   00854|         return None;
   00855|     }
   00856|     if !trimmed
   00857|         .chars()
   00858|         .all(|ch| ch.is_ascii_alphanumeric() || matches!(ch, '-' | '_' | '.'))
   00859|     {
   00860|         return None;
   00861|     }
   00862|     Some(trimmed.to_owned())
   00863| }
   00864| 
   00865| fn is_text_url_extraction_prompt(normalized: &str) -> bool {
   00866|     let normalized = normalized.trim_start().to_ascii_lowercase();
   00867|     (normalized.starts_with("extract url ") || normalized.starts_with("extract urls "))
   00868|         && normalized.contains(" from ")
   00869| }
   00870| 
   00871| fn normalize_concept_term(value: &str) -> String {
   00872|     normalize_prompt(value)
   00873|         .replace(['-', '_'], " ")
   00874|         .split_whitespace()
   00875|         .collect::<Vec<_>>()
   00876|         .join(" ")
   00877| }
   00878| 
   00879| /// Lazy-init the curated projects registry once per process. The seed file is
   00880| /// embedded via `include_str!` and the parsed form is immutable, so a `OnceLock`
   00881| /// is enough and avoids re-parsing on every prompt.
   00882| pub(super) fn registry_static() -> &'static crate::seed::ProjectsRegistry {
   00883|     use std::sync::OnceLock;
   00884|     static REGISTRY: OnceLock<crate::seed::ProjectsRegistry> = OnceLock::new();
   00885|     REGISTRY.get_or_init(projects_registry)
   00886| }
