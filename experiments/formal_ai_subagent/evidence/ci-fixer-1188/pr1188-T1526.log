   00311| /// Execute the web search for `query` and answer from it.
   00312| ///
   00313| /// Issue #1173 (E138): this function used to build the descriptive paragraph
   00314| /// about the browser demo's search machinery ("Web search requested for
   00315| /// `…`" and its latest-news, research, and Russian arms), which stood as the
   00316| /// final answer for every prompt the intent recogniser or the
   00317| /// unknown-reasoning fallback handed it. The description is deleted as an
   00318| /// answer surface: the search now executes through the process source cache
   00319| /// (issue #709 fusion) and answers from the captured statements with
   00320| /// citations, or — offline or on a cache miss — with the localized
   00321| /// `web_search_unavailable` response that names the query.
   00322| ///
   00323| /// `runtime_offline` is the caller's own offline mode; the
   00324| /// `FORMAL_AI_LIVE_FETCH` opt-in is applied here so every caller gets the
   00325| /// combined offline gate `solver_dispatch.rs` uses at its `web_search` call
   00326| /// site.
   00327| pub fn answer_web_search_query(
   00328|     prompt: &str,
   00329|     query: &str,
   00330|     query_kind: WebSearchQueryKind,
   00331|     log: &mut EventLog,
   00332|     runtime_offline: bool,
   00333| ) -> SymbolicAnswer {
   00334|     let cache_dir =
   00335|         std::env::var("FORMAL_AI_SOURCE_CACHE_DIR").unwrap_or_else(|_| String::from("data"));
   00336|     let client = CachedSourceClient::new(cache_dir, CurlSourceTransport)
   00337|         .with_online(!runtime_offline && live_search::live_fetch_enabled());
   00338|     live_search::execute_web_search_answer(prompt, query, query_kind, log, &client)
   00339| }
