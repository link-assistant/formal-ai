   00124| /// Formalize the page a request names through `client` (R1188-U18).
   00125| ///
   00126| /// The cache answers first, and the network only when the client is
   00127| /// online. Returns `None` when the request names no URL or does not ask for
   00128| /// a formalization. The browser twin is `tryPageFormalization` in
   00129| /// `js/worker/formal_ai_worker_page_formalization.js`.
   00130| pub fn try_page_formalization_with_client<T: SourceTransport>(
   00131|     prompt: &str,
   00132|     log: &mut EventLog,
   00133|     client: &CachedSourceClient<T>,
   00134| ) -> Option<SymbolicAnswer> {
   00135|     let normalized = normalize_prompt(prompt);
   00136|     let url = extract_http_fetch_url(prompt, &normalized)?;
   00137|     is_page_formalization_prompt(prompt, &normalized)
   00138|         .then(|| answer_page_formalization(prompt, &url, log, client))
   00139| }
   00140| 
   00141| /// The statements of the page at `url`, in the request's language: the
   00142| /// page's prose ([`crate::web_formalize::page_prose`]) read by
   00143| /// [`crate::formalization::page::formalize_page`] in the page's language.
   00144| /// Offline with no cached capture, or when the fetch fails, the answer says
   00145| /// so and nothing is formalized.
   00146| fn answer_page_formalization<T: SourceTransport>(
   00147|     prompt: &str,
   00148|     url: &str,
   00149|     log: &mut EventLog,
   00150|     client: &CachedSourceClient<T>,
   00151| ) -> SymbolicAnswer {
   00152|     log.append("page_formalization:request", url);
   00153|     let language = detect_language(prompt).slug();
   00154|     let capture = match client.fetch(url) {
   00155|         Ok(capture) => capture,
   00156|         Err(error) => {
   00157|             log.append("error:fetch", error.to_string());
   00158|             let reason = error.to_string();
   00159|             let body = if matches!(error, FetchError::OfflineCacheMiss(_)) {
   00160|                 seed::render_response("page_formalization_offline", language, &[("url", url)])
   00161|             } else {
   00162|                 seed::render_response(
   00163|                     "page_formalization_fetch_failed",
   00164|                     language,
   00165|                     &[("url", url), ("error", &reason)],
   00166|                 )
   00167|             };
   00168|             return finalize_simple(
   00169|                 prompt,
   00170|                 log,
   00171|                 "page_formalization",
   00172|                 "response:page_formalization_unavailable",
   00173|                 &body.unwrap_or_default(),
   00174|                 0.0,
   00175|             );
   00176|         }
   00177|     };
   00178|     capture.record(log);
   00179|     let prose = crate::web_formalize::page_prose(capture.bytes(), url);
   00180|     let report = formalize_page(&prose, detect_language(&prose).slug());
   00181|     let counts = [
   00182|         report.sentences.len(),
   00183|         report.statements,
   00184|         report.covered,
   00185|         report.terms,
   00186|         report.unknown,
   00187|     ]
   00188|     .map(|count| count.to_string());
   00189|     log.append_fields(
   00190|         "page_formalization:report",
   00191|         &[
   00192|             ("sentences", &counts[0]),
   00193|             ("statements", &counts[1]),
   00194|             ("covered", &counts[2]),
   00195|             ("terms", &counts[3]),
   00196|             ("unknown", &counts[4]),
   00197|         ],
   00198|     );
   00199|     let body = page_answer(&report, url, language);
   00200|     finalize_simple(
   00201|         prompt,
   00202|         log,
   00203|         "page_formalization",
   00204|         "response:page_formalization",
   00205|         &body,
   00206|         0.9,
   00207|     )
   00208| }
