   00031| /// Match prompts that explicitly ask the engine to perform an HTTP request
   00032| /// (e.g. `fetch google.com`, `Сделай запрос к google.com`). In the browser
   00033| /// web app the actual `fetch()` is attempted first, with an iframe fallback when
   00034| /// CORS blocks the request only after target frame-policy headers have been
   00035| /// checked. Non-fetch URL prompts (`Navigate to github.com`, `Visit github.com`,
   00036| /// ...) are handled by [`try_url_navigate`] instead.
   00037| pub fn try_http_fetch(
   00038|     prompt: &str,
   00039|     normalized: &str,
   00040|     log: &mut EventLog,
   00041| ) -> Option<SymbolicAnswer> {
   00042|     try_http_fetch_with_offline(prompt, normalized, log, true)
   00043| }
   00044| 
   00045| /// Execute an explicit HTTP request when the caller has opted out of offline
   00046| /// mode. A failed request records an error, never source provenance.
   00047| pub fn try_http_fetch_with_offline(
   00048|     prompt: &str,
   00049|     normalized: &str,
   00050|     log: &mut EventLog,
   00051|     offline: bool,
   00052| ) -> Option<SymbolicAnswer> {
   00053|     let url = extract_http_fetch_url(prompt, normalized)?;
   00054|     Some(answer_http_fetch_url(prompt, &url, log, offline))
   00055| }
   00056| 
   00057| /// Execute the URL selected by the shared object/act/locus capability table.
   00058| ///
   00059| /// Unlike [`try_http_fetch_with_offline`], this entry point does not ask a
   00060| /// second verb recognizer whether the already-routed request really meant
   00061| /// fetch.  The URL remains structural and is parsed from the original prompt;
   00062| /// all execution, cache, provenance, and offline behaviour is the same.
   00063| pub fn try_routed_http_fetch_with_offline(
   00064|     prompt: &str,
   00065|     log: &mut EventLog,
   00066|     offline: bool,
   00067| ) -> Option<SymbolicAnswer> {
   00068|     let url = crate::capability_routing::first_url(prompt)?;
   00069|     Some(answer_http_fetch_url(prompt, &url, log, offline))
   00070| }
