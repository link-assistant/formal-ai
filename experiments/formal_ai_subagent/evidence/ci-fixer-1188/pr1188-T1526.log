   00702| fn append_repository_evidence(log: &mut EventLog, platform: RepositoryPlatform, slug: String) {
   00703|     let kind = match platform {
   00704|         RepositoryPlatform::GitHub => "project_lookup:repository:github",
   00705|         RepositoryPlatform::GitLab => "project_lookup:repository:gitlab",
   00706|         RepositoryPlatform::Bitbucket => "project_lookup:repository:bitbucket",
   00707|     };
   00708|     log.append(kind, slug);
   00709| }
