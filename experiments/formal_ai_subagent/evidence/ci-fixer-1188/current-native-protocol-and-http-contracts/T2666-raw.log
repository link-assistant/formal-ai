   00036| #[test]
   00037| fn repeated_event_sequences_become_a_validated_parameterized_algorithm() {
   00038|     let run = discover_algorithms(&[
   00039|         trace("run-alpha", "alpha", "json"),
   00040|         trace("run-beta", "beta", "json"),
   00041|         trace("run-gamma", "gamma", "json"),
   00042|     ]);
   00043| 
   00044|     assert!(run.associative_compression_lossless);
   00045|     assert!(run.associative_compression_steps > 0);
   00046|     let candidates = run.validated_candidates();
   00047|     assert_eq!(candidates.len(), 1, "{}", run.links_notation());
   00048|     let candidate = candidates[0];
   00049|     assert_eq!(candidate.steps.len(), 3);
   00050|     assert_eq!(candidate.support_trace_ids, ["run-alpha", "run-beta"]);
   00051|     assert_eq!(candidate.held_out.len(), 1);
   00052|     assert!(candidate.held_out[0].passed);
   00053| 
   00054|     let fetch_subject = &candidate.steps[0].arguments["subject"];
   00055|     let normalize_subject = &candidate.steps[1].arguments["subject"];
   00056|     assert_eq!(fetch_subject, normalize_subject);
   00057|     assert!(matches!(fetch_subject, ArgumentPattern::Parameter(_)));
   00058|     assert_eq!(
   00059|         candidate.steps[1].arguments["format"],
   00060|         ArgumentPattern::Constant(String::from("json"))
   00061|     );
   00062| 
   00063|     let document = run.links_notation();
   00064|     assert!(document.contains("mode \"proposal_only\""));
   00065|     assert!(document.contains("human_gated \"true\""));
   00066|     assert!(document.contains("associative_compression_lossless \"true\""));
   00067| }
