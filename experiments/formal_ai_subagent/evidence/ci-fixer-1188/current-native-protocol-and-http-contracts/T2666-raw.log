   00025| fn trace(id: &str, subject: &str, format: &str) -> ExecutionTrace {
   00026|     ExecutionTrace::new(
   00027|         id,
   00028|         vec![
   00029|             step("fetch", &[("subject", subject)]),
   00030|             step("normalize", &[("subject", subject), ("format", format)]),
   00031|             step("persist", &[("subject", subject)]),
   00032|         ],
   00033|     )
   00034| }
