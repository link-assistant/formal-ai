   00328| #[derive(Default)]
   00329| struct RecordingHost {
   00330|     operations: Vec<(String, BTreeMap<String, String>)>,
   00331| }
   00332| 
   00333| impl AlgorithmHost for RecordingHost {
   00334|     fn perform(
   00335|         &mut self,
   00336|         operation: &str,
   00337|         arguments: &BTreeMap<String, String>,
   00338|         input: &str,
   00339|     ) -> Result<String, String> {
   00340|         self.operations
   00341|             .push((operation.to_owned(), arguments.clone()));
   00342|         Ok(format!("{operation}({input})"))
   00343|     }
   00344| }
