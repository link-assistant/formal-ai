   00522| /// Render a command result the way an agentic CLI would surface it: stdout on
   00523| /// success, an annotated error otherwise (so the agent can "understand errors").
   00524| fn format_command_result(result: &AgentCommandResult) -> String {
   00525|     if result.timed_out {
   00526|         return format!("command timed out: {}", result.command);
   00527|     }
   00528|     match result.status_code {
   00529|         Some(0) => result.stdout.clone(),
   00530|         Some(code) => format!(
   00531|             "command exited with status {code}\nstdout:\n{}\nstderr:\n{}",
   00532|             result.stdout, result.stderr
   00533|         ),
   00534|         None => format!(
   00535|             "command terminated without an exit status\nstderr:\n{}",
   00536|             result.stderr
   00537|         ),
   00538|     }
   00539| }
