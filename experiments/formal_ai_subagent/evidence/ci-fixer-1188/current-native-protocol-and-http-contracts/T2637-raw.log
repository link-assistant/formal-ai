   00350| /// The read-only half of the translate tool: the result text is the rendered
   00351| /// target itself (the CLI's stdout mode), and every honest gap renders from
   00352| /// the same seed intents the write half uses.
   00353| fn translate_without_write(
   00354|     from: crate::meta_translate::SourceRoot,
   00355|     to: crate::meta_translate::SourceRoot,
   00356|     root: &std::path::Path,
   00357|     repo_relative: &str,
   00358| ) -> (String, bool) {
   00359|     use crate::meta_translate::TranslationOutcome;
   00360|     let report = match std::fs::read_to_string(root.join(repo_relative)) {
   00361|         Ok(source) => match crate::meta_translate::translate(from, to, repo_relative, &source) {
   00362|             TranslationOutcome::Rendered { target, .. } => return (target, false),
   00363|             TranslationOutcome::Refused { refusals } => {
   00364|                 crate::translate_write::WriteReport::Refused {
   00365|                     items: crate::translate_write::refusal_items(repo_relative, &refusals),
   00366|                 }
   00367|             }
   00368|             TranslationOutcome::Pending { .. } => {
   00369|                 crate::translate_write::WriteReport::UnsupportedLeg { from, to }
   00370|             }
   00371|             TranslationOutcome::Invalid { reason } => {
   00372|                 crate::translate_write::WriteReport::Invalid {
   00373|                     path: repo_relative.to_owned(),
   00374|                     reason,
   00375|                 }
   00376|             }
   00377|         },
   00378|         Err(_) => crate::translate_write::WriteReport::Missing {
   00379|             path: repo_relative.to_owned(),
   00380|         },
   00381|     };
   00382|     let (intent, values) = report.intent();
   00383|     let values = values
   00384|         .iter()
   00385|         .map(|(key, value)| (*key, value.as_str()))
   00386|         .collect::<Vec<_>>();
   00387|     let rendered =
   00388|         crate::seed::render_response(intent, "en", &values).unwrap_or_else(|| intent.to_owned());
   00389|     (rendered, true)
   00390| }
