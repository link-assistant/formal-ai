   00486| /// OpenAI-shaped function tool definitions for the advertised tool `names`.
   00487| fn tool_definitions(names: &[&str]) -> Vec<Value> {
   00488|     names
   00489|         .iter()
   00490|         .map(|name| {
   00491|             json!({
   00492|                 "type": "function",
   00493|                 "function": { "name": name, "description": tool_description(name) },
