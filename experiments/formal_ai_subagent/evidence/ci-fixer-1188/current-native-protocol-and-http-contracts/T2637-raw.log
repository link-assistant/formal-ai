   00240| /// Execute one tool call against the offline corpus or the sandbox workspace and
   00241| /// return the textual result to feed back to the server, plus whether the call
   00242| /// failed to produce its output at all (refused, unsupported, or lost) — the
   00243| /// transport fact a real Agent CLI flags with `is_error`.
   00244| fn execute_tool_call(call: &ToolCall, workspace: &mut AgentWorkspace) -> (String, bool) {
   00245|     let arguments: Value = serde_json::from_str(&call.function.arguments).unwrap_or(Value::Null);
   00246|     match call.function.name.as_str() {
   00247|         "web_search" => (corpus::web_search(arg_str(&arguments, "query")), false),
   00248|         "web_fetch" => (corpus::web_fetch(arg_str(&arguments, "url")), false),
   00249|         "read_file" => {
   00250|             let path = arg_str(&arguments, "path");
   00251|             match workspace.read_file(path) {
   00252|                 Ok(content) => {
   00253|                     let body = content
   00254|                         .split('\n')
   00255|                         .enumerate()
   00256|                         .map(|(index, line)| format!("{:05}| {line}", index + 1))
   00257|                         .collect::<Vec<_>>()
   00258|                         .join("\n");
   00259|                     (
   00260|                         super::work_item_steps::fill(
   00261|                             "agent-file-read-frame",
   00262|                             &[
   00263|                                 (concat!("{", "body", "}"), &body),
   00264|                                 ("{lines}", &content.split('\n').count().to_string()),
   00265|                             ],
   00266|                         ),
   00267|                         false,
   00268|                     )
   00269|                 }
   00270|                 Err(error) => (error.to_string(), true),
   00271|             }
   00272|         }
   00273|         "write_file" => {
   00274|             let path = arg_str(&arguments, "path");
   00275|             let content = arg_str(&arguments, "content");
   00276|             workspace.create_file(path, content);
   00277|             (format!("wrote {} byte(s) to {path}", content.len()), false)
   00278|         }
   00279|         "run_command" => {
   00280|             let command = arg_str(&arguments, "command");
   00281|             if let Some(result) = execute_algorithm_command(command, workspace) {
   00282|                 return (result, false);
   00283|             }
   00284|             if let Some(result) = execute_procedure_conformance(command, workspace) {
   00285|                 return (result, false);
   00286|             }
   00287|             workspace.run_command(command);
   00288|             workspace.last_command_result().map_or_else(
   00289|                 || {
   00290|                     (
   00291|                         format!("run_command produced no result for {command:?}"),
   00292|                         true,
   00293|                     )
   00294|                 },
   00295|                 |executed| (format_command_result(executed), false),
   00296|             )
   00297|         }
   00298|         // Plan 16 L2g: the same library the CLI's `--write` runs, executed
   00299|         // against the sandbox workspace — the workspace root plays the
   00300|         // repository root, so `js/…` paths are the ones the plan wrote
   00301|         // there. The report text is rendered from the seed the CLI uses,
   00302|         // and a refusal, wrong root or unreadable source is an error result
   00303|         // so the agent sees the failure instead of a silent no-op.
   00304|         "translate" => {
   00305|             let Some(from) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "from"))
   00306|             else {
   00307|                 return (
   00308|                     "error: translate needs a known from root (js, ts)".to_owned(),
   00309|                     true,
   00310|                 );
   00311|             };
   00312|             let Some(to) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "to"))
   00313|             else {
   00314|                 return (
   00315|                     "error: translate needs a known to root (js, ts)".to_owned(),
   00316|                     true,
   00317|                 );
   00318|             };
   00319|             let path = arg_str(&arguments, "path");
   00320|             let write = arguments
   00321|                 .get("write")
   00322|                 .and_then(serde_json::Value::as_bool)
   00323|                 .unwrap_or(false);
   00324|             let report = if path.is_empty() {
   00325|                 if !write {
   00326|                     return (
   00327|                         "error: a tree translation must set write, or name one path".to_owned(),
   00328|                         true,
   00329|                     );
   00330|                 }
   00331|                 crate::translate_write::write_tree(from, to, workspace.root())
   00332|             } else if write {
   00333|                 crate::translate_write::write_one(from, to, workspace.root(), path)
   00334|             } else {
   00335|                 return translate_without_write(from, to, workspace.root(), path);
   00336|             };
   00337|             let (intent, values) = report.intent();
   00338|             let values = values
   00339|                 .iter()
   00340|                 .map(|(key, value)| (*key, value.as_str()))
   00341|                 .collect::<Vec<_>>();
   00342|             let rendered = crate::seed::render_response(intent, "en", &values)
   00343|                 .unwrap_or_else(|| intent.to_owned());
   00344|             (rendered, report.is_failure())
   00345|         }
   00346|         other => (format!("error: unsupported tool {other}"), true),
   00347|     }
   00348| }
