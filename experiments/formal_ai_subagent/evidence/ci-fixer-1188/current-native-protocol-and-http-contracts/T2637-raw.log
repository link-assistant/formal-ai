   00139| /// Drive the agentic loop for `task` using a default sandbox workspace.
   00140| ///
   00141| /// # Errors
   00142| ///
   00143| /// Returns an [`AgentError`] if the isolated workspace cannot be created.
   00144| pub fn run_agentic_task(task: &str) -> Result<DriverOutcome, AgentError> {
   00145|     run_agentic_task_in(task, &AgentWorkspaceConfig::default())
   00146| }
   00147| 
   00148| /// Drive the agentic loop for `task` using the given workspace `config`.
   00149| ///
   00150| /// # Errors
   00151| ///
   00152| /// Returns an [`AgentError`] if the isolated workspace cannot be created.
   00153| pub fn run_agentic_task_in(
   00154|     task: &str,
   00155|     config: &AgentWorkspaceConfig,
   00156| ) -> Result<DriverOutcome, AgentError> {
   00157|     // Agent mode is the explicit opt-in the server's tool gate requires; without
   00158|     // it the server refuses every tool. The driver is that isolated execution
   00159|     // environment, so it opts in.
   00160|     let solver = UniversalSolver::new(SolverConfig {
   00161|         agent_mode: true,
   00162|         ..SolverConfig::default()
   00163|     });
   00164|     let tools = tool_definitions(&DRIVER_TOOLS);
   00165|     let mut workspace = AgentWorkspace::for_prompt(task, config)?;
   00166|     let mut messages = vec![ChatMessage::user(task)];
   00167|     let mut steps = Vec::new();
   00168|     let mut turns = 0usize;
   00169| 
   00170|     loop {
   00171|         if turns >= MAX_TURNS {
   00172|             return Ok(DriverOutcome {
   00173|                 task: task.to_owned(),
   00174|                 steps,
   00175|                 final_answer: String::new(),
   00176|                 turns,
   00177|                 hit_turn_cap: true,
   00178|             });
   00179|         }
   00180|         turns += 1;
   00181| 
   00182|         let request = ChatCompletionRequest {
   00183|             model: None,
   00184|             messages: messages.clone(),
   00185|             temperature: None,
   00186|             stream: false,
   00187|             tools: tools.clone(),
   00188|             tool_choice: None,
   00189|             functions: Vec::new(),
   00190|             function_call: None,
   00191|             stream_options: None,
   00192|         };
   00193|         let completion = create_chat_completion_with_solver(&request, &solver);
   00194|         let Some(choice) = completion.choices.into_iter().next() else {
   00195|             return Ok(DriverOutcome {
   00196|                 task: task.to_owned(),
   00197|                 steps,
   00198|                 final_answer: String::new(),
   00199|                 turns,
   00200|                 hit_turn_cap: false,
   00201|             });
   00202|         };
   00203| 
   00204|         let requested_tools =
   00205|             choice.finish_reason == "tool_calls" && !choice.message.tool_calls.is_empty();
   00206|         if !requested_tools {
   00207|             return Ok(DriverOutcome {
   00208|                 task: task.to_owned(),
   00209|                 steps,
   00210|                 final_answer: choice.message.content.plain_text(),
   00211|                 turns,
   00212|                 hit_turn_cap: false,
   00213|             });
   00214|         }
   00215| 
   00216|         // Execute the requested tool calls, then append the assistant turn
   00217|         // followed by the `tool` results (order matters: the planner maps each
   00218|         // result's `tool_call_id` back to a *prior* assistant `tool_calls` turn).
   00219|         let assistant = choice.message;
   00220|         let mut results = Vec::with_capacity(assistant.tool_calls.len());
   00221|         for call in &assistant.tool_calls {
   00222|             let (result, failed) = execute_tool_call(call, &mut workspace);
   00223|             steps.push(DriverToolStep {
   00224|                 tool: call.function.name.clone(),
   00225|                 arguments: call.function.arguments.clone(),
   00226|                 result: result.clone(),
   00227|             });
   00228|             let message = if failed {
   00229|                 ChatMessage::tool_result_error(call.id.clone(), call.function.name.clone(), result)
   00230|             } else {
   00231|                 ChatMessage::tool_result(call.id.clone(), call.function.name.clone(), result)
   00232|             };
   00233|             results.push(message);
   00234|         }
   00235|         messages.push(assistant);
   00236|         messages.extend(results);
   00237|     }
   00238| }
