   00392| /// Mirror the public discovery/conformance commands inside the deterministic
   00393| /// in-repo driver. External Agent CLIs invoke the installed binary instead.
   00394| fn execute_algorithm_command(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00395|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00396|     if parts.get(..3) == Some(&["formal-ai", "learn", "algorithms"]) {
   00397|         let from = option_value(&parts, "--from")?;
   00398|         let output = option_value(&parts, "--output")?;
   00399|         if from != super::algorithm_learning::OBSERVATIONS_PATH
   00400|             || output != super::algorithm_learning::DISCOVERY_PATH
   00401|         {
   00402|             return Some(format!(
   00403|                 "algorithm_learning_paths_unsupported:{from:?}:{output:?}"
   00404|             ));
   00405|         }
   00406|         let document = match std::fs::read_to_string(workspace.root().join(from)) {
   00407|             Ok(document) => document,
   00408|             Err(error) => return Some(format!("algorithm_observations_read_failed:{error}")),
   00409|         };
   00410|         let mut memory = MemoryStore::new();
   00411|         memory.replace_from_links_notation(&document);
   00412|         let run = discover_algorithms(&traces_from_memory_events(memory.events()));
   00413|         if let Err(error) = std::fs::write(workspace.root().join(output), run.links_notation()) {
   00414|             return Some(format!("algorithm_artifact_write_failed:{error}"));
   00415|         }
   00416|         return Some(format!(
   00417|             "algorithm_learning_complete:candidates={}:validated={}",
   00418|             run.candidates.len(),
   00419|             run.validated_candidates().len()
   00420|         ));
   00421|     }
   00422|     if parts.get(..3) != Some(&["formal-ai", "algorithm", "conformance"]) {
   00423|         return None;
   00424|     }
   00425|     let artifact = option_value(&parts, "--artifact")?;
   00426|     let trigger = option_value(&parts, "--trigger")?;
   00427|     if artifact != super::algorithm_learning::DISCOVERY_PATH {
   00428|         return Some(format!("algorithm_artifact_unsupported:{artifact:?}"));
   00429|     }
   00430|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00431|         Ok(document) => document,
   00432|         Err(error) => return Some(format!("algorithm_artifact_read_failed:{artifact}:{error}")),
   00433|     };
   00434|     let candidate = match AlgorithmCandidate::from_links_notation(&document) {
   00435|         Ok(candidate) => candidate,
   00436|         Err(error) => return Some(format!("algorithm_artifact_invalid:{error}")),
   00437|     };
   00438|     let mut bindings = std::collections::BTreeMap::new();
   00439|     for (index, part) in parts.iter().enumerate() {
   00440|         if *part != "--binding" {
   00441|             continue;
   00442|         }
   00443|         let Some(binding) = parts.get(index + 1) else {
   00444|             return Some(String::from("algorithm_binding_missing"));
   00445|         };
   00446|         let Some((name, value)) = binding.split_once('=') else {
   00447|             return Some(format!("algorithm_binding_invalid:{binding:?}"));
   00448|         };
   00449|         bindings.insert(name.to_owned(), value.to_owned());
   00450|     }
   00451|     Some(
   00452|         candidate
   00453|             .conformance_links_notation(trigger, &bindings)
   00454|             .unwrap_or_else(|error| format!("algorithm_conformance_failed:{error}")),
   00455|     )
   00456| }
