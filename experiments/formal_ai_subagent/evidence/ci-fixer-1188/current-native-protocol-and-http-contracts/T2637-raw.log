   00458| /// Mirror the public `formal-ai procedure conformance` command inside the
   00459| /// in-repo sandbox. External Agent CLI runs the binary; this deterministic
   00460| /// driver invokes the same library path without allowing arbitrary executables.
   00461| fn execute_procedure_conformance(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00462|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00463|     if parts.get(..3) != Some(&["formal-ai", "procedure", "conformance"]) {
   00464|         return None;
   00465|     }
   00466|     let artifact = option_value(&parts, "--artifact")?;
   00467|     let trigger = option_value(&parts, "--trigger")?;
   00468|     if artifact != super::procedure::COMPILED_PROCEDURE_PATH {
   00469|         return Some(format!("procedure_artifact_unsupported:{artifact:?}"));
   00470|     }
   00471|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00472|         Ok(document) => document,
   00473|         Err(error) => return Some(format!("procedure_artifact_read_failed:{artifact}:{error}")),
   00474|     };
   00475|     match CompiledProcedure::from_artifact_links_notation(&document) {
   00476|         Ok(procedure) => Some(procedure.conformance_links_notation(trigger)),
   00477|         Err(error) => Some(format!("procedure_artifact_invalid:{error}")),
   00478|     }
   00479| }
