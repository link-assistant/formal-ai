   00090| #[test]
   00091| fn the_recorded_learning_frontier_spans_every_supported_language() {
   00092|     // Issue #498 requires the learning frontier to span *every* supported language,
   00093|     // not just one: English (en), Russian (ru), Hindi (hi), and Chinese (zh). A
   00094|     // regression that dropped a locale would silently narrow the engine's own map of
   00095|     // which trending prompts it could not yet answer. Each expected fragment is the
   00096|     // native-language request template the frontier prompt is built from, so this also
   00097|     // pins that the non-English prompts stay in their own script.
   00098|     //
   00099|     // The live frontier is empty since issue #701 closed the gap, so the check runs
   00100|     // against the frozen pre-adoption record — the durable frontier artifact that
   00101|     // keeps the failure visible instead of dropping it (R425).
   00102|     let recorded = recorded_google_trends_frontier();
   00103|     let expected: [(&str, &str); 4] = [
   00104|         ("en", "Give Google Trends context for"),
   00105|         ("ru", "Дай контекст Google Trends для"),
   00106|         ("hi", "के बारे में बताओ"),
   00107|         ("zh", "介绍一下"),
   00108|     ];
   00109|     for (language, request_fragment) in expected {
   00110|         assert!(
   00111|             recorded
   00112|                 .iter()
   00113|                 .any(|item| item.language == language && item.prompt.contains(request_fragment)),
   00114|             "the recorded frontier must include {language} prompts like {request_fragment:?}",
   00115|         );
   00116|     }
   00117| 
   00118|     // Coverage is derived from supported_languages(), so every language contributed at
   00119|     // least one frontier prompt — none was silently dropped.
   00120|     for language in ["en", "ru", "hi", "zh"] {
   00121|         assert!(
   00122|             recorded.iter().any(|item| item.language == language),
   00123|             "language {language} must appear on the recorded frontier",
   00124|         );
   00125|     }
   00126| }
