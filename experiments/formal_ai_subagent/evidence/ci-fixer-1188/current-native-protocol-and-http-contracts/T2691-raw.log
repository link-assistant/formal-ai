   00029| #[test]
   00030| fn committed_google_trends_learning_report_is_generated_by_the_recipe() {
   00031|     let committed = include_str!("../../../../data/meta/google-trends-learning.lino");
   00032|     assert_eq!(
   00033|         committed,
   00034|         recipe::render_document(),
   00035|         "the committed Trends learning report is stale; regenerate it from the issue-498 recipe",
   00036|     );
   00037|     parse_indented(committed).expect("the learning report should parse as Links Notation");
   00038|     assert!(committed.contains("google_trends_learning"));
   00039|     assert!(committed.contains("auto_learning_loop \"issue_558_self_improvement\""));
   00040|     assert!(committed.contains("human_gated \"true\""));
   00041|     // The honest coverage split. It used to be 20 routed / 60 on the frontier;
   00042|     // issue #701's learning cycle derived the missing request-opener surfaces
   00043|     // from that very frontier and promoted them through the human gate, so the
   00044|     // frontier is now empty. The pre-adoption verdicts are preserved in
   00045|     // `data/meta/learning-frontier-google-trends.lino`, and the per-prompt
   00046|     // capability deltas in `data/meta/learning-adoption-ledger.lino`.
   00047|     assert!(committed.contains("handled_by_engine \"80\""));
   00048|     assert!(committed.contains("learning_frontier \"0\""));
   00049|     // Still nothing is auto-adopted *here*: adoption went through issue #656.
   00050|     assert!(committed.contains("learning_run_adopted \"0\""));
   00051|     // A frontier entry is only an *unrouted* prompt; no routed intent leaks in.
   00052|     assert!(!committed.contains("engine_intent \"web_search\""));
   00053| }
