   00055| #[test]
   00056| fn the_learning_report_is_a_faithful_proposal_only_run() {
   00057|     let report = trending_learning_report();
   00058|     // The catalog holds 80 prompts (10 topics × 4 languages × 2 variations); the split
   00059|     // is derived from the engine, not hardcoded: routed + frontier == total.
   00060|     assert_eq!(report.total_prompts, 80);
   00061|     assert_eq!(
   00062|         report.handled_by_engine + report.frontier_count(),
   00063|         report.total_prompts,
   00064|         "every prompt is either routed or on the frontier",
   00065|     );
   00066|     // Issue #701 closed the gap: the frontier is empty and every catalog prompt
   00067|     // routes. This is a ratchet — a regression that unroutes a prompt fails here.
   00068|     assert_eq!(report.frontier_count(), 0);
   00069|     assert_eq!(report.handled_by_engine, 80);
   00070| 
   00071|     // Every frontier prompt is genuinely unrouted, and each becomes a learning trace.
   00072|     assert!(
   00073|         report
   00074|             .frontier
   00075|             .iter()
   00076|             .all(|entry| entry.engine_intent == "unknown")
   00077|     );
   00078|     assert_eq!(report.run.trace_count, report.frontier_count());
   00079| 
   00080|     // The loop is still proposal-only and still adopts nothing on its own: the
   00081|     // surfaces that closed the gap were promoted through the human-gated
   00082|     // issue-#656 protocol, not auto-adopted here (issue #558's honest behaviour).
   00083|     assert!(report.is_proposal_only());
   00084|     assert_eq!(report.adopted_count(), 0);
   00085|     // With no frontier there is nothing to reject, so there is no uniform reason.
   00086|     assert_eq!(report.uniform_rejection_reason(), None);
   00087|     assert!(report.summary().contains("frontier is empty"));
   00088| }
