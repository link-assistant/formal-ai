   00262| #[test]
   00263| fn a_read_never_answers_from_a_previous_turns_tool_result() {
   00264|     // Turn one runs `cat 1.txt` and the client reports "stale". Turn two asks to
   00265|     // read the same file: the planner must issue a *fresh* read rather than
   00266|     // replaying the earlier result.
   00267|     enable_http_agent_mode_for_current_process();
   00268|     let tools = vec![read_tool(), shell_tool()];
   00269|     let mut messages = vec![json!({"role": "user", "content": "execute cat 1.txt"})];
   00270|     let first = next_step(&tools, &messages);
   00271|     let calls = first["tool_calls"]
   00272|         .as_array()
   00273|         .cloned()
   00274|         .expect("the first turn should run the command");
   00275|     messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00276|     messages.push(json!({
   00277|         "role": "tool",
   00278|         "tool_call_id": calls[0]["id"],
   00279|         "content": "stale"
   00280|     }));
   00281|     // Close turn one so its result is history, then open a new user turn.
   00282|     let closing = next_step(&tools, &messages);
   00283|     messages.push(json!({
   00284|         "role": "assistant",
   00285|         "content": closing["content"].as_str().unwrap_or_default()
   00286|     }));
   00287|     messages.push(json!({"role": "user", "content": "read 1.txt"}));
   00288| 
   00289|     let second = next_step(&tools, &messages);
   00290|     let calls = second["tool_calls"].as_array();
   00291|     assert!(
   00292|         calls.is_some_and(|calls| !calls.is_empty()),
   00293|         "a new read turn must issue a fresh tool call, got {second}"
   00294|     );
   00295|     let answer = second["content"].as_str().unwrap_or_default();
   00296|     assert!(
   00297|         !answer.contains("stale"),
   00298|         "a previous turn's result must never answer this one, got {second}"
   00299|     );
