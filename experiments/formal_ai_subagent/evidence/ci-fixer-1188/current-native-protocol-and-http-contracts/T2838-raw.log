   00378| /// One planning round trip for an in-flight conversation.
   00379| fn next_step(tools: &[Value], messages: &[Value]) -> Value {
   00380|     enable_http_agent_mode_for_current_process();
   00381|     let body = json!({"model": "formal-ai", "messages": messages, "tools": tools});
   00382|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00383|     assert_eq!(response.status_code, 200, "{}", response.body);
   00384|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00385|     response["choices"][0]["message"].clone()
   00386| }
   00387| 
   00388| /// Drive the client tool loop, answering every call with `result`, and return
   00389| /// the `(tool, arguments)` pairs the server asked for.
   00390| fn drive(prompt: &str, tools: &[Value], result: &str, turns: usize) -> Vec<(String, Value)> {
   00391|     let owned = result.to_owned();
   00392|     drive_with(prompt, tools, turns, &mut |_, _| owned.clone())
   00393| }
   00394| 
   00395| /// Drive the client tool loop, delegating each call to `execute`.
   00396| fn drive_with(
   00397|     prompt: &str,
   00398|     tools: &[Value],
   00399|     turns: usize,
   00400|     execute: &mut dyn FnMut(&str, &Value) -> String,
   00401| ) -> Vec<(String, Value)> {
   00402|     enable_http_agent_mode_for_current_process();
   00403|     let mut messages = vec![json!({"role": "user", "content": prompt})];
   00404|     let mut transcript = Vec::new();
   00405|     for _ in 0..turns {
   00406|         let message = next_step(tools, &messages);
   00407|         let Some(calls) = message["tool_calls"].as_array().filter(|c| !c.is_empty()) else {
   00408|             break;
   00409|         };
   00410|         messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00411|         for call in calls {
   00412|             let name = call["function"]["name"].as_str().unwrap_or_default();
   00413|             let arguments: Value =
   00414|                 serde_json::from_str(call["function"]["arguments"].as_str().unwrap_or("{}"))
   00415|                     .unwrap_or(Value::Null);
   00416|             let result = execute(name, &arguments);
   00417|             transcript.push((name.to_owned(), arguments));
   00418|             messages.push(json!({
   00419|                 "role": "tool",
   00420|                 "tool_call_id": call["id"],
   00421|                 "content": result
   00422|             }));
   00423|         }
   00424|     }
   00425|     transcript
   00426| }
   00427| 
   00428| fn call_arguments(prompt: &str, name: &str, parameters: &Value) -> Value {
   00429|     enable_http_agent_mode_for_current_process();
   00430|     let body = json!({
   00431|         "model": "formal-ai",
   00432|         "messages": [{"role": "user", "content": prompt}],
   00433|         "tools": [{
   00434|             "type": "function",
   00435|             "function": {"name": name, "parameters": parameters}
   00436|         }]
   00437|     });
   00438|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00439|     assert_eq!(response.status_code, 200, "{}", response.body);
   00440|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00441|     let call = &response["choices"][0]["message"]["tool_calls"][0];
   00442|     assert_eq!(call["function"]["name"], name, "{response}");
   00443|     serde_json::from_str(call["function"]["arguments"].as_str().unwrap()).unwrap()
   00444| }
