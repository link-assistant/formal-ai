   00190| #[test]
   00191| fn a_multi_turn_lifecycle_reads_back_the_current_content_each_time() {
   00192|     // create -> read back -> overwrite -> read back, all in one session with a
   00193|     // client loop that applies writes and answers reads from a scratch
   00194|     // workspace. Each read turn must reflect the *current* bytes, never a value
   00195|     // captured by an earlier turn (issue #755, read/list determinism).
   00196|     use std::collections::HashMap;
   00197|     enable_http_agent_mode_for_current_process();
   00198|     let tools = vec![write_tool(&strict_write_schema()), read_tool()];
   00199|     let workspace: std::cell::RefCell<HashMap<String, String>> =
   00200|         std::cell::RefCell::new(HashMap::new());
   00201|     let mut messages: Vec<Value> = Vec::new();
   00202| 
   00203|     let run_turn = |messages: &mut Vec<Value>, prompt: &str| -> String {
   00204|         messages.push(json!({"role": "user", "content": prompt}));
   00205|         let mut last_read = String::new();
   00206|         for _ in 0..6 {
   00207|             let message = next_step(&tools, messages);
   00208|             let Some(calls) = message["tool_calls"].as_array().filter(|c| !c.is_empty()) else {
   00209|                 messages.push(json!({
   00210|                     "role": "assistant",
   00211|                     "content": message["content"].as_str().unwrap_or_default()
   00212|                 }));
   00213|                 break;
   00214|             };
   00215|             messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00216|             for call in calls {
   00217|                 let name = call["function"]["name"].as_str().unwrap_or_default();
   00218|                 let args: Value =
   00219|                     serde_json::from_str(call["function"]["arguments"].as_str().unwrap_or("{}"))
   00220|                         .unwrap_or(Value::Null);
   00221|                 let result = match name {
   00222|                     "Write" => {
   00223|                         let path = args["file_path"].as_str().unwrap_or_default().to_owned();
   00224|                         let content = args["content"].as_str().unwrap_or_default().to_owned();
   00225|                         workspace.borrow_mut().insert(path, content);
   00226|                         String::from("ok")
   00227|                     }
   00228|                     "Read" => {
   00229|                         let path = args["file_path"].as_str().unwrap_or_default();
   00230|                         let content = workspace.borrow().get(path).cloned().unwrap_or_default();
   00231|                         last_read = content.clone();
   00232|                         content
   00233|                     }
   00234|                     _ => String::new(),
   00235|                 };
   00236|                 messages.push(json!({
   00237|                     "role": "tool",
   00238|                     "tool_call_id": call["id"],
   00239|                     "content": result
   00240|                 }));
   00241|             }
   00242|         }
   00243|         last_read
   00244|     };
   00245| 
   00246|     run_turn(&mut messages, "write 10 to 1.txt file");
   00247|     assert_eq!(
   00248|         workspace.borrow().get("1.txt").map(String::as_str),
   00249|         Some("10")
   00250|     );
   00251|     assert_eq!(run_turn(&mut messages, "read 1.txt"), "10");
   00252| 
   00253|     run_turn(&mut messages, "write 20 to 1.txt file");
   00254|     assert_eq!(
   00255|         workspace.borrow().get("1.txt").map(String::as_str),
   00256|         Some("20")
   00257|     );
   00258|     // The second read must reflect the overwrite, not replay the first read's 10.
   00259|     assert_eq!(run_turn(&mut messages, "read 1.txt"), "20");
   00260| }
