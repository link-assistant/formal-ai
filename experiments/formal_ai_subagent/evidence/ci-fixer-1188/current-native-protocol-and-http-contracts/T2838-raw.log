   00147|     for (tool, arguments) in &transcript {
   00148|         assert_eq!(tool, "Write");
   00149|         let object = arguments.as_object().expect("object arguments");
   00150|         assert_eq!(object.len(), 2, "only file_path + content: {arguments}");
