   00106| #[test]
   00107| fn the_users_content_reaches_the_users_file_in_every_language() {
   00108|     // The plan-first design is fine internally; what the user asked for is that
   00109|     // "10" ends up in "1.txt". Drive the whole loop in each supported language
   00110|     // and assert the user's write is emitted with the advertised keys only.
   00111|     for (language, request) in WRITE_REQUESTS {
   00112|         let transcript = drive(request, &[write_tool(&strict_write_schema())], "ok", 4);
   00113|         let user_write = transcript
   00114|             .iter()
   00115|             .find(|(tool, arguments)| tool == "Write" && arguments["file_path"] == "1.txt")
   00116|             .unwrap_or_else(|| panic!("[{language}] no write targeted 1.txt: {transcript:?}"));
   00117|         assert_eq!(
   00118|             user_write.1["content"], "10",
   00119|             "[{language}] the user's file must carry the user's content: {transcript:?}"
   00120|         );
   00121|         assert_eq!(
   00122|             user_write.1.as_object().unwrap().len(),
   00123|             2,
   00124|             "[{language}] only file_path + content: {transcript:?}"
   00125|         );
   00126|     }
   00127| }
