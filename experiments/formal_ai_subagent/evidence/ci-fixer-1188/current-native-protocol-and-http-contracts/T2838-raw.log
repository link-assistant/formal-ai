   00129| #[test]
   00130| fn a_failed_plan_write_never_blocks_the_users_write() {
   00131|     // The client rejects every write it is handed. The internal plan artifact may
   00132|     // be recorded first, but a failure there must not swallow the requested
   00133|     // change: the user's file, with the user's content, must still be written.
   00134|     let transcript = drive(
   00135|         "write 10 to 1.txt file",
   00136|         &[write_tool(&strict_write_schema())],
   00137|         "<tool_use_error>Error writing file</tool_use_error>",
