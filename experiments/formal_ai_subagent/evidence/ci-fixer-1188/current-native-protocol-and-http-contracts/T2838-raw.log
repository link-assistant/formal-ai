   00157| fn the_whole_write_read_task_persists_and_reads_back_the_users_content() {
   00158|     // create -> read back, driven end to end through the protocol with a client
   00159|     // loop that actually applies the writes to a scratch workspace.
   00160|     let tools = vec![write_tool(&strict_write_schema()), read_tool()];
   00161|     let mut workspace: Vec<(String, String)> = Vec::new();
   00162|     let transcript = drive_with(
   00163|         "write 10 to 1.txt file",
   00164|         &tools,
   00165|         6,
   00166|         &mut |name, arguments| match name {
   00167|             "Write" => {
   00168|                 let path = arguments["file_path"].as_str().unwrap_or_default();
   00169|                 let content = arguments["content"].as_str().unwrap_or_default();
   00170|                 workspace.push((path.to_owned(), content.to_owned()));
   00171|                 String::from("ok")
   00172|             }
   00173|             "Read" => {
   00174|                 let path = arguments["file_path"].as_str().expect("advertised read path");
   00175|                 workspace.iter().rev().find(|(written, _)| written == path)
   00176|                     .map_or_else(|| json!({"is_error": true, "error": format!("File not found: {path}")}).to_string(), |(_, content)| content.clone())
