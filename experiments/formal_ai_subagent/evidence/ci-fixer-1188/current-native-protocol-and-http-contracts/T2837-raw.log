   00079| #[test]
   00080| fn write_emits_only_the_advertised_parameter_names() {
   00081|     for (tool, parameter) in WRITE_SCHEMAS {
   00082|         let arguments = call_arguments(
   00083|             "write 10 to 1.txt file",
   00084|             tool,
   00085|             &json!({
   00086|                 "type": "object",
   00087|                 "properties": {
   00088|                     (*parameter): {"type": "string"},
   00089|                     "content": {"type": "string"}
   00090|                 },
   00091|                 "required": [*parameter, "content"],
   00092|                 "additionalProperties": false
   00093|             }),
   00094|         );
   00095|         let object = arguments.as_object().expect("object arguments");
   00096|         assert_eq!(
   00097|             object.len(),
   00098|             2,
   00099|             "{tool} declares only `{parameter}` and `content`, got {arguments}"
   00100|         );
   00101|         assert!(object.contains_key(*parameter), "{arguments}");
   00102|         assert!(object.contains_key("content"), "{arguments}");
