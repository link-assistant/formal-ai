   00129| #[test]
   00130| fn a_failed_plan_write_never_blocks_the_users_write() {
   00131|     // The client rejects every write it is handed. The internal plan artifact may
   00132|     // be recorded first, but a failure there must not swallow the requested
   00133|     // change: the user's file, with the user's content, must still be written.
   00134|     let transcript = drive(
   00135|         "write 10 to 1.txt file",
   00136|         &[write_tool(&strict_write_schema())],
   00137|         "<tool_use_error>Error writing file</tool_use_error>",
   00138|         4,
   00139|     );
   00140|     assert!(
   00141|         transcript.iter().any(|(tool, arguments)| tool == "Write"
   00142|             && arguments["file_path"] == "1.txt"
   00143|             && arguments["content"] == "10"),
   00144|         "the user's write must still be attempted, got {transcript:?}"
   00145|     );
   00146|     // Every emitted write uses only the advertised keys, even the plan step.
   00147|     for (tool, arguments) in &transcript {
   00148|         assert_eq!(tool, "Write");
   00149|         let object = arguments.as_object().expect("object arguments");
   00150|         assert_eq!(object.len(), 2, "only file_path + content: {arguments}");
   00151|         assert!(object.contains_key("file_path"), "{arguments}");
   00152|         assert!(object.contains_key("content"), "{arguments}");
   00153|     }
   00154| }
