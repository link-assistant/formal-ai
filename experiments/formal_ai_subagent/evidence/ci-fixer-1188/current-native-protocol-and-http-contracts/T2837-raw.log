   00185| #[test]
   00186| fn a_multi_turn_lifecycle_reads_back_the_current_content_each_time() {
   00187|     // create -> read back -> overwrite -> read back, all in one session with a
   00188|     // client loop that applies writes and answers reads from a scratch
   00189|     // workspace. Each read turn must reflect the *current* bytes, never a value
   00190|     // captured by an earlier turn (issue #755, read/list determinism).
   00191|     use std::collections::HashMap;
   00192|     enable_http_agent_mode_for_current_process();
   00193|     let tools = vec![write_tool(&strict_write_schema()), read_tool()];
   00194|     let workspace: std::cell::RefCell<HashMap<String, String>> =
   00195|         std::cell::RefCell::new(HashMap::new());
   00196|     let mut messages: Vec<Value> = Vec::new();
   00197| 
   00198|     let run_turn = |messages: &mut Vec<Value>, prompt: &str| -> String {
   00199|         messages.push(json!({"role": "user", "content": prompt}));
   00200|         let mut last_read = String::new();
   00201|         for _ in 0..6 {
   00202|             let message = next_step(&tools, messages);
   00203|             let Some(calls) = message["tool_calls"].as_array().filter(|c| !c.is_empty()) else {
   00204|                 messages.push(json!({
   00205|                     "role": "assistant",
   00206|                     "content": message["content"].as_str().unwrap_or_default()
   00207|                 }));
   00208|                 break;
   00209|             };
   00210|             messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00211|             for call in calls {
   00212|                 let name = call["function"]["name"].as_str().unwrap_or_default();
   00213|                 let args: Value =
   00214|                     serde_json::from_str(call["function"]["arguments"].as_str().unwrap_or("{}"))
   00215|                         .unwrap_or(Value::Null);
   00216|                 let result = match name {
   00217|                     "Write" => {
   00218|                         let path = args["file_path"].as_str().unwrap_or_default().to_owned();
   00219|                         let content = args["content"].as_str().unwrap_or_default().to_owned();
   00220|                         workspace.borrow_mut().insert(path, content);
   00221|                         String::from("ok")
   00222|                     }
   00223|                     "Read" => {
   00224|                         let path = args["file_path"].as_str().unwrap_or_default();
   00225|                         let content = workspace.borrow().get(path).cloned().unwrap_or_default();
   00226|                         last_read = content.clone();
   00227|                         content
   00228|                     }
   00229|                     _ => String::new(),
   00230|                 };
   00231|                 messages.push(json!({
   00232|                     "role": "tool",
   00233|                     "tool_call_id": call["id"],
   00234|                     "content": result
   00235|                 }));
   00236|             }
   00237|         }
   00238|         last_read
   00239|     };
   00240| 
   00241|     run_turn(&mut messages, "write 10 to 1.txt file");
   00242|     assert_eq!(
   00243|         workspace.borrow().get("1.txt").map(String::as_str),
   00244|         Some("10")
   00245|     );
   00246|     assert_eq!(run_turn(&mut messages, "read 1.txt"), "10");
   00247| 
   00248|     run_turn(&mut messages, "write 20 to 1.txt file");
   00249|     assert_eq!(
   00250|         workspace.borrow().get("1.txt").map(String::as_str),
   00251|         Some("20")
   00252|     );
   00253|     // The second read must reflect the overwrite, not replay the first read's 10.
   00254|     assert_eq!(run_turn(&mut messages, "read 1.txt"), "20");
   00255| }
