   00297| #[test]
   00298| fn repeated_read_turns_are_deterministic() {
   00299|     // The same request, asked twice in one session, must plan the same call both
   00300|     // times rather than drifting into a stale-result answer.
   00301|     enable_http_agent_mode_for_current_process();
   00302|     let tools = vec![read_tool()];
   00303|     let mut messages = vec![json!({"role": "user", "content": "read 1.txt"})];
   00304|     let first = next_step(&tools, &messages);
   00305|     let first_call = first["tool_calls"][0]["function"].clone();
   00306| 
   00307|     let calls = first["tool_calls"].as_array().cloned().unwrap();
   00308|     messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00309|     messages.push(json!({"role": "tool", "tool_call_id": calls[0]["id"], "content": "10"}));
   00310|     let answered = next_step(&tools, &messages);
   00311|     messages.push(json!({
   00312|         "role": "assistant",
   00313|         "content": answered["content"].as_str().unwrap_or_default()
   00314|     }));
   00315|     messages.push(json!({"role": "user", "content": "read 1.txt"}));
   00316| 
   00317|     let second = next_step(&tools, &messages);
   00318|     assert_eq!(
   00319|         second["tool_calls"][0]["function"], first_call,
