   00257| #[test]
   00258| fn a_read_never_answers_from_a_previous_turns_tool_result() {
   00259|     // Turn one runs `cat 1.txt` and the client reports "stale". Turn two asks to
   00260|     // read the same file: the planner must issue a *fresh* read rather than
   00261|     // replaying the earlier result.
   00262|     enable_http_agent_mode_for_current_process();
   00263|     let tools = vec![read_tool(), shell_tool()];
   00264|     let mut messages = vec![json!({"role": "user", "content": "execute cat 1.txt"})];
   00265|     let first = next_step(&tools, &messages);
   00266|     let calls = first["tool_calls"]
   00267|         .as_array()
   00268|         .cloned()
   00269|         .expect("the first turn should run the command");
   00270|     messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00271|     messages.push(json!({
   00272|         "role": "tool",
   00273|         "tool_call_id": calls[0]["id"],
   00274|         "content": "stale"
   00275|     }));
   00276|     // Close turn one so its result is history, then open a new user turn.
   00277|     let closing = next_step(&tools, &messages);
   00278|     messages.push(json!({
   00279|         "role": "assistant",
   00280|         "content": closing["content"].as_str().unwrap_or_default()
   00281|     }));
   00282|     messages.push(json!({"role": "user", "content": "read 1.txt"}));
   00283| 
   00284|     let second = next_step(&tools, &messages);
   00285|     let calls = second["tool_calls"].as_array();
   00286|     assert!(
   00287|         calls.is_some_and(|calls| !calls.is_empty()),
   00288|         "a new read turn must issue a fresh tool call, got {second}"
   00289|     );
   00290|     let answer = second["content"].as_str().unwrap_or_default();
   00291|     assert!(
   00292|         !answer.contains("stale"),
   00293|         "a previous turn's result must never answer this one, got {second}"
   00294|     );
   00295| }
