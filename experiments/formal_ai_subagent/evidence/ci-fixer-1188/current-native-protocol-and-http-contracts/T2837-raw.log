   00373| /// One planning round trip for an in-flight conversation.
   00374| fn next_step(tools: &[Value], messages: &[Value]) -> Value {
   00375|     enable_http_agent_mode_for_current_process();
   00376|     let body = json!({"model": "formal-ai", "messages": messages, "tools": tools});
   00377|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00378|     assert_eq!(response.status_code, 200, "{}", response.body);
   00379|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00380|     response["choices"][0]["message"].clone()
   00381| }
   00382| 
   00383| /// Drive the client tool loop, answering every call with `result`, and return
   00384| /// the `(tool, arguments)` pairs the server asked for.
   00385| fn drive(prompt: &str, tools: &[Value], result: &str, turns: usize) -> Vec<(String, Value)> {
   00386|     let owned = result.to_owned();
   00387|     drive_with(prompt, tools, turns, &mut |_, _| owned.clone())
   00388| }
   00389| 
   00390| /// Drive the client tool loop, delegating each call to `execute`.
   00391| fn drive_with(
   00392|     prompt: &str,
   00393|     tools: &[Value],
   00394|     turns: usize,
   00395|     execute: &mut dyn FnMut(&str, &Value) -> String,
   00396| ) -> Vec<(String, Value)> {
   00397|     enable_http_agent_mode_for_current_process();
   00398|     let mut messages = vec![json!({"role": "user", "content": prompt})];
   00399|     let mut transcript = Vec::new();
   00400|     for _ in 0..turns {
   00401|         let message = next_step(tools, &messages);
   00402|         let Some(calls) = message["tool_calls"].as_array().filter(|c| !c.is_empty()) else {
   00403|             break;
   00404|         };
   00405|         messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00406|         for call in calls {
   00407|             let name = call["function"]["name"].as_str().unwrap_or_default();
   00408|             let arguments: Value =
   00409|                 serde_json::from_str(call["function"]["arguments"].as_str().unwrap_or("{}"))
   00410|                     .unwrap_or(Value::Null);
   00411|             let result = execute(name, &arguments);
   00412|             transcript.push((name.to_owned(), arguments));
   00413|             messages.push(json!({
   00414|                 "role": "tool",
   00415|                 "tool_call_id": call["id"],
   00416|                 "content": result
   00417|             }));
   00418|         }
   00419|     }
   00420|     transcript
   00421| }
   00422| 
   00423| fn call_arguments(prompt: &str, name: &str, parameters: &Value) -> Value {
   00424|     enable_http_agent_mode_for_current_process();
   00425|     let body = json!({
   00426|         "model": "formal-ai",
   00427|         "messages": [{"role": "user", "content": prompt}],
   00428|         "tools": [{
   00429|             "type": "function",
   00430|             "function": {"name": name, "parameters": parameters}
   00431|         }]
   00432|     });
   00433|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00434|     assert_eq!(response.status_code, 200, "{}", response.body);
   00435|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00436|     let call = &response["choices"][0]["message"]["tool_calls"][0];
   00437|     assert_eq!(call["function"]["name"], name, "{response}");
   00438|     serde_json::from_str(call["function"]["arguments"].as_str().unwrap()).unwrap()
   00439| }
