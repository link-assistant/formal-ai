   00120| // R499-5 / whole task: the directive routes into the Google Trends learning
   00121| // frontier — the same human-gated, proposal-only loop the rest of the system uses
   00122| // — and the answer reflects that report faithfully (counts, and adopts nothing).
   00123| #[test]
   00124| fn the_directive_routes_into_the_human_gated_learning_frontier() {
   00125|     let report = trending_learning_report();
   00126|     assert_eq!(report.adopted_count(), 0, "the loop stays proposal-only");
   00127| 
   00128|     let result = answer(REPORTED_PROMPT);
   00129|     assert_eq!(result.intent, "learn_from_source");
   00130|     // The answer names Google Trends and quotes the report's own coverage split,
   00131|     // proving it is derived from trending_learning_report(), not a canned string.
   00132|     assert!(result.answer.contains("Google Trends"));
   00133|     assert!(result.answer.contains(&report.total_prompts.to_string()));
   00134|     assert!(result.answer.contains(&report.frontier_count().to_string()));
   00135|     assert!(
   00136|         result.answer.contains("human-gated"),
   00137|         "the answer must state the frontier flows into the human-gated loop: {}",
   00138|         result.answer,
   00139|     );
   00140| }
