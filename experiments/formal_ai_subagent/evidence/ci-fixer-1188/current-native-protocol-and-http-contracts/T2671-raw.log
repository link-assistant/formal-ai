   00109| #[test]
   00110| fn answered_questions_form_a_recall_table() {
   00111|     // The catalog is a *recall table*: a question it already answered is recognised and
   00112|     // answered from the catalog (case/whitespace-insensitive), not re-derived. This is
   00113|     // the issue-#527 auto-learning link — without touching the human-gated ledger.
   00114|     let catalog = recipe::catalog();
   00115|     let first = catalog
   00116|         .answered
   00117|         .first()
   00118|         .expect("at least one answered question");
   00119| 
   00120|     let recalled = catalog
   00121|         .answer_for(&format!("  {}  ", first.question.to_uppercase()))
   00122|         .expect("a trivially rephrased question should be recalled");
   00123|     assert_eq!(recalled, first);
   00124| 
   00125|     // A question the catalog never generated is not recalled (no hallucinated answers).
   00126|     assert!(catalog.answer_for("what colour is the sky?").is_none());
   00127| }
