   00046| #[test]
   00047| fn catalog_classifies_smallest_first_and_answers_meaningful_questions() {
   00048|     let catalog = recipe::catalog();
   00049| 
   00050|     // Candidates are enumerated smallest-first (word count is non-decreasing).
   00051|     assert!(
   00052|         catalog
   00053|             .candidates
   00054|             .windows(2)
   00055|             .all(|pair| pair[0].word_count <= pair[1].word_count),
   00056|         "candidates must be recorded smallest-first: {:?}",
   00057|         catalog.candidates,
   00058|     );
   00059|     assert_eq!(
   00060|         catalog.candidates.first().map(|c| c.text.as_str()),
   00061|         Some("what?"),
   00062|         "the smallest candidate is the single most-frequent interrogative opener",
   00063|     );
   00064| 
   00065|     // The catalog demonstrates the four-way distinction: a fragment (one-word opener),
   00066|     // an ungrammatical candidate, and — among the answered — grammatical-and-meaningful.
   00067|     assert!(
   00068|         catalog
   00069|             .candidates
   00070|             .iter()
   00071|             .any(|c| c.class == "fragment" && c.grammar == "fragment"),
   00072|         "the catalog should record at least one fragment candidate",
   00073|     );
   00074|     assert!(
   00075|         catalog
   00076|             .candidates
   00077|             .iter()
   00078|             .any(|c| c.class == "ungrammatical"),
   00079|         "the catalog should record at least one ungrammatical candidate",
   00080|     );
   00081| 
   00082|     // Every answered entry is a grammatical, meaningful question with a real answer.
   00083|     assert!(
   00084|         !catalog.answered.is_empty(),
   00085|         "the catalog should answer at least one meaningful question",
   00086|     );
   00087|     for answered in &catalog.answered {
   00088|         assert!(answered.question.ends_with('?'));
   00089|         assert!(
   00090|             !answered.answer.trim().is_empty(),
   00091|             "every meaningful question gets a best-possible answer: {answered:?}",
   00092|         );
   00093|         assert!(
   00094|             (0.0..=1.0).contains(&answered.confidence),
   00095|             "confidence stays a probability: {answered:?}",
   00096|         );
   00097|     }
   00098| 
   00099|     // The engine answers what it can and stays honest about what it cannot: the identity
   00100|     // question resolves with full confidence, an unknown concept stays low-confidence.
   00101|     let identity = catalog
   00102|         .answer_for("what is you?")
   00103|         .expect("the identity question should be answered");
   00104|     assert_eq!(identity.intent, "identity");
   00105|     assert!(identity.confidence > 0.99);
   00106|     assert!(identity.answer.to_lowercase().contains("formal-ai"));
   00107| }
