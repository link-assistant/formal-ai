   00129| #[test]
   00130| fn committed_catalog_document_is_generated_by_the_recipe() {
   00131|     // The committed artifact is *generated* from the recipe — never hand written — so it
   00132|     // can never drift, and it is byte-for-byte what the Agent CLI writes. It depends only
   00133|     // on the seed lexicon and the deterministic engine, so it is safe to pin.
   00134|     let committed = include_str!("../../../../data/meta/question-catalog.lino");
   00135|     assert_eq!(
   00136|         committed,
   00137|         recipe::render_document(),
   00138|         "the committed catalog is stale — regenerate it with `cargo run --example dump_question_catalog`",
   00139|     );
   00140|     parse_indented(committed).expect("the committed document should parse as Links Notation");
   00141|     assert!(committed.contains("question_catalog"));
   00142|     assert!(committed.contains("intent \"generate_all_possible_questions\""));
   00143|     assert!(committed.contains("class \"fragment\""));
   00144|     assert!(committed.contains("class \"ungrammatical\""));
   00145|     assert!(committed.contains("answered"));
   00146| }
