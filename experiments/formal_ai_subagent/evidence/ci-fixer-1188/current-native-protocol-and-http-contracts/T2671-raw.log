   00195| #[test]
   00196| fn planner_walks_the_question_catalog_recipe() {
   00197|     let tools = ["web_search", "web_fetch", "write_file", "run_command"];
   00198|     let mut messages = vec![ChatMessage::user(QUESTION_CATALOG_TASK)];
   00199| 
   00200|     // Step 1: write the generated catalog document (no web step — it is a pure function
   00201|     // of the seed lexicon and the deterministic engine).
   00202|     let call = expect_single_call(&messages, &tools);
   00203|     assert_eq!(call.tool, "write_file");
   00204|     assert!(call.arguments.contains(QUESTION_CATALOG_PATH));
   00205|     let written: serde_json::Value = serde_json::from_str(&call.arguments).unwrap();
   00206|     assert_eq!(written["content"], recipe::render_document());
   00207|     answer_tool_call(&mut messages, &call, "wrote question-catalog.lino");
   00208| 
   00209|     // Step 2: verify by reading the document back.
   00210|     let call = expect_single_call(&messages, &tools);
   00211|     assert_eq!(call.tool, "run_command");
   00212|     assert!(call.arguments.contains(QUESTION_CATALOG_PATH));
   00213|     answer_tool_call(&mut messages, &call, &recipe::render_document());
   00214| 
   00215|     // Step 3: the recipe is exhausted — the final answer carries the catalog.
   00216|     match plan_chat_step(&messages, &tools) {
   00217|         Some(AgenticPlan::Final(answer)) => {
   00218|             assert!(answer.contains(QUESTION_CATALOG_PATH));
   00219|             assert!(answer.contains("question catalog"));
   00220|         }
   00221|         other => panic!("expected a final answer, got {other:?}"),
   00222|     }
   00223| }
