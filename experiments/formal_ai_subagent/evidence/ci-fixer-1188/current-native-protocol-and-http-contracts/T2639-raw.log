   00091| impl DriverOutcome {
   00092|     /// A human-readable transcript of the tool calls and how the loop ended.
   00093|     #[must_use]
   00094|     pub fn transcript(&self) -> String {
   00095|         let mut out = String::new();
   00096|         let _ = writeln!(out, "task: {}", self.task);
   00097|         let _ = writeln!(
   00098|             out,
   00099|             "turns: {} (tool calls: {})",
   00100|             self.turns,
   00101|             self.steps.len()
   00102|         );
   00103|         for (index, step) in self.steps.iter().enumerate() {
   00104|             let _ = writeln!(out, "  [{}] {} {}", index + 1, step.tool, step.arguments);
   00105|             let _ = writeln!(out, "      -> {}", preview(&step.result, 200));
   00106|         }
   00107|         if self.hit_turn_cap {
   00108|             let _ = writeln!(out, "(stopped at the {MAX_TURNS}-turn safety cap)");
   00109|         }
   00110|         out
   00111|     }
   00112| 
   00113|     /// A stable, replayable JSON record of the whole agentic session — the task,
   00114|     /// the tools the CLI advertised, every executed tool call with its arguments
   00115|     /// and result, the turn count, and the final answer. This is the "Agent CLI
   00116|     /// session that solved the task" artifact: it is deterministic (no clock, no
   00117|     /// randomness, no network), so committing it to the repo documents exactly how
   00118|     /// Formal AI drove its own CLI to the solution.
   00119|     #[must_use]
   00120|     pub fn session_json(&self) -> Value {
   00121|         json!({
   00122|             "task": self.task,
   00123|             "driver": "formal-ai in-repo agentic CLI",
   00124|             "server": "formal-ai OpenAI-compatible chat completions",
   00125|             "tools_advertised": self.tools_advertised,
   00126|             "turns": self.turns,
   00127|             "hit_turn_cap": self.hit_turn_cap,
   00128|             "steps": self.steps.iter().map(|step| json!({
   00129|                 "tool": step.tool,
   00130|                 "arguments": serde_json::from_str::<Value>(&step.arguments)
   00131|                     .unwrap_or_else(|_| Value::String(step.arguments.clone())),
   00132|                 "result": step.result,
   00133|             })).collect::<Vec<_>>(),
   00134|             "final_answer": self.final_answer,
   00135|         })
   00136|     }
   00137| }
