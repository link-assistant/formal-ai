   00469| /// Mirror the public `formal-ai procedure conformance` command inside the
   00470| /// in-repo sandbox. External Agent CLI runs the binary; this deterministic
   00471| /// driver invokes the same library path without allowing arbitrary executables.
   00472| fn execute_procedure_conformance(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00473|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00474|     if parts.get(..3) != Some(&["formal-ai", "procedure", "conformance"]) {
   00475|         return None;
   00476|     }
   00477|     let artifact = option_value(&parts, "--artifact")?;
   00478|     let trigger = option_value(&parts, "--trigger")?;
   00479|     if artifact != super::procedure::COMPILED_PROCEDURE_PATH {
   00480|         return Some(format!("procedure_artifact_unsupported:{artifact:?}"));
   00481|     }
   00482|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00483|         Ok(document) => document,
   00484|         Err(error) => return Some(format!("procedure_artifact_read_failed:{artifact}:{error}")),
   00485|     };
   00486|     match CompiledProcedure::from_artifact_links_notation(&document) {
   00487|         Ok(procedure) => Some(procedure.conformance_links_notation(trigger)),
   00488|         Err(error) => Some(format!("procedure_artifact_invalid:{error}")),
   00489|     }
   00490| }
