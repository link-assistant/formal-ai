   00403| /// Mirror the public discovery/conformance commands inside the deterministic
   00404| /// in-repo driver. External Agent CLIs invoke the installed binary instead.
   00405| fn execute_algorithm_command(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00406|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00407|     if parts.get(..3) == Some(&["formal-ai", "learn", "algorithms"]) {
   00408|         let from = option_value(&parts, "--from")?;
   00409|         let output = option_value(&parts, "--output")?;
   00410|         if from != super::algorithm_learning::OBSERVATIONS_PATH
   00411|             || output != super::algorithm_learning::DISCOVERY_PATH
   00412|         {
   00413|             return Some(format!(
   00414|                 "algorithm_learning_paths_unsupported:{from:?}:{output:?}"
   00415|             ));
   00416|         }
   00417|         let document = match std::fs::read_to_string(workspace.root().join(from)) {
   00418|             Ok(document) => document,
   00419|             Err(error) => return Some(format!("algorithm_observations_read_failed:{error}")),
   00420|         };
   00421|         let mut memory = MemoryStore::new();
   00422|         memory.replace_from_links_notation(&document);
   00423|         let run = discover_algorithms(&traces_from_memory_events(memory.events()));
   00424|         if let Err(error) = std::fs::write(workspace.root().join(output), run.links_notation()) {
   00425|             return Some(format!("algorithm_artifact_write_failed:{error}"));
   00426|         }
   00427|         return Some(format!(
   00428|             "algorithm_learning_complete:candidates={}:validated={}",
   00429|             run.candidates.len(),
   00430|             run.validated_candidates().len()
   00431|         ));
   00432|     }
   00433|     if parts.get(..3) != Some(&["formal-ai", "algorithm", "conformance"]) {
   00434|         return None;
   00435|     }
   00436|     let artifact = option_value(&parts, "--artifact")?;
   00437|     let trigger = option_value(&parts, "--trigger")?;
   00438|     if artifact != super::algorithm_learning::DISCOVERY_PATH {
   00439|         return Some(format!("algorithm_artifact_unsupported:{artifact:?}"));
   00440|     }
   00441|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00442|         Ok(document) => document,
   00443|         Err(error) => return Some(format!("algorithm_artifact_read_failed:{artifact}:{error}")),
   00444|     };
   00445|     let candidate = match AlgorithmCandidate::from_links_notation(&document) {
   00446|         Ok(candidate) => candidate,
   00447|         Err(error) => return Some(format!("algorithm_artifact_invalid:{error}")),
   00448|     };
   00449|     let mut bindings = std::collections::BTreeMap::new();
   00450|     for (index, part) in parts.iter().enumerate() {
   00451|         if *part != "--binding" {
   00452|             continue;
   00453|         }
   00454|         let Some(binding) = parts.get(index + 1) else {
   00455|             return Some(String::from("algorithm_binding_missing"));
   00456|         };
   00457|         let Some((name, value)) = binding.split_once('=') else {
   00458|             return Some(format!("algorithm_binding_invalid:{binding:?}"));
   00459|         };
   00460|         bindings.insert(name.to_owned(), value.to_owned());
   00461|     }
   00462|     Some(
   00463|         candidate
   00464|             .conformance_links_notation(trigger, &bindings)
   00465|             .unwrap_or_else(|error| format!("algorithm_conformance_failed:{error}")),
   00466|     )
   00467| }
