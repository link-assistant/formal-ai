   00139| /// Drive the agentic loop for `task` using a default sandbox workspace.
   00140| ///
   00141| /// # Errors
   00142| ///
   00143| /// Returns an [`AgentError`] if the isolated workspace cannot be created.
   00144| pub fn run_agentic_task(task: &str) -> Result<DriverOutcome, AgentError> {
   00145|     run_agentic_task_in(task, &AgentWorkspaceConfig::default())
   00146| }
   00147| 
   00148| /// Execute with exactly the caller's advertised tool names, including archived sessions.
   00149| ///
   00150| /// # Errors
   00151| /// Returns an error for unsupported or repeated tools, or an unavailable workspace.
   00152| pub fn run_agentic_task_with_tools(
   00153|     task: &str,
   00154|     tool_names: &[&str],
   00155| ) -> Result<DriverOutcome, AgentError> {
   00156|     run_agentic_task_in_with_tools(task, &AgentWorkspaceConfig::default(), tool_names)
   00157| }
   00158| 
   00159| /// Drive the agentic loop for `task` using the given workspace `config`.
   00160| ///
   00161| /// # Errors
   00162| ///
   00163| /// Returns an [`AgentError`] if the isolated workspace cannot be created.
   00164| pub fn run_agentic_task_in(
   00165|     task: &str,
   00166|     config: &AgentWorkspaceConfig,
   00167| ) -> Result<DriverOutcome, AgentError> {
   00168|     // Agent mode is the explicit opt-in the server's tool gate requires; without
   00169|     // it the server refuses every tool. The driver is that isolated execution
   00170|     // environment, so it opts in.
   00171|     let solver = UniversalSolver::new(SolverConfig {
   00172|         agent_mode: true,
   00173|         ..SolverConfig::default()
   00174|     });
   00175|     let tools = tool_definitions(&DRIVER_TOOLS);
   00176|     let mut workspace = AgentWorkspace::for_prompt(task, config)?;
   00177|     let mut messages = vec![ChatMessage::user(task)];
   00178|     let mut steps = Vec::new();
   00179|     let mut turns = 0usize;
   00180| 
   00181|     loop {
   00182|         if turns >= MAX_TURNS {
   00183|             return Ok(DriverOutcome {
   00184|                 task: task.to_owned(),
   00185|                 steps,
   00186|                 final_answer: String::new(),
   00187|                 turns,
   00188|                 hit_turn_cap: true,
   00189|             });
   00190|         }
   00191|         turns += 1;
   00192| 
   00193|         let request = ChatCompletionRequest {
   00194|             model: None,
   00195|             messages: messages.clone(),
   00196|             temperature: None,
   00197|             stream: false,
   00198|             tools: tools.clone(),
   00199|             tool_choice: None,
   00200|             functions: Vec::new(),
   00201|             function_call: None,
   00202|             stream_options: None,
   00203|         };
   00204|         let completion = create_chat_completion_with_solver(&request, &solver);
   00205|         let Some(choice) = completion.choices.into_iter().next() else {
   00206|             return Ok(DriverOutcome {
   00207|                 task: task.to_owned(),
   00208|                 steps,
   00209|                 final_answer: String::new(),
   00210|                 turns,
   00211|                 hit_turn_cap: false,
   00212|             });
   00213|         };
   00214| 
   00215|         let requested_tools =
   00216|             choice.finish_reason == "tool_calls" && !choice.message.tool_calls.is_empty();
   00217|         if !requested_tools {
   00218|             return Ok(DriverOutcome {
   00219|                 task: task.to_owned(),
   00220|                 steps,
   00221|                 final_answer: choice.message.content.plain_text(),
   00222|                 turns,
   00223|                 hit_turn_cap: false,
   00224|             });
   00225|         }
   00226| 
   00227|         // Execute the requested tool calls, then append the assistant turn
   00228|         // followed by the `tool` results (order matters: the planner maps each
   00229|         // result's `tool_call_id` back to a *prior* assistant `tool_calls` turn).
   00230|         let assistant = choice.message;
   00231|         let mut results = Vec::with_capacity(assistant.tool_calls.len());
   00232|         for call in &assistant.tool_calls {
   00233|             let (result, failed) = execute_tool_call(call, &mut workspace);
   00234|             steps.push(DriverToolStep {
   00235|                 tool: call.function.name.clone(),
   00236|                 arguments: call.function.arguments.clone(),
   00237|                 result: result.clone(),
   00238|             });
   00239|             let message = if failed {
   00240|                 ChatMessage::tool_result_error(call.id.clone(), call.function.name.clone(), result)
   00241|             } else {
   00242|                 ChatMessage::tool_result(call.id.clone(), call.function.name.clone(), result)
   00243|             };
   00244|             results.push(message);
   00245|         }
   00246|         messages.push(assistant);
   00247|         messages.extend(results);
   00248|     }
   00249| }
