   00251| /// Execute one tool call against the offline corpus or the sandbox workspace and
   00252| /// return the textual result to feed back to the server, plus whether the call
   00253| /// failed to produce its output at all (refused, unsupported, or lost) — the
   00254| /// transport fact a real Agent CLI flags with `is_error`.
   00255| fn execute_tool_call(call: &ToolCall, workspace: &mut AgentWorkspace) -> (String, bool) {
   00256|     let arguments: Value = serde_json::from_str(&call.function.arguments).unwrap_or(Value::Null);
   00257|     match call.function.name.as_str() {
   00258|         "web_search" => (corpus::web_search(arg_str(&arguments, "query")), false),
   00259|         "web_fetch" => (corpus::web_fetch(arg_str(&arguments, "url")), false),
   00260|         "read_file" => {
   00261|             let path = arg_str(&arguments, "path");
   00262|             match workspace.read_file(path) {
   00263|                 Ok(content) => {
   00264|                     let body = content
   00265|                         .split('\n')
   00266|                         .enumerate()
   00267|                         .map(|(index, line)| format!("{:05}| {line}", index + 1))
   00268|                         .collect::<Vec<_>>()
   00269|                         .join("\n");
   00270|                     (
   00271|                         super::work_item_steps::fill(
   00272|                             "agent-file-read-frame",
   00273|                             &[
   00274|                                 (concat!("{", "body", "}"), &body),
   00275|                                 ("{lines}", &content.split('\n').count().to_string()),
   00276|                             ],
   00277|                         ),
   00278|                         false,
   00279|                     )
   00280|                 }
   00281|                 Err(error) => (error.to_string(), true),
   00282|             }
   00283|         }
   00284|         "write_file" => {
   00285|             let path = arg_str(&arguments, "path");
   00286|             let content = arg_str(&arguments, "content");
   00287|             workspace.create_file(path, content);
   00288|             (format!("wrote {} byte(s) to {path}", content.len()), false)
   00289|         }
   00290|         "run_command" => {
   00291|             let command = arg_str(&arguments, "command");
   00292|             if let Some(result) = execute_algorithm_command(command, workspace) {
   00293|                 return (result, false);
   00294|             }
   00295|             if let Some(result) = execute_procedure_conformance(command, workspace) {
   00296|                 return (result, false);
   00297|             }
   00298|             workspace.run_command(command);
   00299|             workspace.last_command_result().map_or_else(
   00300|                 || {
   00301|                     (
   00302|                         format!("run_command produced no result for {command:?}"),
   00303|                         true,
   00304|                     )
   00305|                 },
   00306|                 |executed| (format_command_result(executed), false),
   00307|             )
   00308|         }
   00309|         // Plan 16 L2g: the same library the CLI's `--write` runs, executed
   00310|         // against the sandbox workspace — the workspace root plays the
   00311|         // repository root, so `js/…` paths are the ones the plan wrote
   00312|         // there. The report text is rendered from the seed the CLI uses,
   00313|         // and a refusal, wrong root or unreadable source is an error result
   00314|         // so the agent sees the failure instead of a silent no-op.
   00315|         "translate" => {
   00316|             let Some(from) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "from"))
   00317|             else {
   00318|                 return (
   00319|                     "error: translate needs a known from root (js, ts)".to_owned(),
   00320|                     true,
   00321|                 );
   00322|             };
   00323|             let Some(to) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "to"))
   00324|             else {
   00325|                 return (
   00326|                     "error: translate needs a known to root (js, ts)".to_owned(),
   00327|                     true,
   00328|                 );
   00329|             };
   00330|             let path = arg_str(&arguments, "path");
   00331|             let write = arguments
   00332|                 .get("write")
   00333|                 .and_then(serde_json::Value::as_bool)
   00334|                 .unwrap_or(false);
   00335|             let report = if path.is_empty() {
   00336|                 if !write {
   00337|                     return (
   00338|                         "error: a tree translation must set write, or name one path".to_owned(),
   00339|                         true,
   00340|                     );
   00341|                 }
   00342|                 crate::translate_write::write_tree(from, to, workspace.root())
   00343|             } else if write {
   00344|                 crate::translate_write::write_one(from, to, workspace.root(), path)
   00345|             } else {
   00346|                 return translate_without_write(from, to, workspace.root(), path);
   00347|             };
   00348|             let (intent, values) = report.intent();
   00349|             let values = values
   00350|                 .iter()
   00351|                 .map(|(key, value)| (*key, value.as_str()))
   00352|                 .collect::<Vec<_>>();
   00353|             let rendered = crate::seed::render_response(intent, "en", &values)
   00354|                 .unwrap_or_else(|| intent.to_owned());
   00355|             (rendered, report.is_failure())
   00356|         }
   00357|         other => (format!("error: unsupported tool {other}"), true),
   00358|     }
   00359| }
