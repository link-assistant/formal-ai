   00361| /// The read-only half of the translate tool: the result text is the rendered
   00362| /// target itself (the CLI's stdout mode), and every honest gap renders from
   00363| /// the same seed intents the write half uses.
   00364| fn translate_without_write(
   00365|     from: crate::meta_translate::SourceRoot,
   00366|     to: crate::meta_translate::SourceRoot,
   00367|     root: &std::path::Path,
   00368|     repo_relative: &str,
   00369| ) -> (String, bool) {
   00370|     use crate::meta_translate::TranslationOutcome;
   00371|     let report = match std::fs::read_to_string(root.join(repo_relative)) {
   00372|         Ok(source) => match crate::meta_translate::translate(from, to, repo_relative, &source) {
   00373|             TranslationOutcome::Rendered { target, .. } => return (target, false),
   00374|             TranslationOutcome::Refused { refusals } => {
   00375|                 crate::translate_write::WriteReport::Refused {
   00376|                     items: crate::translate_write::refusal_items(repo_relative, &refusals),
   00377|                 }
   00378|             }
   00379|             TranslationOutcome::Pending { .. } => {
   00380|                 crate::translate_write::WriteReport::UnsupportedLeg { from, to }
   00381|             }
   00382|             TranslationOutcome::Invalid { reason } => {
   00383|                 crate::translate_write::WriteReport::Invalid {
   00384|                     path: repo_relative.to_owned(),
   00385|                     reason,
   00386|                 }
   00387|             }
   00388|         },
   00389|         Err(_) => crate::translate_write::WriteReport::Missing {
   00390|             path: repo_relative.to_owned(),
   00391|         },
   00392|     };
   00393|     let (intent, values) = report.intent();
   00394|     let values = values
   00395|         .iter()
   00396|         .map(|(key, value)| (*key, value.as_str()))
   00397|         .collect::<Vec<_>>();
   00398|     let rendered =
   00399|         crate::seed::render_response(intent, "en", &values).unwrap_or_else(|| intent.to_owned());
   00400|     (rendered, true)
   00401| }
