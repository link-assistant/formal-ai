   00420| /// Mirror the public discovery/conformance commands inside the deterministic
   00421| /// in-repo driver. External Agent CLIs invoke the installed binary instead.
   00422| fn execute_algorithm_command(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00423|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00424|     if parts.get(..3) == Some(&["formal-ai", "learn", "algorithms"]) {
   00425|         let from = option_value(&parts, "--from")?;
   00426|         let output = option_value(&parts, "--output")?;
   00427|         if from != super::algorithm_learning::OBSERVATIONS_PATH
   00428|             || output != super::algorithm_learning::DISCOVERY_PATH
   00429|         {
   00430|             return Some(format!(
   00431|                 "algorithm_learning_paths_unsupported:{from:?}:{output:?}"
   00432|             ));
   00433|         }
   00434|         let document = match std::fs::read_to_string(workspace.root().join(from)) {
   00435|             Ok(document) => document,
   00436|             Err(error) => return Some(format!("algorithm_observations_read_failed:{error}")),
   00437|         };
   00438|         let mut memory = MemoryStore::new();
   00439|         memory.replace_from_links_notation(&document);
   00440|         let run = discover_algorithms(&traces_from_memory_events(memory.events()));
   00441|         if let Err(error) = std::fs::write(workspace.root().join(output), run.links_notation()) {
   00442|             return Some(format!("algorithm_artifact_write_failed:{error}"));
   00443|         }
   00444|         return Some(format!(
   00445|             "algorithm_learning_complete:candidates={}:validated={}",
   00446|             run.candidates.len(),
   00447|             run.validated_candidates().len()
   00448|         ));
   00449|     }
   00450|     if parts.get(..3) != Some(&["formal-ai", "algorithm", "conformance"]) {
   00451|         return None;
   00452|     }
   00453|     let artifact = option_value(&parts, "--artifact")?;
   00454|     let trigger = option_value(&parts, "--trigger")?;
   00455|     if artifact != super::algorithm_learning::DISCOVERY_PATH {
   00456|         return Some(format!("algorithm_artifact_unsupported:{artifact:?}"));
   00457|     }
   00458|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00459|         Ok(document) => document,
   00460|         Err(error) => return Some(format!("algorithm_artifact_read_failed:{artifact}:{error}")),
   00461|     };
   00462|     let candidate = match AlgorithmCandidate::from_links_notation(&document) {
   00463|         Ok(candidate) => candidate,
   00464|         Err(error) => return Some(format!("algorithm_artifact_invalid:{error}")),
   00465|     };
   00466|     let mut bindings = std::collections::BTreeMap::new();
   00467|     for (index, part) in parts.iter().enumerate() {
   00468|         if *part != "--binding" {
   00469|             continue;
   00470|         }
   00471|         let Some(binding) = parts.get(index + 1) else {
   00472|             return Some(String::from("algorithm_binding_missing"));
   00473|         };
   00474|         let Some((name, value)) = binding.split_once('=') else {
   00475|             return Some(format!("algorithm_binding_invalid:{binding:?}"));
   00476|         };
   00477|         bindings.insert(name.to_owned(), value.to_owned());
   00478|     }
   00479|     Some(
   00480|         candidate
   00481|             .conformance_links_notation(trigger, &bindings)
   00482|             .unwrap_or_else(|error| format!("algorithm_conformance_failed:{error}")),
   00483|     )
   00484| }
