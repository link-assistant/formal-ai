   00378| /// The read-only half of the translate tool: the result text is the rendered
   00379| /// target itself (the CLI's stdout mode), and every honest gap renders from
   00380| /// the same seed intents the write half uses.
   00381| fn translate_without_write(
   00382|     from: crate::meta_translate::SourceRoot,
   00383|     to: crate::meta_translate::SourceRoot,
   00384|     root: &std::path::Path,
   00385|     repo_relative: &str,
   00386| ) -> (String, bool) {
   00387|     use crate::meta_translate::TranslationOutcome;
   00388|     let report = match std::fs::read_to_string(root.join(repo_relative)) {
   00389|         Ok(source) => match crate::meta_translate::translate(from, to, repo_relative, &source) {
   00390|             TranslationOutcome::Rendered { target, .. } => return (target, false),
   00391|             TranslationOutcome::Refused { refusals } => {
   00392|                 crate::translate_write::WriteReport::Refused {
   00393|                     items: crate::translate_write::refusal_items(repo_relative, &refusals),
   00394|                 }
   00395|             }
   00396|             TranslationOutcome::Pending { .. } => {
   00397|                 crate::translate_write::WriteReport::UnsupportedLeg { from, to }
   00398|             }
   00399|             TranslationOutcome::Invalid { reason } => {
   00400|                 crate::translate_write::WriteReport::Invalid {
   00401|                     path: repo_relative.to_owned(),
   00402|                     reason,
   00403|                 }
   00404|             }
   00405|         },
   00406|         Err(_) => crate::translate_write::WriteReport::Missing {
   00407|             path: repo_relative.to_owned(),
   00408|         },
   00409|     };
   00410|     let (intent, values) = report.intent();
   00411|     let values = values
   00412|         .iter()
   00413|         .map(|(key, value)| (*key, value.as_str()))
   00414|         .collect::<Vec<_>>();
   00415|     let rendered =
   00416|         crate::seed::render_response(intent, "en", &values).unwrap_or_else(|| intent.to_owned());
   00417|     (rendered, true)
   00418| }
