   00171| fn run_agentic_task_in_with_tools(
   00172|     task: &str,
   00173|     config: &AgentWorkspaceConfig,
   00174|     tool_names: &[&str],
   00175| ) -> Result<DriverOutcome, AgentError> {
   00176|     if tool_names.iter().enumerate().any(|(index, name)| {
   00177|         !DRIVER_TOOLS.contains(name) || tool_names[..index].contains(name)
   00178|     }) {
   00179|         return Err(std::io::Error::from(std::io::ErrorKind::InvalidInput).into());
   00180|     }
   00181|     let advertised_tools = tool_names.iter().map(|name| (*name).to_owned()).collect::<Vec<_>>();
   00182|     // Agent mode is the explicit opt-in the server's tool gate requires; without
   00183|     // it the server refuses every tool. The driver is that isolated execution
   00184|     // environment, so it opts in.
   00185|     let solver = UniversalSolver::new(SolverConfig {
   00186|         agent_mode: true,
   00187|         ..SolverConfig::default()
   00188|     });
   00189|     let tools = tool_definitions(tool_names);
   00190|     let mut workspace = AgentWorkspace::for_prompt(task, config)?;
   00191|     let mut messages = vec![ChatMessage::user(task)];
   00192|     let mut steps = Vec::new();
   00193|     let mut turns = 0usize;
   00194| 
   00195|     loop {
   00196|         if turns >= MAX_TURNS {
   00197|             return Ok(DriverOutcome {
   00198|                 task: task.to_owned(),
   00199|                 steps,
   00200|                 final_answer: String::new(),
   00201|                 tools_advertised: advertised_tools.clone(),
   00202|                 turns,
   00203|                 hit_turn_cap: true,
   00204|             });
   00205|         }
   00206|         turns += 1;
   00207| 
   00208|         let request = ChatCompletionRequest {
   00209|             model: None,
   00210|             messages: messages.clone(),
   00211|             temperature: None,
   00212|             stream: false,
   00213|             tools: tools.clone(),
   00214|             tool_choice: None,
   00215|             functions: Vec::new(),
   00216|             function_call: None,
   00217|             stream_options: None,
   00218|         };
   00219|         let completion = create_chat_completion_with_solver(&request, &solver);
   00220|         let Some(choice) = completion.choices.into_iter().next() else {
   00221|             return Ok(DriverOutcome {
   00222|                 task: task.to_owned(),
   00223|                 steps,
   00224|                 final_answer: String::new(),
   00225|                 tools_advertised: advertised_tools.clone(),
   00226|                 turns,
   00227|                 hit_turn_cap: false,
   00228|             });
   00229|         };
   00230| 
   00231|         let requested_tools =
   00232|             choice.finish_reason == "tool_calls" && !choice.message.tool_calls.is_empty();
   00233|         if !requested_tools {
   00234|             return Ok(DriverOutcome {
   00235|                 task: task.to_owned(),
   00236|                 steps,
   00237|                 final_answer: choice.message.content.plain_text(),
   00238|                 tools_advertised: advertised_tools.clone(),
   00239|                 turns,
   00240|                 hit_turn_cap: false,
   00241|             });
   00242|         }
   00243| 
   00244|         // Execute the requested tool calls, then append the assistant turn
   00245|         // followed by the `tool` results (order matters: the planner maps each
   00246|         // result's `tool_call_id` back to a *prior* assistant `tool_calls` turn).
   00247|         let assistant = choice.message;
   00248|         let mut results = Vec::with_capacity(assistant.tool_calls.len());
   00249|         for call in &assistant.tool_calls {
   00250|             let (result, failed) = execute_tool_call(call, &mut workspace);
   00251|             steps.push(DriverToolStep {
   00252|                 tool: call.function.name.clone(),
   00253|                 arguments: call.function.arguments.clone(),
   00254|                 result: result.clone(),
   00255|             });
   00256|             let message = if failed {
   00257|                 ChatMessage::tool_result_error(call.id.clone(), call.function.name.clone(), result)
   00258|             } else {
   00259|                 ChatMessage::tool_result(call.id.clone(), call.function.name.clone(), result)
   00260|             };
   00261|             results.push(message);
   00262|         }
   00263|         messages.push(assistant);
   00264|         messages.extend(results);
   00265|     }
   00266| }
