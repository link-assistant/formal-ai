   00486| /// Mirror the public `formal-ai procedure conformance` command inside the
   00487| /// in-repo sandbox. External Agent CLI runs the binary; this deterministic
   00488| /// driver invokes the same library path without allowing arbitrary executables.
   00489| fn execute_procedure_conformance(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00490|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00491|     if parts.get(..3) != Some(&["formal-ai", "procedure", "conformance"]) {
   00492|         return None;
   00493|     }
