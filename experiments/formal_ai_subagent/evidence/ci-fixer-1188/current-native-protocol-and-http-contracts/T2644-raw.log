   00268| /// Execute one tool call against the offline corpus or the sandbox workspace and
   00269| /// return the textual result to feed back to the server, plus whether the call
   00270| /// failed to produce its output at all (refused, unsupported, or lost) — the
   00271| /// transport fact a real Agent CLI flags with `is_error`.
   00272| fn execute_tool_call(call: &ToolCall, workspace: &mut AgentWorkspace) -> (String, bool) {
   00273|     let arguments: Value = serde_json::from_str(&call.function.arguments).unwrap_or(Value::Null);
   00274|     match call.function.name.as_str() {
   00275|         "web_search" => (corpus::web_search(arg_str(&arguments, "query")), false),
   00276|         "web_fetch" => (corpus::web_fetch(arg_str(&arguments, "url")), false),
   00277|         "read_file" => {
   00278|             let path = arg_str(&arguments, "path");
   00279|             match workspace.read_file(path) {
   00280|                 Ok(content) => {
   00281|                     let body = content
   00282|                         .split('\n')
   00283|                         .enumerate()
   00284|                         .map(|(index, line)| format!("{:05}| {line}", index + 1))
   00285|                         .collect::<Vec<_>>()
   00286|                         .join("\n");
   00287|                     (
   00288|                         super::work_item_steps::fill(
   00289|                             "agent-file-read-frame",
   00290|                             &[
   00291|                                 (concat!("{", "body", "}"), &body),
   00292|                                 ("{lines}", &content.split('\n').count().to_string()),
   00293|                             ],
   00294|                         ),
   00295|                         false,
   00296|                     )
   00297|                 }
   00298|                 Err(error) => (error.to_string(), true),
   00299|             }
   00300|         }
   00301|         "write_file" => {
   00302|             let path = arg_str(&arguments, "path");
   00303|             let content = arg_str(&arguments, "content");
   00304|             workspace.create_file(path, content);
   00305|             (format!("wrote {} byte(s) to {path}", content.len()), false)
   00306|         }
   00307|         "run_command" => {
   00308|             let command = arg_str(&arguments, "command");
   00309|             if let Some(result) = execute_algorithm_command(command, workspace) {
   00310|                 return (result, false);
   00311|             }
   00312|             if let Some(result) = execute_procedure_conformance(command, workspace) {
   00313|                 return (result, false);
   00314|             }
   00315|             workspace.run_command(command);
   00316|             workspace.last_command_result().map_or_else(
   00317|                 || {
   00318|                     (
   00319|                         format!("run_command produced no result for {command:?}"),
   00320|                         true,
   00321|                     )
   00322|                 },
   00323|                 |executed| (format_command_result(executed), false),
   00324|             )
   00325|         }
   00326|         // Plan 16 L2g: the same library the CLI's `--write` runs, executed
   00327|         // against the sandbox workspace — the workspace root plays the
   00328|         // repository root, so `js/…` paths are the ones the plan wrote
   00329|         // there. The report text is rendered from the seed the CLI uses,
   00330|         // and a refusal, wrong root or unreadable source is an error result
   00331|         // so the agent sees the failure instead of a silent no-op.
   00332|         "translate" => {
   00333|             let Some(from) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "from"))
   00334|             else {
   00335|                 return (
   00336|                     "error: translate needs a known from root (js, ts)".to_owned(),
   00337|                     true,
   00338|                 );
   00339|             };
   00340|             let Some(to) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "to"))
   00341|             else {
   00342|                 return (
   00343|                     "error: translate needs a known to root (js, ts)".to_owned(),
   00344|                     true,
   00345|                 );
   00346|             };
   00347|             let path = arg_str(&arguments, "path");
   00348|             let write = arguments
   00349|                 .get("write")
   00350|                 .and_then(serde_json::Value::as_bool)
   00351|                 .unwrap_or(false);
   00352|             let report = if path.is_empty() {
   00353|                 if !write {
   00354|                     return (
   00355|                         "error: a tree translation must set write, or name one path".to_owned(),
   00356|                         true,
   00357|                     );
   00358|                 }
   00359|                 crate::translate_write::write_tree(from, to, workspace.root())
   00360|             } else if write {
   00361|                 crate::translate_write::write_one(from, to, workspace.root(), path)
   00362|             } else {
   00363|                 return translate_without_write(from, to, workspace.root(), path);
   00364|             };
   00365|             let (intent, values) = report.intent();
   00366|             let values = values
   00367|                 .iter()
   00368|                 .map(|(key, value)| (*key, value.as_str()))
   00369|                 .collect::<Vec<_>>();
   00370|             let rendered = crate::seed::render_response(intent, "en", &values)
   00371|                 .unwrap_or_else(|| intent.to_owned());
   00372|             (rendered, report.is_failure())
   00373|         }
   00374|         other => (format!("error: unsupported tool {other}"), true),
   00375|     }
   00376| }
