   00021| 
   00022| use serde::{Deserialize, Serialize};
   00023| use serde_json::{Value, json};
   00024| 
   00025| use super::corpus;
   00026| use crate::agent::{AgentCommandResult, AgentError, AgentWorkspace, AgentWorkspaceConfig};
   00027| use crate::algorithm_discovery::{
   00028|     AlgorithmCandidate, discover_algorithms, traces_from_memory_events,
   00029| };
   00030| use crate::memory::MemoryStore;
   00031| use crate::protocol::{
   00032|     ChatCompletionRequest, ChatMessage, ToolCall, create_chat_completion_with_solver,
   00033| };
   00034| use crate::skill_procedure::CompiledProcedure;
   00035| use crate::solver::{SolverConfig, UniversalSolver};
