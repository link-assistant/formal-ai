   00519| /// Render a command result the way an agentic CLI would surface it: stdout on
   00520| /// success, an annotated error otherwise (so the agent can "understand errors").
   00521| fn format_command_result(result: &AgentCommandResult) -> String {
   00522|     if result.timed_out {
   00523|         return format!("command timed out: {}", result.command);
   00524|     }
   00525|     match result.status_code {
   00526|         Some(0) => result.stdout.clone(),
   00527|         Some(code) => format!(
   00528|             "command exited with status {code}\nstdout:\n{}\nstderr:\n{}",
   00529|             result.stdout, result.stderr
   00530|         ),
   00531|         None => format!(
   00532|             "command terminated without an exit status\nstderr:\n{}",
   00533|             result.stderr
   00534|         ),
   00535|     }
   00536| }
