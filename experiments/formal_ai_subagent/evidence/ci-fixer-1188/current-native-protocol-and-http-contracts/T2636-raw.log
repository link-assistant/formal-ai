   00136| /// Drive the agentic loop for `task` using a default sandbox workspace.
   00137| ///
   00138| /// # Errors
   00139| ///
   00140| /// Returns an [`AgentError`] if the isolated workspace cannot be created.
   00141| pub fn run_agentic_task(task: &str) -> Result<DriverOutcome, AgentError> {
   00142|     run_agentic_task_in(task, &AgentWorkspaceConfig::default())
   00143| }
   00144| 
   00145| /// Drive the agentic loop for `task` using the given workspace `config`.
   00146| ///
   00147| /// # Errors
   00148| ///
   00149| /// Returns an [`AgentError`] if the isolated workspace cannot be created.
   00150| pub fn run_agentic_task_in(
   00151|     task: &str,
   00152|     config: &AgentWorkspaceConfig,
   00153| ) -> Result<DriverOutcome, AgentError> {
   00154|     // Agent mode is the explicit opt-in the server's tool gate requires; without
   00155|     // it the server refuses every tool. The driver is that isolated execution
   00156|     // environment, so it opts in.
   00157|     let solver = UniversalSolver::new(SolverConfig {
   00158|         agent_mode: true,
   00159|         ..SolverConfig::default()
   00160|     });
   00161|     let tools = tool_definitions(&DRIVER_TOOLS);
   00162|     let mut workspace = AgentWorkspace::for_prompt(task, config)?;
   00163|     let mut messages = vec![ChatMessage::user(task)];
   00164|     let mut steps = Vec::new();
   00165|     let mut turns = 0usize;
   00166| 
   00167|     loop {
   00168|         if turns >= MAX_TURNS {
   00169|             return Ok(DriverOutcome {
   00170|                 task: task.to_owned(),
   00171|                 steps,
   00172|                 final_answer: String::new(),
   00173|                 turns,
   00174|                 hit_turn_cap: true,
   00175|             });
   00176|         }
   00177|         turns += 1;
   00178| 
   00179|         let request = ChatCompletionRequest {
   00180|             model: None,
   00181|             messages: messages.clone(),
   00182|             temperature: None,
   00183|             stream: false,
   00184|             tools: tools.clone(),
   00185|             tool_choice: None,
   00186|             functions: Vec::new(),
   00187|             function_call: None,
   00188|             stream_options: None,
   00189|         };
   00190|         let completion = create_chat_completion_with_solver(&request, &solver);
   00191|         let Some(choice) = completion.choices.into_iter().next() else {
   00192|             return Ok(DriverOutcome {
   00193|                 task: task.to_owned(),
   00194|                 steps,
   00195|                 final_answer: String::new(),
   00196|                 turns,
   00197|                 hit_turn_cap: false,
   00198|             });
   00199|         };
   00200| 
   00201|         let requested_tools =
   00202|             choice.finish_reason == "tool_calls" && !choice.message.tool_calls.is_empty();
   00203|         if !requested_tools {
   00204|             return Ok(DriverOutcome {
   00205|                 task: task.to_owned(),
   00206|                 steps,
   00207|                 final_answer: choice.message.content.plain_text(),
   00208|                 turns,
   00209|                 hit_turn_cap: false,
   00210|             });
   00211|         }
   00212| 
   00213|         // Execute the requested tool calls, then append the assistant turn
   00214|         // followed by the `tool` results (order matters: the planner maps each
   00215|         // result's `tool_call_id` back to a *prior* assistant `tool_calls` turn).
   00216|         let assistant = choice.message;
   00217|         let mut results = Vec::with_capacity(assistant.tool_calls.len());
   00218|         for call in &assistant.tool_calls {
   00219|             let (result, failed) = execute_tool_call(call, &mut workspace);
   00220|             steps.push(DriverToolStep {
   00221|                 tool: call.function.name.clone(),
   00222|                 arguments: call.function.arguments.clone(),
   00223|                 result: result.clone(),
   00224|             });
   00225|             let message = if failed {
   00226|                 ChatMessage::tool_result_error(call.id.clone(), call.function.name.clone(), result)
   00227|             } else {
   00228|                 ChatMessage::tool_result(call.id.clone(), call.function.name.clone(), result)
   00229|             };
   00230|             results.push(message);
   00231|         }
   00232|         messages.push(assistant);
   00233|         messages.extend(results);
   00234|     }
   00235| }
