   00347| /// The read-only half of the translate tool: the result text is the rendered
   00348| /// target itself (the CLI's stdout mode), and every honest gap renders from
   00349| /// the same seed intents the write half uses.
   00350| fn translate_without_write(
   00351|     from: crate::meta_translate::SourceRoot,
   00352|     to: crate::meta_translate::SourceRoot,
   00353|     root: &std::path::Path,
   00354|     repo_relative: &str,
   00355| ) -> (String, bool) {
   00356|     use crate::meta_translate::TranslationOutcome;
   00357|     let report = match std::fs::read_to_string(root.join(repo_relative)) {
   00358|         Ok(source) => match crate::meta_translate::translate(from, to, repo_relative, &source) {
   00359|             TranslationOutcome::Rendered { target, .. } => return (target, false),
   00360|             TranslationOutcome::Refused { refusals } => {
   00361|                 crate::translate_write::WriteReport::Refused {
   00362|                     items: crate::translate_write::refusal_items(repo_relative, &refusals),
   00363|                 }
   00364|             }
   00365|             TranslationOutcome::Pending { .. } => {
   00366|                 crate::translate_write::WriteReport::UnsupportedLeg { from, to }
   00367|             }
   00368|             TranslationOutcome::Invalid { reason } => {
   00369|                 crate::translate_write::WriteReport::Invalid {
   00370|                     path: repo_relative.to_owned(),
   00371|                     reason,
   00372|                 }
   00373|             }
   00374|         },
   00375|         Err(_) => crate::translate_write::WriteReport::Missing {
   00376|             path: repo_relative.to_owned(),
   00377|         },
   00378|     };
   00379|     let (intent, values) = report.intent();
   00380|     let values = values
   00381|         .iter()
   00382|         .map(|(key, value)| (*key, value.as_str()))
   00383|         .collect::<Vec<_>>();
   00384|     let rendered =
   00385|         crate::seed::render_response(intent, "en", &values).unwrap_or_else(|| intent.to_owned());
   00386|     (rendered, true)
   00387| }
