   00237| /// Execute one tool call against the offline corpus or the sandbox workspace and
   00238| /// return the textual result to feed back to the server, plus whether the call
   00239| /// failed to produce its output at all (refused, unsupported, or lost) — the
   00240| /// transport fact a real Agent CLI flags with `is_error`.
   00241| fn execute_tool_call(call: &ToolCall, workspace: &mut AgentWorkspace) -> (String, bool) {
   00242|     let arguments: Value = serde_json::from_str(&call.function.arguments).unwrap_or(Value::Null);
   00243|     match call.function.name.as_str() {
   00244|         "web_search" => (corpus::web_search(arg_str(&arguments, "query")), false),
   00245|         "web_fetch" => (corpus::web_fetch(arg_str(&arguments, "url")), false),
   00246|         "read_file" => {
   00247|             let path = arg_str(&arguments, "path");
   00248|             match workspace.read_file(path) {
   00249|                 Ok(content) => {
   00250|                     let body = content
   00251|                         .split('\n')
   00252|                         .enumerate()
   00253|                         .map(|(index, line)| format!("{:05}| {line}", index + 1))
   00254|                         .collect::<Vec<_>>()
   00255|                         .join("\n");
   00256|                     (
   00257|                         super::work_item_steps::fill(
   00258|                             "agent-file-read-frame",
   00259|                             &[
   00260|                                 (concat!("{", "body", "}"), &body),
   00261|                                 ("{lines}", &content.split('\n').count().to_string()),
   00262|                             ],
   00263|                         ),
   00264|                         false,
   00265|                     )
   00266|                 }
   00267|                 Err(error) => (error.to_string(), true),
   00268|             }
   00269|         }
   00270|         "write_file" => {
   00271|             let path = arg_str(&arguments, "path");
   00272|             let content = arg_str(&arguments, "content");
   00273|             workspace.create_file(path, content);
   00274|             (format!("wrote {} byte(s) to {path}", content.len()), false)
   00275|         }
   00276|         "run_command" => {
   00277|             let command = arg_str(&arguments, "command");
   00278|             if let Some(result) = execute_algorithm_command(command, workspace) {
   00279|                 return (result, false);
   00280|             }
   00281|             if let Some(result) = execute_procedure_conformance(command, workspace) {
   00282|                 return (result, false);
   00283|             }
   00284|             workspace.run_command(command);
   00285|             workspace.last_command_result().map_or_else(
   00286|                 || {
   00287|                     (
   00288|                         format!("run_command produced no result for {command:?}"),
   00289|                         true,
   00290|                     )
   00291|                 },
   00292|                 |executed| (format_command_result(executed), false),
   00293|             )
   00294|         }
   00295|         // Plan 16 L2g: the same library the CLI's `--write` runs, executed
   00296|         // against the sandbox workspace — the workspace root plays the
   00297|         // repository root, so `js/…` paths are the ones the plan wrote
   00298|         // there. The report text is rendered from the seed the CLI uses,
   00299|         // and a refusal, wrong root or unreadable source is an error result
   00300|         // so the agent sees the failure instead of a silent no-op.
   00301|         "translate" => {
   00302|             let Some(from) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "from"))
   00303|             else {
   00304|                 return (
   00305|                     "error: translate needs a known from root (js, ts)".to_owned(),
   00306|                     true,
   00307|                 );
   00308|             };
   00309|             let Some(to) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "to"))
   00310|             else {
   00311|                 return (
   00312|                     "error: translate needs a known to root (js, ts)".to_owned(),
   00313|                     true,
   00314|                 );
   00315|             };
   00316|             let path = arg_str(&arguments, "path");
   00317|             let write = arguments
   00318|                 .get("write")
   00319|                 .and_then(serde_json::Value::as_bool)
   00320|                 .unwrap_or(false);
   00321|             let report = if path.is_empty() {
   00322|                 if !write {
   00323|                     return (
   00324|                         "error: a tree translation must set write, or name one path".to_owned(),
   00325|                         true,
   00326|                     );
   00327|                 }
   00328|                 crate::translate_write::write_tree(from, to, workspace.root())
   00329|             } else if write {
   00330|                 crate::translate_write::write_one(from, to, workspace.root(), path)
   00331|             } else {
   00332|                 return translate_without_write(from, to, workspace.root(), path);
   00333|             };
   00334|             let (intent, values) = report.intent();
   00335|             let values = values
   00336|                 .iter()
   00337|                 .map(|(key, value)| (*key, value.as_str()))
   00338|                 .collect::<Vec<_>>();
   00339|             let rendered = crate::seed::render_response(intent, "en", &values)
   00340|                 .unwrap_or_else(|| intent.to_owned());
   00341|             (rendered, report.is_failure())
   00342|         }
   00343|         other => (format!("error: unsupported tool {other}"), true),
   00344|     }
   00345| }
