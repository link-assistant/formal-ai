   00455| /// Mirror the public `formal-ai procedure conformance` command inside the
   00456| /// in-repo sandbox. External Agent CLI runs the binary; this deterministic
   00457| /// driver invokes the same library path without allowing arbitrary executables.
   00458| fn execute_procedure_conformance(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00459|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00460|     if parts.get(..3) != Some(&["formal-ai", "procedure", "conformance"]) {
   00461|         return None;
   00462|     }
   00463|     let artifact = option_value(&parts, "--artifact")?;
   00464|     let trigger = option_value(&parts, "--trigger")?;
   00465|     if artifact != super::procedure::COMPILED_PROCEDURE_PATH {
   00466|         return Some(format!("procedure_artifact_unsupported:{artifact:?}"));
   00467|     }
   00468|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00469|         Ok(document) => document,
   00470|         Err(error) => return Some(format!("procedure_artifact_read_failed:{artifact}:{error}")),
   00471|     };
   00472|     match CompiledProcedure::from_artifact_links_notation(&document) {
   00473|         Ok(procedure) => Some(procedure.conformance_links_notation(trigger)),
   00474|         Err(error) => Some(format!("procedure_artifact_invalid:{error}")),
   00475|     }
   00476| }
