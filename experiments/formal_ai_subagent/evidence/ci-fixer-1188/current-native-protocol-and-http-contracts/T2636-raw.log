   00483| /// OpenAI-shaped function tool definitions for the advertised tool `names`.
   00484| fn tool_definitions(names: &[&str]) -> Vec<Value> {
   00485|     names
   00486|         .iter()
   00487|         .map(|name| {
   00488|             json!({
   00489|                 "type": "function",
   00490|                 "function": { "name": name, "description": tool_description(name) },
   00491|             })
   00492|         })
   00493|         .collect()
