   00389| /// Mirror the public discovery/conformance commands inside the deterministic
   00390| /// in-repo driver. External Agent CLIs invoke the installed binary instead.
   00391| fn execute_algorithm_command(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00392|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00393|     if parts.get(..3) == Some(&["formal-ai", "learn", "algorithms"]) {
   00394|         let from = option_value(&parts, "--from")?;
   00395|         let output = option_value(&parts, "--output")?;
   00396|         if from != super::algorithm_learning::OBSERVATIONS_PATH
   00397|             || output != super::algorithm_learning::DISCOVERY_PATH
   00398|         {
   00399|             return Some(format!(
   00400|                 "algorithm_learning_paths_unsupported:{from:?}:{output:?}"
   00401|             ));
   00402|         }
   00403|         let document = match std::fs::read_to_string(workspace.root().join(from)) {
   00404|             Ok(document) => document,
   00405|             Err(error) => return Some(format!("algorithm_observations_read_failed:{error}")),
   00406|         };
   00407|         let mut memory = MemoryStore::new();
   00408|         memory.replace_from_links_notation(&document);
   00409|         let run = discover_algorithms(&traces_from_memory_events(memory.events()));
   00410|         if let Err(error) = std::fs::write(workspace.root().join(output), run.links_notation()) {
   00411|             return Some(format!("algorithm_artifact_write_failed:{error}"));
   00412|         }
   00413|         return Some(format!(
   00414|             "algorithm_learning_complete:candidates={}:validated={}",
   00415|             run.candidates.len(),
   00416|             run.validated_candidates().len()
   00417|         ));
   00418|     }
   00419|     if parts.get(..3) != Some(&["formal-ai", "algorithm", "conformance"]) {
   00420|         return None;
   00421|     }
   00422|     let artifact = option_value(&parts, "--artifact")?;
   00423|     let trigger = option_value(&parts, "--trigger")?;
   00424|     if artifact != super::algorithm_learning::DISCOVERY_PATH {
   00425|         return Some(format!("algorithm_artifact_unsupported:{artifact:?}"));
   00426|     }
   00427|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00428|         Ok(document) => document,
   00429|         Err(error) => return Some(format!("algorithm_artifact_read_failed:{artifact}:{error}")),
   00430|     };
   00431|     let candidate = match AlgorithmCandidate::from_links_notation(&document) {
   00432|         Ok(candidate) => candidate,
   00433|         Err(error) => return Some(format!("algorithm_artifact_invalid:{error}")),
   00434|     };
   00435|     let mut bindings = std::collections::BTreeMap::new();
   00436|     for (index, part) in parts.iter().enumerate() {
   00437|         if *part != "--binding" {
   00438|             continue;
   00439|         }
   00440|         let Some(binding) = parts.get(index + 1) else {
   00441|             return Some(String::from("algorithm_binding_missing"));
   00442|         };
   00443|         let Some((name, value)) = binding.split_once('=') else {
   00444|             return Some(format!("algorithm_binding_invalid:{binding:?}"));
   00445|         };
   00446|         bindings.insert(name.to_owned(), value.to_owned());
   00447|     }
   00448|     Some(
   00449|         candidate
   00450|             .conformance_links_notation(trigger, &bindings)
   00451|             .unwrap_or_else(|error| format!("algorithm_conformance_failed:{error}")),
   00452|     )
   00453| }
