   00088| impl DriverOutcome {
   00089|     /// A human-readable transcript of the tool calls and how the loop ended.
   00090|     #[must_use]
   00091|     pub fn transcript(&self) -> String {
   00092|         let mut out = String::new();
   00093|         let _ = writeln!(out, "task: {}", self.task);
   00094|         let _ = writeln!(
   00095|             out,
   00096|             "turns: {} (tool calls: {})",
   00097|             self.turns,
   00098|             self.steps.len()
   00099|         );
   00100|         for (index, step) in self.steps.iter().enumerate() {
   00101|             let _ = writeln!(out, "  [{}] {} {}", index + 1, step.tool, step.arguments);
   00102|             let _ = writeln!(out, "      -> {}", preview(&step.result, 200));
   00103|         }
   00104|         if self.hit_turn_cap {
   00105|             let _ = writeln!(out, "(stopped at the {MAX_TURNS}-turn safety cap)");
   00106|         }
   00107|         out
   00108|     }
