   00110|     /// A stable, replayable JSON record of the whole agentic session — the task,
   00111|     /// the tools the CLI advertised, every executed tool call with its arguments
   00112|     /// and result, the turn count, and the final answer. This is the "Agent CLI
   00113|     /// session that solved the task" artifact: it is deterministic (no clock, no
   00114|     /// randomness, no network), so committing it to the repo documents exactly how
   00115|     /// Formal AI drove its own CLI to the solution.
   00116|     #[must_use]
   00117|     pub fn session_json(&self) -> Value {
   00118|         json!({
   00119|             "task": self.task,
   00120|             "driver": "formal-ai in-repo agentic CLI",
   00121|             "server": "formal-ai OpenAI-compatible chat completions",
   00122|             "tools_advertised": DRIVER_TOOLS,
   00123|             "turns": self.turns,
   00124|             "hit_turn_cap": self.hit_turn_cap,
   00125|             "steps": self.steps.iter().map(|step| json!({
   00126|                 "tool": step.tool,
   00127|                 "arguments": serde_json::from_str::<Value>(&step.arguments)
   00128|                     .unwrap_or_else(|_| Value::String(step.arguments.clone())),
   00129|                 "result": step.result,
   00130|             })).collect::<Vec<_>>(),
   00131|             "final_answer": self.final_answer,
   00132|         })
   00133|     }
