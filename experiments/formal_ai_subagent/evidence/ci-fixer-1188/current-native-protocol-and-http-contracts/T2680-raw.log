   <file>
   00001| name: Agent CLI E2E
   00002| 
   00003| # Issue #1081 moved this job out of `.github/workflows/release.yml`. That file
   00004| # had reached 1576 lines against the 1576 its own gate allowed, and every
   00005| # previous overrun had been answered by raising the allowance to whatever the
   00006| # file then measured -- which is how a warning band ends up unable to warn: at
   00007| # 1576 of 1576 the next line added is a failure, and there is no band left in
   00008| # between. The same issue's other fixes would have taken it to 1707. The gate
   00009| # is back to the ordinary 1500-line band, and `release.yml` to 1407 lines.
   00010| #
   00011| # This job was the one to move. It was the largest block in the workflow (312
   00012| # lines and 51 steps, a fifth of the file) and it is a leaf: nothing `needs:`
   00013| # it except the terminal `pipeline-status` gate, so lifting it changes no
   00014| # ordering -- the same argument issue #895 used for `coverage.yml` and issue
   00015| # #1014 for `macos-core-tests.yml`. It also removes a fifth of the surface from
   00016| # the repository's third most conflicted path
   00017| # (`data/meta/merge-conflict-ledger.lino`).
   00018| #
   00019| # The `if:`, `needs:` and `concurrency:` stay behind on the calling job, which
   00020| # is where GitHub evaluates them. What moves is `runs-on`, the cap, and the
   00021| # steps.
   00022| 
   00023| on:
   00024|   workflow_call:
   00025|     inputs:
   00026|       full-replay:
   00027|         description: >-
   00028|           Replay every recorded scenario. `main`, scheduled runs, manual
   00029|           dispatches, and pull requests that change agentic routing pass true;
   00030|           other feature branches run the held-out generalization gates instead
   00031|           (issues #1107 and #1137). Those
   00032|           gates are the ones that fail when the planner has been overfitted to
   00033|           the recorded scenarios, which is the regression a branch can
   00034|           introduce; the remaining steps re-verify scenarios already pinned on
   00035|           `main`, and every one of them still runs before a merge lands.
   00036|         required: false
   00037|         type: boolean
   00038|         default: true
   00039| 
   00040| permissions:
   00041|   contents: read
   00042| 
   00043| # A reusable workflow inherits nothing from its caller's `env:`, so the block
   00044| # below is a copy of `release.yml`'s, narrowed to what these steps read.
   00045| # `RUSTFLAGS: -Dwarnings` is the load-bearing one: dropping it in the move
   00046| # would have left this job compiling without the setting the rest of CI uses,
   00047| # which is a false negative introduced by a refactor meant to remove one.
   00048| env:
   00049|   GIT_CONFIG_COUNT: '1'
   00050|   GIT_CONFIG_KEY_0: init.defaultBranch
   00051|   GIT_CONFIG_VALUE_0: main
   00052|   CARGO_NET_RETRY: '10'
   00053|   CARGO_HTTP_MULTIPLEXING: 'false'
   00054|   CARGO_TERM_COLOR: always
   00055|   FORMAL_AI_CI_VERBOSE: ${{ vars.FORMAL_AI_CI_VERBOSE || 'false' }}
   00056|   RUSTFLAGS: -Dwarnings
   00057| 
   00058| jobs:
   00059|   agent-cli-e2e:
   00060|     name: E2E Tests (agent CLI ↔ formal-ai)${{ matrix.part == 'learning' && ' (method learning)' || matrix.part != 'scenarios' && format(' ({0})', matrix.part) || '' }}
   00061|     runs-on: ubuntu-latest
   00062|     # Issue #1069 raised the cap from 32 to 45 so one job outlasted the 900s
   00063|     # and 600s deadlines of both computer-use steps. R1188-U9 (no job over 30
   00064|     # minutes): each computer-use step now runs in a leg of its own, so a leg
   00065|     # carries at most one of those deadlines (a 17-minute backstop) beside the
   00066|     # shared setup, and every leg fits 30 minutes.
   00067|     timeout-minutes: 30
   00068|     # PR #1188: the full replay took 19-23 minutes in one job, 11.1 of them in
   00069|     # the issue #922 method-learning replay alone (run 37663997662). That step
   00070|     # runs in its own `learning` leg beside the `scenarios` leg; both legs set
   00071|     # up the same toolchain and binary, every other step stays in `scenarios`,
   00072|     # and a branch without the full replay runs the one leg it needs.
   00073|     strategy:
   00074|       fail-fast: false
   00075|       matrix:
   00076|         part: ${{ fromJSON(inputs.full-replay && '["scenarios", "learning", "computer-use-record", "computer-use-generalization"]' || '["scenarios", "computer-use-generalization"]') }}
   00077|     env:
   00078|       LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: "false"
   00079|     steps:
   00080|       - uses: actions/checkout@v7
   00081|         with:
   00082|           persist-credentials: false
   00083|       - name: Skip when identical inputs already passed
   00084|         id: ledger
   00085|         uses: ./.github/actions/green-ledger
   00086|         with:
   00087|           check: agent-cli-e2e-full-replay-${{ inputs.full-replay }}-${{ matrix.part }}
   00088|           paths: >-
   00089|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/agent_cli_e2e experiments/issue_921_hive_mind_full_circle scripts rust/tests/e2e .github/workflows/agent-cli-e2e.yml .github/actions
   00090|           enabled: ${{ github.ref != 'refs/heads/main' }}
   00091|       - name: Setup Rust
   00092|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00093|         uses: dtolnay/rust-toolchain@stable
   00094|       - uses: ./.github/actions/setup-sccache
   00095|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00096|       - uses: ./.github/actions/cache-cargo-registry
   00097|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00098|         with:
   00099|           prefix: agentcli-e2e-
   00100|       - name: Setup Bun
   00101|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00102|         uses: oven-sh/setup-bun@v2
   00103|         with:
   00104|           bun-version-file: .bun-version
   00105|           no-cache: true
   00106|       - name: Install @link-assistant/agent CLI
   00107|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00108|         run: |
   00109|           bun add -g --ignore-scripts @link-assistant/agent
   00110|           echo "$HOME/.bun/bin" >> "$GITHUB_PATH"
   00111|       - name: Install external agent CLIs
   00112|         if: ${{ matrix.part == 'scenarios' && steps.ledger.outputs.already-green != 'true' }}
   00113|         run: |
   00114|           # OpenCode's pinned postinstall selects its platform binary. Trust
   00115|           # only that reviewed package; suppress lifecycle scripts elsewhere.
   00116|           bun add -g --trust opencode-ai@1.18.25
   00117|           # Pinned for the reason experiments/agentic_cli_matrix/clients.lock
   00118|           # gives: a leg must fail because our server changed, not because a CLI
   00119|           # shipped overnight — @openai/codex@0.148.0 drops the ENTER answering
   00120|           # its first-run trust dialog (https://github.com/openai/codex/issues/39487).
   00121|           # Before bumping, run experiments/issue_1021_codex_tui_version.
   00122|           bun add -g --ignore-scripts @anthropic-ai/claude-code@2.1.252 @openai/codex@0.147.0 @google/gemini-cli@0.57.0
   00123|       - uses: ./.github/actions/download-formal-ai-binary
