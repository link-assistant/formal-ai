   00054| // ---- algorithm discovery / algorithm_learning (issue #531) -----------------
   00055| 
   00056| const step = (operation, args) => ({ operation, arguments: [...args].sort(([a], [b]) => (a < b ? -1 : 1)) });
   00057| const trace = (id, subject, format) => ({
   00058|   id,
   00059|   steps: [step('fetch', [['subject', subject]]), step('normalize', [['subject', subject], ['format', format]]), step('persist', [['subject', subject]])],
   00060| });
   00061| const threeRuns = () => discoverAlgorithms([trace('run-alpha', 'alpha', 'json'), trace('run-beta', 'beta', 'json'), trace('run-gamma', 'gamma', 'json')]);
   00062| 
   00063| test('repeated event sequences become a validated parameterized algorithm', () => {
   00064|   const run = threeRuns();
   00065|   assert.ok(run.associative_compression_lossless);
   00066|   assert.ok(run.associative_compression_steps > 0);
   00067|   const candidates = validatedCandidates(run);
   00068|   assert.equal(candidates.length, 1);
   00069|   const [candidate] = candidates;
   00070|   assert.equal(candidate.steps.length, 3);
   00071|   assert.deepEqual(candidate.support_trace_ids, ['run-alpha', 'run-beta']);
   00072|   assert.equal(candidate.held_out.length, 1);
   00073|   assert.ok(candidate.held_out[0].passed);
   00074|   const argument = (index, name) => candidate.steps[index].arguments.find(([key]) => key === name)[1];
   00075|   assert.deepEqual(argument(0, 'subject'), argument(1, 'subject'));
   00076|   assert.ok(argument(0, 'subject').parameter !== undefined);
   00077|   assert.deepEqual(argument(1, 'format'), { constant: 'json' });
   00078| });
   00079| 
   00080| test('held-out constant drift is preserved as a failed candidate', () => {
   00081|   const run = discoverAlgorithms([trace('run-alpha', 'alpha', 'json'), trace('run-beta', 'beta', 'json'), trace('run-gamma', 'gamma', 'xml')]);
   00082|   assert.equal(validatedCandidates(run).length, 0);
   00083|   const candidate = run.candidates.find((entry) => entry.steps.length === 3);
   00084|   assert.equal(candidate.held_out.length, 1);
   00085|   assert.ok(!candidate.held_out[0].passed);
   00086| });
   00087| 
