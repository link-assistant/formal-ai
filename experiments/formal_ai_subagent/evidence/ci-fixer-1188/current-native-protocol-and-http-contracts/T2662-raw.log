   00089|   const [candidate] = validatedCandidates(threeRuns());
   00090|   const document = candidateLinksNotation(candidate);
   00091|   assert.ok(candidatesEqual(candidateFromLinksNotation(document), candidate));
   00092|   const parameter = candidate.steps[0].arguments.find(([key]) => key === 'subject')[1].parameter;
   00093|   const conformance = conformanceLinksNotation(candidate, 'dry-trigger', new Map([[parameter, 'delta']]));
