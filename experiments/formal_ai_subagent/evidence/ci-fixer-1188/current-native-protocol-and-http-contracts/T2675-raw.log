   00101| /// Plan one step and assert it is a single tool call, returning it.
   00102| fn expect_single_call(messages: &[ChatMessage], tools: &[&str]) -> PlannedToolCall {
   00103|     match plan_chat_step(messages, tools) {
   00104|         Some(AgenticPlan::ToolCalls(mut calls)) => {
   00105|             assert_eq!(calls.len(), 1, "the planner emits one call per step");
   00106|             calls.remove(0)
   00107|         }
   00108|         other => panic!("expected a single tool call, got {other:?}"),
   00109|     }
   00110| }
   00111| 
   00112| /// Append the assistant `tool_calls` turn plus the tool's `result`.
   00113| fn answer_tool_call(messages: &mut Vec<ChatMessage>, call: &PlannedToolCall, result: &str) {
   00114|     let id = format!("call_{}", messages.len());
   00115|     messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00116|         id.clone(),
   00117|         call.tool.clone(),
   00118|         call.arguments.clone(),
   00119|     )]));
   00120|     messages.push(ChatMessage::tool_result(id, &call.tool, result));
   00121| }
