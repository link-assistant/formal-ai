   00001| //! The issue-#538 agentic recipe — Formal AI driving its *own* agentic CLI to
   00002| //! make one of its meanings more detailed, reproducing the exact seed data change.
   00003| //!
   00004| //! Issue #468 proved the loop can *formalize a text*. Issue #538 asks the harder,
   00005| //! self-referential question the maintainer set as the project's direction: can
   00006| //! the **same** loop edit Formal AI's own seed knowledge to make a meaning more
   00007| //! detailed? These pins lock that: the deterministic planner walks
   00008| //! search → fetch → write → verify → final for the tomato meaning, and the block
   00009| //! the loop writes is **byte-for-byte** the enriched seed block in
   00010| //! `data/seed/meanings-translation.lino`. So the agentic CLI reproduces the exact
   00011| //! change the issue asked for — not a hand-authored approximation.
   00012| 
   00013| use formal_ai::agentic_coding::{
   00014|     AgenticPlan, CORE_RECIPE_TOOLS, PlannedToolCall, corpus, diagram, is_meaning_detail_task,
   00015|     meaning_detail, plan_chat_step, run_agentic_task, run_agentic_task_with_tools, self_ast,
   00016| };
   00017| use formal_ai::{ChatMessage, ToolCall};
   00018| 
   00019| /// Derive the enriched tomato block from the given fetched text (or the embedded
   00020| /// real Wikidata cache when `None`) — the recipe under test, pinned to the tomato
   00021| /// concept for the tomato-specific assertions.
   00022| fn enrich_tomato_block(fetched: Option<&str>) -> String {
   00023|     meaning_detail::enrich_block(&meaning_detail::TOMATO, fetched)
   00024| }
   00025| 
   00026| /// Extract the enriched tomato meaning block from the seed file — everything from
   00027| /// the `  tomato` lemma head up to (but not including) the next lemma `  cucumber`.
   00028| /// This is the ground truth the agentic loop must reproduce.
   00029| fn seed_tomato_block() -> String {
   00030|     let seed = include_str!("../../../../data/seed/meanings-translation.lino");
   00031|     let start = seed.find("\n  tomato\n").expect("seed has a tomato lemma") + 1; // skip the leading newline so the block starts at `  tomato`
   00032|     let rest = &seed[start..];
   00033|     let end = rest
   00034|         .find("\n  cucumber\n")
   00035|         .expect("cucumber follows tomato")
   00036|         + 1;
   00037|     rest[..end].to_owned()
   00038| }
   00039| 
   00040| /// Extract the enriched potato meaning block from the seed file — everything from
   00041| /// the `  potato` lemma head up to (but not including) the next lemma `  carrot`.
   00042| fn seed_potato_block() -> String {
   00043|     let seed = include_str!("../../../../data/seed/meanings-translation.lino");
   00044|     let start = seed.find("\n  potato\n").expect("seed has a potato lemma") + 1;
   00045|     let rest = &seed[start..];
   00046|     let end = rest.find("\n  carrot\n").expect("carrot follows potato") + 1;
   00047|     rest[..end].to_owned()
   00048| }
