   00417| /// Mirror the public discovery/conformance commands inside the deterministic
   00418| /// in-repo driver. External Agent CLIs invoke the installed binary instead.
   00419| fn execute_algorithm_command(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00420|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00421|     if parts.get(..3) == Some(&["formal-ai", "learn", "algorithms"]) {
   00422|         let from = option_value(&parts, "--from")?;
   00423|         let output = option_value(&parts, "--output")?;
   00424|         if from != super::algorithm_learning::OBSERVATIONS_PATH
   00425|             || output != super::algorithm_learning::DISCOVERY_PATH
   00426|         {
   00427|             return Some(format!(
   00428|                 "algorithm_learning_paths_unsupported:{from:?}:{output:?}"
   00429|             ));
   00430|         }
   00431|         let document = match std::fs::read_to_string(workspace.root().join(from)) {
   00432|             Ok(document) => document,
   00433|             Err(error) => return Some(format!("algorithm_observations_read_failed:{error}")),
   00434|         };
   00435|         let mut memory = MemoryStore::new();
   00436|         memory.replace_from_links_notation(&document);
   00437|         let run = discover_algorithms(&traces_from_memory_events(memory.events()));
   00438|         if let Err(error) = std::fs::write(workspace.root().join(output), run.links_notation()) {
   00439|             return Some(format!("algorithm_artifact_write_failed:{error}"));
   00440|         }
   00441|         return Some(format!(
   00442|             "algorithm_learning_complete:candidates={}:validated={}",
   00443|             run.candidates.len(),
   00444|             run.validated_candidates().len()
   00445|         ));
   00446|     }
   00447|     if parts.get(..3) != Some(&["formal-ai", "algorithm", "conformance"]) {
   00448|         return None;
   00449|     }
   00450|     let artifact = option_value(&parts, "--artifact")?;
   00451|     let trigger = option_value(&parts, "--trigger")?;
   00452|     if artifact != super::algorithm_learning::DISCOVERY_PATH {
   00453|         return Some(format!("algorithm_artifact_unsupported:{artifact:?}"));
   00454|     }
   00455|     let document = match std::fs::read_to_string(workspace.root().join(artifact)) {
   00456|         Ok(document) => document,
   00457|         Err(error) => return Some(format!("algorithm_artifact_read_failed:{artifact}:{error}")),
   00458|     };
   00459|     let candidate = match AlgorithmCandidate::from_links_notation(&document) {
   00460|         Ok(candidate) => candidate,
   00461|         Err(error) => return Some(format!("algorithm_artifact_invalid:{error}")),
   00462|     };
   00463|     let mut bindings = std::collections::BTreeMap::new();
   00464|     for (index, part) in parts.iter().enumerate() {
   00465|         if *part != "--binding" {
   00466|             continue;
   00467|         }
   00468|         let Some(binding) = parts.get(index + 1) else {
   00469|             return Some(String::from("algorithm_binding_missing"));
   00470|         };
   00471|         let Some((name, value)) = binding.split_once('=') else {
   00472|             return Some(format!("algorithm_binding_invalid:{binding:?}"));
   00473|         };
   00474|         bindings.insert(name.to_owned(), value.to_owned());
   00475|     }
   00476|     Some(
   00477|         candidate
   00478|             .conformance_links_notation(trigger, &bindings)
   00479|             .unwrap_or_else(|error| format!("algorithm_conformance_failed:{error}")),
   00480|     )
   00481| }
