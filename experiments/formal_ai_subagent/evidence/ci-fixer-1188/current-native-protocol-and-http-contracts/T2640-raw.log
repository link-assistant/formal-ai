   00037| /// The four capabilities every recipe relies on (`web_search` → `web_fetch` →
   00038| /// `write_file` → `run_command`).
   00039| ///
   00040| /// `DRIVER_TOOLS` is these plus the translator, which a recipe calls only
   00041| /// when it means to turn the js/ts cycle — so a recipe's executed tools pin
   00042| /// against this list, never against the whole advertised surface.
   00043| pub const CORE_RECIPE_TOOLS: [&str; 4] = ["web_search", "web_fetch", "write_file", "run_command"];
   00044| 
   00045| /// The tool set the driver advertises.
   00046| ///
   00047| /// [`CORE_RECIPE_TOOLS`] plus observed workspace reads and the translator so the
   00048| /// agent CLI can turn the js/ts cycle mid-session without shelling out.
   00049| pub const DRIVER_TOOLS: [&str; 6] = [
   00050|     "web_search",
   00051|     "web_fetch",
   00052|     "write_file",
   00053|     "run_command",
   00054|     "translate",
   00055|     "read_file",
   00056| ];
