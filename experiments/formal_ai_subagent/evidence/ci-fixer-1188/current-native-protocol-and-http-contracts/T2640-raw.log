   00483| /// Mirror the public `formal-ai procedure conformance` command inside the
   00484| /// in-repo sandbox. External Agent CLI runs the binary; this deterministic
   00485| /// driver invokes the same library path without allowing arbitrary executables.
   00486| fn execute_procedure_conformance(command: &str, workspace: &AgentWorkspace) -> Option<String> {
   00487|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00488|     if parts.get(..3) != Some(&["formal-ai", "procedure", "conformance"]) {
   00489|         return None;
   00490|     }
   00491|     let artifact = option_value(&parts, "--artifact")?;
   00492|     let trigger = option_value(&parts, "--trigger")?;
   00493|     if artifact != super::procedure::COMPILED_PROCEDURE_PATH {
