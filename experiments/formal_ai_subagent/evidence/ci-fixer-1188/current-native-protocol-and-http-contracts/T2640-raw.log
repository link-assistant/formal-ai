   00553|     match result.status_code {
   00554|         Some(0) => result.stdout.clone(),
   00555|         Some(code) => format!(
   00556|             "command exited with status {code}\nstdout:\n{}\nstderr:\n{}",
   00557|             result.stdout, result.stderr
   00558|         ),
   00559|         None => format!(
   00560|             "command terminated without an exit status\nstderr:\n{}",
   00561|             result.stderr
   00562|         ),
   00563|     }
