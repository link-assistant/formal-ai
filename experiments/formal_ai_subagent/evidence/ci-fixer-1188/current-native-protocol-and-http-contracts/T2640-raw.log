   00171| fn run_agentic_task_in_with_tools(
   00172|     task: &str,
   00173|     config: &AgentWorkspaceConfig,
   00174|     tool_names: &[&str],
   00175| ) -> Result<DriverOutcome, AgentError> {
   00176|     if tool_names.iter().enumerate().any(|(index, name)| {
   00177|         !DRIVER_TOOLS.contains(name) || tool_names[..index].contains(name)
   00178|     }) {
   00179|         return Err(std::io::Error::from(std::io::ErrorKind::InvalidInput).into());
   00180|     }
   00181|     let advertised_tools = tool_names.iter().map(|name| (*name).to_owned()).collect::<Vec<_>>();
   00182|     // Agent mode is the explicit opt-in the server's tool gate requires; without
   00183|     // it the server refuses every tool. The driver is that isolated execution
   00184|     // environment, so it opts in.
   00185|     let solver = UniversalSolver::new(SolverConfig {
   00186|         agent_mode: true,
   00187|         ..SolverConfig::default()
   00188|     });
   00189|     let tools = tool_definitions(&DRIVER_TOOLS);
   00190|     let mut workspace = AgentWorkspace::for_prompt(task, config)?;
   00191|     let mut messages = vec![ChatMessage::user(task)];
   00192|     let mut steps = Vec::new();
   00193|     let mut turns = 0usize;
   00194| 
   00195|     loop {
   00196|         if turns >= MAX_TURNS {
   00197|             return Ok(DriverOutcome {
   00198|                 task: task.to_owned(),
   00199|                 steps,
   00200|                 final_answer: String::new(),
   00201|                 turns,
   00202|                 hit_turn_cap: true,
   00203|             });
   00204|         }
   00205|         turns += 1;
   00206| 
   00207|         let request = ChatCompletionRequest {
   00208|             model: None,
   00209|             messages: messages.clone(),
   00210|             temperature: None,
   00211|             stream: false,
   00212|             tools: tools.clone(),
   00213|             tool_choice: None,
   00214|             functions: Vec::new(),
   00215|             function_call: None,
   00216|             stream_options: None,
   00217|         };
   00218|         let completion = create_chat_completion_with_solver(&request, &solver);
   00219|         let Some(choice) = completion.choices.into_iter().next() else {
   00220|             return Ok(DriverOutcome {
   00221|                 task: task.to_owned(),
   00222|                 steps,
   00223|                 final_answer: String::new(),
   00224|                 turns,
   00225|                 hit_turn_cap: false,
   00226|             });
   00227|         };
   00228| 
   00229|         let requested_tools =
   00230|             choice.finish_reason == "tool_calls" && !choice.message.tool_calls.is_empty();
   00231|         if !requested_tools {
   00232|             return Ok(DriverOutcome {
   00233|                 task: task.to_owned(),
   00234|                 steps,
   00235|                 final_answer: choice.message.content.plain_text(),
   00236|                 turns,
   00237|                 hit_turn_cap: false,
   00238|             });
   00239|         }
   00240| 
   00241|         // Execute the requested tool calls, then append the assistant turn
   00242|         // followed by the `tool` results (order matters: the planner maps each
   00243|         // result's `tool_call_id` back to a *prior* assistant `tool_calls` turn).
   00244|         let assistant = choice.message;
   00245|         let mut results = Vec::with_capacity(assistant.tool_calls.len());
   00246|         for call in &assistant.tool_calls {
   00247|             let (result, failed) = execute_tool_call(call, &mut workspace);
   00248|             steps.push(DriverToolStep {
   00249|                 tool: call.function.name.clone(),
   00250|                 arguments: call.function.arguments.clone(),
   00251|                 result: result.clone(),
   00252|             });
   00253|             let message = if failed {
   00254|                 ChatMessage::tool_result_error(call.id.clone(), call.function.name.clone(), result)
   00255|             } else {
   00256|                 ChatMessage::tool_result(call.id.clone(), call.function.name.clone(), result)
   00257|             };
   00258|             results.push(message);
   00259|         }
   00260|         messages.push(assistant);
   00261|         messages.extend(results);
   00262|     }
   00263| }
