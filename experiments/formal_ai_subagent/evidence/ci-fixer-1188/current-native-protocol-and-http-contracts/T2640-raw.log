   00375| /// The read-only half of the translate tool: the result text is the rendered
   00376| /// target itself (the CLI's stdout mode), and every honest gap renders from
   00377| /// the same seed intents the write half uses.
   00378| fn translate_without_write(
   00379|     from: crate::meta_translate::SourceRoot,
   00380|     to: crate::meta_translate::SourceRoot,
   00381|     root: &std::path::Path,
   00382|     repo_relative: &str,
   00383| ) -> (String, bool) {
   00384|     use crate::meta_translate::TranslationOutcome;
   00385|     let report = match std::fs::read_to_string(root.join(repo_relative)) {
   00386|         Ok(source) => match crate::meta_translate::translate(from, to, repo_relative, &source) {
   00387|             TranslationOutcome::Rendered { target, .. } => return (target, false),
   00388|             TranslationOutcome::Refused { refusals } => {
   00389|                 crate::translate_write::WriteReport::Refused {
   00390|                     items: crate::translate_write::refusal_items(repo_relative, &refusals),
   00391|                 }
   00392|             }
   00393|             TranslationOutcome::Pending { .. } => {
   00394|                 crate::translate_write::WriteReport::UnsupportedLeg { from, to }
   00395|             }
   00396|             TranslationOutcome::Invalid { reason } => {
   00397|                 crate::translate_write::WriteReport::Invalid {
   00398|                     path: repo_relative.to_owned(),
   00399|                     reason,
   00400|                 }
   00401|             }
   00402|         },
   00403|         Err(_) => crate::translate_write::WriteReport::Missing {
   00404|             path: repo_relative.to_owned(),
   00405|         },
   00406|     };
   00407|     let (intent, values) = report.intent();
   00408|     let values = values
   00409|         .iter()
   00410|         .map(|(key, value)| (*key, value.as_str()))
   00411|         .collect::<Vec<_>>();
   00412|     let rendered =
   00413|         crate::seed::render_response(intent, "en", &values).unwrap_or_else(|| intent.to_owned());
   00414|     (rendered, true)
   00415| }
