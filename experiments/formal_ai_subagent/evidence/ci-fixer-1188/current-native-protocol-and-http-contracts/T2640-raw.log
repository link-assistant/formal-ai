   00265| /// Execute one tool call against the offline corpus or the sandbox workspace and
   00266| /// return the textual result to feed back to the server, plus whether the call
   00267| /// failed to produce its output at all (refused, unsupported, or lost) — the
   00268| /// transport fact a real Agent CLI flags with `is_error`.
   00269| fn execute_tool_call(call: &ToolCall, workspace: &mut AgentWorkspace) -> (String, bool) {
   00270|     let arguments: Value = serde_json::from_str(&call.function.arguments).unwrap_or(Value::Null);
   00271|     match call.function.name.as_str() {
   00272|         "web_search" => (corpus::web_search(arg_str(&arguments, "query")), false),
   00273|         "web_fetch" => (corpus::web_fetch(arg_str(&arguments, "url")), false),
   00274|         "read_file" => {
   00275|             let path = arg_str(&arguments, "path");
   00276|             match workspace.read_file(path) {
   00277|                 Ok(content) => {
   00278|                     let body = content
   00279|                         .split('\n')
   00280|                         .enumerate()
   00281|                         .map(|(index, line)| format!("{:05}| {line}", index + 1))
   00282|                         .collect::<Vec<_>>()
   00283|                         .join("\n");
   00284|                     (
   00285|                         super::work_item_steps::fill(
   00286|                             "agent-file-read-frame",
   00287|                             &[
   00288|                                 (concat!("{", "body", "}"), &body),
   00289|                                 ("{lines}", &content.split('\n').count().to_string()),
   00290|                             ],
   00291|                         ),
   00292|                         false,
   00293|                     )
   00294|                 }
   00295|                 Err(error) => (error.to_string(), true),
   00296|             }
   00297|         }
   00298|         "write_file" => {
   00299|             let path = arg_str(&arguments, "path");
   00300|             let content = arg_str(&arguments, "content");
   00301|             workspace.create_file(path, content);
   00302|             (format!("wrote {} byte(s) to {path}", content.len()), false)
   00303|         }
   00304|         "run_command" => {
   00305|             let command = arg_str(&arguments, "command");
   00306|             if let Some(result) = execute_algorithm_command(command, workspace) {
   00307|                 return (result, false);
   00308|             }
   00309|             if let Some(result) = execute_procedure_conformance(command, workspace) {
   00310|                 return (result, false);
   00311|             }
   00312|             workspace.run_command(command);
   00313|             workspace.last_command_result().map_or_else(
   00314|                 || {
   00315|                     (
   00316|                         format!("run_command produced no result for {command:?}"),
   00317|                         true,
   00318|                     )
   00319|                 },
   00320|                 |executed| (format_command_result(executed), false),
   00321|             )
   00322|         }
   00323|         // Plan 16 L2g: the same library the CLI's `--write` runs, executed
   00324|         // against the sandbox workspace — the workspace root plays the
   00325|         // repository root, so `js/…` paths are the ones the plan wrote
   00326|         // there. The report text is rendered from the seed the CLI uses,
   00327|         // and a refusal, wrong root or unreadable source is an error result
   00328|         // so the agent sees the failure instead of a silent no-op.
   00329|         "translate" => {
   00330|             let Some(from) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "from"))
   00331|             else {
   00332|                 return (
   00333|                     "error: translate needs a known from root (js, ts)".to_owned(),
   00334|                     true,
   00335|                 );
   00336|             };
   00337|             let Some(to) = crate::meta_translate::SourceRoot::parse(arg_str(&arguments, "to"))
   00338|             else {
   00339|                 return (
   00340|                     "error: translate needs a known to root (js, ts)".to_owned(),
   00341|                     true,
   00342|                 );
   00343|             };
   00344|             let path = arg_str(&arguments, "path");
   00345|             let write = arguments
   00346|                 .get("write")
   00347|                 .and_then(serde_json::Value::as_bool)
   00348|                 .unwrap_or(false);
   00349|             let report = if path.is_empty() {
   00350|                 if !write {
   00351|                     return (
   00352|                         "error: a tree translation must set write, or name one path".to_owned(),
   00353|                         true,
   00354|                     );
   00355|                 }
   00356|                 crate::translate_write::write_tree(from, to, workspace.root())
   00357|             } else if write {
   00358|                 crate::translate_write::write_one(from, to, workspace.root(), path)
   00359|             } else {
   00360|                 return translate_without_write(from, to, workspace.root(), path);
   00361|             };
   00362|             let (intent, values) = report.intent();
   00363|             let values = values
   00364|                 .iter()
   00365|                 .map(|(key, value)| (*key, value.as_str()))
   00366|                 .collect::<Vec<_>>();
   00367|             let rendered = crate::seed::render_response(intent, "en", &values)
   00368|                 .unwrap_or_else(|| intent.to_owned());
   00369|             (rendered, report.is_failure())
   00370|         }
   00371|         other => (format!("error: unsupported tool {other}"), true),
   00372|     }
   00373| }
