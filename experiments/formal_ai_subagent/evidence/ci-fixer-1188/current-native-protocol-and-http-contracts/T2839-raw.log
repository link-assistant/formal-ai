   00036|         }
   00037|         let result = match tool {
   00038|             "read_file" => {
   00039|                 if path == PLAN_PATH && files.get(path) == Some(&expected) {
   00040|                     stream_observed = true;
   00041|                 }
   00042|                 files.get(path).cloned().unwrap_or_else(|| {
   00043|                     json!({"is_error": true, "error": format!("File not found: {path}")}).to_string()
   00044|                 })
   00045|             }
   00046|             "write_file" => {
   00047|                 assert_eq!(path, PLAN_PATH, "only the auxiliary write is consumed");
   00048|                 let content = arguments["content"].as_str().expect("written stream");
   00049|                 assert_eq!(content, expected, "earlier event bytes must be retained");
   00050|                 files.insert(path.to_owned(), content.to_owned());
