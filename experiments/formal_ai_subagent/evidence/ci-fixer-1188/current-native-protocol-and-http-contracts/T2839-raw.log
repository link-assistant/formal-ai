   00020|         assert_eq!(response["choices"][0]["finish_reason"], "tool_calls");
   00021|         let calls = response["choices"][0]["message"]["tool_calls"]
   00022|             .as_array().expect("actual HTTP tool calls");
   00023|         assert_eq!(calls.len(), 1);
   00024|         let call = &calls[0];
   00025|         let tool = call["function"]["name"].as_str().expect("tool name");
   00026|         let arguments: Value = serde_json::from_str(
   00027|             call["function"]["arguments"].as_str().expect("tool arguments"),
   00028|         ).expect("JSON arguments");
