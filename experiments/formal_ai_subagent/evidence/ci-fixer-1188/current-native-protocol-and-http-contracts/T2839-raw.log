   00030|         assert!(path == PLAN_PATH || path == target, "unexpected path: {arguments}");
   00031|         if tool == "write_file" && path == target {
   00032|             assert!(stream_observed, "target write requires observed retained event");
   00033|             assert_eq!(arguments["content"], plan.content);
   00034|             assert_eq!(files.get(PLAN_PATH), Some(&expected));
