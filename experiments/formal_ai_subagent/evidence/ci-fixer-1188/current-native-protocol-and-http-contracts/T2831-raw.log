   00001| //! Issue #680: over the wire, a web-search / web-fetch *intent* must emit a real
   00002| //! tool call on every surface — not only for a pinned phrasing.
   00003| //!
   00004| //! The unit test `issue_680_intent_routing` proves the planner routes by intent;
   00005| //! this boots a real agent-mode server and asserts the same routing survives the
   00006| //! full HTTP round-trip on all three tool-calling surfaces the CLIs use:
   00007| //!   * OpenAI Chat Completions (`tool_calls` + `finish_reason == "tool_calls"`)
   00008| //!   * OpenAI Responses        (a `function_call` output item)
   00009| //!   * Gemini generateContent  (a `functionCall` part)
   00010| //!
   00011| //! Each surface uses a *different* natural-language request (CONTRIBUTING rule 4)
   00012| //! so a passing run proves the routing is general, not memorised.
   00013| 
   00014| use crate::http_server::{
   00015|     http_post_json, reserve_loopback_port, spawn_formal_ai_server_agent_mode,
   00016| };
   00017| 
   00018| #[path = "../support/http_auxiliary_workspace.rs"]
   00019| mod auxiliary_workspace;
   00020| 
   00021| const TOKEN: Option<&str> = Some("sk-local-agentic-tools");
   00022| 
   00023| /// Chat Completions: a plain web-search request routes to the `web_search` tool.
   00024| #[test]
   00025| fn chat_completions_routes_web_search_intent_to_tool_call() {
   00026|     let port = reserve_loopback_port();
   00027|     let _server = spawn_formal_ai_server_agent_mode(port);
   00028| 
   00029|     let response = http_post_json(
   00030|         port,
   00031|         "/api/openai/v1/chat/completions",
   00032|         TOKEN,
   00033|         &serde_json::json!({
   00034|             "model": "formal-ai",
   00035|             "stream": false,
   00036|             "messages": [{
   00037|                 "role": "user",
   00038|                 "content": "look up the latest news about renewable energy"
   00039|             }],
   00040|             "tools": [
   00041|                 function_tool("web_search"),
   00042|                 function_tool("web_fetch"),
   00043|             ]
   00044|         }),
   00045|     );
   00046| 
   00047|     assert_eq!(response["choices"][0]["finish_reason"], "tool_calls");
   00048|     let call = &response["choices"][0]["message"]["tool_calls"][0];
   00049|     assert_eq!(call["function"]["name"], "web_search");
   00050|     let arguments: serde_json::Value =
   00051|         serde_json::from_str(call["function"]["arguments"].as_str().unwrap()).unwrap();
   00052|     assert!(
   00053|         arguments["query"]
   00054|             .as_str()
   00055|             .is_some_and(|query| !query.trim().is_empty()),
   00056|         "search call should carry a non-empty query: {arguments}"
   00057|     );
   00058| }
