   00079| #[test]
   00080| fn write_emits_only_the_advertised_parameter_names() {
   00081|     for (tool, parameter) in WRITE_SCHEMAS {
   00082|         let arguments = call_arguments(
   00083|             "write 10 to 1.txt file",
   00084|             tool,
   00085|             &json!({
