   00306| #[test]
   00307| fn repeated_read_turns_are_deterministic() {
   00308|     // The same request, asked twice in one session, must plan the same call both
   00309|     // times rather than drifting into a stale-result answer.
   00310|     enable_http_agent_mode_for_current_process();
   00311|     let tools = vec![read_tool()];
   00312|     let mut messages = vec![json!({"role": "user", "content": "read 1.txt"})];
   00313|     let first = next_step(&tools, &messages);
   00314|     let first_call = first["tool_calls"][0]["function"].clone();
   00315| 
   00316|     let calls = first["tool_calls"].as_array().cloned().unwrap();
   00317|     messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00318|     messages.push(json!({"role": "tool", "tool_call_id": calls[0]["id"], "content": "10"}));
   00319|     let answered = next_step(&tools, &messages);
   00320|     messages.push(json!({
   00321|         "role": "assistant",
   00322|         "content": answered["content"].as_str().unwrap_or_default()
   00323|     }));
   00324|     messages.push(json!({"role": "user", "content": "read 1.txt"}));
   00325| 
   00326|     let second = next_step(&tools, &messages);
   00327|     assert_eq!(
   00328|         second["tool_calls"][0]["function"], first_call,
