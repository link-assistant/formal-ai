   00266| #[test]
   00267| fn a_read_never_answers_from_a_previous_turns_tool_result() {
   00268|     // Turn one runs `cat 1.txt` and the client reports "stale". Turn two asks to
   00269|     // read the same file: the planner must issue a *fresh* read rather than
   00270|     // replaying the earlier result.
   00271|     enable_http_agent_mode_for_current_process();
   00272|     let tools = vec![read_tool(), shell_tool()];
   00273|     let mut messages = vec![json!({"role": "user", "content": "execute cat 1.txt"})];
   00274|     let first = next_step(&tools, &messages);
   00275|     let calls = first["tool_calls"]
   00276|         .as_array()
   00277|         .cloned()
   00278|         .expect("the first turn should run the command");
   00279|     messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00280|     messages.push(json!({
   00281|         "role": "tool",
   00282|         "tool_call_id": calls[0]["id"],
   00283|         "content": "stale"
   00284|     }));
   00285|     // Close turn one so its result is history, then open a new user turn.
   00286|     let closing = next_step(&tools, &messages);
   00287|     messages.push(json!({
   00288|         "role": "assistant",
   00289|         "content": closing["content"].as_str().unwrap_or_default()
   00290|     }));
   00291|     messages.push(json!({"role": "user", "content": "read 1.txt"}));
   00292| 
   00293|     let second = next_step(&tools, &messages);
   00294|     let calls = second["tool_calls"].as_array();
   00295|     assert!(
   00296|         calls.is_some_and(|calls| !calls.is_empty()),
   00297|         "a new read turn must issue a fresh tool call, got {second}"
   00298|     );
   00299|     let answer = second["content"].as_str().unwrap_or_default();
   00300|     assert!(
   00301|         !answer.contains("stale"),
   00302|         "a previous turn's result must never answer this one, got {second}"
   00303|     );
   00304| }
