   00382| /// One planning round trip for an in-flight conversation.
   00383| fn next_step(tools: &[Value], messages: &[Value]) -> Value {
   00384|     enable_http_agent_mode_for_current_process();
   00385|     let body = json!({"model": "formal-ai", "messages": messages, "tools": tools});
   00386|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00387|     assert_eq!(response.status_code, 200, "{}", response.body);
   00388|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00389|     response["choices"][0]["message"].clone()
   00390| }
   00391| 
   00392| /// Drive the client tool loop, answering every call with `result`, and return
   00393| /// the `(tool, arguments)` pairs the server asked for.
   00394| fn drive(prompt: &str, tools: &[Value], result: &str, turns: usize) -> Vec<(String, Value)> {
   00395|     let owned = result.to_owned();
   00396|     drive_with(prompt, tools, turns, &mut |_, _| owned.clone())
   00397| }
   00398| 
   00399| /// Drive the client tool loop, delegating each call to `execute`.
   00400| fn drive_with(
   00401|     prompt: &str,
   00402|     tools: &[Value],
   00403|     turns: usize,
   00404|     execute: &mut dyn FnMut(&str, &Value) -> String,
   00405| ) -> Vec<(String, Value)> {
   00406|     enable_http_agent_mode_for_current_process();
   00407|     let mut messages = vec![json!({"role": "user", "content": prompt})];
   00408|     let mut transcript = Vec::new();
   00409|     for _ in 0..turns {
   00410|         let message = next_step(tools, &messages);
   00411|         let Some(calls) = message["tool_calls"].as_array().filter(|c| !c.is_empty()) else {
   00412|             break;
   00413|         };
   00414|         messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00415|         for call in calls {
   00416|             let name = call["function"]["name"].as_str().unwrap_or_default();
   00417|             let arguments: Value =
   00418|                 serde_json::from_str(call["function"]["arguments"].as_str().unwrap_or("{}"))
   00419|                     .unwrap_or(Value::Null);
   00420|             let result = execute(name, &arguments);
   00421|             transcript.push((name.to_owned(), arguments));
   00422|             messages.push(json!({
   00423|                 "role": "tool",
   00424|                 "tool_call_id": call["id"],
   00425|                 "content": result
   00426|             }));
   00427|         }
   00428|     }
   00429|     transcript
   00430| }
   00431| 
   00432| fn call_arguments(prompt: &str, name: &str, parameters: &Value) -> Value {
   00433|     enable_http_agent_mode_for_current_process();
   00434|     let body = json!({
   00435|         "model": "formal-ai",
   00436|         "messages": [{"role": "user", "content": prompt}],
   00437|         "tools": [{
   00438|             "type": "function",
   00439|             "function": {"name": name, "parameters": parameters}
   00440|         }]
   00441|     });
   00442|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00443|     assert_eq!(response.status_code, 200, "{}", response.body);
   00444|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00445|     let call = &response["choices"][0]["message"]["tool_calls"][0];
   00446|     assert_eq!(call["function"]["name"], name, "{response}");
   00447|     serde_json::from_str(call["function"]["arguments"].as_str().unwrap()).unwrap()
   00448| }
