   00083| fn map(structure_ids: &[&str], candidates: Vec<CandidatePart>) -> ConceptMap {
   00084|     let registry = structural_meanings();
   00085|     let structures = structure_ids
   00086|         .iter()
   00087|         .map(|id| {
   00088|             registry
   00089|                 .iter()
   00090|                 .find(|meaning| meaning.id == *id)
   00091|                 .cloned()
   00092|                 .unwrap_or_else(|| StructuralMeaning {
   00093|                     id: (*id).to_owned(),
   00094|                     idiom: String::new(),
   00095|                     grounding: String::new(),
   00096|                 })
   00097|         })
   00098|         .collect();
   00099|     ConceptMap {
   00100|         needs: vec![ConceptRequirement::new(
   00101|             "fixture need",
   00102|             "en",
   00103|             NeedState::Satisfied,
   00104|             structures,
   00105|             candidates,
   00106|         )],
   00107|         evidence: Vec::new(),
   00108|     }
   00109| }
