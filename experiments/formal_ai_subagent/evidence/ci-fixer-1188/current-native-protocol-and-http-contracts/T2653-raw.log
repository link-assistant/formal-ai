   00066|         code: code.map(str::to_owned),
   00067|         callable_name: None,
   00068|         callable_contract: None,
   00069|         source_tests: Vec::new(),
   00070|         license: if kind == "stdlib" {
   00071|             "PSF-2.0"
   00072|         } else {
   00073|             "Apache-2.0"
   00074|         }
   00075|         .to_owned(),
   00076|         source_url: format!("https://source.invalid/{id}"),
   00077|         sha256: "e".repeat(64),
   00078|         fetched_at: "2026-09-15T00:00:00Z".to_owned(),
   00079|         score: 1.0,
   00080|     }
   00081| }
