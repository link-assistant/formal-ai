   00061| #[test]
   00062| fn enriched_block_matches_the_seed_byte_for_byte() {
   00063|     // The heart of the issue: the block re-derived from the fetched Wikidata lexeme
   00064|     // facts is exactly the enriched seed block. If someone hand-edits the seed, this
   00065|     // fails until the recipe is re-derived — the loop and the seed stay in lockstep.
   00066|     let produced = enrich_tomato_block(None);
   00067|     assert_eq!(produced, seed_tomato_block());
   00068| }
