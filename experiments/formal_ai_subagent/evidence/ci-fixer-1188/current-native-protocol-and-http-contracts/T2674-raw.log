   00087| #[test]
   00088| fn fetch_and_canonical_fallback_yield_the_same_block() {
   00089|     // Whether the fetch "succeeds" (returns the corpus body) or errors (falls back
   00090|     // to the canonical facts), the loop derives an identical block — the
   00091|     // determinism invariant the planner relies on.
   00092|     let from_fetch = enrich_tomato_block(Some(
   00093|         corpus::web_fetch(meaning_detail::TOMATO.source_url).as_str(),
   00094|     ));
   00095|     let from_fallback = enrich_tomato_block(Some("web_fetch error: 404 not found"));
   00096|     let from_none = enrich_tomato_block(None);
   00097|     assert_eq!(from_fetch, from_none);
   00098|     assert_eq!(from_fallback, from_none);
   00099| }
