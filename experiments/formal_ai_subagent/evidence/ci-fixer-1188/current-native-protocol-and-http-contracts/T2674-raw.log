   00191| #[test]
   00192| fn driver_runs_the_meaning_detail_loop_and_writes_the_seed_block() {
   00193|     // End-to-end: the in-repo agentic CLI drives the server through the whole loop
   00194|     // and the file it writes into the sandbox is byte-for-byte the enriched seed
   00195|     // block — Formal AI making its own meaning more detailed, offline and
   00196|     // deterministically.
   00197|     let outcome = run_agentic_task(meaning_detail::MEANING_DETAIL_TASK).expect("sandbox workspace");
   00198| 
   00199|     assert!(!outcome.hit_turn_cap, "the loop must finish, not run away");
   00200| 
   00201|     // The recipe executes exactly the four core tools, in canonical order —
   00202|     // the advertised surface additionally carries the translator, which this
   00203|     // recipe never calls.
   00204|     let executed: Vec<&str> = outcome.steps.iter().map(|s| s.tool.as_str()).collect();
   00205|     assert_eq!(executed, CORE_RECIPE_TOOLS.to_vec());
   00206| 
   00207|     // Step 3 writes the enriched block; its JSON content is the seed block.
   00208|     let write = &outcome.steps[2];
   00209|     assert_eq!(write.tool, "write_file");
   00210|     let written: serde_json::Value = serde_json::from_str(&write.arguments).unwrap();
   00211|     assert_eq!(written["content"], seed_tomato_block());
   00212| 
   00213|     // Step 4 reads the file back and observes the grounded plural — proof the write
   00214|     // landed in the workspace.
   00215|     let run = &outcome.steps[3];
   00216|     assert_eq!(run.tool, "run_command");
   00217|     assert!(run.result.contains("томаты"));
   00218|     assert!(run.result.contains("grammatical_number plural"));
   00219| 
   00220|     // The final answer summarises the change with the block inline.
   00221|     assert!(outcome.final_answer.contains("more detailed"));
   00222|     assert!(
   00223|         outcome
   00224|             .final_answer
   00225|             .contains(meaning_detail::TOMATO.kb_path)
   00226|     );
   00227| }
