   00814|           username: ${{ github.actor }}
   00815|           password: ${{ secrets.GITHUB_TOKEN }}
   00816|       - name: Set up Docker Buildx
   00817|         if: |
   00818|           steps.check.outputs.should_release == 'true' && (
   00819|             steps.prepared.outputs.crate_published == 'true' ||
   00820|             steps.publish-crate.outputs.publish_result == 'success'
   00821|           )
   00822|         uses: ./.github/actions/setup-buildx-resilient
   00823|       - name: Extract GHCR Docker metadata
   00824|         if: |
   00825|           steps.check.outputs.should_release == 'true' && (
   00826|             steps.prepared.outputs.crate_published == 'true' ||
