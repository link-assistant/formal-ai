   00747|         env:
   00748|           # Issue #1085 (D3.3): the ledger row names who opened each qualifying
   00749|           # pull request, read through `gh` with the job token.
   00750|           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
   00751|           FORMAL_AI_PULL_REQUEST_AUTHOR_LOOKUP: gh
   00752|         run: |
   00753|           rust-script scripts/version-and-commit.rs \
   00754|             --bump-type "${{ steps.bump_type.outputs.bump_type }}" \
   00755|             --resume-prepared \
   00756|             --branch main
   00757|       - name: Get current version
   00758|         id: current_version
