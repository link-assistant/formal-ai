   00693|       (needs.test-e2e-local.result == 'success' || needs.test-e2e-local.result == 'skipped') &&
   00694|       (needs.test-agent-cli-e2e.result == 'success' || needs.test-agent-cli-e2e.result == 'skipped') &&
   00695|       (needs.server-parity.result == 'success' || needs.server-parity.result == 'skipped')
   00696|     runs-on: ubuntu-latest
   00697|     # Issue #1076 (D5): 50.6 min worst case was 84.4% of the old 60m cap, and
   00698|     # the 45m GHCR budget below must fire before the cap. 90m puts it at 56.2%.
   00699|     timeout-minutes: 90
   00700|     outputs:
   00701|       pages_sha: ${{ steps.release_pages_ref.outputs.sha }}
   00702|       pages_version: ${{ steps.release_pages_ref.outputs.version }}
   00703|     env:
