   00786|           steps.check.outputs.should_release == 'true' && (
   00787|             steps.prepared.outputs.crate_published == 'true' ||
   00788|             steps.publish-crate.outputs.publish_result == 'success'
   00789|           )
   00790|         run: rust-script scripts/wait-for-crate.rs --release-version "${{ steps.current_version.outputs.version }}"
   00791|       - name: Smoke test the published crate
   00792|         if: |
   00793|           steps.check.outputs.should_release == 'true' && (
   00794|             steps.prepared.outputs.crate_published == 'true' ||
   00795|             steps.publish-crate.outputs.publish_result == 'success'
   00796|           )
   00797|         run: scripts/smoke-test-published-crate.sh "${{ steps.current_version.outputs.version }}"
   00798|       - name: Free up runner disk space
   00799|         if: |
   00800|           steps.check.outputs.should_release == 'true' && (
   00801|             steps.prepared.outputs.crate_published == 'true' ||
   00802|             steps.publish-crate.outputs.publish_result == 'success'
