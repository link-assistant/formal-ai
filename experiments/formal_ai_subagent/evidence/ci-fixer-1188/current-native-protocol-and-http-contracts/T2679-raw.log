   00829|         id: ghcr-meta
   00830|         uses: docker/metadata-action@v6
   00831|         with:
   00832|           images: ${{ env.GHCR_IMAGE }}
   00833|           tags: |
   00834|             type=raw,value=latest
   00835|             type=raw,value=${{ steps.current_version.outputs.version }}
   00836|           labels: |
   00837|             org.opencontainers.image.version=${{ steps.current_version.outputs.version }}
   00838|       - name: Publish Docker image to GHCR
   00839|         if: |
   00840|           steps.check.outputs.should_release == 'true' && (
   00841|             steps.prepared.outputs.crate_published == 'true' ||
   00842|             steps.publish-crate.outputs.publish_result == 'success'
   00843|           )
   00844|         # Issue #1076: a step-level cap, unlike the job cap, reports an overrun
   00845|         # as a step *failure*, and run 33955786226 spent 24.6 of the job's 60
   00846|         # minutes here with seven steps pending and nothing red. 45m is 1.4x
