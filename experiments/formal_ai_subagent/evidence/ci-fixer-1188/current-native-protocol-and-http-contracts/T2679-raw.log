   00774|       - name: Verify packaged crate archive
   00775|         if: steps.check.outputs.should_release == 'true'
   00776|         run: cargo package --manifest-path rust/Cargo.toml --locked -p formal-ai
   00777|       - name: Publish to Crates.io
