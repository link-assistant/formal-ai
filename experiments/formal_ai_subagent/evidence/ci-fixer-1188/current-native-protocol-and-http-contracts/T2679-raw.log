   00670|   auto-release:
   00671|     name: Auto Release
   00672|     concurrency:
   00673|       group: formal-ai-repository-writes
   00674|       queue: max
   00675|     needs:
   00676|       [
   00677|         lint,
   00678|         test,
   00679|         build,
   00680|         secrets-scan,
   00681|         test-e2e-local,
   00682|         test-agent-cli-e2e,
