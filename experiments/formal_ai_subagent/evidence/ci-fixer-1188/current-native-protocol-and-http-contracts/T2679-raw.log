   00779|         id: publish-crate
   00780|         env:
   00781|           CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}
   00782|           CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}
   00783|         run: rust-script scripts/publish-crate.rs
   00784|       - name: Wait for Crate availability on Crates.io
