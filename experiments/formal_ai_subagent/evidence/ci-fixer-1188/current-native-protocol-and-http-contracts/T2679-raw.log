   01145|   changelog-pr:
   01146|     name: Create Changelog PR
   01147|     concurrency:
   01148|       group: formal-ai-repository-writes
   01149|       queue: max
   01150|     if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changelog-pr' && github.ref == 'refs/heads/main'
   01151|     runs-on: ubuntu-latest
   01152|     timeout-minutes: 10
   01153|     permissions:
   01154|       contents: write
   01155|       pull-requests: write
   01156|     steps:
   01157|       # The last of this repository's four checkouts that keep their
   01158|       # credential (issue #1079); every other one sets
   01159|       # `persist-credentials: false`. `peter-evans/create-pull-request` below
   01160|       # commits the generated fragment and pushes a new branch, and this job
   01161|       # only runs on `workflow_dispatch`, so the credential exists solely for a
   01162|       # manually triggered release and never on a pull request.
   01163|       - uses: actions/checkout@v7
   01164|         with:
   01165|           fetch-depth: 0
   01166|       - name: Setup Rust
   01167|         uses: dtolnay/rust-toolchain@stable
   01168|       - name: Install rust-script
   01169|         run: bash scripts/install-rust-script.sh
   01170|       - name: Create changelog fragment
   01171|         env:
   01172|           BUMP_TYPE: ${{ github.event.inputs.bump_type }}
   01173|           DESCRIPTION: ${{ github.event.inputs.description }}
   01174|         run: rust-script scripts/create-changelog-fragment.rs --bump-type "$BUMP_TYPE" --description "$DESCRIPTION"
   01175|       - name: Create Pull Request
   01176|         uses: peter-evans/create-pull-request@v8
   01177|         with:
   01178|           token: ${{ secrets.GITHUB_TOKEN }}
   01179|           commit-message: 'chore: add changelog for manual ${{ github.event.inputs.bump_type }} release'
   01180|           branch: changelog-manual-release-${{ github.run_id }}
   01181|           delete-branch: true
   01182|           title: 'chore: manual ${{ github.event.inputs.bump_type }} release'
   01183|           body: |
   01184|             This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.
   01185|             - **Type:** ${{ github.event.inputs.bump_type }}
   01186|             - **Description:** ${{ github.event.inputs.description || 'Manual release' }}
   01187|             - **Triggered by:** @${{ github.actor }}
   01188|             1. Review the changelog fragment in this PR
   01189|             2. Merge this PR to main
   01190|             3. The automated release workflow will publish to crates.io and create a GitHub release
   01191|   test-e2e-local:
   01192|     name: E2E Tests (local web app)
   01193|     concurrency:
   01194|       group: ${{ github.workflow }}-${{ github.ref }}-test-e2e-local
   01195|       cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
   01196|     needs: [detect-changes]
   01197|     if: |
   01198|       !cancelled() && (
   01199|         github.event_name == 'workflow_dispatch' ||
   01200|         needs.detect-changes.outputs.any-code-changed == 'true'
   01201|       )
   01202|     # Issue #1138 moved the 83 lines of steps behind this call into
   01203|     # `.github/workflows/e2e-local.yml`, returning this file to the 1500-line
   01204|     # warning band; the reasoning is in that file's header. The cap moved with
   01205|     # them, because a caller job declares none.
   01206|     uses: ./.github/workflows/e2e-local.yml
   01207|     permissions:
   01208|       contents: read
   01209|   test-agent-cli-e2e:
   01210|     name: E2E Tests (agent CLI ↔ formal-ai)
   01211|     concurrency:
   01212|       group: ${{ github.workflow }}-${{ github.ref }}-test-agent-cli-e2e
   01213|       cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
   01214|     needs: [detect-changes, build-artifacts]
   01215|     if: |
   01216|       !cancelled() && (
   01217|         github.event_name == 'workflow_dispatch' ||
   01218|         needs.detect-changes.outputs.any-code-changed == 'true' ||
   01219|         needs.detect-changes.outputs.rs-changed == 'true' ||
   01220|         needs.detect-changes.outputs.toml-changed == 'true' ||
   01221|         needs.detect-changes.outputs.pipeline-changed == 'true'
   01222|       )
   01223|     # Issue #1081 moved the 51 steps behind this call into their own file; the
   01224|     # reasoning is in its header. The cap moved with them, because a caller job
   01225|     # declares none.
   01226|     uses: ./.github/workflows/agent-cli-e2e.yml
   01227|     # Issue #1107 (item 4): the full replay is 25 of the pipeline's minutes. On
   01228|     # `main`, on a schedule and on manual dispatch it runs in full. Issue #1137
   01229|     # also requires it before merge whenever the PR changes the agentic routing
   01230|     # subsystem, because agent, OpenCode, Claude, and Codex expose different
   01231|     # tools. Other feature branches keep the held-out generalization gates.
   01232|     with:
   01233|       full-replay: ${{ github.ref == 'refs/heads/main' || github.event_name == 'workflow_dispatch' || github.event_name == 'schedule' || (github.event_name == 'pull_request' && needs.detect-changes.outputs.agentic-routing-changed == 'true') }}
   01234|     permissions:
   01235|       contents: read
   01236|   # Build the host binary once for the seven Box image legs. The audited run
   01237|   # compiled the same Linux binary seven times and reported 1,131 cache write
   01238|   # errors across those legs; the available logs do not include backend error
   01239|   # details, so opt-in diagnostics live in the shared sccache setup action.
   01240|   build-artifacts:
   01241|     name: Build binaries and tests
   01242|     concurrency:
   01243|       group: ${{ github.workflow }}-${{ github.ref }}-build-artifacts
   01244|       cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
   01245|     runs-on: ubuntu-latest
   01246|     timeout-minutes: 20
   01247|     needs: [detect-changes]
   01248|     if: |
   01249|       !cancelled() && (
   01250|         github.event_name == 'workflow_dispatch' ||
   01251|         needs.detect-changes.outputs.any-code-changed == 'true' ||
   01252|         needs.detect-changes.outputs.rs-changed == 'true' ||
   01253|         needs.detect-changes.outputs.toml-changed == 'true' ||
   01254|         needs.detect-changes.outputs.pipeline-changed == 'true'
   01255|       )
   01256|     steps:
   01257|       - uses: actions/checkout@v7
   01258|         with:
   01259|           persist-credentials: false
   01260|       - name: Free up runner disk space
   01261|         run: bash scripts/free-runner-disk.sh
   01262|       - name: Setup Rust
   01263|         uses: dtolnay/rust-toolchain@stable
   01264|       - uses: ./.github/actions/setup-sccache
   01265|       - uses: ./.github/actions/cache-cargo-registry
   01266|         with:
   01267|           prefix: artifacts-
   01268|       # Issue #1055: one compile per platform; consumers download the results.
   01269|       - name: Build binaries and test executables
   01270|         run: cargo test --manifest-path rust/Cargo.toml --release --no-run --bins --tests --all-features
   01271|       - name: Collect the build artifacts
   01272|         run: bash scripts/collect-build-artifacts.sh
   01273|       - name: Upload formal-ai binaries
   01274|         uses: actions/upload-artifact@v7
   01275|         with:
   01276|           name: formal-ai-release-binary
   01277|           path: dist/*
   01278|           retention-days: 1
   01279|       - name: Upload test executables
   01280|         uses: actions/upload-artifact@v7
   01281|         with:
   01282|           name: formal-ai-test-executables
   01283|           path: dist/tests
   01284|           retention-days: 1
   01285|   # Issue #932 (follow-up of PR #119): a generated project for a language is
   01286|   # built and run inside the link-foundation/box image that matches that
