   00626|     needs: [lint, test, macos-core-tests, build-artifacts]
   00627|     # Issue #1111: `skipped` is off, not broken; `failure` still blocks.
   00628|     if: ${{ !cancelled() && needs.lint.result == 'success' && needs.test.result == 'success' && (needs.macos-core-tests.result == 'success' || needs.macos-core-tests.result == 'skipped') }}
   00629|     steps:
   00630|       - uses: actions/checkout@v7
   00631|         with:
   00632|           persist-credentials: false
   00633|       - name: Setup Rust
   00634|         uses: dtolnay/rust-toolchain@stable
   00635|       - uses: ./.github/actions/setup-sccache
   00636|       - name: Install rust-script
