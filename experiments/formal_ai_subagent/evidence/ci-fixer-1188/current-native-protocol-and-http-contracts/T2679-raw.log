   00705|       DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
   00706|     permissions:
   00707|       contents: write
   00708|       packages: write
   00709|     steps:
   00710|       # This job and `manual-release` are two of the four checkouts in this
   00711|       # repository that keep their credential (issue #1079); every other one
   00712|       # sets `persist-credentials: false`. `scripts/version-and-commit.rs`
   00713|       # below runs `git push` and `git push --tags` to publish the version
   00714|       # bump, and `scripts/git-config.rs` sets only `user.name`/`user.email`,
   00715|       # so that push authenticates with exactly the credential
   00716|       # `persist-credentials: false` removes. This job requires
   00717|       # `github.event_name == 'push' && github.ref == 'refs/heads/main'` and
