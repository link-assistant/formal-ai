   00070| #[test]
   00071| fn enriched_block_is_grounded_and_adds_the_missing_plural() {
   00072|     let block = enrich_tomato_block(None);
   00073|     // Every surface pins part of speech (6 grounded + 3 extra: hi, zh×2) and every
   00074|     // grounded surface pins grammatical number.
   00075|     assert_eq!(block.matches("part_of_speech noun").count(), 9);
   00076|     assert_eq!(block.matches("grammatical_number singular").count(), 3);
   00077|     assert_eq!(block.matches("grammatical_number plural").count(), 3);
   00078|     // The previously missing Russian plural `томаты` (form L170542-F7) is present…
   00079|     assert!(block.contains("surface L170542-F7"));
   00080|     assert!(block.contains("text томаты"));
   00081|     // …so `томат` now matches its synonym `помидор`, both grounded in Wikidata.
   00082|     assert!(block.contains("grounded-in Q23501"));
   00083|     assert!(block.contains("source-lexeme L170542"));
   00084|     assert!(block.contains("feature Q146786 # wikidata grammatical feature plural"));
   00085| }
