   00123| #[test]
   00124| fn planner_walks_the_full_recipe_for_the_meaning_detail_task() {
   00125|     let tools = ["web_search", "web_fetch", "write_file", "run_command"];
   00126|     let mut messages = vec![ChatMessage::user(meaning_detail::MEANING_DETAIL_TASK)];
   00127| 
   00128|     // Step 1: search for the Wikidata lexeme data.
   00129|     let call = expect_single_call(&messages, &tools);
   00130|     assert_eq!(call.tool, "web_search");
   00131|     assert!(call.arguments.contains(meaning_detail::TOMATO.search_query));
   00132|     answer_tool_call(
   00133|         &mut messages,
   00134|         &call,
   00135|         &corpus::web_search(meaning_detail::TOMATO.search_query),
   00136|     );
   00137| 
   00138|     // Step 2: fetch the tomato lexemes.
   00139|     let call = expect_single_call(&messages, &tools);
   00140|     assert_eq!(call.tool, "web_fetch");
   00141|     assert!(call.arguments.contains(meaning_detail::TOMATO.source_url));
   00142|     answer_tool_call(
   00143|         &mut messages,
   00144|         &call,
   00145|         &corpus::web_fetch(meaning_detail::TOMATO.source_url),
   00146|     );
   00147| 
   00148|     // Step 3: write the enriched meaning block — byte-for-byte the seed block.
   00149|     let call = expect_single_call(&messages, &tools);
   00150|     assert_eq!(call.tool, "write_file");
   00151|     assert!(call.arguments.contains(meaning_detail::TOMATO.kb_path));
   00152|     let written: serde_json::Value = serde_json::from_str(&call.arguments).unwrap();
   00153|     assert_eq!(written["content"], seed_tomato_block());
   00154|     answer_tool_call(&mut messages, &call, "wrote meanings-tomato-detail.lino");
   00155| 
   00156|     // Step 4: verify by reading the file back.
   00157|     let call = expect_single_call(&messages, &tools);
   00158|     assert_eq!(call.tool, "run_command");
   00159|     assert!(call.arguments.contains(meaning_detail::TOMATO.kb_path));
   00160|     answer_tool_call(&mut messages, &call, &seed_tomato_block());
   00161| 
   00162|     // Step 5: the recipe is exhausted — the final answer carries the block inline.
   00163|     match plan_chat_step(&messages, &tools) {
   00164|         Some(AgenticPlan::Final(answer)) => {
   00165|             assert!(answer.contains("more detailed"));
   00166|             assert!(answer.contains("томаты"));
   00167|             assert!(answer.contains(meaning_detail::TOMATO.kb_path));
   00168|         }
   00169|         other => panic!("expected a final answer, got {other:?}"),
   00170|     }
   00171| }
