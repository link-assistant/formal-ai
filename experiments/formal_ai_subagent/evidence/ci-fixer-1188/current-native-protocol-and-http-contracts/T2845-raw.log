   00309| #[test]
   00310| fn repeated_read_turns_are_deterministic() {
   00311|     // The same request, asked twice in one session, must plan the same call both
   00312|     // times rather than drifting into a stale-result answer.
   00313|     enable_http_agent_mode_for_current_process();
   00314|     let tools = vec![read_tool()];
   00315|     let mut messages = vec![json!({"role": "user", "content": "read 1.txt"})];
   00316|     let first = next_step(&tools, &messages);
   00317|     let first_call = first["tool_calls"][0]["function"].clone();
   00318| 
   00319|     let calls = first["tool_calls"].as_array().cloned().unwrap();
   00320|     messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00321|     messages.push(json!({"role": "tool", "tool_call_id": calls[0]["id"], "content": "10"}));
   00322|     let answered = next_step(&tools, &messages);
   00323|     messages.push(json!({
   00324|         "role": "assistant",
   00325|         "content": answered["content"].as_str().unwrap_or_default()
   00326|     }));
   00327|     messages.push(json!({"role": "user", "content": "read 1.txt"}));
   00328| 
   00329|     let second = next_step(&tools, &messages);
   00330|     assert_eq!(
   00331|         second["tool_calls"][0]["function"], first_call,
   00332|         "the same request must plan the same call, got {second}"
   00333|     );
   00334| }
