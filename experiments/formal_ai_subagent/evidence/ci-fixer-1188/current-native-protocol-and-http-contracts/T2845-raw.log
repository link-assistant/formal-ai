   00385| /// One planning round trip for an in-flight conversation.
   00386| fn next_step(tools: &[Value], messages: &[Value]) -> Value {
   00387|     enable_http_agent_mode_for_current_process();
   00388|     let body = json!({"model": "formal-ai", "messages": messages, "tools": tools});
   00389|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00390|     assert_eq!(response.status_code, 200, "{}", response.body);
   00391|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00392|     response["choices"][0]["message"].clone()
   00393| }
   00394| 
   00395| /// Drive the client tool loop, answering every call with `result`, and return
   00396| /// the `(tool, arguments)` pairs the server asked for.
   00397| fn drive(prompt: &str, tools: &[Value], result: &str, turns: usize) -> Vec<(String, Value)> {
   00398|     let owned = result.to_owned();
   00399|     drive_with(prompt, tools, turns, &mut |_, _| owned.clone())
   00400| }
   00401| 
   00402| /// Drive the client tool loop, delegating each call to `execute`.
   00403| fn drive_with(
   00404|     prompt: &str,
   00405|     tools: &[Value],
   00406|     turns: usize,
   00407|     execute: &mut dyn FnMut(&str, &Value) -> String,
   00408| ) -> Vec<(String, Value)> {
   00409|     enable_http_agent_mode_for_current_process();
   00410|     let mut messages = vec![json!({"role": "user", "content": prompt})];
   00411|     let mut transcript = Vec::new();
   00412|     for _ in 0..turns {
   00413|         let message = next_step(tools, &messages);
   00414|         let Some(calls) = message["tool_calls"].as_array().filter(|c| !c.is_empty()) else {
   00415|             break;
   00416|         };
   00417|         messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00418|         for call in calls {
   00419|             let name = call["function"]["name"].as_str().unwrap_or_default();
   00420|             let arguments: Value =
   00421|                 serde_json::from_str(call["function"]["arguments"].as_str().unwrap_or("{}"))
   00422|                     .unwrap_or(Value::Null);
   00423|             let result = execute(name, &arguments);
   00424|             transcript.push((name.to_owned(), arguments));
   00425|             messages.push(json!({
   00426|                 "role": "tool",
   00427|                 "tool_call_id": call["id"],
   00428|                 "content": result
   00429|             }));
   00430|         }
   00431|     }
   00432|     transcript
   00433| }
   00434| 
   00435| fn call_arguments(prompt: &str, name: &str, parameters: &Value) -> Value {
   00436|     enable_http_agent_mode_for_current_process();
   00437|     let body = json!({
   00438|         "model": "formal-ai",
   00439|         "messages": [{"role": "user", "content": prompt}],
   00440|         "tools": [{
   00441|             "type": "function",
   00442|             "function": {"name": name, "parameters": parameters}
   00443|         }]
   00444|     });
   00445|     let response = handle_api_request("POST", "/v1/chat/completions", &body.to_string());
   00446|     assert_eq!(response.status_code, 200, "{}", response.body);
   00447|     let response: Value = serde_json::from_str(&response.body).unwrap();
   00448|     let call = &response["choices"][0]["message"]["tool_calls"][0];
   00449|     assert_eq!(call["function"]["name"], name, "{response}");
   00450|     serde_json::from_str(call["function"]["arguments"].as_str().unwrap()).unwrap()
   00451| }
