   00269| #[test]
   00270| fn a_read_never_answers_from_a_previous_turns_tool_result() {
   00271|     // Turn one runs `cat 1.txt` and the client reports "stale". Turn two asks to
   00272|     // read the same file: the planner must issue a *fresh* read rather than
   00273|     // replaying the earlier result.
   00274|     enable_http_agent_mode_for_current_process();
   00275|     let tools = vec![read_tool(), shell_tool()];
   00276|     let mut messages = vec![json!({"role": "user", "content": "execute cat 1.txt"})];
   00277|     let first = next_step(&tools, &messages);
   00278|     let calls = first["tool_calls"]
   00279|         .as_array()
   00280|         .cloned()
   00281|         .expect("the first turn should run the command");
   00282|     messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00283|     messages.push(json!({
   00284|         "role": "tool",
   00285|         "tool_call_id": calls[0]["id"],
   00286|         "content": "stale"
   00287|     }));
   00288|     // Close turn one so its result is history, then open a new user turn.
   00289|     let closing = next_step(&tools, &messages);
   00290|     messages.push(json!({
   00291|         "role": "assistant",
   00292|         "content": closing["content"].as_str().unwrap_or_default()
   00293|     }));
   00294|     messages.push(json!({"role": "user", "content": "read 1.txt"}));
   00295| 
   00296|     let second = next_step(&tools, &messages);
   00297|     let calls = second["tool_calls"].as_array();
   00298|     assert!(
   00299|         calls.is_some_and(|calls| !calls.is_empty()),
   00300|         "a new read turn must issue a fresh tool call, got {second}"
   00301|     );
   00302|     let answer = second["content"].as_str().unwrap_or_default();
   00303|     assert!(
   00304|         !answer.contains("stale"),
   00305|         "a previous turn's result must never answer this one, got {second}"
   00306|     );
   00307| }
