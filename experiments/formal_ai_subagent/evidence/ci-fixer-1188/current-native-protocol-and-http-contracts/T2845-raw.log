   00193| #[test]
   00194| fn a_multi_turn_lifecycle_reads_back_the_current_content_each_time() {
   00195|     // create -> read back -> overwrite -> read back, all in one session with a
   00196|     // client loop that applies writes and answers reads from a scratch
   00197|     // workspace. Each read turn must reflect the *current* bytes, never a value
   00198|     // captured by an earlier turn (issue #755, read/list determinism).
   00199|     use std::collections::HashMap;
   00200|     enable_http_agent_mode_for_current_process();
   00201|     let tools = vec![write_tool(&strict_write_schema()), read_tool()];
   00202|     let workspace: std::cell::RefCell<HashMap<String, String>> =
   00203|         std::cell::RefCell::new(HashMap::new());
   00204|     let mut messages: Vec<Value> = Vec::new();
   00205| 
   00206|     let run_turn = |messages: &mut Vec<Value>, prompt: &str| -> String {
   00207|         messages.push(json!({"role": "user", "content": prompt}));
   00208|         let mut last_read = String::new();
   00209|         for _ in 0..6 {
   00210|             let message = next_step(&tools, messages);
   00211|             let Some(calls) = message["tool_calls"].as_array().filter(|c| !c.is_empty()) else {
   00212|                 messages.push(json!({
   00213|                     "role": "assistant",
   00214|                     "content": message["content"].as_str().unwrap_or_default()
   00215|                 }));
   00216|                 break;
   00217|             };
   00218|             messages.push(json!({"role": "assistant", "tool_calls": calls}));
   00219|             for call in calls {
   00220|                 let name = call["function"]["name"].as_str().unwrap_or_default();
   00221|                 let args: Value =
   00222|                     serde_json::from_str(call["function"]["arguments"].as_str().unwrap_or("{}"))
   00223|                         .unwrap_or(Value::Null);
   00224|                 let result = match name {
   00225|                     "Write" => {
   00226|                         let path = args["file_path"].as_str().unwrap_or_default().to_owned();
   00227|                         let content = args["content"].as_str().unwrap_or_default().to_owned();
   00228|                         workspace.borrow_mut().insert(path, content);
   00229|                         String::from("ok")
   00230|                     }
   00231|                     "Read" => {
   00232|                         let path = args["file_path"].as_str().unwrap_or_default();
   00233|                         let content = workspace.borrow().get(path).cloned();
   00234|                         if let Some(content) = content {
   00235|                             if path == "1.txt" { last_read = content.clone(); }
   00236|                             content
   00237|                         } else {
   00238|                             json!({"is_error": true, "error": format!("File not found: {path}")}).to_string()
   00239|                         }
   00240|                     }
   00241|                     _ => String::new(),
   00242|                 };
   00243|                 messages.push(json!({
   00244|                     "role": "tool",
   00245|                     "tool_call_id": call["id"],
   00246|                     "content": result
   00247|                 }));
   00248|             }
   00249|         }
   00250|         last_read
   00251|     };
   00252| 
   00253|     run_turn(&mut messages, "write 10 to 1.txt file");
   00254|     assert_eq!(
   00255|         workspace.borrow().get("1.txt").map(String::as_str),
   00256|         Some("10")
   00257|     );
   00258|     assert_eq!(run_turn(&mut messages, "read 1.txt"), "10");
   00259| 
   00260|     run_turn(&mut messages, "write 20 to 1.txt file");
   00261|     assert_eq!(
   00262|         workspace.borrow().get("1.txt").map(String::as_str),
   00263|         Some("20")
   00264|     );
   00265|     // The second read must reflect the overwrite, not replay the first read's 10.
   00266|     assert_eq!(run_turn(&mut messages, "read 1.txt"), "20");
   00267| }
