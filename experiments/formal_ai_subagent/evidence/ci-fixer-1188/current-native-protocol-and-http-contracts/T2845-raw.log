   00156| #[test]
   00157| fn the_whole_write_read_task_persists_and_reads_back_the_users_content() {
   00158|     // create -> read back, driven end to end through the protocol with a client
   00159|     // loop that actually applies the writes to a scratch workspace.
   00160|     let tools = vec![write_tool(&strict_write_schema()), read_tool()];
   00161|     let plan = formal_ai::agentic_coding::general_planner::compose_general_change_plan("write 10 to 1.txt file").expect("original literal write plan");
   00162|     let plan_path = formal_ai::agentic_coding::general_planner::PLAN_PATH;
   00163|     let prior = "earlier observed fixture event\n";
   00164|     let mut workspace: Vec<(String, String)> = vec![(plan_path.to_owned(), prior.to_owned())];
   00165|     let transcript = drive_with(
   00166|         "write 10 to 1.txt file",
   00167|         &tools,
   00168|         6,
   00169|         &mut |name, arguments| match name {
   00170|             "Write" => {
   00171|                 let path = arguments["file_path"].as_str().unwrap_or_default();
   00172|                 let content = arguments["content"].as_str().unwrap_or_default();
   00173|                 workspace.push((path.to_owned(), content.to_owned()));
   00174|                 String::from("ok")
   00175|             }
   00176|             "Read" => {
   00177|                 let path = arguments["file_path"].as_str().expect("advertised read path");
   00178|                 workspace.iter().rev().find(|(written, _)| written == path)
   00179|                     .map_or_else(|| json!({"is_error": true, "error": format!("File not found: {path}")}).to_string(), |(_, content)| content.clone())
   00180|             }
   00181|             other => panic!("unadvertised workspace operation: {other}"),
   00182|         },
   00183|     );
   00184|     assert!(!transcript.is_empty(), "the request should drive a write");
   00185|     assert!(
   00186|         workspace
   00187|             .iter()
   00188|             .any(|(path, content)| path == "1.txt" && content == "10"),
   00189|         "the user's file must receive the user's content, wrote {workspace:?}"
   00190|     );
   00191| }
