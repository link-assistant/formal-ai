   00001| //! Regression coverage for issue #755: file read and write over the agentic
   00002| //! protocol.
   00003| //!
   00004| //! Three defects are pinned here:
   00005| //!
   00006| //! 1. **Read/Write parameter names.** The emitted arguments must contain exactly
   00007| //!    the keys the client advertised — no `{filePath, file_path, path}` shotgun
   00008| //!    that a `additionalProperties: false` schema rejects, and no missing
   00009| //!    `absolute_path` that qwen requires.
   00010| //! 2. **The write target.** A `write X to F` request must persist the *user's*
   00011| //!    content to the *user's* file. The internal plan artifact may not preempt
   00012| //!    or block that write.
   00013| //! 3. **Read/list determinism.** A tool result produced for an *earlier* user
   00014| //!    turn may never be replayed as the answer to the current one.
   00015| 
   00016| use formal_ai::server::{enable_http_agent_mode_for_current_process, handle_api_request};
   00017| use serde_json::{Value, json};
   00018| 
   00019| /// The read tool as each supported CLI advertises it, with the single parameter
   00020| /// name that CLI declares. Claude is listed for the projection assertions only;
   00021| /// the driven sweep below excludes it, exactly as the issue asks.
   00022| const READ_SCHEMAS: &[(&str, &str)] = &[
   00023|     ("Read", "file_path"),
   00024|     ("read_file", "absolute_path"),
   00025|     ("read_file", "path"),
   00026|     ("read_file", "filePath"),
   00027| ];
   00028| 
   00029| /// The write tool as each supported CLI advertises its path parameter.
   00030| const WRITE_SCHEMAS: &[(&str, &str)] = &[
   00031|     ("Write", "file_path"),
   00032|     ("write_file", "path"),
   00033|     ("write", "filePath"),
   00034|     ("create_file", "file_path"),
   00035| ];
   00036| 
   00037| /// "write 10 to 1.txt" in every language the seed lexicon covers, so a passing
   00038| /// sweep proves the routing is seed-driven rather than English-only.
   00039| const WRITE_REQUESTS: &[(&str, &str)] = &[
   00040|     ("en", "write 10 to 1.txt file"),
   00041|     ("ru", "создай файл 1.txt с текстом 10"),
   00042|     ("hi", "बनाओ 1.txt जिसमें लिखा हो 10"),
   00043|     ("zh", "创建 文件 1.txt 内容为 10"),
   00044| ];
   00045| 
   00046| #[test]
   00047| fn read_emits_only_the_advertised_parameter_name() {
   00048|     for (tool, parameter) in READ_SCHEMAS {
   00049|         let arguments = call_arguments(
   00050|             "read 1.txt",
   00051|             tool,
   00052|             &json!({
   00053|                 "type": "object",
   00054|                 "properties": {(*parameter): {"type": "string"}},
   00055|                 "required": [*parameter],
   00056|                 "additionalProperties": false
   00057|             }),
   00058|         );
   00059|         let object = arguments.as_object().expect("object arguments");
   00060|         assert_eq!(
   00061|             object.len(),
   00062|             1,
   00063|             "{tool} declares only `{parameter}`, got {arguments}"
   00064|         );
   00065|         let path = object[*parameter].as_str().expect("string path");
   00066|         assert!(
   00067|             path.ends_with("1.txt"),
   00068|             "{tool}.{parameter} should name the requested file, got {arguments}"
   00069|         );
   00070|         if *parameter == "absolute_path" {
   00071|             assert!(
   00072|                 std::path::Path::new(path).is_absolute(),
   00073|                 "{tool} declares an absolute path, got {arguments}"
   00074|             );
   00075|         }
   00076|     }
   00077| }
