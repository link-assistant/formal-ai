   00058| /** Mirrors the Rust tests' `answer_tool_call`. */
   00059| function answerCall(messages, call, result) {
   00060|   const id = `call_${messages.length}`;
   00061|   messages.push(callMessage(id, call.tool, call.arguments));
   00062|   messages.push(toolResult(id, call.tool, result));
   00063| }
   00064| const single = (plan) => {
   00065|   assert.equal(plan?.kind, 'tool_calls', JSON.stringify(plan)?.slice(0, 400));
