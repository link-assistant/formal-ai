   00463| /** Every `.rs` file under rust/src, enumerated independently of the port. */
   00464| function rustSourcePaths(dir = 'rust/src') {
   00465|   const out = [];
   00466|   for (const name of readdirSync(new URL(dir, ROOT))) {
   00467|     const path = `${dir}/${name}`;
   00468|     if (statSync(new URL(path, ROOT)).isDirectory()) out.push(...rustSourcePaths(path));
   00469|     else if (name.endsWith('.rs')) out.push(path.slice('rust/'.length));
   00470|   }
   00471|   return out;
   00472| }
   00473| const utf8 = (text) => new TextEncoder().encode(text).length;
