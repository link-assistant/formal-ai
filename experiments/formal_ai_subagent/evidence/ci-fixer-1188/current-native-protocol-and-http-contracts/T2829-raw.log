   00001| //! Issue #680: over the wire, a web-search / web-fetch *intent* must emit a real
   00002| //! tool call on every surface — not only for a pinned phrasing.
   00003| //!
   00004| //! The unit test `issue_680_intent_routing` proves the planner routes by intent;
   00005| //! this boots a real agent-mode server and asserts the same routing survives the
   00006| //! full HTTP round-trip on all three tool-calling surfaces the CLIs use:
   00007| //!   * OpenAI Chat Completions (`tool_calls` + `finish_reason == "tool_calls"`)
   00008| //!   * OpenAI Responses        (a `function_call` output item)
   00009| //!   * Gemini generateContent  (a `functionCall` part)
   00010| //!
   00011| //! Each surface uses a *different* natural-language request (CONTRIBUTING rule 4)
   00012| //! so a passing run proves the routing is general, not memorised.
   00013| 
   00014| use crate::http_server::{
   00015|     http_post_json, reserve_loopback_port, spawn_formal_ai_server_agent_mode,
   00016| };
   00017| 
   00018| const TOKEN: Option<&str> = Some("sk-local-agentic-tools");
   00019| 
   00020| /// Chat Completions: a plain web-search request routes to the `web_search` tool.
   00021| #[test]
   00022| fn chat_completions_routes_web_search_intent_to_tool_call() {
   00023|     let port = reserve_loopback_port();
   00024|     let _server = spawn_formal_ai_server_agent_mode(port);
   00025| 
   00026|     let response = http_post_json(
   00027|         port,
   00028|         "/api/openai/v1/chat/completions",
   00029|         TOKEN,
   00030|         &serde_json::json!({
   00031|             "model": "formal-ai",
   00032|             "stream": false,
   00033|             "messages": [{
   00034|                 "role": "user",
   00035|                 "content": "look up the latest news about renewable energy"
   00036|             }],
   00037|             "tools": [
   00038|                 function_tool("web_search"),
   00039|                 function_tool("web_fetch"),
   00040|             ]
   00041|         }),
   00042|     );
   00043| 
   00044|     assert_eq!(response["choices"][0]["finish_reason"], "tool_calls");
   00045|     let call = &response["choices"][0]["message"]["tool_calls"][0];
   00046|     assert_eq!(call["function"]["name"], "web_search");
   00047|     let arguments: serde_json::Value =
   00048|         serde_json::from_str(call["function"]["arguments"].as_str().unwrap()).unwrap();
   00049|     assert!(
   00050|         arguments["query"]
   00051|             .as_str()
   00052|             .is_some_and(|query| !query.trim().is_empty()),
   00053|         "search call should carry a non-empty query: {arguments}"
   00054|     );
   00055| }
