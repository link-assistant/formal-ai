   00108| #[test]
   00109| fn answered_questions_form_a_recall_table() {
   00110|     // The catalog is a *recall table*: a question it already answered is recognised and
   00111|     // answered from the catalog (case/whitespace-insensitive), not re-derived. This is
   00112|     // the issue-#527 auto-learning link — without touching the human-gated ledger.
   00113|     let catalog = recipe::catalog();
   00114|     let first = catalog
   00115|         .answered
   00116|         .first()
   00117|         .expect("at least one answered question");
   00118| 
   00119|     let recalled = catalog
   00120|         .answer_for(&format!("  {}  ", first.question.to_uppercase()))
   00121|         .expect("a trivially rephrased question should be recalled");
   00122|     assert_eq!(recalled, first);
   00123| 
   00124|     // A question the catalog never generated is not recalled (no hallucinated answers).
   00125|     assert!(catalog.answer_for("what colour is the sky?").is_none());
   00126| }
