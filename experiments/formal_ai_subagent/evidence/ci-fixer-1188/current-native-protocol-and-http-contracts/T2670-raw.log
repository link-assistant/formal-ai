   00194| #[test]
   00195| fn planner_walks_the_question_catalog_recipe() {
   00196|     let tools = ["web_search", "web_fetch", "write_file", "run_command"];
   00197|     let mut messages = vec![ChatMessage::user(QUESTION_CATALOG_TASK)];
   00198| 
   00199|     // Step 1: write the generated catalog document (no web step — it is a pure function
   00200|     // of the seed lexicon and the deterministic engine).
   00201|     let call = expect_single_call(&messages, &tools);
   00202|     assert_eq!(call.tool, "write_file");
   00203|     assert!(call.arguments.contains(QUESTION_CATALOG_PATH));
   00204|     let written: serde_json::Value = serde_json::from_str(&call.arguments).unwrap();
   00205|     assert_eq!(written["content"], recipe::render_document());
   00206|     answer_tool_call(&mut messages, &call, "wrote question-catalog.lino");
   00207| 
   00208|     // Step 2: verify by reading the document back.
   00209|     let call = expect_single_call(&messages, &tools);
   00210|     assert_eq!(call.tool, "run_command");
   00211|     assert!(call.arguments.contains(QUESTION_CATALOG_PATH));
   00212|     answer_tool_call(&mut messages, &call, &recipe::render_document());
   00213| 
   00214|     // Step 3: the recipe is exhausted — the final answer carries the catalog.
   00215|     match plan_chat_step(&messages, &tools) {
   00216|         Some(AgenticPlan::Final(answer)) => {
   00217|             assert!(answer.contains(QUESTION_CATALOG_PATH));
   00218|             assert!(answer.contains("question catalog"));
   00219|         }
   00220|         other => panic!("expected a final answer, got {other:?}"),
   00221|     }
   00222| }
