   00001| //! The issue-#527 question-catalog loop — *"generate all possible questions and
   00002| //! answer them"*, reachable through the agentic interface as the eleventh recipe.
   00003| //!
   00004| //! Issue #527 asks Formal AI to enumerate questions from smallest to largest out of a
   00005| //! frequency-tiered vocabulary, classify each candidate grammatically and logically,
   00006| //! and answer the meaningful ones with the best possible answer. The generator itself
   00007| //! is exercised by `generated_question_ordering.rs`; these pins lock the *agentic* capability:
   00008| //!
   00009| //! 1. the catalog records the four-way classification smallest-first and answers the
   00010| //!    grammatical-and-meaningful questions with the deterministic engine;
   00011| //! 2. the answered questions form a recall table (a repeated question is answered from
   00012| //!    the catalog, not re-derived) that never changes solver behaviour on its own;
   00013| //! 3. the committed `data/meta/question-catalog.lino` is byte-for-byte what the recipe
   00014| //!    renders and parses as Links Notation;
   00015| //! 4. the recipe routes without colliding with the sibling recipes and the planner and
   00016| //!    the in-repo Agent CLI driver walk it write → verify → final.
   00017| 
   00018| use formal_ai::agentic_coding::{
   00019|     AgenticPlan, DRIVER_TOOLS, PlannedToolCall, QUESTION_CATALOG_PATH, QUESTION_CATALOG_TASK,
   00020|     is_question_catalog_task, plan_chat_step, question_catalog as recipe, run_agentic_task,
   00021| };
   00022| use formal_ai::{ChatMessage, ToolCall};
   00023| use lino_objects_codec::format::parse_indented;
   00024| 
   00025| fn expect_single_call(messages: &[ChatMessage], tools: &[&str]) -> PlannedToolCall {
   00026|     match plan_chat_step(messages, tools) {
   00027|         Some(AgenticPlan::ToolCalls(mut calls)) => {
   00028|             assert_eq!(calls.len(), 1, "the planner emits one call per step");
   00029|             calls.remove(0)
   00030|         }
   00031|         other => panic!("expected a single tool call, got {other:?}"),
   00032|     }
   00033| }
   00034| 
   00035| fn answer_tool_call(messages: &mut Vec<ChatMessage>, call: &PlannedToolCall, result: &str) {
   00036|     let id = format!("call_{}", messages.len());
   00037|     messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00038|         id.clone(),
   00039|         call.tool.clone(),
   00040|         call.arguments.clone(),
   00041|     )]));
   00042|     messages.push(ChatMessage::tool_result(id, &call.tool, result));
   00043| }
