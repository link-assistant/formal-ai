   00045| #[test]
   00046| fn catalog_classifies_smallest_first_and_answers_meaningful_questions() {
   00047|     let catalog = recipe::catalog();
   00048| 
   00049|     // Candidates are enumerated smallest-first (word count is non-decreasing).
   00050|     assert!(
   00051|         catalog
   00052|             .candidates
   00053|             .windows(2)
   00054|             .all(|pair| pair[0].word_count <= pair[1].word_count),
   00055|         "candidates must be recorded smallest-first: {:?}",
   00056|         catalog.candidates,
   00057|     );
   00058|     assert_eq!(
   00059|         catalog.candidates.first().map(|c| c.text.as_str()),
   00060|         Some("what?"),
   00061|         "the smallest candidate is the single most-frequent interrogative opener",
   00062|     );
   00063| 
   00064|     // The catalog demonstrates the four-way distinction: a fragment (one-word opener),
   00065|     // an ungrammatical candidate, and — among the answered — grammatical-and-meaningful.
   00066|     assert!(
   00067|         catalog
   00068|             .candidates
   00069|             .iter()
   00070|             .any(|c| c.class == "fragment" && c.grammar == "fragment"),
   00071|         "the catalog should record at least one fragment candidate",
   00072|     );
   00073|     assert!(
   00074|         catalog
   00075|             .candidates
   00076|             .iter()
   00077|             .any(|c| c.class == "ungrammatical"),
   00078|         "the catalog should record at least one ungrammatical candidate",
   00079|     );
   00080| 
   00081|     // Every answered entry is a grammatical, meaningful question with a real answer.
   00082|     assert!(
   00083|         !catalog.answered.is_empty(),
   00084|         "the catalog should answer at least one meaningful question",
   00085|     );
   00086|     for answered in &catalog.answered {
   00087|         assert!(answered.question.ends_with('?'));
   00088|         assert!(
   00089|             !answered.answer.trim().is_empty(),
   00090|             "every meaningful question gets a best-possible answer: {answered:?}",
   00091|         );
   00092|         assert!(
   00093|             (0.0..=1.0).contains(&answered.confidence),
   00094|             "confidence stays a probability: {answered:?}",
   00095|         );
   00096|     }
   00097| 
   00098|     // The engine answers what it can and stays honest about what it cannot: the identity
   00099|     // question resolves with full confidence, an unknown concept stays low-confidence.
   00100|     let identity = catalog
   00101|         .answer_for("what is you?")
   00102|         .expect("the identity question should be answered");
   00103|     assert_eq!(identity.intent, "identity");
   00104|     assert!(identity.confidence > 0.99);
   00105|     assert!(identity.answer.to_lowercase().contains("formal-ai"));
   00106| }
