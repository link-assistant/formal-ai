   00128| #[test]
   00129| fn committed_catalog_document_is_generated_by_the_recipe() {
   00130|     // The committed artifact is *generated* from the recipe — never hand written — so it
   00131|     // can never drift, and it is byte-for-byte what the Agent CLI writes. It depends only
   00132|     // on the seed lexicon and the deterministic engine, so it is safe to pin.
   00133|     let committed = include_str!("../../../../data/meta/question-catalog.lino");
   00134|     assert_eq!(
   00135|         committed,
   00136|         recipe::render_document(),
   00137|         "the committed catalog is stale — regenerate it with `cargo run --example dump_question_catalog`",
   00138|     );
   00139|     parse_indented(committed).expect("the committed document should parse as Links Notation");
   00140|     assert!(committed.contains("question_catalog"));
   00141|     assert!(committed.contains("intent \"generate_all_possible_questions\""));
   00142|     assert!(committed.contains("class \"fragment\""));
   00143|     assert!(committed.contains("class \"ungrammatical\""));
   00144|     assert!(committed.contains("answered"));
