   00049| /// Where a new text that starts at byte `from` ends, given the sentence end
   00050| /// `cut` (mirrors `wholePayloadEnd`).
   00051| ///
   00052| /// When the payload cut there is no whole literal, or its closing mark opens
   00053| /// an inner quote, its marks are read by their shape: a mark after a space or
   00054| /// an opening bracket and before a word opens an inner quote, a mark after a
   00055| /// word and before a space or punctuation closes one, and the payload ends
   00056| /// where its own opening mark is closed. `cut` when a mark has neither shape
   00057| /// or the payload never closes.
   00058| pub(super) fn whole_payload_end(request: &str, from: usize, cut: usize) -> usize {
   00059|     let Some(payload) = request.get(from..cut) else {
   00060|         return cut;
   00061|     };
   00062|     if wrapped_in_quote_pair(payload) && !opens_inner(request, cut) {
   00063|         return cut;
   00064|     }
   00065|     let rest = &request[from..];
   00066|     let open = from + (rest.len() - rest.trim_start().len());
   00067|     let Some(mark) = request[open..].chars().next() else {
   00068|         return cut;
   00069|     };
   00070|     if !SAME_MARKS.contains(&mark) || request[open..].starts_with(FENCE) {
   00071|         return cut;
   00072|     }
   00073|     let end = super::positional_edit::instruction_end(request);
   00074|     if end <= open + mark.len_utf8() {
   00075|         return cut;
   00076|     }
   00077|     let mut depth = 1_usize;
   00078|     let mut before = mark;
   00079|     let mut characters = request[open + mark.len_utf8()..end]
   00080|         .char_indices()
   00081|         .peekable();
   00082|     while let Some((offset, character)) = characters.next() {
   00083|         let previous = before;
   00084|         before = character;
   00085|         if character != mark {
   00086|             continue;
   00087|         }
   00088|         let after = characters.peek().map(|(_, next)| *next);
   00089|         let closes = !previous.is_whitespace()
   00090|             && after.is_none_or(|next| next.is_whitespace() || CLOSE_FOLLOWERS.contains(next));
   00091|         let opens = (previous.is_whitespace() || OPEN_LEADERS.contains(previous))
   00092|             && after.is_some_and(|next| !next.is_whitespace());
   00093|         if opens && !closes {
   00094|             depth += 1;
   00095|         } else if closes {
   00096|             depth -= 1;
   00097|         } else {
   00098|             return cut;
   00099|         }
   00100|         if depth == 0 {
   00101|             return open + mark.len_utf8() + offset + mark.len_utf8();
   00102|         }
   00103|     }
   00104|     cut
   00105| }
