   00144| /// The seeded answer declining a request whose quotes do not pair (PR #1188
   00145| /// G71) or nest (G90), whose edit names several files (G91, G104), or whose
   00146| /// several edits hold one that is no replacement (G106); mirrors
   00147| /// `requestFaultAnswer` in `js/agentic/planner.mjs`.
   00148| ///
   00149| /// Steps joined by a sequence cue are each checked alone (G99).
   00150| pub(super) fn request_fault_answer(task: &str) -> Option<AgenticPlan> {
   00151|     let fault = crate::normal_markov::quote_fault(task)
   00152|         .map(|fault| (format!("request_quote_{}", fault.kind), fault.fragment))
   00153|         .or_else(|| {
   00154|             nested_quote_fault(task).map(|fault| (fault.intent.to_owned(), fault.fragment))
   00155|         });
   00156|     let answer = if let Some((intent, fragment)) = fault {
   00157|         code_task::render_seeded_change(&intent, task, "", &[("{fragment}", &fragment)])
   00158|     } else if super::request_sequence::sequence_steps(task).is_some() {
   00159|         return None;
   00160|     } else if let Some(targets) = super::replace_list::several_edit_targets(task) {
   00161|         code_task::render_seeded_change(
   00162|             "request_several_edit_targets",
   00163|             task,
   00164|             "",
   00165|             &[("{files}", &targets.join("`, `"))],
   00166|         )
   00167|     } else {
   00168|         let clause = super::replace_list::unplanned_edit_clause(task)?;
   00169|         code_task::render_seeded_change(UNPLANNED_CLAUSE_INTENT, task, "", &[("{clause}", &clause)])
   00170|     };
   00171|     answer.map(AgenticPlan::Final)
   00172| }
