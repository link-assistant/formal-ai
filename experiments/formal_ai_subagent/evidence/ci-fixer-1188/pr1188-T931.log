   00107| /// The first quoted text of a request naming a file whose closing mark opens
   00108| /// an inner quote and that the request's edit, if one can be read, does not
   00109| /// hold whole (mirrors `nestedQuoteFault`).
   00110| pub(super) fn nested_quote_fault(text: &str) -> Option<NestedQuote> {
   00111|     let edit = super::write_request::compose_edit_request(text);
   00112|     // A request naming a file whose edit cannot be read at all is declined too.
   00113|     if edit.is_none() && super::module_function::paths_in(text).is_empty() {
   00114|         return None;
   00115|     }
   00116|     for segment in quoted_segment_spans(text) {
   00117|         let opening = text[segment.start..].chars().next();
   00118|         if !opening.is_some_and(|mark| SAME_MARKS.contains(&mark))
   00119|             || text[segment.start..].starts_with(FENCE)
   00120|             || !opens_inner(text, segment.end)
   00121|         {
   00122|             continue;
   00123|         }
   00124|         let next = text[segment.end..].chars().next().map_or(0, char::len_utf8);
   00125|         let across = &text[segment.start + 1..segment.end + next];
   00126|         let held = edit
   00127|             .as_ref()
   00128|             .is_some_and(|(_, old, new)| old.contains(across) || new.contains(across));
   00129|         if held {
   00130|             continue;
   00131|         }
   00132|         let fragment: String = text[segment.start..]
   00133|             .chars()
   00134|             .take(FAULT_FRAGMENT_CHARS)
   00135|             .collect();
   00136|         return Some(NestedQuote {
   00137|             intent: NESTED_INTENT,
   00138|             fragment: fragment.trim_end().to_owned(),
   00139|         });
   00140|     }
   00141|     None
   00142| }
