   00028|   const workingTreeChanges = execFileSync('git', ['diff', '--name-only', 'HEAD', '--', 'rust/src', 'js', 'ts'],
   00029|     { cwd: ROOT, encoding: 'utf8' }).trim();
   00030|   const paths = ownedProductionSources();
   00031|   const selected = partitionSourcePaths(paths, shardIndex, shardCount);
   00032|   if (selected.length === 0) throw new Error('source shard contains no owned modules');
   00033|   const output = value('--output', '');
