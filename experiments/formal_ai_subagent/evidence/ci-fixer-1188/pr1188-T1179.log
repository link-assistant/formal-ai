   00326| fn requested_identifier(task: &str, path: &str, kind: RustItemKind) -> Option<String> {
   00327|     let normalized = task.to_lowercase();
   00328|     if kind != RustItemKind::Constant
   00329|         && let Some(name) = slot_identifier(&normalized, seed::ROLE_CODING_NAME_SLOT)
   00330|         && valid_identifier(&name)
   00331|     {
   00332|         return Some(name);
   00333|     }
   00334|     let without_path = task.replacen(path, "", 1);
   00335|     let mut candidates = identifier_tokens(&without_path)
   00336|         .filter(|candidate| valid_identifier(candidate))
   00337|         .collect::<Vec<_>>();
   00338|     if kind == RustItemKind::Constant {
   00339|         candidates.retain(|candidate| {
   00340|             candidate.chars().any(|character| character == '_')
   00341|                 && candidate
   00342|                     .chars()
   00343|                     .all(|character| character.is_ascii_uppercase() || character == '_')
   00344|         });
   00345|     } else {
   00346|         candidates.retain(|candidate| candidate.contains('_'));
   00347|     }
   00348|     candidates.into_iter().next().map(str::to_owned)
   00349| }
