   00273| /// A placeholder the seed sentence wraps in backticks becomes a `CommonMark`
   00274| /// code span: a value holding a backtick run gets a longer fence, padded when
   00275| /// it starts or ends with a backtick, so the inserted text reads back verbatim.
   00276| fn code_span_item(value: &str) -> String {
   00277|     let longest = value
   00278|         .split(|character| character != '`')
   00279|         .map(str::len)
   00280|         .max()
   00281|         .unwrap_or(0);
   00282|     if longest == 0 {
   00283|         return format!("`{value}`");
   00284|     }
   00285|     let fence = "`".repeat(longest + 1);
   00286|     let pad = if value.starts_with('`') || value.ends_with('`') {
   00287|         " "
   00288|     } else {
   00289|         ""
   00290|     };
   00291|     format!("{fence}{pad}{value}{pad}{fence}")
   00292| }
   00293| 
   00294| fn code_span(value: &str) -> String {
   00295|     code_span_item(value)
   00296| }
