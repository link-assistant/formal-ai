   00351| fn slot_identifier(normalized: &str, role: &str) -> Option<String> {
   00352|     seed::lexicon()
   00353|         .role_word_forms(role)
   00354|         .into_iter()
   00355|         .find_map(|form| match form.slot() {
   00356|             Slot::Prefix => {
   00357|                 let prefix = form.before_slot().trim().to_lowercase();
   00358|                 let start = normalized.find(&prefix)?.checked_add(prefix.len())?;
   00359|                 identifier_tokens(normalized.get(start..)?)
   00360|                     .next()
   00361|                     .map(str::to_owned)
   00362|             }
   00363|             Slot::Suffix => {
   00364|                 let suffix = form.after_slot().trim().to_lowercase();
   00365|                 let end = normalized.find(&suffix)?;
   00366|                 identifier_tokens(normalized.get(..end)?)
   00367|                     .last()
   00368|                     .map(str::to_owned)
   00369|             }
   00370|             Slot::Circumfix => {
   00371|                 let before = form.before_slot().trim().to_lowercase();
   00372|                 let after = form.after_slot().trim().to_lowercase();
   00373|                 let start = normalized.find(&before)?.checked_add(before.len())?;
   00374|                 let remainder = normalized.get(start..)?;
   00375|                 let end = remainder.find(&after)?;
   00376|                 identifier_tokens(remainder.get(..end)?)
   00377|                     .next()
   00378|                     .map(str::to_owned)
   00379|             }
   00380|             Slot::Bare => None,
   00381|         })
   00382| }
   00383| 
   00384| fn identifier_tokens(text: &str) -> impl Iterator<Item = &str> {
   00385|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00386|         .filter(|token| !token.is_empty())
   00387| }
   00388| 
   00389| fn valid_identifier(identifier: &str) -> bool {
   00390|     let mut characters = identifier.chars();
   00391|     let Some(first) = characters.next() else {
   00392|         return false;
   00393|     };
   00394|     (first.is_ascii_alphabetic() || first == '_')
   00395|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00396|         && !seed::lexicon()
   00397|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00398|             .iter()
   00399|             .any(|reserved| reserved == identifier)
   00400| }
   00401| 
   00402| fn numeric_literals(text: &str) -> Vec<String> {
   00403|     let chars = text.char_indices().collect::<Vec<_>>();
   00404|     let mut values = Vec::new();
   00405|     let mut index = 0;
   00406|     while index < chars.len() {
   00407|         let (start, character) = chars[index];
   00408|         if !character.is_ascii_digit()
   00409|             || index
   00410|                 .checked_sub(1)
   00411|                 .is_some_and(|prior| chars[prior].1.is_ascii_alphabetic())
   00412|         {
   00413|             index += 1;
   00414|             continue;
   00415|         }
   00416|         let mut end_index = index + 1;
   00417|         while end_index < chars.len()
   00418|             && (chars[end_index].1.is_ascii_digit() || chars[end_index].1 == '.')
   00419|         {
   00420|             end_index += 1;
   00421|         }
   00422|         if end_index < chars.len() && chars[end_index].1.is_ascii_alphabetic() {
   00423|             index = end_index + 1;
   00424|             continue;
   00425|         }
   00426|         let end = chars
   00427|             .get(end_index)
   00428|             .map_or(text.len(), |(offset, _)| *offset);
   00429|         let value = text[start..end].trim_end_matches('.');
   00430|         if !value.is_empty() {
   00431|             values.push(value.to_owned());
   00432|         }
   00433|         index = end_index;
   00434|     }
   00435|     values
   00436| }
