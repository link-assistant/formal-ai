   00307| fn rust_path(task: &str) -> Option<String> {
   00308|     let end = task.find(".rs")?.checked_add(3)?;
   00309|     let start = task[..end]
   00310|         .char_indices()
   00311|         .rev()
   00312|         .take_while(|(_, character)| is_path_character(*character))
   00313|         .last()
   00314|         .map_or(0, |(index, _)| index);
   00315|     let path = task.get(start..end)?;
   00316|     (!path.is_empty()
   00317|         && !path.starts_with('/')
   00318|         && !path.split('/').any(|component| component == ".."))
   00319|     .then(|| path.to_owned())
   00320| }
   00321| 
   00322| const fn is_path_character(character: char) -> bool {
   00323|     character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00324| }
