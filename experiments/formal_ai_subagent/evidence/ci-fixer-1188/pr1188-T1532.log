   00001| //! PR #1188 dogfooding (T29, T30, T33, T35 and probe gaps G3, G4): whole-line
   00002| //! operations. Before: a line deletion with its neighbour was routed to a
   00003| //! whole-file write that replaced a 380-line file with one line (T29);
   00004| //! numbered line ranges were only read (T30); an insert after line N planned
   00005| //! nothing (T33); a quoted path-shaped needle was read as the file (T35); a
   00006| //! moved line was duplicated (G4); a swap planned nothing (G3). A computed
   00007| //! change that would drop most of a file without the request stating that
   00008| //! extent is refused. Twin of
   00009| //! `rust/tests/web/pull-request-1188-line-operations.test.mjs`.
   00010| 
   00011| use formal_ai::agentic_coding::{AgenticPlan, plan_chat_step};
   00012| use formal_ai::protocol::{ChatMessage, ToolCall};
   00013| use formal_ai::source_fetch::sha256_hex;
   00014| 
   00015| const TOOLS: [&str; 4] = ["read", "edit", "bash", "write"];
   00016| const SIX: &str = "one\ntwo\nthree\nfour\nfive\nsix\n";
   00017| const CFG: &str = "alpha = 1\nbeta = 2\ngamma = 3\n";
   00018| const LINO: &str =
   00019|     "header\n      surface\n        text \"get it\"\n      surface\n        text find\nfooter\n";
   00020| 
   00021| /// The tools called, the file afterwards, and the final answer.
   00022| struct Run {
   00023|     tools: Vec<String>,
   00024|     file: String,
   00025|     answer: Option<String>,
   00026| }
   00027| 
   00028| /// Run `prompt` over one file `name` holding `source`; the tools act on it the
   00029| /// way the Agent CLI's do.
   00030| fn drive(prompt: &str, source: &str, name: &str) -> Run {
   00031|     let mut file = source.to_owned();
   00032|     let mut messages = vec![ChatMessage::user(prompt)];
   00033|     let mut tools = Vec::new();
   00034|     let mut answer = None;
   00035|     for index in 0..6 {
   00036|         let calls = match plan_chat_step(&messages, &TOOLS) {
   00037|             Some(AgenticPlan::ToolCalls(calls)) => calls,
   00038|             Some(AgenticPlan::Final(text)) => {
   00039|                 answer = Some(text);
   00040|                 break;
   00041|             }
   00042|             None => break,
   00043|         };
   00044|         let call = calls[0].clone();
   00045|         let arguments: serde_json::Value =
   00046|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00047|         let result = match call.tool.as_str() {
   00048|             "read" => file.clone(),
   00049|             "edit" => {
   00050|                 let old = arguments["oldString"].as_str().unwrap_or_default();
   00051|                 let new = arguments["newString"].as_str().unwrap_or_default();
   00052|                 file = file.replacen(old, new, 1);
   00053|                 String::new()
   00054|             }
   00055|             "write" => {
   00056|                 arguments["content"].as_str().unwrap_or_default().clone_into(&mut file);
   00057|                 String::new()
   00058|             }
   00059|             "bash" => format!("{}  {name}\n", sha256_hex(file.as_bytes())),
   00060|             _ => String::new(),
   00061|         };
   00062|         tools.push(call.tool.clone());
   00063|         let id = format!("call_{index}");
   00064|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00065|             id.clone(),
   00066|             call.tool.clone(),
   00067|             call.arguments.clone(),
   00068|         )]));
   00069|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00070|     }
   00071|     Run {
   00072|         tools,
   00073|         file,
   00074|         answer,
   00075|     }
   00076| }
   00077| 
   00078| #[test]
   00079| fn numbered_lines_are_removed() {
   00080|     let range = drive("Delete lines 2-3 from f.txt.", SIX, "f.txt");
   00081|     assert_eq!(range.tools, ["read", "edit", "bash"]);
   00082|     assert_eq!(range.file, "one\nfour\nfive\nsix\n");
   00083|     assert_eq!(
   00084|         range.answer.as_deref(),
   00085|         Some("Deleted line(s) 2-3 of `f.txt` and observed the result.")
   00086|     );
   00087|     assert_eq!(
   00088|         drive("Delete lines 2 to 3 from f.txt.", SIX, "f.txt").file,
   00089|         "one\nfour\nfive\nsix\n"
   00090|     );
   00091|     assert_eq!(
   00092|         drive(
   00093|             "Remove line 6 from f.txt.",
   00094|             "one\ntwo\nthree\nfour\nfive\nsix",
   00095|             "f.txt"
   00096|         )
   00097|         .file,
   00098|         "one\ntwo\nthree\nfour\nfive"
   00099|     );
   00100| }
