   00124| pub(crate) fn drive(prompt: &str, workspace: &[(&str, &str)]) -> Run {
   00125|     let mut run = Run {
   00126|         files: workspace
   00127|             .iter()
   00128|             .map(|(path, text)| ((*path).to_owned(), (*text).to_owned()))
   00129|             .collect(),
   00130|         tools: Vec::new(),
   00131|         commands: Vec::new(),
   00132|         answer: None,
   00133|     };
   00134|     let mut messages = vec![ChatMessage::user(prompt)];
   00135|     for index in 0..16 {
   00136|         let calls = match plan_chat_step(&messages, &TOOLS) {
   00137|             Some(AgenticPlan::ToolCalls(calls)) => calls,
   00138|             Some(AgenticPlan::Final(text)) => {
   00139|                 run.answer = Some(text);
   00140|                 break;
   00141|             }
   00142|             None => break,
   00143|         };
   00144|         let call = calls[0].clone();
   00145|         let arguments: serde_json::Value =
   00146|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00147|         if call.tool == "bash" {
   00148|             run.commands
   00149|                 .push(arguments["command"].as_str().unwrap_or_default().to_owned());
   00150|         }
   00151|         run.tools.push(call.tool.clone());
   00152|         let result = execute(&mut run.files, &call.tool, &arguments);
   00153|         let id = format!("call_{index}");
   00154|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00155|             id.clone(),
   00156|             call.tool.clone(),
   00157|             call.arguments.clone(),
   00158|         )]));
   00159|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00160|     }
   00161|     run
   00162| }
