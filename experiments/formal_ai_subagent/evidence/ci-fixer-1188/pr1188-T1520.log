   00229| /// The `contraction` / `expansion` pairs `data/seed/languages.lino` seeds.
   00230| fn seeded_contractions() -> Vec<(String, String)> {
   00231|     let languages = formal_ai::seed::seed_files()
   00232|         .into_iter()
   00233|         .find(|(path, _)| *path == "data/seed/languages.lino")
   00234|         .map(|(_, text)| text)
   00235|         .expect("languages.lino is seeded");
   00236|     let mut pairs = Vec::new();
   00237|     let mut contracted = None;
   00238|     for line in languages.lines() {
   00239|         let Some((key, value)) = line.trim().split_once(' ') else {
   00240|             continue;
   00241|         };
   00242|         let value = value.trim_matches('"').to_owned();
   00243|         match key {
   00244|             "contraction" => contracted = Some(value),
   00245|             "expansion" => {
   00246|                 if let Some(pair) = contracted.take() {
   00247|                     pairs.push((pair, value));
   00248|                 }
   00249|             }
   00250|             _ => {}
   00251|         }
   00252|     }
   00253|     pairs
   00254| }
