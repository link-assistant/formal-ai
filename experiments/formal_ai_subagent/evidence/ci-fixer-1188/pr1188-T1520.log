   00533| /// The answer to `Run <command>` once the command ran with no output.
   00534| fn quiet_run(command: &str) -> Option<String> {
   00535|     let mut messages = vec![ChatMessage::user(format!("Run {command}"))];
   00536|     let Some(AgenticPlan::ToolCalls(calls)) = plan_chat_step(&messages, &TOOLS) else {
   00537|         panic!("{command} is planned");
   00538|     };
   00539|     let arguments: serde_json::Value =
   00540|         serde_json::from_str(&calls[0].arguments).expect("tool arguments are JSON");
   00541|     assert_eq!(arguments["command"], command);
   00542|     messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00543|         "c0",
   00544|         "bash",
   00545|         calls[0].arguments.clone(),
   00546|     )]));
   00547|     messages.push(ChatMessage::tool_result("c0", "bash", ""));
   00548|     match plan_chat_step(&messages, &TOOLS) {
   00549|         Some(AgenticPlan::Final(answer)) => Some(answer),
   00550|         _ => None,
   00551|     }
   00552| }
