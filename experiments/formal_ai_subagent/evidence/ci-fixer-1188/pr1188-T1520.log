   00012| const TOOLS: [&str; 7] = ["bash", "edit", "glob", "grep", "list", "read", "write"];
   00013| 
   00014| /// One driven session: the workspace afterwards, the bash commands and tools
   00015| /// it ran, and its final answer.
   00016| pub(crate) struct Run {
   00017|     pub(crate) files: BTreeMap<String, String>,
   00018|     pub(crate) tools: Vec<String>,
   00019|     pub(crate) commands: Vec<String>,
   00020|     pub(crate) answer: Option<String>,
   00021| }
   00022| 
   00023| fn path_of(arguments: &serde_json::Value) -> String {
   00024|     ["filePath", "file_path", "path"]
   00025|         .iter()
   00026|         .find_map(|key| arguments[key].as_str())
   00027|         .unwrap_or_default()
   00028|         .to_owned()
   00029| }
   00030| 
   00031| /// The Agent CLI's tools over an in-memory workspace; bash knows
   00032| /// `sha256sum --`, `cat` and a passing `node --test`.
   00033| fn execute(
   00034|     files: &mut BTreeMap<String, String>,
   00035|     tool: &str,
   00036|     arguments: &serde_json::Value,
   00037| ) -> String {
   00038|     match tool {
   00039|         "read" => files
   00040|             .get(&path_of(arguments))
   00041|             .cloned()
   00042|             .unwrap_or_else(|| format!("Error: File not found: {}", path_of(arguments))),
   00043|         "write" => {
   00044|             let content = arguments["content"].as_str().unwrap_or_default().to_owned();
   00045|             files.insert(path_of(arguments), content);
   00046|             String::new()
   00047|         }
   00048|         "edit" => {
   00049|             let path = path_of(arguments);
   00050|             let text = files.get(&path).cloned().unwrap_or_default();
   00051|             let old = arguments["oldString"].as_str().unwrap_or_default();
   00052|             let new = arguments["newString"].as_str().unwrap_or_default();
   00053|             if text.matches(old).count() != 1 {
   00054|                 return "Error: oldString not found in content".to_owned();
   00055|             }
   00056|             files.insert(path, text.replacen(old, new, 1));
   00057|             String::new()
   00058|         }
   00059|         "bash" => {
   00060|             let command = arguments["command"].as_str().unwrap_or_default();
   00061|             if let Some(path) = command.strip_prefix("sha256sum -- ") {
   00062|                 let text = files.get(path).cloned().unwrap_or_default();
   00063|                 return format!("{}  {path}\n", sha256_hex(text.as_bytes()));
   00064|             }
   00065|             // The file operations a copy recipe runs (G82).
   00066|             if let Some(path) = command.strip_prefix("test -e ") {
   00067|                 return if files.contains_key(path) {
   00068|                     String::new()
   00069|                 } else {
   00070|                     "Output: \nError: \nExit Code: 1".to_owned()
   00071|                 };
   00072|             }
   00073|             if let Some(path) = command.strip_prefix("test ! -e ") {
   00074|                 return if files.contains_key(path) {
   00075|                     "Output: \nError: \nExit Code: 1".to_owned()
   00076|                 } else {
   00077|                     String::new()
   00078|                 };
   00079|             }
   00080|             if command == "mkdir -p -- ." {
   00081|                 return String::new();
   00082|             }
   00083|             if let Some((from, to)) = command
   00084|                 .strip_prefix("cp ")
   00085|                 .and_then(|rest| rest.split_once(' '))
   00086|             {
   00087|                 let text = files.get(from).cloned().unwrap_or_default();
   00088|                 files.insert(to.to_owned(), text);
   00089|                 return String::new();
   00090|             }
   00091|             // A replace of every occurrence of a plain word (G84).
   00092|             if let Some((old, new, path)) = perl_replace(command) {
   00093|                 let text = files.get(path).cloned().unwrap_or_default();
   00094|                 files.insert(path.to_owned(), text.replace(old, new));
   00095|                 return String::new();
   00096|             }
   00097|             // A suite slower than the driver's timeout comes back killed (G77).
   00098|             if command == "node --test slow.test.mjs" {
   00099|                 return "Output: TAP version 13\nError: \nSignal: SIGTERM\nTimeout: 60000 ms"
   00100|                     .to_owned();
   00101|             }
   00102|             if command.starts_with("node --test ") {
   00103|                 return "# tests 1\n# pass 1\n# fail 0\n".to_owned();
   00104|             }
   00105|             command.strip_prefix("cat ").map_or_else(
   00106|                 || format!("Error: {command} is not simulated"),
   00107|                 |path| files.get(path).cloned().unwrap_or_default(),
   00108|             )
   00109|         }
   00110|         _ => format!("Error: {tool} is not simulated"),
   00111|     }
   00112| }
   00113| 
   00114| /// The old word, new word and path of `perl -pi -e 's/OLD/NEW/g' -- PATH`.
   00115| fn perl_replace(command: &str) -> Option<(&str, &str, &str)> {
   00116|     let (expression, path) = command
   00117|         .strip_prefix("perl -pi -e 's/")?
   00118|         .split_once("/g' -- ")?;
   00119|     let (old, new) = expression.split_once('/')?;
   00120|     let word = |text: &str| !text.is_empty() && text.chars().all(char::is_alphanumeric);
   00121|     (word(old) && word(new)).then_some((old, new, path))
   00122| }
