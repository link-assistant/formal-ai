   00575|         "examples must be compile-checked without linking every standalone binary (issue #534)"
   00576|     );
   00577|     assert!(
   00578|         !lint.contains("actionlint"),
   00579|         "workflow linting belongs to .github/workflows/workflows.yml since issue \
   00580|          #1076; a second copy here would drift from the Docker-image form that \
   00581|          guarantees ShellCheck is present"
   00582|     );
   00583|     assert!(
   00584|         lint.contains("scripts/lint-shell-scripts.sh"),
   00585|         "standalone shell scripts must be linted (issue #812)"
   00586|     );
   00587| 
   00588|     // Issue #977 moved the selector into a script; the empty-list guard is the
