   00915|         let job = job_block(&workflow, job_name);
   00916|         if timeout_minutes == 0 {
   00917|             // A reusable call declares no cap of its own; the called workflow's
   00918|             // jobs own them. Read whichever workflow this job actually calls,
   00919|             // so a second delegating job cannot be checked against the first
   00920|             // one's file (issue #1017 added `base`).
   00921|             let called = job
   00922|                 .lines()
   00923|                 .find_map(|line| line.trim().strip_prefix("uses: ./"))
   00924|                 .unwrap_or_else(|| {
   00925|                     panic!("{job_name} is listed as delegating but calls no reusable workflow")
   00926|                 })
   00927|                 .trim();
   00928|             let reusable =
   00929|                 fs::read_to_string(format!("{}/../{called}", env!("CARGO_MANIFEST_DIR")))
   00930|                     .unwrap_or_else(|error| panic!("read {called}: {error}"));
   00931|             for inner_job in workflow_job_names(&reusable) {
