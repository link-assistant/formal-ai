   00644| /// A research harness that declares no MCP tool-call timeout makes the Agent
   00645| /// CLI compute its per-tool deadline as `NaN`, so a call the mock answers in
   00646| /// milliseconds aborts with `timed out after NaN seconds`. Run 32107664418
   00647| /// failed exactly that way: `run_issue_781.sh` ended after one fetch and
   00648| /// tripped its own `[ "$fetches" -ge 3 ]` assertion.
   00649| ///
   00650| /// Pinned for `run_issue_781.sh` only, which is where the fault was observed.
   00651| /// `run_issue_687.sh` and `run_issue_771.sh` look similarly exposed but have
   00652| /// never produced a `NaN` deadline, and adding the same keys to them broke
   00653| /// them -- so they are left as they are rather than "fixed" against a fault
   00654| /// they do not have.
   00655| ///
   00656| /// `mcp_defaults` is added for the Agent CLI only. `OpenCode` reads the same
   00657| /// file and validates it against its own schema, which rejects that key
   00658| /// outright ("Configuration is invalid ... Unrecognized key: `mcp_defaults`"),
   00659| /// so writing it unconditionally trades one red client for another.
   00660| #[test]
   00661| fn the_research_harness_declares_an_mcp_tool_call_timeout() {
   00662|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00663|     let harness = fs::read_to_string(format!(
   00664|         "{manifest_dir}/experiments/agent_cli_e2e/run_issue_781.sh"
   00665|     ))
   00666|     .expect("research E2E harness should be readable");
   00667| 
   00668|     assert!(
   00669|         harness.contains(r#""tool_call_timeout": 120000"#),
   00670|         "run_issue_781.sh must give its MCP server an explicit tool-call \
   00671|          timeout, or the Agent CLI computes it as NaN and aborts the call"
   00672|     );
   00673|     assert!(
   00674|         harness.contains("max_tool_call_timeout: 600000"),
   00675|         "run_issue_781.sh must declare mcp_defaults.max_tool_call_timeout"
   00676|     );
   00677|     assert!(
   00678|         harness.contains(r#"if [ "$for_client" = agent ]"#),
   00679|         "mcp_defaults must be written only for the Agent CLI: OpenCode reads \
   00680|          the same file and its schema rejects that key"
   00681|     );
   00682| }
