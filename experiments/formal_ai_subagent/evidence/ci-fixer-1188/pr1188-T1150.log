   00962|         deploy.contains("bash scripts/build-rust-api-docs.sh"),
   00963|         "deploy-pages should invoke the API-docs builder"
   00964|     );
   00965|     assert!(
   00966|         deploy.contains("cp -R target/doc/. js/docs/api/"),
   00967|         "deploy-pages should copy the generated docs into js/docs/api/"
   00968|     );
   00969| 
   00970|     let stamp_pos = deploy
   00971|         .find("Stamp GitHub Pages artifact")
   00972|         .expect("deploy-pages should stamp the Pages artifact");
   00973|     let copy_pos = deploy
   00974|         .find("Copy Rust API docs into the Pages artifact")
   00975|         .expect("deploy-pages should copy the API docs");
   00976|     assert!(
   00977|         stamp_pos < copy_pos,
   00978|         "the API-docs copy must run after the stamp step so rustdoc HTML is not scanned for placeholders"
   00979|     );
   00980| 
   00981|     // cargo doc emits the crate root under target/doc/formal_ai/ (lib name
   00982|     // formal_ai); a redirect at the doc root keeps /docs/api/ from 404ing.
   00983|     let docs_script = std::fs::read_to_string(format!(
   00984|         "{}/../scripts/build-rust-api-docs.sh",
   00985|         env!("CARGO_MANIFEST_DIR")
   00986|     ))
   00987|     .expect("build-rust-api-docs.sh");
   00988|     assert!(
   00989|         docs_script.contains("cargo doc --no-deps --lib"),
