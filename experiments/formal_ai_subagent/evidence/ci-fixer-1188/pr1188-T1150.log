   00949| /// artifact — and the copy must run *after* stamping (rustdoc HTML carries no
   00950| /// version placeholders, so copying post-stamp keeps the large generated tree
   00951| /// out of the placeholder scan).
   00952| #[test]
   00953| fn pages_deploy_generates_api_docs_and_copies_them_after_stamping() {
   00954|     let workflow = pages_artifact_workflow();
   00955|     let deploy = job_block(&workflow, "build");
