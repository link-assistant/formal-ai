   00228| fn pages_e2e_navigation_preserves_repository_subpath() {
   00229|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00230|     let pages_config = fs::read_to_string(format!(
   00231|         "{manifest_dir}/rust/tests/e2e/playwright.pages.config.js"
   00232|     ))
   00233|     .unwrap();
   00234|     let demo_spec =
   00235|         fs::read_to_string(format!("{manifest_dir}/rust/tests/e2e/tests/demo.spec.js")).unwrap();
   00236|     // The multilingual suite is split across `multilingual-*.spec.js`
   00237|     // (repository line budget); every part must keep the relative navigation.
   00238|     let multilingual_specs = [
   00239|         "multilingual-chat.spec.js",
   00240|         "multilingual-wikipedia.spec.js",
   00241|         "multilingual-memory-settings.spec.js",
   00242|         "multilingual-issue-27.spec.js",
   00243|     ]
   00244|     .map(|name| {
   00245|         let spec =
   00246|             fs::read_to_string(format!("{manifest_dir}/rust/tests/e2e/tests/{name}")).unwrap();
   00247|         (format!("tests/e2e/tests/{name}"), spec)
   00248|     });
   00249|     let connectivity_spec = fs::read_to_string(format!(
   00250|         "{manifest_dir}/rust/tests/e2e/tests/connectivity.spec.js"
   00251|     ))
   00252|     .unwrap();
   00253| 
   00254|     assert!(
   00255|         pages_config.contains("normalizeBaseUrl"),
   00256|         "Pages e2e should normalize PAGES_URL with a trailing slash so ./ resolves inside /formal-ai/"
   00257|     );
   00258|     assert!(
   00259|         pages_config.contains("https://link-assistant.github.io/formal-ai/"),
   00260|         "default Pages URL should include the repository subpath and trailing slash"
   00261|     );
   00262| 
   00263|     // The app moved to /app/ (issue #479), so the Pages baseURL targets /app/.
   00264|     // The app specs navigate with a relative './' (→ /app/), while connectivity
   00265|     // reaches its sibling harness with a relative '../tests/' (→ /tests/). Both
   00266|     // are relative, so the /formal-ai/ repository subpath is always preserved;
   00267|     // an absolute '/…' would drop it.
   00268|     let mut navigation_cases = vec![
   00269|         (
   00270|             "tests/e2e/tests/demo.spec.js",
   00271|             demo_spec.as_str(),
   00272|             "page.goto('./')",
   00273|         ),
   00274|         (
   00275|             "tests/e2e/tests/connectivity.spec.js",
   00276|             connectivity_spec.as_str(),
   00277|             "page.goto('../tests/')",
   00278|         ),
   00279|     ];
   00280|     for (path, spec) in &multilingual_specs {
   00281|         navigation_cases.push((path.as_str(), spec.as_str(), "page.goto('./')"));
   00282|     }
   00283|     for (path, spec, expected_nav) in navigation_cases {
   00284|         assert!(
   00285|             !spec.contains("page.goto('/');"),
   00286|             "{path} should not navigate to / because URL resolution drops the /formal-ai/ subpath"
   00287|         );
   00288|         assert!(
   00289|             spec.contains(expected_nav),
   00290|             "{path} should navigate with a relative {expected_nav} so Pages tests stay under the repository subpath"
   00291|         );
   00292|     }
   00293| }
