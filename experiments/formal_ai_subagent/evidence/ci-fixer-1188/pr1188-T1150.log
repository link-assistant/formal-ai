   00295| #[test]
   00296| fn test_job_skips_non_code_changes() {
   00297|     // Issue #442: the `test` job ran whenever the `changelog` job was *skipped*.
   00298|     // `changelog` is skipped precisely when there are no code changes (docs-only
   00299|     // commits, .gitkeep edits, changelog-fragment-only commits), so the
   00300|     // `needs.changelog.result == 'skipped'` clause turned "nothing relevant
   00301|     // changed" into "run the entire test suite". This regression guard pins the
   00302|     // corrected gating: `test` keys off the detect-changes outputs, exactly like
   00303|     // `lint` and `coverage`, and never resurrects the changelog-skip escape.
   00304|     let workflow = release_workflow();
   00305|     let test = job_block(&workflow, "test");
   00306| 
   00307|     assert!(
   00308|         !test.contains("needs.changelog.result == 'skipped'"),
   00309|         "test job must not run merely because the changelog check was skipped; \
   00310|          a skipped changelog means there were no code changes (issue #442)"
   00311|     );
   00312|     assert!(
   00313|         !test.contains("needs.changelog.result == 'success'"),
   00314|         "test job should be decoupled from the changelog check and gate on the \
   00315|          change detector instead (issue #442)"
   00316|     );
   00317|     // Issue #1017 added `base`, which resolves the base-branch commit once so
   00318|     // every gate merges the same one. Assert the dependency rather than the
   00319|     // exact list, so adding a dependency cannot break a contract that is about
   00320|     // `detect-changes`.
   00321|     assert!(
   00322|         test.contains("needs: [detect-changes")
   00323|             && test.lines().any(|line| {
   00324|                 line.trim().starts_with("needs:") && line.contains("detect-changes")
   00325|             }),
   00326|         "test job should depend on detect-changes so it can gate on its outputs"
   00327|     );
   00328|     assert!(
   00329|         test.contains("needs.detect-changes.outputs.any-code-changed == 'true'"),
   00330|         "test job should run when code files changed"
   00331|     );
   00332|     assert!(
   00333|         test.contains("needs.detect-changes.outputs.rs-changed == 'true'"),
   00334|         "test job should run when Rust sources changed"
   00335|     );
   00336|     assert!(
   00337|         test.contains("needs.detect-changes.outputs.toml-changed == 'true'"),
   00338|         "test job should run when Cargo manifests changed"
   00339|     );
   00340|     // Issue #1107: `workflow-changed` is true for any file under
   00341|     // `.github/workflows/`, so gating the compiled test matrix on it made an
   00342|     // edit to a scheduled benchmark pay for the whole suite. What the matrix
   00343|     // cares about is the pipeline it runs inside -- its own definition, a
   00344|     // composite action it calls, or a script those run.
   00345|     assert!(
   00346|         test.contains("needs.detect-changes.outputs.pipeline-changed == 'true'"),
   00347|         "test job should run when the pipeline it runs inside changed"
   00348|     );
   00349|     assert!(
   00350|         !test.contains("github.event_name == 'push'")
   00351|             && test.contains("github.event_name == 'workflow_dispatch'"),
   00352|         "issue #846 requires pushes to obey detect-changes while manual \
   00353|          dispatch remains unconditional"
   00354|     );
   00355|     assert!(
   00356|         // Issue #808 / CI-CD-BEST-PRACTICES.md section 10: `always()` also runs
   00357|         // the job when the *run* is cancelled, which is not what this gate wants.
   00358|         // `!cancelled()` is enough to stop a skipped `detect-changes` from
   00359|         // cascading -- any status-check function disables the auto-skip.
   00360|         test.contains("!cancelled()") && !test.contains("always()"),
   00361|         "test job needs !cancelled() so the skipped detect-changes dependency \
   00362|          does not cascade on workflow_dispatch"
   00363|     );
   00364| }
