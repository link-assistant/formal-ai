   00390| /// Issue #812: both release jobs gated on `[lint, test, build]` alone, so a red
   00391| /// `Secrets Scan` or E2E suite on `main` did not stop the crate, the Docker
   00392| /// image and the GitHub Release from publishing.
   00393| #[test]
   00394| fn releases_do_not_publish_past_a_failing_secrets_scan_or_e2e_suite() {
   00395|     let workflow = release_workflow();
   00396| 
   00397|     for job_name in ["auto-release", "manual-release"] {
   00398|         let job = job_block(&workflow, job_name);
   00399|         let effective: String = job
   00400|             .lines()
   00401|             .filter(|line| !line.trim_start().starts_with('#'))
   00402|             .collect::<Vec<_>>()
   00403|             .join("\n");
   00404| 
   00405|         for gate in ["secrets-scan", "test-e2e-local", "test-agent-cli-e2e"] {
   00406|             // The acceptable results must be enumerated, not excluded. A job
   00407|             // killed by its own `timeout-minutes` reports as 'cancelled', which
   00408|             // a `!= 'failure'` guard would wave through -- run 29767811026 is
   00409|             // the observed instance of exactly that result value.
   00410|             assert!(
   00411|                 effective.contains(&format!(
   00412|                     "(needs.{gate}.result == 'success' || needs.{gate}.result == 'skipped')"
   00413|                 )),
   00414|                 "{job_name} must gate on {gate} being success-or-skipped, so a \
   00415|                  timed-out (cancelled) job cannot release (issue #812)"
   00416|             );
   00417|             assert!(
   00418|                 !effective.contains(&format!("needs.{gate}.result != 'failure'")),
   00419|                 "{job_name} must not use `!= 'failure'` for {gate}: a timeout \
   00420|                  reports as 'cancelled' and would pass that check (issue #812)"
   00421|             );
   00422|             assert!(
   00423|                 effective.contains(gate),
   00424|                 "{job_name} must declare {gate} in needs: (issue #812)"
   00425|             );
   00426|         }
   00427|     }
   00428| }
