   00366| #[test]
   00367| fn change_gated_jobs_never_depend_on_a_skipped_changelog() {
   00368|     // Generalises issue #442 across every change-gated job: none of them should
   00369|     // treat a *skipped* changelog/version check as a signal to run. A skipped
   00370|     // upstream check means "no code changed", which must never widen coverage.
   00371|     // The `coverage` job moved to `.github/workflows/coverage.yml` for issue
   00372|     // #895; `coverage_jobs_never_depend_on_a_skipped_upstream_check` in
   00373|     // `workflow_coverage.rs` pins this same property for it there.
   00374|     let workflow = release_workflow();
   00375|     for job_name in ["lint", "test", "test-e2e-local"] {
   00376|         let job = job_block(&workflow, job_name);
   00377|         // Inspect only effective YAML (skip `#` comment lines) so the rationale
   00378|         // comments that quote the old buggy clause don't trip the guard.
   00379|         let has_skip_dependency = job
   00380|             .lines()
   00381|             .filter(|line| !line.trim_start().starts_with('#'))
   00382|             .any(|line| line.contains("result == 'skipped'"));
   00383|         assert!(
   00384|             !has_skip_dependency,
   00385|             "{job_name} job must not run because an upstream check was skipped (issue #442)"
   00386|         );
   00387|     }
   00388| }
