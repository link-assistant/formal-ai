   00190| #[test]
   00191| fn wait_for_pages_deployment_is_marker_authoritative() {
   00192|     // Issue #479 (root cause, take 2): the live-Pages freshness probe used to
   00193|     // require the raw deploy SHA to appear in the served index BODY
   00194|     // (`grep -Fq "$expected_sha" "$index_file"`). That coupled the probe to every
   00195|     // root page embedding the commit SHA verbatim. When the issue #479 landing
   00196|     // page shipped at `/` WITHOUT cache-busted asset refs, the stamped index
   00197|     // never contained the SHA, so the probe ran the full 300s and timed out --
   00198|     // failing the whole pipeline and (via the desktop-release gate) suppressing
   00199|     // every desktop build. The probe is now marker-authoritative: GitHub Pages
   00200|     // deploys atomically, so deployment.json advertising "sha":"<expected_sha>"
   00201|     // is sufficient proof the matching stamped index is live.
   00202|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00203|     let wait_script = fs::read_to_string(format!(
   00204|         "{manifest_dir}/scripts/wait-for-pages-deployment.sh"
   00205|     ))
   00206|     .unwrap();
   00207| 
   00208|     // The marker SHA is the authoritative freshness signal.
   00209|     assert!(
   00210|         wait_script.contains("${expected_sha}") && wait_script.contains("\"$marker_file\""),
   00211|         "wait script should require the deployment.json marker to advertise the expected SHA"
   00212|     );
   00213|     // The brittle "index body must contain the SHA" requirement must be gone.
   00214|     assert!(
   00215|         !wait_script.contains("-Fq \"$expected_sha\" \"$index_file\""),
   00216|         "issue #479 regression: the probe must NOT hard-require the raw SHA in the index body -- \
   00217|          a valid root page without cache-busted asset refs would hang the probe for the full timeout"
   00218|     );
   00219|     // But the defensive placeholder guards (catch a half-run stamp step) remain.
   00220|     assert!(
   00221|         wait_script.contains("__FORMAL_AI_ASSET_VERSION__")
   00222|             && wait_script.contains("__FORMAL_AI_VERSION__"),
   00223|         "wait script should still reject an index that retains un-stamped placeholders"
   00224|     );
   00225| }
