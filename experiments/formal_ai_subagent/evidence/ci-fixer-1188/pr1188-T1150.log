   00684| /// Issue #534 forbids caching `target/` in CI, and the reason is disk rather
   00685| /// than taste: a hosted ubuntu runner ships ~14 GB free, seven jobs already run
   00686| /// `scripts/free-runner-disk.sh` to survive, and a job that exhausts `/` takes
   00687| /// the runner down with no failed step and no log to download. A cached target
   00688| /// tree measured 930 MB per job on top of that.
   00689| ///
   00690| /// The guard read three hand-listed files, so `agentic-cli-matrix.yml` and
   00691| /// `external-benchmarks.yml` cached it unnoticed. It now reads every workflow;
   00692| /// this test pins that it does, because a policy enforced over part of the tree
   00693| /// reports compliance it has not checked.
   00694| #[test]
   00695| fn the_disk_policy_reads_every_workflow_not_a_hand_listed_few() {
   00696|     let manifest_dir = concat!(env!("CARGO_MANIFEST_DIR"), "/..");
   00697|     let guard = fs::read_to_string(format!("{manifest_dir}/scripts/check-disk-usage-policy.rs"))
   00698|         .expect("disk usage policy guard should be readable");
   00699| 
   00700|     assert!(
   00701|         guard.contains(r#"fs::read_dir(".github/workflows")"#),
   00702|         "the disk policy must sweep the workflow directory, or a workflow it \
   00703|          does not list can cache the target tree unnoticed"
   00704|     );
   00705| 
   00706|     let dir = format!("{manifest_dir}/.github/workflows");
   00707|     let mut checked = 0;
   00708|     for entry in fs::read_dir(&dir).expect("workflow directory should be readable") {
   00709|         let path = entry.expect("directory entry").path();
   00710|         if path.extension().is_none_or(|ext| ext != "yml") {
   00711|             continue;
   00712|         }
   00713|         let workflow = fs::read_to_string(&path).expect("workflow should be readable");
   00714|         assert!(
   00715|             !workflow.lines().any(|line| line.trim() == "target"),
   00716|             "{} caches the target tree, which issue #534 forbids",
   00717|             path.display()
   00718|         );
   00719|         checked += 1;
   00720|     }
   00721|     assert!(checked > 0, "the sweep must actually find workflows");
   00722| }
