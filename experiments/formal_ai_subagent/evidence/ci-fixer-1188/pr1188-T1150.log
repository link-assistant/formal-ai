   00784| #[test]
   00785| fn release_workflow_jobs_have_explicit_timeouts() {
   00786|     let workflow = release_workflow();
   00787|     let expected_timeouts = [
   00788|         ("detect-changes", 5),
   00789|         ("changelog", 10),
   00790|         // Issue #808's evidence-check job now lives in
   00791|         // `.github/workflows/evidence-check.yml`; its timeout is asserted by
   00792|         // `evidence_check_workflow_caps_its_job_and_installs_rust_script_with_the_retry_wrapper`.
   00793|         ("docker-build", 30),
   00794|         ("secrets-scan", 10),
   00795|         ("version-check", 5),
   00796|         // Issue #1081 (D15): probes every publishing credential with a write
   00797|         // before the pipeline spends 90 minutes building what it cannot
   00798|         // publish. Five probes over HTTP against five registries; the cap is a
   00799|         // backstop for a hung TLS handshake, not a work budget.
   00800|         ("release-preflight", 5),
   00801|         // Issue #1017: resolves the base-branch commit once so `lint`, `test`
   00802|         // and the macOS lane all merge the same one instead of each resolving
   00803|         // the tip at its own start time. A reusable workflow, so it owns its
   00804|         // own cap -- and so `release.yml` does not pay lines for it against the
   00805|         // 1500-line band this same file pins below.
   00806|         ("base", 0),
   00807|         // Issue #812: raised from 10; the job grew from ~3.3 to ~7.8 minutes.
   00808|         // Issue #1076 (D5): raised from 15. Over 400 `main` runs the worst
   00809|         // case was 12.7 min, 84.4% of that cap and trending up (6.0 -> 12.7
   00810|         // across the window) -- the deadline, not the backstop, and a cap kills
   00811|         // as `cancelled`. No single step dominates here, so the cap is the only
   00812|         // mechanism available; 25 puts the same worst case at 50.7%.
   00813|         // Issue #1138: raised from 25. The gate set kept growing and run
   00814|         // 35806556194 consumed the full 25 minutes, killed mid-gate inside
   00815|         // repository_workspace_protocol and reported as `cancelled` -- the red
   00816|         // hidden behind a cancelled job, every gate that did run passing. The
   00817|         // measured demand of at least 25.2 min sits under 56% of 45, back
   00818|         // below the 70% warn line of check-job-headroom.rs.
   00819|         // PR #1188: instead of a fourth raise, the gates run as four parallel
   00820|         // lanes (`lane` in data/meta/ci-gates/); 30 holds the slowest (~15).
   00821|         ("lint", 30),
   00822|         // Issue #812: raised from 15 after run 29767811026 was killed 1.1 s
   00823|         // after the suite passed. See
   00824|         // `test_job_budget_exceeds_the_measured_suite_cost_and_warns_before_it_is_eaten`.
   00825|         // Issue #1012 partitions the macOS core suite so every slice retains
   00826|         // this baseline rather than extending a monolithic timeout.
   00827|         // Issue #1017 raised this from 25: 455s of the job runs outside the
   00828|         // budgeted step, so a 20-minute budget under a 25-minute cap could
   00829|         // never expire first.
   00830|         // Issue #1081 raised this from 35. The job is a matrix, and its two
   00831|         // legs are budgeted separately: the `full` leg now declares 2640s
   00832|         // across four steps and the `specification` leg 2460s across two, after
   00833|         // the compile that was 86% of `Run specification tests` was split into
   00834|         // a step of its own. One cap covers both legs, so it has to hold the
   00835|         // larger sum at or under the 70% share
   00836|         // `job_budget_fit::the_budgets_a_job_can_spend_together_fit_inside_its_cap`
   00837|         // enforces: 2640/3900 is 67.7%.
   00838|         // The same fix raised the cap from 65 to 90: the spec lane's worst
   00839|         // budgeted group is 3600s, and 3600/5400 leaves it at 66% of the cap
   00840|         // instead of 92% of the old one -- the budget, not the cap, stays the
   00841|         // real deadline.
   00842|         // Issue #1138 raised the full leg's `Run tests` budget from 1440 to
   00843|         // 2400 (measured demand ~1520s: unit 1251-1315s + integration ~200s),
   00844|         // which lifts that leg's sum to 3600s -- the same 66% of this cap.
   00845|         // PR #1188 (R1188-U9) lowered it to 30: both suites run prebuilt
   00846|         // executables in shards (full five, specification four), and each
   00847|         // budgeted group is 1080s, 60% of the cap.
   00848|         ("test", 30),
   00849|         // Issue #1014 compiles one nextest archive and fans it out to five
   00850|         // macOS runners. The reusable workflow owns both internal timeouts.
   00851|         ("macos-core-tests", 0),
   00852|         // Issue #896: raised from 10; the published web-search/web-capture
   00853|         // graphs moved the job from ~4-5 to 7.2 minutes, and a cold release
   00854|         // build after a Cargo.lock change hit the former cap.
   00855|         // Issue #1076 (D5): raised from 15. The run that missed its cargo
   00856|         // cache took 11.6 min, 77.0% of the cap; 20 puts it at 57.8%.
   00857|         ("build", 20),
   00858|         // R1015: the JavaScript server answers the parity corpus as the
   00859|         // release binary does; it reuses build-artifacts' binary, so no compile.
   00860|         ("server-parity", 15),
