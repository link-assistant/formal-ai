   00557| /// Issue #812: nothing validated the pipeline definitions themselves, and
   00558| /// `cargo clippy` ran without `-D warnings` while every lint in `[lints.clippy]`
   00559| /// is set to `warn` -- so clippy printed findings and exited 0.
   00560| #[test]
   00561| fn lint_job_gates_on_workflow_shell_and_clippy_findings() {
   00562|     // Clippy and the shell lint are registered gates since issue #991.
   00563|     // actionlint left this job in issue #1076: as a bare binary it skips every
   00564|     // `run:` check and exits 0 when ShellCheck is absent, so it runs as the
   00565|     // Docker image in `workflows.yml` now. `issue_999` owns the assertion.
   00566|     let workflow = ci_surface();
   00567|     let lint = job_block(&workflow, "lint");
   00568| 
   00569|     assert!(
   00570|         lint.contains("cargo clippy --manifest-path rust/Cargo.toml --lib --bins --tests --all-features -- -D warnings"),
   00571|         "clippy must lint executable test targets and fail the job on findings"
   00572|     );
   00573|     assert!(
