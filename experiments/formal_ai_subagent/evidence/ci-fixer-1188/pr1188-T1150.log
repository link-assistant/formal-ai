   00430| /// Issue #812: run 29767811026 reported `Test (ubuntu-latest)` as failed with
   00431| /// every test passing -- the suite finished 1.1 s before `timeout-minutes: 15`
   00432| /// killed the job. The budget must exceed the measured cost, and the step must
   00433| /// say so out loud before the margin is eaten again.
   00434| #[test]
   00435| fn test_job_budget_exceeds_the_measured_suite_cost_and_warns_before_it_is_eaten() {
   00436|     let workflow = release_workflow();
   00437|     let test_job = job_block(&workflow, "test");
   00438| 
   00439|     // Issue #1017: the cap has to clear the budget by more than the job's
   00440|     // unbudgeted setup -- checkout, disk cleanup, the data-file and self-AST
   00441|     // census gates and the doc tests measured 455s on run 31937348472 -- or the
   00442|     // job clock still wins and the overrun is reported as `cancelled`.
   00443|     //
   00444|     // Issue #1081 replaced the two exact numbers this used to pin with floors,
   00445|     // and both moved the same day. Pinning an exact budget is what makes a
   00446|     // budget unable to grow when the work under it grows, which is how the
   00447|     // macOS specification shard reached 100.1% of its budget twice with no
   00448|     // warning; the arithmetic that decides what the numbers should be now
   00449|     // lives in `tests/unit/ci-cd/job_budget_fit.rs`, which recomputes the whole
   00450|     // job from the workflow instead of memorising one figure from it. What
   00451|     // this test still defends is the shape: a plain-number cap, a budget on
   00452|     // the suite, and the wrapper that makes the overrun red rather than grey.
   00453|     let cap_minutes: u64 = test_job
   00454|         .lines()
   00455|         .find_map(|line| line.trim().strip_prefix("timeout-minutes:"))
   00456|         .and_then(|value| value.trim().parse().ok())
   00457|         .expect("the test job declares a plain-number timeout-minutes");
   00458|     // PR #1188 (R1188-U9) runs the suite as five shards of prebuilt
   00459|     // executables, a fifth of it about 450s (run 37802763478), so the floors
   00460|     // are per shard: 15 minutes of shard work behind a 25-minute backstop.
   00461|     assert!(
   00462|         cap_minutes >= 25,
   00463|         "the test job's cap is {cap_minutes}m; a shard of the suite plus its \
   00464|          setup needs at least 25m of backstop behind it"
   00465|     );
   00466|     let suite_budget: u64 = workflow_step_block(test_job, "Run tests")
   00467|         .lines()
   00468|         .find_map(|line| line.trim().strip_prefix("TEST_BUDGET_SECONDS:"))
   00469|         .and_then(|value| value.trim().parse().ok())
   00470|         .expect("the full-suite step declares a plain-number execution budget");
   00471|     assert!(
   00472|         suite_budget >= 900,
   00473|         "the full suite's execution budget is {suite_budget}s, below the 900s \
   00474|          that twice a measured shard needs"
   00475|     );
   00476|     assert!(
   00477|         suite_budget <= cap_minutes * 60,
   00478|         "the full suite's {suite_budget}s budget cannot expire before the          {cap_minutes}m cap that is supposed to be its backstop"
   00479|     );
   00480|     assert!(
   00481|         test_job.contains("scripts/run-with-budget-warning.sh"),
   00482|         "creeping back toward the cap must be visible in the run summary rather \
   00483|          than resurfacing as a mystery cancellation (issue #812)"
   00484|     );
   00485| }
