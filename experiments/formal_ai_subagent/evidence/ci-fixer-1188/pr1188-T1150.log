   00594|     .expect("lint-shell-scripts.sh");
   00595|     assert!(shell_lint.contains("shellcheck --severity=warning"));
   00596|     assert!(
   00597|         shell_lint.contains("the lint selector is broken"),
   00598|         "an empty selector must fail rather than lint nothing (issue #812)"
   00599|     );
