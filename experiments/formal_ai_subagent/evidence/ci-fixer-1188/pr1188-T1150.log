   00088| /// PR #965 review: "All CI/CD warnings, and errors must be also fixed.
   00089| /// Including all false positives and false negatives."
   00090| ///
   00091| /// `actions/deploy-pages` accepts at most a 600 000 ms wait. On `main` run
   00092| /// 31090830031 the artifact uploaded successfully (15.7 MB, id 8966823763) and
   00093| /// the action then reported `Current status: deployment_queued` for that entire
   00094| /// default before `Timeout reached, aborting!` — a red pipeline caused by
   00095| /// GitHub's Pages deployment queue rather than by anything in the commit. The
   00096| /// next push deployed green with no code change, which is the signature of a
   00097| /// false positive. Pin the documented maximum rather than supplying the
   00098| /// unsupported 1 200 000 ms value that the action silently clamps, and keep
   00099| /// the job's own budget above it.
   00100| #[test]
   00101| fn pages_deploy_uses_the_actions_maximum_supported_wait() {
   00102|     const DEPLOY_ACTION_MAXIMUM_MS: u64 = 600_000;
   00103| 
   00104|     let workflow = release_workflow();
   00105|     let deploy_demo = job_block(&workflow, "deploy-pages");
   00106| 
   00107|     let timeout_ms = deploy_demo
   00108|         .split("actions/deploy-pages@v5")
   00109|         .nth(1)
   00110|         .and_then(|after| after.split_once("timeout: "))
   00111|         .and_then(|(_, rest)| rest.split_whitespace().next())
   00112|         .and_then(|value| value.parse::<u64>().ok())
   00113|         .expect("the deploy-pages step should pin an explicit `timeout:` in milliseconds");
   00114| 
   00115|     assert!(
   00116|         timeout_ms == DEPLOY_ACTION_MAXIMUM_MS,
   00117|         "deploy-pages accepts at most {DEPLOY_ACTION_MAXIMUM_MS} ms, got {timeout_ms} ms"
   00118|     );
   00119| 
   00120|     let job_budget_ms = job_block(&workflow, "deploy-pages")
   00121|         .split_once("timeout-minutes: ")
   00122|         .and_then(|(_, rest)| rest.split_whitespace().next())
   00123|         .and_then(|value| value.parse::<u64>().ok())
   00124|         .map(|minutes| minutes * 60_000)
   00125|         .expect("deploy-pages should declare timeout-minutes");
   00126| 
   00127|     assert!(
   00128|         job_budget_ms > timeout_ms,
   00129|         "the deploy-pages job budget ({job_budget_ms} ms) must exceed the deployment wait \
   00130|          ({timeout_ms} ms), or `timeout-minutes` kills the job before the wait can help"
   00131|     );
   00132| }
