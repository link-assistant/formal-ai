   00933|                     job_block(&reusable, inner_job).contains("    timeout-minutes:"),
   00934|                     "{inner_job} should declare an explicit timeout"
   00935|                 );
   00936|             }
   00937|             continue;
   00938|         }
   00939|         let expected = format!("    timeout-minutes: {timeout_minutes}\n");
   00940|         assert!(
   00941|             job.contains(&expected),
   00942|             "{job_name} should declare {expected:?}"
   00943|         );
   00944|     }
