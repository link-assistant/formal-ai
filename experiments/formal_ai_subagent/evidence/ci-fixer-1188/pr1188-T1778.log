   00329| fn literal_code_search_query(normalized: &str) -> Option<String> {
   00330|     seed::lexicon()
   00331|         .role_word_forms(seed::ROLE_CODING_SEARCH_LITERAL_QUERY)
   00332|         .into_iter()
   00333|         .find(|form| normalized.contains(&form.text.to_lowercase()))
   00334|         .and_then(|form| (!form.action.is_empty()).then(|| form.action.clone()))
   00335| }
   00336| 
   00337| /// The most identifier-shaped token in `prompt`, if it holds one.
   00338| ///
   00339| /// Prose names an identifier by writing it: `task_decomposition`,
   00340| /// `retry-policy`, `AgenticPlan`, `Cargo.toml`. Each of those carries a mark
   00341| /// that ordinary English words do not, and the marks are weighted by how rarely
   00342| /// prose produces them. A hyphen is the weakest because prose hyphenates freely,
   00343| /// so `retry-policy` only wins when nothing better is present -- and when it
   00344| /// does win it is lowered to `retry_policy`, the spelling the source would use.
   00345| ///
   00346| /// A run of digits separated by dots is excluded even though it carries the
   00347| /// strongest mark. It is never an identifier: it is a version, a section, or --
   00348| /// the case that sent an entire ladder node to grep for `1.1.1.1.1` and record
   00349| /// the result as its evidence -- a node path in the instructions wrapped around
   00350| /// the task (issue #1066).
   00351| fn shaped_code_search_token(prompt: &str) -> Option<String> {
   00352|     search_tokens(prompt)
   00353|         .filter_map(|token| {
   00354|             let interior_uppercase = token
   00355|                 .chars()
   00356|                 .skip(1)
   00357|                 .any(|character| character.is_ascii_uppercase());
   00358|             let score = usize::from(token.contains('.')) * 4
   00359|                 + usize::from(token.contains('_')) * 4
   00360|                 + usize::from(interior_uppercase) * 3
   00361|                 + usize::from(token.contains('-')) * 2;
   00362|             let shaped = score > 0 && !token.contains('/') && !is_dotted_number(token);
   00363|             shaped.then_some((score, token.len(), token))
   00364|         })
   00365|         .max_by_key(|(score, length, _)| (*score, *length))
   00366|         .map(|(_, _, token)| token.replace('-', "_"))
   00367| }
   00368| 
   00369| fn adjacent_code_search_token(prompt: &str, normalized: &str) -> Option<String> {
   00370|     let tokens = search_tokens_with_offsets(prompt).collect::<Vec<_>>();
   00371|     seed::lexicon()
   00372|         .role_word_forms(seed::ROLE_CODING_SEARCH_SUBJECT_KIND)
   00373|         .into_iter()
   00374|         .filter_map(|form| {
   00375|             let surface = form.text.to_lowercase();
   00376|             let start = normalized.find(&surface)?;
   00377|             let end = start.checked_add(surface.len())?;
   00378|             tokens
   00379|                 .iter()
   00380|                 .filter(|(_, token_start, token_end)| *token_end <= start || *token_start >= end)
   00381|                 .filter_map(|(token, token_start, token_end)| {
   00382|                     let distance = if *token_end <= start {
   00383|                         start - *token_end
   00384|                     } else {
   00385|                         *token_start - end
   00386|                     };
   00387|                     valid_search_identifier(token).then_some((distance, *token_start, *token))
   00388|                 })
   00389|                 .min_by_key(|(distance, offset, _)| (*distance, *offset))
   00390|         })
   00391|         .min_by_key(|(distance, offset, _)| (*distance, *offset))
   00392|         .map(|(_, _, token)| token.to_owned())
   00393| }
   00394| 
   00395| pub(super) fn search_tokens(text: &str) -> impl Iterator<Item = &str> {
   00396|     text.split(|character: char| {
   00397|         !character.is_ascii_alphanumeric() && !matches!(character, '_' | '.' | ':' | '-')
   00398|     })
   00399|     .map(|token| token.trim_matches(['.', '-']))
   00400|     .filter(|token| !token.is_empty())
   00401| }
   00402| 
   00403| fn search_tokens_with_offsets(text: &str) -> impl Iterator<Item = (&str, usize, usize)> {
   00404|     text.split_inclusive(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00405|         .scan(0, |offset, chunk| {
   00406|             let start = *offset;
   00407|             *offset += chunk.len();
   00408|             let token = chunk.trim_end_matches(|character: char| {
   00409|                 !character.is_ascii_alphanumeric() && character != '_'
   00410|             });
   00411|             Some((token, start, start + token.len()))
   00412|         })
   00413|         .filter(|(token, _, _)| !token.is_empty())
   00414| }
   00415| 
   00416| pub(super) fn valid_search_identifier(token: &str) -> bool {
   00417|     let mut characters = token.chars();
   00418|     characters
   00419|         .next()
   00420|         .is_some_and(|first| first.is_ascii_alphabetic() || first == '_')
   00421|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00422|         && !seed::lexicon()
   00423|             .words_for_role(seed::ROLE_CODING_SEARCH_SUBJECT_KIND)
   00424|             .iter()
   00425|             .any(|surface| surface.eq_ignore_ascii_case(token))
   00426| }
