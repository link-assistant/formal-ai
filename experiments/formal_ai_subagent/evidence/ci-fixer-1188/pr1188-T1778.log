   00268| /// Recover the literal subject of a seed-backed source-code search request.
   00269| ///
   00270| /// A client may advertise a dedicated grep/code-search tool instead of a shell.
   00271| /// The planner uses this semantic query before falling back to the `rg` lowering
   00272| /// returned by [`shell_command_for_task`].
   00273| ///
   00274| /// The request has to spell the act out — "search the repository for
   00275| /// `task_decomposition`". A request that only says what the caller wants to
   00276| /// know is a different admission with a stricter subject rule; see
   00277| /// [`super::workspace_inspection::workspace_inspection_search_for_task`].
   00278| pub(super) fn code_search_query_for_task(prompt: &str) -> Option<String> {
   00279|     let vocab = seed::shell_intent_vocabulary();
   00280|     super::stated_request::request_blocks(prompt)
   00281|         .into_iter()
   00282|         .find_map(|block| {
   00283|             let lower = block.to_lowercase();
   00284|             let cue = longest_search_cue(&lower, &vocab)?;
   00285|             literal_code_search_query(&lower)
   00286|                 .or_else(|| shaped_code_search_token(block))
   00287|                 .or_else(|| adjacent_code_search_token(block, &lower))
   00288|                 .or_else(|| local_search_query(block, &cue, &vocab))
   00289|         })
   00290| }
