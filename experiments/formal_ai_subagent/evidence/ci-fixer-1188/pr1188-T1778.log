   00292| /// Resolve the source subject named by an inspection request.
   00293| ///
   00294| /// Explicit literal cues and visibly code-shaped tokens are unambiguous on
   00295| /// their own. A plain identifier is also unambiguous when the seed lexicon
   00296| /// places it next to a source-artifact kind, such as `retry check`.
   00297| pub(super) fn code_shaped_query(text: &str) -> Option<String> {
   00298|     let normalized = text.to_lowercase();
   00299|     literal_code_search_query(&normalized)
   00300|         .or_else(|| shaped_code_search_token(text))
   00301|         .or_else(|| adjacent_code_search_token(text, &normalized))
   00302| }
   00303| 
   00304| /// The longest search cue `normalized` spells out, if it spells one out at all.
   00305| ///
   00306| /// Both registries describe the same act from different sides — the shell
   00307| /// vocabulary lowers it to `rg`, the capability registry routes it to a `grep`
   00308| /// tool — so a cue from either one is an explicit request to search. The longest
   00309| /// match wins because a longer cue is the more specific reading of the same
   00310| /// words.
   00311| fn longest_search_cue(normalized: &str, vocab: &ShellIntentVocabulary) -> Option<String> {
   00312|     let intent_cues = vocab
   00313|         .intents
   00314|         .iter()
   00315|         .filter(|intent| intent.command == "rg")
   00316|         .flat_map(|intent| intent.cues.iter());
   00317|     let capability_registry = seed::agentic_tool_capabilities();
   00318|     let capability_cues = capability_registry
   00319|         .iter()
   00320|         .filter(|capability| capability.id == "grep")
   00321|         .flat_map(|capability| capability.cues.iter());
   00322|     intent_cues
   00323|         .chain(capability_cues)
   00324|         .filter(|cue| normalized.contains(cue.as_str()))
   00325|         .max_by_key(|cue| cue.chars().count())
   00326|         .cloned()
   00327| }
