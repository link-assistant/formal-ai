   00188| /// Whether `word` is a seed-declared noun that names a command. Punctuation is
   00189| /// trimmed and case folded across scripts, so *«команду»* and *"Command."* both
   00190| /// match their seed entry.
   00191| fn names_a_command(word: &str, vocab: &TerminalCommandVocabulary) -> bool {
   00192|     let normalized = word
   00193|         .trim_matches(|c: char| !c.is_alphanumeric())
   00194|         .to_lowercase();
   00195|     !normalized.is_empty() && vocab.command_nouns.iter().any(|noun| noun == &normalized)
   00196| }
