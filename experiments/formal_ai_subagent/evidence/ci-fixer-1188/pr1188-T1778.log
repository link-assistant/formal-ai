   00198| /// Whether a recovered command line is really a sentence describing an action.
   00199| ///
   00200| /// Two tells, either of which is enough: the command position holds a
   00201| /// natural-language word, or the arguments carry two or more function words. A
   00202| /// genuine command line spends its arguments on paths and flags, not on *in
   00203| /// the*, *without asking*, or *so that*.
   00204| ///
   00205| /// A known shell token in command position settles it outright, because the two
   00206| /// vocabularies overlap: `file` is both a Unix command and an ordinary English
   00207| /// word, so `execute file Cargo.toml` must stay a command.
   00208| fn reads_as_prose(remainder: &str, vocab: &TerminalCommandVocabulary) -> bool {
   00209|     let mut words = remainder.split_whitespace();
   00210|     let Some(first) = words.next() else {
   00211|         return true;
   00212|     };
   00213|     // A web address is a resource to act on, not a program to run. Issue #862
   00214|     // asked to *"Execute https://rosettacode.org/wiki/Copy_stdin_to_stdout in
   00215|     // Rust"* — the task published at that address, not the address typed at a
   00216|     // shell — and the passthrough prefix happily handed the whole line over.
   00217|     if first.contains("://") {
   00218|         return true;
   00219|     }
   00220|     let command = normalize_command_word(first);
   00221|     if vocab.shell_tokens.iter().any(|token| token == &command) {
   00222|         return false;
   00223|     }
   00224|     is_prose_word(first) || words.filter(|word| is_prose_word(word)).count() >= 2
   00225| }
