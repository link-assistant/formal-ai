   00085| fn strip_balanced_outer_quotes(prompt: &str) -> &str {
   00086|     for quote in ['"', '\'', '`'] {
   00087|         if prompt.starts_with(quote) && prompt.ends_with(quote) && prompt.len() >= 2 {
   00088|             return &prompt[1..prompt.len() - 1];
   00089|         }
   00090|     }
   00091|     prompt
   00092| }
   00093| 
   00094| /// Pass an explicitly introduced command through byte-for-byte (apart from
   00095| /// surrounding whitespace). Explicit execution is an intent boundary: the
   00096| /// command need not appear in a maintained binary allowlist because the client
   00097| /// still owns its normal sandbox and permission decision.
   00098| ///
   00099| /// The remainder must still *look* like a command line rather than a sentence
   00100| /// about one. `run`/`execute` are ordinary English verbs, so "Run all tests in
   00101| /// the background" and "Execute nothing without asking the operator first"
   00102| /// reach this function exactly like "run cargo test" does — and passing their
   00103| /// prose through produced commands such as `all tests in the background`. The
   00104| /// allowlist stays absent: an unknown binary (`mytool --flag`, `./build.sh`) is
   00105| /// accepted, and only prose is refused.
   00106| fn prefixed_shell_command(prompt: &str, vocab: &TerminalCommandVocabulary) -> Option<String> {
   00107|     let prompt = prompt.trim();
   00108|     let lower = prompt.to_lowercase();
   00109|     let prefix = vocab
   00110|         .passthrough_prefixes
   00111|         .iter()
   00112|         .filter(|prefix| prefix_boundary(&lower, prefix))
   00113|         .max_by_key(|prefix| prefix.chars().count())?;
   00114|     let remainder = command_span(prompt.get(prefix.len()..)?.trim_start())?;
   00115|     let remainder = trim_command_sentence_end(strip_balanced_outer_quotes(remainder));
   00116|     if let Some(named) = command_named_in_prose(remainder, vocab) {
   00117|         return Some(named);
   00118|     }
   00119|     (!remainder.is_empty() && !reads_as_prose(remainder, vocab)).then(|| remainder.to_owned())
   00120| }
   00121| 
   00122| /// The sentence's full stop and the quotes it wrapped around the command,
   00123| /// peeled from the last token to a fixpoint.
   00124| ///
   00125| /// `Run python3 greet.py.` ran `python3 greet.py.`, which names no file, and
   00126| /// `` Run `ls -la`. `` ran the backticks too (PR #1188 dogfooding). The dot is
   00127| /// peeled by [`trim_trailing_sentence_dot`], so `cd ..` and `ls .` keep the
   00128| /// dots that are their whole argument.
   00129| fn trim_command_sentence_end(remainder: &str) -> &str {
   00130|     let mut current = remainder;
   00131|     loop {
   00132|         let unquoted = strip_balanced_outer_quotes(current.trim());
   00133|         let split = unquoted
   00134|             .char_indices()
   00135|             .rfind(|(_, character)| character.is_whitespace())
   00136|             .map_or(0, |(at, character)| at + character.len_utf8());
   00137|         let next = &unquoted[..split + trim_trailing_sentence_dot(&unquoted[split..]).len()];
   00138|         if next == current {
   00139|             return current;
   00140|         }
   00141|         current = next;
   00142|     }
   00143| }
