   00227| /// The command an explicit passthrough prefix introduces, if any.
   00228| ///
   00229| /// This is the boundary the shell cascade itself trusts: a prompt that opens
   00230| /// with a run verb plus a known terminal token (`execute cp a.txt b.txt`)
   00231| /// dictates the command verbatim, so the capability table must not re-read its
   00232| /// operands as a request (issue #749).
   00233| pub(super) fn explicit_passthrough_command(prompt: &str) -> Option<String> {
   00234|     let prompt = strip_balanced_outer_quotes(prompt.trim());
   00235|     if governs_commands_rather_than_requesting_one(prompt) {
   00236|         return None;
   00237|     }
   00238|     prefixed_shell_command(prompt, &seed::terminal_command_vocabulary())
   00239|         .filter(|command| super::shell_command_policy::shell_quotes_paired(command))
   00240| }
