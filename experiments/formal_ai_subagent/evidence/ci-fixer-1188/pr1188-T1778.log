   00260| fn prefix_boundary(prompt: &str, prefix: &str) -> bool {
   00261|     prompt.starts_with(prefix)
   00262|         && prompt
   00263|             .get(prefix.len()..)
   00264|             .and_then(|rest| rest.chars().next())
   00265|             .is_some_and(|c| c.is_whitespace() || c == ':')
   00266| }
