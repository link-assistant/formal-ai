   00024| const REPORT_ISSUE_ACTION: &str = "formal-ai:report-issue";
   00025| /// Resolve a user turn into the concrete shell command the agentic loop should run.
   00026| ///
   00027| /// Named commands preserve their flags, paths and subcommands. Directory
   00028| /// listings use the seeded listing intent. Both vocabularies live in seed
   00029| /// data, so new language forms do not require prompt-specific code.
   00030| pub(super) fn shell_command_for_task(prompt: &str) -> Option<String> {
   00031|     let prompt = strip_balanced_outer_quotes(prompt.trim());
   00032|     // Caller policy is filtered here, not inside one strategy, because
   00033|     // `prefixed_shell_command` below runs first and matches on the whole prompt:
   00034|     // a rule applied only to `named_shell_command` would leave
   00035|     // "Run commands with sudo only when necessary." passing straight through as
   00036|     // an explicitly introduced command (issue #907, follow-up).
   00037|     if governs_commands_rather_than_requesting_one(prompt) {
   00038|         return None;
   00039|     }
   00040|     let vocab = seed::terminal_command_vocabulary();
   00041|     let intent_vocab = seed::shell_intent_vocabulary();
   00042|     let intent = intent_shell_command(prompt, &intent_vocab);
   00043|     let listing = asks_for_directory_listing(prompt);
   00044|     let web_search = crate::solver_handlers::web_search_query_for(prompt).is_some();
   00045|     let semantic = listing.then(|| String::from("ls")).or(intent);
   00046| 
   00047|     if let Some(command) = prefixed_shell_command(prompt, &vocab) {
   00048|         let first = command
   00049|             .split_whitespace()
   00050|             .next()
   00051|             .map(normalize_command_word);
   00052|         let names_known_command = first
   00053|             .as_ref()
   00054|             .is_some_and(|first| vocab.shell_tokens.iter().any(|token| token == first));
   00055|         let names_semantic_command = semantic.as_ref().is_some_and(|semantic| {
   00056|             semantic
   00057|                 .split_whitespace()
   00058|                 .next()
   00059|                 .map(normalize_command_word)
   00060|                 == first
   00061|         });
   00062|         if names_semantic_command {
   00063|             return semantic;
   00064|         }
   00065|         if names_known_command || (semantic.is_none() && !web_search) {
   00066|             return Some(command);
   00067|         }
   00068|     }
   00069| 
   00070|     semantic
   00071|         .or_else(|| named_shell_command(prompt, &vocab))
   00072|         .or_else(|| bare_shell_command(prompt, &vocab))
   00073| }
