   00075| /// Resolve only the seed-backed natural-language shell intent.
   00076| ///
   00077| /// The interactive solver uses this narrower entry point after its explicit
   00078| /// terminal syntax checks, so ordinary Chat requests and the agentic planner
   00079| /// share one semantic intent table without broadening Chat detection to every
   00080| /// named shell token.
   00081| pub fn semantic_shell_command_for_task(prompt: &str) -> Option<String> {
   00082|     intent_shell_command(prompt, &seed::shell_intent_vocabulary())
   00083| }
