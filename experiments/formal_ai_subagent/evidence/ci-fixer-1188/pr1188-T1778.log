   00242| fn bare_shell_command(prompt: &str, vocab: &TerminalCommandVocabulary) -> Option<String> {
   00243|     let first = prompt.split_whitespace().next()?;
   00244|     let command = normalize_command_word(first);
   00245|     // A bare command token can also be an ordinary imperative (notably
   00246|     // `find information about ...`).  Explicit passthrough prefixes above are
   00247|     // unambiguous, but a seed-backed web-search request must remain available
   00248|     // to the dedicated search router instead of becoming a shell command.
   00249|     if crate::solver_handlers::web_search_query_for(prompt).is_some() {
   00250|         return None;
   00251|     }
   00252|     let is_known = vocab
   00253|         .bare_shell_tokens
   00254|         .iter()
   00255|         .any(|token| token == &command);
   00256|     let words = prompt.split_whitespace().collect::<Vec<_>>();
   00257|     (is_known && words[1..].iter().all(|word| !is_prose_word(word))).then(|| prompt.to_owned())
   00258| }
