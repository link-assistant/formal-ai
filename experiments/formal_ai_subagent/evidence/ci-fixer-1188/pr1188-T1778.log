   00145| /// Characters that turn the words around them into data rather than prose:
   00146| /// quoting, redirection, substitution and command separators.
   00147| const SHELL_QUOTING_AND_METACHARACTERS: &[char] = &[
   00148|     '"', '\'', '`', '|', '&', ';', '<', '>', '$', '(', ')', '{', '}',
   00149| ];
   00150| 
   00151| /// Recover the command from a remainder that *names* it instead of being it.
   00152| ///
   00153| /// Issue #866 and #867 reported *"Execute ls command"* running `/bin/ls
   00154| /// command`, which fails with *cannot access 'command'*. The trailing noun
   00155| /// names the command; it is not an argument to it. Seed data declares those
   00156| /// nouns per language in `data/seed/terminal-commands.lino`, and their presence
   00157| /// is the tell that the remainder is a noun phrase *about* a command rather
   00158| /// than a command line — so the command is collected out of it, dropping the
   00159| /// determiners that lead the phrase and stopping at the prose that ends it,
   00160| /// exactly as argument collection does elsewhere.
   00161| ///
   00162| /// Quoting and shell metacharacters switch the recovery off, because inside
   00163| /// them a word is data: `git commit -m 'fix command parsing'` keeps its message.
   00164| fn command_named_in_prose(remainder: &str, vocab: &TerminalCommandVocabulary) -> Option<String> {
   00165|     if remainder.contains(|c| SHELL_QUOTING_AND_METACHARACTERS.contains(&c)) {
   00166|         return None;
   00167|     }
   00168|     let words = remainder.split_whitespace().collect::<Vec<_>>();
   00169|     let kept = words
   00170|         .iter()
   00171|         .copied()
   00172|         .filter(|word| !names_a_command(word, vocab))
   00173|         .collect::<Vec<_>>();
   00174|     if kept.len() == words.len() || kept.is_empty() {
   00175|         return None;
   00176|     }
   00177|     let start = kept.iter().position(|word| !is_prose_word(word))?;
   00178|     let mut command = vec![kept[start]];
   00179|     for word in &kept[start + 1..] {
   00180|         if is_prose_word(word) {
   00181|             break;
   00182|         }
   00183|         command.push(word);
   00184|     }
   00185|     Some(command.join(" "))
   00186| }
