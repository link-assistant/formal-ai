   00007| fn repository_file(path: &str) -> String {
   00008|     fs::read_to_string(format!("{}/../{path}", env!("CARGO_MANIFEST_DIR")))
   00009|         .unwrap_or_else(|error| panic!("read {path}: {error}"))
