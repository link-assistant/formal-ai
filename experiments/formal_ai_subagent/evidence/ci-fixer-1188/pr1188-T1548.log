   00044| #[test]
   00045| fn write_jobs_queue_together_without_workflow_level_cancellation() {
   00046|     let release = release_workflow();
   00047|     let desktop = desktop_release_workflow();
   00048|     let external = repository_file(".github/workflows/external-benchmarks.yml");
   00049|     let shared = concat!(
   00050|         "    concurrency:\n",
   00051|         "      group: formal-ai-repository-writes\n",
   00052|         "      queue: max\n",
   00053|     );
   00054| 
   00055|     for workflow in [&release, &desktop, &external] {
   00056|         let header = workflow.split("\njobs:\n").next().unwrap();
   00057|         assert!(!header.contains("\nconcurrency:\n"));
   00058|     }
   00059|     for job_name in [
   00060|         "auto-release",
   00061|         "manual-release",
   00062|         "changelog-pr",
   00063|         "deploy-pages",
   00064|     ] {
   00065|         assert!(job_block(&release, job_name).contains(shared), "{job_name}");
   00066|     }
   00067|     let desktop_build = job_block(&desktop, "build");
   00068|     assert!(desktop_build.contains("group: desktop-release-${{ github.event.pull_request.number || needs.resolve.outputs.tag }}-${{ matrix.label }}"));
   00069|     assert!(desktop_build.contains("queue: max"));
   00070|     let vscode = job_block(&desktop, "vscode");
   00071|     assert!(vscode.contains("group: desktop-release-${{ github.event.pull_request.number || needs.resolve.outputs.tag }}-vscode"));
   00072|     assert!(vscode.contains("queue: max"));
   00073|     assert!(job_block(&desktop, "finalize").contains(shared));
   00074|     assert!(job_block(&external, "external-benchmarks").contains(shared));
   00075| }
