   00127| #[test]
   00128| fn actionlint_tracks_githubs_queue_schema_without_hiding_other_errors() {
   00129|     // Issue #1076 moved actionlint out of release.yml's `lint` job and into
   00130|     // `.github/workflows/workflows.yml`, and with it the `-ignore` flag, which
   00131|     // is now a `paths:` entry in `.github/actionlint.yaml`. The property this
   00132|     // test defends is unchanged: the suppression names GitHub's `queue` schema
   00133|     // lag specifically and cannot be widened into a blanket filter.
   00134|     let workflow = repository_file(".github/workflows/workflows.yml");
   00135|     let config = repository_file(".github/actionlint.yaml");
   00136| 
   00137|     // Issue #1079 replaced the tag with the digest it resolved to: a tag is a
   00138|     // mutable pointer, and `.github/zizmor.yml` forbids those. The tag it was
   00139|     // resolved from stays in the comment beside it, so a bump is still a
   00140|     // readable diff rather than an opaque hash swap.
   00141|     assert!(
   00142|         workflow.contains("docker://rhysd/actionlint@sha256:"),
   00143|         "actionlint must run as the digest-pinned Docker image -- the image \
   00144|          bundles ShellCheck, and a bare binary without ShellCheck on PATH skips \
   00145|          every `run:` block check and still exits 0 (issues #1076, #1079)"
   00146|     );
   00147|     assert!(
   00148|         workflow.contains("rhysd/actionlint:<tag>"),
   00149|         "workflows.yml must keep the command that re-resolves the digest, or \
   00150|          the next bump has no way to check what the hash points at (issue #1079)"
   00151|     );
   00152|     assert!(config.contains("rhysd/actionlint/issues/657"));
   00153|     assert!(config.contains("unexpected key \"queue\" for \"concurrency\" section"));
   00154| 
   00155|     // A pattern matching everything is indistinguishable from not running the
   00156|     // linter at all, whichever form it takes.
   00157|     for blanket in ["- '.*'", "- \".*\"", "-ignore '.*'"] {
   00158|         assert!(
   00159|             !config.contains(blanket) && !workflow.contains(blanket),
   00160|             "actionlint suppressions must stay specific, found {blanket:?}"
   00161|         );
   00162|     }
   00163| }
