   00562| /// The answer to `Run <command>` once the command ran with no output.
   00563| fn quiet_run(command: &str) -> Option<String> {
   00564|     let mut messages = vec![ChatMessage::user(format!("Run {command}"))];
   00565|     let Some(AgenticPlan::ToolCalls(calls)) = plan_chat_step(&messages, &TOOLS) else {
   00566|         panic!("{command} is planned");
   00567|     };
   00568|     let arguments: serde_json::Value =
   00569|         serde_json::from_str(&calls[0].arguments).expect("tool arguments are JSON");
   00570|     assert_eq!(arguments["command"], command);
   00571|     messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00572|         "c0",
   00573|         "bash",
   00574|         calls[0].arguments.clone(),
   00575|     )]));
   00576|     messages.push(ChatMessage::tool_result("c0", "bash", ""));
   00577|     match plan_chat_step(&messages, &TOOLS) {
   00578|         Some(AgenticPlan::Final(answer)) => Some(answer),
   00579|         _ => None,
   00580|     }
   00581| }
