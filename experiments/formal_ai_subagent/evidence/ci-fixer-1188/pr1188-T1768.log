   00315|     for (path, text) in formal_ai::seed::seed_files() {
   00316|         if path == "data/seed/languages.lino" {
   00317|             continue;
   00318|         }
   00319|         for (index, line) in text.lines().enumerate() {
   00320|             let trimmed = line.trim();
   00321|             let Some(value) = ["text ", "phrase ", "cue ", "followup_request "]
   00322|                 .iter()
   00323|                 .find_map(|key| trimmed.strip_prefix(key))
   00324|                 .and_then(|value| value.strip_prefix('"')?.strip_suffix('"'))
   00325|             else {
