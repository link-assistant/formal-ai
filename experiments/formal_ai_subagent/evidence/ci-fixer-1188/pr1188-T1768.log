   00001| //! PR #1188 TEACH-F: the open gaps of `experiments/formal_ai_subagent/gaps.md`
   00002| //! taught to Formal AI (ledger rows T210-T229, T290-T299, T360-T369). Twin of
   00003| //! `rust/tests/web/pull-request-1188-teach-f.test.mjs`.
   00004| 
   00005| use std::collections::BTreeMap;
   00006| 
   00007| use formal_ai::agentic_coding::{AgenticPlan, plan_chat_step};
   00008| use formal_ai::normal_markov::{quote_fault, quoted_segment_spans};
   00009| use formal_ai::protocol::{ChatMessage, ToolCall};
   00010| use formal_ai::source_fetch::sha256_hex;
