   00012| const TOOLS: [&str; 7] = ["bash", "edit", "glob", "grep", "list", "read", "write"];
   00013| 
   00014| /// One driven session: the workspace afterwards, the bash commands and tools
   00015| /// it ran, and its final answer.
   00016| pub struct Run {
   00017|     pub(crate) files: BTreeMap<String, String>,
   00018|     pub(crate) tools: Vec<String>,
   00019|     pub(crate) commands: Vec<String>,
   00020|     pub(crate) answer: Option<String>,
   00021| }
   00022| 
   00023| fn path_of(arguments: &serde_json::Value) -> String {
   00024|     ["filePath", "file_path", "path"]
   00025|         .iter()
   00026|         .find_map(|key| arguments[key].as_str())
   00027|         .unwrap_or_default()
   00028|         .to_owned()
   00029| }
   00030| 
   00031| /// The Agent CLI's tools over an in-memory workspace; bash knows
   00032| /// `sha256sum --`, `cat` and a passing `node --test`.
   00033| fn execute(
   00034|     files: &mut BTreeMap<String, String>,
   00035|     tool: &str,
   00036|     arguments: &serde_json::Value,
   00037| ) -> String {
   00038|     match tool {
   00039|         "read" => files
   00040|             .get(&path_of(arguments))
   00041|             .cloned()
   00042|             .unwrap_or_else(|| format!("Error: File not found: {}", path_of(arguments))),
   00043|         "write" => {
   00044|             let content = arguments["content"].as_str().unwrap_or_default().to_owned();
   00045|             files.insert(path_of(arguments), content);
   00046|             String::new()
   00047|         }
   00048|         "edit" => {
   00049|             let path = path_of(arguments);
   00050|             let text = files.get(&path).cloned().unwrap_or_default();
   00051|             let old = arguments["oldString"].as_str().unwrap_or_default();
   00052|             let new = arguments["newString"].as_str().unwrap_or_default();
   00053|             if text.matches(old).count() != 1 {
   00054|                 return "Error: oldString not found in content".to_owned();
   00055|             }
   00056|             files.insert(path, text.replacen(old, new, 1));
   00057|             String::new()
   00058|         }
   00059|         "bash" => {
   00060|             let command = arguments["command"].as_str().unwrap_or_default();
   00061|             if command.starts_with("mkdir -p -- .formal-ai && (lock=") {
   00062|                 let directory = tempfile::tempdir().expect("append workspace");
   00063|                 std::fs::create_dir(directory.path().join(".formal-ai")).expect("event directory");
   00064|                 let event_path = ".formal-ai/general-change-plan.lino";
   00065|                 if let Some(before) = files.get(event_path) {
   00066|                     std::fs::write(directory.path().join(event_path), before)
   00067|                         .expect("earlier stream");
   00068|                 }
   00069|                 let output = std::process::Command::new("sh")
   00070|                     .args(["-c", command])
   00071|                     .current_dir(directory.path())
   00072|                     .output()
   00073|                     .expect("real shell append");
   00074|                 let stream = std::fs::read_to_string(directory.path().join(event_path))
   00075|                     .expect("appended stream");
   00076|                 files.insert(event_path.to_owned(), stream);
   00077|                 return format!(
   00078|                     "Output: {}\nError: {}\nExit Code: {}",
   00079|                     String::from_utf8_lossy(&output.stdout),
   00080|                     String::from_utf8_lossy(&output.stderr),
   00081|                     output.status.code().unwrap_or(-1)
   00082|                 );
   00083|             }
   00084|             if let Some(path) = command.strip_prefix("sha256sum -- ") {
   00085|                 let text = files.get(path).cloned().unwrap_or_default();
   00086|                 return format!("{}  {path}\n", sha256_hex(text.as_bytes()));
   00087|             }
   00088|             // The file operations a copy recipe runs (G82).
   00089|             if let Some(path) = command.strip_prefix("test -e ") {
   00090|                 return if files.contains_key(path) {
   00091|                     String::new()
   00092|                 } else {
   00093|                     "Output: \nError: \nExit Code: 1".to_owned()
   00094|                 };
   00095|             }
   00096|             if let Some(path) = command.strip_prefix("test ! -e ") {
   00097|                 return if files.contains_key(path) {
   00098|                     "Output: \nError: \nExit Code: 1".to_owned()
   00099|                 } else {
   00100|                     String::new()
   00101|                 };
   00102|             }
   00103|             if command == "mkdir -p -- ." {
   00104|                 return String::new();
   00105|             }
   00106|             if let Some((from, to)) = command
   00107|                 .strip_prefix("cp ")
   00108|                 .and_then(|rest| rest.split_once(' '))
   00109|             {
   00110|                 let text = files.get(from).cloned().unwrap_or_default();
   00111|                 files.insert(to.to_owned(), text);
   00112|                 return String::new();
   00113|             }
   00114|             // A replace of every occurrence of a plain word (G84).
   00115|             if let Some((old, new, path)) = perl_replace(command) {
   00116|                 let text = files.get(path).cloned().unwrap_or_default();
   00117|                 files.insert(path.to_owned(), text.replace(old, new));
   00118|                 return String::new();
   00119|             }
   00120|             // A suite slower than the driver's timeout comes back killed (G77).
   00121|             if command == "node --test slow.test.mjs" {
   00122|                 return "Output: TAP version 13\nError: \nSignal: SIGTERM\nTimeout: 60000 ms"
   00123|                     .to_owned();
   00124|             }
   00125|             if command.starts_with("node --test ") {
   00126|                 return "# tests 1\n# pass 1\n# fail 0\n".to_owned();
   00127|             }
   00128|             command.strip_prefix("cat ").map_or_else(
   00129|                 || format!("Error: {command} is not simulated"),
   00130|                 |path| files.get(path).cloned().unwrap_or_default(),
   00131|             )
   00132|         }
   00133|         _ => format!("Error: {tool} is not simulated"),
   00134|     }
   00135| }
   00136| 
   00137| /// The old word, new word and path of `perl -pi -e 's/OLD/NEW/g' -- PATH`.
   00138| fn perl_replace(command: &str) -> Option<(&str, &str, &str)> {
   00139|     let (expression, path) = command
   00140|         .strip_prefix("perl -pi -e 's/")?
   00141|         .split_once("/g' -- ")?;
   00142|     let (old, new) = expression.split_once('/')?;
   00143|     let word = |text: &str| !text.is_empty() && text.chars().all(char::is_alphanumeric);
   00144|     (word(old) && word(new)).then_some((old, new, path))
   00145| }
