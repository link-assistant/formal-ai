   00252| /// The `contraction` / `expansion` pairs `data/seed/languages.lino` seeds.
   00253| fn seeded_contractions() -> Vec<(String, String)> {
   00254|     let languages = formal_ai::seed::seed_files()
   00255|         .into_iter()
   00256|         .find(|(path, _)| *path == "data/seed/languages.lino")
   00257|         .map(|(_, text)| text)
   00258|         .expect("languages.lino is seeded");
   00259|     let mut pairs = Vec::new();
   00260|     let mut contracted = None;
   00261|     for line in languages.lines() {
   00262|         let Some((key, value)) = line.trim().split_once(' ') else {
   00263|             continue;
   00264|         };
   00265|         let value = value.trim_matches('"').to_owned();
   00266|         match key {
   00267|             "contraction" => contracted = Some(value),
   00268|             "expansion" => {
   00269|                 if let Some(pair) = contracted.take() {
   00270|                     pairs.push((pair, value));
   00271|                 }
   00272|             }
   00273|             _ => {}
   00274|         }
   00275|     }
   00276|     pairs
   00277| }
