   00147| pub fn drive(prompt: &str, workspace: &[(&str, &str)]) -> Run {
   00148|     let mut run = Run {
   00149|         files: workspace
   00150|             .iter()
   00151|             .map(|(path, text)| ((*path).to_owned(), (*text).to_owned()))
   00152|             .collect(),
   00153|         tools: Vec::new(),
   00154|         commands: Vec::new(),
   00155|         answer: None,
   00156|     };
   00157|     let mut messages = vec![ChatMessage::user(prompt)];
   00158|     for index in 0..16 {
   00159|         let calls = match plan_chat_step(&messages, &TOOLS) {
   00160|             Some(AgenticPlan::ToolCalls(calls)) => calls,
   00161|             Some(AgenticPlan::Final(text)) => {
   00162|                 run.answer = Some(text);
   00163|                 break;
   00164|             }
   00165|             None => break,
   00166|         };
   00167|         let call = calls[0].clone();
   00168|         let arguments: serde_json::Value =
   00169|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00170|         if call.tool == "bash" {
   00171|             run.commands
   00172|                 .push(arguments["command"].as_str().unwrap_or_default().to_owned());
   00173|         }
   00174|         run.tools.push(call.tool.clone());
   00175|         let result = execute(&mut run.files, &call.tool, &arguments);
   00176|         let id = format!("call_{index}");
   00177|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00178|             id.clone(),
   00179|             call.tool.clone(),
   00180|             call.arguments.clone(),
   00181|         )]));
   00182|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00183|     }
   00184|     run
   00185| }
