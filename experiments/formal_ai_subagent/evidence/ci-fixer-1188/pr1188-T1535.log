   00067|     if TUI_ISOLATION_TEST.contains(".args([\"-qfec\"")
   00068|         || WITH_FORMAL_AI_TEST.contains(".args([\"-qfec\"")
   00069|         || !PTY_HELPER.contains("ScriptDialect::Bsd")
   00070|         || !PTY_HELPER.contains("command.args([\"-q\", \"/dev/null\", program])")
   00071|     {
   00072|         failures.push("PTY tests must select BSD script syntax on macOS");
   00073|     }
   00074|     if !seed_array_guard_precedes_expansion() {
   00075|         failures.push("the empty destination array must be guarded before expansion");
   00076|     }
   00077|     if !supported_macos_test_shards_are_complete() {
   00078|         failures.push("the test matrix must include every supported macOS core slice");
   00079|     }
   00080| 
   00081|     failures
   00082| }
