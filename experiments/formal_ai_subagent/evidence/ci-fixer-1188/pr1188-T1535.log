   00117| #[test]
   00118| fn full_test_matrix_runs_on_a_supported_macos_image() {
   00119|     assert!(supported_macos_test_shards_are_complete());
   00120|     // Issue #961 needed 25 minutes for the archive build and froze that literal;
   00121|     // issue #1017 raised it to 30 so the 1200s step budget expires before the
   00122|     // job cap rather than after it. The floor is the contract -- the archive
   00123|     // build must still be allowed at least the 25 minutes it was measured to
   00124|     // need -- so assert the floor instead of an exact value that a later
   00125|     // headroom increase would break again.
   00126|     let longest_cap = MACOS_CORE_WORKFLOW
   00127|         .split("timeout-minutes: ")
   00128|         .skip(1)
   00129|         .filter_map(|rest| rest.split('\n').next()?.trim().parse::<u64>().ok())
   00130|         .max()
   00131|         .expect("the macOS core workflow must declare job timeouts");
   00132|     assert!(
   00133|         longest_cap >= 25,
   00134|         "the archive build needs at least 25 minutes (issue #961); found {longest_cap}"
   00135|     );
   00136|     // Issue #1055: a floor, for the reason the comment above gives -- pinning
   00137|     // the exact number is what broke this when the budget grew from 1200s to
   00138|     // 1400s to absorb a cold rebuild after a profile change.
   00139|     let archive_budget = MACOS_CORE_WORKFLOW
   00140|         .split("TEST_BUDGET_SECONDS: ")
   00141|         .skip(1)
   00142|         .filter_map(|rest| rest.split('\n').next()?.trim().parse::<u64>().ok())
   00143|         .max()
   00144|         .expect("the macOS core workflow must budget its archive build");
   00145|     assert!(
   00146|         archive_budget >= 1200,
   00147|         "the archive build needs at least 1200s (issue #961); found {archive_budget}"
   00148|     );
   00149|     assert!(MACOS_CORE_WORKFLOW.contains("taiki-e/install-action@nextest"));
   00150|     // Plan 16 L1 moved the manifest to rust/Cargo.toml, which sits between
   00151|     // `nextest` and its `archive` subcommand; count the subcommand token on
   00152|     // cargo-nextest lines instead of the three-word literal, so the contract
   00153|     // (the archive is built exactly once) survives flag insertions.
   00154|     let archive_builds = MACOS_CORE_WORKFLOW
   00155|         .lines()
   00156|         .filter(|line| line.contains("cargo nextest"))
   00157|         .filter(|line| line.split_whitespace().any(|token| token == "archive"))
   00158|         .count();
   00159|     assert_eq!(archive_builds, 1);
   00160| }
