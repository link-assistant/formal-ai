   00025| /// The denominator the slice step actually passes to `cargo nextest
   00026| /// --partition`. Issue #961 froze it at twelve; issue #1017 raised it to
   00027| /// sixteen because the round-robin partitioner balances by test index and never
   00028| /// by duration. Reading it from the step instead of repeating a literal keeps
   00029| /// #961's contract -- every supported shard runs -- true at any slice count,
   00030| /// and still catches the failure it was written for: a matrix that disagrees
   00031| /// with the denominator silently drops those tests while CI stays green.
   00032| /// Issue #1059 removed the slice denominator: macOS runs the modules named in
   00033| /// `data/meta/macos-platform-tests.lino` on one runner rather than a shard of
   00034| /// the whole suite. The failure this guarded -- a selection that silently drops
   00035| /// tests while CI stays green -- now takes the shape of an empty module list.
   00036| fn macos_platform_modules() -> usize {
   00037|     std::fs::read_to_string(concat!(
   00038|         env!("CARGO_MANIFEST_DIR"),
   00039|         "/../data/meta/macos-platform-tests.lino"
   00040|     ))
   00041|     .expect("read the macOS platform test list")
   00042|     .lines()
   00043|     .filter(|line| line.trim().starts_with("module "))
   00044|     .count()
   00045| }
   00046| 
   00047| fn supported_macos_test_shards_are_complete() -> bool {
   00048|     RELEASE_WORKFLOW.matches("os: macos-15-intel").count() == 1
   00049|         && RELEASE_WORKFLOW.contains("uses: ./.github/workflows/macos-core-tests.yml")
   00050|         && MACOS_CORE_WORKFLOW.matches("- { partition:").count() == 1
   00051|         && macos_platform_modules() >= 5
   00052|         && MACOS_CORE_WORKFLOW.contains("platform.filter")
   00053|         && RELEASE_WORKFLOW.contains("test-suite: specification")
   00054| }
