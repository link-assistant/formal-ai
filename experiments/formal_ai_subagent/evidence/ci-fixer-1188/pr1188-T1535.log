   00019| fn seed_array_guard_precedes_expansion() -> bool {
   00020|     let guard = SYNC_SEED.find("if [[ ${#dests[@]} -gt 0 ]]");
   00021|     let expansion = SYNC_SEED.find("for dst in \"${dests[@]}\"");
   00022|     matches!((guard, expansion), (Some(guard), Some(expansion)) if guard < expansion)
   00023| }
