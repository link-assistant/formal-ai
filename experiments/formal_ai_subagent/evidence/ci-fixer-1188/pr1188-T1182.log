   00405| fn identifier_tokens(text: &str) -> impl Iterator<Item = &str> {
   00406|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00407|         .filter(|token| !token.is_empty())
   00408| }
