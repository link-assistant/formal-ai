   00276| /// A placeholder the seed sentence wraps in backticks becomes a `CommonMark`
   00277| /// code span: a value holding a backtick run gets a longer fence, padded when
   00278| /// it starts or ends with a backtick, so the inserted text reads back verbatim.
   00279| fn code_span_item(value: &str) -> String {
   00280|     let longest = value
   00281|         .split(|character| character != '`')
   00282|         .map(str::len)
   00283|         .max()
   00284|         .unwrap_or(0);
   00285|     if longest == 0 {
   00286|         return format!("`{value}`");
   00287|     }
   00288|     let fence = "`".repeat(longest + 1);
   00289|     let pad = if value.starts_with('`') || value.ends_with('`') {
   00290|         " "
   00291|     } else {
   00292|         ""
   00293|     };
   00294|     format!("{fence}{pad}{value}{pad}{fence}")
   00295| }
   00296| 
   00297| fn code_span(value: &str) -> String {
   00298|     code_span_item(value)
   00299| }
