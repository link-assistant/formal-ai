   00372| fn slot_identifier(normalized: &str, role: &str) -> Option<String> {
   00373|     seed::lexicon()
   00374|         .role_word_forms(role)
   00375|         .into_iter()
   00376|         .find_map(|form| match form.slot() {
   00377|             Slot::Prefix => {
   00378|                 let prefix = form.before_slot().trim().to_lowercase();
   00379|                 let start = normalized.find(&prefix)?.checked_add(prefix.len())?;
   00380|                 identifier_tokens(normalized.get(start..)?)
   00381|                     .next()
   00382|                     .map(str::to_owned)
   00383|             }
   00384|             Slot::Suffix => {
   00385|                 let suffix = form.after_slot().trim().to_lowercase();
   00386|                 let end = normalized.find(&suffix)?;
   00387|                 identifier_tokens(normalized.get(..end)?)
   00388|                     .last()
   00389|                     .map(str::to_owned)
   00390|             }
   00391|             Slot::Circumfix => {
   00392|                 let before = form.before_slot().trim().to_lowercase();
   00393|                 let after = form.after_slot().trim().to_lowercase();
   00394|                 let start = normalized.find(&before)?.checked_add(before.len())?;
   00395|                 let remainder = normalized.get(start..)?;
   00396|                 let end = remainder.find(&after)?;
   00397|                 identifier_tokens(remainder.get(..end)?)
   00398|                     .next()
   00399|                     .map(str::to_owned)
   00400|             }
   00401|             Slot::Bare => None,
   00402|         })
   00403| }
