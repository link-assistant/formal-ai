   00410| fn valid_identifier(identifier: &str) -> bool {
   00411|     let mut characters = identifier.chars();
   00412|     let Some(first) = characters.next() else {
   00413|         return false;
   00414|     };
   00415|     (first.is_ascii_alphabetic() || first == '_')
   00416|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00417|         && !seed::lexicon()
   00418|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00419|             .iter()
   00420|             .any(|reserved| reserved == identifier)
   00421| }
