   00423| fn numeric_literals(text: &str) -> Vec<String> {
   00424|     let chars = text.char_indices().collect::<Vec<_>>();
   00425|     let mut values = Vec::new();
   00426|     let mut index = 0;
   00427|     while index < chars.len() {
   00428|         let (start, character) = chars[index];
   00429|         if !character.is_ascii_digit()
   00430|             || index
   00431|                 .checked_sub(1)
   00432|                 .is_some_and(|prior| chars[prior].1.is_ascii_alphabetic())
   00433|         {
   00434|             index += 1;
   00435|             continue;
   00436|         }
   00437|         let mut end_index = index + 1;
   00438|         while end_index < chars.len()
   00439|             && (chars[end_index].1.is_ascii_digit() || chars[end_index].1 == '.')
   00440|         {
   00441|             end_index += 1;
   00442|         }
   00443|         if end_index < chars.len() && chars[end_index].1.is_ascii_alphabetic() {
   00444|             index = end_index + 1;
   00445|             continue;
   00446|         }
   00447|         let end = chars
   00448|             .get(end_index)
   00449|             .map_or(text.len(), |(offset, _)| *offset);
   00450|         let value = text[start..end].trim_end_matches('.');
   00451|         if !value.is_empty() {
   00452|             values.push(value.to_owned());
   00453|         }
   00454|         index = end_index;
   00455|     }
   00456|     values
   00457| }
