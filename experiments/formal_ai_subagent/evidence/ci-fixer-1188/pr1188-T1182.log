   00317|             rendered.push_str(value);
   00318|             template = &template[length..];
   00319|         } else {
   00320|             let character = template.chars().next().expect("nonempty template");
   00321|             rendered.push(character);
   00322|             template = &template[character.len_utf8()..];
   00323|         }
   00324|     }
   00325|     rendered
   00326| }
