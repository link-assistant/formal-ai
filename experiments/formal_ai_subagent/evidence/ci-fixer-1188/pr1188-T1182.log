   00328| fn rust_path(task: &str) -> Option<String> {
   00329|     let end = task.find(".rs")?.checked_add(3)?;
   00330|     let start = task[..end]
   00331|         .char_indices()
   00332|         .rev()
   00333|         .take_while(|(_, character)| is_path_character(*character))
   00334|         .last()
   00335|         .map_or(0, |(index, _)| index);
   00336|     let path = task.get(start..end)?;
   00337|     (!path.is_empty()
   00338|         && !path.starts_with('/')
   00339|         && !path.split('/').any(|component| component == ".."))
   00340|     .then(|| path.to_owned())
   00341| }
   00342| 
   00343| const fn is_path_character(character: char) -> bool {
   00344|     character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00345| }
