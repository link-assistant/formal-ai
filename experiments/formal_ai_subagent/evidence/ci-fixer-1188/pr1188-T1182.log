   00307| /// Substitute only seed-owned slots; inserted literal values are never templates.
   00308| fn render_template_values(mut template: &str, values: &[(&str, String, String)]) -> String {
   00309|     let mut rendered = String::new();
   00310|     while !template.is_empty() {
   00311|         let found = values.iter().find_map(|(slot, plain, quoted)| {
   00312|             let fenced = format!("`{slot}`");
   00313|             if template.starts_with(&fenced) { return Some((fenced.len(), quoted.as_str())); }
   00314|             template.starts_with(slot).then_some((slot.len(), plain.as_str()))
   00315|         });
