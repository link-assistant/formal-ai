   00347| fn requested_identifier(task: &str, path: &str, kind: RustItemKind) -> Option<String> {
   00348|     let normalized = task.to_lowercase();
   00349|     if kind != RustItemKind::Constant
   00350|         && let Some(name) = slot_identifier(&normalized, seed::ROLE_CODING_NAME_SLOT)
   00351|         && valid_identifier(&name)
   00352|     {
   00353|         return Some(name);
   00354|     }
   00355|     let without_path = task.replacen(path, "", 1);
   00356|     let mut candidates = identifier_tokens(&without_path)
   00357|         .filter(|candidate| valid_identifier(candidate))
   00358|         .collect::<Vec<_>>();
   00359|     if kind == RustItemKind::Constant {
   00360|         candidates.retain(|candidate| {
   00361|             candidate.chars().any(|character| character == '_')
   00362|                 && candidate
   00363|                     .chars()
   00364|                     .all(|character| character.is_ascii_uppercase() || character == '_')
   00365|         });
   00366|     } else {
   00367|         candidates.retain(|candidate| candidate.contains('_'));
   00368|     }
   00369|     candidates.into_iter().next().map(str::to_owned)
   00370| }
