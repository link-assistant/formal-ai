   00177| /// The summary envelope over `turns` in `language`, with the chat title.
   00178| ///
   00179| /// The envelope holds the summary, the title and the numbered user turns,
   00180| /// trimmed at the end. Mirrored by `conversationSummaryEnvelope` in
   00181| /// `js/agentic/crate/conversation_summary.mjs`.
   00182| fn conversation_summary_envelope(turns: &[DialogTurn], language: &str) -> (String, String) {
   00183|     // Standard mode keeps roughly 50% of the highest-weighted statements; with
   00184|     // the dialog bias (user +20, assistant -10) the user's questions dominate
   00185|     // the output while still keeping room for any assistant prose worth
   00186|     // remembering.
   00187|     let config = SummarizationConfig::default()
   00188|         .with_mode(SummarizationMode::Standard)
   00189|         .with_language(language);
   00190|     let summary = summarize_dialog(turns, &config);
   00191|     let title = generate_chat_title(turns, language);
   00192|     let user_turns: Vec<&str> = turns
   00193|         .iter()
   00194|         .filter(|turn| turn.role == "user")
   00195|         .map(|turn| turn.text.as_str())
   00196|         .collect();
   00197|     let mut body = match language {
   00198|         "ru" => {
   00199|             format!("Резюме разговора: {summary}\n\nЗаголовок: {title}\n\nРеплики пользователя:\n")
   00200|         }
   00201|         "zh" => format!("对话摘要:{summary}\n\n标题:{title}\n\n用户发言:\n"),
   00202|         _ => format!("Conversation summary: {summary}\n\nTitle: {title}\n\nUser turns:\n"),
   00203|     };
   00204|     for (index, turn) in user_turns.iter().enumerate() {
   00205|         writeln!(body, "  {}. {turn}", index + 1).expect("string write is infallible");
   00206|     }
   00207|     (body.trim_end().to_owned(), title)
   00208| }
