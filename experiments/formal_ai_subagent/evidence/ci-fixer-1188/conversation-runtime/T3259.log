   00017| /// Recognise a request to summarize the running conversation by composing
   00018| /// meaning roles rather than matching raw per-language phrases (issue #386).
   00019| ///
   00020| /// The universal algorithm is identical for every language: the prompt either
   00021| /// (a) carries a complete standalone conversation-summary phrasing, (b) carries
   00022| /// an objectless courtesy frame asking for a summary, (c) names a summary
   00023| /// directive *together with* a conversation reference, or (d) leads with a bare
   00024| /// summary directive (`summarize`, `резюме`, `总结`, …). The prompt is
   00025| /// re-normalised first so the boundary-aware matcher sees punctuation collapsed
   00026| /// to spaces. Mirror of `asksForConversationSummary` in the browser worker.
   00027| fn asks_for_conversation_summary(normalized: &str) -> bool {
   00028|     let cleaned = normalize_prompt(normalized);
   00029|     let lexicon = seed::lexicon();
   00030|     lexicon.mentions_role(seed::ROLE_CONVERSATION_RETURN_RECAP, &cleaned)
   00031|         || lexicon.mentions_role(seed::ROLE_CONVERSATION_SUMMARY_PHRASE, &cleaned)
   00032|         || (lexicon.mentions_role(seed::ROLE_CONVERSATION_SUMMARY_COURTESY, &cleaned)
   00033|             && courtesy_frame_leaves_no_object(&cleaned))
   00034|         || (lexicon.mentions_role(seed::ROLE_CONVERSATION_SUMMARY_DIRECTIVE, &cleaned)
   00035|             && lexicon.mentions_role(seed::ROLE_CONVERSATION_REFERENCE, &cleaned))
   00036|         || summary_directive_leads(&cleaned)
   00037| }
   00038| 
   00039| /// The courtesy frames are frames, not owners: "can you summarize" opens a
   00040| /// request whose object, when one follows, belongs to whichever handler
   00041| /// summarizes that object (the topic summarizer sits below this one in the
   00042| /// dispatch order, so this guard is where the handoff happens — the dispatch
   00043| /// comment for `conversation_memory` and `conversation_summary_directive`'s
   00044| /// role contract both leave a "summarize X" to other handlers). Stripping
   00045| /// every courtesy and directive surface from the prompt must leave nothing:
   00046| /// "can you summarize" alone summarizes the running conversation, while
   00047| /// "can you summarize Rust" names a topic. Longest surfaces strip first so a
   00048| /// frame that prefixes another ("подведи итог" inside "подведи итоги") does
   00049| /// not leave orphan letters behind.
   00050| fn courtesy_frame_leaves_no_object(cleaned: &str) -> bool {
   00051|     let lexicon = seed::lexicon();
   00052|     let mut surfaces: Vec<String> = lexicon
   00053|         .words_for_role(seed::ROLE_CONVERSATION_SUMMARY_COURTESY)
   00054|         .into_iter()
   00055|         .chain(lexicon.words_for_role(seed::ROLE_CONVERSATION_SUMMARY_DIRECTIVE))
   00056|         .filter(|surface| !surface.is_empty())
   00057|         .collect();
   00058|     surfaces.sort_by_key(|surface| std::cmp::Reverse(surface.chars().count()));
   00059|     let mut remainder = cleaned.to_owned();
   00060|     for surface in &surfaces {
   00061|         remainder = remainder.replace(surface.as_str(), " ");
   00062|     }
   00063|     remainder
   00064|         .chars()
   00065|         .all(|c| c.is_whitespace() || c.is_ascii_punctuation())
   00066| }
   00067| 
   00068| /// A bare summary directive standing alone is itself a request to summarize the
   00069| /// running conversation ("summarize", "резюме", "总结", …).
   00070| ///
   00071| /// For whitespace-delimited scripts the directive must be the *whole* prompt, so
   00072| /// "summarize the article" is left for other handlers (a conversation object is
   00073| /// required via the directive∧reference arm instead). For CJK (no word spaces) a
   00074| /// leading substring suffices — mirroring the worker's historical `^总结` anchor
   00075| /// — which also keeps compounds like "工作总结" (a *work* summary) from being
   00076| /// mis-claimed. Surface words come from the `conversation_summary_directive`
   00077| /// role in the seed lexicon.
   00078| fn summary_directive_leads(cleaned: &str) -> bool {
   00079|     seed::lexicon()
   00080|         .words_for_role(seed::ROLE_CONVERSATION_SUMMARY_DIRECTIVE)
   00081|         .iter()
   00082|         .any(|word| {
   00083|             if contains_cjk(word) {
   00084|                 cleaned.starts_with(word.as_str())
   00085|             } else {
   00086|                 cleaned == word.as_str()
   00087|             }
   00088|         })
   00089| }
