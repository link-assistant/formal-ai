   00091| pub(super) fn try_summarize_conversation(
   00092|     prompt: &str,
   00093|     normalized: &str,
   00094|     log: &mut EventLog,
   00095| ) -> Option<SymbolicAnswer> {
   00096|     let is_return_recap = seed::lexicon().mentions_role(
   00097|         seed::ROLE_CONVERSATION_RETURN_RECAP,
   00098|         &normalize_prompt(normalized),
   00099|     );
   00100|     if !is_return_recap && !asks_for_conversation_summary(normalized) {
   00101|         return None;
   00102|     }
   00103|     let mut turns: Vec<DialogTurn> = log
   00104|         .events()
   00105|         .iter()
   00106|         .filter_map(|event| match event.kind {
   00107|             "prior_turn:user" => Some(DialogTurn::user(event.payload.clone())),
   00108|             "prior_turn:assistant" => Some(DialogTurn::assistant(event.payload.clone())),
   00109|             _ => None,
   00110|         })
   00111|         .collect();
   00112|     if turns.is_empty()
   00113|         && let Some(content) = prompt
   00114|             .split_once(':')
   00115|             .map(|(_, content)| content.trim())
   00116|             .filter(|content| !content.is_empty())
   00117|     {
   00118|         turns.push(DialogTurn::user(content));
   00119|     }
   00120|     // A summarize request over a conversation that has not started yet is
   00121|     // still owned here: the request itself is the only turn so far, and an
   00122|     // honest one-turn summary beats falling through ownerless -- the open-web
   00123|     // decision table answered the bare phrase with a literal web search and a
   00124|     // hallucinated fetch loop (agentic CLI matrix, summarize leg).
   00125|     if turns.is_empty() && !prompt.trim().is_empty() {
   00126|         log.append(
   00127|             "conversation_recall:refusal",
   00128|             "conversation not started".to_owned(),
   00129|         );
   00130|         turns.push(DialogTurn::user(prompt.trim().to_owned()));
   00131|     }
   00132|     let user_turn_count = turns.iter().filter(|turn| turn.role == "user").count();
   00133|     if user_turn_count == 0 {
   00134|         return None;
   00135|     }
   00136|     if is_return_recap {
   00137|         let summary =
   00138|             summarize_dialog_plain(&turns, RETURN_RECAP_MAX_WORDS, RETURN_RECAP_MAX_SENTENCES);
   00139|         if summary.is_empty() {
   00140|             return None;
   00141|         }
   00142|         log.append("filter:user", "conversation_return_recap".to_owned());
   00143|         log.append("summarization:format", "plain".to_owned());
   00144|         log.append(
   00145|             "summarization:max_words",
   00146|             RETURN_RECAP_MAX_WORDS.to_string(),
   00147|         );
   00148|         log.append(
   00149|             "summarization:max_sentences",
   00150|             RETURN_RECAP_MAX_SENTENCES.to_string(),
   00151|         );
   00152|         return Some(finalize_simple(
   00153|             prompt,
   00154|             log,
   00155|             "summarize_conversation",
   00156|             "response:summarize_conversation",
   00157|             &summary,
   00158|             0.9,
   00159|         ));
   00160|     }
   00161|     let language = detect_language(prompt).slug();
   00162|     let (body, title) = conversation_summary_envelope(&turns, language);
   00163|     log.append("filter:user", "conversation_summary".to_owned());
   00164|     log.append("summarization:mode", "standard".to_owned());
   00165|     log.append("summarization:language", language.to_owned());
   00166|     log.append("chat_title", title);
   00167|     Some(finalize_simple(
   00168|         prompt,
   00169|         log,
   00170|         "summarize_conversation",
   00171|         "response:summarize_conversation",
   00172|         &body,
   00173|         0.9,
   00174|     ))
   00175| }
