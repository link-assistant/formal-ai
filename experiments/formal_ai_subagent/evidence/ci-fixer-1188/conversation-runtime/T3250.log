   00107| pub fn record_decomposition(
   00108|     log: &mut EventLog,
   00109|     prompt: &str,
   00110|     max_depth: u8,
   00111| ) -> Vec<DecomposedSubImpulse> {
   00112|     if max_depth == 0 {
   00113|         return Vec::new();
   00114|     }
   00115| 
   00116|     // Multiple explicit questions are independently actionable even when the
   00117|     // whole prompt happens to match the first one. Previously that whole-prompt
   00118|     // match (for example, `capabilities`) suppressed decomposition and silently
   00119|     // discarded every following question. Mixed sentences keep their existing
   00120|     // whole-prompt semantics: "Hello. Prove ..." is one proof request, and a
   00121|     // greeting followed by an identity question remains an identity request.
   00122|     let independent_parts = independent_actionable_segments(prompt);
   00123|     if independent_parts.len() > 1
   00124|         && independent_parts.iter().all(|part| {
   00125|             part.trim_end()
   00126|                 .chars()
   00127|                 .next_back()
   00128|                 .is_some_and(|ch| matches!(ch, '?' | '？'))
   00129|         })
   00130|     {
   00131|         return record_sub_impulses(log, independent_parts, true);
   00132|     }
   00133|     // A question asking the assistant's opinion is one utterance: the clause
   00134|     // after its lead ("Как ты думаешь, …") is what the opinion is about, not a
   00135|     // second request (the browser worker splits only at sentence ends).
   00136|     if crate::rule_interpreter::handler_matches("opinion_question", prompt) {
   00137|         return Vec::new();
   00138|     }
   00139| 
   00140|     if courtesy_context_for_single_directive(&independent_parts) {
   00141|         return Vec::new();
   00142|     }
   00143| 
   00144|     let language = detect_language(prompt);
   00145|     let whole_intent = formalize_intent(prompt, language.slug(), None);
   00146|     if (whole_intent.route.is_none() || whole_intent.kind == IntentKind::Courtesy)
   00147|         && independent_parts.len() > 1
   00148|     {
   00149|         return record_sub_impulses(log, independent_parts, true);
   00150|     }
   00151| 
   00152|     let lower = prompt.to_lowercase();
   00153|     let triggers = [" and ", " with tests", " with benchmarks", "; "];
   00154|     if !triggers.iter().any(|trigger| lower.contains(trigger)) {
   00155|         return Vec::new();
   00156|     }
   00157| 
   00158|     let parts: Vec<String> = prompt
   00159|         .split([',', ';'])
   00160|         .flat_map(|chunk| chunk.split(" and "))
   00161|         .flat_map(|chunk| chunk.split(" with "))
   00162|         .map(str::trim)
   00163|         .filter(|chunk| !chunk.is_empty())
   00164|         .map(str::to_owned)
   00165|         .collect();
   00166|     record_sub_impulses(log, parts, false)
   00167| }
