   00659| pub fn infer_program_languages_from_code(
   00660|     code: &str,
   00661|     normalized: &str,
   00662| ) -> Option<(&'static str, &'static str)> {
   00663|     let trimmed = code.trim();
   00664|     let source = if trimmed.contains("fn ") || trimmed.contains("let ") || trimmed.contains("-> ") {
   00665|         "rust"
   00666|     } else if trimmed.contains("def ") || trimmed.contains("print(") {
   00667|         "python"
   00668|     } else if trimmed.contains("function ") || trimmed.contains("console.log") {
   00669|         "javascript"
   00670|     } else {
   00671|         return None;
   00672|     };
   00673|     let langs = [
   00674|         "python",
   00675|         "rust",
   00676|         "javascript",
   00677|         "typescript",
   00678|         "go",
   00679|         "java",
   00680|         "c",
   00681|         "ruby",
   00682|     ];
   00683|     let target = langs
   00684|         .iter()
   00685|         .find(|lang| normalized.contains(&format!("to {lang}")))
   00686|         .copied()?;
