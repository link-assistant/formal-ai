   00399| /// Walk the event log for a user-introduced name. Looks in the current
   00400| /// prompt first, then in each `prior_turn:user` event so name recall works
   00401| /// across multi-turn conversations.
   00402| pub fn recall_name_from_history(log: &EventLog, prompt: &str) -> Option<String> {
   00403|     if let Some(name) = extract_introduced_name(prompt) {
   00404|         return Some(name);
   00405|     }
   00406|     for event in log.events() {
   00407|         if event.kind == "prior_turn:user" {
   00408|             if let Some(name) = extract_introduced_name(&event.payload) {
   00409|                 return Some(name);
   00410|             }
   00411|         }
   00412|     }
   00413|     None
   00414| }
