   00281| fn strip_leading_coordinator(text: &str) -> &str {
   00282|     let trimmed = text.trim_start();
   00283|     let lowered = trimmed.to_ascii_lowercase();
   00284|     for coordinator in ["and", "then"] {
   00285|         if lowered == coordinator {
   00286|             return "";
   00287|         }
   00288|         let prefix = format!("{coordinator} ");
   00289|         if lowered.starts_with(&prefix) {
   00290|             return trimmed[prefix.len()..].trim_start();
   00291|         }
   00292|     }
   00293|     trimmed
   00294| }
