   00609| /// Normalize a surface fragment into a deterministic, language-independent
   00610| /// key for hashing into a meaning id. The previous implementation looked
   00611| /// the surface up in a hand-curated registry; that is now removed (the
   00612| /// real meaning id comes from Wikidata via the translation pipeline). We
   00613| /// keep the normalization step so the legacy hash continues to be stable
   00614| /// across whitespace, casing, and punctuation differences.
   00615| pub fn normalize_meaning(surface: &str) -> String {
   00616|     let raw: String = surface
   00617|         .chars()
   00618|         .flat_map(char::to_lowercase)
   00619|         .filter(|c| c.is_alphanumeric())
   00620|         .collect();
   00621|     canonical_meaning_token(&raw)
   00622| }
