   00333| #[derive(Debug, Clone)]
   00334| pub struct ValidationChoice {
   00335|     pub answer: String,
   00336| }
   00337| 
   00338| pub fn record_validation(log: &mut EventLog, prompt: &str) -> Option<ValidationChoice> {
   00339|     let lower = prompt.to_lowercase();
   00340|     if lower.contains("prime") {
   00341|         if let Some((low, high)) = extract_range(&lower) {
   00342|             for candidate in low..=high {
   00343|                 if is_prime(candidate) {
   00344|                     let answer = format!("{candidate}");
   00345|                     log.append("validation", format!("prime_between_{low}_and_{high}"));
   00346|                     return Some(ValidationChoice { answer });
   00347|                 }
   00348|             }
   00349|         }
   00350|         log.append("validation", "no_prime_in_range".to_owned());
   00351|     }
   00352|     None
   00353| }
   00354| 
   00355| pub fn extract_range(lower: &str) -> Option<(u64, u64)> {
   00356|     let numbers: Vec<u64> = lower
   00357|         .split(|character: char| !character.is_ascii_digit())
   00358|         .filter_map(|token| token.parse::<u64>().ok())
   00359|         .collect();
   00360|     match numbers.as_slice() {
   00361|         [low, high] if low <= high => Some((*low, *high)),
   00362|         _ => None,
   00363|     }
   00364| }
   00365| 
   00366| pub const fn is_prime(value: u64) -> bool {
   00367|     if value < 2 {
   00368|         return false;
   00369|     }
   00370|     let mut divisor: u64 = 2;
   00371|     while divisor.saturating_mul(divisor) <= value {
   00372|         if value % divisor == 0 {
   00373|             return false;
   00374|         }
   00375|         divisor += 1;
   00376|     }
   00377|     true
   00378| }
