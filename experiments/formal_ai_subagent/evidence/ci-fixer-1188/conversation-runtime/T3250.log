   00597| fn is_binary_add_function(code: &str) -> bool {
   00598|     let compact = code
   00599|         .chars()
   00600|         .filter(|character| !character.is_whitespace())
   00601|         .flat_map(char::to_lowercase)
   00602|         .collect::<String>();
   00603|     let declares_add = compact.contains("defadd(")
   00604|         || compact.contains("fnadd(")
   00605|         || compact.contains("functionadd(");
   00606|     declares_add && compact.contains("a+b")
   00607| }
