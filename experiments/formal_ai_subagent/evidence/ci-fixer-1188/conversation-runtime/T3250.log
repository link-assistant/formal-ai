   00186| /// The substantive clause after an actually bound leading courtesy.
   00187| /// Keep the full original utterance in the log; this is only a parser view.
   00188| pub fn request_after_leading_courtesy(prompt: &str) -> Option<&str> {
   00189|     let (at, delimiter) = prompt.char_indices().find(|&(at, character)| {
   00190|         matches!(
   00191|             character,
   00192|             ',' | ';' | '；' | '，' | '、' | '\n' | '。' | '！' | '？'
   00193|         ) || (matches!(character, '.' | '!' | '?')
   00194|             && prompt[at + character.len_utf8()..]
   00195|                 .chars()
   00196|                 .next()
   00197|                 .is_some_and(char::is_whitespace))
   00198|     })?;
   00199|     let lead = prompt[..at].trim();
   00200|     let language = detect_language(lead);
   00201|     if formalize_intent(lead, language.slug(), None).kind != IntentKind::Courtesy {
   00202|         return None;
   00203|     }
   00204|     let tail = strip_leading_coordinator(prompt[at + delimiter.len_utf8()..].trim());
   00205|     (!tail.is_empty()).then_some(tail)
   00206| }
