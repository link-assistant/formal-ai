   00933| pub fn format_write_script_execution(program: ProgramSpec) -> String {
   00934|     let execution = &program.language.execution;
   00935|     let expected_output = program.expected_output();
   00936|     let cmd = execution.check_command.map_or_else(
   00937|         || format!("Run command: `{}`", execution.run_command),
   00938|         |check| {
   00939|             format!(
   00940|                 "Check command: `{check}`\nRun command: `{}`",
   00941|                 execution.run_command
   00942|             )
   00943|         },
   00944|     );
   00945|     let output_label = if matches!(execution.status, ExecutionStatus::Verified) {
   00946|         "Output"
   00947|     } else {
   00948|         "Expected output after verification"
   00949|     };
   00950|     format!(
   00951|         "Execution status: {} in {}.\n{}\n{}:\n```text\n{}\n```\n{}",
   00952|         execution.status.label(),
   00953|         execution.environment,
   00954|         cmd,
   00955|         output_label,
   00956|         expected_output,
   00957|         execution.notes
   00958|     )
   00959| }
