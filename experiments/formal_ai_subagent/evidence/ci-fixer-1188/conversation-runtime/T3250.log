   00208| // Courtesy is context for one directed operation, not an extra operation.
   00209| // Explicit question lists and procedure questions retain their composition.
   00210| fn courtesy_context_for_single_directive(parts: &[String]) -> bool {
   00211|     let mut courtesies = 0;
   00212|     let mut directives = 0;
   00213|     for part in parts {
   00214|         let language = detect_language(part);
   00215|         let binding = formalize_intent(part, language.slug(), None);
   00216|         if binding.kind == IntentKind::Courtesy {
   00217|             courtesies += 1;
   00218|         } else if binding.route.is_some() && binding.kind != IntentKind::Question {
   00219|             directives += 1;
   00220|         } else {
   00221|             return false;
   00222|         }
   00223|     }
   00224|     courtesies > 0 && directives == 1
   00225| }
