   00789| /// Render a percent-encoded URL in its readable IRI form (RFC 3987).
   00790| ///
   00791| /// Leaves reserved URI delimiters (`; / ? : @ & = + $ , #`) percent-encoded so
   00792| /// query strings and fragments still resolve. Returns the input unchanged when
   00793| /// the URL has no percent-escapes or when decoding would produce invalid
   00794| /// UTF-8.
   00795| ///
   00796| /// Mirrors the JavaScript `decodeURI` semantics used in
   00797| /// `js/worker/formal_ai_worker.js::humanizeUrl` so Wikipedia source links render
   00798| /// identically across every formal-ai surface (issue #21).
   00799| #[must_use]
   00800| pub fn humanize_url(url: &str) -> String {
   00801|     if !url.contains('%') {
   00802|         return url.to_owned();
   00803|     }
   00804|     let bytes = url.as_bytes();
   00805|     let mut out: Vec<u8> = Vec::with_capacity(bytes.len());
   00806|     let mut i = 0usize;
   00807|     while i < bytes.len() {
   00808|         if bytes[i] == b'%' && i + 2 < bytes.len() {
   00809|             if let (Some(hi), Some(lo)) = (hex_nibble(bytes[i + 1]), hex_nibble(bytes[i + 2])) {
   00810|                 let value = (hi << 4) | lo;
   00811|                 if is_reserved_uri_delimiter(value) {
   00812|                     out.extend_from_slice(&bytes[i..=i + 2]);
   00813|                 } else {
   00814|                     out.push(value);
   00815|                 }
   00816|                 i += 3;
   00817|                 continue;
   00818|             }
   00819|         }
   00820|         out.push(bytes[i]);
   00821|         i += 1;
   00822|     }
   00823|     String::from_utf8(out).unwrap_or_else(|_| url.to_owned())
   00824| }
   00825| 
   00826| const fn hex_nibble(byte: u8) -> Option<u8> {
   00827|     match byte {
   00828|         b'0'..=b'9' => Some(byte - b'0'),
   00829|         b'a'..=b'f' => Some(byte - b'a' + 10),
   00830|         b'A'..=b'F' => Some(byte - b'A' + 10),
   00831|         _ => None,
   00832|     }
   00833| }
   00834| 
   00835| const fn is_reserved_uri_delimiter(byte: u8) -> bool {
   00836|     matches!(
   00837|         byte,
   00838|         b';' | b'/' | b'?' | b':' | b'@' | b'&' | b'=' | b'+' | b'$' | b',' | b'#'
   00839|     )
   00840| }
   00841| 
   00842| /// Find a fenced code block whose info string matches one of the supplied
   00843| /// languages (case-insensitive). Returns the block body with trailing newlines
   00844| /// trimmed.
   00845| pub fn extract_fenced_block(text: &str, languages: &[&str]) -> Option<String> {
   00846|     let fence = "```";
   00847|     let mut cursor = 0usize;
   00848|     while let Some(open_offset) = text[cursor..].find(fence) {
   00849|         let open = cursor + open_offset;
   00850|         let info_start = open + fence.len();
   00851|         let info_end = text[info_start..]
   00852|             .find('\n')
   00853|             .map_or(text.len(), |n| info_start + n);
   00854|         let info = text[info_start..info_end].trim().to_lowercase();
   00855|         let body_start = (info_end + 1).min(text.len());
   00856|         let body_end_offset = text[body_start..].find(fence)?;
   00857|         let body_end = body_start + body_end_offset;
   00858|         let body = text[body_start..body_end].trim_end_matches('\n').to_owned();
   00859|         if info.is_empty() || languages.iter().any(|lang| info == *lang) {
   00860|             return Some(body);
   00861|         }
   00862|         cursor = body_end + fence.len();
   00863|     }
   00864|     None
   00865| }
