   00169| fn record_sub_impulses(
   00170|     log: &mut EventLog,
   00171|     parts: Vec<String>,
   00172|     independent: bool,
   00173| ) -> Vec<DecomposedSubImpulse> {
   00174|     let mut sub_impulses = Vec::new();
   00175|     for sub_impulse in parts {
   00176|         let id = log.append("sub_impulse", sub_impulse.clone());
   00177|         sub_impulses.push(DecomposedSubImpulse {
   00178|             id,
   00179|             text: sub_impulse,
   00180|             independent,
   00181|         });
   00182|     }
   00183|     sub_impulses
   00184| }
