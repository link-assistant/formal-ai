   00380| pub fn extract_quoted_phrase(text: &str) -> Option<String> {
   00381|     for (open, close) in [('\'', '\''), ('"', '"'), ('`', '`'), ('«', '»')] {
   00382|         if let Some(start) = text.find(open) {
   00383|             if let Some(end_offset) = text[start + open.len_utf8()..].find(close) {
   00384|                 let inner = &text[start + open.len_utf8()..start + open.len_utf8() + end_offset];
   00385|                 return Some(inner.to_owned());
   00386|             }
   00387|         }
   00388|     }
   00389|     None
   00390| }
   00391| 
   00392| pub fn extract_backticked(text: &str) -> Option<String> {
   00393|     let start = text.find('`')?;
   00394|     let rest = &text[start + 1..];
   00395|     let end = rest.find('`')?;
   00396|     Some(rest[..end].to_owned())
   00397| }
