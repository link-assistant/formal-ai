   00227| fn independent_actionable_segments(prompt: &str) -> Vec<String> {
   00228|     let parts = split_candidate_actionable_parts(prompt);
   00229|     if parts.len() <= 1
   00230|         || !parts
   00231|             .iter()
   00232|             .all(|part| looks_like_independent_impulse(part))
   00233|     {
   00234|         return Vec::new();
   00235|     }
   00236|     parts
   00237| }
