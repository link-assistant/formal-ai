   00239| fn split_candidate_actionable_parts(text: &str) -> Vec<String> {
   00240|     let mut parts = Vec::new();
   00241|     for sentence in split_sentences(text) {
   00242|         for clause in sentence.split(';') {
   00243|             for comma_part in clause.split(',') {
   00244|                 for and_part in comma_part.split(" and ") {
   00245|                     let trimmed = strip_leading_coordinator(and_part.trim());
   00246|                     if !trimmed.is_empty() {
   00247|                         parts.push(trimmed.to_owned());
   00248|                     }
   00249|                 }
   00250|             }
   00251|         }
   00252|     }
   00253|     parts
   00254| }
   00255| 
   00256| fn split_sentences(text: &str) -> Vec<String> {
   00257|     let chars: Vec<char> = text.chars().collect();
   00258|     let mut sentences = Vec::new();
   00259|     let mut current = String::new();
   00260|     for (index, &ch) in chars.iter().enumerate() {
   00261|         current.push(ch);
   00262|         let strong_terminator = matches!(ch, '?' | '!' | '。' | '！' | '？');
   00263|         let period_boundary =
   00264|             ch == '.' && chars.get(index + 1).is_none_or(|next| next.is_whitespace());
   00265|         if strong_terminator || period_boundary {
   00266|             push_trimmed_segment(&mut sentences, &current);
   00267|             current.clear();
   00268|         }
   00269|     }
   00270|     push_trimmed_segment(&mut sentences, &current);
   00271|     sentences
   00272| }
   00273| 
   00274| fn push_trimmed_segment(out: &mut Vec<String>, candidate: &str) {
   00275|     let trimmed = candidate.trim();
   00276|     if !trimmed.is_empty() {
   00277|         out.push(trimmed.to_owned());
   00278|     }
   00279| }
