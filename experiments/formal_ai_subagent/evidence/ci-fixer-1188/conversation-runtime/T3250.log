   00486| /// Language-neutral meta representation of a code fragment — the code meta
   00487| /// language.
   00488| ///
   00489| /// Issue #526 forbids direct pair-specific translation: with `N` languages a
   00490| /// direct table needs `N * N` translators, which is computationally
   00491| /// intractable. Code translation therefore mirrors the natural-language
   00492| /// pipeline. A fragment is first *formalized* into a `CodeMeaning` and then
   00493| /// *rendered* into the requested target, so the translator stays at `N`
   00494| /// formalizers plus `N` renderers instead of `N * N` hardcoded pairs. Adding a
   00495| /// language is one new [`formalize_code_meaning`] recognizer and one new
   00496| /// [`render_code_meaning`] arm — never a new `(source, target)` pair.
   00497| #[derive(Debug, Clone, PartialEq, Eq)]
   00498| pub enum CodeMeaning {
   00499|     /// A binary function `add(a, b)` that returns the sum of its two
   00500|     /// parameters. This is the currently seeded code meaning; widen coverage by
   00501|     /// adding variants here rather than by adding direct language pairs.
   00502|     BinaryAddFunction,
   00503|     /// The fragment has not been formalized into a known code meaning. Carries
   00504|     /// the trimmed source so callers render a traceable gap instead of
   00505|     /// manufacturing an incorrect translation.
   00506|     Unformalized(String),
   00507| }
   00508| 
   00509| impl CodeMeaning {
   00510|     /// Stable, language-neutral slug for this code meaning. Two fragments that
   00511|     /// share a meaning (e.g. the same add function written in Rust and in
   00512|     /// JavaScript) collapse to the same slug, which is what lets a round trip
   00513|     /// preserve its `meaning:` link.
   00514|     pub fn slug(&self) -> String {
   00515|         match self {
   00516|             Self::BinaryAddFunction => String::from("function:add:binary_sum"),
   00517|             Self::Unformalized(source) => source
   00518|                 .chars()
   00519|                 .filter(char::is_ascii_alphanumeric)
   00520|                 .collect::<String>()
   00521|                 .to_lowercase(),
   00522|         }
   00523|     }
   00524| }
   00525| 
   00526| /// Formalize a source-language code fragment into the language-neutral code
   00527| /// meta language. The source language is irrelevant to the result: `add`
   00528| /// written in Rust, Python, or JavaScript all collapse to the same
   00529| /// [`CodeMeaning::BinaryAddFunction`], which is exactly why the round trip
   00530| /// preserves meaning.
   00531| pub fn formalize_code_meaning(code: &str) -> CodeMeaning {
   00532|     if is_binary_add_function(code) {
   00533|         CodeMeaning::BinaryAddFunction
   00534|     } else {
   00535|         CodeMeaning::Unformalized(code.trim().to_owned())
   00536|     }
   00537| }
