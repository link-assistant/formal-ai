   00539| /// Render a [`CodeMeaning`] into `target`'s surface syntax. When the meaning is
   00540| /// unknown, or the target language has no seeded rendering yet, this returns a
   00541| /// traceable, language-appropriate translation-gap comment rather than
   00542| /// inventing plausible-but-wrong code.
   00543| pub fn render_code_meaning(meaning: &CodeMeaning, source: &str, target: &str) -> String {
   00544|     if matches!(meaning, CodeMeaning::BinaryAddFunction) {
   00545|         if let Some(rendered) = render_binary_add(target) {
   00546|             return rendered;
   00547|         }
   00548|     }
   00549|     let subject = match meaning {
   00550|         CodeMeaning::BinaryAddFunction => "add function",
   00551|         CodeMeaning::Unformalized(source_code) => source_code.as_str(),
   00552|     };
   00553|     format!(
   00554|         "{} translation gap for `{subject}` from {source} to {target}",
   00555|         code_comment_prefix(target)
   00556|     )
   00557| }
   00558| 
   00559| /// Render the seeded [`CodeMeaning::BinaryAddFunction`] into `target`. Returns
   00560| /// `None` when `target` has no seeded rendering, so the caller can emit a gap.
   00561| fn render_binary_add(target: &str) -> Option<String> {
   00562|     let rendered = match target {
   00563|         "python" => "def add(a, b):\n    return a + b",
   00564|         "rust" => "fn add(a: i32, b: i32) -> i32 {\n    a + b\n}",
   00565|         "javascript" => "function add(a, b) {\n    return a + b;\n}",
   00566|         "typescript" => "function add(a: number, b: number): number {\n    return a + b;\n}",
   00567|         "go" => "func add(a int, b int) int {\n    return a + b\n}",
   00568|         _ => return None,
   00569|     };
   00570|     Some(String::from(rendered))
   00571| }
   00572| 
   00573| /// Comment prefix used to render a translation gap in `language`'s own syntax.
   00574| fn code_comment_prefix(language: &str) -> &'static str {
   00575|     match language {
   00576|         "python" | "ruby" => "#",
   00577|         _ => "//",
   00578|     }
   00579| }
