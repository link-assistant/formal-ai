   00867| /// Return true when the normalized prompt asks for a script or code to be
   00868| /// *authored* — the author verb ([`ROLE_SCRIPT_AUTHORING_VERB`], carried by the
   00869| /// `write` meaning) paired with a script-or-code artifact noun
   00870| /// ([`ROLE_SCRIPT_OR_CODE_ARTIFACT`], carried by `script` and `code`) — in any
   00871| /// supported language. No natural-language word is hardcoded here; the lexicon
   00872| /// answers which surface forms evidence each role.
   00873| ///
   00874| /// Defers to the parametric write-program route for prompts that name the broad
   00875| /// program genus ([`ROLE_PROGRAM_GENUS`]) or the canonical hello-world archetype
   00876| /// ([`ROLE_HELLO_WORLD_REFERENCE`]), so those keep their richer formalization
   00877| /// instead of collapsing into a bare script.
   00878| ///
   00879| /// Defers again — see [`names_no_task_beyond_the_minimal_script`] — when the
   00880| /// prompt names a task the minimal script cannot render.
   00881| ///
   00882| /// [`ROLE_SCRIPT_AUTHORING_VERB`]: crate::seed::ROLE_SCRIPT_AUTHORING_VERB
   00883| /// [`ROLE_SCRIPT_OR_CODE_ARTIFACT`]: crate::seed::ROLE_SCRIPT_OR_CODE_ARTIFACT
   00884| /// [`ROLE_PROGRAM_GENUS`]: crate::seed::ROLE_PROGRAM_GENUS
   00885| /// [`ROLE_HELLO_WORLD_REFERENCE`]: crate::seed::ROLE_HELLO_WORLD_REFERENCE
   00886| pub fn is_write_script_request(prompt: &str, normalized: &str) -> bool {
   00887|     use crate::seed::{
   00888|         ROLE_HELLO_WORLD_REFERENCE, ROLE_PROGRAM_GENUS, ROLE_SCRIPT_AUTHORING_VERB,
   00889|         ROLE_SCRIPT_OR_CODE_ARTIFACT,
   00890|     };
   00891|     let lexicon = crate::seed::lexicon();
   00892|     // The parametric write-program route owns the broad program genus and the
   00893|     // canonical hello-world archetype; step aside for those.
   00894|     if lexicon.mentions_role(ROLE_PROGRAM_GENUS, normalized)
   00895|         || lexicon.mentions_role(ROLE_HELLO_WORLD_REFERENCE, normalized)
   00896|     {
   00897|         return false;
   00898|     }
   00899|     // Author a script: the write verb plus a script-or-code artifact noun.
   00900|     if !(lexicon.mentions_role(ROLE_SCRIPT_AUTHORING_VERB, normalized)
   00901|         && lexicon.mentions_role(ROLE_SCRIPT_OR_CODE_ARTIFACT, normalized))
   00902|     {
   00903|         return false;
   00904|     }
   00905|     names_no_task_beyond_the_minimal_script(prompt, normalized)
   00906| }
   00907| 
   00908| /// Return true when the minimal-script route can render everything the prompt
   00909| /// names, and false when the prompt names a task it cannot.
   00910| ///
   00911| /// The route renders exactly one thing: the hello-world template for the
   00912| /// language it recognizes. `handler:write_script` is hoisted to the front of
   00913| /// method selection by the bare tokens "script"/"code" in
   00914| /// `data/meta/cue-lexicon.lino`, which without this check lets that one template
   00915| /// answer any request merely ending in "give me the code" — jumping over the
   00916| /// task routes `data/seed/handler-precedence.lino` ranks above it (`numeric_list`
   00917| /// is line 29, `write_script` line 43). Standing aside for a task it cannot
   00918| /// render restores that order for any authoring verb, in any language, because
   00919| /// the test is a property of the route rather than of a phrase.
   00920| fn names_no_task_beyond_the_minimal_script(prompt: &str, normalized: &str) -> bool {
   00921|     let Some(program) = crate::engine::hello_world_program_by_alias(normalized) else {
   00922|         // No catalogued language: the route declines on its own grounds.
   00923|         return true;
   00924|     };
   00925|     if crate::coding::program_task_by_alias(normalized)
   00926|         .is_some_and(|task| task.slug != program.task.slug)
   00927|     {
   00928|         return false;
   00929|     }
   00930|     crate::solver_handlers::numeric_list::solve_numeric_list(prompt).is_none()
   00931| }
