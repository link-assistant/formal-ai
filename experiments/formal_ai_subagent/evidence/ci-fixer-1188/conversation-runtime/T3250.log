   00633| pub fn infer_source_from_prompt(prompt: &str) -> &'static str {
   00634|     let lower = prompt.to_lowercase();
   00635|     if let Some(surface) = extract_quoted_phrase(prompt)
   00636|         .or_else(|| crate::translation::extract_unquoted_translation_surface(prompt))
   00637|     {
   00638|         let language = detect_language(&surface);
   00639|         if language != Language::Unknown {
   00640|             return language.slug();
   00641|         }
   00642|     }
   00643|     // Issue #386: the source language of an un-annotated request is the language
   00644|     // the user issued the *translation command* in. Ask the lexicon which
   00645|     // language's translation-action verb (переведи/опиши, अनुवाद, 翻译/翻譯…) the
   00646|     // prompt carries — the per-language stems live once in
   00647|     // data/seed/meanings-translation.lino under the `translate` meaning; this
   00648|     // code knows only the concept and the language-code bridge. English is the
   00649|     // default when no command verb is present.
   00650|     crate::seed::lexicon()
   00651|         .first_role_language(
   00652|             crate::seed::ROLE_TRANSLATION_ACTION,
   00653|             &lower,
   00654|             &["ru", "hi", "zh"],
   00655|         )
   00656|         .unwrap_or("en")
   00657| }
