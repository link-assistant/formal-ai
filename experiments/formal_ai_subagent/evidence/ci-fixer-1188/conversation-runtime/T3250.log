   00581| /// Translate a code fragment from `source` to `target` by routing through the
   00582| /// code meta language: `source -> CodeMeaning -> target`. There is no direct
   00583| /// `(source, target)` path — see [`CodeMeaning`] for why.
   00584| pub fn translate_program(code: &str, source: &str, target: &str) -> String {
   00585|     let meaning = formalize_code_meaning(code);
   00586|     render_code_meaning(&meaning, source, target)
   00587| }
