   00437| pub fn extract_introduced_name(prompt: &str) -> Option<String> {
   00438|     let needles = ["my name is", "i am called", "call me", "i'm", "i am "];
   00439|     let lower = prompt.to_lowercase();
   00440|     for needle in needles {
   00441|         let mut search_from = 0;
   00442|         while let Some(offset) = lower[search_from..].find(needle) {
   00443|             let absolute = search_from + offset + needle.len();
   00444|             let tail = &prompt[absolute..];
   00445|             let token = tail
   00446|                 .trim_start()
   00447|                 .split(|c: char| {
   00448|                     c.is_whitespace() || matches!(c, '.' | ',' | '!' | '?' | ';' | ':' | '\n')
   00449|                 })
   00450|                 .find(|token| !token.is_empty())?;
   00451|             let cleaned = token.trim_matches(|c: char| !c.is_alphanumeric());
   00452|             if !cleaned.is_empty() && cleaned.chars().next().is_some_and(char::is_alphabetic) {
   00453|                 return Some(cleaned.to_owned());
   00454|             }
   00455|             search_from = absolute;
   00456|         }
   00457|     }
   00458|     None
   00459| }
