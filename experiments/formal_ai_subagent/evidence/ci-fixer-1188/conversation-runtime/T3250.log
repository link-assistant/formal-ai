   00296| fn looks_like_independent_impulse(segment: &str) -> bool {
   00297|     let normalized = normalize_prompt(segment);
   00298|     if normalized.is_empty() {
   00299|         return false;
   00300|     }
   00301|     let language = detect_language(segment);
   00302|     let formalization = formalize_intent(segment, language.slug(), None);
   00303|     formalization.route.is_some()
   00304|         || matches!(
   00305|             formalization.kind,
   00306|             IntentKind::Task
   00307|                 | IntentKind::Question
   00308|                 | IntentKind::Requirement
   00309|                 | IntentKind::Courtesy
   00310|         )
   00311|         || formalization
   00312|             .relevants
   00313|             .iter()
   00314|             .any(|relevant| relevant.starts_with("handler:"))
   00315| }
