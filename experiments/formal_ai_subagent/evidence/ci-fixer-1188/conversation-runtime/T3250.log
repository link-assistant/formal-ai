   00477|         .iter()
   00478|         .find(|lang| normalized.contains(&format!("to {lang}")))
   00479|         .copied();
   00480|     match (from, to) {
   00481|         (Some(f), Some(t)) => Some((f, t)),
   00482|         _ => None,
   00483|     }
   00484| }
