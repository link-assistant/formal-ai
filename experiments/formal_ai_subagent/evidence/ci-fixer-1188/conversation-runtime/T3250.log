   00763| /// Extract a JavaScript program from a prompt that asks the solver to run it.
   00764| /// Looks for triple-backtick code fences first (with optional `js`/`javascript`
   00765| /// language tag), then single-backtick spans, then `run "...";` quoted bodies.
   00766| /// Returns `None` when the prompt does not appear to request JS execution.
   00767| pub fn extract_javascript_program(prompt: &str) -> Option<String> {
   00768|     let lower = prompt.to_lowercase();
   00769|     let asks_to_run = lower.contains("run this javascript")
   00770|         || lower.contains("run this js")
   00771|         || lower.contains("execute this javascript")
   00772|         || lower.contains("execute this js")
   00773|         || lower.contains("run the following javascript")
   00774|         || lower.contains("run the following js")
   00775|         || lower.contains("evaluate this javascript")
   00776|         || lower.contains("evaluate this js");
   00777|     if !asks_to_run {
   00778|         return None;
   00779|     }
   00780|     if let Some(body) = extract_fenced_block(prompt, &["javascript", "js"]) {
   00781|         return Some(body);
   00782|     }
   00783|     if let Some(body) = extract_backticked(prompt) {
   00784|         return Some(body);
   00785|     }
   00786|     extract_quoted_phrase(prompt)
