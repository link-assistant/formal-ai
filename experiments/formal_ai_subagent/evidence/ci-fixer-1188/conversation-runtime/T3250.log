   00624| /// Return the canonical meaning token for a normalized surface. With the
   00625| /// offline registry gone, this is currently the identity function — the
   00626| /// translation pipeline supplies the language-neutral [`MeaningId`] when a
   00627| /// translation request actually fires, and callers that need a hash key
   00628| /// (e.g. the engine's stable id) feed the normalized surface directly.
   00629| pub fn canonical_meaning_token(raw: &str) -> String {
   00630|     String::from(raw)
   00631| }
