   01105|     explicitSuffixes: suffixLiterals(ROLE_WEB_SEARCH_EXPLICIT_PREFIX),
   01106|     explicitCircumfixes: circumfixLiterals(ROLE_WEB_SEARCH_EXPLICIT_PREFIX),
   01107|     actionMarkers: bareLiterals(ROLE_WEB_SEARCH_ACTION),
   01108|     strongActionMarkers: bareLiterals(ROLE_WEB_SEARCH_STRONG_ACTION),
   01109|     strongImperativeLeadMarkers: prefixLiterals(ROLE_WEB_SEARCH_STRONG_ACTION),
   01110|     signalMarkers: bareLiterals(ROLE_WEB_SEARCH_SIGNAL),
   01111|     topicAfterMarkers: prefixLiterals(ROLE_WEB_SEARCH_TOPIC_MARKER),
   01112|     topicBeforeMarkers: suffixLiterals(ROLE_WEB_SEARCH_TOPIC_MARKER),
   01113|     imperativeLeadMarkers: prefixLiterals(ROLE_WEB_SEARCH_IMPERATIVE_LEAD),
   01114|     leadingNoise: prefixLiterals(ROLE_WEB_SEARCH_QUERY_LEADING_NOISE),
   01115|     trailingNoise: suffixLiterals(ROLE_WEB_SEARCH_QUERY_TRAILING_NOISE),
   01116|     sourceOnly: sourceLiterals(ROLE_WEB_SEARCH_SOURCE_ONLY),
   01117|     sourceMarkers: bareLiterals(ROLE_WEB_SEARCH_SOURCE_ONLY),
   01118|     sourceMediumMarkers: bareLiterals(ROLE_WEB_MEDIUM),
   01119|     informationMarkers: bareLiterals(ROLE_WEB_SEARCH_SIGNAL).filter(
   01120|       (marker) =>
   01121|         !bareLiterals(ROLE_WEB_SEARCH_SOURCE_ONLY).some(
