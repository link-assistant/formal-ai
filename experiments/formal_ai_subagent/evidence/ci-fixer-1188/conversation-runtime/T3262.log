   01155| function containsSearchMarker(normalized, marker) {
   01156|   const text = String(normalized || "");
   01157|   if (marker.startsWith(" ") || marker.endsWith(" ")) {
   01158|     return ` ${text} `.includes(marker);
   01159|   }
   01160|   return text.includes(marker);
   01161| }
   01162| 
   01163| function containsAnySearchMarker(normalized, markers) {
   01164|   return markers.some((marker) => containsSearchMarker(normalized, marker));
   01165| }
   01166| 
   01167| function stripSearchNoisePrefix(value, prefix) {
   01168|   const text = cleanSearchQuery(value);
   01169|   return text.toLowerCase().startsWith(prefix)
   01170|     ? cleanSearchQuery(text.slice(prefix.length))
   01171|     : text;
   01172| }
   01173| 
   01174| function stripSearchNoiseSuffix(value, suffix) {
   01175|   const text = cleanSearchQuery(value);
   01176|   return text.toLowerCase().endsWith(suffix)
   01177|     ? cleanSearchQuery(text.slice(0, text.length - suffix.length))
   01178|     : text;
   01179| }
