   01181| // Sentence-ending punctuation that can introduce a follow-up instruction
   01182| // clause — ASCII plus the fullwidth/ideographic forms a CJK prompt uses.
   01183| // Mirrors is_sentence_boundary.
   01184| const SEARCH_SENTENCE_BOUNDARY = new Set([
   01185|   ".",
   01186|   "?",
   01187|   "!",
   01188|   ";",
   01189|   ":",
   01190|   "\u3002",
   01191|   "\uff1f",
   01192|   "\uff01",
   01193|   "\uff1b",
   01194|   "\uff1a",
   01195| ]);
   01196| 
   01197| // ASCII-only lowercase: folds A–Z and nothing else, so the result keeps the same
   01198| // length (in UTF-16 code units) as the input and computed offsets stay aligned.
   01199| // Mirrors Rust str::to_ascii_lowercase (a full toLowerCase could change length,
   01200| // e.g. 'İ' -> 'i̇', and misalign the cut offsets).
   01201| function asciiLowercase(value) {
   01202|   return String(value || "").replace(/[A-Z]/g, (character) =>
   01203|     String.fromCharCode(character.charCodeAt(0) + 32),
   01204|   );
   01205| }
   01206| 
   01207| // Is the single Unicode code point `code` a letter or number? Mirrors Rust
   01208| // char::is_alphanumeric closely enough for token-boundary detection.
   01209| function isSearchAlnum(code) {
   01210|   return /[\p{L}\p{N}]/u.test(String.fromCodePoint(code));
   01211| }
   01212| 
   01213| // Does `index` begin a token in `text` (the preceding code point is non-
   01214| // alphanumeric, or there is none)? Surrogate-pair aware. Mirrors is_token_start.
   01215| function isSearchTokenStart(text, index) {
   01216|   if (index <= 0) return true;
   01217|   const i = index - 1;
   01218|   let code = text.charCodeAt(i);
   01219|   if (code >= 0xdc00 && code <= 0xdfff && i > 0) {
   01220|     const high = text.charCodeAt(i - 1);
   01221|     if (high >= 0xd800 && high <= 0xdbff) {
   01222|       code = (high - 0xd800) * 0x400 + (code - 0xdc00) + 0x10000;
   01223|     }
   01224|   }
   01225|   return !isSearchAlnum(code);
   01226| }
   01227| 
   01228| // Does `index` end a token in `text` (the following code point is non-
   01229| // alphanumeric, or there is none)? Mirrors is_token_end.
   01230| function isSearchTokenEnd(text, index) {
   01231|   if (index >= text.length) return true;
   01232|   return !isSearchAlnum(text.codePointAt(index));
   01233| }
   01234| 
   01235| // Whether `haystack` ends with `marker` as a whole token. CJK markers match as
   01236| // bare substrings; space-delimited markers need a preceding whitespace (or for
   01237| // the whole string to be exactly the marker). Mirrors ends_with_token.
   01238| function searchEndsWithToken(haystack, marker) {
   01239|   if (containsCjk(marker)) return haystack.endsWith(marker);
   01240|   if (haystack === marker) return true;
   01241|   if (!haystack.endsWith(marker)) return false;
   01242|   const head = haystack.slice(0, haystack.length - marker.length);
   01243|   return /\s$/u.test(head);
   01244| }
   01245| 
   01246| // If the text immediately before `verbStart` is a follow-up boundary, return the
   01247| // code-unit offset at which to cut (the start of the boundary run); otherwise
   01248| // null. Mirrors boundary_before.
   01249| function searchBoundaryBefore(text, verbStart, markers) {
   01250|   const head = text.slice(0, verbStart).trimEnd();
   01251|   if (head.length === 0) return null;
   01252|   if (SEARCH_SENTENCE_BOUNDARY.has(head[head.length - 1])) return head.length;
   01253|   // Walk back over a run of clause-continuation markers ("and", "then",
   01254|   // "and then"); the cut falls at the start of the run.
   01255|   let cursor = head;
   01256|   let matched = false;
   01257|   for (;;) {
   01258|     const trimmed = cursor.trimEnd();
   01259|     let rest = null;
   01260|     for (const marker of markers.continuationMarkers) {
   01261|       if (searchEndsWithToken(trimmed, marker)) {
   01262|         rest = trimmed.slice(0, trimmed.length - marker.length);
   01263|         break;
   01264|       }
   01265|     }
   01266|     if (rest === null) break;
   01267|     cursor = rest;
   01268|     matched = true;
   01269|   }
   01270|   return matched ? cursor.trimEnd().length : null;
   01271| }
   01272| 
   01273| // Drop a trailing follow-up instruction clause ("… and summarize who won",
   01274| // "… . Compare their patents") from a query. A universal boundary algorithm, not
   01275| // a list of memorised fragments: a follow-up clause is one of the lexicon's
   01276| // followup_instruction_verb surfaces sitting immediately after a *boundary* —
   01277| // sentence punctuation or a run of clause_continuation_marker words — and the
   01278| // query is cut at the start of the earliest such boundary. A bare verb with no
   01279| // boundary before it is part of the topic and left untouched. Mirrors
   01280| // truncate_search_instruction_tail in src/solver_handlers/web_search_intent.rs.
   01281| // Issue #1175 R3, numeric group: claim evidence joined into claimEvidence() (formal_ai_worker_dispatch.js), each the operand reader its handler already runs, twin of rust/src/capability_routing/claims.rs.
   01282| const NUMERIC_CLAIM_EVIDENCE = Object.freeze({
   01283|   stated_number: (prompt) => parseNumericListNumbers(String(prompt).toLowerCase()).length > 0,
   01284|   calculation_expression: (prompt) => Boolean(extractArithmeticExpression(prompt)),
   01285|   currency_rate_basis: (prompt) => mentionsUsdRate(normalizePrompt(prompt)) && mentionsRateCalculationBasis(normalizePrompt(prompt)),
   01286|   investment_terms: (prompt, normalized) => parseCompoundInterestRequest(prompt, normalized) !== null,
   01287|   conversion_target_currency: (prompt, normalized) => Boolean(targetCurrencyFromText(normalized)),
   01288|   interval_bounds: (prompt, normalized) => numberConstraintIntervalBounds(normalizePrompt(normalized), String(prompt).toLowerCase()) !== null,
   01289|   measured_quantity: (prompt) => parseNumericListNumbers(String(prompt).toLowerCase()).length > 0 && unitMentions(String(prompt).toLowerCase()).length === 2,
   01290|   calendar_anchor: (prompt, normalized) => Boolean(detectWeekday(normalized) || detectCalendarMonth(normalized) || calendarStatedDate(prompt, normalized) || mentionsCurrentDayQuestion(normalized)),
