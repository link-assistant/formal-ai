   00103| function writeProgramVerificationTrace(candidateId, plan, template, modifiers) {
   00104|   if (!plan || !Array.isArray(modifiers) || modifiers.length === 0) return null;
   00105|   const planCheck = programPlanWasModified(plan) && Array.isArray(plan.traces) && plan.traces.length > 0;
