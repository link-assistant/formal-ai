   00774| // Mirror probable_local_file_name in src/solver_handlers/web_search_intent.rs.
   00775| // A schemeless attachment/path such as report.txt is a local object, not an
   00776| // HTTPS host. Explicit http(s) URLs still take the authoritative branch below.
   00777| function probableLocalFileName(candidate) {
   00778|   const extension = String(candidate || "").split(".").pop().toLowerCase();
   00779|   return [
   00780|     "txt", "md", "json", "yaml", "yml", "toml", "rs", "py", "js", "ts",
   00781|     "tsx", "jsx", "css", "html", "xml", "csv", "lino", "log", "sh",
   00782|   ].includes(extension);
   00783| }
