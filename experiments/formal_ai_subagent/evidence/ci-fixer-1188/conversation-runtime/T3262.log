   00757| function looksLikeHostname(value) {
   00758|   const host = String(value || "").trim();
   00759|   if (!host.includes(".") || host.startsWith(".") || host.endsWith(".")) {
   00760|     return false;
   00761|   }
   00762|   const labels = host.split(".");
   00763|   if (labels.some((label) => !label)) return false;
   00764|   const tld = labels[labels.length - 1] || "";
   00765|   if (tld.length < 2) return false;
   00766|   return labels.every(
   00767|     (label) =>
   00768|       /^[a-z0-9-]+$/i.test(label) &&
   00769|       !label.startsWith("-") &&
   00770|       !label.endsWith("-"),
   00771|   );
   00772| }
