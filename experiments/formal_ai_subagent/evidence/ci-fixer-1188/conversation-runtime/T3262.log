   00585| // The draft table: the seeded intro, a topic column and one column per
   00586| // criterion with the seeded, source-dependent cell instruction in the request's
   00587| // language. Mirrors render_comparison_table in
   00588| // src/solver_handlers/research_table.rs; no topic fact is ever written here.
   00589| function renderResearchComparisonTable(topics, criteria, language) {
   00590|   const procedure = researchTableProcedure();
   00591|   const tableText = procedure.tableTexts.find((entry) => entry.language === language) ||
   00592|     procedure.tableTexts.find((entry) => entry.language === "en") || null;
   00593|   const columnText = (criterion, field) => {
   00594|     const column = researchTableColumn(criterion);
   00595|     return (column && researchLocalizedValue(column[field], language)) || criterion;
   00596|   };
   00597|   let body = `${tableText ? tableText.intro : ""}\n\n| ${tableText ? tableText.topicLabel : ""} |`;
   00598|   for (const criterion of criteria) body += ` ${columnText(criterion, "labels")} |`;
   00599|   body += `\n| --- |${criteria.map(() => " --- |").join("")}\n`;
   00600|   for (const topic of topics) {
   00601|     body += `| ${escapeResearchTableCell(topic)} |`;
   00602|     for (const criterion of criteria) {
