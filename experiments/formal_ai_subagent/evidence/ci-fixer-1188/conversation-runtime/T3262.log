   00383| function tryHistorical(prompt, history) {
   00384|   const normalized = normalizePrompt(prompt);
   00385|   // Issue #386: a conversation-summary request is recognised by composing
   00386|   // meaning roles (see isSummarizePrompt) across every supported language, so
   00387|   // we test it before the empty-normalized bail-out below. Issue #858 selects
   00388|   // the returning-user recap's bounded plain format before the detailed report.
   00389|   if (isReturnRecapPrompt(normalized)) {
   00390|     return tryRecapConversation(history);
   00391|   }
   00392|   if (isSummarizePrompt(normalized)) {
   00393|     return trySummarizeConversation(history);
   00394|   }
   00395|   if (!normalized) return null;
   00396|   // Issue #676: set/recall the assistant's own name from dialog-local history so
   00397|   // "Now your name is Ineffa" is acknowledged and later recalled, instead of
   00398|   // falling through to the unknown opener. Mirrors try_assistant_name in the
   00399|   // Rust conversation-memory handler and runs before the user-name recall below.
   00400|   const assistantName = tryAssistantName(prompt, normalized, history);
   00401|   if (assistantName) return assistantName;
   00402|   if (normalized === "what is my name" || normalized === "what s my name") {
   00403|     const hit = tryRecallName(history);
   00404|     if (hit) return hit;
   00405|   }
   00406|   if (lexiconMentionsRole(ROLE_CONVERSATION_RECALL_PREVIOUS_USER_MESSAGE, normalized)) {
   00407|     return tryRecallLastQuestion(prompt, history);
   00408|   }
   00409|   // Issue #529: recognise "what was written in the previous message?" across
   00410|   // every supported language via the conversation_recall_previous_message seed
   00411|   // role after the user-message recall above, so "what did I ask in the
   00412|   // previous message" targets the user's prior turn rather than the assistant's.
   00413|   const previousMessage = tryRecallPreviousMessage(prompt, history);
   00414|   if (previousMessage) return previousMessage;
   00415|   return tryConversationRecall(prompt, normalized, history);
   00416| }
