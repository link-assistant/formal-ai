   01053| // The literal lead-in (form.before, the text before the … slot) of every
   01054| // prefix-slot form of a role, in lexicon declaration order. A meaning's roles
   01055| // apply to all its forms, so keep only the slot we asked for. Mirrors
   01056| // prefix_literals.
   01057| function prefixLiterals(role) {
   01058|   return roleWordForms(role)
   01059|     .filter((form) => form.slot === "prefix")
   01060|     .map((form) => form.before);
   01061| }
   01062| // The literal tail (form.after) of every suffix-slot form of a role. Mirrors
   01063| // suffix_literals.
   01064| function suffixLiterals(role) {
   01065|   return roleWordForms(role)
   01066|     .filter((form) => form.slot === "suffix")
   01067|     .map((form) => form.after);
   01068| }
   01069| // The literal pair around every circumfix-slot form of a role. Mirrors
   01070| // circumfix_literals.
   01071| function circumfixLiterals(role) {
   01072|   return roleWordForms(role)
   01073|     .filter((form) => form.slot === "circumfix")
   01074|     .map((form) => ({ before: form.before, after: form.after }));
   01075| }
   01076| // The surface text of every bare-slot form of a role (drop any prefix/suffix
   01077| // surfaces the same meaning also owns). Mirrors bare_literals.
   01078| function bareLiterals(role) {
   01079|   return roleWordForms(role)
   01080|     .filter((form) => form.slot === "bare")
   01081|     .map((form) => form.text);
   01082| }
   01083| // The distinct surface words of a role, trimmed + lowercased for equality
   01084| // comparison against a cleaned query. Mirrors source_literals (words_for_role).
   01085| function sourceLiterals(role) {
   01086|   const seen = new Set();
   01087|   const out = [];
   01088|   for (const form of roleWordForms(role)) {
   01089|     const key = form.text.trim().toLowerCase();
   01090|     if (!seen.has(key)) {
   01091|       seen.add(key);
   01092|       out.push(key);
   01093|     }
   01094|   }
   01095|   return out;
   01096| }
