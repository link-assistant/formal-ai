   00334| function recapPlainSentence(text) {
   00335|   let plain = String(text || "")
   00336|     .replace(/```[\s\S]*?```|~~~[\s\S]*?~~~/gu, " ")
   00337|     .replace(/^\s*(?:#{1,6}|[-+>*])\s*/gmu, " ")
   00338|     .replace(/[#`*]/gu, "")
   00339|     .replace(/\s+/gu, " ")
   00340|     .trim()
   00341|     .split(/\s+[—–]\s+/u)[0];
   00342|   const sentence = plain.match(/^.*?(?:[.!?](?=\s|$)|[。！？])/u);
   00343|   if (sentence) plain = sentence[0];
   00344|   if (plain && !/[.!?。！？]$/u.test(plain)) plain += ".";
   00345|   return plain;
   00346| }
