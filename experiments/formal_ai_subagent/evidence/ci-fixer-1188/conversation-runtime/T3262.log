   00107|   // reverse_sort must leave the output descending; its inverse,
   00108|   // cancel_reverse_sort, must leave NO descending order — otherwise the cancel
   00109|   // silently failed to remove the sort. Modifiers that touch no ordering pass.
   00110|   const cancelsSort = modifiers.includes("cancel_reverse_sort");
