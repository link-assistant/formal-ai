   00680| // Issue #386: a conversation-summary request is recognised by composing
   00681| // meaning roles, not by matching raw words per language. The universal
   00682| // algorithm is identical for every language: the prompt either carries a
   00683| // complete standalone conversation-summary phrasing, an objectless courtesy
   00684| // frame ("can you summarize", "подведи итог"), a summary directive together
   00685| // with an explicit conversation reference, or it is itself a bare summary
   00686| // directive. The prompt is re-normalised first so the boundary-aware matcher
   00687| // sees punctuation collapsed to spaces (idempotent here, since `normalized`
   00688| // is already normalised). Mirror of asks_for_conversation_summary in
   00689| // src/solver_handlers/mod.rs.
   00690| function isSummarizePrompt(normalized) {
   00691|   const cleaned = normalizePrompt(normalized);
   00692|   return (
   00693|     isReturnRecapPrompt(cleaned) ||
   00694|     lexiconMentionsRole(ROLE_CONVERSATION_SUMMARY_PHRASE, cleaned) ||
   00695|     (lexiconMentionsRole(ROLE_CONVERSATION_SUMMARY_COURTESY, cleaned) &&
   00696|       courtesyFrameLeavesNoObject(cleaned)) ||
   00697|     (lexiconMentionsRole(ROLE_CONVERSATION_SUMMARY_DIRECTIVE, cleaned) &&
   00698|       lexiconMentionsRole(ROLE_CONVERSATION_REFERENCE, cleaned)) ||
   00699|     summaryDirectiveLeads(cleaned)
   00700|   );
   00701| }
   00702| 
   00703| // The courtesy frames are frames, not owners: "can you summarize" opens a
   00704| // request whose object, when one follows, belongs to whichever handler
   00705| // summarizes that object. Stripping every courtesy and directive surface
   00706| // from the prompt must leave nothing — "can you summarize" alone summarizes
   00707| // the running conversation, "can you summarize Rust" names a topic. Longest
   00708| // surfaces strip first so a frame that prefixes another ("подведи итог"
   00709| // inside "подведи итоги") leaves no orphan letters. Mirror of
   00710| // courtesy_frame_leaves_no_object in
   00711| // src/solver_handlers/conversation_memory/conversation_summary.rs.
   00712| function courtesyFrameLeavesNoObject(cleaned) {
   00713|   const surfaces = [
   00714|     ...wordsForRole(ROLE_CONVERSATION_SUMMARY_COURTESY),
   00715|     ...wordsForRole(ROLE_CONVERSATION_SUMMARY_DIRECTIVE),
   00716|   ]
   00717|     .filter(Boolean)
   00718|     .sort((a, b) => b.length - a.length);
   00719|   let remainder = cleaned;
   00720|   for (const surface of surfaces) {
   00721|     remainder = remainder.split(surface).join(" ");
   00722|   }
   00723|   // Whitespace and ASCII punctuation are the only leftovers an objectless
   00724|   // frame may show ("can you summarize?", "summarize!").
   00725|   return !remainder.replace(
   00726|     /[\s\x21-\x2f\x3a-\x40\x5b-\x60\x7b-\x7e]/gu,
   00727|     "",
   00728|   );
   00729| }
