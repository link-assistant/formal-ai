   00507|   const text = seedRawText(SEED_RAW, "research-table-procedure.lino");
   00508|   const root = text
   00509|     ? parseLinoTree(text).children.find((node) => node.name === "research_table_procedure")
   00510|     : null;
   00511|   const records = root ? root.children : [];
   00512|   const localized = (node, name) => linoChildValues(node, name).map((raw) => {
   00513|     const value = String(raw || "");
   00514|     const space = value.search(/\s/u);
   00515|     if (space < 0) return null;
   00516|     const text = value.slice(space).trim().replace(/^"+|"+$/gu, "").split('""').join('"');
   00517|     return { language: value.slice(0, space), text };
   00518|   }).filter(Boolean);
   00519|   const named = (name) => records.filter((node) => node.name === name);
   00520|   const procedure = {
   00521|     statuses: named("status").map((node) => ({
   00522|       slug: node.value,
   00523|       markers: linoChildValues(node, "marker").map((marker) => String(marker).toLowerCase()),
   00524|     })),
   00525|     tableTexts: named("table_text").map((node) => ({
   00526|       language: node.value,
   00527|       intro: childValue(node, "intro"),
   00528|       topicLabel: childValue(node, "topic_label"),
   00529|     })),
   00530|     criteria: named("criterion").map((node) => ({
   00531|       slug: node.value,
   00532|       labels: localized(node, "label"),
   00533|       instructions: localized(node, "instruction"),
   00534|     })),
   00535|     followupRequests: named("followup_request").map((node) => String(node.value).toLowerCase()),
   00536|   };
   00537|   if (text) cachedResearchTableProcedure = procedure;
   00538|   return procedure;
   00539| }
