   00785| function normalizeUrlCandidate(candidate) {
   00786|   const text = String(candidate || "").trim();
   00787|   if (!text || /\s/.test(text) || text.includes("@")) return null;
   00788|   const lower = text.toLowerCase();
   00789|   let url = "";
   00790|   if (lower.startsWith("http://") || lower.startsWith("https://")) {
   00791|     url = text;
   00792|   } else {
   00793|     const hostCandidate = text.split(/[/?#]/, 1)[0] || "";
   00794|     if (
   00795|       !probableLocalFileName(hostCandidate) &&
   00796|       (lower.startsWith("www.") || looksLikeHostname(hostCandidate))
   00797|     ) {
   00798|       url = `https://${text}`;
   00799|     }
   00800|   }
   00801|   if (!url) return null;
   00802|   let parsed;
   00803|   try {
   00804|     parsed = new URL(url);
   00805|   } catch (_error) {
   00806|     return null;
   00807|   }
   00808|   if (!looksLikeHostname(parsed.hostname)) return null;
   00809|   return parsed.href.replace(/\/$/, "");
   00810| }
