   00731| function isReturnRecapPrompt(normalized) {
   00732|   return lexiconMentionsRole(
   00733|     ROLE_CONVERSATION_RETURN_RECAP,
   00734|     normalizePrompt(normalized),
   00735|   );
   00736| }
