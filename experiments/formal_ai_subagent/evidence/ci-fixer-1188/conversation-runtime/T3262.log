   01123|         ),
   01124|     ),
   01125|     newsSubjectMarkers: bareLiterals(ROLE_WEB_SEARCH_NEWS_SUBJECT),
   01126|     newsRecencyMarkers: bareLiterals(ROLE_WEB_SEARCH_NEWS_RECENCY),
   01127|     recordsSubjectMarkers: bareLiterals(ROLE_WEB_SEARCH_RECORDS_SUBJECT),
   01128|     publicEventSubjectMarkers: bareLiterals(ROLE_WEB_SEARCH_PUBLIC_EVENT_SUBJECT),
   01129|     followupVerbs: bareLiterals(ROLE_FOLLOWUP_INSTRUCTION_VERB),
   01130|     continuationMarkers: bareLiterals(ROLE_CLAUSE_CONTINUATION_MARKER),
   01131|     termInformationPrefixes: prefixLiterals(ROLE_TERM_INFORMATION_REQUEST_OPENER),
   01132|     termInformationSuffixes: suffixLiterals(ROLE_TERM_INFORMATION_REQUEST_OPENER),
   01133|     termInformationCircumfixes: circumfixLiterals(ROLE_TERM_INFORMATION_REQUEST_OPENER),
   01134|     researchQuestionPrefixes: prefixLiterals(ROLE_RESEARCH_QUESTION_OPENER),
   01135|     researchModifiers: bareLiterals(ROLE_RESEARCH_SUPERLATIVE_MODIFIER),
   01136|     researchEvidenceDomains: bareLiterals(ROLE_RESEARCH_EVIDENCE_DOMAIN),
   01137|     researchEvaluationDomains: bareLiterals(ROLE_RESEARCH_EVALUATION_DOMAIN),
   01138|     enumerationPrefixes: prefixLiterals(ROLE_ENUMERATION_REQUEST_OPENER),
   01139|     enumerationConstraintMarkers: bareLiterals(ROLE_ENUMERATION_CONSTRAINT),
