   00348| function tryRecapConversation(history) {
   00349|   if (!Array.isArray(history)) return null;
   00350|   let userIndex = -1;
   00351|   for (let index = history.length - 1; index >= 0; index -= 1) {
   00352|     if (history[index]?.role === "user" && history[index]?.content) {
   00353|       userIndex = index;
   00354|       break;
   00355|     }
   00356|   }
   00357|   if (userIndex < 0) return null;
   00358|   const sentences = [recapPlainSentence(history[userIndex].content)].filter(Boolean);
   00359|   for (let index = history.length - 1; index > userIndex; index -= 1) {
   00360|     if (history[index]?.role !== "assistant" || !history[index]?.content) continue;
   00361|     const status = recapPlainSentence(history[index].content);
   00362|     if (status && status.toLowerCase() !== sentences[0]?.toLowerCase())
   00363|       sentences.push(status);
   00364|     break;
   00365|   }
   00366|   const words = sentences.slice(0, 2).join(" ").split(/\s+/u).filter(Boolean);
   00367|   let content = words.slice(0, 39).join(" ");
   00368|   if (words.length > 39) content = `${content.replace(/[.,;:!?。！？]+$/u, "")}.`;
   00369|   if (!content) return null;
   00370|   return {
   00371|     intent: "summarize_conversation",
   00372|     content,
   00373|     confidence: 0.9,
   00374|     evidence: [
   00375|       "summarize_conversation",
   00376|       "summarization:format:plain",
   00377|       "max_words:39",
   00378|       "max_sentences:2",
   00379|     ],
   00380|   };
   00381| }
