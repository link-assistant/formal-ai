   00711| // Issue #1175 R3 classes (b), (c) and (e): a follow-up admits on the earlier
   00712| // turn it continues, read from the dialogue log; a composer on its
   00713| // specification, admitted to its refusal lane without one; a lookup or policy
   00714| // on the subject or shape its own reader extracts. Mirrored by the class tests
   00715| // of `rust/tests/web/issue-1175-claim-routing.test.mjs`.
   00716| fn dialogue(turns: &[(&str, &str)]) -> EventLog {
   00717|     let mut log = EventLog::new();
   00718|     for (role, content) in turns {
   00719|         let kind = if *role == "user" {
   00720|             "prior_turn:user"
   00721|         } else {
   00722|             "prior_turn:assistant"
   00723|         };
   00724|         log.append(kind, (*content).to_owned());
   00725|     }
   00726|     log
   00727| }
