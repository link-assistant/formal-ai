   00911| // Issue #1175 R3, follow-up round: a handler that answered without its input
   00912| // records a named refusal event there and is admitted to the refusal lane;
   00913| // the assistant is the subject of a question that addresses it or names no
   00914| // other subject. Mirrored by `rust/tests/web/issue-1175-claim-routing.test.mjs`.
   00915| #[test]
   00916| fn follow_up_round_handlers_without_their_input_may_only_refuse() {
   00917|     for (handler, bare, full) in [
   00918|         (
   00919|             "algorithm",
   00920|             "Write an algorithm",
   00921|             "Write a sorting algorithm in Python",
   00922|         ),
   00923|         ("proof_request", "Prove it", "Prove that 2 + 2 = 4"),
   00924|         (
   00925|             "translation",
   00926|             "Translate to Russian",
   00927|             "Translate \"apple\" to Russian",
   00928|         ),
   00929|         (
   00930|             "source_refresh",
   00931|             "Refresh the cache",
   00932|             "Refresh the cached page https://example.com/docs",
   00933|         ),
   00934|     ] {
   00935|         assert_eq!(
   00936|             claim_admission(handler, bare, &bare.to_lowercase()),
   00937|             ClaimAdmission::RefusalOnly,
   00938|             "{handler}: {bare}"
   00939|         );
   00940|         assert_eq!(
   00941|             claim_admission(handler, full, &full.to_lowercase()),
   00942|             ClaimAdmission::Full,
   00943|             "{handler}: {full}"
   00944|         );
   00945|     }
   00946|     let reply = dialogue(&[("user", "Delete the logs"), ("assistant", "Deleted.")]);
   00947|     assert_eq!(
   00948|         claim_admission_in_dialogue(
   00949|             "clarification",
   00950|             "I don't understand",
   00951|             "i don't understand",
   00952|             &reply
   00953|         ),
   00954|         ClaimAdmission::Full
   00955|     );
   00956|     assert_eq!(
   00957|         claim_admission("clarification", "I don't understand", "i don't understand"),
   00958|         ClaimAdmission::RefusalOnly
   00959|     );
   00960| }
