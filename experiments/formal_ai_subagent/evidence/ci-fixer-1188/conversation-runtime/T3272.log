   00653| // Issue #1175 R3, refusal group: without its operand a refusal-group handler
   00654| // is admitted to refuse only (the dispatcher keeps its answer only when it
   00655| // recorded the row's refusal event), and with it every answer is admitted.
   00656| #[test]
   00657| fn a_refusal_group_handler_without_its_operand_may_only_refuse() {
   00658|     for (handler, prompt) in [
   00659|         ("test_generation", "Write unit tests"),
   00660|         ("code_refactoring", "Refactor my morning routine"),
   00661|         ("format_conversion", "Convert this JSON to YAML"),
   00662|     ] {
   00663|         assert_eq!(
   00664|             claim_admission(handler, prompt, &prompt.to_lowercase()),
   00665|             ClaimAdmission::RefusalOnly,
   00666|             "{handler}: {prompt}"
   00667|         );
   00668|         assert!(claim_admitted(handler, prompt, &prompt.to_lowercase()));
   00669|     }
   00670|     for (handler, prompt) in [
   00671|         (
   00672|             "test_generation",
   00673|             "Write tests for `square(n)`: square(3) returns 9",
   00674|         ),
   00675|         (
   00676|             "code_refactoring",
   00677|             "Refactor this promise chain with async/await:\n```javascript\nfetch(url).then(r => r.json());\n```",
   00678|         ),
   00679|         (
   00680|             "format_conversion",
   00681|             "Convert this JSON to YAML:\n```json\n{\"a\": 1}\n```",
   00682|         ),
   00683|     ] {
   00684|         assert_eq!(
   00685|             claim_admission(handler, prompt, &prompt.to_lowercase()),
   00686|             ClaimAdmission::Full,
   00687|             "{handler}: {prompt}"
   00688|         );
   00689|     }
   00690|     // A row without a refusal event still denies a prompt without evidence.
   00691|     assert_eq!(
   00692|         claim_admission(
   00693|             "code_review",
   00694|             "Review my essay about the ocean",
   00695|             "review my essay about the ocean"
   00696|         ),
   00697|         ClaimAdmission::Denied
   00698|     );
   00699| }
