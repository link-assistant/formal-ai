   00493| #[test]
   00494| fn a_surface_word_alone_is_not_admitted() {
   00495|     for (handler, prompt) in [
   00496|         (
   00497|             "terminal_command",
   00498|             "Make a 3-day itinerary for a first visit to Rome.",
   00499|         ),
   00500|         (
   00501|             "terminal_command",
   00502|             "Find the bug: def average(xs): return sum(xs) / len(xs)",
   00503|         ),
   00504|         (
   00505|             "software_project",
   00506|             "Write a regex for a US ZIP code with an optional 4-digit extension",
   00507|         ),
   00508|         ("repository_lineage", "Which issue introduced this feature?"),
   00509|         (
   00510|             "page_query_text",
   00511|             "What command builds the jar on this page?",
   00512|         ),
   00513|         ("javascript_execution", "Run this JavaScript"),
   00514|         ("incompatible_units", "What does a unit test check?"),
   00515|         ("http_fetch", "Fetch me a summary of the news"),
   00516|         ("url_navigate", "Navigate the menu to the settings screen"),
   00517|         ("calendar_create_event", "Explain how a calendar works."),
   00518|         ("code_debugging", "Find the bug in my plan for the trip"),
   00519|         ("code_explanation", "Explain how a compiler works"),
   00520|         ("code_review", "Review my essay about the ocean"),
   00521|         ("summarization_text", "Summarize the rust language"),
   00522|         ("text_rewrite", "Make this more formal"),
   00523|         ("statistics", "What is the mean of my test scores?"),
   00524|         ("statistics", "Is this number prime?"),
   00525|         ("word_problem", "How many apples are left if I eat some?"),
   00526|         ("arithmetic", "Explain how long division works"),
   00527|         (
   00528|             "compound_interest",
   00529|             "How does compound interest work when you invest?",
   00530|         ),
   00531|         (
   00532|             "number_constraint_reasoning",
   00533|             "Guess the hidden number I am thinking of",
   00534|         ),
   00535|         ("unit_conversion", "Convert this recipe to metric units"),
   00536|         ("calendar_reasoning", "Explain how a calendar works."),
   00537|     ] {
   00538|         assert!(
   00539|             !claim_admitted(handler, prompt, &prompt.to_lowercase()),
   00540|             "`{handler}` must not be offered `{prompt}`"
   00541|         );
   00542|     }
   00543| }
