   00001| //! Issue #1175 R3: claim routing through the capability table.
   00002| //!
   00003| //! The `claim` rows of `data/seed/capability-routing.lino` are consulted after
   00004| //! formalization and before a handler runs: a handler with a row is offered
   00005| //! the prompt only when one of its `admits_on` evidence kinds holds in the
   00006| //! prompt's structure, so a surface word alone cannot claim it. Mirrored by
   00007| //! `rust/tests/web/issue-1175-claim-routing.test.mjs`.
   00008| 
   00009| use formal_ai::capability_routing::{
   00010|     CLAIM_EVIDENCE_KINDS, ClaimAdmission, ClaimRow, claim_admission, claim_admission_in_dialogue,
   00011|     claim_admitted, claim_evidence_holds, claim_evidence_holds_in_dialogue, claim_rows,
   00012|     claim_rows_from, without_answer_shape_directive,
   00013| };
   00014| use formal_ai::event_log::EventLog;
   00015| 
