   00466| #[test]
   00467| fn every_row_names_a_known_handler_and_known_evidence() {
   00468|     let precedence = formal_ai::seed::handler_precedence();
   00469|     for row in claim_rows() {
   00470|         assert!(
   00471|             row.handler == "terminal_command" || precedence.iter().any(|name| name == &row.handler),
   00472|             "claim row names a handler the precedence table does not: {row:?}"
   00473|         );
   00474|         assert!(
   00475|             !row.admits_on.is_empty(),
   00476|             "a row admits on something: {row:?}"
   00477|         );
   00478|         for kind in &row.admits_on {
   00479|             assert!(
   00480|                 CLAIM_EVIDENCE_KINDS.contains(&kind.as_str()),
   00481|                 "unknown evidence kind `{kind}` in {row:?}"
   00482|             );
   00483|             assert!(claim_evidence_holds(kind, "ls -la", "ls -la").is_some());
   00484|         }
   00485|         assert!(
   00486|             !row.because.is_empty(),
   00487|             "every row states its reason: {row:?}"
   00488|         );
   00489|     }
   00490|     assert_eq!(claim_evidence_holds("surface_word", "ls", "ls"), None);
   00491| }
