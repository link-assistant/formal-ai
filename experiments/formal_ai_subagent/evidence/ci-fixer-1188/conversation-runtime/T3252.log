   00623| fn push_memory_field<'a>(
   00624|     fields: &mut Vec<(&'static str, &'a str)>,
   00625|     name: &'static str,
   00626|     value: Option<&'a str>,
   00627| ) {
   00628|     if let Some(value) = value.filter(|value| !value.trim().is_empty()) {
   00629|         fields.push((name, value));
   00630|     }
   00631| }
