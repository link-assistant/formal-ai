   00159| fn try_recall_name(prompt: &str, normalized: &str, log: &mut EventLog) -> Option<SymbolicAnswer> {
   00160|     let asks_name = normalized.contains("what is my name")
   00161|         || normalized.contains("what's my name")
   00162|         || normalized.contains("do you know my name")
   00163|         || normalized.contains("who am i");
   00164|     if !asks_name {
   00165|         return None;
   00166|     }
   00167|     let name = recall_name_from_history(log, prompt).or_else(|| extract_introduced_name(prompt))?;
   00168|     log.append("filter:user", format!("name={name}"));
   00169|     let body = format!("Your name is {name}.");
   00170|     Some(finalize_simple(
   00171|         prompt,
   00172|         log,
   00173|         "recall_name",
   00174|         "response:recall_name",
   00175|         &body,
   00176|         0.9,
   00177|     ))
   00178| }
