   00595| fn memory_event_field_values(event: &MemoryEvent) -> Vec<(&'static str, &str)> {
   00596|     let mut fields = Vec::new();
   00597|     push_memory_field(&mut fields, "id", Some(event.id.as_str()));
   00598|     push_memory_field(&mut fields, "kind", event.kind.as_deref());
   00599|     push_memory_field(&mut fields, "role", event.role.as_deref());
   00600|     push_memory_field(&mut fields, "intent", event.intent.as_deref());
   00601|     push_memory_field(&mut fields, "tool", event.tool.as_deref());
   00602|     push_memory_field(&mut fields, "inputs", event.inputs.as_deref());
   00603|     push_memory_field(&mut fields, "outputs", event.outputs.as_deref());
   00604|     push_memory_field(&mut fields, "content", event.content.as_deref());
   00605|     push_memory_field(&mut fields, "sentAt", event.sent_at.as_deref());
   00606|     push_memory_field(&mut fields, "demoLabel", event.demo_label.as_deref());
   00607|     push_memory_field(
   00608|         &mut fields,
   00609|         "conversationId",
   00610|         event.conversation_id.as_deref(),
   00611|     );
   00612|     push_memory_field(
   00613|         &mut fields,
   00614|         "conversationTitle",
   00615|         event.conversation_title.as_deref(),
   00616|     );
   00617|     for evidence in &event.evidence {
   00618|         push_memory_field(&mut fields, "evidence", Some(evidence.as_str()));
   00619|     }
   00620|     fields
   00621| }
