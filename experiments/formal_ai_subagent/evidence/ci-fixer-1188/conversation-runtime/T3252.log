   00376| fn try_conversation_recall(
   00377|     prompt: &str,
   00378|     normalized: &str,
   00379|     log: &mut EventLog,
   00380| ) -> Option<SymbolicAnswer> {
   00381|     let query = recognize_recall_query(normalized)?;
   00382|     let matches = recall_matches(log, &query.term);
   00383|     log.append("filter:memory_query", query.term.clone());
   00384|     log.append("filter:memory_scope", query.scope.as_str());
   00385|     log.append("filter:memory_matches", matches.len().to_string());
   00386|     for matched in &matches {
   00387|         log.append(
   00388|             "memory_match",
   00389|             format!(
   00390|                 "turn={} role={} content={}",
   00391|                 matched.turn_index, matched.role, matched.content
   00392|             ),
   00393|         );
   00394|     }
   00395|     let language = detect_language(prompt).slug();
   00396|     let body = render_recall_report(&query, &matches, language);
   00397|     Some(finalize_simple(
   00398|         prompt,
   00399|         log,
   00400|         "conversation_recall",
   00401|         "response:conversation_recall",
   00402|         &body,
   00403|         0.9,
   00404|     ))
   00405| }
