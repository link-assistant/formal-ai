   00268| fn previous_user_request_turn(log: &EventLog) -> Option<String> {
   00269|     let latest_user = last_user_turn(log).map(ToOwned::to_owned);
   00270|     log.events()
   00271|         .iter()
   00272|         .rev()
   00273|         .filter(|event| event.kind == "prior_turn:user")
   00274|         .filter_map(|event| {
   00275|             let content = event.payload.trim();
   00276|             (!content.is_empty()).then_some(content)
   00277|         })
   00278|         .find(|content| !is_recall_meta_prompt(content))
   00279|         .map(ToOwned::to_owned)
   00280|         .or(latest_user)
   00281| }
   00282| 
   00283| fn is_recall_meta_prompt(prompt: &str) -> bool {
   00284|     let normalized = normalize_prompt(prompt);
   00285|     seed::lexicon().mentions_role(
   00286|         seed::ROLE_CONVERSATION_RECALL_PREVIOUS_USER_MESSAGE,
   00287|         &normalized,
   00288|     ) || seed::lexicon().mentions_role(seed::ROLE_CONVERSATION_RECALL_PREVIOUS_MESSAGE, &normalized)
   00289|         || recognize_recall_query(&normalized).is_some()
   00290| }
