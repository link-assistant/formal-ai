   00180| /// Set or recall the *assistant's* name from dialog-local memory (issue #676).
   00181| ///
   00182| /// The assistant advertises "you can name me as you like", but nothing acted on a
   00183| /// follow-up such as "Now your name is Ineffa", so it fell through to the unknown
   00184| /// fallback. This handler closes that loop, statelessly, in the same spirit as
   00185| /// [`try_recall_name`]: when the current turn assigns a name it acknowledges it, and
   00186| /// when a later turn asks "what is your name" it replays the most recent assigned
   00187| /// name from the conversation history. With no name ever set it returns `None` so the
   00188| /// static `assistant_name` answer ("…you can name me as you like") still applies.
   00189| fn try_assistant_name(
   00190|     prompt: &str,
   00191|     _normalized: &str,
   00192|     log: &mut EventLog,
   00193| ) -> Option<SymbolicAnswer> {
   00194|     let language = detect_language(prompt).slug();
   00195|     // A rename in the current turn takes priority — acknowledge it.
   00196|     if let Some(name) = extract_assistant_name(prompt) {
   00197|         log.append("filter:assistant", format!("name={name}"));
   00198|         let body = render_assistant_name_ack(&name, language);
   00199|         return Some(finalize_simple(
   00200|             prompt,
   00201|             log,
   00202|             "set_assistant_name",
   00203|             "response:set_assistant_name",
   00204|             &body,
   00205|             0.9,
   00206|         ));
   00207|     }
   00208|     // Otherwise, an explicit "what is your name" recalls a previously set name.
   00209|     let asks_name =
   00210|         formalize_intent(prompt, language, None).route.as_deref() == Some("assistant_name");
   00211|     if !asks_name {
   00212|         return None;
   00213|     }
   00214|     let name = recall_assistant_name_from_history(log, prompt)?;
   00215|     log.append("filter:assistant", format!("name={name}"));
   00216|     let body = render_assistant_name_recall(&name, language);
   00217|     Some(finalize_simple(
   00218|         prompt,
   00219|         log,
   00220|         "assistant_name",
   00221|         "response:assistant_name",
   00222|         &body,
   00223|         0.9,
   00224|     ))
   00225| }
