   00241| fn try_recall_last_question(
   00242|     prompt: &str,
   00243|     normalized: &str,
   00244|     log: &mut EventLog,
   00245| ) -> Option<SymbolicAnswer> {
   00246|     let cleaned = normalize_prompt(normalized);
   00247|     let asks = seed::lexicon().mentions_role(
   00248|         seed::ROLE_CONVERSATION_RECALL_PREVIOUS_USER_MESSAGE,
   00249|         &cleaned,
   00250|     );
   00251|     if !asks {
   00252|         return None;
   00253|     }
   00254|     let previous = previous_user_request_turn(log)?;
   00255|     let language = detect_language(prompt).slug();
   00256|     let body = render_previous_user_message(&previous, language);
   00257|     log.append("filter:user", "previous_turn".to_owned());
   00258|     Some(finalize_simple(
   00259|         prompt,
   00260|         log,
   00261|         "recall_last_question",
   00262|         "response:recall_last_question",
   00263|         &body,
   00264|         0.9,
   00265|     ))
   00266| }
