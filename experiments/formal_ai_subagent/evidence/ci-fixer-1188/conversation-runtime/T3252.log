   00138| /// Indices of the store events a recall for this prompt reads.
   00139| fn recalled_event_indices(
   00140|     normalized: &str,
   00141|     events: &[MemoryEvent],
   00142|     current_conversation_id: Option<&str>,
   00143|     prompt: &str,
   00144| ) -> Vec<usize> {
   00145|     let Some(query) = recognize_recall_query(normalized) else {
   00146|         return Vec::new();
   00147|     };
   00148|     let mut indices: Vec<usize> =
   00149|         memory_recall_matches(events, &query, current_conversation_id, prompt)
   00150|             .iter()
   00151|             // `event_index` is 1-based for display; the store slice is 0-based.
   00152|             .map(|matched| matched.event_index.saturating_sub(1))
   00153|             .collect();
   00154|     indices.sort_unstable();
   00155|     indices.dedup();
   00156|     indices
   00157| }
