   00343| /// Localize the role of a recalled message ("user"/"assistant").
   00344| fn localized_role(role: &str, language: &str) -> &'static str {
   00345|     match (role, language) {
   00346|         ("assistant", "ru") => "ассистент",
   00347|         ("assistant", "hi") => "सहायक",
   00348|         ("assistant", "zh") => "助手",
   00349|         ("assistant", _) => "assistant",
   00350|         (_, "ru") => "пользователь",
   00351|         (_, "hi") => "उपयोगकर्ता",
   00352|         (_, "zh") => "用户",
   00353|         (_, _) => "user",
   00354|     }
   00355| }
   00356| 
   00357| fn render_previous_message(role: &str, content: &str, language: &str) -> String {
   00358|     let role_label = localized_role(role, language);
   00359|     match language {
   00360|         "ru" => format!("В прошлом сообщении ({role_label}) было написано: \"{content}\""),
   00361|         "zh" => format!("上一条消息（{role_label}）写道:\"{content}\""),
   00362|         "hi" => format!("पिछले संदेश ({role_label}) में लिखा था: \"{content}\""),
   00363|         _ => format!("The previous message ({role_label}) was: \"{content}\""),
   00364|     }
   00365| }
   00366| 
   00367| fn render_no_previous_message(language: &str) -> String {
   00368|     match language {
   00369|         "ru" => String::from("Прошлого сообщения пока нет."),
   00370|         "zh" => String::from("还没有上一条消息。"),
   00371|         "hi" => String::from("अभी तक कोई पिछला संदेश नहीं है."),
   00372|         _ => String::from("There is no previous message yet."),
   00373|     }
   00374| }
