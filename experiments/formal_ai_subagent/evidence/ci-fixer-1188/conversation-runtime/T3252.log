   00449| /// Whether the request names a term to recall from the conversation.
   00450| ///
   00451| /// The `recall_query_term` claim evidence of issue #1175 R3.
   00452| #[must_use]
   00453| pub fn names_recall_query(normalized: &str) -> bool {
   00454|     recognize_recall_query(normalized).is_some()
   00455| }
   00456| 
   00457| fn recognize_recall_query(normalized: &str) -> Option<RecallQuery> {
   00458|     recall_term_for_role(seed::ROLE_CONVERSATION_RECALL_QUERY, normalized)
   00459|         .map(|term| RecallQuery {
   00460|             term,
   00461|             scope: RecallScope::Conversation,
   00462|         })
   00463|         .or_else(|| {
   00464|             recall_term_for_role(seed::ROLE_CONVERSATION_RECALL_OTHER_QUERY, normalized).map(
   00465|                 |term| RecallQuery {
   00466|                     term,
   00467|                     scope: RecallScope::OtherConversations,
   00468|                 },
   00469|             )
   00470|         })
   00471| }
   00472| 
   00473| fn recall_term_for_role(role: &str, normalized: &str) -> Option<String> {
   00474|     seed::lexicon()
   00475|         .role_word_forms(role)
   00476|         .iter()
   00477|         .filter_map(|form| term_from_form(form, normalized))
   00478|         .find(|term| !term.is_empty())
   00479| }
   00480| 
   00481| fn term_from_form(form: &WordForm, normalized: &str) -> Option<String> {
   00482|     let raw = match form.slot() {
   00483|         Slot::Prefix => normalized.strip_prefix(form.before_slot())?,
   00484|         Slot::Suffix => normalized.strip_suffix(form.after_slot())?,
   00485|         Slot::Circumfix => normalized
   00486|             .strip_prefix(form.before_slot())?
   00487|             .strip_suffix(form.after_slot())?,
   00488|         Slot::Bare => return None,
   00489|     };
   00490|     clean_recall_term(raw)
   00491| }
   00492| 
   00493| fn clean_recall_term(raw: &str) -> Option<String> {
   00494|     let term = raw
   00495|         .trim()
   00496|         .trim_matches(|ch: char| {
   00497|             ch.is_whitespace()
   00498|                 || matches!(
   00499|                     ch,
   00500|                     '`' | '"' | '\'' | ':' | '-' | '_' | '.' | ',' | '?' | '!' | '(' | ')'
   00501|                 )
   00502|         })
   00503|         .split_whitespace()
   00504|         .collect::<Vec<_>>()
   00505|         .join(" ");
   00506|     (!term.is_empty()).then_some(term)
   00507| }
   00508| 
   00509| fn recall_matches(log: &EventLog, term: &str) -> Vec<RecallMatch> {
   00510|     let needle = normalize_prompt(term);
   00511|     if needle.is_empty() {
   00512|         return Vec::new();
   00513|     }
   00514|     log.events()
   00515|         .iter()
   00516|         .enumerate()
   00517|         .filter_map(|(index, event)| {
   00518|             let role = match event.kind {
   00519|                 "prior_turn:user" => "user",
   00520|                 "prior_turn:assistant" => "assistant",
   00521|                 _ => return None,
   00522|             };
   00523|             let haystack = normalize_prompt(&event.payload);
   00524|             haystack.contains(&needle).then(|| RecallMatch {
   00525|                 turn_index: index + 1,
   00526|                 role,
   00527|                 content: event.payload.clone(),
   00528|             })
   00529|         })
   00530|         .collect()
   00531| }
   00532| 
   00533| fn memory_recall_matches(
   00534|     events: &[MemoryEvent],
   00535|     query: &RecallQuery,
   00536|     current_conversation_id: Option<&str>,
   00537|     trigger_text: &str,
   00538| ) -> Vec<MemoryRecallMatch> {
   00539|     let needle = normalize_prompt(&query.term);
   00540|     if needle.is_empty() {
   00541|         return Vec::new();
   00542|     }
   00543|     let trigger = normalize_prompt(trigger_text);
   00544|     let mut matches = Vec::new();
   00545|     for (index, event) in events.iter().enumerate() {
   00546|         if !event_in_recall_scope(event, query, current_conversation_id) {
   00547|             continue;
   00548|         }
   00549|         for (name, value) in memory_event_field_values(event) {
   00550|             let value = value.trim();
   00551|             if value.is_empty() {
   00552|                 continue;
   00553|             }
   00554|             let haystack = normalize_prompt(value);
   00555|             if !haystack.contains(&needle) {
   00556|                 continue;
   00557|             }
   00558|             if name == "content" && !trigger.is_empty() && haystack == trigger {
   00559|                 continue;
   00560|             }
   00561|             matches.push(memory_field_match(index, event, name, value));
   00562|         }
   00563|     }
   00564| 
   00565|     for (index, (event, record)) in events
   00566|         .iter()
   00567|         .zip(memory_events_to_link_records(events))
   00568|         .enumerate()
   00569|     {
   00570|         if !event_in_recall_scope(event, query, current_conversation_id) {
   00571|             continue;
   00572|         }
   00573|         for link in record.links {
   00574|             let haystack = normalize_prompt(&format!("{} {}", link.from, link.to));
   00575|             if !haystack.contains(&needle) {
   00576|                 continue;
   00577|             }
   00578|             matches.push(memory_link_match(index, event, &link.from, &link.to));
   00579|         }
   00580|     }
   00581| 
   00582|     matches
   00583| }
