   00407| fn try_memory_recall(
   00408|     prompt: &str,
   00409|     normalized: &str,
   00410|     events: &[MemoryEvent],
   00411|     current_conversation_id: Option<&str>,
   00412|     log: &mut EventLog,
   00413| ) -> Option<SymbolicAnswer> {
   00414|     let query = recognize_recall_query(normalized)?;
   00415|     let matches = memory_recall_matches(events, &query, current_conversation_id, prompt);
   00416|     let conversation_count = memory_conversation_count(&matches);
   00417|     log.append("filter:memory_query", query.term.clone());
   00418|     log.append("filter:memory_scope", query.scope.as_str());
   00419|     log.append("filter:memory_matches", matches.len().to_string());
   00420|     log.append(
   00421|         "filter:memory_conversations",
   00422|         conversation_count.to_string(),
   00423|     );
   00424|     for matched in &matches {
   00425|         log.append(
   00426|             "memory_match",
   00427|             format!(
   00428|                 "event={} conversation={} title={} role={} {}",
   00429|                 matched.event_index,
   00430|                 matched.conversation_id,
   00431|                 matched.conversation_title,
   00432|                 matched.role,
   00433|                 matched.log_fragment()
   00434|             ),
   00435|         );
   00436|     }
   00437|     let language = detect_language(prompt).slug();
   00438|     let body = render_memory_recall_report(&query, &matches, language);
   00439|     Some(finalize_simple(
   00440|         prompt,
   00441|         log,
   00442|         "conversation_recall",
   00443|         "response:conversation_recall",
   00444|         &body,
   00445|         0.9,
   00446|     ))
   00447| }
