   00585| fn event_in_recall_scope(
   00586|     event: &MemoryEvent,
   00587|     query: &RecallQuery,
   00588|     current_conversation_id: Option<&str>,
   00589| ) -> bool {
   00590|     let conversation_id = event.conversation_id.as_deref().unwrap_or("legacy");
   00591|     query.scope != RecallScope::OtherConversations
   00592|         || current_conversation_id.is_none_or(|current| current != conversation_id)
   00593| }
