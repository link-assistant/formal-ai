   00301| /// Recall the content of the immediately preceding message (issue #529).
   00302| ///
   00303| /// Recognizes language-agnostic "what was written in the previous message?"
   00304| /// phrasings via the `conversation_recall_previous_message` seed role and
   00305| /// replays the last prior turn regardless of role. Unlike
   00306| /// [`try_recall_last_question`], which returns the user's own last question,
   00307| /// this returns whatever message came immediately before the current prompt —
   00308| /// for the issue's scenario, the assistant's previous reply.
   00309| fn try_recall_previous_message(
   00310|     prompt: &str,
   00311|     normalized: &str,
   00312|     log: &mut EventLog,
   00313| ) -> Option<SymbolicAnswer> {
   00314|     if !seed::lexicon().mentions_role(
   00315|         seed::ROLE_CONVERSATION_RECALL_PREVIOUS_MESSAGE,
   00316|         &normalize_prompt(normalized),
   00317|     ) {
   00318|         return None;
   00319|     }
   00320|     let language = detect_language(prompt).slug();
   00321|     let previous = last_turn(log).map(|(role, content)| (role, content.to_owned()));
   00322|     let body = if let Some((role, content)) = previous {
   00323|         log.append("filter:user", format!("previous_message role={role}"));
   00324|         render_previous_message(role, &content, language)
   00325|     } else {
   00326|         log.append("filter:user", "previous_message:none".to_owned());
   00327|         log.append(
   00328|             "conversation_recall:refusal",
   00329|             "no previous message".to_owned(),
   00330|         );
   00331|         render_no_previous_message(language)
   00332|     };
   00333|     Some(finalize_simple(
   00334|         prompt,
   00335|         log,
   00336|         "recall_previous_message",
   00337|         "response:recall_previous_message",
   00338|         &body,
   00339|         0.9,
   00340|     ))
   00341| }
