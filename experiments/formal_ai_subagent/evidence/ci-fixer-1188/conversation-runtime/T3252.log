   00086|     if let Some(answer) = try_recall_name(prompt, normalized, log) {
   00087|         return Some(answer);
   00088|     }
   00089|     if let Some(answer) = try_recall_last_question(prompt, normalized, log) {
   00090|         return Some(answer);
   00091|     }
   00092|     if let Some(answer) = try_recall_previous_message(prompt, normalized, log) {
   00093|         return Some(answer);
   00094|     }
   00095|     if let Some(answer) = try_conversation_recall(prompt, normalized, log) {
   00096|         return Some(answer);
   00097|     }
   00098|     if let Some(answer) = try_summarize_conversation(prompt, normalized, log) {
   00099|         return Some(answer);
   00100|     }
   00101|     None
   00102| }
