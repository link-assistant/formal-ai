   00292| fn render_previous_user_message(content: &str, language: &str) -> String {
   00293|     match language {
   00294|         "ru" => format!("Вы спрашивали: \"{content}\""),
   00295|         "zh" => format!("你之前问的是:\"{content}\""),
   00296|         "hi" => format!("आपने पूछा था: \"{content}\""),
   00297|         _ => format!("Your previous question was: {content}"),
   00298|     }
   00299| }
