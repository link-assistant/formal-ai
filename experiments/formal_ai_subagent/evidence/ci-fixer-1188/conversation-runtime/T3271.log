   00214| test("R1175-3 refusal lane: a cued request without its operand keeps only its named refusal", async () => {
   00215|   await seeded;
   00216|   const admission = (handler, prompt) => plain(evaluate(worker, `claimRouteAdmission(${JSON.stringify(handler)}, ${JSON.stringify(prompt)})`));
   00217|   // Without the operand the handler is admitted to refuse only.
   00218|   assert.equal(await admission("tryTestGeneration", "Write unit tests"), "refusal");
   00219|   assert.equal(await admission("tryCodeRefactoring", "Refactor my morning routine"), "refusal");
   00220|   assert.equal(await admission("tryFormatConversion", "Convert this JSON to YAML"), "refusal");
   00221|   // With it, every answer the handler gives is admitted.
   00222|   assert.equal(await admission("tryTestGeneration", "Write tests for `square(n)`: square(3) returns 9"), "full");
   00223|   assert.equal(await admission("tryCodeRefactoring", "Refactor this promise chain with async/await:\n```javascript\nfetch(url).then(r => r.json());\n```"), "full");
   00224|   assert.equal(await admission("tryFormatConversion", "Convert this JSON to YAML:\n```json\n{\"a\": 1}\n```"), "full");
   00225|   // A refusal recorded by the handler stands; an answer without one is dropped.
   00226|   const refused = (handler, hit) => plain(evaluate(worker, `claimRouteRefused(${JSON.stringify(handler)}, ${JSON.stringify(hit)})`));
   00227|   assert.equal(await refused("tryTestGeneration", { evidence: ["test_generation:request:cued", "test_generation:refusal:function=none"] }), true);
   00228|   assert.equal(await refused("tryTestGeneration", { evidence: ["test_generation:request:cued", "test_generation:suite:case=3"] }), false);
   00229|   // End to end the named refusal is still the answer.
   00230|   const answer = plain(await evaluate(worker, "solve(\"Write unit tests\", [], {}, {}, [], {})"));
   00231|   assert.equal(answer.intent, "test_generation", JSON.stringify(answer));
   00232|   assert.ok(answer.content.startsWith("Recognized a test-writing request, but no function under test could be identified"), answer.content);
   00233| });
