   00242| // Issue #1175 R3 classes (b), (c) and (e): a follow-up admits on the earlier
   00243| // turn it continues, a composer on its specification (without one it is
   00244| // admitted to its refusal lane), a lookup or policy on its subject or shape.
   00245| async function evidenceIn(kind, prompt, history = []) {
   00246|   await seeded;
   00247|   return plain(evaluate(worker, `claimEvidence()[${JSON.stringify(kind)}](${JSON.stringify(prompt)}, normalizePrompt(${JSON.stringify(prompt)}), ${JSON.stringify(history)})`));
   00248| }
