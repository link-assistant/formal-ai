   00119| test("every row names browser functions and evidence kinds the worker knows", async () => {
   00120|   await seeded;
   00121|   const unknown = plain(evaluate(worker, `claimRouteRows().flatMap((row) => [
   00122|     ...row.admitsOn.filter((kind) => typeof claimEvidence()[kind] !== "function"),
   00123|     ...(row.browserHandler && typeof self[row.browserHandler] !== "function"
   00124|       && !browserHandlerPrecedence().some((record) => record.name === row.browserHandler && (record.contextBinding || record.ruleSet))
   00125|       ? [row.browserHandler] : []),
   00126|   ])`));
   00127|   assert.deepEqual(unknown, []);
   00128| });
