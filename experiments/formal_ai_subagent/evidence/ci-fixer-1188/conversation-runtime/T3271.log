   00192| // The numeric rows must not change an admitted answer: each handler, run on
   00193| // its own probes, answers only where its row admits (and the one-number
   00194| // primality question still reaches statistics).
   00195| test("a numeric handler answers only where its row admits", async () => {
   00196|   await seeded;
   00197|   const answered = plain(evaluate(worker, `[
   00198|     ["tryStatistics", "Is 97 a prime number?"], ["tryStatistics", "What is the mean of my test scores?"],
   00199|     ["tryUnitConversion", "How many meters are in 3 km?"], ["tryUnitConversion", "Convert this recipe to metric units"],
   00200|     ["tryCalendarReasoning", "What day comes after Monday?"], ["tryCalendarReasoning", "Explain how a calendar works."],
   00201|   ].map(([name, prompt]) => {
   00202|     const normalized = normalizePrompt(prompt);
   00203|     const hit = self[name](prompt, normalized, detectLanguage(prompt));
   00204|     return [Boolean(hit), claimRouteAdmits(name, prompt, normalized)];
   00205|   })`));
   00206|   assert.deepEqual(answered, [[true, true], [false, false], [true, true], [false, false], [true, true], [false, false]]);
   00207| });
