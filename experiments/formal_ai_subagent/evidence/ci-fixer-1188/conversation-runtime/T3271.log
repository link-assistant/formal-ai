   00250| test("R1175-3 class b: the dialogue evidence reads the earlier turns, never the prompt alone", async () => {
   00251|   const research = [{ role: "user", content: "Research the best laptops for programming" }, { role: "assistant", content: "Here is what I found." }];
   00252|   assert.equal(await evidenceIn("prior_research_request", "What is the result?", research), true);
   00253|   assert.equal(await evidenceIn("prior_research_request", "What is the result?"), false);
