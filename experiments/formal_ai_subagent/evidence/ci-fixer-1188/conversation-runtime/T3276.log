   00042| /**
   00043|  * The topic of a prior assistant reply: the term before "(" on its first line
   00044|  * ("Term (category): …"), else its first capitalised token of two or more
   00045|  * bytes that is not a topic_scan_stop_word. Mirrors extract_topic_from_prior_reply.
   00046|  * @param {string} reply
   00047|  * @returns {string|null}
   00048|  */
   00049| function howItWorksPriorTopic(reply) {
   00050|   const firstLine = String(reply).split(/\r?\n/u)[0].trim();
   00051|   const paren = firstLine.indexOf("(");
   00052|   if (paren >= 0 && firstLine.slice(0, paren).trim()) return firstLine.slice(0, paren).trim().toLowerCase();
   00053|   const stopWords = roleWordForms("topic_scan_stop_word").map((form) => form.text);
   00054|   for (const word of String(reply).split(/\s+/u).filter(Boolean)) {
   00055|     const clean = word.replace(/^[^\p{Alphabetic}\p{N}]+|[^\p{Alphabetic}\p{N}]+$/gu, "");
   00056|     if (new TextEncoder().encode(clean).length < 2 || !/^\p{Uppercase}/u.test(clean)) continue;
   00057|     if (!stopWords.includes(clean.toLowerCase())) return clean.toLowerCase();
   00058|   }
   00059|   return null;
   00060| }
