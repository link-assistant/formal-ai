   00008|  * @returns {object}
   00009|  */
   00010| function howItWorksFromHistory(prompt, history) {
   00011|   const solverEvents = [{ kind: "followup:how_it_works", payload: normalizePrompt(prompt) }];
   00012|   const prior = lastHistoryTurn(history, "assistant");
   00013|   if (prior) solverEvents.push({ kind: "followup:prior_turn", payload: "assistant" });
   00014|   const term = prior ? howItWorksPriorTopic(prior) : null;
   00015|   if (term) {
   00016|     const concept = tryConceptLookup(howPolicy("how_it_works", "concept-query", { term }));
   00017|     if (concept) {
   00018|       concept.evidence = [`followup:subject:prior_reply:${term}`, ...concept.evidence];
   00019|       concept.solverEvents = [
   00020|         ...solverEvents, { kind: "followup:subject", payload: `prior_reply:${term}` },
   00021|         ...(Array.isArray(concept.solverEvents) ? concept.solverEvents : []),
   00022|       ];
   00023|       return concept;
   00024|     }
   00025|     return {
   00026|       intent: "concept_elaboration_missing",
   00027|       content: nativeLaneRender(answerFor("how_it_works_prior_topic", "en"), { term }),
   00028|       confidence: 0.3,
   00029|       solverEvents: [...solverEvents, { kind: "followup:subject", payload: `prior_reply_no_record:${term}` }],
   00030|       evidence: ["followup:prior_turn:assistant", `followup:subject:prior_reply_no_record:${term}`, "response:concept_elaboration_missing"],
   00031|     };
   00032|   }
   00033|   return {
