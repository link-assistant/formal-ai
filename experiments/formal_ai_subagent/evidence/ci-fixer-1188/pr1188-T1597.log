   00226|         return None;
   00227|     }
   00228|     let indices: Vec<usize> = (0..literals.len()).collect();
   00229|     let anchor_at = governed_literal(&positions, &literals, &indices)?;
   00230|     let context_at = if contexts.is_empty() {
   00231|         None
   00232|     } else {
