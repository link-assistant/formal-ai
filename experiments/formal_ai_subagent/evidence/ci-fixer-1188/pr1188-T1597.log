   00273|         target: String::new(),
   00274|         anchor: unescape_prose_newlines(&literals[anchor_at].text),
   00275|         inserted,
   00276|         after,
   00277|         context: context_at.map(|index| unescape_prose_newlines(&literals[index].text)),
   00278|         rebase: None,
   00279|         spans: false,
   00280|     };
