   00346| /// The seeded role of the words that name the line an anchor follows.
   00347| const ANCHOR_CONTEXT_CUE: &str = "file_edit_anchor_context_cue";
   00348| /// The seeded role of the words that join listed lines or clauses.
   00349| const JOINER_CUE: &str = "file_edit_joiner_cue";
   00350| 
   00351| /// The literal a seeded anchor context names, and the span naming it.
   00352| ///
   00353| /// `that follows 'z'`: `(start, end, text)`, the span from the cue through the
   00354| /// literal (the literal through the cue, in a postpositional language).
   00355| pub(super) fn anchor_context(sentence: &str) -> Option<(usize, usize, String)> {
   00356|     let contexts = cue_occurrences(sentence, ANCHOR_CONTEXT_CUE);
   00357|     if contexts.is_empty() {
   00358|         return None;
   00359|     }
   00360|     let literals = quoted_literals(sentence);
   00361|     let indices: Vec<usize> = (0..literals.len()).collect();
   00362|     let literal = &literals[governed_literal(&contexts, &literals, &indices)?];
   00363|     // The cue that governs the literal: the nearest on its language's side.
   00364|     let (cue_start, cue_end, postpositional) = contexts
   00365|         .iter()
   00366|         .copied()
   00367|         .filter_map(|cue @ (cue_start, cue_end, postpositional)| {
   00368|             let distance = if postpositional {
   00369|                 cue_start.checked_sub(literal.end)
   00370|             } else {
   00371|                 literal.start.checked_sub(cue_end)
   00372|             };
   00373|             distance.map(|distance| (distance, cue))
   00374|         })
   00375|         .min_by_key(|(distance, _)| *distance)?
   00376|         .1;
   00377|     let (start, end) = if postpositional {
   00378|         (literal.start, cue_end)
   00379|     } else {
   00380|         (cue_start, literal.end)
   00381|     };
   00382|     Some((start, end, unescape_prose_newlines(&literal.text)))
   00383| }
