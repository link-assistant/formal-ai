   00156|         &quoted_segment_spans(sentence)
   00157|             .iter()
   00158|             .rev()
   00159|             .fold(sentence.to_owned(), |text, segment| {
   00160|                 [&text[..segment.start], " ", &text[segment.end..]].concat()
   00161|             }),
   00162|     );
   00163|     let after = lexicon.mentions_role(seed::ROLE_FILE_EDIT_POSITION_AFTER, &outside);
   00164|     let before = lexicon.mentions_role(seed::ROLE_FILE_EDIT_POSITION_BEFORE, &outside);
   00165|     if after == before || !lexicon.mentions_role(seed::ROLE_CODING_MEMBER_ADD_ACTION, &normalized) {
   00166|         return None;
   00167|     }
   00168|     let target = named_paths(sentence).first().map(|path| (*path).to_owned());
   00169|     let literals: Vec<QuotedLiteral> = quoted_literals(sentence)
   00170|         .into_iter()
   00171|         .filter(|literal| target.as_deref() != Some(literal.text.as_str()))
   00172|         .collect();
   00173|     let contexts = cue_occurrences(sentence, ANCHOR_CONTEXT_CUE);
   00174|     let role = if after {
   00175|         seed::ROLE_FILE_EDIT_POSITION_AFTER
   00176|     } else {
   00177|         seed::ROLE_FILE_EDIT_POSITION_BEFORE
   00178|     };
   00179|     // A position word inside the context cue ("के बाद आने वाली") is the
   00180|     // context's, not the anchor's.
   00181|     let positions: Vec<CueOccurrence> = cue_occurrences(sentence, role)
   00182|         .into_iter()
   00183|         .filter(|&(start, _, _)| {
   00184|             !contexts
   00185|                 .iter()
   00186|                 .any(|&(from, to, _)| start >= from && start < to)
   00187|         })
   00188|         .collect();
