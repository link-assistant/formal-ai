   00287| /// The workspace paths `sentence` names, in order.
   00288| ///
   00289| /// Those it leaves unquoted, or, when it leaves none, the quoted literals that
   00290| /// are exactly one path. In `Insert the line 'foo' after the line
   00291| /// 'js/ocr.bundle.js' in paths.txt.` the quoted path is the anchor and
   00292| /// `paths.txt` the file (PR #1188 G21).
   00293| fn named_paths(sentence: &str) -> Vec<&str> {
   00294|     let segments = quoted_segment_spans(sentence);
   00295|     let paths: Vec<(bool, &str)> = unquoted_path_tokens(sentence)
   00296|         .iter()
   00297|         .map(|token| {
   00298|             let quoted = segments
   00299|                 .iter()
   00300|                 .any(|segment| token.start < segment.end && token.end > segment.start);
   00301|             (quoted, clean_path_token(token.text))
   00302|         })
   00303|         .filter(|(_, path)| looks_like_file_path(path) && safe_relative_path(path))
   00304|         .collect();
   00305|     let bare = paths.iter().any(|(quoted, _)| !quoted);
   00306|     paths
   00307|         .into_iter()
   00308|         .filter(|(quoted, _)| !bare || !quoted)
   00309|         .map(|(_, path)| path)
   00310|         .collect()
   00311| }
