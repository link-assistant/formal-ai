   00194|         block_text.is_none() && contexts.is_empty() && lexicon.mentions_role(BLANK_LINE, &outside);
   00195|     if let Some(text) = block_text
   00196|         && literals.is_empty()
   00197|     {
   00198|         return unquoted_anchor::unquoted_anchor_insert(
   00199|             sentence, &positions, &contexts, target, text, after,
   00200|         );
   00201|     }
   00202|     if let Some(text) = block_text.or_else(|| blank.then_some("")) {
   00203|         let (anchor_at, context_at) = match (literals.len(), contexts.is_empty()) {
   00204|             // A context cue then names no second line: `the following lines`
   00205|             // speaks of the block (G16).
   00206|             (1, _) => (0, None),
