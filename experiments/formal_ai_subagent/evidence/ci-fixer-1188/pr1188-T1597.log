   00385| /// The request cut into insert clauses.
   00386| ///
   00387| /// A cut falls before every repeated add action that a seeded joiner or a
   00388| /// clause mark leads -- after it, in a postpositional language, whose verb
   00389| /// closes its clause.
   00390| fn insert_clauses(request: &str) -> Vec<&str> {
   00391|     let segments = quoted_segment_spans(request);
   00392|     let toks = tokens(request);
   00393|     let quoted = |token: &super::write_request::Token<'_>| {
   00394|         segments
   00395|             .iter()
   00396|             .any(|segment| token.start < segment.end && token.end > segment.start)
   00397|     };
   00398|     let joiners = bare_surfaces(JOINER_CUE);
   00399|     let joins = |token: Option<&super::write_request::Token<'_>>| {
   00400|         token.is_some_and(|token| !quoted(token) && joiners.contains(&clean_cue_token(token.text)))
   00401|     };
   00402|     let closes =
   00403|         |token: &super::write_request::Token<'_>| token.text.ends_with([',', ';', '\u{0964}']);
   00404|     let mut actions: Vec<(String, bool)> = Vec::new();
   00405|     for meaning in seed::lexicon().meanings_with_role(seed::ROLE_CODING_MEMBER_ADD_ACTION) {
   00406|         for lexeme in &meaning.lexemes {
   00407|             let postpositional = crate::language::uses_postpositions(&lexeme.language);
   00408|             for word in &lexeme.words {
   00409|                 actions.push((word.text.to_lowercase(), postpositional));
   00410|             }
   00411|         }
   00412|     }
   00413|     // Only a repeated action opens a clause: the first one (the last, where the
   00414|     // verb closes its clause) belongs to the clause before it.
   00415|     let verbs: Vec<(usize, bool)> = toks
   00416|         .iter()
   00417|         .enumerate()
   00418|         .filter(|(_, token)| !quoted(token))
   00419|         .filter_map(|(index, token)| {
   00420|             let cleaned = clean_cue_token(token.text);
   00421|             actions
   00422|                 .iter()
   00423|                 .rev()
   00424|                 .find(|(surface, _)| *surface == cleaned)
   00425|                 .map(|&(_, postpositional)| (index, postpositional))
   00426|         })
   00427|         .collect();
   00428|     let mut cuts: Vec<(usize, usize)> = Vec::new();
   00429|     for (at, &(index, postpositional)) in verbs.iter().enumerate() {
   00430|         let token = &toks[index];
   00431|         if !postpositional && at > 0 {
   00432|             let previous = &toks[index - 1];
   00433|             if joins(Some(previous)) {
   00434|                 cuts.push((previous.start, previous.end));
   00435|             } else if closes(previous) {
   00436|                 cuts.push((token.start, token.start));
   00437|             }
   00438|         } else if postpositional && at + 1 < verbs.len() {
   00439|             if joins(toks.get(index + 1)) {
   00440|                 cuts.push((toks[index + 1].start, toks[index + 1].end));
   00441|             } else if closes(token) {
   00442|                 cuts.push((token.end, token.end));
   00443|             }
   00444|         }
   00445|     }
   00446|     let mut clauses = Vec::new();
   00447|     let mut from = 0;
   00448|     for (start, end) in cuts {
   00449|         // Two verbs may claim one joiner; the second claim is already made.
   00450|         if start < from {
   00451|             continue;
   00452|         }
   00453|         clauses.push(&request[from..start]);
   00454|         from = end;
   00455|     }
   00456|     clauses.push(&request[from..]);
   00457|     clauses
   00458|         .into_iter()
   00459|         .map(str::trim)
   00460|         .filter(|clause| !clause.is_empty())
   00461|         .collect()
   00462| }
