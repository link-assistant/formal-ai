   00313| /// `text` with `indentation` before each of its non-empty lines.
   00314| ///
   00315| /// Lines given with their shared indentation removed, set as siblings of a
   00316| /// line indented by `indentation` (PR #1188 G16).
   00317| pub(super) fn rebased_block(text: &str, indentation: &str) -> String {
   00318|     text.split('\n')
   00319|         .map(|line| {
   00320|             if line.is_empty() {
   00321|                 String::new()
   00322|             } else {
   00323|                 [indentation, line].concat()
   00324|             }
   00325|         })
   00326|         .collect::<Vec<_>>()
   00327|         .join("\n")
   00328| }
