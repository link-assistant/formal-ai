   00215|             target: String::new(),
   00216|             anchor: unescape_prose_newlines(&literals[anchor_at].text),
   00217|             inserted: text.to_owned(),
   00218|             after,
   00219|             context: context_at.map(|index| unescape_prose_newlines(&literals[index].text)),
   00220|             rebase: None,
   00221|             spans: false,
   00222|         };
