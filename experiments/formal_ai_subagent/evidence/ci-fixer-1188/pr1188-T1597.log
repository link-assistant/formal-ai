   00097| /// Every insert the request asks for, in its order.
   00098| ///
   00099| /// `None` unless every clause is one. Clauses are the request cut before a
   00100| /// repeated add action that a seeded joiner or a clause mark leads (`…, and
   00101| /// insert …`); a clause that names no file takes the one file the request
   00102| /// names.
   00103| pub(super) fn positional_inserts(request: &str) -> Option<Vec<PositionalInsert>> {
   00104|     // `… after the line 'x':` followed by lines: the first line is the request
   00105|     // and the lines under it are the text inserted, whatever they quote.
   00106|     let block = introduced_block(request);
   00107|     let clauses = block
   00108|         .as_ref()
   00109|         .map_or_else(|| insert_clauses(request), |block| vec![block.head]);
   00110|     let block_text = block.as_ref().map(|block| block.text.as_str());
   00111|     let rebase = block
   00112|         .as_ref()
   00113|         .filter(|block| !block.verbatim)
   00114|         .map(|block| block.indentation.to_owned());
   00115|     let mut inserts = Vec::new();
   00116|     for clause in clauses {
   00117|         let (target, insert) = clause_insert(clause, block_text)?;
   00118|         let rebase = rebase.clone();
   00119|         inserts.push((target, PositionalInsert { rebase, ..insert }));
   00120|     }
   00121|     let mut named: Vec<&str> = Vec::new();
   00122|     for candidate in named_paths(request) {
   00123|         if !named.contains(&candidate) {
   00124|             named.push(candidate);
   00125|         }
   00126|     }
   00127|     inserts
   00128|         .into_iter()
   00129|         .map(|(target, insert)| match (target, named.as_slice()) {
   00130|             (Some(target), _) => Some(PositionalInsert { target, ..insert }),
   00131|             (None, [only]) => Some(PositionalInsert {
   00132|                 target: (*only).to_owned(),
   00133|                 ..insert
   00134|             }),
   00135|             (None, _) => None,
   00136|         })
   00137|         .collect()
   00138| }
