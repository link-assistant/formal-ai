   00464| /// The request's quoted literals other than `target`, one line each.
   00465| ///
   00466| /// Only when there are several and only seeded joiners and commas separate
   00467| /// them (`Append the lines 'a', 'b' to f`, PR #1188 G54); an escape inside
   00468| /// one is content (G53).
   00469| pub(super) fn joined_literal_lines(request: &str, target: &str) -> Option<String> {
   00470|     let literals = quoted_literals(request);
   00471|     let lines: Vec<&QuotedLiteral> = literals
   00472|         .iter()
   00473|         .filter(|literal| literal.text != target)
   00474|         .collect();
   00475|     (lines.len() >= 2 && joined_only(request, &lines)).then(|| {
   00476|         lines
   00477|             .iter()
   00478|             .map(|literal| literal.text.as_str())
   00479|             .collect::<Vec<_>>()
   00480|             .join("\n")
   00481|     })
   00482| }
   00483| 
   00484| /// Whether listed literals are joined only by joiners.
   00485| ///
   00486| /// Consecutive inserted literals may be separated by nothing but whitespace,
   00487| /// commas and seeded joiners (`'a' and 'b'`).
   00488| fn joined_only(sentence: &str, literals: &[&QuotedLiteral]) -> bool {
   00489|     let joiners = bare_surfaces(JOINER_CUE);
   00490|     literals.windows(2).all(|pair| {
   00491|         sentence[pair[0].end..pair[1].start]
   00492|             .split_whitespace()
   00493|             .map(clean_cue_token)
   00494|             .all(|word| word.is_empty() || joiners.contains(&word))
   00495|     })
   00496| }
   00497| 
   00498| /// A cue's byte span in a sentence and whether its language is postpositional.
   00499| type CueOccurrence = (usize, usize, bool);
   00500| 
   00501| /// Every surface of `role` in `sentence` outside its quoted literals.
   00502| ///
   00503| /// Each comes with the side its own language's adposition governs, because
   00504| /// the side a cue governs is a fact of *its* language and a mixed prompt
   00505| /// (`config.yml में … "on:" के बाद`) cannot be trusted to detect as one
   00506| /// (`languages.lino`, `adposition`).
   00507| fn cue_occurrences(sentence: &str, role: &str) -> Vec<CueOccurrence> {
   00508|     let lowered = sentence.to_lowercase();
   00509|     // A cue word inside a quoted literal is payload ("Insert the line «… before
   00510|     // …» after …"), never the position the request asks for.
   00511|     let literals = quoted_literals(sentence);
   00512|     let inside_literal = |start: usize| {
   00513|         literals
   00514|             .iter()
   00515|             .any(|literal| start >= literal.start && start < literal.end)
   00516|     };
   00517|     let mut occurrences = Vec::new();
   00518|     for meaning in seed::lexicon().meanings_with_role(role) {
   00519|         for lexeme in &meaning.lexemes {
   00520|             let postpositional = crate::language::uses_postpositions(&lexeme.language);
   00521|             for word in &lexeme.words {
   00522|                 let surface = word.text.to_lowercase();
   00523|                 if surface.is_empty() {
   00524|                     continue;
   00525|                 }
   00526|                 occurrences.extend(
   00527|                     lowered
   00528|                         .match_indices(surface.as_str())
   00529|                         .filter(|(start, _)| !inside_literal(*start))
   00530|                         .map(|(start, matched)| (start, start + matched.len(), postpositional)),
   00531|                 );
   00532|             }
   00533|         }
   00534|     }
   00535|     occurrences
   00536| }
   00537| 
   00538| /// Which of the `candidates` (literal indices) a cue governs.
   00539| ///
   00540| /// The nearest on the side its language's adposition faces -- a preposition
   00541| /// the literal after it, a postposition the literal before it -- and a later
   00542| /// one on a tie. A cue that occurs only on the far side of every candidate
   00543| /// places none ("… renders "x" before it reads the list" is a time, not a
   00544| /// position: issue #1069); with no cue at all, the last candidate (the
   00545| /// prepositional default).
   00546| fn governed_literal(
   00547|     occurrences: &[CueOccurrence],
   00548|     literals: &[QuotedLiteral],
   00549|     candidates: &[usize],
   00550| ) -> Option<usize> {
   00551|     let gap = |literal: &QuotedLiteral| {
   00552|         occurrences
   00553|             .iter()
   00554|             // `checked_sub` is the guard as well as the arithmetic: a cue on
   00555|             // the wrong side of the literal yields `None` rather than a
   00556|             // subtraction that underflows.
   00557|             .filter_map(|&(cue_start, cue_end, postpositional)| {
   00558|                 if postpositional {
   00559|                     cue_start.checked_sub(literal.end)
   00560|                 } else {
   00561|                     literal.start.checked_sub(cue_end)
   00562|                 }
   00563|             })
   00564|             .min()
   00565|     };
   00566|     let mut governed: Option<(usize, usize)> = None;
   00567|     for &index in candidates {
   00568|         if let Some(distance) = gap(&literals[index])
   00569|             && governed.is_none_or(|(_, nearest)| distance <= nearest)
   00570|         {
   00571|             governed = Some((index, distance));
   00572|         }
   00573|     }
   00574|     governed.map(|(index, _)| index).or_else(|| {
   00575|         candidates
   00576|             .last()
   00577|             .copied()
   00578|             .filter(|_| occurrences.is_empty())
   00579|     })
   00580| }
   00581| 
   00582| /// The lines under a request whose first line ends in a colon.
   00583| pub(super) struct IntroducedBlock<'a> {
   00584|     /// The first line: the request itself.
   00585|     pub(super) head: &'a str,
   00586|     /// The lines, less their shared indentation (or verbatim).
   00587|     pub(super) text: String,
   00588|     /// A fenced block or one quoted literal, kept as written.
   00589|     pub(super) verbatim: bool,
   00590|     /// The indentation the lines shared.
   00591|     pub(super) indentation: &'a str,
   00592| }
   00593| 
   00594| /// Where the instruction of `request` ends.
   00595| ///
   00596| /// At the end of its first line when that line ends in a colon and lines
   00597| /// follow it, since those lines are the payload whatever they say (PR #1188
   00598| /// G94, G95); else at the end of the request (mirrors `instructionEnd`).
   00599| pub(super) fn instruction_end(request: &str) -> usize {
   00600|     introduced_block(request).map_or(request.len(), |block| block.head.len())
   00601| }
   00602| 
   00603| /// A request whose first line ends in a colon and is followed by lines: that
   00604| /// first line, and the lines with their shared indentation removed (one quoted
   00605| /// literal stands for itself; a fenced block keeps its own).
   00606| pub(super) fn introduced_block(request: &str) -> Option<IntroducedBlock<'_>> {
   00607|     let (head, rest) = request.split_once('\n')?;
   00608|     let head = head.trim_end();
   00609|     if !head.ends_with(':') {
   00610|         return None;
   00611|     }
   00612|     let mut lines: Vec<&str> = rest.split('\n').map(str::trim_end).collect();
   00613|     while lines.first().is_some_and(|line| line.is_empty()) {
   00614|         lines.remove(0);
   00615|     }
   00616|     while lines.last().is_some_and(|line| line.is_empty()) {
   00617|         lines.pop();
   00618|     }
   00619|     let indent_of = |line: &str| line.len() - line.trim_start().len();
   00620|     // A fenced block (```` ``` ```` lines around it) is kept as written, less
   00621|     // the fence's own indentation: its indentation is the text's.
   00622|     let fenced = lines.len() >= 2
   00623|         && lines[0].trim_start().starts_with(FENCE)
   00624|         && lines[lines.len() - 1].trim() == FENCE;
   00625|     let (body, shared) = if fenced {
   00626|         (&lines[1..lines.len() - 1], indent_of(lines[0]))
   00627|     } else {
   00628|         let shared = lines
   00629|             .iter()
   00630|             .copied()
   00631|             .filter(|line| !line.is_empty())
   00632|             .map(indent_of)
   00633|             .min()?;
   00634|         (lines.as_slice(), shared)
   00635|     };
   00636|     let text = body
   00637|         .iter()
   00638|         .copied()
   00639|         .map(|line| &line[shared.min(indent_of(line))..])
   00640|         .collect::<Vec<_>>()
   00641|         .join("\n");
   00642|     let quoted = if fenced { None } else { quoted_verbatim(&text) };
   00643|     let verbatim = fenced || quoted.is_some();
   00644|     let indentation = if fenced {
   00645|         ""
   00646|     } else {
   00647|         lines
   00648|             .iter()
   00649|             .find(|line| !line.is_empty())
   00650|             .map_or("", |line| &line[..shared])
   00651|     };
   00652|     Some(IntroducedBlock {
   00653|         head,
   00654|         text: quoted.unwrap_or(text),
   00655|         verbatim,
   00656|         indentation,
   00657|     })
   00658| }
   00659| 
   00660| /// The line that opens and closes a fenced block.
   00661| const FENCE: &str = "```";
   00662| 
   00663| /// One quoted span of a request and where it sits.
   00664| struct QuotedLiteral {
   00665|     start: usize,
   00666|     end: usize,
   00667|     text: String,
   00668| }
   00669| 
   00670| /// The delimited literal slots of `request`, verbatim: a quoted line keeps its
   00671| /// indentation. Every quote pair [`quoted_segment_spans`] reads counts —
   00672| /// `'single'` quotes included — so `Insert 'x' after the line 'y'` places the
   00673| /// line exactly as its double-quoted form does.
   00674| fn quoted_literals(request: &str) -> Vec<QuotedLiteral> {
   00675|     quoted_segment_spans(request)
   00676|         .into_iter()
   00677|         .map(|segment| QuotedLiteral {
   00678|             start: segment.start,
   00679|             end: segment.end,
   00680|             text: segment.text,
   00681|         })
   00682|         .collect()
   00683| }
   00684| 
   00685| /// A span that is one quoted literal, kept byte for byte: the author who
   00686| /// quoted `"  schedule:"` quoted its indentation on purpose (issue #1116).
   00687| fn quoted_verbatim(span: &str) -> Option<String> {
   00688|     let trimmed = span.trim().trim_start_matches([':', '-', '—', '–']).trim();
   00689|     // One quoted literal of any delimiter (single quotes included) is verbatim.
   00690|     if let [segment] = quoted_segment_spans(trimmed).as_slice()
   00691|         && segment.start == 0
   00692|         && segment.end == trimmed.len()
   00693|     {
   00694|         return Some(segment.text.clone());
   00695|     }
   00696|     let mut chars = trimmed.chars();
   00697|     let (first, last) = (chars.next()?, chars.next_back()?);
   00698|     (first == last && matches!(first, '"' | '`') && trimmed.len() >= 2)
   00699|         .then(|| trimmed[1..trimmed.len() - 1].to_owned())
   00700|         .filter(|inner| !inner.contains(first))
   00701| }
   00702| 
   00703| /// The request's tokens outside every quoted literal; a literal that is
   00704| /// exactly one path still names the file (mirrors `unquotedPathTokens`).
   00705| pub(super) fn unquoted_path_tokens(request: &str) -> Vec<super::write_request::Token<'_>> {
   00706|     let segments = quoted_segment_spans(request);
   00707|     tokens(request)
   00708|         .into_iter()
   00709|         .filter(|token| {
   00710|             !segments.iter().any(|segment| {
   00711|                 token.start >= segment.start
   00712|                     && token.end <= segment.end
   00713|                     && clean_path_token(token.text) != segment.text
   00714|             })
   00715|         })
   00716|         .collect()
   00717| }
   00718| 
   00719| /// The words a request says itself.
   00720| ///
   00721| /// The head of an edit request whose lines follow it (the lines are its
   00722| /// payload); otherwise the whole request.
   00723| pub(super) fn own_text(request: &str) -> &str {
   00724|     match introduced_block(request) {
   00725|         Some(block) if names_local_edit(block.head) => block.head,
   00726|         _ => request,
   00727|     }
   00728| }
   00729| 
   00730| /// Whether `task` is an instruction to change a named local file: an edit or
   00731| /// insert action beside a workspace path. Such a request is never a web
   00732| /// question, whatever else the router makes of it (issues #1115, #1133).
   00733| #[must_use]
   00734| pub(super) fn names_local_edit(task: &str) -> bool {
   00735|     let lexicon = seed::lexicon();
   00736|     let normalized = crate::engine::normalize_prompt(task);
   00737|     let edits = lexicon.mentions_role(seed::ROLE_FILE_EDIT_ACTION_CUE, &normalized)
   00738|         || lexicon.mentions_role(seed::ROLE_CODING_MEMBER_ADD_ACTION, &normalized);
   00739|     edits && local_edit_path(task).is_some()
   00740| }
   00741| 
   00742| /// The first workspace path the request names.
   00743| fn local_edit_path(task: &str) -> Option<String> {
   00744|     tokens(task).iter().find_map(|token| {
   00745|         let candidate = clean_path_token(token.text);
   00746|         (looks_like_file_path(candidate) && safe_relative_path(candidate))
   00747|             .then(|| candidate.to_owned())
   00748|     })
   00749| }
   00750| 
   00751| /// The file a request leading with the add verb names when it quotes no text.
   00752| ///
   00753| /// "add hello to config.txt" (PR #1188 G69): its words may be the text or
   00754| /// describe it, so the request earns a question, never a write. In "Create a
   00755| /// test for add in t.mjs" `add` is a name, not the action.
   00756| pub(super) fn unquoted_addition_path(task: &str) -> Option<String> {
   00757|     if !quoted_segment_spans(task).is_empty() {
   00758|         return None;
   00759|     }
   00760|     let normalized = crate::engine::normalize_prompt(task);
   00761|     let lead = normalized.split(' ').next().unwrap_or_default();
   00762|     if !seed::lexicon().mentions_role(seed::ROLE_CODING_MEMBER_ADD_ACTION, lead) {
   00763|         return None;
   00764|     }
   00765|     local_edit_path(task)
   00766| }
   00767| 
   00768| /// A newline an author spelled as `\n` inside prose means a newline in the
   00769| /// file (issue #1116); the edit tool would otherwise write the two characters.
   00770| pub(super) fn unescape_prose_newlines(text: &str) -> String {
   00771|     text.replace("\\n", "\n").replace("\\t", "\t")
   00772| }
   00773| 
   00774| /// One insert as `(start, old, new)` over `source`.
   00775| ///
   00776| /// `old` is the whole lines from the anchor context (or the anchor) through
   00777| /// the anchor, `new` those lines with the inserted text beside the anchor's
   00778| /// line; `None` unless the context (with none, the anchor) occurs once and the
   00779| /// anchor occurs after it.
   00780| fn insert_edit(source: &str, given: &PositionalInsert) -> Option<(usize, String, String, String)> {
   00781|     let resolved = if given.spans {
   00782|         Some(unquoted_anchor::resolved_spans(source, given)?)
   00783|     } else {
   00784|         unquoted_anchor::written_escapes(source, given)
   00785|     };
   00786|     let insert = resolved.as_ref().unwrap_or(given);
   00787|     let anchor = insert.anchor.as_str();
   00788|     let lead = insert.context.as_deref().unwrap_or(anchor);
   00789|     let mut leads: Vec<usize> = source.match_indices(lead).map(|(at, _)| at).collect();
   00790|     // A lead found inside other lines too names the one line it is by itself.
   00791|     if leads.len() > 1 {
   00792|         leads = lone_line_occurrences(source, lead);
   00793|     }
   00794|     let [lead_at]: [usize; 1] = leads.try_into().ok()?;
   00795|     if anchor.is_empty() {
   00796|         return None;
   00797|     }
   00798|     // After a context, a line that is exactly the anchor outranks one that only
   00799|     // contains it (`text set` is not `text setting`).
   00800|     let at = if insert.context.is_some() {
   00801|         let from = lead_at + lead.len();
   00802|         let whole = |index: usize| {
   00803|             (index == 0 || source.as_bytes()[index - 1] == b'\n')
   00804|                 && (anchor.ends_with('\n')
   00805|                     || source
   00806|                         .as_bytes()
   00807|                         .get(index + anchor.len())
   00808|                         .is_none_or(|byte| *byte == b'\n'))
   00809|         };
   00810|         let found: Vec<usize> = source[from..]
   00811|             .match_indices(anchor)
   00812|             .map(|(index, _)| from + index)
   00813|             .collect();
   00814|         found
   00815|             .iter()
   00816|             .copied()
   00817|             .find(|index| whole(*index))
   00818|             .or_else(|| found.first().copied())?
   00819|     } else {
   00820|         lead_at
   00821|     };
   00822|     let line_start = |index: usize| source[..index].rfind('\n').map_or(0, |newline| newline + 1);
   00823|     let start = line_start(lead_at);
   00824|     let tail = at + anchor.len();
   00825|     let end = if anchor.ends_with('\n') {
   00826|         tail - 1
   00827|     } else {
   00828|         source[tail..]
   00829|             .find('\n')
   00830|             .map_or(source.len(), |newline| tail + newline)
   00831|     };
   00832|     let old = &source[start..end];
   00833|     let anchor_line = line_start(at);
   00834|     let inserted = inserted_text(source, anchor_line, insert);
   00835|     let new = if insert.after {
   00836|         [old, "\n", inserted.as_str()].concat()
   00837|     } else {
   00838|         [
   00839|             &source[start..anchor_line],
   00840|             inserted.as_str(),
   00841|             "\n",
   00842|             &source[anchor_line..end],
   00843|         ]
   00844|         .concat()
   00845|     };
   00846|     // The edit tool needs its old text once in the file: a line that also ends
   00847|     // another line (`];`) is widened back over the lines before it (PR #1188 G73).
   00848|     let from = unique_from(source, start, end)?;
   00849|     Some((
   00850|         from,
   00851|         source[from..end].to_owned(),
   00852|         [&source[from..start], new.as_str()].concat(),
   00853|         inserted,
   00854|     ))
   00855| }
   00856| 
   00857| /// Where `text` occurs in `source` as a whole line but for its indentation.
   00858| ///
   00859| /// `the line 'b'` is the line `b`, not the `b` inside `table a`.
   00860| fn lone_line_occurrences(source: &str, text: &str) -> Vec<usize> {
   00861|     source
   00862|         .match_indices(text)
   00863|         .map(|(index, _)| index)
   00864|         .filter(|&index| {
   00865|             let line_start = source[..index].rfind('\n').map_or(0, |newline| newline + 1);
   00866|             let tail = index + text.len();
   00867|             let line_end = source[tail..]
   00868|                 .find('\n')
   00869|                 .map_or(source.len(), |newline| tail + newline);
   00870|             source[line_start..index].trim().is_empty()
   00871|                 && (text.ends_with('\n') || source[tail..line_end].trim().is_empty())
   00872|         })
   00873|         .collect()
   00874| }
   00875| 
   00876| /// The lines an insert puts beside the anchor's line.
   00877| ///
   00878| /// An unfenced block keeps the indentation it was given when the file already
   00879| /// indents lines so (G93, as appended lines do); otherwise it is rebased on
   00880| /// the anchor line's indentation, so it lands as its siblings (PR #1188 G16).
   00881| fn inserted_text(source: &str, anchor_line: usize, insert: &PositionalInsert) -> String {
   00882|     let Some(given) = insert.rebase.as_deref() else {
   00883|         return insert.inserted.clone();
   00884|     };
   00885|     if indents_lines_at(source, given) {
   00886|         return rebased_block(&insert.inserted, given);
   00887|     }
   00888|     let line_end = source[anchor_line..]
   00889|         .find('\n')
   00890|         .map_or(source.len(), |newline| anchor_line + newline);
   00891|     rebased_block(
   00892|         &insert.inserted,
   00893|         leading_indentation(&source[anchor_line..line_end]),
   00894|     )
   00895| }
   00896| 
   00897| /// The sentence stating an insert; an empty line is stated in its own words.
   00898| pub(super) const fn insert_intent(after: bool, inserted: &str) -> &'static str {
   00899|     if inserted.is_empty() {
   00900|         BLANK_LINE
   00901|     } else if after {
   00902|         "file_edit_position_after"
   00903|     } else {
   00904|         "file_edit_position_before"
   00905|     }
   00906| }
   00907| 
   00908| /// Make a request's inserts one anchored edit at a time.
   00909| ///
   00910| /// Each file is read once; each insert is its own anchored edit over the file
   00911| /// as the earlier inserts left it; then every file's digest is checked and
   00912| /// every insert stated.
   00913| pub(super) fn plan_insert_sequence_step(
   00914|     task: &str,
   00915|     current_turn: &[ChatMessage],
   00916|     tool_names: &[&str],
   00917|     inserts: &[PositionalInsert],
   00918| ) -> Option<AgenticPlan> {
   00919|     let edit_tool = tool_for(tool_names, Capability::Edit)?;
   00920|     let mut expected: Vec<(&str, String)> = Vec::new();
   00921|     let mut stated = Vec::new();
   00922|     for insert in inserts {
   00923|         let target = insert.target.as_str();
   00924|         if !expected.iter().any(|(path, _)| *path == target) {
   00925|             let Some(read) = result_for_path(current_turn, Capability::Read, target, None) else {
   00926|                 let tool = tool_for(tool_names, Capability::Read)?;
   00927|                 return Some(plan_one(tool, read_arguments(target)));
   00928|             };
   00929|             expected.push((target, source_from_read_result(&read)));
   00930|         }
   00931|         let index = expected.iter().position(|(path, _)| *path == target)?;
   00932|         let source = expected[index].1.as_str();
   00933|         let Some((start, lines, widened, inserted)) = insert_edit(source, insert) else {
   00934|             // An anchor line found more than once names no one place: the
   00935|             // answer says so instead of a failed verification (PR #1188 G72).
   00936|             if let Some(occurrences) = repeated_anchor_count(source, insert) {
   00937|                 let lead = insert.context.as_deref().unwrap_or(&insert.anchor);
   00938|                 return render_seeded_change(
   00939|                     "file_edit_anchor_repeated",
   00940|                     task,
   00941|                     target,
   00942|                     &[
   00943|                         ("{anchor}", lead.trim_end_matches('\n')),
   00944|                         (COUNT_SLOT, &occurrences.to_string()),
   00945|                     ],
   00946|                 )
   00947|                 .map(AgenticPlan::Final);
   00948|             }
   00949|             return Some(AgenticPlan::Final(render_seeded_outcome(
   00950|                 "coding_workspace_verification_failed",
   00951|                 task,
   00952|                 target,
   00953|             )?));
   00954|         };
   00955|         if result_for_edit(current_turn, target, &lines, &widened).is_none() {
   00956|             return Some(plan_one(
   00957|                 edit_tool,
   00958|                 edit_arguments(target, &lines, &widened),
   00959|             ));
   00960|         }
   00961|         let updated = [
   00962|             &source[..start],
   00963|             widened.as_str(),
   00964|             &source[start + lines.len()..],
   00965|         ]
   00966|         .concat();
   00967|         expected[index].1 = updated;
   00968|         // An empty line beside the lines is stated in its own words (PR #1188
