   00208|                 let anchor_at = governed_literal(&positions, &literals, &[0, 1])?;
   00209|                 let context_at = governed_literal(&contexts, &literals, &[1 - anchor_at])?;
   00210|                 (anchor_at, Some(context_at))
   00211|             }
   00212|             _ => return None,
   00213|         };
