   00031| /** The longest recipe the seed declares is six steps; twelve is a runaway. */
   00032| const MAX_PLAN_STEPS = 12;
   00033| 
   00034| /**
   00035|  * The shell command the agentic planner resolves for `prompt`, or null. A
   00036|  * verified recipe (issue #944) is driven to its end with every step succeeding
   00037|  * and its mutating action picked out, as the Rust `shell_command` helper does;
   00038|  * a single read-only command is returned as planned.
   00039|  */
   00040| async function shellCommand(prompt) {
   00041|   const messages = [{ role: 'user', content: prompt }];
   00042|   const commands = [];
   00043|   while (commands.length <= MAX_PLAN_STEPS) {
   00044|     const plan = await planner.planChatStep(messages, ['exec_command']);
   00045|     if (!plan || plan.kind !== 'tool_calls') break;
   00046|     const call = plan.calls[0];
   00047|     const command = JSON.parse(call.arguments).command;
   00048|     if (!command) break;
   00049|     const id = `call_${messages.length}`;
   00050|     messages.push({ role: 'assistant', content: '', tool_calls: [{ id, type: 'function', function: { name: call.tool, arguments: call.arguments } }] });
   00051|     messages.push({ role: 'tool', tool_call_id: id, name: call.tool, content: `Command: ${command}\nOutput: (empty)\nExit Code: 0` });
   00052|     commands.push(command);
   00053|     // A read-only command is the whole plan; only a recipe opens with a check.
   00054|     if (commands.length === 1 && !command.startsWith('test ')) break;
   00055|   }
   00056|   return commands.find((command) => mutating.verifiedRecipe(command)) ?? commands[0] ?? null;
   00057| }
