   00088| /// The tool capabilities the planner's recipe relies on.
   00089| ///
   00090| /// This is the single source of truth for "what kind of thing a tool does". Both
   00091| /// the planner (to pick which advertised tool to call for each recipe step) and
   00092| /// the server's permission gate (to decide whether an agentic client may drive a
   00093| /// tool of this kind) classify tool names through [`tool_capability`] — so the
   00094| /// two never drift and no per-tool-name special cases accumulate.
   00095| #[derive(Debug, Clone, Copy, PartialEq, Eq)]
   00096| pub enum Capability {
   00097|     Search,
   00098|     Fetch,
   00099|     Read,
   00100|     Write,
   00101|     Edit,
   00102|     Run,
   00103|     Grep,
   00104|     Glob,
   00105|     ListDir,
   00106|     Todo,
   00107|     Subagent,
   00108|     ReadMany,
   00109|     MultiEdit,
   00110|     AskUser,
   00111| }
   00112| 
   00113| impl Capability {
   00114|     /// The associative-package capability key that grants an agentic client the
   00115|     /// right to drive a tool of this kind, e.g. `tool:capability:write`. Grants
   00116|     /// are by *capability class*, not by tool name, so any CLI's naming
   00117|     /// (`write`, `write_file`, `edit`, `patch`, …) maps to the same permission.
   00118|     #[must_use]
   00119|     pub const fn permission_key(self) -> &'static str {
   00120|         match self {
   00121|             Self::Search => "tool:capability:search",
   00122|             Self::Fetch => "tool:capability:fetch",
   00123|             Self::Read => "tool:capability:read",
   00124|             Self::Write => "tool:capability:write",
   00125|             Self::Edit => "tool:capability:edit",
   00126|             Self::Run => "tool:capability:run",
   00127|             Self::Grep => "tool:capability:grep",
   00128|             Self::Glob => "tool:capability:glob",
   00129|             Self::ListDir => "tool:capability:list_dir",
   00130|             Self::Todo => "tool:capability:todo",
   00131|             Self::Subagent => "tool:capability:subagent",
   00132|             Self::ReadMany => "tool:capability:read_many",
   00133|             Self::MultiEdit => "tool:capability:multi_edit",
   00134|             Self::AskUser => "tool:capability:ask_user",
   00135|         }
   00136|     }
   00137| 
   00138|     pub(super) const fn registry_id(self) -> &'static str {
   00139|         match self {
   00140|             Self::Search => "web_search",
   00141|             Self::Fetch => "web_fetch",
   00142|             Self::Read => "read_file",
   00143|             Self::Write => "write_file",
   00144|             Self::Edit => "edit_file",
   00145|             Self::Run => "shell",
   00146|             Self::Grep => "grep",
   00147|             Self::Glob => "glob",
   00148|             Self::ListDir => "list_dir",
   00149|             Self::Todo => "todo",
   00150|             Self::Subagent => "subagent",
   00151|             Self::ReadMany => "read_many",
   00152|             Self::MultiEdit => "multi_edit",
