   00871|     // ownership" ended in nothing at all.
   00872|     if let Some(plan) = capability_router::plan_routed_capability_step(
   00873|         task,
   00874|         messages,
   00875|         tool_names,
   00876|         capability_router::RoutingStage::OpenWeb,
   00877|     ) {
   00878|         return Some(plan);
   00879|     }
   00880|     None
   00881| }
   00882| 
   00883| /// The `shell_command` route arm of the cascade, or `None` to fall through.
   00884| ///
   00885| /// A destructive shell intent read against a request about text inside a file
   00886| /// is declined with the seeded sentence, never composed (PR #1188); that
   00887| /// guard is this arm's own head, not a separately named route. Otherwise the
   00888| /// composed command runs through the file fallback, the verified mutating
   00889| /// recipe, or one shell step.
   00890| fn plan_shell_command_arm(
   00891|     task: &str,
   00892|     messages: &[ChatMessage],
   00893|     tool_names: &[&str],
   00894| ) -> Option<AgenticPlan> {
   00895|     if let Some(decline) = shell_command::destructive_edit_decline(task) {
   00896|         return Some(decline);
   00897|     }
   00898|     let command = shell_command::shell_command_for_task(task)?;
   00899|     if let Some(plan) = shell_file_fallback::plan_step(task, messages, tool_names, &command) {
   00900|         return Some(plan);
   00901|     }
   00902|     // A command that changes the workspace answers by what the workspace
   00903|     // holds afterwards, so it is carried out as the verified recipe its seed
   00904|     // intent declares rather than issued once (issues #824 and #944).
   00905|     if let Some(plan) = mutating_action::plan_step(&command, messages, tool_names, task) {
   00906|         return Some(plan);
   00907|     }
   00908|     Some(plan_shell_step(messages, tool_names, &command))
   00909| }
   00910| 
   00911| /// Run a shell command through the client-owned tool loop, then present its result.
   00912| fn plan_shell_step(messages: &[ChatMessage], tool_names: &[&str], command: &str) -> AgenticPlan {
   00913|     let progress = Progress::scan(messages);
   00914|     if progress.done(Capability::Run) {
   00915|         return AgenticPlan::Final(tool_result::render(
   00916|             command,
   00917|             progress.run_outputs.last().map_or("", String::as_str),
   00918|             crate::protocol::latest_user_request(messages)
   00919|                 .as_deref()
   00920|                 .unwrap_or_default(),
   00921|         ));
   00922|     }
   00923| 
   00924|     if let Some(tool) = tool_for(tool_names, Capability::Run) {
   00925|         return plan_one(tool, json!({ "command": command }).to_string());
   00926|     }
   00927| 
   00928|     AgenticPlan::Final(format!(
   00929|         "I can run `{command}` when the client advertises a shell tool such as `bash`, `shell`, or `run_command`."
   00930|     ))
   00931| }
   00932| 
   00933| pub(super) fn plan_one(tool: &str, arguments: String) -> AgenticPlan {
   00934|     AgenticPlan::ToolCalls(vec![PlannedToolCall {
   00935|         tool: tool.to_owned(),
   00936|         arguments,
   00937|     }])
   00938| }
