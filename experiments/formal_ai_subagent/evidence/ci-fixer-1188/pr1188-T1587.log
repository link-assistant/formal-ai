   00940| /// Arguments for a write step that satisfy whichever key the advertised write
   00941| /// tool expects. Agentic CLIs disagree on the parameter name — the in-repo driver
   00942| /// reads `path`, the `@link-assistant/agent` CLI's `write` tool wants `filePath`,
   00943| /// others use `file_path`. All are emitted; a schema-validating CLI keeps the one
   00944| /// it declared and strips the rest, so the same plan drives any of them without a
   00945| /// per-CLI special case.
   00946| pub(super) fn write_arguments(path: &str, content: &str) -> String {
   00947|     json!({
   00948|         "path": path,
   00949|         "filePath": path,
   00950|         "file_path": path,
   00951|         "content": content,
   00952|     })
   00953|     .to_string()
   00954| }
   00955| 
   00956| /// Arguments for a fetch step. Emits `url` (the universal key) plus `format`
   00957| /// set to `"text"` — the `@link-assistant/agent` CLI's `webfetch` tool declares
   00958| /// a required `format` enum (`"text" | "markdown" | "html"`) and zod refuses the
   00959| /// call otherwise (observed live: *"Invalid option: expected one of
   00960| /// \"text\"|\"markdown\"|\"html\""*). The in-repo driver reads only `url`, and
   00961| /// CLIs whose schemas don't declare `format` strip it, so one shape drives all
   00962| /// of them without a per-CLI special case.
   00963| pub(super) fn fetch_arguments(url: &str) -> String {
   00964|     json!({
   00965|         "url": url,
   00966|         "format": "text",
   00967|     })
   00968|     .to_string()
   00969| }
