   00091| fn expand_with(command: &str, vocab: &ShellIntentVocabulary) -> Option<VerifiedAction> {
   00092|     let intent = vocab
   00093|         .intents
   00094|         .iter()
   00095|         .filter(|intent| intent.effect.is_declared())
   00096|         .filter(|intent| {
   00097|             command
   00098|                 .strip_prefix(intent.command.as_str())
   00099|                 .is_some_and(|rest| rest.starts_with(' '))
   00100|         })
   00101|         .max_by_key(|intent| intent.command.len())?;
   00102|     let effect = &intent.effect;
   00103|     let (operands, flags) = effect_operands(&command[intent.command.len()..], effect)?;
   00104|     if operands.is_empty() {
   00105|         return None;
   00106|     }
   00107|     let before = if flags.iter().any(|flag| effect.reuse_options.contains(flag))
   00108|         && !effect.before_reuse.is_empty()
   00109|     {
   00110|         &effect.before_reuse
   00111|     } else {
   00112|         &effect.before
   00113|     };
   00114|     let has_path = before
   00115|         .iter()
   00116|         .chain(&effect.prepare)
   00117|         .chain(&effect.after)
   00118|         .any(|template| template.contains(PATH_PLACEHOLDER));
   00119|     let bind = |template: &str, bindings: &[(&str, String)]| {
   00120|         bindings
   00121|             .iter()
   00122|             .fold(template.to_owned(), |text, (key, value)| {
   00123|                 text.replace(key, value)
   00124|             })
   00125|     };
   00126|     let mut groups: Vec<Vec<(&str, String)>> = Vec::new();
   00127|     let mut collection = None;
   00128|     if has_path {
   00129|         groups.extend(
   00130|             operands
   00131|                 .iter()
   00132|                 .map(|path| vec![(PATH_PLACEHOLDER, (*path).to_owned())]),
   00133|         );
   00134|     } else {
   00135|         if operands.len() < 2 || (operands.len() > 2 && !effect.directory_targets) {
   00136|             return None;
   00137|         }
   00138|         let destination = *operands.last()?;
   00139|         let sources = &operands[..operands.len() - 1];
   00140|         if !effect.directory_targets && sources.iter().any(|source| has_shell_expansion(source)) {
   00141|             return None;
   00142|         }
   00143|         if effect.directory_targets
   00144|             && (sources.len() > 1
   00145|                 || sources.iter().any(|source| has_shell_expansion(source))
   00146|                 || destination.trim_matches(['\'', '"']).ends_with('/'))
   00147|         {
   00148|             collection = Some((sources.join(" "), destination));
   00149|             groups.push(vec![
   00150|                 (SOURCE_PLACEHOLDER, String::from("\"$formal_ai_source\"")),
   00151|                 (
   00152|                     DESTINATION_PARENT_PLACEHOLDER,
   00153|                     String::from("\"$formal_ai_parent\""),
   00154|                 ),
   00155|                 (
   00156|                     DESTINATION_PLACEHOLDER,
   00157|                     String::from("\"$formal_ai_destination\""),
   00158|                 ),
   00159|             ]);
   00160|         } else {
   00161|             groups.push(vec![
   00162|                 (SOURCE_PLACEHOLDER, sources[0].to_owned()),
   00163|                 (DESTINATION_PARENT_PLACEHOLDER, parent_of(destination)),
   00164|                 (DESTINATION_PLACEHOLDER, destination.to_owned()),
   00165|             ]);
   00166|         }
   00167|     }
   00168|     let fill = |template: &String| -> Vec<String> {
   00169|         groups.iter().map(|bindings| {
   00170|             let check = bind(template, bindings);
   00171|             if let Some((sources, destination)) = &collection {
   00172|                 let setup = format!("formal_ai_destination={destination}; {}", concat!(
   00173|                     "if test -d \"$formal_ai_destination\" || [ \"${formal_ai_destination%/}\" != \"$formal_ai_destination\" ]; then ",
   00174|                     "formal_ai_leaf=\"${formal_ai_source%/}\"; formal_ai_destination=\"${formal_ai_destination%/}/${formal_ai_leaf##*/}\"; fi; ",
   00175|                     "formal_ai_parent=\"${formal_ai_destination%/*}\"; ",
   00176|                     "if [ \"$formal_ai_parent\" = \"$formal_ai_destination\" ]; then formal_ai_parent=.; fi; "));
   00177|                 format!("for formal_ai_source in {sources}; do {setup}{check} || exit $?; done")
   00178|             } else { check }
   00179|         }).collect()
   00180|     };
   00181|     let mut steps: Vec<String> = before.iter().flat_map(fill).collect();
   00182|     steps.extend(effect.prepare.iter().flat_map(fill));
   00183|     let action = steps.len();
   00184|     steps.push(command.to_owned());
   00185|     steps.extend(effect.after.iter().flat_map(fill));
   00186|     Some(VerifiedAction { steps, action })
   00187| }
