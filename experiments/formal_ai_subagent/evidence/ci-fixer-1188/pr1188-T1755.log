   00312| /// The directory component of `path`, or `.` when it names no directory.
   00313| ///
   00314| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00315| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00316| /// happily hand back a `~` that the shell then declines to expand once it is no
   00317| /// longer the first character of the word.
   00318| fn parent_of(path: &str) -> String {
   00319|     if path.contains(['"', '\'', '\\']) {
   00320|         return format!("\"$(dirname -- {path})\"");
   00321|     }
   00322|     match path.rsplit_once('/') {
   00323|         Some(("", _)) => String::from("/"),
   00324|         Some((parent, _)) => parent.to_owned(),
   00325|         None => String::from(CURRENT_DIRECTORY),
   00326|     }
   00327| }
