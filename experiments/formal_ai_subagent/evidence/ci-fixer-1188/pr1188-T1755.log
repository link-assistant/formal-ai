   00240| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00241|     let mut words = Vec::new();
   00242|     let mut start = None;
   00243|     let mut quote = None;
   00244|     let mut escaped = false;
   00245|     for (index, character) in text.char_indices() {
   00246|         if start.is_none() && character.is_whitespace() {
   00247|             continue;
   00248|         }
   00249|         if start.is_none() {
   00250|             start = Some(index);
   00251|         }
   00252|         if escaped {
   00253|             escaped = false;
   00254|             continue;
   00255|         }
   00256|         if character == '\\' && quote != Some('\'') {
   00257|             escaped = true;
   00258|             continue;
   00259|         }
   00260|         if let Some(delimiter) = quote {
   00261|             if character == delimiter {
   00262|                 quote = None;
   00263|             }
   00264|             continue;
   00265|         }
   00266|         if character == '"' || character == '\'' {
   00267|             quote = Some(character);
   00268|             continue;
   00269|         }
   00270|         if character.is_whitespace() {
   00271|             words.push(&text[start.take()?..index]);
   00272|         } else if ";|&<>()`".contains(character) {
   00273|             return None;
   00274|         }
   00275|     }
   00276|     if quote.is_some() || escaped {
   00277|         return None;
   00278|     }
   00279|     if let Some(start) = start {
   00280|         words.push(&text[start..]);
   00281|     }
   00282|     Some(words)
   00283| }
   00284| 
   00285| fn has_shell_expansion(word: &str) -> bool {
   00286|     let mut quote = None;
   00287|     let mut escaped = false;
   00288|     for character in word.chars() {
   00289|         if escaped {
   00290|             escaped = false;
   00291|             continue;
   00292|         }
   00293|         if character == '\\' && quote != Some('\'') {
   00294|             escaped = true;
   00295|             continue;
   00296|         }
   00297|         if let Some(delimiter) = quote {
   00298|             if character == delimiter {
   00299|                 quote = None;
   00300|             }
   00301|             continue;
   00302|         }
   00303|         if character == '"' || character == '\'' {
   00304|             quote = Some(character);
   00305|         } else if "*?[$".contains(character) {
   00306|             return true;
   00307|         }
   00308|     }
   00309|     false
   00310| }
