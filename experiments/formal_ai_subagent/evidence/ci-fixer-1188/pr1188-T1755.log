   00189| /// Separate declared options from shell words while preserving operand quoting.
   00190| fn effect_operands<'a>(
   00191|     text: &'a str,
   00192|     effect: &seed::ShellIntentEffect,
   00193| ) -> Option<(Vec<&'a str>, Vec<String>)> {
   00194|     let words = shell_words(text)?;
   00195|     let mut operands = Vec::new();
   00196|     let mut flags = Vec::new();
   00197|     let mut options = true;
   00198|     let mut index = 0;
   00199|     while index < words.len() {
   00200|         let raw = words[index];
   00201|         let word = raw.trim_matches(['\'', '"']);
   00202|         if options && word == "--" {
   00203|             options = false;
   00204|         } else if options && word.starts_with('-') && word != "-" {
   00205|             if let Some(option) = effect.value_options.iter().find(|option| {
   00206|                 word == option.as_str()
   00207|                     || word.strip_prefix(option.as_str()).is_some_and(|suffix| {
   00208|                         suffix.starts_with('=') || (!option.starts_with("--") && !suffix.is_empty())
   00209|                     })
   00210|             }) {
   00211|                 if word == option.as_str() {
   00212|                     index += 1;
   00213|                     if index >= words.len() {
   00214|                         return None;
   00215|                     }
   00216|                 }
   00217|                 flags.push(option.clone());
   00218|             } else if effect.flags.iter().any(|flag| flag == word) {
   00219|                 flags.push(word.to_owned());
   00220|             } else if !word.starts_with("--") {
   00221|                 let bundled: Vec<String> = word[1..]
   00222|                     .chars()
   00223|                     .map(|letter| format!("-{letter}"))
   00224|                     .collect();
   00225|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) {
   00226|                     return None;
   00227|                 }
   00228|                 flags.extend(bundled);
   00229|             } else {
   00230|                 return None;
   00231|             }
   00232|         } else {
   00233|             operands.push(raw);
   00234|         }
   00235|         index += 1;
   00236|     }
   00237|     Some((operands, flags))
   00238| }
