   00329| /// Plan the next step of the verified recipe for `command`.
   00330| ///
   00331| /// Returns `None` when the command declares no effect (every read-only intent),
   00332| /// or when the client advertised no shell tool — in which case the caller's
   00333| /// single-shot path still produces the honest "I can run this when you give me a
   00334| /// shell" answer rather than this module inventing a second one.
   00335| pub(super) fn plan_step(
   00336|     command: &str,
   00337|     messages: &[ChatMessage],
   00338|     tool_names: &[&str],
   00339|     prompt: &str,
   00340| ) -> Option<AgenticPlan> {
   00341|     let recipe = expand(command)?;
   00342|     let tool = tool_for(tool_names, Capability::Run)?;
   00343|     let progress = Progress::scan(messages);
   00344|     let taken = progress.run_outputs.len();
   00345| 
   00346|     // The workspace gets the last word before anything else is planned: a step
   00347|     // that exited non-zero ends the recipe where it stopped.
   00348|     if let Some(index) = taken.checked_sub(1) {
   00349|         let observed = &progress.run_outputs[index];
   00350|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00351|             return Some(AgenticPlan::Final(blocked_report(
   00352|                 &recipe,
   00353|                 recipe.steps().get(index).map_or(command, String::as_str),
   00354|                 observed,
   00355|                 prompt,
   00356|                 index >= recipe.action,
   00357|             )));
   00358|         }
   00359|     }
   00360|     if let Some(step) = recipe.steps().get(taken) {
   00361|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00362|     }
   00363|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00364| }
   00365| 
   00366| /// The report for a recipe that stopped: which check stopped it, with what
   00367| /// status, and the fact that the action did not run.
   00368| ///
   00369| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00370| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00371| /// record of what a false completion claim costs; a recipe that names the check
   00372| /// it stopped on avoids both.
   00373| fn blocked_report(
   00374|     recipe: &VerifiedAction,
   00375|     check: &str,
   00376|     observed: &str,
   00377|     prompt: &str,
   00378|     attempted: bool,
   00379| ) -> String {
   00380|     let language = tool_result::response_language(prompt);
   00381|     let intent = if attempted {
   00382|         "mutating-action-observed-failure"
   00383|     } else {
   00384|         "mutating_action_blocked"
   00385|     };
   00386|     let Some(mut answer) = seed::localized_response(intent, language) else {
   00387|         return tool_result::render(check, observed, prompt);
   00388|     };
   00389|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00390|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00391|     answer = answer.replace(
   00392|         EXIT_CODE_PLACEHOLDER,
   00393|         &tool_result::reported_exit_code(observed)
   00394|             .map_or_else(String::new, |code| code.to_string()),
   00395|     );
   00396|     answer
   00397| }
   00398| 
   00399| /// The report for a recipe that finished: the action that ran, and the checks
   00400| /// that were observed to hold afterwards.
   00401| ///
   00402| /// The claim rests on those checks and names them, because a claim the reader
   00403| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00404| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00405|     let language = tool_result::response_language(prompt);
   00406|     let checks = recipe
   00407|         .postconditions()
   00408|         .iter()
   00409|         .map(|check| format!("`{check}`"))
   00410|         .collect::<Vec<_>>()
   00411|         .join(", ");
   00412|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00413|         || recipe.action().to_owned(),
   00414|         |answer| {
   00415|             answer
   00416|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00417|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00418|         },
   00419|     )
   00420| }
   00421| 
   00422| /// The ordered steps `command` is carried out as.
   00423| ///
   00424| /// `None` when no seed intent declares an effect for it — every read-only
   00425| /// intent, and every mutating one whose operands are not the source/destination
   00426| /// pair the effect is written against.
   00427| ///
   00428| /// Read-only intents keep their single-shot path, which is why this is the same
   00429| /// question the planner asks: a caller that wants to know whether a command is
   00430| /// carried out as a recipe asks for the recipe.
   00431| #[must_use]
   00432| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00433|     expand(command).map(|recipe| recipe.steps)
   00434| }
