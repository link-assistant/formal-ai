   00001| //! R1188-U18: page formalization.
   00002| //!
   00003| //! Every sentence of a page becomes formal statements, nothing is dropped
   00004| //! silently, and the statements deformalize back to the same known terms. The
   00005| //! JavaScript twin is `rust/tests/web/web-formalization.test.mjs`; both pin the
   00006| //! same outputs of the shared text formalizer.
   00007| 
   00008| use std::cmp::Reverse;
   00009| use std::collections::{BTreeSet, HashMap};
   00010| use std::fs;
   00011| use std::path::Path;
   00012| 
   00013| use formal_ai::formalization::page::formalize_page;
   00014| use formal_ai::formalization::statement_rendering::deformalize_statement;
   00015| use formal_ai::formalization::text_statements::{
   00016|     FUNCTION_WORD_ROLES, NEGATION_ROLE, Token, formalize_text, indexed_meaning, phrase_key,
   00017|     statement_identity, tokens,
   00018| };
   00019| use formal_ai::seed::{lexicon, parse_lino};
   00020| 
   00021| fn identities(text: &str, language: &str) -> Vec<String> {
   00022|     formalize_text(text, language)
   00023|         .iter()
   00024|         .map(statement_identity)
   00025|         .collect()
   00026| }
   00027| 
   00028| fn token(surface: &str, han: bool) -> Token {
   00029|     Token {
   00030|         surface: surface.to_owned(),
   00031|         han,
   00032|     }
   00033| }
