   00037|     assert_eq!(
   00038|         tokens("Earth's orbit is 378,000 km; 1.2 billion. 地球的卫星（月球）"),
   00039|         vec![
   00040|             token("Earth's", false),
   00041|             token("orbit", false),
   00042|             token("is", false),
   00043|             token("378,000", false),
   00044|             token("km", false),
   00045|             token("1.2", false),
   00046|             token("billion", false),
   00047|             token("地球的卫星", true),
   00048|             token("月球", true),
   00049|         ]
   00050|     );
   00051| }
