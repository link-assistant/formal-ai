   00091| /// PR #1188 (LEXEMES): the surface count spans every language, so one meaning
   00092| /// holds a shared word in each language, and the rank still tells meanings
   00093| /// apart once every meaning is written in all five languages.
   00094| #[test]
   00095| fn a_shared_surface_goes_to_more_languages_then_fewer_surfaces_then_declaration_order() {
   00096|     assert_eq!(
   00097|         indexed_meaning("apple", "en").as_deref(),
   00098|         Some("wikidata_item_apple")
   00099|     );
   00100|     assert_eq!(
   00101|         indexed_meaning("सेब", "hi").as_deref(),
   00102|         Some("wikidata_item_apple")
   00103|     );
   00104|     // A rank orders lower first: more languages, fewer surfaces, earlier declared.
   00105|     let mut ranks: HashMap<String, (Reverse<usize>, usize, usize, String)> = HashMap::new();
   00106|     for (order, meaning) in lexicon().meanings.iter().enumerate() {
   00107|         let excluded = FUNCTION_WORD_ROLES
   00108|             .iter()
   00109|             .any(|role| meaning.has_role(role))
   00110|             || meaning.has_role(NEGATION_ROLE);
   00111|         if excluded {
   00112|             continue;
   00113|         }
   00114|         let languages: BTreeSet<&str> = meaning
   00115|             .lexemes
   00116|             .iter()
   00117|             .map(|lexeme| lexeme.language.as_str())
   00118|             .collect();
   00119|         let size: usize = meaning
   00120|             .lexemes
   00121|             .iter()
   00122|             .map(|lexeme| lexeme.words.len())
   00123|             .sum();
   00124|         let Some(english) = meaning
   00125|             .lexemes
   00126|             .iter()
   00127|             .find(|lexeme| lexeme.language == "en")
   00128|         else {
   00129|             continue;
   00130|         };
   00131|         for word in &english.words {
   00132|             let Some(key) = phrase_key(&word.text) else {
   00133|                 continue;
   00134|             };
   00135|             let rank = (Reverse(languages.len()), size, order, meaning.slug.clone());
   00136|             let better = ranks
   00137|                 .get(&key)
   00138|                 .is_none_or(|held| (&rank.0, rank.1, rank.2) < (&held.0, held.1, held.2));
   00139|             if better {
   00140|                 ranks.insert(key, rank);
   00141|             }
   00142|         }
   00143|     }
   00144|     for (key, rank) in ranks {
   00145|         assert_eq!(indexed_meaning(&key, "en"), Some(rank.3), "{key}");
   00146|     }
   00147| }
