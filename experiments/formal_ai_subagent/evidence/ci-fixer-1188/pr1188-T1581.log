   00141| /// The workflow files, and only those.
   00142| ///
   00143| /// Most callers parse what they get here as a workflow -- `jobs:`, job caps,
   00144| /// concurrency groups -- so a composite action, which has none of those, makes
   00145| /// them panic rather than fail with a reason. `ci_shell_files` is the list for
   00146| /// contracts about the shell CI runs, wherever it lives.
   00147| pub fn workflow_files() -> Vec<(String, String)> {
   00148|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00149|         .parent()
   00150|         .expect("the repository root sits one level above the crate");
   00151|     let mut files = Vec::new();
   00152|     collect_ci_files(
   00153|         &root.join(".github/workflows"),
   00154|         root,
   00155|         &mut files,
   00156|         &["yml", "yaml"],
   00157|     );
   00158|     files.sort();
   00159|     assert!(!files.is_empty(), "no workflow files found");
   00160|     files
   00161| }
   00162| 
   00163| /// Everything CI executes as shell: the workflows, the composite actions, and
   00164| /// the scripts either of them runs.
   00165| ///
   00166| /// Issue #1085 moved the self-authored authoring loop into
   00167| /// `.github/actions/author-with-formal-ai/` so another repository can install
   00168| /// it. A contract about the shell -- no bare `git push`, no credentialed
   00169| /// checkout without a reason -- has to read this list, or moving a line one
   00170| /// directory across would move it out of review. The shell CI runs is the same
   00171| /// shell either way.
   00172| pub fn ci_shell_files() -> Vec<(String, String)> {
   00173|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00174|         .parent()
   00175|         .expect("the repository root sits one level above the crate");
   00176|     let mut files = Vec::new();
   00177|     collect_ci_files(
   00178|         &root.join(".github/workflows"),
   00179|         root,
   00180|         &mut files,
   00181|         &["yml", "yaml"],
   00182|     );
   00183|     collect_ci_files(
   00184|         &root.join(".github/actions"),
   00185|         root,
   00186|         &mut files,
   00187|         &["yml", "yaml", "sh"],
   00188|     );
   00189|     files.sort();
   00190|     assert!(!files.is_empty(), "no CI shell files found");
   00191|     files
   00192| }
   00193| 
   00194| fn collect_ci_files(
   00195|     dir: &Path,
   00196|     root: &Path,
   00197|     files: &mut Vec<(String, String)>,
   00198|     extensions: &[&str],
   00199| ) {
   00200|     let Ok(entries) = fs::read_dir(dir) else {
   00201|         return;
   00202|     };
   00203|     for entry in entries {
   00204|         let path = entry.expect("workflow entry").path();
   00205|         if path.is_dir() {
   00206|             collect_ci_files(&path, root, files, extensions);
   00207|             continue;
   00208|         }
   00209|         if !path
   00210|             .extension()
   00211|             .is_some_and(|ext| extensions.iter().any(|allowed| ext == *allowed))
   00212|         {
   00213|             continue;
   00214|         }
   00215|         let name = path
   00216|             .strip_prefix(root)
   00217|             .unwrap_or(&path)
   00218|             .to_string_lossy()
   00219|             .into_owned();
   00220|         let name = name
   00221|             .strip_prefix(".github/workflows/")
   00222|             .unwrap_or(&name)
   00223|             .to_owned();
   00224|         files.push((
   00225|             name,
   00226|             fs::read_to_string(&path).unwrap().replace("\r\n", "\n"),
   00227|         ));
   00228|     }
   00229| }
