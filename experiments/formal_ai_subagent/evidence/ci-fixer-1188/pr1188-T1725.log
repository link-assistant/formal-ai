   00085| /// The recipe is derived from the seed effect table, so it is the same list the
   00086| /// planner walks and the same list a maintainer edits.
   00087| #[test]
   00088| fn a_move_expands_into_preconditions_preparation_action_and_postconditions() {
   00089|     assert_eq!(
   00090|         verified_recipe("mv report.txt archive/report.txt"),
   00091|         Some(vec![
   00092|             String::from("test -e report.txt"),
   00093|             String::from("test ! -e archive/report.txt"),
   00094|             String::from("mkdir -p -- archive"),
   00095|             String::from("mv report.txt archive/report.txt"),
   00096|             String::from("test -e archive/report.txt"),
   00097|             String::from("test ! -e report.txt"),
   00098|         ])
   00099|     );
   00100| }
