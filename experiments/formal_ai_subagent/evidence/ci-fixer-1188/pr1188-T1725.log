   00001| //! Issue #1021 / #944 (E92): a move is *performed and verified*, not issued.
   00002| //!
   00003| //! Issue #824 reported *"Move <dir> to <dir>"* being refused. The routing half
   00004| //! of that was answered on this branch — the request lowers to a concrete `mv
   00005| //! SOURCE DESTINATION` — and issue #944 asks for the other half: "verify source
   00006| //! exists, verify/create destination parent (mkdir -p), perform the move, verify
   00007| //! the result, and confirm to the user".
   00008| //!
   00009| //! So these tests do not assert that a command was *planned*. They drive the
   00010| //! planner's own tool loop with the results a shell would return and assert the
   00011| //! ordered recipe it walks, that a check which fails stops the recipe before the
   00012| //! action, and that the answer afterwards names what it rests on. The same
   00013| //! recipe is exercised end to end against a real filesystem by the write-effect
   00014| //! ladder rungs `824.L1`-`824.L5`.
   00015| 
   00016| use formal_ai::agentic_coding::mutating_action::verified_recipe;
   00017| use formal_ai::agentic_coding::{AgenticPlan, PlannedToolCall, plan_chat_step};
   00018| use formal_ai::{ChatMessage, ToolCall};
   00019| 
   00020| const TOOLS: [&str; 2] = ["write_file", "run_shell_command"];
   00021| 
   00022| /// The qwen-code shell envelope, the shape the #902-#909 corpus recorded and the
   00023| /// one the write-effect ladder replays.
   00024| fn shell_result(command: &str, stdout: &str, exit_code: i32) -> String {
   00025|     format!(
   00026|         "Command: {command}\nDirectory: (root)\nOutput: {}\nError: (none)\nExit Code: {exit_code}\nSignal: 0\nProcess Group PGID: 0",
   00027|         if stdout.is_empty() { "(empty)" } else { stdout }
   00028|     )
   00029| }
   00030| 
   00031| fn next_call(messages: &[ChatMessage]) -> Option<PlannedToolCall> {
   00032|     match plan_chat_step(messages, &TOOLS)? {
   00033|         AgenticPlan::ToolCalls(mut calls) if calls.len() == 1 => Some(calls.remove(0)),
   00034|         AgenticPlan::Final(_) => None,
   00035|         other @ AgenticPlan::ToolCalls(_) => {
   00036|             panic!("expected one tool call or a final answer, got {other:?}")
   00037|         }
   00038|     }
   00039| }
   00040| 
   00041| fn final_answer(messages: &[ChatMessage]) -> String {
   00042|     match plan_chat_step(messages, &TOOLS) {
   00043|         Some(AgenticPlan::Final(answer)) => answer,
   00044|         other => panic!("expected a final answer, got {other:?}"),
   00045|     }
   00046| }
   00047| 
   00048| fn record(messages: &mut Vec<ChatMessage>, call: &PlannedToolCall, result: &str) {
   00049|     let id = format!("call_{}", messages.len());
   00050|     messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00051|         id.clone(),
   00052|         call.tool.clone(),
   00053|         call.arguments.clone(),
   00054|     )]));
   00055|     messages.push(ChatMessage::tool_result(id, &call.tool, result));
   00056| }
   00057| 
   00058| fn command_of(call: &PlannedToolCall) -> String {
   00059|     let arguments: serde_json::Value =
   00060|         serde_json::from_str(&call.arguments).expect("tool arguments");
   00061|     arguments["command"]
   00062|         .as_str()
   00063|         .unwrap_or_else(|| panic!("a shell step should carry a command: {}", call.arguments))
   00064|         .to_owned()
   00065| }
   00066| 
   00067| /// Drive the planner until it answers, returning every command it ran and the
   00068| /// answer it finished with. `exit_codes` supplies the status of each step in
   00069| /// order; a missing entry means the step succeeded.
   00070| fn drive(prompt: &str, exit_codes: &[i32]) -> (Vec<String>, String) {
   00071|     let mut messages = vec![ChatMessage::user(prompt)];
   00072|     let mut commands = Vec::new();
   00073|     for step in 0..10 {
   00074|         let Some(call) = next_call(&messages) else {
   00075|             break;
   00076|         };
   00077|         let command = command_of(&call);
   00078|         let code = exit_codes.get(step).copied().unwrap_or(0);
   00079|         record(&mut messages, &call, &shell_result(&command, "", code));
   00080|         commands.push(command);
   00081|     }
   00082|     (commands, final_answer(&messages))
   00083| }
