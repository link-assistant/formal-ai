   00129| #[test]
   00130| fn actionlint_tracks_githubs_queue_schema_without_hiding_other_errors() {
   00131|     // Issue #1076 moved actionlint out of release.yml's `lint` job and into
   00132|     // `.github/workflows/workflows.yml`, and with it the `-ignore` flag, which
   00133|     // is now a `paths:` entry in `.github/actionlint.yaml`. The property this
   00134|     // test defends is unchanged: the suppression names GitHub's `queue` schema
   00135|     // lag specifically and cannot be widened into a blanket filter.
   00136|     let workflow = repository_file(".github/workflows/workflows.yml");
   00137|     let config = repository_file(".github/actionlint.yaml");
   00138| 
   00139|     // Issue #1079 replaced the tag with the digest it resolved to: a tag is a
   00140|     // mutable pointer, and `.github/zizmor.yml` forbids those. The tag it was
   00141|     // resolved from stays in the comment beside it, so a bump is still a
   00142|     // readable diff rather than an opaque hash swap.
   00143|     assert!(
   00144|         workflow.contains("docker://rhysd/actionlint@sha256:"),
   00145|         "actionlint must run as the digest-pinned Docker image -- the image \
   00146|          bundles ShellCheck, and a bare binary without ShellCheck on PATH skips \
   00147|          every `run:` block check and still exits 0 (issues #1076, #1079)"
   00148|     );
   00149|     assert!(
   00150|         workflow.contains("rhysd/actionlint:<tag>"),
   00151|         "workflows.yml must keep the command that re-resolves the digest, or \
   00152|          the next bump has no way to check what the hash points at (issue #1079)"
   00153|     );
   00154|     assert!(config.contains("rhysd/actionlint/issues/657"));
   00155|     assert!(config.contains("unexpected key \"queue\" for \"concurrency\" section"));
   00156| 
   00157|     // A pattern matching everything is indistinguishable from not running the
   00158|     // linter at all, whichever form it takes.
   00159|     for blanket in ["- '.*'", "- \".*\"", "-ignore '.*'"] {
   00160|         assert!(
   00161|             !config.contains(blanket) && !workflow.contains(blanket),
   00162|             "actionlint suppressions must stay specific, found {blanket:?}"
   00163|         );
   00164|     }
   00165| }
