   00046| #[test]
   00047| fn write_jobs_queue_together_without_workflow_level_cancellation() {
   00048|     let release = release_workflow();
   00049|     let desktop = desktop_release_workflow();
   00050|     let external = repository_file(".github/workflows/external-benchmarks.yml");
   00051|     let shared = concat!(
   00052|         "    concurrency:\n",
   00053|         "      group: formal-ai-repository-writes\n",
   00054|         "      queue: max\n",
   00055|     );
   00056| 
   00057|     for workflow in [&release, &desktop, &external] {
   00058|         let header = workflow.split("\njobs:\n").next().unwrap();
   00059|         assert!(!header.contains("\nconcurrency:\n"));
   00060|     }
   00061|     for job_name in [
   00062|         "auto-release",
   00063|         "manual-release",
   00064|         "changelog-pr",
   00065|         "deploy-pages",
   00066|     ] {
   00067|         assert!(job_block(&release, job_name).contains(shared), "{job_name}");
   00068|     }
   00069|     let desktop_build = job_block(&desktop, "build");
   00070|     assert!(desktop_build.contains("group: desktop-release-${{ github.event.pull_request.number || needs.resolve.outputs.tag }}-${{ matrix.label }}"));
   00071|     assert!(desktop_build.contains("queue: max"));
   00072|     let vscode = job_block(&desktop, "vscode");
   00073|     assert!(vscode.contains("group: desktop-release-${{ github.event.pull_request.number || needs.resolve.outputs.tag }}-vscode"));
   00074|     assert!(vscode.contains("queue: max"));
   00075|     assert!(job_block(&desktop, "finalize").contains(shared));
   00076|     assert!(job_block(&external, "external-benchmarks").contains(shared));
   00077| }
