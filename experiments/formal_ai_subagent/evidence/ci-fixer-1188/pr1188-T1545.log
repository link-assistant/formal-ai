   00013| #[test]
   00014| fn macos_tests_are_partitioned_without_raising_the_failed_budget() {
   00015|     let workflow = release_workflow();
   00016|     let test = job_block(&workflow, "test");
   00017|     let macos_call = job_block(&workflow, "macos-core-tests");
   00018|     let macos = repository_file(".github/workflows/macos-core-tests.yml");
   00019| 
   00020|     assert!(test.contains("name: Test (${{ matrix.os }} / ${{ matrix.test-suite }})"));
   00021|     assert!(test.contains("test-suite: full"));
   00022|     // Issue #1059: the lane runs 139 platform-sensitive tests on one runner
   00023|     // rather than the whole suite across eight.
   00024|     assert!(macos.contains("- { partition: 1 }"));
   00025|     assert!(test.contains("test-suite: specification"));
   00026|     assert_eq!(macos.matches("runs-on: macos-15-intel").count(), 2);
   00027|     assert!(macos_call.contains("uses: ./.github/workflows/macos-core-tests.yml"));
   00028|     // Issue #1055 raised the archive cap to 35m and issue #1081 to 45m; see
   00029|     // issue_1012 for the math, which is where the cap is checked. Pinning an
   00030|     // exact backstop from two places means every future widening has to be
   00031|     // argued twice, so this one only asserts that the partitioning below did
   00032|     // not remove it.
   00033|     assert!(macos.contains("\n    timeout-minutes:"));
   00034|     assert!(macos.contains("cargo nextest --manifest-path rust/Cargo.toml archive"));
   00035|     assert!(macos.contains("cargo nextest --manifest-path rust/Cargo.toml run --archive-file"));
   00036|     assert!(macos.contains("--macos-platform"));
   00037|     assert!(test.contains("cargo test --manifest-path rust/Cargo.toml --test unit --all-features --verbose specification::"));
   00038|     assert!(macos.contains("test(specification::)"));
   00039|     assert!(test.contains("matrix.test-suite == 'full'"));
   00040|     assert!(test.contains("matrix.test-suite == 'specification'"));
   00041| }
