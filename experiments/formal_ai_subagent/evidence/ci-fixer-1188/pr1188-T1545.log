   00126| #[test]
   00127| fn actionlint_tracks_githubs_queue_schema_without_hiding_other_errors() {
   00128|     // Issue #1076 moved actionlint out of release.yml's `lint` job and into
   00129|     // `.github/workflows/workflows.yml`, and with it the `-ignore` flag, which
   00130|     // is now a `paths:` entry in `.github/actionlint.yaml`. The property this
   00131|     // test defends is unchanged: the suppression names GitHub's `queue` schema
   00132|     // lag specifically and cannot be widened into a blanket filter.
   00133|     let workflow = repository_file(".github/workflows/workflows.yml");
   00134|     let config = repository_file(".github/actionlint.yaml");
   00135| 
   00136|     // Issue #1079 replaced the tag with the digest it resolved to: a tag is a
   00137|     // mutable pointer, and `.github/zizmor.yml` forbids those. The tag it was
   00138|     // resolved from stays in the comment beside it, so a bump is still a
   00139|     // readable diff rather than an opaque hash swap.
   00140|     assert!(
   00141|         workflow.contains("docker://rhysd/actionlint@sha256:"),
   00142|         "actionlint must run as the digest-pinned Docker image -- the image \
   00143|          bundles ShellCheck, and a bare binary without ShellCheck on PATH skips \
   00144|          every `run:` block check and still exits 0 (issues #1076, #1079)"
   00145|     );
   00146|     assert!(
   00147|         workflow.contains("rhysd/actionlint:<tag>"),
   00148|         "workflows.yml must keep the command that re-resolves the digest, or \
   00149|          the next bump has no way to check what the hash points at (issue #1079)"
   00150|     );
   00151|     assert!(config.contains("rhysd/actionlint/issues/657"));
   00152|     assert!(config.contains("unexpected key \"queue\" for \"concurrency\" section"));
   00153| 
   00154|     // A pattern matching everything is indistinguishable from not running the
   00155|     // linter at all, whichever form it takes.
   00156|     for blanket in ["- '.*'", "- \".*\"", "-ignore '.*'"] {
   00157|         assert!(
   00158|             !config.contains(blanket) && !workflow.contains(blanket),
   00159|             "actionlint suppressions must stay specific, found {blanket:?}"
   00160|         );
   00161|     }
   00162| }
