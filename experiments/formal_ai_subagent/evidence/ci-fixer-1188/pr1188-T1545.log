   00043| #[test]
   00044| fn write_jobs_queue_together_without_workflow_level_cancellation() {
   00045|     let release = release_workflow();
   00046|     let desktop = desktop_release_workflow();
   00047|     let external = repository_file(".github/workflows/external-benchmarks.yml");
   00048|     let shared = concat!(
   00049|         "    concurrency:\n",
   00050|         "      group: formal-ai-repository-writes\n",
   00051|         "      queue: max\n",
   00052|     );
   00053| 
   00054|     for workflow in [&release, &desktop, &external] {
   00055|         let header = workflow.split("\njobs:\n").next().unwrap();
   00056|         assert!(!header.contains("\nconcurrency:\n"));
   00057|     }
   00058|     for job_name in [
   00059|         "auto-release",
   00060|         "manual-release",
   00061|         "changelog-pr",
   00062|         "deploy-pages",
   00063|     ] {
   00064|         assert!(job_block(&release, job_name).contains(shared), "{job_name}");
   00065|     }
   00066|     let desktop_build = job_block(&desktop, "build");
   00067|     assert!(desktop_build.contains("group: desktop-release-${{ github.event.pull_request.number || needs.resolve.outputs.tag }}-${{ matrix.label }}"));
   00068|     assert!(desktop_build.contains("queue: max"));
   00069|     let vscode = job_block(&desktop, "vscode");
   00070|     assert!(vscode.contains("group: desktop-release-${{ github.event.pull_request.number || needs.resolve.outputs.tag }}-vscode"));
   00071|     assert!(vscode.contains("queue: max"));
   00072|     assert!(job_block(&desktop, "finalize").contains(shared));
   00073|     assert!(job_block(&external, "external-benchmarks").contains(shared));
   00074| }
