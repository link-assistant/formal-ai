   00027| const TOOLS = ['bash', 'edit', 'glob', 'grep', 'list', 'read', 'write'];
   00028| const pathOf = (args) => args.filePath ?? args.file_path ?? args.path;
   00029| 
   00030| /** The Agent CLI's tools over an in-memory workspace; bash knows `sha256sum --` and `cat`. */
   00031| function execute(files, tool, args) {
   00032|   if (tool === 'read') {
   00033|     const path = pathOf(args);
   00034|     return files.has(path) ? files.get(path) : `Error: File not found: ${path}`;
   00035|   }
   00036|   if (tool === 'write') {
   00037|     files.set(pathOf(args), args.content);
   00038|     return '';
   00039|   }
   00040|   if (tool === 'edit') {
   00041|     const path = pathOf(args);
   00042|     const text = files.get(path) ?? '';
   00043|     if (!text.includes(args.oldString)) return 'Error: oldString not found in content';
   00044|     if (text.indexOf(args.oldString) !== text.lastIndexOf(args.oldString)) return 'Error: Found multiple matches for oldString.';
   00045|     files.set(path, text.replace(args.oldString, () => args.newString));
   00046|     return '';
   00047|   }
   00048|   if (tool === 'bash') {
   00049|     const presence = args.command.match(/^test (! )?-e (\S+)$/u);
   00050|     if (presence) return files.has(presence[2]) !== Boolean(presence[1]) ? '' : ['Output: ', 'Error: ', 'Exit Code: 1'].join(String.fromCharCode(10));
   00051|     if (args.command.startsWith('mkdir -p -- ')) return '';
   00052|     const transfer = args.command.match(/^(cp|mv) (\S+) (\S+)$/u);
   00053|     if (transfer && files.has(transfer[2])) {
   00054|       files.set(transfer[3], files.get(transfer[2]));
   00055|       if (transfer[1] === 'mv') files.delete(transfer[2]);
   00056|       return '';
   00057|     }
   00058|     const digest = /^sha256sum -- (\S+)$/u.exec(args.command);
   00059|     if (digest) return `${createHash('sha256').update(files.get(digest[1]) ?? '').digest('hex')}  ${digest[1]}\n`;
   00060|     const cat = /^cat (\S+)$/u.exec(args.command);
   00061|     if (cat) return files.get(cat[1]) ?? `Output: \nError: cat: ${cat[1]}: No such file or directory\nExit Code: 1`;
   00062|   }
   00063|   return `Error: ${tool} is not simulated`;
   00064| }
