   00066| async function drive(prompt, workspace, maxSteps = 12) {
   00067|   const files = new Map(Object.entries(workspace));
   00068|   const messages = [{ role: 'user', content: prompt }];
   00069|   const calls = [];
   00070|   for (let step = 0; step < maxSteps; step += 1) {
   00071|     const plan = await planChatStep(messages, TOOLS);
   00072|     if (!plan || plan.kind === 'final') return { calls, files, answer: plan ? plan.answer : null };
   00073|     const [call] = plan.calls;
   00074|     const args = JSON.parse(call.arguments);
   00075|     const id = `call_${step}`;
   00076|     calls.push(call.tool);
   00077|     messages.push({ role: 'assistant', content: '', tool_calls: [{ id, type: 'function', function: { name: call.tool, arguments: call.arguments } }] });
   00078|     messages.push({ role: 'tool', tool_call_id: id, content: execute(files, call.tool, args) });
   00079|   }
   00080|   return { calls, files, answer: null };
   00081| }
