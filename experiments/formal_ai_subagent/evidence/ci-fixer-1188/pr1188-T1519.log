   00110| /// The JavaScript test's mulberry32 generator, step for step.
   00111| struct Generator(u32);
   00112| 
   00113| impl Generator {
   00114|     fn next(&mut self) -> f64 {
   00115|         self.0 = self.0.wrapping_add(0x6d2b_79f5);
   00116|         let mut value = self.0;
