   00130| fn payload(random: &mut Generator) -> String {
   00131|     let count = 1 + random.below(3);
   00132|     (0..count)
   00133|         .map(|_| WORDS[random.below(WORDS.len())])
   00134|         .collect::<Vec<_>>()
   00135|         .join(" ")
   00136| }
   00137| 
   00138| fn generate(random: &mut Generator) -> (String, String, String) {
   00139|     let (open, close) = STYLES[random.below(STYLES.len())];
   00140|     let old = payload(random);
   00141|     let mut next = payload(random);
   00142|     if next == old {
   00143|         next = format!("{next} beta");
   00144|     }
   00145|     let ending = if random.next() < 0.2 { "" } else { close };
   00146|     let request = if random.next() < 0.5 {
   00147|         format!("Replace {open}{old}{close} with {open}{next}{ending} in {TARGET}.")
   00148|     } else {
   00149|         format!("In {TARGET} replace {open}{old}{close} with {open}{next}{ending}.")
   00150|     };
   00151|     (request, old, next)
   00152| }
