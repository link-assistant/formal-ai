   00121| 
   00122|     fn below(&mut self, count: usize) -> usize {
   00123|         let bound = u32::try_from(count).expect("fixture collection fits in u32");
   00124|         #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
   00125|         let index = (self.next() * count as f64) as usize;
   00126|         index
   00127|     }
   00128| }
