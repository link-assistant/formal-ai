   00154| fn verification(command: &str) -> bool {
   00155|     let words: Vec<&str> = command.split(' ').collect();
   00156|     matches!(
   00157|         words.as_slice(),
   00158|         ["sha256sum", "--", _] | ["cat", _] | ["test", "-e", _] | ["test", "!", "-e", _]
