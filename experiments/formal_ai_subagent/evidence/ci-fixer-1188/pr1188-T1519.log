   00173|         let call = calls[0].clone();
   00174|         let arguments: serde_json::Value =
   00175|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00176|         let path = ["filePath", "file_path", "path"]
   00177|             .iter()
   00178|             .find_map(|key| arguments[*key].as_str())
   00179|             .unwrap_or_default()
   00180|             .to_owned();
   00181|         let result = match call.tool.as_str() {
   00182|             "read" => files.get(&path).cloned().unwrap_or_default(),
   00183|             "write" => {
   00184|                 files.insert(
   00185|                     path,
   00186|                     arguments["content"].as_str().unwrap_or_default().to_owned(),
   00187|                 );
   00188|                 String::new()
   00189|             }
   00190|             "edit" => {
   00191|                 let old = arguments["oldString"].as_str().unwrap_or_default();
   00192|                 let new = arguments["newString"].as_str().unwrap_or_default();
   00193|                 let text = files.get(&path).cloned().unwrap_or_default();
   00194|                 if text.contains(old) {
   00195|                     files.insert(path, text.replacen(old, new, 1));
   00196|                 }
   00197|                 String::new()
   00198|             }
   00199|             "bash" => {
   00200|                 commands.push(arguments["command"].as_str().unwrap_or_default().to_owned());
   00201|                 String::new()
   00202|             }
   00203|             _ => String::new(),
   00204|         };
   00205|         let id = format!("call_{index}");
   00206|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00207|             id.clone(),
   00208|             call.tool.clone(),
   00209|             call.arguments.clone(),
   00210|         )]));
   00211|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00212|     }
   00213|     (files, commands)
   00214| }
