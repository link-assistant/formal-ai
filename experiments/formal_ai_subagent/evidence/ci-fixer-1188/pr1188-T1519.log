   00162| fn run_request(request: &str, source: &str) -> (BTreeMap<String, String>, Vec<String>) {
   00163|     let mut files = BTreeMap::from([
   00164|         (TARGET.to_owned(), source.to_owned()),
   00165|         (BYSTANDER.to_owned(), BYSTANDER_TEXT.to_owned()),
   00166|     ]);
   00167|     let mut commands = Vec::new();
   00168|     let mut messages = vec![ChatMessage::user(request)];
