   00323| /// The directory component of `path`, or `.` when it names no directory.
   00324| ///
   00325| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00326| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00327| /// happily hand back a `~` that the shell then declines to expand once it is no
   00328| /// longer the first character of the word.
   00329| fn parent_of(path: &str) -> String {
   00330|     if path.contains(['"', '\'', '\\']) {
   00331|         return format!("\"$(dirname -- {path})\"");
   00332|     }
   00333|     match path.rsplit_once('/') {
   00334|         Some(("", _)) => String::from("/"),
   00335|         Some((parent, _)) => parent.to_owned(),
   00336|         None => String::from(CURRENT_DIRECTORY),
   00337|     }
   00338| }
