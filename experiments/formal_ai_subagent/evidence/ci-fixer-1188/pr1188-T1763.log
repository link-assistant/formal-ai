   00340| /// Plan the next step of the verified recipe for `command`.
   00341| ///
   00342| /// Returns `None` when the command declares no effect (every read-only intent),
   00343| /// or when the client advertised no shell tool — in which case the caller's
   00344| /// single-shot path still produces the honest "I can run this when you give me a
   00345| /// shell" answer rather than this module inventing a second one.
   00346| pub(super) fn plan_step(
   00347|     command: &str,
   00348|     messages: &[ChatMessage],
   00349|     tool_names: &[&str],
   00350|     prompt: &str,
   00351| ) -> Option<AgenticPlan> {
   00352|     let recipe = expand(command)?;
   00353|     let tool = tool_for(tool_names, Capability::Run)?;
   00354|     let progress = Progress::scan(messages);
   00355|     let taken = progress.run_outputs.len();
   00356| 
   00357|     // The workspace gets the last word before anything else is planned: a step
   00358|     // that exited non-zero ends the recipe where it stopped.
   00359|     if let Some(index) = taken.checked_sub(1) {
   00360|         let observed = &progress.run_outputs[index];
   00361|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00362|             return Some(AgenticPlan::Final(blocked_report(
   00363|                 &recipe,
   00364|                 recipe.steps().get(index).map_or(command, String::as_str),
   00365|                 observed,
   00366|                 prompt,
   00367|                 index >= recipe.action,
   00368|             )));
   00369|         }
   00370|     }
   00371|     if let Some(step) = recipe.steps().get(taken) {
   00372|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00373|     }
   00374|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00375| }
   00376| 
   00377| /// The report for a recipe that stopped: which check stopped it, with what
   00378| /// status, and the fact that the action did not run.
   00379| ///
   00380| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00381| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00382| /// record of what a false completion claim costs; a recipe that names the check
   00383| /// it stopped on avoids both.
   00384| fn blocked_report(
   00385|     recipe: &VerifiedAction,
   00386|     check: &str,
   00387|     observed: &str,
   00388|     prompt: &str,
   00389|     attempted: bool,
   00390| ) -> String {
   00391|     let language = tool_result::response_language(prompt);
   00392|     let intent = if attempted {
   00393|         "mutating-action-observed-failure"
   00394|     } else {
   00395|         "mutating_action_blocked"
   00396|     };
   00397|     let Some(mut answer) = seed::localized_response(intent, language) else {
   00398|         return tool_result::render(check, observed, prompt);
   00399|     };
   00400|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00401|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00402|     answer = answer.replace(
   00403|         EXIT_CODE_PLACEHOLDER,
   00404|         &tool_result::reported_exit_code(observed)
   00405|             .map_or_else(String::new, |code| code.to_string()),
   00406|     );
   00407|     answer
   00408| }
   00409| 
   00410| /// The report for a recipe that finished: the action that ran, and the checks
   00411| /// that were observed to hold afterwards.
   00412| ///
   00413| /// The claim rests on those checks and names them, because a claim the reader
   00414| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00415| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00416|     let language = tool_result::response_language(prompt);
   00417|     let checks = recipe
   00418|         .postconditions()
   00419|         .iter()
   00420|         .map(|check| format!("`{check}`"))
   00421|         .collect::<Vec<_>>()
   00422|         .join(", ");
   00423|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00424|         || recipe.action().to_owned(),
   00425|         |answer| {
   00426|             answer
   00427|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00428|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00429|         },
   00430|     )
   00431| }
   00432| 
   00433| /// The ordered steps `command` is carried out as.
   00434| ///
   00435| /// `None` when no seed intent declares an effect for it — every read-only
   00436| /// intent, and every mutating one whose operands are not the source/destination
   00437| /// pair the effect is written against.
   00438| ///
   00439| /// Read-only intents keep their single-shot path, which is why this is the same
   00440| /// question the planner asks: a caller that wants to know whether a command is
   00441| /// carried out as a recipe asks for the recipe.
   00442| #[must_use]
   00443| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00444|     expand(command).map(|recipe| recipe.steps)
   00445| }
