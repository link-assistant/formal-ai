   00200| /// Separate declared options from shell words while preserving operand quoting.
   00201| fn effect_operands<'a>(
   00202|     text: &'a str,
   00203|     effect: &seed::ShellIntentEffect,
   00204| ) -> Option<(Vec<&'a str>, Vec<String>)> {
   00205|     let words = shell_words(text)?;
   00206|     let mut operands = Vec::new();
   00207|     let mut flags = Vec::new();
   00208|     let mut options = true;
   00209|     let mut index = 0;
   00210|     while index < words.len() {
   00211|         let raw = words[index];
   00212|         let word = raw.trim_matches(['\'', '"']);
   00213|         if options && word == "--" {
   00214|             options = false;
   00215|         } else if options && word.starts_with('-') && word != "-" {
   00216|             if let Some(option) = effect.value_options.iter().find(|option| {
   00217|                 word == option.as_str()
   00218|                     || word.strip_prefix(option.as_str()).is_some_and(|suffix| {
   00219|                         suffix.starts_with('=') || (!option.starts_with("--") && !suffix.is_empty())
   00220|                     })
   00221|             }) {
   00222|                 if word == option.as_str() {
   00223|                     index += 1;
   00224|                     if index >= words.len() {
   00225|                         return None;
   00226|                     }
   00227|                 }
   00228|                 flags.push(option.clone());
   00229|             } else if effect.flags.iter().any(|flag| flag == word) {
   00230|                 flags.push(word.to_owned());
   00231|             } else if !word.starts_with("--") {
   00232|                 let bundled: Vec<String> = word[1..]
   00233|                     .chars()
   00234|                     .map(|letter| format!("-{letter}"))
   00235|                     .collect();
   00236|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) {
   00237|                     return None;
   00238|                 }
   00239|                 flags.extend(bundled);
   00240|             } else {
   00241|                 return None;
   00242|             }
   00243|         } else {
   00244|             operands.push(raw);
   00245|         }
   00246|         index += 1;
   00247|     }
   00248|     Some((operands, flags))
   00249| }
