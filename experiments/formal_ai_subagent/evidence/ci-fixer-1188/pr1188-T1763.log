   00296| fn has_shell_expansion(word: &str) -> bool {
   00297|     let mut quote = None;
   00298|     let mut escaped = false;
   00299|     for character in word.chars() {
   00300|         if escaped {
   00301|             escaped = false;
   00302|             continue;
   00303|         }
   00304|         if character == '\\' && quote != Some('\'') {
   00305|             escaped = true;
   00306|             continue;
   00307|         }
   00308|         if let Some(delimiter) = quote {
   00309|             if character == delimiter {
   00310|                 quote = None;
   00311|             }
   00312|             continue;
   00313|         }
   00314|         if character == '"' || character == '\'' {
   00315|             quote = Some(character);
   00316|         } else if "*?[$".contains(character) {
   00317|             return true;
   00318|         }
   00319|     }
   00320|     false
   00321| }
