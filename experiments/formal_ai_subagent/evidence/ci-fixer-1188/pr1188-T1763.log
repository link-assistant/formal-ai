   00251| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00252|     let mut words = Vec::new();
   00253|     let mut start = None;
   00254|     let mut quote = None;
   00255|     let mut escaped = false;
   00256|     for (index, character) in text.char_indices() {
   00257|         if start.is_none() && character.is_whitespace() {
   00258|             continue;
   00259|         }
   00260|         if start.is_none() {
   00261|             start = Some(index);
   00262|         }
   00263|         if escaped {
   00264|             escaped = false;
   00265|             continue;
   00266|         }
   00267|         if character == '\\' && quote != Some('\'') {
   00268|             escaped = true;
   00269|             continue;
   00270|         }
   00271|         if let Some(delimiter) = quote {
   00272|             if character == delimiter {
   00273|                 quote = None;
   00274|             }
   00275|             continue;
   00276|         }
   00277|         if character == '"' || character == '\'' {
   00278|             quote = Some(character);
   00279|             continue;
   00280|         }
   00281|         if character.is_whitespace() {
   00282|             words.push(&text[start.take()?..index]);
   00283|         } else if ";|&<>()`".contains(character) {
   00284|             return None;
   00285|         }
   00286|     }
   00287|     if quote.is_some() || escaped {
   00288|         return None;
   00289|     }
   00290|     if let Some(start) = start {
   00291|         words.push(&text[start..]);
   00292|     }
   00293|     Some(words)
   00294| }
