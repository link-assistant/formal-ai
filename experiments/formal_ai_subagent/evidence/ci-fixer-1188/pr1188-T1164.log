   00839| fn rust_paths(task: &str) -> Vec<String> {
   00840|     let mut paths = Vec::new();
   00841|     for (suffix, _) in task.match_indices(".rs") {
   00842|         let end = suffix + 3;
   00843|         let start = task[..end]
   00844|             .char_indices()
   00845|             .rev()
   00846|             .take_while(|(_, character)| {
   00847|                 character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00848|             })
   00849|             .last()
   00850|             .map_or(0, |(index, _)| index);
   00851|         let path = &task[start..end];
   00852|         if !path.is_empty()
   00853|             && !path.starts_with('/')
   00854|             && !path.split('/').any(|component| component == "..")
   00855|             && !paths.iter().any(|existing| existing == path)
   00856|         {
   00857|             paths.push(path.to_owned());
   00858|         }
   00859|     }
   00860|     paths
   00861| }
