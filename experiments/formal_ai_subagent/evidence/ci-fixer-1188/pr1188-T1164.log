   00746| fn insert_registration(source: &str, registration: &str) -> String {
   00747|     if source
   00748|         .lines()
   00749|         .any(|line| line.trim() == registration.trim())
   00750|     {
   00751|         return source.to_owned();
   00752|     }
   00753|     let mut updated = source.to_owned();
   00754|     if !updated.is_empty() && !updated.ends_with('\n') {
   00755|         updated.push('\n');
   00756|     }
   00757|     updated.push_str(registration);
   00758|     updated
   00759| }
