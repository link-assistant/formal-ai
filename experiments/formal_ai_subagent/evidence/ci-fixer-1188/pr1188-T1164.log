   00761| fn compact_registration_edit(source: &str, registration: &str) -> Option<(String, String)> {
   00762|     const MAX_SUFFIX_BYTES: usize = 4096;
   00763|     let mut starts = source
   00764|         .match_indices('\n')
   00765|         .map(|(index, _)| index + 1)
   00766|         .filter(|start| *start < source.len())
   00767|         .collect::<Vec<_>>();
   00768|     starts.insert(0, 0);
   00769|     for start in starts.into_iter().rev() {
   00770|         let suffix = &source[start..];
   00771|         if suffix.len() > MAX_SUFFIX_BYTES {
   00772|             break;
   00773|         }
   00774|         if source.match_indices(suffix).count() != 1 {
   00775|             continue;
   00776|         }
   00777|         let mut replacement = suffix.to_owned();
   00778|         if !replacement.ends_with('\n') {
   00779|             replacement.push('\n');
   00780|         }
   00781|         replacement.push_str(registration);
   00782|         return Some((suffix.to_owned(), replacement));
   00783|     }
   00784|     None
   00785| }
