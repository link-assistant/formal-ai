   00938| pub(super) fn plan_digest_verification(
   00939|     task: &str,
   00940|     current_turn: &[ChatMessage],
   00941|     tool_names: &[&str],
   00942|     change: &VerifiedChange<'_>,
   00943| ) -> Option<AgenticPlan> {
   00944|     let command = ["sha256sum -- ", change.target].concat();
   00945|     let Some(observed) = result_for_command(current_turn, &command) else {
   00946|         let tool = tool_for(tool_names, Capability::Run)?;
   00947|         return Some(plan_one(tool, json!({"command": command}).to_string()));
   00948|     };
   00949|     let digest = crate::source_fetch::sha256_hex(change.expected.as_bytes());
   00950|     if observed.split_whitespace().next() != Some(digest.as_str()) {
   00951|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00952|             "coding_workspace_verification_failed",
   00953|             task,
   00954|             change.target,
   00955|         )?));
   00956|     }
   00957|     Some(AgenticPlan::Final(render_seeded_change(
   00958|         change.intent,
   00959|         task,
   00960|         change.target,
   00961|         change.slots,
   00962|     )?))
   00963| }
