   00504| fn rewritten_source(source: &str, rewrite: &GroundedRewrite) -> Option<String> {
   00505|     if rewrite.single_pass {
   00506|         return source
   00507|             .contains(rewrite.pattern.as_str())
   00508|             .then(|| source.replace(rewrite.pattern.as_str(), &rewrite.replacement));
   00509|     }
   00510|     if rewrite.unique {
   00511|         let (start, old, new) = anchored_lines(source, rewrite)?;
   00512|         return Some([&source[..start], new.as_str(), &source[start + old.len()..]].concat());
   00513|     }
   00514|     execute_scoped_workspace_rewrite(
   00515|         source,
   00516|         &rewrite.pattern,
   00517|         &rewrite.replacement,
   00518|         rewrite.scope,
   00519|     )
   00520|     .ok()
   00521|     .map(|execution| execution.output)
   00522| }
   00523| 
   00524| /// A positional insertion's one anchor occurrence widened to the whole lines
   00525| /// it sits on, as `(start, old_lines, new_lines)`, or `None` unless the anchor
   00526| /// occurs exactly once. The inserted text is a line, so an anchor that is only
   00527| /// part of a line (`after the line containing '| T20 |'`) must not split it.
   00528| fn anchored_lines(source: &str, rewrite: &GroundedRewrite) -> Option<(usize, String, String)> {
   00529|     let (pattern, replacement) = (rewrite.pattern.as_str(), rewrite.replacement.as_str());
   00530|     let mut found = source.match_indices(pattern).map(|(at, _)| at);
   00531|     let (Some(at), None) = (found.next(), found.next()) else {
   00532|         return None;
   00533|     };
   00534|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00535|     let tail = at + pattern.len();
   00536|     let end = if pattern.ends_with('\n') {
   00537|         tail - 1
   00538|     } else {
   00539|         source[tail..]
   00540|             .find('\n')
   00541|             .map_or(source.len(), |newline| tail + newline)
   00542|     };
   00543|     let old = &source[start..end];
   00544|     let new = replacement.strip_prefix(pattern).map_or_else(
   00545|         || [&replacement[..replacement.len() - pattern.len()], old].concat(),
   00546|         |rest| [old, rest].concat(),
   00547|     );
   00548|     Some((start, old.to_owned(), new))
   00549| }
   00550| 
   00551| /// The smallest run of whole lines holding every change from `source` to
   00552| /// `updated`, as an edit pair, when that run occurs once in `source`.
   00553| pub(super) fn changed_lines_edit(source: &str, updated: &str) -> Option<(String, String)> {
   00554|     const MAX_EDIT_BYTES: usize = 4096;
   00555|     let prefix = source
   00556|         .bytes()
   00557|         .zip(updated.bytes())
   00558|         .take_while(|(left, right)| left == right)
   00559|         .count();
   00560|     let limit = source.len().min(updated.len()) - prefix;
   00561|     let suffix = source
   00562|         .bytes()
   00563|         .rev()
   00564|         .zip(updated.bytes().rev())
   00565|         .take(limit)
   00566|         .take_while(|(left, right)| left == right)
   00567|         .count();
   00568|     // Byte positions only meet `\n`, so `start` and `end` fall on line -- and
   00569|     // therefore character -- boundaries even when the first or last differing
   00570|     // byte sits inside a multi-byte character.
   00571|     let bytes = source.as_bytes();
   00572|     let line_start = |before: usize| {
   00573|         bytes[..before]
   00574|             .iter()
   00575|             .rposition(|byte| *byte == b'\n')
   00576|             .map_or(0, |at| at + 1)
   00577|     };
   00578|     let mut start = line_start(prefix);
   00579|     let end = bytes[source.len() - suffix..]
   00580|         .iter()
   00581|         .position(|byte| *byte == b'\n')
   00582|         .map_or(source.len(), |at| source.len() - suffix + at);
   00583|     // Lines inserted between two lines change none: the line above carries
   00584|     // them.
   00585|     if start == end && start > 0 {
   00586|         start = line_start(start - 1);
   00587|     }
   00588|     let old = &source[start..end];
   00589|     let new = &updated[start..updated.len() - (source.len() - end)];
   00590|     (!old.is_empty() && old.len() <= MAX_EDIT_BYTES && source.matches(old).count() == 1)
   00591|         .then(|| (old.to_owned(), new.to_owned()))
   00592| }
   00593| 
   00594| /// `Insert 'x' after the line 'y' in f`: the anchor line, replaced once by the
   00595| /// anchor beside the new line, stated by the position meaning that placed it.
   00596| fn grounded_positional_insert(task: &str) -> Option<GroundedRewrite> {
   00597|     let (target, anchor, replacement) = super::positional_edit::compose_positional_insert(task)?;
   00598|     let after_anchor = [anchor.as_str(), "\n"].concat();
   00599|     let (after, inserted) = if let Some(inserted) = replacement.strip_prefix(&after_anchor) {
   00600|         (true, inserted.to_owned())
   00601|     } else {
   00602|         let before_anchor = ["\n", anchor.as_str()].concat();
   00603|         (false, replacement.strip_suffix(&before_anchor)?.to_owned())
   00604|     };
   00605|     let intent = super::positional_edit::insert_intent(after, &inserted);
   00606|     Some(GroundedRewrite {
   00607|         target,
   00608|         stated: Some((
   00609|             intent,
   00610|             vec![(NEW_SLOT, inserted), (ANCHOR_SLOT, anchor.clone())],
   00611|         )),
   00612|         pattern: anchor,
   00613|         replacement,
   00614|         scope: RewriteScope::Substring,
   00615|         renaming: false,
   00616|         unique: true,
   00617|         single_pass: false,
   00618|         verbatim: None,
   00619|     })
   00620| }
   00621| 
   00622| /// Every insert the request asks for, each its own anchored edit.
   00623| ///
   00624| /// Several clauses (`…, and insert …`), an anchor named by the line it
   00625| /// follows (T31, T34), lines rebased on the anchor (G16), or one insert whose
   00626| /// anchor is a whole line also found inside others (`the line 'b'`).
   00627| fn insert_sequence(task: &str) -> Option<Vec<PositionalInsert>> {
   00628|     super::positional_edit::positional_inserts(task)
   00629| }
   00630| 
   00631| fn grounded_rewrite(task: &str) -> Option<GroundedRewrite> {
   00632|     if let Some(positional) = grounded_positional_insert(task) {
   00633|         return Some(positional);
   00634|     }
   00635|     let (target, old_clause, new_clause) = compose_edit_request(task)?;
   00636|     let renaming = seed::lexicon().mentions_role(
   00637|         seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00638|         &task.to_lowercase(),
   00639|     );
   00640|     // A request that names a line replaces whole lines
   00641|     // (`grounded_line_replacement`).
   00642|     if !renaming && super::workspace_computed_change::names_line(task) {
   00643|         return None;
   00644|     }
   00645|     // Both operands have to be literals the request actually quoted, so prose
   00646|     // ("replace the old header with something clearer") is never rewritten as
   00647|     // bytes. What that cannot be is a count: requiring the request to hold
   00648|     // *exactly* two quoted segments made every other pair of delimiters in the
   00649|     // prompt disqualify the edit, and this repository's own prose backticks the
   00650|     // file it names. The issue #1028 ladder node "In the file
   00651|     // `src/protocol_memory.rs`, replace \"request_history\" with
   00652|     // \"conversation_history\"" quotes three things and states one replacement.
   00653|     // Asking whether each clause *is* quoted keeps the guarantee and drops the
   00654|     // arithmetic.
   00655|     // The edit request unescapes `\n` / `\t` in its literals, so the quoted
   00656|     // segments are compared unescaped too: a multi-line replacement written
   00657|     // with `\n` was otherwise not "quoted", and the general fallback wrote its
   00658|     // new text over the whole file (PR #1188 sub-agent gap 3).
   00659|     let quoted: Vec<String> = quoted_segments(task)
   00660|         .iter()
   00661|         .map(String::as_str)
   00662|         .map(super::positional_edit::unescape_prose_newlines)
   00663|         .collect();
   00664|     // A literal quoted whole counts even when backtick spans inside it pair
   00665|     // among themselves (PR #1188 G63).
   00666|     let is_quoted =
   00667|         |value: &String| quoted.contains(value) || crate::normal_markov::quotes_whole(task, value);
   00668|     let operands = if is_quoted(&old_clause) && is_quoted(&new_clause) {
   00669|         Some((old_clause, new_clause))
   00670|     } else if renaming {
   00671|         Some((
   00672|             identifier_tokens(&old_clause).next_back()?.to_owned(),
   00673|             identifier_tokens(&new_clause).next()?.to_owned(),
   00674|         ))
   00675|     } else {
   00676|         None
   00677|     }?;
   00678|     let (old, new) = operands;
   00679|     let as_quoted = |text: &str| {
   00680|         quoted_segments(task)
   00681|             .into_iter()
   00682|             .find(|raw| raw != text && super::positional_edit::unescape_prose_newlines(raw) == text)
   00683|             .unwrap_or_else(|| text.to_owned())
   00684|     };
   00685|     let verbatim = (as_quoted(&old) != old || as_quoted(&new) != new)
   00686|         .then(|| (as_quoted(&old), as_quoted(&new)));
   00687|     // A rename names a *word*, so the edit is word-scoped whichever way the
   00688|     // request spelled its operands. Without that scope the most ordinary rename
   00689|     // there is -- giving a name a prefix or a suffix -- has to be refused, since
   00690|     // an unanchored substring rewrite that reintroduces its own pattern never
   00691|     // terminates.
   00692|     //
   00693|     // A word replaced by a longer word that contains it (`smal` → `small`, a
   00694|     // typo fix) is only safe word by word for the same reason.
   00695|     let words = is_identifier_word(&old) && is_identifier_word(&new);
   00696|     let scope = if words && (renaming || new.contains(&old)) {
   00697|         RewriteScope::Word
   00698|     } else {
   00699|         RewriteScope::Substring
   00700|     };
   00701|     if old.is_empty() || old == new {
   00702|         return None;
   00703|     }
   00704|     // A new text holding the old one (`key 3` → `key 33`) is replaced in one
   00705|     // pass over the file, never rewritten again inside its own result (PR
   00706|     // #1188 G78).
   00707|     let single_pass = scope == RewriteScope::Substring && new.contains(&old);
   00708|     Some(GroundedRewrite {
   00709|         target,
   00710|         pattern: old,
   00711|         replacement: new,
   00712|         scope,
   00713|         renaming: renaming && scope == RewriteScope::Word,
   00714|         unique: false,
   00715|         single_pass,
   00716|         stated: None,
   00717|         verbatim,
   00718|     })
   00719| }
