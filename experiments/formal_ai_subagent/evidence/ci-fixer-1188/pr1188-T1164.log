   00483| /// The file after `rewrite`, or `None` when it cannot apply. A positional
   00484| /// insertion replaces its one anchor occurrence; an anchor found zero or
   00485| /// several times does not say where the line goes.
   00486| /// The rewrite as the request wrote it, when the file holds no unescaped
   00487| /// pattern but holds the pattern as written (source code quoting `'\n'`,
   00488| /// PR #1188 G65).
   00489| fn as_written(source: &str, rewrite: &GroundedRewrite) -> Option<GroundedRewrite> {
   00490|     let (pattern, replacement) = rewrite.verbatim.clone()?;
   00491|     if (rewrite.pattern != pattern && source.contains(&rewrite.pattern))
   00492|         || !source.contains(&pattern)
   00493|     {
   00494|         return None;
   00495|     }
   00496|     Some(GroundedRewrite {
   00497|         pattern,
   00498|         replacement,
   00499|         verbatim: None,
   00500|         ..rewrite.clone()
   00501|     })
   00502| }
