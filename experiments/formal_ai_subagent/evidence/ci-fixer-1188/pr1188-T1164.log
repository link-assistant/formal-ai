   00226|     if let Some((target, _)) = super::workspace_line_operation::named_target_and_payloads(task)
   00227|         && !targets.contains(&target)
   00228|     {
   00229|         targets.push(target);
   00230|     }
   00231|     targets.iter().any(|target| {
   00232|         [
