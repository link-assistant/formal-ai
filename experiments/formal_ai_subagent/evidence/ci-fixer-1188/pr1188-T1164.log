   00321|             task,
   00322|             current_turn,
   00323|             tool_names,
   00324|             &VerifiedChange {
   00325|                 target: &rewrite.target,
   00326|                 expected: &updated,
   00327|                 intent: rewrite.stated_intent(),
   00328|                 slots: &rewrite.stated_slots(),
   00329|             },
   00330|         );
   00331|     }
   00332| 
   00333|     if result_for_path(
   00334|         current_turn,
   00335|         Capability::Write,
   00336|         &rewrite.target,
   00337|         Some(&updated),
   00338|     )
   00339|     .is_none()
   00340|     {
   00341|         let tool = tool_for(tool_names, Capability::Write)?;
