   00723| fn composite_module_change(task: &str) -> Option<CompositeModuleChange> {
   00724|     let lowered = task.to_lowercase();
   00725|     if !seed::lexicon().mentions_role(seed::ROLE_CODING_MODULE_REGISTRATION_ACTION, &lowered) {
   00726|         return None;
   00727|     }
   00728|     let generated = rust_source_for_task(task)?;
   00729|     let registration_path = rust_paths(task)
   00730|         .into_iter()
   00731|         .find(|path| path != &generated.path)?;
   00732|     let module = generated.path.rsplit('/').next()?.strip_suffix(".rs")?;
   00733|     if !valid_identifier(module) {
   00734|         return None;
   00735|     }
   00736|     let registration =
   00737|         render_rust_template("coding_source_module_registration", &[("{module}", module)])?;
   00738|     Some(CompositeModuleChange {
   00739|         source_path: generated.path,
   00740|         source: generated.content,
   00741|         registration_path,
   00742|         registration,
   00743|     })
