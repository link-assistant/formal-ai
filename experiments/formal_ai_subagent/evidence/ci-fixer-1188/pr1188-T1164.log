   00299|                 return Some(plan_one(tool, edit_arguments(&rewrite.target, &old, &new)));
   00300|             }
   00301|             return plan_digest_verification(
   00302|                 task,
   00303|                 current_turn,
   00304|                 tool_names,
   00305|                 &VerifiedChange {
   00306|                     target: &rewrite.target,
   00307|                     expected: &updated,
   00308|                     intent: rewrite.stated_intent(),
   00309|                     slots: &rewrite.stated_slots(),
   00310|                 },
   00311|             );
   00312|         }
   00313|     } else if tool_for(tool_names, Capability::Edit).is_some()
   00314|         && let Some(command) = repeated_identifier_rewrite_command(rewrite)
   00315|         && let Some(tool) = tool_for(tool_names, Capability::Run)
   00316|     {
   00317|         if result_for_command(current_turn, &command).is_none() {
   00318|             return Some(plan_one(tool, json!({"command": command}).to_string()));
   00319|         }
