   00904|             && argument_matches(&value, &["newString", "new_string", "new_str", "new"], new)
   00905|     })
   00906| }
   00907| 
   00908| fn argument_matches_path(value: &Value, expected: &str) -> bool {
   00909|     ["path", "filePath", "file_path"].iter().any(|key| {
   00910|         value
   00911|             .get(key)
   00912|             .and_then(Value::as_str)
   00913|             .is_some_and(|observed| workspace_path_matches(expected, observed))
   00914|     })
   00915| }
   00916| 
   00917| fn argument_matches(value: &Value, keys: &[&str], expected: &str) -> bool {
   00918|     keys.iter()
   00919|         .any(|key| value.get(key).and_then(Value::as_str) == Some(expected))
   00920| }
   00921| 
   00922| fn workspace_path_matches(expected: &str, observed: &str) -> bool {
   00923|     if observed == expected {
   00924|         return true;
   00925|     }
   00926|     let expected = Path::new(expected);
   00927|     let observed = Path::new(observed);
   00928|     expected.is_relative() && observed.is_absolute() && observed.ends_with(expected)
   00929| }
