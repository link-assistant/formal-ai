   00965| fn matching_result(
   00966|     messages: &[ChatMessage],
   00967|     matches: impl Fn(&str, &str) -> bool,
   00968| ) -> Option<String> {
   00969|     messages
   00970|         .iter()
   00971|         .enumerate()
   00972|         .rev()
   00973|         .find_map(|(index, message)| {
   00974|             if !message.role.eq_ignore_ascii_case("tool") {
   00975|                 return None;
   00976|             }
   00977|             let id = message.tool_call_id.as_deref()?;
   00978|             let call = messages[..index]
   00979|                 .iter()
   00980|                 .rev()
   00981|                 .flat_map(|prior| prior.tool_calls.iter().rev())
   00982|                 .find(|call| call.id == id)?;
   00983|             matches(&call.function.name, &call.function.arguments)
   00984|                 .then(|| message.content.plain_text())
   00985|         })
   00986| }
