   00863| pub(super) fn result_for_path(
   00864|     messages: &[ChatMessage],
   00865|     capability: Capability,
   00866|     path: &str,
   00867|     expected_content: Option<&str>,
   00868| ) -> Option<String> {
   00869|     matching_result(messages, |name, arguments| {
   00870|         if tool_capability(name) != Some(capability) {
   00871|             return false;
   00872|         }
   00873|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
   00874|             return false;
   00875|         };
   00876|         let matches_path = ["path", "filePath", "file_path"].iter().any(|key| {
   00877|             value
   00878|                 .get(key)
   00879|                 .and_then(Value::as_str)
   00880|                 .is_some_and(|observed| workspace_path_matches(path, observed))
   00881|         });
   00882|         matches_path
   00883|             && expected_content.is_none_or(|expected| {
   00884|                 value.get("content").and_then(Value::as_str) == Some(expected)
   00885|             })
   00886|     })
   00887| }
