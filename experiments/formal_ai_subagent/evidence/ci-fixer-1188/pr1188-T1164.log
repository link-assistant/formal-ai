   00787| fn repeated_identifier_rewrite_command(rewrite: &GroundedRewrite) -> Option<String> {
   00788|     if !shell_safe_identifier(&rewrite.pattern) || !shell_safe_identifier(&rewrite.replacement) {
   00789|         return None;
   00790|     }
   00791|     // The in-memory execution and the command the client runs have to agree on
   00792|     // what a match is, so a word-scoped rewrite asks for whole words too.
   00793|     let pattern = match rewrite.scope {
   00794|         RewriteScope::Substring => rewrite.pattern.clone(),
   00795|         RewriteScope::Word => format!("\\b{}\\b", rewrite.pattern),
   00796|     };
   00797|     // `perl -pi -e`, not `sed -i` (issue #1110). GNU and BSD sed disagree about
   00798|     // both halves of that command: BSD `-i` reads the script as its backup
   00799|     // suffix, and BSD sed has no `\b`. On macOS every rename therefore failed
   00800|     // with `bad flag in substitute command`, the file was left unchanged, and
   00801|     // Formal AI reported the mismatch as its own verification failure -- a
   00802|     // confident failure report instead of a rename. perl's `-pi -e` and `\b`
   00803|     // mean the same thing on both, and perl ships with macOS and the runners.
   00804|     // Both identifiers are `[A-Za-z0-9_]` by `shell_safe_identifier`, so
   00805|     // neither side can carry a regex or shell metacharacter.
   00806|     // Assembled from named parts rather than one template string: the prose
   00807|     // detector reads `perl -pi -e ...` as a multi-word phrase (two alphabetic
   00808|     // runs, one of three letters) and would have it live in `data/seed`, which
   00809|     // is the wrong home for a shell invocation. Naming the pieces says what
   00810|     // each is, and none of them reads as a sentence.
   00811|     let script = format!("'s/{pattern}/{}/g'", rewrite.replacement);
   00812|     Some(["perl", "-pi", "-e", &script, "--", &rewrite.target].join(" "))
   00813| }
   00814| 
   00815| fn shell_safe_identifier(identifier: &str) -> bool {
   00816|     !identifier.is_empty()
   00817|         && identifier
   00818|             .chars()
   00819|             .all(|character| character.is_ascii_alphanumeric() || character == '_')
   00820| }
   00821| 
   00822| pub(super) fn identifier_tokens(text: &str) -> impl DoubleEndedIterator<Item = &str> {
   00823|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00824|         .filter(|token| valid_identifier(token))
   00825| }
   00826| 
   00827| fn valid_identifier(identifier: &str) -> bool {
   00828|     let mut characters = identifier.chars();
   00829|     characters
   00830|         .next()
   00831|         .is_some_and(|first| first.is_ascii_alphabetic() || first == '_')
   00832|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00833|         && !seed::lexicon()
   00834|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00835|             .iter()
   00836|             .any(|reserved| reserved == identifier)
   00837| }
