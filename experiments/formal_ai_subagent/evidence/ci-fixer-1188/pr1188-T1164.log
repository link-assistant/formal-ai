   00889| pub(super) fn result_for_edit(
   00890|     messages: &[ChatMessage],
   00891|     path: &str,
   00892|     old: &str,
   00893|     new: &str,
   00894| ) -> Option<String> {
   00895|     matching_result(messages, |name, arguments| {
   00896|         if tool_capability(name) != Some(Capability::Edit) {
