   00284|     const argumentBefore = new Set();
   00285|     let inverse = null;
   00286|     for (const child of operationNode.children) {
   00287|       if (child.name === "inverse") inverse = child.value;
   00288|       else if (child.name === "language") {
   00289|         const before = child.children.some((form) => form.name === "argument" && form.value === "before");
