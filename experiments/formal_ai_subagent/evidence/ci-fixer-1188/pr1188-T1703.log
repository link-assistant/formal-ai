   01262| function parseLinoValue(raw) {
   01263|   const trimmed = raw.trim(); // a backtick string unescapes as a double-quoted one (decode_quoted_reference)
   01264|   if (trimmed.length >= 2 && ['"', "`"].some((quote) => trimmed.startsWith(quote) && trimmed.endsWith(quote))) {
   01265|     return unescapeLinoValue(trimmed.slice(1, -1));
   01266|   }
   01267|   if (trimmed.length >= 2 && trimmed.startsWith("'") && trimmed.endsWith("'")) {
   01268|     return unescapeSingleLinoValue(trimmed.slice(1, -1));
   01269|   }
   01270|   return decodeRawReference(trimmed);
   01271| }
