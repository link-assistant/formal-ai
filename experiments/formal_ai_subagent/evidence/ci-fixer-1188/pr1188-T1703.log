   00150|     ["en", "ru"],
   00151|   );
   00152|   const languageNouns = wordsForRoleInLanguages(
   00153|     ROLE_IMPLEMENTATION_LANGUAGE_NOUN,
   00154|     ["en", "ru"],
   00155|   );
   00156|   const functionWords = wordsForRoleInLanguages(ROLE_STATEMENT_FUNCTION_WORD, [
   00157|     "en",
   00158|     "ru",
   00159|     "hi",
   00160|     "zh",
   00161|   ]);
