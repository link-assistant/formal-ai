   00830| function detectIncompatibleUnitPair(normalized) {
   00831|   const found = [];
   00832|   for (const unit of meaningsWithRole(ROLE_MEASUREMENT_UNIT)) {
   00833|     const dimension = dimensionLabelForUnit(unit);
   00834|     if (!dimension || found.some((entry) => entry.dimension === dimension)) {
   00835|       continue;
   00836|     }
   00837|     const matched = unit.words.find((word) => containsUnitWord(normalized, word));
   00838|     if (matched) {
   00839|       found.push({ unit: matched, dimension });
   00840|     }
   00841|   }
   00842|   if (found.length < 2) return null;
   00843|   return [found[0], found[1]];
   00844| }
