   00172|         namedByNoun = true;
   00173|         cursor += 1;
   00174|         continue;
   00175|       }
   00176|       if (
   00177|         functionWords.includes(tokens[cursor]) &&
   00178|         !knownImplementationLanguage(tokens[cursor])
