   00291|           if (form.name === "phrase") {
   00292|             phrases.push(form.value);
   00293|             if (before) argumentBefore.add(form.value);
   00294|           } else if (form.name === "unit") units.push(form.value);
   00295|           else if (form.name === "members") members.push(form.value);
   00296|           else if (form.name === "exclude") exclusions.push(form.value);
   00297|           else if (form.name === "combo") {
   00298|             combos.push(
   00299|               form.value
   00300|                 .split("+")
   00301|                 .map((token) => token.trim())
   00302|                 .filter(Boolean),
   00303|             );
   00304|           }
   00305|         }
   00306|       }
