   01229| function stripLinoComment(line) {
   01230|   // Mirrors rust/src/seed/parser.rs strip_comment: any of the three quote
   01231|   // characters opens a string the comment rule must not see into, a doubled
   01232|   // single quote is an escape, and a backslash escapes inside double quotes
   01233|   // and backticks.
   01234|   let quote = null;
   01235|   let escaped = false;
   01236|   let previousWasSpace = true;
   01237|   for (let index = 0; index < line.length; index += 1) {
   01238|     const ch = line[index];
   01239|     if (quote) {
   01240|       if (escaped) {
   01241|         escaped = false;
   01242|       } else if ((quote === '"' || quote === "`") && ch === "\\") {
   01243|         escaped = true;
   01244|       } else if (quote === "'" && ch === "'" && line[index + 1] === "'") {
   01245|         index += 1;
   01246|       } else if (ch === quote) {
   01247|         quote = null;
   01248|       }
   01249|       continue;
   01250|     }
   01251|     if (ch === '"' || ch === "'" || ch === "`") {
   01252|       quote = ch;
   01253|       previousWasSpace = false;
   01254|       continue;
   01255|     }
   01256|     if (ch === "#" && previousWasSpace) return line.slice(0, index);
   01257|     previousWasSpace = /\s/.test(ch);
   01258|   }
   01259|   return line;
   01260| }
