   00349| // Where the earliest phrase, or the earliest token of a fully present combo,
   00350| // starts in `normalized`; null when the operation is not named. Mirrors
   00351| // OperationVocabulary::position in src/seed/operation_vocabulary.rs.
   00352| function operationFirstPosition(normalized, operation) {
   00353|   const source = String(normalized || "");
   00354|   if (!operationFormMatches(source, operation)) return null;
   00355|   const positions = (operation.phrases || []).map((phrase) => source.indexOf(phrase));
   00356|   for (const combo of operation.combos || []) {
   00357|     const tokens = combo.map((token) => source.indexOf(String(token || "")));
   00358|     if (tokens.length && tokens.every((index) => index >= 0)) positions.push(Math.min(...tokens));
   00359|   }
   00360|   const found = positions.filter((index) => index >= 0);
   00361|   return found.length ? Math.min(...found) : null;
   00362| }
