   00267|   const root = parseLinoTree(OPERATION_VOCABULARY_LINO);
   00268|   const container =
   00269|     root.children.find((child) => child.name === "operation_vocabulary") || root;
   00270|   const operations = [];
   00271|   cachedCountingCues = container.children
   00272|     .filter((node) => node.name === "counting_cue")
   00273|     .flatMap((node) => node.children.flatMap((language) => language.children))
   00274|     .filter((form) => form.name === "phrase")
   00275|     .map((form) => form.value);
   00276|   for (const operationNode of container.children) {
   00277|     if (operationNode.name !== "operation") continue;
   00278|     const phrases = [];
   00279|     const combos = [];
   00280|     const exclusions = [];
   00281|     const units = [];
   00282|     const members = [];
