   00530| // Slot marker (U+2026 …) carried inside a surface word's text to mark the open
   00531| // subject/task position. Mirrors the `split_once('…')` slot derivation on
   00532| // WordForm in src/seed/meanings.rs (issue #386).
   00533| const SLOT_MARKER = "…";
   00534| 
   00535| // Build a surface form { text, action, description, slot, before, after } from a
   00536| // raw surface word, its optional canonical action, and its self-describing note.
   00537| // The slot classification and the literal text on either side are derived from
   00538| // the position of the … marker, exactly as WordForm::slot/before_slot/after_slot
   00539| // do in src/seed/meanings.rs: no marker = "bare"; trailing marker = "prefix";
   00540| // leading marker = "suffix"; a marker with text on both sides = "circumfix".
   00541| function makeWordForm(text, action, description) {
   00542|   const idx = text.indexOf(SLOT_MARKER);
   00543|   if (idx === -1) {
   00544|     return {
   00545|       text,
   00546|       action: action || "",
   00547|       description: description || "",
   00548|       slot: "bare",
   00549|       before: text,
   00550|       after: "",
   00551|     };
   00552|   }
   00553|   const before = text.slice(0, idx);
   00554|   const after = text.slice(idx + SLOT_MARKER.length);
   00555|   let slot = "bare";
   00556|   if (before && after) slot = "circumfix";
   00557|   else if (before) slot = "prefix";
   00558|   else if (after) slot = "suffix";
   00559|   return {
   00560|     text,
   00561|     action: action || "",
   00562|     description: description || "",
   00563|     slot,
   00564|     before,
   00565|     after,
   00566|   };
   00567| }
