   00686| // Does `expected` (a surface word or multi-word phrase) appear in `normalized`?
   00687| // CJK surfaces match as substrings; everything else matches on whitespace
   00688| // boundaries (whole token or whole phrase). Mirrors surface_present in
   00689| // src/seed/meanings.rs — stricter than a raw substring, so a short surface like
   00690| // "hp" never matches inside "php" and a phrase like "each step" matches only on
   00691| // word boundaries.
   00692| function surfacePresent(normalized, expected) {
   00693|   if (!expected) return false;
   00694|   const text = String(normalized || "");
   00695|   if (containsCjk(expected)) return text.includes(expected);
   00696|   return (
   00697|     text === expected ||
   00698|     text.startsWith(`${expected} `) ||
   00699|     text.endsWith(` ${expected}`) ||
   00700|     text.includes(` ${expected} `)
   00701|   );
   00702| }
   00703| 
   00704| // Is any surface word (any language) of `meaning` evidenced in `normalized`?
   00705| // Mirrors Meaning::evidenced_in in src/seed/meanings.rs.
   00706| function meaningEvidencedIn(meaning, normalized) {
   00707|   return meaning.words.some((word) => surfacePresent(normalized, word));
   00708| }
   00709| 
   00710| // Does `normalized` mention any surface word of any meaning carrying `role`?
   00711| // Mirrors Lexicon::mentions_role in src/seed/meanings.rs — the boundary-aware,
   00712| // phrase-capable surface_present contract (CJK substring vs. whitespace token).
   00713| function lexiconMentionsRole(role, normalized) {
   00714|   return meaningsWithRole(role).some((meaning) => meaningEvidencedIn(meaning, normalized));
   00715| }
   00716| 
   00717| // Like lexiconMentionsRole but ignores a meaning's script-independent *value
   00718| // surfaces* — word forms with no alphabetic character, such as the operator
   00719| // symbol "+" or the numeral "10". Those forms exist so the arithmetic normalizer
   00720| // can read a meaning's machine value; they are not spelled words, so operator-
   00721| // *word* detection skips them and a bare "+" is recognised as an operator symbol
   00722| // by the symbol scan, not double-counted here. Mirrors Lexicon::mentions_role_spelled
   00723| // in src/seed/meanings.rs.
   00724| function lexiconMentionsRoleSpelled(role, normalized) {
   00725|   return meaningsWithRole(role).some((meaning) =>
   00726|     meaning.words
   00727|       .filter((word) => /\p{Alphabetic}/u.test(word))
   00728|       .some((word) => surfacePresent(normalized, word)),
   00729|   );
   00730| }
   00731| 
   00732| // The first meaning (declaration order) carrying `role` that is evidenced in
   00733| // `normalized`, or null. Declaration order encodes priority. Mirrors
   00734| // Lexicon::first_role_match in src/seed/meanings.rs.
   00735| function firstRoleMatch(role, normalized) {
   00736|   return meaningsWithRole(role).find((meaning) => meaningEvidencedIn(meaning, normalized)) || null;
   00737| }
