   00180|         skippedFunctionWord = true;
   00181|         cursor += 1;
   00182|         continue;
   00183|       }
   00184|       break;
   00185|     }
   00186|     const candidate = tokens[cursor];
   00187|     if (!candidate) continue;
   00188|     let end = cursor + 1;
   00189|     // "in the elvish language" names the noun after the candidate.
   00190|     if (languageNouns.includes(tokens[end])) {
   00191|       namedByNoun = true;
   00192|       end += 1;
   00193|     }
