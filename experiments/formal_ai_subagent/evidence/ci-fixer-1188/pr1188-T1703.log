   00647| function childValue(node, name) {
   00648|   const child = (node.children || []).find((candidate) => candidate.name === name);
   00649|   return child ? child.value : "";
   00650| }
   00651| 
   00652| function meaningSlug(node) {
   00653|   return node.name === "meaning" ? node.value : node.name;
   00654| }
   00655| 
   00656| function lexemeLanguage(node) {
   00657|   return childValue(node, "language") || node.value || "";
   00658| }
   00659| 
   00660| function decodeCodepoints(raw) {
   00661|   return String(raw || "")
   00662|     .split(/\s+/)
   00663|     .filter(Boolean)
   00664|     .map((part) => {
   00665|       const trimmed = part.trim();
   00666|       const radix = /^0x/i.test(trimmed) ? 16 : 10;
   00667|       const parsed = parseInt(radix === 16 ? trimmed.slice(2) : trimmed, radix);
   00668|       return String.fromCodePoint(Number.isFinite(parsed) ? parsed : 0);
   00669|     })
   00670|     .join("");
   00671| }
   00672| 
   00673| function surfaceText(node) {
   00674|   // Issue #398: surfaces now carry a readable `text` child; the legacy
   00675|   // `codepoints` byte-dump is still decoded for backward compatibility.
   00676|   const text = childValue(node, "text");
   00677|   if (text) return text;
   00678|   const codepoints = childValue(node, "codepoints");
   00679|   return codepoints ? decodeCodepoints(codepoints) : node.value;
   00680| }
   00681| 
   00682| function generatedWordDescription(parentMeaning, text) {
   00683|   return text ? `${text} denotes ${parentMeaning}` : parentMeaning;
   00684| }
