   00762| // Every meaning carrying `role`, in lexicon (declaration) order. Mirrors
   00763| // Lexicon::meanings_with_role in src/seed/meanings.rs.
   00764| function meaningsWithRole(role) {
   00765|   return meaningLexicon().filter((meaning) => meaning.roles.includes(role));
