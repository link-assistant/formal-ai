   00935|     if (
   00936|       !best ||
   00937|       span[0] < best[0] ||
   00938|       (span[0] === best[0] && span[1] > best[1])
   00939|     ) {
   00940|       best = span;
   00941|     }
   00942|   }
   00943|   return best;
   00944| }
