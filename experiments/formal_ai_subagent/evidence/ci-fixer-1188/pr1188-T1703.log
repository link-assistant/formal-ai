   00903| // Leftmost boundary-aware [start, end) span of `surface` within `haystack`, or
   00904| // null. Mirrors surface_span: a CJK surface matches as a substring (no
   00905| // inter-word spaces); a space-delimited surface must be a whole whitespace token
   00906| // or phrase bounded by the string ends or by spaces.
   00907| function memorySurfaceSpan(haystack, surface) {
   00908|   if (!surface) return null;
   00909|   if (containsCjk(surface)) {
   00910|     const start = haystack.indexOf(surface);
   00911|     return start === -1 ? null : [start, start + surface.length];
   00912|   }
   00913|   let search = 0;
   00914|   while (search <= haystack.length) {
   00915|     const rel = haystack.slice(search).indexOf(surface);
   00916|     if (rel === -1) return null;
   00917|     const start = search + rel;
   00918|     const end = start + surface.length;
   00919|     const leftOk = start === 0 || haystack[start - 1] === " ";
   00920|     const rightOk = end === haystack.length || haystack[end] === " ";
   00921|     if (leftOk && rightOk) return [start, end];
   00922|     search = start + 1;
   00923|   }
   00924|   return null;
   00925| }
