   01322| function parseCrudEvent(value) {
   01323|   const map = {
   01324|     manual: "manual",
   01325|     apply: "manual",
   01326|     create: "create",
   01327|     created: "create",
   01328|     read: "read",
   01329|     select: "read",
   01330|     query: "read",
   01331|     update: "update",
   01332|     updated: "update",
   01333|     delete: "delete",
   01334|     deleted: "delete",
   01335|   };
   01336|   const key = String(value).trim().toLowerCase();
   01337|   if (!map[key]) throw new Error(`invalid CRUD event: ${value}`);
   01338|   return map[key];
   01339| }
