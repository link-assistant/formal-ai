   01161| function unescapeLinoValue(value) {
   01162|   let out = "";
   01163|   for (let index = 0; index < value.length; index += 1) {
   01164|     const ch = value[index];
   01165|     // Links Notation doubles a delimiter to escape it; the seed corpus now
   01166|     // writes that canonical form, so both dialects are read.
   01167|     if (ch === '"' && value[index + 1] === '"') {
   01168|       out += '"';
   01169|       index += 1;
   01170|       continue;
   01171|     }
   01172|     if (ch === "\\" && index + 1 < value.length) {
   01173|       const next = value[index + 1];
   01174|       if (next === "n" || next === "t" || next === "r") {
   01175|         out += { n: "\n", t: "\t", r: "\r" }[next];
   01176|         index += 1;
   01177|         continue;
   01178|       }
   01179|       if (next === '"' || next === "\\") {
   01180|         out += next;
   01181|         index += 1;
   01182|         continue;
   01183|       }
   01184|     }
   01185|     out += ch;
   01186|   }
   01187|   return out;
   01188| }
   01189| 
   01190| function unescapeSingleLinoValue(value) {
   01191|   let out = "";
   01192|   for (let index = 0; index < value.length; index += 1) {
   01193|     const ch = value[index];
   01194|     if (ch === "\\" && index + 1 < value.length) {
   01195|       const next = value[index + 1];
   01196|       if (next === "n") {
   01197|         out += "\n";
   01198|         index += 1;
   01199|         continue;
   01200|       }
   01201|       if (next === "\\") {
   01202|         out += "\\";
   01203|         index += 1;
   01204|         continue;
   01205|       }
   01206|       if (next === "x" && value.slice(index + 2, index + 4) === "27") {
   01207|         out += "'";
   01208|         index += 3;
   01209|         continue;
   01210|       }
   01211|     }
   01212|     out += ch;
   01213|   }
   01214|   return out;
   01215| }
