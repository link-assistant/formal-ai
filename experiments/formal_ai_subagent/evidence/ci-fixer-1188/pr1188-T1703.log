   00805| // Mirrors contains_unit_word in src/solver_handler_units.rs: ASCII and CJK unit
   00806| // surfaces need alphabetic boundaries so "gram" inside "program" and "克" inside
   00807| // an unrelated CJK compound do not count, while inflected alphabetic scripts can
   00808| // still match suffix forms such as Russian "килограмм" in "килограмме".
   00809| function containsUnitWord(normalized, unit) {
   00810|   if (!unit) return false;
   00811|   const text = String(normalized || "");
   00812|   if (!/[^\x00-\x7F]/.test(unit) || containsCjk(unit)) {
   00813|     let searchFrom = 0;
   00814|     while (searchFrom <= text.length) {
   00815|       const start = text.indexOf(unit, searchFrom);
   00816|       if (start < 0) return false;
   00817|       const end = start + unit.length;
   00818|       const before = Array.from(text.slice(0, start)).pop() || "";
   00819|       const after = Array.from(text.slice(end))[0] || "";
   00820|       if (!isAlphabeticCharacter(before) && !isAlphabeticCharacter(after)) {
   00821|         return true;
   00822|       }
   00823|       searchFrom = end;
   00824|     }
   00825|     return false;
   00826|   }
   00827|   return text.includes(unit);
   00828| }
