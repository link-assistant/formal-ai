   01217| function decodeRawReference(raw) {
   01218|   const value = String(raw || "").trim();
   01219|   if (value === "unformalized-raw" || value === "codepoints") return "";
   01220|   if (value.startsWith("unformalized-raw ")) {
   01221|     return decodeCodepoints(value.slice("unformalized-raw ".length));
   01222|   }
   01223|   if (value.startsWith("codepoints ")) {
   01224|     return decodeCodepoints(value.slice("codepoints ".length));
   01225|   }
   01226|   return value;
   01227| }
