   01341| function parseSubstitutionRule(node) {
   01342|   const rule = { id: node.value, order: 0, events: [], conditions: [], actions: [] };
   01343|   for (const child of node.children) {
   01344|     switch (child.name) {
   01345|       case "order": {
   01346|         const parsed = parseInt(child.value, 10);
   01347|         rule.order = Number.isNaN(parsed) ? 0 : parsed;
   01348|         break;
   01349|       }
   01350|       case "event":
   01351|         rule.events.push(parseCrudEvent(child.value));
   01352|         break;
   01353|       case "when":
   01354|         rule.conditions.push(parseLinkPattern(child.value));
   01355|         break;
   01356|       case "replace": {
