   00846| function tryIncompatibleUnits(prompt, normalized) {
   00847|   const pair = detectIncompatibleUnitPair(normalized);
   00848|   if (!pair) return null;
   00849|   const [a, b] = pair;
   00850|   const content = nativeLaneRender(answerFor("unit_incompatibility", detectLanguage(prompt)),
   00851|     { unit_a: a.unit, dim_a: a.dimension, unit_b: b.unit, dim_b: b.dimension });
   00852|   return {
   00853|     intent: "unit_incompatibility",
   00854|     content,
   00855|     confidence: 1.0,
