   00569| let cachedMeaningLexicon = null;
   00570| // Parse the embedded lexicon once. Each meaning keeps the semantic roles it
   00571| // plays, the surface words (across every language) that evidence it, and the
   00572| // richer per-form data (action + self-describing note + derived slot) in
   00573| // declaration order. Mirrors parse_lexicon in src/seed/meanings.rs.
   00574| function meaningLexicon() {
   00575|   if (cachedMeaningLexicon) return cachedMeaningLexicon;
   00576|   const root = parseLinoTree(MEANINGS_LINO);
   00577|   // The lexicon is split across several files (program, units, …), each
   00578|   // wrapping its records under a top-level `meanings` node. Concatenated, the
   00579|   // document therefore holds one-or-more `meanings` containers; collect the
   00580|   // records from every one. If none is present the records sit at the document
   00581|   // root (kept for robustness). Mirrors parse_lexicon in src/seed/meanings.rs.
   00582|   const containers = root.children.filter((child) => child.name === "meanings");
   00583|   const sources = containers.length ? containers : [root];
   00584|   const meanings = [];
   00585|   for (const container of sources) {
   00586|     for (const node of container.children) {
   00587|       if (node.name === "meanings") continue;
   00588|       const slug = meaningSlug(node);
   00589|       if (!slug) continue;
   00590|       const roles = [];
   00591|       const definedBy = [];
   00592|       const words = [];
   00593|       const wordForms = [];
   00594|       // Per-language word groups, so a handler can partition a role's vocabulary
   00595|       // by language (e.g. head-initial vs. head-final translation verbs) without
   00596|       // losing the language tag the flat `words` list drops. Mirrors the
   00597|       // `lexemes` field on Meaning in src/seed/meanings.rs (issue #386).
   00598|       const lexemes = [];
   00599|       if (node.name !== "meaning" && node.value) {
   00600|         definedBy.push(...node.value.split(/\s+/).filter(Boolean));
   00601|       }
   00602|       for (const child of node.children) {
   00603|         if (child.name === "role") roles.push(child.value);
   00604|         else if (child.name === "defined_by" || child.name === "defined-by") {
   00605|           definedBy.push(child.value);
   00606|         }
   00607|         else if (child.name === "lexeme") {
   00608|           const lexemeWords = [];
   00609|           for (const lexWord of child.children) {
   00610|             if (lexWord.name !== "word" && lexWord.name !== "surface") continue;
   00611|             const text = surfaceText(lexWord);
   00612|             words.push(text);
   00613|             lexemeWords.push(text);
   00614|             let action = "";
   00615|             let description = "";
   00616|             for (const attr of lexWord.children) {
   00617|               if (attr.name === "action") action = attr.value;
   00618|               else if (attr.name === "description") description = attr.value;
   00619|             }
   00620|             wordForms.push(
   00621|               makeWordForm(text, action, description || generatedWordDescription(slug, text)),
   00622|             );
   00623|           }
   00624|           lexemes.push({ language: lexemeLanguage(child), words: lexemeWords });
   00625|         } else if (child.name === "surface") {
   00626|           const text = surfaceText(child);
   00627|           words.push(text);
   00628|           let action = "";
   00629|           let description = "";
   00630|           for (const attr of child.children) {
   00631|             if (attr.name === "action") action = attr.value;
   00632|             else if (attr.name === "description") description = attr.value;
   00633|           }
   00634|           wordForms.push(
   00635|             makeWordForm(text, action, description || generatedWordDescription(slug, text)),
   00636|           );
   00637|           lexemes.push({ language: childValue(child, "language"), words: [text] });
   00638|         }
   00639|       }
   00640|       meanings.push({ slug, roles, definedBy, words, wordForms, lexemes });
   00641|     }
   00642|   }
   00643|   cachedMeaningLexicon = meanings;
   00644|   return cachedMeaningLexicon;
   00645| }
