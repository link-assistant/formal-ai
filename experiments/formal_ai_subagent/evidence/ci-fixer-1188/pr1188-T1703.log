   00792| function dimensionLabelForUnit(unit) {
   00793|   for (const slug of unit.definedBy || []) {
   00794|     const dimension = findMeaning(slug);
   00795|     if (!dimension || !dimension.roles.includes(ROLE_PHYSICAL_DIMENSION)) continue;
   00796|     return wordInLanguage(dimension, "en") || dimension.words[0] || null;
   00797|   }
   00798|   return null;
   00799| }
