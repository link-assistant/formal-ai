   01303| function parsePatternNode(text) {
   01304|   if (!text) throw new Error("pattern node is empty");
   01305|   if (text.startsWith("$")) return { kind: "variable", variable: text.slice(1) };
   01306|   const dollar = text.indexOf("$");
   01307|   if (dollar !== -1) {
   01308|     return { kind: "prefix", prefix: text.slice(0, dollar), variable: text.slice(dollar + 1) };
   01309|   }
   01310|   return { kind: "literal", value: text };
   01311| }
   01312| 
   01313| function parseLinkPattern(text) {
   01314|   const index = text.indexOf("->");
   01315|   if (index === -1) throw new Error(`expected \`from -> to\`, got \`${text}\``);
   01316|   return {
   01317|     from: parsePatternNode(text.slice(0, index).trim()),
   01318|     to: parsePatternNode(text.slice(index + 2).trim()),
   01319|   };
   01320| }
