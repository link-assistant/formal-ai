   00212| function programLanguageFromPrompt(normalized) {
   00213|   const delimited = normalized.replace(/(\p{Script=Han})(?=[a-z0-9])|([a-z0-9])(?=\p{Script=Han})/giu, "$1$2 ");
   00214|   const tokens = delimited.split(/\s+/).filter(Boolean);
   00215|   // Each language's alias surfaces live in its `program_language_<slug>` meaning,
   00216|   // not inline on WRITE_PROGRAM_LANGUAGES — read them by slug (issue #386). Names
   00217|   // are single tokens, matched on whitespace boundaries exactly as in Rust.
   00218|   //
   00219|   // Framework targets are consulted first, mirroring `program_language_by_alias`:
   00220|   // a request that names both a framework and the language it is written in —
   00221|   // `напиши мне код на PHP Laravel`, issue #723 — names the framework, and
   00222|   // answering in the base language throws away the part of the request that was
   00223|   // hardest to satisfy.
   00224|   const slugs = Object.keys(WRITE_PROGRAM_LANGUAGES);
   00225|   const isFramework = (slug) => Boolean(WRITE_PROGRAM_LANGUAGES[slug].frameworkOf);
   00226|   for (const slug of slugs.filter(isFramework).concat(slugs.filter((s) => !isFramework(s)))) {
   00227|     const surfaces = wordsForMeaning(`program_language_${slug}`);
   00228|     if (surfaces.some((alias) => containsProgramToken(delimited, alias))) return slug;
   00229|   }
   00230|   const span = implementationLanguageSpan(tokens);
   00231|   return span ? span.name : null;
   00232| }
