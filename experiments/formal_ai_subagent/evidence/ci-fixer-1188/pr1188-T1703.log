   00059| // CJK scripts have no inter-word spaces, so the whitespace-based phrase/token
   00060| // matchers never isolate a CJK word. When the expected alias itself contains a
   00061| // CJK ideograph we fall back to a substring test (issue #312). Mirrors
   00062| // `coding::catalog::contains_cjk` on the Rust side.
   00063| function containsCjk(text) {
   00064|   return /[㐀-䶿一-鿿豈-﫿぀-ヿ㄀-ㄯ]/.test(
   00065|     String(text || ""),
   00066|   );
   00067| }
   00068| 
   00069| // Devanagari (Hindi, …) is written without spaces between words, so the
   00070| // whitespace-based phrase/token matchers never isolate a Devanagari word —
   00071| // exactly as for CJK above. Mirrors `coding::catalog::contains_devanagari` on
   00072| // the Rust side (range U+0900–U+097F): lets a handler split a role's word forms
   00073| // by script (Devanagari vs. Han) straight from the seed, so the head-final
   00074| // Hindi and Chinese extraction strategies never name a raw word (issue #386).
   00075| function containsDevanagari(text) {
   00076|   return /[ऀ-ॿ]/.test(String(text || ""));
   00077| }
   00078| 
   00079| // Whether every character of `text` is ASCII. Mirrors Rust's `str::is_ascii`:
   00080| // the calculator-domain signal builder shapes a surface differently by script,
   00081| // matching an ASCII code on a word boundary but a non-ASCII surface as a raw
   00082| // substring (issue #386).
   00083| function isAsciiText(text) {
   00084|   return /^[\x00-\x7f]*$/.test(String(text || ""));
   00085| }
   00086| 
   00087| function containsProgramToken(normalized, token) {
   00088|   if (containsCjk(token)) return String(normalized || "").includes(token);
   00089|   return String(normalized || "")
   00090|     .split(/\s+/)
   00091|     .includes(token);
   00092| }
   00093| 
   00094| // A Han character beside a Latin phrase is a word boundary (`写一个hello world程序`).
   00095| function containsProgramPhrase(normalized, phrase) {
   00096|   if (containsCjk(phrase)) return normalized.includes(phrase);
   00097|   const boundary = (character) => character === undefined || /\s/u.test(character) || containsCjk(character);
   00098|   for (let at = normalized.indexOf(phrase); at !== -1; at = normalized.indexOf(phrase, at + 1)) {
   00099|     if (boundary(normalized[at - 1]) && boundary(normalized[at + phrase.length])) return true;
   00100|   }
   00101|   return false;
   00102| }
