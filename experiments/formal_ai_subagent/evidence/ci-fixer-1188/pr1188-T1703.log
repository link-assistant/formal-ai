   01273| function parseLinoTree(text) {
   01274|   const root = { name: "", value: "", depth: -1, children: [] };
   01275|   const stack = [root];
   01276|   for (const line of text.split("\n")) {
   01277|     const stripped = stripLinoComment(line);
   01278|     if (!stripped.trim()) continue;
   01279|     const indent = stripped.length - stripped.trimStart().length;
   01280|     const depth = indent / 2;
   01281|     const rest = stripped.trim();
   01282|     const colonIndex = rest.indexOf(":");
   01283|     const whitespaceIndex = rest.search(/\s/);
   01284|     let name = "";
   01285|     let value = "";
   01286|     if (colonIndex !== -1 && (whitespaceIndex === -1 || colonIndex < whitespaceIndex)) {
   01287|       name = rest.slice(0, colonIndex).trim();
   01288|       value = parseLinoValue(rest.slice(colonIndex + 1));
   01289|     } else if (whitespaceIndex === -1) {
   01290|       name = rest;
   01291|     } else {
   01292|       name = rest.slice(0, whitespaceIndex);
   01293|       value = parseLinoValue(rest.slice(whitespaceIndex + 1));
   01294|     }
   01295|     const node = { name, value, depth, children: [] };
   01296|     while (stack.length && stack[stack.length - 1].depth >= depth) stack.pop();
   01297|     stack[stack.length - 1].children.push(node);
   01298|     stack.push(node);
   01299|   }
   01300|   return root;
   01301| }
