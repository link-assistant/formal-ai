   00340|   if ((operation.exclusions || []).some((phrase) => source.includes(phrase))) return false;
   00341|   return (
   00342|     (operation.phrases || []).some((phrase) => source.includes(phrase)) ||
   00343|     (operation.combos || []).some((combo) =>
   00344|       combo.every((token) => source.includes(String(token || ""))),
   00345|     )
   00346|   );
   00347| }
