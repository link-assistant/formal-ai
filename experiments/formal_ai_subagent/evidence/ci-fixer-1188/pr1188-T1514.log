   00118| #[test]
   00119| fn formalize_url_answers_the_statements_of_the_fetched_page_in_every_language() {
   00120|     for (prompt, summary, more) in SUMMARIES {
   00121|         let answer = answer(prompt, true);
   00122|         assert_eq!(answer.intent, "page_formalization", "{prompt}");
   00123|         let lines: Vec<&str> = answer.answer.split('\n').collect();
   00124|         assert_eq!(lines[0], *summary, "{prompt}");
   00125|         assert_eq!(lines[1], "", "{prompt}");
   00126|         assert_eq!(lines[2], FIRST_STATEMENT, "{prompt}");
   00127|         assert_eq!(lines.len(), 43, "{prompt}");
   00128|         assert_eq!(lines.last().copied(), Some(*more), "{prompt}");
   00129|     }
   00130| }
