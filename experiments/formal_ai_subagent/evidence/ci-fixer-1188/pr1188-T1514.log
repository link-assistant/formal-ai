   00001| //! R1188-U18: "formalize <url>" and "formalize this page: <url>" are answered
   00002| //! in chat, in every seeded language, with the statements of the fetched page.
   00003| //!
   00004| //! The page is fetched through the URL-fetch path's cached source client, here
   00005| //! over a fixture transport that serves the Moon page of
   00006| //! `data/benchmarks/web-formalization/en.lino`, so no test touches the
   00007| //! network. rust/tests/web/page-formalization-route.test.mjs pins the same
   00008| //! answers in the browser worker.
   00009| 
   00010| use std::path::PathBuf;
   00011| use std::sync::atomic::{AtomicUsize, Ordering};
   00012| 
   00013| use formal_ai::{
   00014|     CachedSourceClient, EventLog, FetchError, SourceTransport, try_page_formalization_with_client,
   00015| };
   00016| 
   00017| const URL_UNDER_TEST: &str = "https://en.wikipedia.org/wiki/Moon";
   00018| 
   00019| /// The bare request for the page under test.
   00020| const URL_PROMPT: &str = "formalize https://en.wikipedia.org/wiki/Moon";
   00021| 
   00022| static TEMP_IDS: AtomicUsize = AtomicUsize::new(0);
   00023| 
   00024| /// The paragraphs of the fixture page titled `title`, as the corpus stores them.
   00025| fn fixture_paragraphs(title: &str) -> Vec<String> {
   00026|     let corpus = include_str!("../../../data/benchmarks/web-formalization/en.lino");
   00027|     let heading = format!("  title \"{title}\"");
   00028|     corpus
   00029|         .lines()
   00030|         .skip_while(|line| *line != heading)
   00031|         .skip(1)
   00032|         .take_while(|line| line.starts_with("  "))
   00033|         .filter_map(|line| line.strip_prefix("  paragraph \"")?.strip_suffix('"'))
   00034|         .map(str::to_owned)
   00035|         .collect()
   00036| }
   00037| 
   00038| /// Serves the fixture page for its URL and refuses every other one.
   00039| struct FixtureTransport;
   00040| 
   00041| impl SourceTransport for FixtureTransport {
   00042|     fn get(&self, url: &str) -> Result<Vec<u8>, FetchError> {
   00043|         if url != URL_UNDER_TEST {
   00044|             return Err(FetchError::HttpStatus {
   00045|                 url: url.to_owned(),
   00046|                 status: 404,
   00047|             });
   00048|         }
   00049|         let paragraphs: String = fixture_paragraphs("Moon")
   00050|             .iter()
   00051|             .map(|text| format!("<p>{text}</p>"))
   00052|             .collect();
   00053|         Ok(format!("<html><body><h1>Moon</h1>{paragraphs}</body></html>").into_bytes())
   00054|     }
   00055| }
   00056| 
   00057| /// An empty cache directory of its own.
   00058| fn temp_cache() -> PathBuf {
   00059|     let path = std::env::temp_dir().join(format!(
   00060|         "formal-ai-page-formalization-{}-{}",
   00061|         std::process::id(),
   00062|         TEMP_IDS.fetch_add(1, Ordering::SeqCst)
   00063|     ));
   00064|     let _ = std::fs::remove_dir_all(&path);
   00065|     path
   00066| }
   00067| 
   00068| /// The answer to `prompt`, fetched online through the fixture transport.
   00069| fn answer(prompt: &str, online: bool) -> formal_ai::SymbolicAnswer {
   00070|     let client = CachedSourceClient::new(temp_cache(), FixtureTransport).with_online(online);
   00071|     let mut log = EventLog::new();
   00072|     try_page_formalization_with_client(prompt, &mut log, &client)
   00073|         .unwrap_or_else(|| panic!("the route should answer: {prompt}"))
   00074| }
   00075| 
