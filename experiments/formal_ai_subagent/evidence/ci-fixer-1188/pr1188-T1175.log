   00570|             return None;
   00571|         }
   00572|         let slot = |name: &str| {
   00573|             self.slots
   00574|                 .iter()
   00575|                 .find(|(key, _)| *key == name)
   00576|                 .map(|(_, value)| value.as_str())
   00577|         };
