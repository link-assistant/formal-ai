   00348| /// `Delete the line 'x' from notes.txt`: the seeded `coding_text_remove_action`
   00349| /// with one quoted payload and one path, and no add action alongside it.
   00350| fn grounded_removal(task: &str) -> Option<ComputedChange> {
   00351|     if !mentions("coding_text_remove_action", task) || mentions("coding_member_add_action", task) {
   00352|         return None;
   00353|     }
   00354|     let (target, text) = quoted_payload_and_path(task)?;
   00355|     // A request that names a line removes whole lines, never only the
   00356|     // payload inside one (PR #1188 G60).
   00357|     let computation = if names_line(task) {
   00358|         let containing =
   00359|             seed::lexicon().mentions_role("line_containment_cue", &outside_quotes(task));
   00360|         Computation::LineRemoval {
   00361|             text: text.clone(),
   00362|             containing,
   00363|         }
   00364|     } else {
   00365|         Computation::Removal { text: text.clone() }
   00366|     };
   00367|     Some(ComputedChange {
   00368|         target,
   00369|         intent: "coding_text_remove",
   00370|         slots: vec![("{old}", text)],
   00371|         computation,
   00372|     })
   00373| }
