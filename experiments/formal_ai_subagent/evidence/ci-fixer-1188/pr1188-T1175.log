   00088| /// A computed change: the file, how its bytes are computed, and the seed
   00089| /// sentence (intent and slots) that states it.
   00090| #[derive(Debug, Clone, PartialEq, Eq)]
   00091| pub(super) struct ComputedChange {
   00092|     pub(super) target: String,
   00093|     pub(super) computation: Computation,
   00094|     pub(super) intent: &'static str,
   00095|     pub(super) slots: Vec<(&'static str, String)>,
   00096| }
