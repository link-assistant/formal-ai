   00420| /// `Change the value of "debug" to true in config.json`: the seeded
   00421| /// `config_value_lead` names a setting; the edit request's old clause names its
   00422| /// key (quoted, or its last identifier) and the new clause its value.
   00423| ///
   00424| /// `Change MAXIMUM_RATIO from 8 to 16 in p.rs` states the value the key holds
   00425| /// now (the seeded `file_edit_old_lead_cue`): the line assigning the key that
   00426| /// value is the one changed, and a key assigned nowhere leaves the stated
   00427| /// value itself, when it occurs once as a word (PR #1188 G2).
   00428| fn grounded_setting(task: &str) -> Option<ComputedChange> {
   00429|     let (target, old_clause, value) = compose_edit_request(task)?;
   00430|     let stated = super::workspace_setting::stated_old_value(&old_clause);
   00431|     if stated.is_none() && !mentions("config_value_lead", task) {
   00432|         return None;
   00433|     }
   00434|     // `set the contents of note.txt to hello` writes the file; its contents are
   00435|     // not a key (PR #1188 G68, issue #745).
   00436|     if stated.is_none() && mentions("file_contents_source_cue", task) {
   00437|         return None;
   00438|     }
   00439|     let key_clause = stated
   00440|         .as_ref()
   00441|         .map_or(old_clause.as_str(), |(key, _)| key.as_str());
   00442|     let quoted = quoted_segments(key_clause);
   00443|     let key = match quoted.as_slice() {
   00444|         [key] => key.clone(),
   00445|         _ => identifier_tokens(key_clause).next_back()?.to_owned(),
   00446|     };
   00447|     let value = value.trim().to_owned();
   00448|     if value.is_empty() {
   00449|         return None;
   00450|     }
   00451|     Some(ComputedChange {
   00452|         target,
   00453|         intent: "setting",
   00454|         slots: vec![("{old}", key.clone()), ("{new}", value.clone())],
   00455|         computation: Computation::Setting {
   00456|             key,
   00457|             value,
   00458|             held: stated.map(|(_, held)| held),
   00459|         },
   00460|     })
   00461| }
