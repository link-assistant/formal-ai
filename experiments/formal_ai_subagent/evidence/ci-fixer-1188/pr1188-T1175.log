   00688| /// The file after the insertion; a file without a final newline keeps none.
   00689| /// Lines under an append request, at the indentation they were given.
   00690| ///
   00691| /// Only when the file already has lines indented exactly so (a `.lino` table
   00692| /// appended among its siblings); else at the file's top level, since the
   00693| /// indentation of lines written under a request is otherwise only its layout
   00694| /// (PR #1188 G16).
   00695| fn appended_block(source: &str, text: &str, indentation: Option<&str>) -> String {
   00696|     match indentation {
   00697|         Some(indentation) if super::positional_edit::indents_lines_at(source, indentation) => {
   00698|             super::positional_edit::rebased_block(text, indentation)
   00699|         }
   00700|         _ => text.to_owned(),
   00701|     }
   00702| }
