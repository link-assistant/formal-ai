   00668|     /// The smallest unique edit carrying the change, when there is one.
   00669|     fn edit(&self, source: &str, updated: &str) -> Option<(String, String)> {
   00670|         match &self.computation {
   00671|             Computation::EndInsertion { .. } if source.is_empty() => None,
   00672|             Computation::EndInsertion { at_end, .. } => compact_end_edit(source, updated, *at_end),
   00673|             Computation::LineReplacement { context, .. } => {
   00674|                 context_lines_edit(source, updated, context.as_deref())
   00675|             }
   00676|             Computation::Removal { .. }
   00677|             | Computation::LineRemoval { .. }
   00678|             | Computation::Setting { .. }
   00679|             | Computation::TypoFix { .. }
   00680|             | Computation::DeclarationRemoval { .. }
   00681|             | Computation::Line(_)
   00682|             | Computation::Section { .. }
   00683|             | Computation::ReplaceList { .. } => changed_lines_edit(source, updated),
   00684|         }
   00685|     }
   00686| }
