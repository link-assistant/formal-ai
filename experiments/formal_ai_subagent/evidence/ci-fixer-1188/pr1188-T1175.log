   00971| /// The seeded `file_edit_blank_line` with one named path and no quoted text:
   00972| /// the payload is the empty string (mirrors `blankLineAndPath`).
   00973| fn blank_line_and_path(task: &str) -> Option<(String, String)> {
   00974|     if !quoted_segment_spans(task).is_empty() || !mentions("file_edit_blank_line", task) {
   00975|         return None;
   00976|     }
   00977|     let mut paths: Vec<String> = super::positional_edit::unquoted_path_tokens(task)
   00978|         .iter()
   00979|         .map(|token| clean_path_token(token.text).to_owned())
   00980|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00981|         .collect();
   00982|     paths.sort();
   00983|     paths.dedup();
   00984|     match paths.as_slice() {
   00985|         [path] => Some((path.clone(), String::new())),
   00986|         _ => None,
   00987|     }
   00988| }
