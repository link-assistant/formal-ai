   00108| /// `Fix the typo 'smal' in README.md`: the seeded `typo_fix_lead` with one
   00109| /// quoted word and one path, and no stated correction. The correction is
   00110| /// discovered ([`super::spelling::corrected_spelling`]), and the change is the
   00111| /// word-scoped replacement a stated correction would have made.
   00112| fn grounded_typo_fix(task: &str) -> Option<ComputedChange> {
   00113|     if !mentions("typo_fix_lead", task) {
   00114|         return None;
   00115|     }
   00116|     let (target, word) = quoted_payload_and_path(task)?;
   00117|     if !is_identifier_word(&word) {
   00118|         return None;
   00119|     }
   00120|     let correction = super::spelling::corrected_spelling(&word)?;
   00121|     Some(ComputedChange {
   00122|         target,
   00123|         intent: "coding_text_replaced",
   00124|         slots: vec![("{old}", word.clone()), ("{new}", correction.clone())],
   00125|         computation: Computation::TypoFix { word, correction },
   00126|     })
   00127| }
