   00531| /// The smallest unique changed run of lines, or the lines from the context's
   00532| /// line through the change.
   00533| ///
   00534| /// When the changed run repeats, the run is widened up to the context's line:
   00535| /// the context occurs once, so the widened run does not (mirrors
   00536| /// `contextLinesEdit`).
   00537| fn context_lines_edit(
   00538|     source: &str,
   00539|     updated: &str,
   00540|     context: Option<&str>,
   00541| ) -> Option<(String, String)> {
   00542|     let compact = changed_lines_edit(source, updated);
   00543|     let Some(context) = context.filter(|_| compact.is_none()) else {
   00544|         return compact;
   00545|     };
   00546|     let mut found = source.match_indices(context).map(|(at, _)| at);
   00547|     let (Some(at), None) = (found.next(), found.next()) else {
   00548|         return None;
   00549|     };
   00550|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00551|     let suffix = source[start..]
   00552|         .bytes()
   00553|         .rev()
   00554|         .zip(updated[start..].bytes().rev())
   00555|         .take_while(|(left, right)| left == right)
   00556|         .count();
   00557|     let end = source[source.len() - suffix..]
   00558|         .find('\n')
   00559|         .map_or(source.len(), |newline| source.len() - suffix + newline);
   00560|     Some((
   00561|         source[start..end].to_owned(),
   00562|         updated[start..updated.len() - (source.len() - end)].to_owned(),
   00563|     ))
   00564| }
