   00268| /// `Append 'x' to notes.txt`, `Prepend "x" to a.md`: positioned by the seeded
   00269| /// `file_edit_position_end` / `file_edit_position_start` meanings.
   00270| pub(super) fn grounded_end_insertion(task: &str) -> Option<ComputedChange> {
   00271|     // `Append these lines to f:` followed by lines: the first line is the
   00272|     // request and the lines under it are the text added, verbatim (PR #1188).
   00273|     let block = super::positional_edit::introduced_block(task);
   00274|     // Position cues are read outside the quoted payload: a line saying "at the
   00275|     // start of x" is text being appended (PR #1188 G64).
   00276|     let cues = block
   00277|         .as_ref()
   00278|         .map_or_else(|| outside_quotes(task), |block| sentence_words(block.head));
   00279|     let lexicon = seed::lexicon();
   00280|     let at_end = lexicon.mentions_role("file_edit_position_end", &cues);
   00281|     if at_end == lexicon.mentions_role("file_edit_position_start", &cues) {
   00282|         return None;
   00283|     }
   00284|     // `… at the end of the section '## Usage' in README.md` (PR #1188 G35).
   00285|     if block.is_none()
   00286|         && let Some(section) = super::markdown_section::section_scope(task, &outside_quotes(task))
   00287|     {
   00288|         let text = super::positional_edit::unescape_prose_newlines(&section.text);
   00289|         return Some(ComputedChange {
   00290|             target: section.target,
   00291|             intent: "file_edit_position_after",
   00292|             slots: vec![
   00293|                 ("{new}", text.clone()),
   00294|                 ("{anchor}", section.heading.clone()),
   00295|             ],
   00296|             computation: Computation::Section {
   00297|                 heading: section.heading,
   00298|                 text,
   00299|                 at_end,
   00300|             },
   00301|         });
   00302|     }
   00303|     let (target, text, indentation) = if let Some(block) = block {
   00304|         let indentation = (!block.verbatim).then(|| block.indentation.to_owned());
   00305|         (block_target(block.head)?, block.text, indentation)
   00306|     } else if let Some((target, text)) = quoted_lines_and_path(task) {
   00307|         (target, text, None)
   00308|     } else {
   00309|         let (target, text) = quoted_payload_and_path(task)
   00310|             .or_else(|| blank_line_and_path(task))
   00311|             .or_else(|| line_payload_and_path(task))?;
   00312|         (
   00313|             target,
   00314|             super::positional_edit::unescape_prose_newlines(&text),
   00315|             None,
   00316|         )
   00317|     };
   00318|     Some(ComputedChange {
   00319|         target,
   00320|         // An empty line has no text to quote back; it is stated in its own words.
   00321|         intent: if text.is_empty() {
   00322|             "file_edit_blank_line"
   00323|         } else if at_end {
   00324|             "file_edit_position_end"
   00325|         } else {
   00326|             "file_edit_position_start"
   00327|         },
   00328|         slots: vec![("{new}", text.clone())],
   00329|         computation: Computation::EndInsertion {
   00330|             text,
   00331|             at_end,
   00332|             indentation,
   00333|         },
   00334|     })
   00335| }
