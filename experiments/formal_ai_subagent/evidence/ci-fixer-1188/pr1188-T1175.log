   00463| /// `Replace the line 'x' with 'y' in f`: the seeded `line` meaning outside
   00464| /// the quotes, both clauses quoted. A line replacement never touches text
   00465| /// inside a longer line (T32: `text pays` became `text "pay"s`). With a seeded
   00466| /// anchor context (`the line 'x' that follows the line 'z'`), the first such
   00467| /// line after `z` is the one replaced (T62).
   00468| fn grounded_line_replacement(task: &str) -> Option<ComputedChange> {
   00469|     if !names_line(task)
   00470|         || seed::lexicon().mentions_role(
   00471|             seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00472|             &task.to_lowercase(),
   00473|         )
   00474|     {
   00475|         return None;
   00476|     }
   00477|     let context = super::positional_edit::anchor_context(task);
   00478|     let request = context.as_ref().map_or_else(
   00479|         || task.to_owned(),
   00480|         |(start, end, _)| [&task[..*start], " ", &task[*end..]].concat(),
   00481|     );
   00482|     let (target, original, replacement) = compose_edit_request(&request)?;
   00483|     if super::positional_edit::compose_positional_insert(task).is_some() {
   00484|         return None;
   00485|     }
   00486|     let quoted: Vec<String> = quoted_segments(&request)
   00487|         .iter()
   00488|         .map(String::as_str)
   00489|         .map(super::positional_edit::unescape_prose_newlines)
   00490|         .collect();
   00491|     // Lines under the request (G22) replace the line as its siblings, unless
   00492|     // they were fenced or quoted.
   00493|     let block =
   00494|         super::positional_edit::introduced_block(task).filter(|block| block.text == replacement);
   00495|     // Listed lines (`the three lines 'a', 'b' and 'c'`) are quoted one by one (G80).
   00496|     let listed = !quoted.contains(&original);
   00497|     if (listed
   00498|         && !original
   00499|             .split('\n')
   00500|             .all(|line| quoted.iter().any(|text| text == line)))
   00501|         || (block.is_none() && !quoted.contains(&replacement))
   00502|         || original.is_empty()
   00503|         || original == replacement
   00504|     {
   00505|         return None;
   00506|     }
   00507|     Some(ComputedChange {
   00508|         target,
   00509|         intent: "coding_text_replaced",
   00510|         // Listed lines are named one by one, not as one span holding line breaks.
   00511|         slots: vec![
   00512|             (
   00513|                 "{old}",
   00514|                 if listed {
   00515|                     original.replace('\n', "`, `")
   00516|                 } else {
   00517|                     original.clone()
   00518|                 },
   00519|             ),
   00520|             ("{new}", replacement.clone()),
   00521|         ],
   00522|         computation: Computation::LineReplacement {
   00523|             old: original,
   00524|             new: replacement,
   00525|             context: context.map(|(_, _, text)| text),
   00526|             rebase: block.is_some_and(|block| !block.verbatim),
   00527|         },
   00528|     })
   00529| }
