   00375| /// `Delete the functions a and b from util.rs`: the seeded
   00376| /// `coding_text_remove_action` and `coding_declaration_noun` with no add
   00377| /// action, no quoted text and one named path. The names are the request's
   00378| /// identifiers; `removed_declarations` keeps those the file itself declares
   00379| /// as functions (mirrors `groundedDeclarationRemoval`, PR #1188 dogfooding).
   00380| fn grounded_declaration_removal(task: &str) -> Option<ComputedChange> {
   00381|     if !mentions("coding_text_remove_action", task)
   00382|         || mentions("coding_member_add_action", task)
   00383|         || !mentions("coding_declaration_noun", task)
   00384|         || !quoted_segment_spans(task).is_empty()
   00385|     {
   00386|         return None;
   00387|     }
   00388|     let mut paths: Vec<String> = super::positional_edit::unquoted_path_tokens(task)
   00389|         .iter()
   00390|         .map(|token| clean_path_token(token.text).to_owned())
   00391|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00392|         .collect();
   00393|     paths.sort();
   00394|     paths.dedup();
   00395|     let [target] = paths.as_slice() else {
   00396|         return None;
   00397|     };
   00398|     let mut names: Vec<String> = Vec::new();
   00399|     for token in tokens(task) {
   00400|         if clean_path_token(token.text) == target {
   00401|             continue;
   00402|         }
   00403|         for name in identifier_tokens(token.text) {
   00404|             if !names.iter().any(|known| known == name) {
   00405|                 names.push(name.to_owned());
   00406|             }
   00407|         }
   00408|     }
   00409|     if names.is_empty() {
   00410|         return None;
   00411|     }
   00412|     Some(ComputedChange {
   00413|         target: target.clone(),
   00414|         intent: "coding_text_remove",
   00415|         slots: vec![("{old}", names.join("`, `"))],
   00416|         computation: Computation::DeclarationRemoval { names },
   00417|     })
   00418| }
