   00712| fn inserted_at_end(source: &str, text: &str, at_end: bool) -> String {
   00713|     if source.is_empty() {
   00714|         [text, "\n"].concat()
   00715|     } else if at_end && source.ends_with('\n') {
   00716|         [source, text, "\n"].concat()
   00717|     } else if at_end {
   00718|         [source, "\n", text].concat()
   00719|     } else {
   00720|         [text, "\n", source].concat()
   00721|     }
   00722| }
   00723| 
   00724| /// The smallest unique run of whole lines at the insertion end, and what it
   00725| /// becomes, so the edit tool carries the change rather than the whole file.
   00726| fn compact_end_edit(source: &str, updated: &str, at_end: bool) -> Option<(String, String)> {
   00727|     let starts = source
   00728|         .match_indices('\n')
   00729|         .map(|(index, _)| index + 1)
   00730|         .filter(|start| *start < source.len());
   00731|     let cuts: Vec<usize> = if at_end {
   00732|         std::iter::once(0).chain(starts).rev().collect()
   00733|     } else {
   00734|         starts.chain(std::iter::once(source.len())).collect()
   00735|     };
   00736|     for cut in cuts {
   00737|         let anchor = if at_end {
   00738|             &source[cut..]
   00739|         } else {
   00740|             &source[..cut]
   00741|         };
   00742|         if anchor.trim().is_empty() {
   00743|             continue;
   00744|         }
   00745|         if anchor.len() > MAX_ANCHOR_BYTES {
   00746|             break;
   00747|         }
   00748|         if source.matches(anchor).count() != 1 {
   00749|             continue;
   00750|         }
   00751|         let replacement = if at_end {
   00752|             &updated[cut..]
   00753|         } else {
   00754|             &updated[..updated.len() - (source.len() - cut)]
   00755|         };
   00756|         return Some((anchor.to_owned(), replacement.to_owned()));
   00757|     }
   00758|     None
   00759| }
