   00337| /// Several quoted literals, joined only by seeded joiners and commas, are the
   00338| /// lines added, each its own line, as written (PR #1188 G53, G54).
   00339| fn quoted_lines_and_path(task: &str) -> Option<(String, String)> {
   00340|     let (target, payloads) = named_target_and_payloads(task)?;
   00341|     if payloads.len() < 2 {
   00342|         return None;
   00343|     }
   00344|     let text = super::positional_edit::joined_literal_lines(task, &target)?;
