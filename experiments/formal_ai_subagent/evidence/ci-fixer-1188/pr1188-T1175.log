   00897| /// `Append the line third to notes.txt`: no quoted text, one path, and the
   00898| /// seeded `file_edit_line_lead`; the line is the words after the lead up to
   00899| /// the last destination cue before the path (`go to bed to notes.txt` keeps
   00900| /// `go to bed`). A request without a lead is declined, never guessed.
   00901| fn line_payload_and_path(task: &str) -> Option<(String, String)> {
   00902|     if !quoted_segment_spans(task).is_empty() {
   00903|         return None;
   00904|     }
   00905|     let tokens = tokens(task);
   00906|     let paths: Vec<(usize, &str)> = tokens
   00907|         .iter()
   00908|         .enumerate()
   00909|         .map(|(index, token)| (index, clean_path_token(token.text)))
   00910|         .filter(|(_, path)| looks_like_file_path(path) && safe_relative_path(path))
   00911|         .collect();
   00912|     let (path_index, target) = *paths.first()?;
   00913|     if paths.iter().any(|(_, path)| *path != target) {
   00914|         return None;
   00915|     }
   00916|     let mut leads: Vec<Vec<String>> = seed::lexicon()
   00917|         .words_for_role("file_edit_line_lead")
   00918|         .iter()
   00919|         .map(|lead| {
   00920|             lead.to_lowercase()
   00921|                 .split_whitespace()
   00922|                 .map(str::to_owned)
   00923|                 .collect::<Vec<_>>()
   00924|         })
   00925|         .filter(|words| !words.is_empty())
   00926|         .collect();
   00927|     leads.sort_by_key(|words| std::cmp::Reverse(words.len()));
   00928|     let lead_end = (0..path_index).find_map(|index| {
   00929|         leads
   00930|             .iter()
   00931|             .find(|words| {
   00932|                 words.iter().enumerate().all(|(offset, word)| {
   00933|                     index + offset < path_index
   00934|                         && clean_cue_token(tokens[index + offset].text) == *word
   00935|                 })
   00936|             })
   00937|             .map(|words| index + words.len())
   00938|     })?;
   00939|     let destinations = bare_surfaces("file_write_destination_cue");
   00940|     let end = (lead_end..path_index)
   00941|         .rev()
   00942|         .find(|index| destinations.contains(&clean_cue_token(tokens[*index].text)))?;
   00943|     if end <= lead_end {
   00944|         return None;
   00945|     }
   00946|     Some((
   00947|         target.to_owned(),
   00948|         task[tokens[lead_end].start..tokens[end - 1].end].to_owned(),
   00949|     ))
   00950| }
