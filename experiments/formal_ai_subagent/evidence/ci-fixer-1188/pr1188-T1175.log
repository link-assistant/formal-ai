   00761| impl ComputedChange {
   00762|     /// The seed sentence that states the change made to `source`: lines that
   00763|     /// only contained the payload are reported as lines, with their count;
   00764|     /// every other change keeps its own intent and slots.
   00765|     fn reported(&self, source: &str) -> (&'static str, Vec<(&'static str, String)>) {
   00766|         if let Computation::LineRemoval { text, containing } = &self.computation {
   00767|             let lines: Vec<&str> = source.split_inclusive('\n').map(bare_line).collect();
   00768|             let removed: Vec<&str> = removed_line_indices(source, text, *containing)
   00769|                 .into_iter()
   00770|                 .map(|index| lines[index])
   00771|                 .collect();
   00772|             if removed.iter().any(|line| line != text) {
   00773|                 return (
   00774|                     "line",
   00775|                     vec![
   00776|                         ("{old}", text.clone()),
   00777|                         ("{count}", removed.len().to_string()),
   00778|                     ],
   00779|                 );
   00780|             }
   00781|         }
   00782|         if let Computation::Section {
   00783|             heading,
   00784|             text,
   00785|             at_end,
   00786|         } = &self.computation
   00787|             && let Some((_, follows)) =
   00788|                 super::markdown_section::inserted_in_section(source, heading, text, *at_end)
   00789|         {
   00790|             return (
   00791|                 self.intent,
   00792|                 vec![("{new}", text.clone()), ("{anchor}", follows)],
   00793|             );
   00794|         }
   00795|         if let Computation::DeclarationRemoval { names } = &self.computation
   00796|             && let Some((_, declared)) = removed_declarations(source, names)
   00797|         {
   00798|             return (self.intent, vec![("{old}", declared.join("`, `"))]);
   00799|         }
   00800|         if let Computation::Line(operation) = &self.computation
   00801|             && let Some(reported) = operation.reported(source)
   00802|         {
   00803|             return reported;
   00804|         }
   00805|         (self.intent, self.slots.clone())
   00806|     }
   00807| 
   00808|     /// Preserve removed names and lines as explicit list values for the summary.
   00809|     fn reported_values(&self, source: &str) -> Option<Vec<String>> {
   00810|         match &self.computation {
   00811|             Computation::DeclarationRemoval { names } => {
   00812|                 removed_declarations(source, names).map(|(_, values)| values)
   00813|             }
   00814|             Computation::Line(operation) => operation.reported_values(source),
   00815|             _ => None,
   00816|         }
   00817|     }
   00818| }
