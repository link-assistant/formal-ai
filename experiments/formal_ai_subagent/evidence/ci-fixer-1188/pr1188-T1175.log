   00820| /// Read, compute, edit (or write), check the digest, state the change.
   00821| pub(super) fn plan_computed_change_step(
   00822|     task: &str,
   00823|     current_turn: &[ChatMessage],
   00824|     tool_names: &[&str],
   00825|     change: &ComputedChange,
   00826| ) -> Option<AgenticPlan> {
   00827|     let target = change.target.as_str();
   00828|     let Some(read) = result_for_path(current_turn, Capability::Read, target, None) else {
   00829|         let tool = tool_for(tool_names, Capability::Read)?;
   00830|         return Some(plan_one(tool, read_arguments(target)));
   00831|     };
   00832|     // A read that came back as the client's file block is the file, whatever
   00833|     // its text says: a ledger that quotes error lines is not a missing file.
   00834|     let missing = super::code_artifact::source_from_agent_read_result(&read).is_none()
   00835|         && super::tool_result::failure_message(&read, false, true).is_some();
   00836|     let source = if missing {
   00837|         String::new()
   00838|     } else {
   00839|         source_from_read_result(&read)
   00840|     };
   00841|     if let Some(answer) = super::edit_scope::scoped_decline(task, target, &source) {
   00842|         return Some(AgenticPlan::Final(answer));
   00843|     }
   00844|     let Some(updated) = change
   00845|         .compute(&source, missing)
   00846|         .filter(|updated| *updated != source)
   00847|     else {
   00848|         // Text the change names that the file no longer holds is the answer (G87).
   00849|         let absent = if missing {
   00850|             None
   00851|         } else {
   00852|             change.absent_text_answer(task, &source)
   00853|         };
   00854|         return Some(AgenticPlan::Final(match absent {
   00855|             Some(answer) => answer,
   00856|             None => render_seeded_outcome("coding_workspace_verification_failed", task, target)?,
   00857|         }));
   00858|     };
   00859|     // A change that would drop most of the file is refused unless its request
   00860|     // states that extent (PR #1188 T29).
   00861|     if !change.bounded() && drops_most_of_file(&source, &updated) {
   00862|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00863|             "coding_workspace_fragment_refused",
   00864|             task,
   00865|             target,
   00866|         )?));
   00867|     }
   00868|     let (intent, reported) = change.reported(&source);
   00869|     let slots: Vec<(&str, &str)> = reported
   00870|         .iter()
   00871|         .map(|(slot, value)| (*slot, value.as_str()))
   00872|         .collect();
   00873|     let values = change.reported_values(&source);
   00874|     let list_slots: Vec<(&str, &[String])> = values.as_deref().map(|values| vec![("{old}", values)]).unwrap_or_default();
   00875|     let verified = VerifiedChange {
   00876|         target,
   00877|         expected: &updated,
   00878|         intent,
   00879|         slots: &slots,
   00880|         list_slots: &list_slots,
   00881|     };
   00882|     if let Some((old, new)) = change.edit(&source, &updated)
   00883|         && let Some(tool) = tool_for(tool_names, Capability::Edit)
   00884|     {
   00885|         if result_for_edit(current_turn, target, &old, &new).is_none() {
   00886|             return Some(plan_one(tool, edit_arguments(target, &old, &new)));
   00887|         }
   00888|         return plan_digest_verification(task, current_turn, tool_names, &verified);
   00889|     }
   00890|     if result_for_path(current_turn, Capability::Write, target, Some(&updated)).is_none() {
   00891|         let tool = tool_for(tool_names, Capability::Write)?;
   00892|         return Some(plan_one(tool, write_arguments(target, &updated)));
   00893|     }
   00894|     plan_digest_verification(task, current_turn, tool_names, &verified)
   00895| }
