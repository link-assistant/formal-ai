   00952| /// The one path a colon-ended request line names, with nothing else quoted
   00953| /// (mirrors `blockPayloadAndPath`).
   00954| fn block_target(head: &str) -> Option<String> {
   00955|     let mut paths: Vec<&str> = super::positional_edit::unquoted_path_tokens(head)
   00956|         .iter()
   00957|         .map(|token| clean_path_token(token.text))
   00958|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00959|         .collect();
   00960|     paths.sort_unstable();
   00961|     paths.dedup();
   00962|     let [path] = paths.as_slice() else {
   00963|         return None;
   00964|     };
   00965|     quoted_segment_spans(head)
   00966|         .iter()
   00967|         .all(|segment| segment.text == *path)
   00968|         .then(|| (*path).to_owned())
   00969| }
