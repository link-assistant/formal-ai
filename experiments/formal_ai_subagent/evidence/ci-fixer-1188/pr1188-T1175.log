   00587|     /// The file after the change, or `None` when it cannot apply.
   00588|     fn compute(&self, source: &str, missing: bool) -> Option<String> {
   00589|         match &self.computation {
   00590|             Computation::EndInsertion {
   00591|                 text,
   00592|                 at_end,
   00593|                 indentation,
   00594|             } => Some(inserted_at_end(
   00595|                 source,
   00596|                 &appended_block(source, text, indentation.as_deref()),
   00597|                 *at_end,
   00598|             )),
   00599|             Computation::Removal { text } => {
   00600|                 (!missing).then(|| removed_literal(source, text)).flatten()
   00601|             }
   00602|             Computation::LineRemoval { text, containing } => (!missing)
   00603|                 .then(|| removed_lines(source, text, *containing))
   00604|                 .flatten(),
   00605|             Computation::Setting { key, value, held } => (!missing)
   00606|                 .then(|| {
   00607|                     super::workspace_setting::assigned_setting(
   00608|                         source,
   00609|                         key,
   00610|                         value,
   00611|                         &self.target,
   00612|                         held.as_deref(),
   00613|                     )
   00614|                 })
   00615|                 .flatten(),
   00616|             Computation::LineReplacement {
   00617|                 old,
   00618|                 new,
   00619|                 context,
   00620|                 rebase,
   00621|             } => (!missing)
   00622|                 .then(|| {
   00623|                     let new = if *rebase {
   00624|                         super::positional_edit::rebased_block(new, line_indentation(source, old))
   00625|                     } else {
   00626|                         new.clone()
   00627|                     };
   00628|                     super::workspace_setting::replaced_lines(source, old, &new, context.as_deref())
   00629|                 })
   00630|                 .flatten(),
   00631|             Computation::TypoFix { word, correction } => (!missing)
   00632|                 .then(|| {
   00633|                     execute_scoped_workspace_rewrite(source, word, correction, RewriteScope::Word)
   00634|                         .ok()
   00635|                         .map(|execution| execution.output)
   00636|                 })
   00637|                 .flatten(),
   00638|             Computation::DeclarationRemoval { names } => (!missing)
   00639|                 .then(|| removed_declarations(source, names).map(|(updated, _)| updated))
   00640|                 .flatten(),
   00641|             Computation::Line(operation) => (!missing).then(|| operation.compute(source)).flatten(),
   00642|             Computation::Section {
   00643|                 heading,
   00644|                 text,
   00645|                 at_end,
   00646|             } => (!missing)
   00647|                 .then(|| {
   00648|                     super::markdown_section::inserted_in_section(source, heading, text, *at_end)
   00649|                 })
   00650|                 .flatten()
   00651|                 .map(|(updated, _)| updated),
   00652|             Computation::ReplaceList { pairs } => (!missing)
   00653|                 .then(|| super::replace_list::replaced_in_order(source, pairs))
   00654|                 .flatten(),
   00655|         }
   00656|     }
