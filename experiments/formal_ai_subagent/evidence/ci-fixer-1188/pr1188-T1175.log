   00163| /// Whether the request is about text inside a file: it quotes a payload that
   00164| /// is not a path, or names a line (the seeded `line` meaning) or another unit
   00165| /// of text (`file_text_unit`: word, phrase, occurrence, text, in every
   00166| /// registered language) outside its quotes. A destructive shell intent never
   00167| /// reads such a request as deleting the file (PR #1188).
   00168| pub(super) fn edits_inside_a_file(prompt: &str) -> bool {
   00169|     if quoted_segment_spans(prompt)
   00170|         .iter()
   00171|         .map(|segment| segment.text.trim())
   00172|         .any(|text| !text.is_empty() && !super::shell_command::looks_like_a_path(text))
   00173|     {
   00174|         return true;
   00175|     }
   00176|     let outside = crate::engine::normalize_prompt(
   00177|         &crate::solver_handlers::text_outside_quoted_segments(&without_path_words(prompt)),
   00178|     )
   00179|     .to_lowercase();
   00180|     seed::lexicon()
   00181|         .meaning("line")
   00182|         .is_some_and(|meaning| meaning.evidenced_in(&outside))
   00183|         || seed::lexicon().mentions_role("file_text_unit", &outside)
   00184| }
   00185| 
   00186| /// Whether the request names a line outside its quotes: the seeded `line`
   00187| /// meaning (`the line containing '…'`, `lines`, `строку`, `पंक्ति`, `的行`).
   00188| pub(super) fn names_line(task: &str) -> bool {
   00189|     // A path's own words are no line: `x-line.lino` names a file (PR #1188 G83).
   00190|     seed::lexicon()
   00191|         .meaning("line")
   00192|         .is_some_and(|meaning| meaning.evidenced_in(&outside_quotes(&without_path_words(task))))
   00193| }
