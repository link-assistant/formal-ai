   00704| /// The indentation of the first line that is `text` but for its indentation.
   00705| fn line_indentation<'a>(source: &'a str, text: &str) -> &'a str {
   00706|     source
   00707|         .split('\n')
   00708|         .find(|line| line.trim() == text.trim())
   00709|         .map_or("", super::positional_edit::leading_indentation)
   00710| }
