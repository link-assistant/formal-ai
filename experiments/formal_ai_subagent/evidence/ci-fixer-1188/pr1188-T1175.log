   00195| /// `task` with every unquoted path token blanked.
   00196| ///
   00197| /// A path's own words (`x-line.lino`, `line-budget.lino`) never read as the
   00198| /// words of the request (PR #1188 G83; mirrors `withoutPathWords`).
   00199| pub(super) fn without_path_words(task: &str) -> String {
   00200|     let segments = quoted_segment_spans(task);
   00201|     let mut out = task.to_owned();
   00202|     for token in super::write_request::tokens(task).iter().rev() {
   00203|         if segments
   00204|             .iter()
   00205|             .any(|segment| token.start < segment.end && token.end > segment.start)
   00206|         {
   00207|             continue;
   00208|         }
   00209|         let path = super::write_request::clean_path_token(token.text);
   00210|         if super::write_request::looks_like_file_path(path)
   00211|             && super::write_request::safe_relative_path(path)
   00212|         {
   00213|             out.replace_range(token.start..token.end, &" ".repeat(token.end - token.start));
   00214|         }
   00215|     }
   00216|     out
   00217| }
