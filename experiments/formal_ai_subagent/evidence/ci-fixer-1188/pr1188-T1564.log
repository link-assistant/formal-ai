   00418| /// `Change the value of "debug" to true in config.json`: the seeded
   00419| /// `config_value_lead` names a setting; the edit request's old clause names its
   00420| /// key (quoted, or its last identifier) and the new clause its value.
   00421| ///
   00422| /// `Change MAXIMUM_RATIO from 8 to 16 in p.rs` states the value the key holds
   00423| /// now (the seeded `file_edit_old_lead_cue`): the line assigning the key that
   00424| /// value is the one changed, and a key assigned nowhere leaves the stated
   00425| /// value itself, when it occurs once as a word (PR #1188 G2).
   00426| fn grounded_setting(task: &str) -> Option<ComputedChange> {
   00427|     let (target, old_clause, value) = compose_edit_request(task)?;
   00428|     let stated = super::workspace_setting::stated_old_value(&old_clause);
   00429|     if stated.is_none() && !mentions("config_value_lead", task) {
   00430|         return None;
   00431|     }
   00432|     // `set the contents of note.txt to hello` writes the file; its contents are
   00433|     // not a key (PR #1188 G68, issue #745).
   00434|     if stated.is_none() && mentions("file_contents_source_cue", task) {
   00435|         return None;
   00436|     }
   00437|     let key_clause = stated
   00438|         .as_ref()
   00439|         .map_or(old_clause.as_str(), |(key, _)| key.as_str());
   00440|     let quoted = quoted_segments(key_clause);
   00441|     let key = match quoted.as_slice() {
   00442|         [key] => key.clone(),
   00443|         _ => identifier_tokens(key_clause).next_back()?.to_owned(),
   00444|     };
   00445|     let value = value.trim().to_owned();
   00446|     if value.is_empty() {
   00447|         return None;
   00448|     }
   00449|     Some(ComputedChange {
   00450|         target,
   00451|         intent: "setting",
   00452|         slots: vec![("{old}", key.clone()), ("{new}", value.clone())],
   00453|         computation: Computation::Setting {
   00454|             key,
   00455|             value,
   00456|             held: stated.map(|(_, held)| held),
   00457|         },
   00458|     })
   00459| }
