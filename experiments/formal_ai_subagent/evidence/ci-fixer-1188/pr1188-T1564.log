   00585|     /// The file after the change, or `None` when it cannot apply.
   00586|     fn compute(&self, source: &str, missing: bool) -> Option<String> {
   00587|         match &self.computation {
   00588|             Computation::EndInsertion {
   00589|                 text,
   00590|                 at_end,
   00591|                 indentation,
   00592|             } => Some(inserted_at_end(
   00593|                 source,
   00594|                 &appended_block(source, text, indentation.as_deref()),
   00595|                 *at_end,
   00596|             )),
   00597|             Computation::Removal { text } => {
   00598|                 (!missing).then(|| removed_literal(source, text)).flatten()
   00599|             }
   00600|             Computation::LineRemoval { text, containing } => (!missing)
   00601|                 .then(|| removed_lines(source, text, *containing))
   00602|                 .flatten(),
   00603|             Computation::Setting { key, value, held } => (!missing)
   00604|                 .then(|| {
   00605|                     super::workspace_setting::assigned_setting(
   00606|                         source,
   00607|                         key,
   00608|                         value,
   00609|                         &self.target,
   00610|                         held.as_deref(),
   00611|                     )
   00612|                 })
   00613|                 .flatten(),
   00614|             Computation::LineReplacement {
   00615|                 old,
   00616|                 new,
   00617|                 context,
   00618|                 rebase,
   00619|             } => (!missing)
   00620|                 .then(|| {
   00621|                     let new = if *rebase {
   00622|                         super::positional_edit::rebased_block(new, line_indentation(source, old))
   00623|                     } else {
   00624|                         new.clone()
   00625|                     };
   00626|                     super::workspace_setting::replaced_lines(source, old, &new, context.as_deref())
   00627|                 })
   00628|                 .flatten(),
   00629|             Computation::TypoFix { word, correction } => (!missing)
   00630|                 .then(|| {
   00631|                     execute_scoped_workspace_rewrite(source, word, correction, RewriteScope::Word)
   00632|                         .ok()
   00633|                         .map(|execution| execution.output)
   00634|                 })
   00635|                 .flatten(),
   00636|             Computation::DeclarationRemoval { names } => (!missing)
   00637|                 .then(|| removed_declarations(source, names).map(|(updated, _)| updated))
   00638|                 .flatten(),
   00639|             Computation::Line(operation) => (!missing).then(|| operation.compute(source)).flatten(),
   00640|             Computation::Section {
   00641|                 heading,
   00642|                 text,
   00643|                 at_end,
   00644|             } => (!missing)
   00645|                 .then(|| {
   00646|                     super::markdown_section::inserted_in_section(source, heading, text, *at_end)
   00647|                 })
   00648|                 .flatten()
   00649|                 .map(|(updated, _)| updated),
   00650|             Computation::ReplaceList { pairs } => (!missing)
   00651|                 .then(|| super::replace_list::replaced_in_order(source, pairs))
   00652|                 .flatten(),
   00653|         }
   00654|     }
