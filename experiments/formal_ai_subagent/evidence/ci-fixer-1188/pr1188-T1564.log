   00266| /// `Append 'x' to notes.txt`, `Prepend "x" to a.md`: positioned by the seeded
   00267| /// `file_edit_position_end` / `file_edit_position_start` meanings.
   00268| pub(super) fn grounded_end_insertion(task: &str) -> Option<ComputedChange> {
   00269|     // `Append these lines to f:` followed by lines: the first line is the
   00270|     // request and the lines under it are the text added, verbatim (PR #1188).
   00271|     let block = super::positional_edit::introduced_block(task);
   00272|     // Position cues are read outside the quoted payload: a line saying "at the
   00273|     // start of x" is text being appended (PR #1188 G64).
   00274|     let cues = block
   00275|         .as_ref()
   00276|         .map_or_else(|| outside_quotes(task), |block| sentence_words(block.head));
   00277|     let lexicon = seed::lexicon();
   00278|     let at_end = lexicon.mentions_role("file_edit_position_end", &cues);
   00279|     if at_end == lexicon.mentions_role("file_edit_position_start", &cues) {
   00280|         return None;
   00281|     }
   00282|     // `… at the end of the section '## Usage' in README.md` (PR #1188 G35).
   00283|     if block.is_none()
   00284|         && let Some(section) = super::markdown_section::section_scope(task, &outside_quotes(task))
   00285|     {
   00286|         let text = super::positional_edit::unescape_prose_newlines(&section.text);
   00287|         return Some(ComputedChange {
   00288|             target: section.target,
   00289|             intent: "file_edit_position_after",
   00290|             slots: vec![
   00291|                 ("{new}", text.clone()),
   00292|                 ("{anchor}", section.heading.clone()),
   00293|             ],
   00294|             computation: Computation::Section {
   00295|                 heading: section.heading,
   00296|                 text,
   00297|                 at_end,
   00298|             },
   00299|         });
   00300|     }
   00301|     let (target, text, indentation) = if let Some(block) = block {
   00302|         let indentation = (!block.verbatim).then(|| block.indentation.to_owned());
   00303|         (block_target(block.head)?, block.text, indentation)
   00304|     } else if let Some((target, text)) = quoted_lines_and_path(task) {
   00305|         (target, text, None)
   00306|     } else {
   00307|         let (target, text) = quoted_payload_and_path(task)
   00308|             .or_else(|| blank_line_and_path(task))
   00309|             .or_else(|| line_payload_and_path(task))?;
   00310|         (
   00311|             target,
   00312|             super::positional_edit::unescape_prose_newlines(&text),
   00313|             None,
   00314|         )
   00315|     };
   00316|     Some(ComputedChange {
   00317|         target,
   00318|         // An empty line has no text to quote back; it is stated in its own words.
   00319|         intent: if text.is_empty() {
   00320|             "file_edit_blank_line"
   00321|         } else if at_end {
   00322|             "file_edit_position_end"
   00323|         } else {
   00324|             "file_edit_position_start"
   00325|         },
   00326|         slots: vec![("{new}", text.clone())],
   00327|         computation: Computation::EndInsertion {
   00328|             text,
   00329|             at_end,
   00330|             indentation,
   00331|         },
   00332|     })
   00333| }
