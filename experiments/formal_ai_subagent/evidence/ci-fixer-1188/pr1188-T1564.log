   00529| /// The smallest unique changed run of lines, or the lines from the context's
   00530| /// line through the change.
   00531| ///
   00532| /// When the changed run repeats, the run is widened up to the context's line:
   00533| /// the context occurs once, so the widened run does not (mirrors
   00534| /// `contextLinesEdit`).
   00535| fn context_lines_edit(
   00536|     source: &str,
   00537|     updated: &str,
   00538|     context: Option<&str>,
   00539| ) -> Option<(String, String)> {
   00540|     let compact = changed_lines_edit(source, updated);
   00541|     let Some(context) = context.filter(|_| compact.is_none()) else {
   00542|         return compact;
   00543|     };
   00544|     let mut found = source.match_indices(context).map(|(at, _)| at);
   00545|     let (Some(at), None) = (found.next(), found.next()) else {
   00546|         return None;
   00547|     };
   00548|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00549|     let suffix = source[start..]
   00550|         .bytes()
   00551|         .rev()
   00552|         .zip(updated[start..].bytes().rev())
   00553|         .take_while(|(left, right)| left == right)
   00554|         .count();
   00555|     let end = source[source.len() - suffix..]
   00556|         .find('\n')
   00557|         .map_or(source.len(), |newline| source.len() - suffix + newline);
   00558|     Some((
   00559|         source[start..end].to_owned(),
   00560|         updated[start..updated.len() - (source.len() - end)].to_owned(),
   00561|     ))
   00562| }
