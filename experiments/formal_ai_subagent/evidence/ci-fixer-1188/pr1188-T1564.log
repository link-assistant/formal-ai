   00666|     /// The smallest unique edit carrying the change, when there is one.
   00667|     fn edit(&self, source: &str, updated: &str) -> Option<(String, String)> {
   00668|         match &self.computation {
   00669|             Computation::EndInsertion { .. } if source.is_empty() => None,
   00670|             Computation::EndInsertion { at_end, .. } => compact_end_edit(source, updated, *at_end),
   00671|             Computation::LineReplacement { context, .. } => {
   00672|                 context_lines_edit(source, updated, context.as_deref())
   00673|             }
   00674|             Computation::Removal { .. }
   00675|             | Computation::LineRemoval { .. }
   00676|             | Computation::Setting { .. }
   00677|             | Computation::TypoFix { .. }
   00678|             | Computation::DeclarationRemoval { .. }
   00679|             | Computation::Line(_)
   00680|             | Computation::Section { .. }
   00681|             | Computation::ReplaceList { .. } => changed_lines_edit(source, updated),
   00682|         }
   00683|     }
   00684| }
