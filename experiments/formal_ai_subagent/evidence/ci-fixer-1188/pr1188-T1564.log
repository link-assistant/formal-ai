   00656|     /// Whether the request states the change's whole extent (named
   00657|     /// declarations, a numbered range), so it may remove most of a file.
   00658|     const fn bounded(&self) -> bool {
   00659|         match &self.computation {
   00660|             Computation::DeclarationRemoval { .. } => true,
   00661|             Computation::Line(operation) => operation.bounded(),
   00662|             _ => false,
   00663|         }
   00664|     }
