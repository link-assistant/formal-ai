   00686| /// The file after the insertion; a file without a final newline keeps none.
   00687| /// Lines under an append request, at the indentation they were given.
   00688| ///
   00689| /// Only when the file already has lines indented exactly so (a `.lino` table
   00690| /// appended among its siblings); else at the file's top level, since the
   00691| /// indentation of lines written under a request is otherwise only its layout
   00692| /// (PR #1188 G16).
   00693| fn appended_block(source: &str, text: &str, indentation: Option<&str>) -> String {
   00694|     match indentation {
   00695|         Some(indentation) if super::positional_edit::indents_lines_at(source, indentation) => {
   00696|             super::positional_edit::rebased_block(text, indentation)
   00697|         }
   00698|         _ => text.to_owned(),
   00699|     }
   00700| }
   00701| 
   00702| /// The indentation of the first line that is `text` but for its indentation.
   00703| fn line_indentation<'a>(source: &'a str, text: &str) -> &'a str {
   00704|     source
   00705|         .split('\n')
   00706|         .find(|line| line.trim() == text.trim())
   00707|         .map_or("", super::positional_edit::leading_indentation)
   00708| }
   00709| 
   00710| fn inserted_at_end(source: &str, text: &str, at_end: bool) -> String {
   00711|     if source.is_empty() {
   00712|         [text, "\n"].concat()
   00713|     } else if at_end && source.ends_with('\n') {
   00714|         [source, text, "\n"].concat()
   00715|     } else if at_end {
   00716|         [source, "\n", text].concat()
   00717|     } else {
   00718|         [text, "\n", source].concat()
   00719|     }
   00720| }
   00721| 
   00722| /// The smallest unique run of whole lines at the insertion end, and what it
   00723| /// becomes, so the edit tool carries the change rather than the whole file.
   00724| fn compact_end_edit(source: &str, updated: &str, at_end: bool) -> Option<(String, String)> {
   00725|     let starts = source
   00726|         .match_indices('\n')
   00727|         .map(|(index, _)| index + 1)
   00728|         .filter(|start| *start < source.len());
   00729|     let cuts: Vec<usize> = if at_end {
   00730|         std::iter::once(0).chain(starts).rev().collect()
   00731|     } else {
   00732|         starts.chain(std::iter::once(source.len())).collect()
   00733|     };
   00734|     for cut in cuts {
   00735|         let anchor = if at_end {
   00736|             &source[cut..]
   00737|         } else {
   00738|             &source[..cut]
   00739|         };
   00740|         if anchor.trim().is_empty() {
   00741|             continue;
   00742|         }
   00743|         if anchor.len() > MAX_ANCHOR_BYTES {
   00744|             break;
   00745|         }
   00746|         if source.matches(anchor).count() != 1 {
   00747|             continue;
   00748|         }
   00749|         let replacement = if at_end {
   00750|             &updated[cut..]
   00751|         } else {
   00752|             &updated[..updated.len() - (source.len() - cut)]
   00753|         };
   00754|         return Some((anchor.to_owned(), replacement.to_owned()));
   00755|     }
   00756|     None
   00757| }
