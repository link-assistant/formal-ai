   00346| /// `Delete the line 'x' from notes.txt`: the seeded `coding_text_remove_action`
   00347| /// with one quoted payload and one path, and no add action alongside it.
   00348| fn grounded_removal(task: &str) -> Option<ComputedChange> {
   00349|     if !mentions("coding_text_remove_action", task) || mentions("coding_member_add_action", task) {
   00350|         return None;
   00351|     }
   00352|     let (target, text) = quoted_payload_and_path(task)?;
   00353|     // A request that names a line removes whole lines, never only the
   00354|     // payload inside one (PR #1188 G60).
   00355|     let computation = if names_line(task) {
   00356|         let containing =
   00357|             seed::lexicon().mentions_role("line_containment_cue", &outside_quotes(task));
   00358|         Computation::LineRemoval {
   00359|             text: text.clone(),
   00360|             containing,
   00361|         }
   00362|     } else {
   00363|         Computation::Removal { text: text.clone() }
   00364|     };
   00365|     Some(ComputedChange {
   00366|         target,
   00367|         intent: "coding_text_remove",
   00368|         slots: vec![("{old}", text)],
   00369|         computation,
   00370|     })
   00371| }
