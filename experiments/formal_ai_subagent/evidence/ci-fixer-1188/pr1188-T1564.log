   00129| fn mentions(role: &str, task: &str) -> bool {
   00130|     seed::lexicon().mentions_role(role, &sentence_words(task))
   00131| }
   00132| 
   00133| /// The marks that end a sentence or a clause.
   00134| const SENTENCE_MARKS: [char; 11] = [
   00135|     '.', '!', '?', ';', ':', ',', '\u{0964}', '\u{0965}', '\u{3002}', '\u{ff01}', '\u{ff1f}',
   00136| ];
   00137| 
   00138| /// The lowered request with the marks that end a sentence or clause set off
   00139| /// as spaces, so a verb that closes its sentence (`… पंक्ति हटाओ।`, `…
   00140| /// удали.`) is still a whole word. A dot inside a token (`t.md`) is not
   00141| /// followed by a space and stays.
   00142| pub(super) fn sentence_words(task: &str) -> String {
   00143|     let lowered = task.to_lowercase();
   00144|     let characters: Vec<char> = lowered.chars().collect();
   00145|     let mut out = String::with_capacity(lowered.len());
   00146|     let mut index = 0;
   00147|     while index < characters.len() {
   00148|         let mut end = index;
   00149|         while end < characters.len() && SENTENCE_MARKS.contains(&characters[end]) {
   00150|             end += 1;
   00151|         }
   00152|         if end > index && characters.get(end).is_none_or(|next| next.is_whitespace()) {
   00153|             out.push(' ');
   00154|             index = end;
   00155|         } else {
   00156|             out.push(characters[index]);
   00157|             index += 1;
   00158|         }
   00159|     }
   00160|     out
   00161| }
