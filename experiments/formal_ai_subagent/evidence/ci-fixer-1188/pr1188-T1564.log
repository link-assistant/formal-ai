   00461| /// `Replace the line 'x' with 'y' in f`: the seeded `line` meaning outside
   00462| /// the quotes, both clauses quoted. A line replacement never touches text
   00463| /// inside a longer line (T32: `text pays` became `text "pay"s`). With a seeded
   00464| /// anchor context (`the line 'x' that follows the line 'z'`), the first such
   00465| /// line after `z` is the one replaced (T62).
   00466| fn grounded_line_replacement(task: &str) -> Option<ComputedChange> {
   00467|     if !names_line(task)
   00468|         || seed::lexicon().mentions_role(
   00469|             seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00470|             &task.to_lowercase(),
   00471|         )
   00472|     {
   00473|         return None;
   00474|     }
   00475|     let context = super::positional_edit::anchor_context(task);
   00476|     let request = context.as_ref().map_or_else(
   00477|         || task.to_owned(),
   00478|         |(start, end, _)| [&task[..*start], " ", &task[*end..]].concat(),
   00479|     );
   00480|     let (target, original, replacement) = compose_edit_request(&request)?;
   00481|     if super::positional_edit::compose_positional_insert(task).is_some() {
   00482|         return None;
   00483|     }
   00484|     let quoted: Vec<String> = quoted_segments(&request)
   00485|         .iter()
   00486|         .map(String::as_str)
   00487|         .map(super::positional_edit::unescape_prose_newlines)
   00488|         .collect();
   00489|     // Lines under the request (G22) replace the line as its siblings, unless
   00490|     // they were fenced or quoted.
   00491|     let block =
   00492|         super::positional_edit::introduced_block(task).filter(|block| block.text == replacement);
   00493|     // Listed lines (`the three lines 'a', 'b' and 'c'`) are quoted one by one (G80).
   00494|     let listed = !quoted.contains(&original);
   00495|     if (listed
   00496|         && !original
   00497|             .split('\n')
   00498|             .all(|line| quoted.iter().any(|text| text == line)))
   00499|         || (block.is_none() && !quoted.contains(&replacement))
   00500|         || original.is_empty()
   00501|         || original == replacement
   00502|     {
   00503|         return None;
   00504|     }
   00505|     Some(ComputedChange {
   00506|         target,
   00507|         intent: "coding_text_replaced",
   00508|         // Listed lines are named one by one, not as one span holding line breaks.
   00509|         slots: vec![
   00510|             (
   00511|                 "{old}",
   00512|                 if listed {
   00513|                     original.replace('\n', "`, `")
   00514|                 } else {
   00515|                     original.clone()
   00516|                 },
   00517|             ),
   00518|             ("{new}", replacement.clone()),
   00519|         ],
   00520|         computation: Computation::LineReplacement {
   00521|             old: original,
   00522|             new: replacement,
   00523|             context: context.map(|(_, _, text)| text),
   00524|             rebase: block.is_some_and(|block| !block.verbatim),
   00525|         },
   00526|     })
   00527| }
