   00759| impl ComputedChange {
   00760|     /// The seed sentence that states the change made to `source`: lines that
   00761|     /// only contained the payload are reported as lines, with their count;
   00762|     /// every other change keeps its own intent and slots.
   00763|     fn reported(&self, source: &str) -> (&'static str, Vec<(&'static str, String)>) {
   00764|         if let Computation::LineRemoval { text, containing } = &self.computation {
   00765|             let lines: Vec<&str> = source.split_inclusive('\n').map(bare_line).collect();
   00766|             let removed: Vec<&str> = removed_line_indices(source, text, *containing)
   00767|                 .into_iter()
   00768|                 .map(|index| lines[index])
   00769|                 .collect();
   00770|             if removed.iter().any(|line| line != text) {
   00771|                 return (
   00772|                     "line",
   00773|                     vec![
   00774|                         ("{old}", text.clone()),
   00775|                         ("{count}", removed.len().to_string()),
   00776|                     ],
   00777|                 );
   00778|             }
   00779|         }
   00780|         if let Computation::Section {
   00781|             heading,
   00782|             text,
   00783|             at_end,
   00784|         } = &self.computation
   00785|             && let Some((_, follows)) =
   00786|                 super::markdown_section::inserted_in_section(source, heading, text, *at_end)
   00787|         {
   00788|             return (
   00789|                 self.intent,
   00790|                 vec![("{new}", text.clone()), ("{anchor}", follows)],
   00791|             );
   00792|         }
   00793|         if let Computation::DeclarationRemoval { names } = &self.computation
   00794|             && let Some((_, declared)) = removed_declarations(source, names)
   00795|         {
   00796|             return (self.intent, vec![("{old}", declared.join("`, `"))]);
   00797|         }
   00798|         if let Computation::Line(operation) = &self.computation
   00799|             && let Some(reported) = operation.reported(source)
   00800|         {
   00801|             return reported;
   00802|         }
   00803|         (self.intent, self.slots.clone())
   00804|     }
   00805| 
   00806|     /// Preserve removed names and lines as explicit list values for the summary.
   00807|     fn reported_values(&self, source: &str) -> Option<Vec<String>> {
   00808|         match &self.computation {
   00809|             Computation::DeclarationRemoval { names } => {
   00810|                 removed_declarations(source, names).map(|(_, values)| values)
   00811|             }
   00812|             Computation::Line(operation) => operation.reported_values(source),
   00813|             _ => None,
   00814|         }
   00815|     }
   00816| }
