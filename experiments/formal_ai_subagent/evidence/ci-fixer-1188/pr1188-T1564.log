   00818| /// Read, compute, edit (or write), check the digest, state the change.
   00819| pub(super) fn plan_computed_change_step(
   00820|     task: &str,
   00821|     current_turn: &[ChatMessage],
   00822|     tool_names: &[&str],
   00823|     change: &ComputedChange,
   00824| ) -> Option<AgenticPlan> {
   00825|     let target = change.target.as_str();
   00826|     let Some(read) = result_for_path(current_turn, Capability::Read, target, None) else {
   00827|         let tool = tool_for(tool_names, Capability::Read)?;
   00828|         return Some(plan_one(tool, read_arguments(target)));
   00829|     };
   00830|     // A read that came back as the client's file block is the file, whatever
   00831|     // its text says: a ledger that quotes error lines is not a missing file.
   00832|     let missing = super::code_artifact::source_from_agent_read_result(&read).is_none()
   00833|         && super::tool_result::failure_message(&read, false, true).is_some();
   00834|     let source = if missing {
   00835|         String::new()
   00836|     } else {
   00837|         source_from_read_result(&read)
   00838|     };
   00839|     if let Some(answer) = super::edit_scope::scoped_decline(task, target, &source) {
   00840|         return Some(AgenticPlan::Final(answer));
   00841|     }
   00842|     let Some(updated) = change
   00843|         .compute(&source, missing)
   00844|         .filter(|updated| *updated != source)
   00845|     else {
   00846|         // Text the change names that the file no longer holds is the answer (G87).
   00847|         let absent = if missing {
   00848|             None
   00849|         } else {
   00850|             change.absent_text_answer(task, &source)
   00851|         };
   00852|         return Some(AgenticPlan::Final(match absent {
   00853|             Some(answer) => answer,
   00854|             None => render_seeded_outcome("coding_workspace_verification_failed", task, target)?,
   00855|         }));
   00856|     };
   00857|     // A change that would drop most of the file is refused unless its request
   00858|     // states that extent (PR #1188 T29).
   00859|     if !change.bounded() && drops_most_of_file(&source, &updated) {
   00860|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00861|             "coding_workspace_fragment_refused",
   00862|             task,
   00863|             target,
   00864|         )?));
   00865|     }
   00866|     let (intent, reported) = change.reported(&source);
   00867|     let slots: Vec<(&str, &str)> = reported
   00868|         .iter()
   00869|         .map(|(slot, value)| (*slot, value.as_str()))
   00870|         .collect();
   00871|     let values = change.reported_values(&source);
   00872|     let list_slots: Vec<(&str, &[String])> = values
   00873|         .as_deref()
   00874|         .map(|values| vec![(concat!("{", "old", "}"), values)])
   00875|         .unwrap_or_default();
   00876|     let verified = VerifiedChange {
   00877|         target,
   00878|         expected: &updated,
   00879|         intent,
   00880|         slots: &slots,
   00881|         list_slots: &list_slots,
   00882|     };
   00883|     if let Some((old, new)) = change.edit(&source, &updated)
   00884|         && let Some(tool) = tool_for(tool_names, Capability::Edit)
   00885|     {
   00886|         if result_for_edit(current_turn, target, &old, &new).is_none() {
   00887|             return Some(plan_one(tool, edit_arguments(target, &old, &new)));
   00888|         }
   00889|         return plan_digest_verification(task, current_turn, tool_names, &verified);
   00890|     }
   00891|     if result_for_path(current_turn, Capability::Write, target, Some(&updated)).is_none() {
   00892|         let tool = tool_for(tool_names, Capability::Write)?;
   00893|         return Some(plan_one(tool, write_arguments(target, &updated)));
   00894|     }
   00895|     plan_digest_verification(task, current_turn, tool_names, &verified)
   00896| }
