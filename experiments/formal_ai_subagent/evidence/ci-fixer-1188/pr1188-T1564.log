   00564| impl ComputedChange {
   00565|     /// The seeded answer when the text a replace or removal names is gone.
   00566|     fn absent_text_answer(&self, task: &str, source: &str) -> Option<String> {
   00567|         if !matches!(self.intent, "coding_text_replaced" | "coding_text_remove") {
   00568|             return None;
   00569|         }
   00570|         let slot = |name: &str| {
   00571|             self.slots
   00572|                 .iter()
   00573|                 .find(|(key, _)| *key == name)
   00574|                 .map(|(_, value)| value.as_str())
   00575|         };
   00576|         super::replace_list::absent_text_answer(
   00577|             task,
   00578|             &self.target,
   00579|             source,
   00580|             slot("{old}")?,
   00581|             slot("{new}"),
   00582|         )
   00583|     }
