   00040| /// How a computed change derives the file's new bytes.
   00041| #[derive(Debug, Clone, PartialEq, Eq)]
   00042| pub(super) enum Computation {
   00043|     /// Quoted text placed as the last (`at_end`) or the first line; lines
   00044|     /// given under the request keep their shared `indentation` when the file
   00045|     /// has lines indented exactly so (PR #1188 G16).
   00046|     EndInsertion {
   00047|         text: String,
   00048|         at_end: bool,
   00049|         indentation: Option<String>,
   00050|     },
   00051|     /// Every line that is exactly `text`, else its one in-line occurrence.
   00052|     Removal { text: String },
   00053|     /// Whole lines (the request names a line): see `removed_line_indices`.
   00054|     LineRemoval { text: String, containing: bool },
   00055|     /// The one line assigning `key` (holding `held`, when stated) gets
   00056|     /// `value`, in the file's own quoting.
   00057|     Setting {
   00058|         key: String,
   00059|         value: String,
   00060|         held: Option<String>,
   00061|     },
   00062|     /// Every line that is `old` becomes `new` (the request names a line), or
   00063|     /// only the first one after `context`.
   00064|     LineReplacement {
   00065|         old: String,
   00066|         new: String,
   00067|         context: Option<String>,
   00068|         rebase: bool,
   00069|     },
   00070|     /// Every whole-word `word` becomes its discovered `correction`.
   00071|     TypoFix { word: String, correction: String },
   00072|     /// The functions the file declares under these names go whole, with the
   00073|     /// comment and attribute lines directly above them.
   00074|     DeclarationRemoval { names: Vec<String> },
   00075|     /// A whole-line operation: numbered, adjacent, moved or swapped lines.
   00076|     Line(LineOperation),
   00077|     /// `text` placed at one end of the Markdown section under `heading`
   00078|     /// (PR #1188 G35).
   00079|     Section {
   00080|         heading: String,
   00081|         text: String,
   00082|         at_end: bool,
   00083|     },
   00084|     /// Each `(old, new)` pair replaced everywhere, in order (PR #1188 G82).
   00085|     ReplaceList { pairs: Vec<(String, String)> },
   00086| }
