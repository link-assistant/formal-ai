   00335| /// Several quoted literals, joined only by seeded joiners and commas, are the
   00336| /// lines added, each its own line, as written (PR #1188 G53, G54).
   00337| fn quoted_lines_and_path(task: &str) -> Option<(String, String)> {
   00338|     let (target, payloads) = named_target_and_payloads(task)?;
   00339|     if payloads.len() < 2 {
   00340|         return None;
   00341|     }
   00342|     let text = super::positional_edit::joined_literal_lines(task, &target)?;
   00343|     Some((target, text))
   00344| }
