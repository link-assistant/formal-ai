   00898| /// `Append the line third to notes.txt`: no quoted text, one path, and the
   00899| /// seeded `file_edit_line_lead`; the line is the words after the lead up to
   00900| /// the last destination cue before the path (`go to bed to notes.txt` keeps
   00901| /// `go to bed`). A request without a lead is declined, never guessed.
   00902| fn line_payload_and_path(task: &str) -> Option<(String, String)> {
   00903|     if !quoted_segment_spans(task).is_empty() {
   00904|         return None;
   00905|     }
   00906|     let tokens = tokens(task);
   00907|     let paths: Vec<(usize, &str)> = tokens
   00908|         .iter()
   00909|         .enumerate()
   00910|         .map(|(index, token)| (index, clean_path_token(token.text)))
   00911|         .filter(|(_, path)| looks_like_file_path(path) && safe_relative_path(path))
   00912|         .collect();
   00913|     let (path_index, target) = *paths.first()?;
   00914|     if paths.iter().any(|(_, path)| *path != target) {
   00915|         return None;
   00916|     }
   00917|     let mut leads: Vec<Vec<String>> = seed::lexicon()
   00918|         .words_for_role("file_edit_line_lead")
   00919|         .iter()
   00920|         .map(|lead| {
   00921|             lead.to_lowercase()
   00922|                 .split_whitespace()
   00923|                 .map(str::to_owned)
   00924|                 .collect::<Vec<_>>()
   00925|         })
   00926|         .filter(|words| !words.is_empty())
   00927|         .collect();
   00928|     leads.sort_by_key(|words| std::cmp::Reverse(words.len()));
   00929|     let lead_end = (0..path_index).find_map(|index| {
   00930|         leads
   00931|             .iter()
   00932|             .find(|words| {
   00933|                 words.iter().enumerate().all(|(offset, word)| {
   00934|                     index + offset < path_index
   00935|                         && clean_cue_token(tokens[index + offset].text) == *word
   00936|                 })
   00937|             })
   00938|             .map(|words| index + words.len())
   00939|     })?;
   00940|     let destinations = bare_surfaces("file_write_destination_cue");
   00941|     let end = (lead_end..path_index)
   00942|         .rev()
   00943|         .find(|index| destinations.contains(&clean_cue_token(tokens[*index].text)))?;
   00944|     if end <= lead_end {
   00945|         return None;
   00946|     }
   00947|     Some((
   00948|         target.to_owned(),
   00949|         task[tokens[lead_end].start..tokens[end - 1].end].to_owned(),
   00950|     ))
   00951| }
   00952| 
   00953| /// The one path a colon-ended request line names, with nothing else quoted
   00954| /// (mirrors `blockPayloadAndPath`).
   00955| fn block_target(head: &str) -> Option<String> {
   00956|     let mut paths: Vec<&str> = super::positional_edit::unquoted_path_tokens(head)
   00957|         .iter()
   00958|         .map(|token| clean_path_token(token.text))
   00959|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00960|         .collect();
   00961|     paths.sort_unstable();
   00962|     paths.dedup();
   00963|     let [path] = paths.as_slice() else {
   00964|         return None;
   00965|     };
   00966|     quoted_segment_spans(head)
   00967|         .iter()
   00968|         .all(|segment| segment.text == *path)
   00969|         .then(|| (*path).to_owned())
   00970| }
   00971| 
   00972| /// The seeded `file_edit_blank_line` with one named path and no quoted text:
   00973| /// the payload is the empty string (mirrors `blankLineAndPath`).
   00974| fn blank_line_and_path(task: &str) -> Option<(String, String)> {
   00975|     if !quoted_segment_spans(task).is_empty() || !mentions("file_edit_blank_line", task) {
   00976|         return None;
   00977|     }
   00978|     let mut paths: Vec<String> = super::positional_edit::unquoted_path_tokens(task)
   00979|         .iter()
   00980|         .map(|token| clean_path_token(token.text).to_owned())
   00981|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00982|         .collect();
   00983|     paths.sort();
   00984|     paths.dedup();
   00985|     match paths.as_slice() {
   00986|         [path] => Some((path.clone(), String::new())),
   00987|         _ => None,
   00988|     }
   00989| }
