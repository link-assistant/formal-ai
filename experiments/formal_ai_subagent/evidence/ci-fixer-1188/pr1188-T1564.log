   00373| /// `Delete the functions a and b from util.rs`: the seeded
   00374| /// `coding_text_remove_action` and `coding_declaration_noun` with no add
   00375| /// action, no quoted text and one named path. The names are the request's
   00376| /// identifiers; `removed_declarations` keeps those the file itself declares
   00377| /// as functions (mirrors `groundedDeclarationRemoval`, PR #1188 dogfooding).
   00378| fn grounded_declaration_removal(task: &str) -> Option<ComputedChange> {
   00379|     if !mentions("coding_text_remove_action", task)
   00380|         || mentions("coding_member_add_action", task)
   00381|         || !mentions("coding_declaration_noun", task)
   00382|         || !quoted_segment_spans(task).is_empty()
   00383|     {
   00384|         return None;
   00385|     }
   00386|     let mut paths: Vec<String> = super::positional_edit::unquoted_path_tokens(task)
   00387|         .iter()
   00388|         .map(|token| clean_path_token(token.text).to_owned())
   00389|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00390|         .collect();
   00391|     paths.sort();
   00392|     paths.dedup();
   00393|     let [target] = paths.as_slice() else {
   00394|         return None;
   00395|     };
   00396|     let mut names: Vec<String> = Vec::new();
   00397|     for token in tokens(task) {
   00398|         if clean_path_token(token.text) == target {
   00399|             continue;
   00400|         }
   00401|         for name in identifier_tokens(token.text) {
   00402|             if !names.iter().any(|known| known == name) {
   00403|                 names.push(name.to_owned());
   00404|             }
   00405|         }
   00406|     }
   00407|     if names.is_empty() {
   00408|         return None;
   00409|     }
   00410|     Some(ComputedChange {
   00411|         target: target.clone(),
   00412|         intent: "coding_text_remove",
   00413|         slots: vec![("{old}", names.join("`, `"))],
   00414|         computation: Computation::DeclarationRemoval { names },
   00415|     })
   00416| }
