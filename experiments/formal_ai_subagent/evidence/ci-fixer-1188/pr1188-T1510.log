   00217| #[test]
   00218| fn minimal_core_ledger_covers_every_recursive_handler_source() {
   00219|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00220|         .parent()
   00221|         .expect("the repository root sits one level above the crate");
   00222|     let actual = handler_sources();
   00223|     let ledger = fs::read_to_string(root.join("data/meta/core-boundary-ledger.lino"))
   00224|         .expect("issue #918 must provide the source-file core-boundary ledger");
   00225|     let entries = ledger_entries(&ledger);
   00226|     let active = entries
   00227|         .iter()
   00228|         .filter(|entry| entry.disposition != "delete")
   00229|         .map(|entry| entry.path.clone())
   00230|         .collect::<BTreeSet<_>>();
   00231| 
   00232|     assert_eq!(active, actual);
   00233|     // The census history (46 before issue #1085, the plan 09 leaf 1 corrected
   00234|     // undercount, the plan 08 and URL-parsing promotions, the plan 16 L1
   00235|     // re-measure, the PR #1188 interpreters) lives in the ledger's `note` rows.
   00236|     // Restating the totals here froze 53 / 51 / 2 long after the ledger moved
   00237|     // on, so the expected counts are the ledger's own reviewed ceilings: the
   00238|     // gate proves those equal to the tree, and this test proves the rows agree.
   00239|     let ceiling = |field: &str| -> usize {
   00240|         ledger
   00241|             .lines()
   00242|             .find_map(|line| line.trim().strip_prefix(field))
   00243|             .and_then(|value| value.trim().parse().ok())
   00244|             .unwrap_or_else(|| panic!("the ledger records {field}"))
   00245|     };
   00246|     let source_files = ceiling("source_file_count_max ");
   00247|     let outside_core_files = ceiling("outside_core_file_count_max ");
   00248|     assert_eq!(actual.len(), source_files);
   00249|     assert_eq!(
   00250|         entries
   00251|             .iter()
   00252|             .filter(|entry| entry.disposition == "migrate")
   00253|             .count(),
   00254|         outside_core_files
   00255|     );
   00256|     assert_eq!(
   00257|         entries
   00258|             .iter()
   00259|             .filter(|entry| entry.disposition == "promote")
   00260|             .count(),
   00261|         source_files - outside_core_files,
   00262|         "every active row is either migration debt or a promoted interpreter"
   00263|     );
   00264|     for entry in entries
   00265|         .iter()
   00266|         .filter(|entry| entry.disposition == "promote")
   00267|     {
   00268|         assert!(
   00269|             !entry.core_component.is_empty(),
   00270|             "{} promotion must name its core component",
   00271|             entry.path
   00272|         );
   00273|         assert!(
   00274|             !entry.reason.is_empty(),
   00275|             "{} promotion must explain the boundary decision",
   00276|             entry.path
   00277|         );
   00278|     }
   00279|     for disposition in entries.iter().map(|entry| entry.disposition.as_str()) {
   00280|         assert!(matches!(disposition, "migrate" | "promote" | "delete"));
   00281|     }
   00282|     // The ledger's ceiling is the measurement itself: the gate fails when it sits
   00283|     // above *or* below the real count, so migration debt can only ratchet down.
   00284|     // Restating the number here would freeze a value that every handler edit moves
   00285|     // into a second shared file -- the conflict shape issue #991 removes -- so the
   00286|     // expected total is summed from the same sources the gate measures.
   00287|     let lines = handler_source_lines();
   00288|     let outside_core_lines: usize = entries
   00289|         .iter()
   00290|         .filter(|entry| entry.disposition == "migrate")
   00291|         .map(|entry| lines[&entry.path])
   00292|         .sum();
   00293|     assert!(ledger.contains(&format!("outside_core_lines_max {outside_core_lines}")));
   00294| }
