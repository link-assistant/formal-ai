   00374| #[test]
   00375| fn coding_path_has_complete_metadata_and_every_other_gap_is_data() {
   00376|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00377|         .parent()
   00378|         .expect("the repository root sits one level above the crate");
   00379|     let schema_text = fs::read_to_string(root.join("data/meta/seed-metadata-schema.lino"))
   00380|         .expect("seed metadata schema");
   00381|     let required = required_metadata(&schema_text);
   00382|     assert_eq!(
   00383|         required,
   00384|         ["role", "precondition", "effect", "unit", "example"]
   00385|     );
   00386|     for external_shape in ["FrameNet", "Wikidata:Data_model", "typed property value"] {
   00387|         assert!(
   00388|             schema_text.contains(external_shape),
   00389|             "schema must cite {external_shape}"
   00390|         );
   00391|     }
   00392|     let complete_sources = schema_text
   00393|         .lines()
   00394|         .filter_map(|line| line.strip_prefix("  complete_source "))
   00395|         .map(|value| value.trim_matches('"').to_owned())
   00396|         .collect::<BTreeSet<_>>();
   00397|     assert_eq!(complete_sources.len(), 3);
   00398|     let registered_languages = formal_ai::language::registered_languages();
   00399|     assert!(!registered_languages.is_empty(), "language registry");
   00400| 
   00401|     let mut expected_gaps = BTreeMap::new();
   00402|     let mut coding_records = 0;
   00403|     let seed_root = root.join("data/seed");
   00404|     for path in lino_files_below(&seed_root) {
   00405|         let source = path
   00406|             .strip_prefix(root)
   00407|             .expect("relative seed path")
   00408|             .to_string_lossy()
   00409|             .replace('\\', "/");
   00410|         let text = fs::read_to_string(&path).expect("seed file");
   00411|         for (source, record, fields) in meaning_records(&source, &text) {
   00412|             let missing = required
   00413|                 .iter()
   00414|                 .filter(|field| !fields.contains(field.as_str()))
   00415|                 .cloned()
   00416|                 .collect::<Vec<_>>();
   00417|             if complete_sources.contains(&source) {
   00418|                 coding_records += 1;
   00419|                 for language in &registered_languages {
   00420|                     assert!(
   00421|                         missing.is_empty(),
   00422|                         "{source}:{record} is missing language-neutral metadata {missing:?} for {}",
   00423|                         language.slug()
   00424|                     );
   00425|                 }
   00426|             } else if !missing.is_empty() {
   00427|                 expected_gaps.insert((source, record), missing.join(","));
   00428|             }
   00429|         }
   00430|     }
   00431|     // Scala and Kotlin joined the coding catalog for the hive-mind#2158
   00432|     // language matrix (issue #921), and PHP followed them under issue #1021, so
   00433|     // the complete-source floor rises with each: 27 catalog records + 15 task
   00434|     // records. The fifteenth task is `program_task_copy_stdin_to_stdout`, the
   00435|     // task issue #863 reported (see `tests/unit/issue_1021_behaviour_range.rs`);
   00436|     // the twenty-seventh catalog record is `program_language_laravel`, the
   00437|     // framework issue #723 asked for, which is a catalog row of its own rather
   00438|     // than an alias surface of PHP. Either way a new target is a new
   00439|     // complete-source record, never a new gap. Three later additions are not
   00440|     // language targets at all: `workspace_inspection_examine`,
   00441|     // `workspace_inspection_verify` and `workspace_inspection_identify` are the
   00442|     // vocabulary that lets a request to *look at* the repository route to a
   00443|     // workspace search instead of an open-web one (issue #1066). They land in
   00444|     // the same complete source as the coding tasks and carry the same five
   00445|     // fields, so they raise the floor rather than the gap count -- which is the
   00446|     // point of the floor: new agent capability arrives as described data.
   00447|     // Issue #1069 first added 29 complete workspace-search records, moving the
   00448|     // floor from 45 to 74. Its verified ladder then supplied 18 leaf-first
   00449|     // decomposition and proof facts, moving the floor from 74 to 92. Its
   00450|     // change-shaped delegation work added the three member-list kinds --
   00451|     // `coding_member_list_sequence`, `coding_member_list_set` and
   00452|     // `coding_member_list_group` -- that let a request name the collection it
   00453|     // edits in words the file never has to repeat, moving the floor from 92 to
   00454|     // 95. Issue #1131 added `coding_member_add`, the verb that says a member
   00455|     // list should grow, moving the floor from 95 to 96: the nouns alone had
   00456|     // been routing whole-file rewrites into member insertion. Issue #1133
   00457|     // added five more records from the three Hive Mind runs that produced no
   00458|     // solution -- `git_branch_cue` and `git_commit_request` (where a work
   00459|     // item's result lands, and the request to land it), `ci_workflow_request`
   00460|     // (the workflow an issue asks for beside the program) and the two
   00461|     // `file_edit_position_*` cues of an additive edit -- moving the floor
   00462|     // from 96 to 101: each was a hardcoded English sentence or a missing route
   00463|     // before it was data. None is allowed to become a metadata gap.
   00464|     // Issue #1138 moved five repository-workflow meanings out of the coding
   00465|     // task source into their own complete domain source, then added four
   00466|     // language-neutral repository-target meanings here. Recounted 2026-09-22,
   00467|     // the three complete coding sources carry 5 (config) + 28 (catalog) +
   00468|     // 68 (tasks) = 101 records: the #1138 net-floor line said 100 and shipped
   00469|     // unverified, masked by a run whose census-freshness step died before the
   00470|     // unit tests executed. The floor is 101; none of the nine records became
   00471|     // an unreviewed metadata gap.
   00472|     // Issue #1167 added `program_language_swift` and `program_language_r` to
   00473|     // the catalog, each with role, precondition, effect, unit and example, so
   00474|     // the catalog carries 30 and the floor moves from 101 to 103.
   00475|     // The agentic edit verbs then added three task records, each with all
   00476|     // five fields: `coding_text_remove` (remove quoted text from a file),
   00477|     // `setting` (the key of a configuration file whose value changes) and
   00478|     // `typo` (a misspelling whose correction is discovered, not stated), so
   00479|     // the floor moves from 103 to 106.
   00480|     // PR #1188 then added seven, each with all five fields: the edit composer's
   00481|     // `coding_declaration` and `function_declaration` (a function named by
   00482|     // identifier is removed whole), `function_call` (the undefined-call
   00483|     // routing claim), `coding_bug_fix_request` and `coding_expectation_cue`
   00484|     // (a stated expectation drives the fix), and `module_export_question` and
   00485|     // `module_export_marker` (what a module exports), so the floor moves from
   00486|     // 106 to 113.
   00487|     // PR #1188 round 18 moved the decomposition-tree and Agent-CLI ladder
   00488|     // records out of the tasks source to keep it under 1500 lines, and the
