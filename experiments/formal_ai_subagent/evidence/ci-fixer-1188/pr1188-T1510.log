   00296| #[test]
   00297| fn generic_interpreter_components_are_registered_outside_the_census() {
   00298|     // Issue #1138 B9, plan 09 leaf 17: the migration families need compiled
   00299|     // homes that are not themselves handler debt. A `component` block in the
   00300|     // ledger names one such file outside the census, the boundary category it
   00301|     // was promoted under, and the reason it passes the promotion test. The
   00302|     // test reads the ledger through the gate's own parser so the gate and the
   00303|     // suite cannot disagree about what a component is.
   00304|     let root = Path::new(env!("CARGO_MANIFEST_DIR"))
   00305|         .parent()
   00306|         .expect("the repository root sits one level above the crate");
   00307|     let ledger_text = fs::read_to_string(root.join("data/meta/core-boundary-ledger.lino"))
   00308|         .expect("issue #918 must provide the source-file core-boundary ledger");
   00309|     let ledger = check_minimal_core_boundary::parse_ledger(&ledger_text)
   00310|         .expect("the boundary ledger parses, components included");
   00311|     let census = handler_sources();
   00312|     assert!(
   00313|         !ledger.components.is_empty(),
   00314|         "the migration families register their generic interpreters as components"
   00315|     );
   00316|     let mut names = BTreeSet::new();
   00317|     for record in &ledger.components {
   00318|         assert!(
   00319|             names.insert(record.name.as_str()),
   00320|             "component names are unique: {}",
   00321|             record.name
   00322|         );
   00323|         assert_eq!(
   00324|             record.kind, "Generic interpreter",
   00325|             "component {} is registered under the boundary document's interpreter category",
   00326|             record.name
   00327|         );
   00328|         assert!(
   00329|             !record.reason.is_empty(),
   00330|             "component {} explains the promotion decision",
   00331|             record.name
   00332|         );
   00333|         assert!(
   00334|             !census.contains(&record.file),
   00335|             "component {} file {} must sit outside the handler census",
   00336|             record.name,
   00337|             record.file
   00338|         );
   00339|         assert!(
   00340|             root.join(&record.file).is_file(),
   00341|             "component {} file {} must exist",
   00342|             record.name,
   00343|             record.file
   00344|         );
   00345|     }
   00346|     assert!(
   00347|         names.contains("retrieval_method_interpreter"),
   00348|         "the M2 retrieval family's interpreter is registered"
   00349|     );
   00350| }
