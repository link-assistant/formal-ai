   00099| fn meaning_records(source: &str, text: &str) -> Vec<(String, String, BTreeSet<String>)> {
   00100|     if text.lines().find(|line| !line.trim().is_empty()) != Some("meanings") {
   00101|         return Vec::new();
   00102|     }
   00103|     let mut records = Vec::new();
   00104|     let mut current: Option<(String, String, BTreeSet<String>)> = None;
   00105|     for line in text.lines().skip(1) {
   00106|         // A `#` line documents the records around it, as in the audit script
   00107|         // (`scripts/audit-seed-metadata.rs`); it is never a record itself.
   00108|         if line.trim_start().starts_with('#') {
   00109|             continue;
   00110|         }
   00111|         let indentation = line.bytes().take_while(|byte| *byte == b' ').count();
   00112|         if indentation == 2 {
   00113|             if let Some(record) = current.take() {
   00114|                 records.push(record);
   00115|             }
   00116|             current = Some((
   00117|                 source.to_owned(),
   00118|                 line.split_whitespace()
   00119|                     .next()
   00120|                     .expect("meaning name")
   00121|                     .to_owned(),
   00122|                 BTreeSet::new(),
   00123|             ));
   00124|         } else if indentation == 4 {
   00125|             let trimmed = line.trim();
   00126|             if let (Some(record), Some(value_offset)) =
   00127|                 (current.as_mut(), trimmed.find(char::is_whitespace))
   00128|             {
   00129|                 let field = &trimmed[..value_offset];
   00130|                 let raw_value = trimmed[value_offset..].trim();
   00131|                 let value = raw_value
   00132|                     .strip_prefix('"')
   00133|                     .and_then(|value| value.strip_suffix('"'))
   00134|                     .unwrap_or(raw_value);
   00135|                 if !value.trim().is_empty() {
   00136|                     record.2.insert(field.to_owned());
   00137|                 }
   00138|             }
   00139|         }
   00140|     }
   00141|     if let Some(record) = current {
   00142|         records.push(record);
   00143|     }
   00144|     records
   00145| }
   00146| 
   00147| /// Every `.lino` file below `directory`.
   00148| fn lino_files(directory: &Path, files: &mut Vec<PathBuf>) {
   00149|     for entry in fs::read_dir(directory)
   00150|         .expect("metadata gap directory")
   00151|         .filter_map(Result::ok)
   00152|     {
   00153|         let path = entry.path();
   00154|         if path.is_dir() {
   00155|             lino_files(&path, files);
   00156|         } else if path.extension().is_some_and(|value| value == "lino") {
   00157|             files.push(path);
   00158|         }
   00159|     }
   00160| }
   00161| 
   00162| /// The committed gaps: one file per seed source below
   00163| /// `data/meta/seed-metadata-gaps/` (R1188-U5). A file states its source once,
   00164| /// and the missing fields most of its gaps share once as the file default
   00165| /// (R1188-U7); a gap states `missing` only where it differs.
   00166| fn committed_gaps(root: &Path) -> BTreeMap<(String, String), String> {
   00167|     let mut paths = Vec::new();
   00168|     lino_files(&root.join("data/meta/seed-metadata-gaps"), &mut paths);
   00169|     paths.sort();
   00170|     assert!(!paths.is_empty(), "the metadata gap audit writes gap files");
   00171| 
   00172|     let mut gaps = BTreeMap::new();
   00173|     for path in paths {
   00174|         let text = fs::read_to_string(&path).expect("metadata gap file");
   00175|         assert!(
   00176|             text.lines().count() <= 1_500,
   00177|             "{} exceeds the data-file line limit",
   00178|             path.display()
   00179|         );
   00180|         let source = text
   00181|             .lines()
   00182|             .find_map(|line| line.strip_prefix("  source "))
   00183|             .map(|value| value.trim_matches('"').to_owned())
   00184|             .expect("a gap file states its source");
   00185|         let shared_missing = text
   00186|             .lines()
   00187|             .find_map(|line| line.strip_prefix("  missing "))
   00188|             .map_or_else(String::new, |value| value.trim_matches('"').to_owned());
   00189|         let mut entries: Vec<(String, String, String)> = Vec::new();
   00190|         for line in text.lines() {
   00191|             if let Some(id) = line.strip_prefix("  gap ") {
   00192|                 assert!(
   00193|                     id.starts_with("seed-metadata-gap-") && id.len() == 34,
   00194|                     "gap identifier should be a stable 64-bit hash: {id}"
   00195|                 );
   00196|                 entries.push((id.to_owned(), String::new(), shared_missing.clone()));
   00197|             } else if let Some(value) = line.strip_prefix("    record ") {
   00198|                 entries.last_mut().expect("gap record").1 = value.trim_matches('"').to_owned();
   00199|             } else if let Some(value) = line.strip_prefix("    missing ") {
   00200|                 entries.last_mut().expect("gap missing").2 = value.trim_matches('"').to_owned();
   00201|             }
   00202|         }
   00203|         for (_, record, missing) in entries {
   00204|             assert!(
   00205|                 !missing.is_empty(),
   00206|                 "{record} in {source} names no missing field"
   00207|             );
   00208|             assert!(
   00209|                 gaps.insert((source.clone(), record), missing).is_none(),
   00210|                 "each seed record has at most one gap entry"
   00211|             );
   00212|         }
   00213|     }
   00214|     gaps
   00215| }
