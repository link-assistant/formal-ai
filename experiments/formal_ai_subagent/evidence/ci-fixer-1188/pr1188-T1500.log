   00022|     fn fake_code(bin_dir: &Path) {
   00023|         let path = bin_dir.join("code");
   00024|         std::fs::write(
   00025|             &path,
   00026|             r#"#!/bin/sh
   00027| {
   00028|   i=0
   00029|   for arg in "$@"; do printf "arg[%s]=%s\n" "$i" "$arg"; i=$((i + 1)); done
   00030|   printf "FORMAL_AI_API_KEY=%s\n" "${FORMAL_AI_API_KEY-}"
   00031|   printf "OPENCODE_CONFIG=%s\n" "${OPENCODE_CONFIG-}"
   00032|   if [ -n "${OPENCODE_CONFIG-}" ] && [ -f "$OPENCODE_CONFIG" ]; then
   00033|     printf "%s\n" "---OPENCODE_CONFIG---"
   00034|     cat "$OPENCODE_CONFIG"
   00035|   fi
   00036| } > "$FORMAL_AI_CAPTURE"
   00037| "#,
   00038|         )
   00039|         .expect("fake code");
   00040|         let mut permissions = std::fs::metadata(&path).expect("metadata").permissions();
   00041|         permissions.set_mode(0o755);
   00042|         std::fs::set_permissions(path, permissions).expect("chmod");
   00043|     }
