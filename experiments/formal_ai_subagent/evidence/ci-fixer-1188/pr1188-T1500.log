   00045|     fn run(home: &Path, bin_dir: &Path, capture: &Path, alias: &str) -> Output {
   00046|         let path = format!(
   00047|             "{}:{}",
   00048|             bin_dir.display(),
   00049|             std::env::var("PATH").unwrap_or_default()
   00050|         );
   00051|         Command::new(env!("CARGO_BIN_EXE_formal-ai"))
   00052|             .args([
   00053|                 "with",
   00054|                 "--no-start-server",
   00055|                 "--base-url",
   00056|                 "http://127.0.0.1:18080",
   00057|                 alias,
   00058|             ])
   00059|             .env("HOME", home)
   00060|             .env("PATH", path)
   00061|             .env("FORMAL_AI_CAPTURE", capture)
   00062|             .env_remove("FORMAL_AI_API_KEY")
   00063|             .env_remove("OPENCODE_CONFIG")
   00064|             .output()
   00065|             .expect("run wrapper")
   00066|     }
