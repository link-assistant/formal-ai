   00012|     fn temp_dir() -> PathBuf {
   00013|         let seq = SEQ.fetch_add(1, Ordering::Relaxed);
   00014|         let path = std::env::temp_dir().join(format!(
   00015|             "formal-ai-opencode-vscode-{}-{seq}",
   00016|             std::process::id()
   00017|         ));
