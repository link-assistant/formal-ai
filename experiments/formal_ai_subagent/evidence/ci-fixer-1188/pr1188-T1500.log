   00001| //! Issue #763: The VS Code aliases launch with an isolated OpenCode provider, and global setup can be undone.
   00002| 
   00003| #[cfg(unix)]
   00004| mod unix {
   00005|     use std::os::unix::fs::PermissionsExt;
