   00064|     pub(super) fn steps(&self) -> &[String] {
   00065|         &self.steps
   00066|     }
   00067| 
   00068|     /// The mutating command itself, the one step that is not a check.
   00069|     pub(super) fn action(&self) -> &str {
   00070|         self.steps[self.action].as_str()
