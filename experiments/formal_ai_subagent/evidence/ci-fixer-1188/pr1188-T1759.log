   00344| /// Plan the next step of the verified recipe for `command`.
   00345| ///
   00346| /// Returns `None` when the command declares no effect (every read-only intent),
   00347| /// or when the client advertised no shell tool — in which case the caller's
   00348| /// single-shot path still produces the honest "I can run this when you give me a
   00349| /// shell" answer rather than this module inventing a second one.
   00350| pub(super) fn plan_step(
   00351|     command: &str,
   00352|     messages: &[ChatMessage],
   00353|     tool_names: &[&str],
   00354|     prompt: &str,
   00355| ) -> Option<AgenticPlan> {
   00356|     let recipe = expand(command)?;
   00357|     let tool = tool_for(tool_names, Capability::Run)?;
   00358|     let progress = Progress::scan(messages);
   00359|     let taken = progress.run_outputs.len();
   00360| 
   00361|     // The workspace gets the last word before anything else is planned: a step
   00362|     // that exited non-zero ends the recipe where it stopped.
   00363|     if let Some(index) = taken.checked_sub(1) {
   00364|         let observed = &progress.run_outputs[index];
   00365|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00366|             return Some(AgenticPlan::Final(blocked_report(
   00367|                 &recipe,
   00368|                 recipe.steps().get(index).map_or(command, String::as_str),
   00369|                 observed,
   00370|                 prompt,
   00371|                 index >= recipe.action,
   00372|             )));
   00373|         }
   00374|     }
   00375|     if let Some(step) = recipe.steps().get(taken) {
   00376|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00377|     }
   00378|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00379| }
   00380| 
   00381| /// The report for a recipe that stopped: which check stopped it, with what
   00382| /// status, and the fact that the action did not run.
   00383| ///
   00384| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00385| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00386| /// record of what a false completion claim costs; a recipe that names the check
   00387| /// it stopped on avoids both.
   00388| fn blocked_report(
   00389|     recipe: &VerifiedAction,
   00390|     check: &str,
   00391|     observed: &str,
   00392|     prompt: &str,
   00393|     attempted: bool,
   00394| ) -> String {
   00395|     let language = tool_result::response_language(prompt);
   00396|     let intent = if attempted {
   00397|         "mutating-action-observed-failure"
   00398|     } else {
   00399|         "mutating_action_blocked"
   00400|     };
   00401|     let Some(mut answer) = seed::localized_response(intent, language) else {
   00402|         return tool_result::render(check, observed, prompt);
   00403|     };
   00404|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00405|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00406|     answer = answer.replace(
   00407|         EXIT_CODE_PLACEHOLDER,
   00408|         &tool_result::reported_exit_code(observed)
   00409|             .map_or_else(String::new, |code| code.to_string()),
   00410|     );
   00411|     answer
   00412| }
   00413| 
   00414| /// The report for a recipe that finished: the action that ran, and the checks
   00415| /// that were observed to hold afterwards.
   00416| ///
   00417| /// The claim rests on those checks and names them, because a claim the reader
   00418| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00419| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00420|     let language = tool_result::response_language(prompt);
   00421|     let checks = recipe
   00422|         .postconditions()
   00423|         .iter()
   00424|         .map(|check| format!("`{check}`"))
   00425|         .collect::<Vec<_>>()
   00426|         .join(", ");
   00427|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00428|         || recipe.action().to_owned(),
   00429|         |answer| {
   00430|             answer
   00431|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00432|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00433|         },
   00434|     )
   00435| }
   00436| 
   00437| /// The ordered steps `command` is carried out as.
   00438| ///
   00439| /// `None` when no seed intent declares an effect for it — every read-only
   00440| /// intent, and every mutating one whose operands are not the source/destination
   00441| /// pair the effect is written against.
   00442| ///
   00443| /// Read-only intents keep their single-shot path, which is why this is the same
   00444| /// question the planner asks: a caller that wants to know whether a command is
   00445| /// carried out as a recipe asks for the recipe.
   00446| #[must_use]
   00447| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00448|     expand(command).map(|recipe| recipe.steps)
   00449| }
