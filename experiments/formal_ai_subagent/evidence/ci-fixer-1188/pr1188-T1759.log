   00327| /// The directory component of `path`, or `.` when it names no directory.
   00328| ///
   00329| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00330| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00331| /// happily hand back a `~` that the shell then declines to expand once it is no
   00332| /// longer the first character of the word.
   00333| fn parent_of(path: &str) -> String {
   00334|     if path.contains(['"', '\'', '\\']) {
   00335|         return format!("\"$(dirname -- {path})\"");
   00336|     }
   00337|     match path.rsplit_once('/') {
   00338|         Some(("", _)) => String::from("/"),
   00339|         Some((parent, _)) => parent.to_owned(),
   00340|         None => String::from(CURRENT_DIRECTORY),
   00341|     }
   00342| }
