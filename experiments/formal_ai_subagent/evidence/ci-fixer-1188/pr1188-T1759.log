   00204| /// Separate declared options from shell words while preserving operand quoting.
   00205| fn effect_operands<'a>(
   00206|     text: &'a str,
   00207|     effect: &seed::ShellIntentEffect,
   00208| ) -> Option<(Vec<&'a str>, Vec<String>)> {
   00209|     let words = shell_words(text)?;
   00210|     let mut operands = Vec::new();
   00211|     let mut flags = Vec::new();
   00212|     let mut options = true;
   00213|     let mut index = 0;
   00214|     while index < words.len() {
   00215|         let raw = words[index];
   00216|         let word = raw.trim_matches(['\'', '"']);
   00217|         if options && word == "--" {
   00218|             options = false;
   00219|         } else if options && word.starts_with('-') && word != "-" {
   00220|             if let Some(option) = effect.value_options.iter().find(|option| {
   00221|                 word == option.as_str()
   00222|                     || word.strip_prefix(option.as_str()).is_some_and(|suffix| {
   00223|                         suffix.starts_with('=') || (!option.starts_with("--") && !suffix.is_empty())
   00224|                     })
   00225|             }) {
   00226|                 if word == option.as_str() {
   00227|                     index += 1;
   00228|                     if index >= words.len() {
   00229|                         return None;
   00230|                     }
   00231|                 }
   00232|                 flags.push(option.clone());
   00233|             } else if effect.flags.iter().any(|flag| flag == word) {
   00234|                 flags.push(word.to_owned());
   00235|             } else if !word.starts_with("--") {
   00236|                 let bundled: Vec<String> = word[1..]
   00237|                     .chars()
   00238|                     .map(|letter| format!("-{letter}"))
   00239|                     .collect();
   00240|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) {
   00241|                     return None;
   00242|                 }
   00243|                 flags.extend(bundled);
   00244|             } else {
   00245|                 return None;
   00246|             }
   00247|         } else {
   00248|             operands.push(raw);
   00249|         }
   00250|         index += 1;
   00251|     }
   00252|     Some((operands, flags))
   00253| }
