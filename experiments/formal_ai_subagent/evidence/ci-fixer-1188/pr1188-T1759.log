   00300| fn has_shell_expansion(word: &str) -> bool {
   00301|     let mut quote = None;
   00302|     let mut escaped = false;
   00303|     for character in word.chars() {
   00304|         if escaped {
   00305|             escaped = false;
   00306|             continue;
   00307|         }
   00308|         if character == '\\' && quote != Some('\'') {
   00309|             escaped = true;
   00310|             continue;
   00311|         }
   00312|         if let Some(delimiter) = quote {
   00313|             if character == delimiter {
   00314|                 quote = None;
   00315|             }
   00316|             continue;
   00317|         }
   00318|         if character == '"' || character == '\'' {
   00319|             quote = Some(character);
   00320|         } else if "*?[$".contains(character) {
   00321|             return true;
   00322|         }
   00323|     }
   00324|     false
   00325| }
