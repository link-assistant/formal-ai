   00255| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00256|     let mut words = Vec::new();
   00257|     let mut start = None;
   00258|     let mut quote = None;
   00259|     let mut escaped = false;
   00260|     for (index, character) in text.char_indices() {
   00261|         if start.is_none() && character.is_whitespace() {
   00262|             continue;
   00263|         }
   00264|         if start.is_none() {
   00265|             start = Some(index);
   00266|         }
   00267|         if escaped {
   00268|             escaped = false;
   00269|             continue;
   00270|         }
   00271|         if character == '\\' && quote != Some('\'') {
   00272|             escaped = true;
   00273|             continue;
   00274|         }
   00275|         if let Some(delimiter) = quote {
   00276|             if character == delimiter {
   00277|                 quote = None;
   00278|             }
   00279|             continue;
   00280|         }
   00281|         if character == '"' || character == '\'' {
   00282|             quote = Some(character);
   00283|             continue;
   00284|         }
   00285|         if character.is_whitespace() {
   00286|             words.push(&text[start.take()?..index]);
   00287|         } else if ";|&<>()`".contains(character) {
   00288|             return None;
   00289|         }
   00290|     }
   00291|     if quote.is_some() || escaped {
   00292|         return None;
   00293|     }
   00294|     if let Some(start) = start {
   00295|         words.push(&text[start..]);
   00296|     }
   00297|     Some(words)
   00298| }
