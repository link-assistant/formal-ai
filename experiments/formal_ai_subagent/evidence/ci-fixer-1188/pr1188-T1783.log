   00348| /// Plan the next step of the verified recipe for `command`.
   00349| ///
   00350| /// Returns `None` when the command declares no effect (every read-only intent),
   00351| /// or when the client advertised no shell tool — in which case the caller's
   00352| /// single-shot path still produces the honest "I can run this when you give me a
   00353| /// shell" answer rather than this module inventing a second one.
   00354| pub(super) fn plan_step(
   00355|     command: &str,
   00356|     messages: &[ChatMessage],
   00357|     tool_names: &[&str],
   00358|     prompt: &str,
   00359| ) -> Option<AgenticPlan> {
   00360|     let recipe = expand(command)?;
   00361|     let tool = tool_for(tool_names, Capability::Run)?;
   00362|     let progress = Progress::scan(messages);
   00363|     let taken = progress.run_outputs.len();
   00364| 
   00365|     // The workspace gets the last word before anything else is planned: a step
   00366|     // that exited non-zero ends the recipe where it stopped.
   00367|     if let Some(index) = taken.checked_sub(1) {
   00368|         let observed = &progress.run_outputs[index];
   00369|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00370|             return Some(AgenticPlan::Final(blocked_report(
   00371|                 &recipe,
   00372|                 recipe.steps().get(index).map_or(command, String::as_str),
   00373|                 observed,
   00374|                 prompt,
   00375|                 index >= recipe.action,
   00376|             )));
   00377|         }
   00378|     }
   00379|     if let Some(step) = recipe.steps().get(taken) {
   00380|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00381|     }
   00382|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00383| }
   00384| 
   00385| /// The report for a recipe that stopped: which check stopped it, with what
   00386| /// status, and the fact that the action did not run.
   00387| ///
   00388| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00389| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00390| /// record of what a false completion claim costs; a recipe that names the check
   00391| /// it stopped on avoids both.
   00392| fn blocked_report(
   00393|     recipe: &VerifiedAction,
   00394|     check: &str,
   00395|     observed: &str,
   00396|     prompt: &str,
   00397|     attempted: bool,
   00398| ) -> String {
   00399|     let language = tool_result::response_language(prompt);
   00400|     let intent = if attempted {
   00401|         "mutating-action-observed-failure"
   00402|     } else {
   00403|         "mutating_action_blocked"
   00404|     };
   00405|     let Some(mut answer) = seed::localized_response(intent, language) else {
   00406|         return tool_result::render(check, observed, prompt);
   00407|     };
   00408|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00409|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00410|     answer = answer.replace(
   00411|         EXIT_CODE_PLACEHOLDER,
   00412|         &tool_result::reported_exit_code(observed)
   00413|             .map_or_else(String::new, |code| code.to_string()),
   00414|     );
   00415|     answer
   00416| }
   00417| 
   00418| /// The report for a recipe that finished: the action that ran, and the checks
   00419| /// that were observed to hold afterwards.
   00420| ///
   00421| /// The claim rests on those checks and names them, because a claim the reader
   00422| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00423| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00424|     let language = tool_result::response_language(prompt);
   00425|     let checks = recipe
   00426|         .postconditions()
   00427|         .iter()
   00428|         .map(|check| format!("`{check}`"))
   00429|         .collect::<Vec<_>>()
   00430|         .join(", ");
   00431|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00432|         || recipe.action().to_owned(),
   00433|         |answer| {
   00434|             answer
   00435|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00436|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00437|         },
   00438|     )
   00439| }
   00440| 
   00441| /// The ordered steps `command` is carried out as.
   00442| ///
   00443| /// `None` when no seed intent declares an effect for it — every read-only
   00444| /// intent, and every mutating one whose operands are not the source/destination
   00445| /// pair the effect is written against.
   00446| ///
   00447| /// Read-only intents keep their single-shot path, which is why this is the same
   00448| /// question the planner asks: a caller that wants to know whether a command is
   00449| /// carried out as a recipe asks for the recipe.
   00450| #[must_use]
   00451| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00452|     expand(command).map(|recipe| recipe.steps)
   00453| }
