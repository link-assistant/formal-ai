   00185| fn collection_check(sources: &str, destination: &str, check: &str) -> String {
   00186|     let setup = super::work_item_steps::fill(
   00187|         "filesystem-collection-setup",
   00188|         &[("{destination}", destination)],
   00189|     );
   00190|     super::work_item_steps::fill(
   00191|         "filesystem-collection-check",
   00192|         &[
   00193|             ("{sources}", sources),
   00194|             ("{setup}", &setup),
   00195|             ("{check}", check),
   00196|         ],
   00197|     )
   00198| }
