   00208| /// Separate declared options from shell words while preserving operand quoting.
   00209| fn effect_operands<'a>(
   00210|     text: &'a str,
   00211|     effect: &seed::ShellIntentEffect,
   00212| ) -> Option<(Vec<&'a str>, Vec<String>)> {
   00213|     let words = shell_words(text)?;
   00214|     let mut operands = Vec::new();
   00215|     let mut flags = Vec::new();
   00216|     let mut options = true;
   00217|     let mut index = 0;
   00218|     while index < words.len() {
   00219|         let raw = words[index];
   00220|         let word = raw.trim_matches(['\'', '"']);
   00221|         if options && word == "--" {
   00222|             options = false;
   00223|         } else if options && word.starts_with('-') && word != "-" {
   00224|             if let Some(option) = effect.value_options.iter().find(|option| {
   00225|                 word == option.as_str()
   00226|                     || word.strip_prefix(option.as_str()).is_some_and(|suffix| {
   00227|                         suffix.starts_with('=') || (!option.starts_with("--") && !suffix.is_empty())
   00228|                     })
   00229|             }) {
   00230|                 if word == option.as_str() {
   00231|                     index += 1;
   00232|                     if index >= words.len() {
   00233|                         return None;
   00234|                     }
   00235|                 }
   00236|                 flags.push(option.clone());
   00237|             } else if effect.flags.iter().any(|flag| flag == word) {
   00238|                 flags.push(word.to_owned());
   00239|             } else if !word.starts_with("--") {
   00240|                 let bundled: Vec<String> = word[1..]
   00241|                     .chars()
   00242|                     .map(|letter| format!("-{letter}"))
   00243|                     .collect();
   00244|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) {
   00245|                     return None;
   00246|                 }
   00247|                 flags.extend(bundled);
   00248|             } else {
   00249|                 return None;
   00250|             }
   00251|         } else {
   00252|             operands.push(raw);
   00253|         }
   00254|         index += 1;
   00255|     }
   00256|     Some((operands, flags))
   00257| }
