   00331| /// The directory component of `path`, or `.` when it names no directory.
   00332| ///
   00333| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00334| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00335| /// happily hand back a `~` that the shell then declines to expand once it is no
   00336| /// longer the first character of the word.
   00337| fn parent_of(path: &str) -> String {
   00338|     if path.contains(['"', '\'', '\\']) {
   00339|         return format!("\"$(dirname -- {path})\"");
   00340|     }
   00341|     match path.rsplit_once('/') {
   00342|         Some(("", _)) => String::from("/"),
   00343|         Some((parent, _)) => parent.to_owned(),
   00344|         None => String::from(CURRENT_DIRECTORY),
   00345|     }
   00346| }
