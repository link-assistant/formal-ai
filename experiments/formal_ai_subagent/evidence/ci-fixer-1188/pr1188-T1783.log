   00091| fn expand_with(command: &str, vocab: &ShellIntentVocabulary) -> Option<VerifiedAction> {
   00092|     let intent = vocab
   00093|         .intents
   00094|         .iter()
   00095|         .filter(|intent| intent.effect.is_declared())
   00096|         .filter(|intent| {
   00097|             command
   00098|                 .strip_prefix(intent.command.as_str())
   00099|                 .is_some_and(|rest| rest.starts_with(' '))
   00100|         })
   00101|         .max_by_key(|intent| intent.command.len())?;
   00102|     let effect = &intent.effect;
   00103|     let (operands, flags) = effect_operands(&command[intent.command.len()..], effect)?;
   00104|     if operands.is_empty() {
   00105|         return None;
   00106|     }
   00107|     let before = if flags.iter().any(|flag| effect.reuse_options.contains(flag))
   00108|         && !effect.before_reuse.is_empty()
   00109|     {
   00110|         &effect.before_reuse
   00111|     } else {
   00112|         &effect.before
   00113|     };
   00114|     let has_path = before
   00115|         .iter()
   00116|         .chain(&effect.prepare)
   00117|         .chain(&effect.after)
   00118|         .any(|template| template.contains(PATH_PLACEHOLDER));
   00119|     let mut groups: Vec<Vec<(&str, String)>> = Vec::new();
   00120|     let mut collection = None;
   00121|     if has_path {
   00122|         groups.extend(
   00123|             operands
   00124|                 .iter()
   00125|                 .map(|path| vec![(PATH_PLACEHOLDER, (*path).to_owned())]),
   00126|         );
   00127|     } else {
   00128|         if operands.len() < 2 || (operands.len() > 2 && !effect.directory_targets) {
   00129|             return None;
   00130|         }
   00131|         let destination = *operands.last()?;
   00132|         let sources = &operands[..operands.len() - 1];
   00133|         if !effect.directory_targets && sources.iter().any(|source| has_shell_expansion(source)) {
   00134|             return None;
   00135|         }
   00136|         if effect.directory_targets
   00137|             && (sources.len() > 1
   00138|                 || sources.iter().any(|source| has_shell_expansion(source))
   00139|                 || destination.trim_matches(['\'', '"']).ends_with('/'))
   00140|         {
   00141|             collection = Some((sources.join(" "), destination));
   00142|             groups.push(vec![
   00143|                 (SOURCE_PLACEHOLDER, String::from("\"$formal_ai_source\"")),
   00144|                 (
   00145|                     DESTINATION_PARENT_PLACEHOLDER,
   00146|                     String::from("\"$formal_ai_parent\""),
   00147|                 ),
   00148|                 (
   00149|                     DESTINATION_PLACEHOLDER,
   00150|                     String::from("\"$formal_ai_destination\""),
   00151|                 ),
   00152|             ]);
   00153|         } else {
   00154|             groups.push(vec![
   00155|                 (SOURCE_PLACEHOLDER, sources[0].to_owned()),
   00156|                 (DESTINATION_PARENT_PLACEHOLDER, parent_of(destination)),
   00157|                 (DESTINATION_PLACEHOLDER, destination.to_owned()),
   00158|             ]);
   00159|         }
   00160|     }
   00161|     let fill = |template: &String| -> Vec<String> {
   00162|         groups
   00163|             .iter()
   00164|             .map(|bindings| {
   00165|                 let check = bind_template(template, bindings);
   00166|                 if let Some((sources, destination)) = &collection {
   00167|                     collection_check(sources, destination, &check)
   00168|                 } else {
   00169|                     check
   00170|                 }
   00171|             })
   00172|             .collect()
   00173|     };
   00174|     let mut steps: Vec<String> = before
   00175|         .iter()
   00176|         .chain(&effect.prepare)
   00177|         .flat_map(fill)
   00178|         .collect();
   00179|     let action = steps.len();
   00180|     steps.push(command.to_owned());
   00181|     steps.extend(effect.after.iter().flat_map(fill));
   00182|     Some(VerifiedAction { steps, action })
   00183| }
