   00259| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00260|     let mut words = Vec::new();
   00261|     let mut start = None;
   00262|     let mut quote = None;
   00263|     let mut escaped = false;
   00264|     for (index, character) in text.char_indices() {
   00265|         if start.is_none() && character.is_whitespace() {
   00266|             continue;
   00267|         }
   00268|         if start.is_none() {
   00269|             start = Some(index);
   00270|         }
   00271|         if escaped {
   00272|             escaped = false;
   00273|             continue;
   00274|         }
   00275|         if character == '\\' && quote != Some('\'') {
   00276|             escaped = true;
   00277|             continue;
   00278|         }
   00279|         if let Some(delimiter) = quote {
   00280|             if character == delimiter {
   00281|                 quote = None;
   00282|             }
   00283|             continue;
   00284|         }
   00285|         if character == '"' || character == '\'' {
   00286|             quote = Some(character);
   00287|             continue;
   00288|         }
   00289|         if character.is_whitespace() {
   00290|             words.push(&text[start.take()?..index]);
   00291|         } else if ";|&<>()`".contains(character) {
   00292|             return None;
   00293|         }
   00294|     }
   00295|     if quote.is_some() || escaped {
   00296|         return None;
   00297|     }
   00298|     if let Some(start) = start {
   00299|         words.push(&text[start..]);
   00300|     }
   00301|     Some(words)
   00302| }
   00303| 
   00304| fn has_shell_expansion(word: &str) -> bool {
   00305|     let mut quote = None;
   00306|     let mut escaped = false;
   00307|     for character in word.chars() {
   00308|         if escaped {
   00309|             escaped = false;
   00310|             continue;
   00311|         }
   00312|         if character == '\\' && quote != Some('\'') {
   00313|             escaped = true;
   00314|             continue;
   00315|         }
   00316|         if let Some(delimiter) = quote {
   00317|             if character == delimiter {
   00318|                 quote = None;
   00319|             }
   00320|             continue;
   00321|         }
   00322|         if character == '"' || character == '\'' {
   00323|             quote = Some(character);
   00324|         } else if "*?[$".contains(character) {
   00325|             return true;
   00326|         }
   00327|     }
   00328|     false
   00329| }
