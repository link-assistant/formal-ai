   00200| fn bind_template(template: &str, bindings: &[(&str, String)]) -> String {
   00201|     bindings
   00202|         .iter()
   00203|         .fold(template.to_owned(), |text, (key, value)| {
   00204|             text.replace(key, value)
   00205|         })
   00206| }
