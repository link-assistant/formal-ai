   00027| const TOOLS = ['bash', 'edit', 'glob', 'grep', 'list', 'read', 'write'];
   00028| const pathOf = (args) => args.filePath ?? args.file_path ?? args.path;
   00029| 
   00030| function agentRead(text) {
   00031|   const body = text.split('\n').map((line, index) => `${String(index + 1).padStart(5, '0')}| ${line}`).join('\n');
   00032|   return `<file>\n${body}\n\n(End of file - total ${text.split('\n').length} lines)\n</file>`;
   00033| }
   00034| 
   00035| /** The Agent CLI's tools over an in-memory workspace; bash knows `sha256sum --`, `cat`, a word-for-word `perl -pi` and a passing `node --test`. */
   00036| function execute(files, tool, args) {
   00037|   if (tool === 'read') {
   00038|     const path = pathOf(args);
   00039|     return files.has(path) ? agentRead(files.get(path)) : `Error: File not found: ${path}`;
   00040|   }
   00041|   if (tool === 'write') {
   00042|     files.set(pathOf(args), args.content);
   00043|     return '';
   00044|   }
   00045|   if (tool === 'edit') {
   00046|     const path = pathOf(args);
   00047|     const text = files.get(path) ?? '';
   00048|     if (!text.includes(args.oldString)) return 'Error: oldString not found in content';
   00049|     if (text.indexOf(args.oldString) !== text.lastIndexOf(args.oldString)) return 'Error: Found multiple matches for oldString.';
   00050|     files.set(path, text.replace(args.oldString, () => args.newString));
   00051|     return '';
   00052|   }
   00053|   if (tool === 'bash') {
   00054|     const digest = /^sha256sum -- (\S+)$/u.exec(args.command);
   00055|     if (digest) return `${createHash('sha256').update(files.get(digest[1]) ?? '').digest('hex')}  ${digest[1]}\n`;
   00056|     const cat = /^cat (\S+)$/u.exec(args.command);
   00057|     if (cat) return files.get(cat[1]) ?? `cat: ${cat[1]}: No such file or directory`;
   00058|     // The file operations a copy recipe runs (G82).
   00059|     const exists = /^test (!\s)?-e (\S+)$/u.exec(args.command);
   00060|     if (exists) return files.has(exists[2]) === !exists[1] ? '' : 'Output: \nError: \nExit Code: 1';
   00061|     if (args.command === 'mkdir -p -- .') return '';
   00062|     const copy = /^cp (\S+) (\S+)$/u.exec(args.command);
   00063|     if (copy) {
   00064|       files.set(copy[2], files.get(copy[1]) ?? '');
   00065|       return '';
   00066|     }
   00067|     // A replace of every occurrence of a plain word (G84).
   00068|     const perl = /^perl -pi -e 's\/(\w+)\/(\w+)\/g' -- (\S+)$/u.exec(args.command);
   00069|     if (perl) {
   00070|       files.set(perl[3], (files.get(perl[3]) ?? '').split(perl[1]).join(perl[2]));
   00071|       return '';
   00072|     }
   00073|     // A suite slower than the driver's timeout comes back killed (G77).
   00074|     if (args.command === 'node --test slow.test.mjs') return 'Output: TAP version 13\nError: \nSignal: SIGTERM\nTimeout: 60000 ms';
   00075|     if (/^node --test \S+$/u.test(args.command)) return '# tests 1\n# pass 1\n# fail 0\n';
   00076|   }
   00077|   return `Error: ${tool} is not simulated`;
   00078| }
