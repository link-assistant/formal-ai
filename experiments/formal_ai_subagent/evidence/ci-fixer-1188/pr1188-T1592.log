   00080| async function drive(prompt, workspace, maxSteps = 8) {
   00081|   const files = new Map(Object.entries(workspace));
   00082|   const messages = [{ role: 'user', content: prompt }];
   00083|   const commands = [];
   00084|   const calls = [];
   00085|   for (let step = 0; step < maxSteps; step += 1) {
   00086|     const plan = await planChatStep(messages, TOOLS);
   00087|     if (!plan || plan.kind === 'final') return { calls, commands, files, answer: plan ? plan.answer : null };
   00088|     const [call] = plan.calls;
   00089|     const args = JSON.parse(call.arguments);
   00090|     if (call.tool === 'bash') commands.push(args.command);
   00091|     const id = `call_${step}`;
   00092|     calls.push(call.tool);
   00093|     messages.push({ role: 'assistant', content: '', tool_calls: [{ id, type: 'function', function: { name: call.tool, arguments: call.arguments } }] });
   00094|     messages.push({ role: 'tool', tool_call_id: id, content: execute(files, call.tool, args) });
   00095|   }
   00096|   return { calls, commands, files, answer: null };
   00097| }
