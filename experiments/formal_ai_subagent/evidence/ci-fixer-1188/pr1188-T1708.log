        + 'formal_ai_leaf="${formal_ai_source%/}"; formal_ai_destination="${formal_ai_destination%/}/${formal_ai_leaf##*/}"; fi; '
        + 'formal_ai_parent="${formal_ai_destination%/*}"; '
