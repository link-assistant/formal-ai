   00263| #[test]
   00264| fn javascript_installs_apply_a_scoped_lifecycle_policy() {
   00265|     // Issue #1081 moved the agent-CLI end-to-end steps -- which is where every
   00266|     // `bun add -g` in the pipeline lives -- into their own reusable workflow.
   00267|     // The policy is about what CI installs, not about which file spells the
   00268|     // install, so read the spliced surface and keep asking the same question.
   00269|     let workflow = crate::ci_gates::pipeline_workflows();
   00270|     for line in workflow.lines().filter(|line| line.contains("npm ci")) {
   00271|         assert!(
   00272|             line.contains("--no-audit") && line.contains("--no-fund"),
   00273|             "{line}"
   00274|         );
   00275|     }
   00276| 
   00277|     for path in [
   00278|         ".github/workflows/release.yml",
   00279|         ".github/workflows/agent-cli-e2e.yml",
   00280|         ".github/workflows/proactive-failure-report-e2e.yml",
   00281|         "experiments/agentic_cli_matrix/install_client.sh",
   00282|     ] {
   00283|         let source = repository_file(path);
   00284|         for line in source.lines().filter(|line| {
   00285|             let command = line.trim_start();
   00286|             command.starts_with("bun add -g") || command.starts_with("run: bun add -g")
   00287|         }) {
   00288|             assert!(
   00289|                 line.contains("--ignore-scripts") || line.contains("--trust"),
   00290|                 "{path}: {line}"
   00291|             );
   00292|             if line.contains("--trust") {
   00293|                 assert!(
   00294|                     (path == ".github/workflows/agent-cli-e2e.yml"
   00295|                         && line.contains("opencode-ai@1.18.25"))
   00296|                         || (path == "experiments/agentic_cli_matrix/install_client.sh"
   00297|                             && line.contains("\"$spec\"")),
   00298|                     "{path}: {line}"
   00299|                 );
   00300|             }
   00301|         }
   00302|     }
   00303| 
   00304|     assert!(workflow.contains("bun add -g --trust opencode-ai@1.18.25"));
   00305|     let installer = repository_file("experiments/agentic_cli_matrix/install_client.sh");
   00306|     assert!(installer.contains("[ \"$CLIENT\" = opencode ]"));
   00307|     assert!(installer.contains("bun add -g --trust \"$spec\""));
   00308|     assert!(
   00309|         repository_file("experiments/agentic_cli_matrix/clients.lock")
   00310|             .contains("opencode-ai@1.18.25")
   00311|     );
   00312| }
