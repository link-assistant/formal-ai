   00008| fn repository_path(path: &str) -> PathBuf {
   00009|     Path::new(env!("CARGO_MANIFEST_DIR"))
   00010|         .parent()
   00011|         .expect("the repository root sits one level above the crate")
   00012|         .join(path)
   00013| }
   00014| 
   00015| fn repository_file(path: &str) -> String {
   00016|     fs::read_to_string(repository_path(path))
   00017|         .unwrap_or_else(|error| panic!("read {path}: {error}"))
   00018|         .replace("\r\n", "\n")
   00019| }
   00020| 
   00021| fn files_below(root: &Path, files: &mut Vec<PathBuf>) {
   00022|     for entry in
   00023|         fs::read_dir(root).unwrap_or_else(|error| panic!("read {}: {error}", root.display()))
   00024|     {
   00025|         let path = entry.expect("directory entry").path();
   00026|         if path.is_dir() {
   00027|             files_below(&path, files);
   00028|         } else {
   00029|             files.push(path);
   00030|         }
   00031|     }
   00032| }
   00033| 
   00034| fn direct_files_with(root: &Path, prefix: &str, suffix: &str) -> Vec<PathBuf> {
   00035|     fs::read_dir(root)
   00036|         .unwrap_or_else(|error| panic!("read {}: {error}", root.display()))
   00037|         .map(|entry| entry.expect("directory entry").path())
   00038|         .filter(|path| {
   00039|             path.file_name()
   00040|                 .and_then(|name| name.to_str())
   00041|                 .is_some_and(|name| name.starts_with(prefix) && name.ends_with(suffix))
   00042|         })
   00043|         .collect()
   00044| }
