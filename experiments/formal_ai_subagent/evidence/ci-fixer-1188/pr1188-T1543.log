   00071| /// Issue #1085 (D3.5). The self-development floor still exists and still fails
   00072| /// an ineligible cycle from the first push with no deferral machinery -- but it
   00073| /// reports from `.github/workflows/self-development-status.yml`, red until
   00074| /// true, and no longer decides whether a release is cut. The floor #924 put on
   00075| /// the release path had become satisfiable by a documentation commit carrying
   00076| /// trailers, and it held a downstream-critical fix back for 268 commits
   00077| /// (issue #1064). Neither release job may grow the gate back, and neither may
   00078| /// grow a bypass: the floor is honest exactly because nothing needs to escape it.
   00079| #[test]
   00080| fn an_ineligible_cycle_is_reported_red_without_gating_the_release() {
   00081|     let workflow = release_workflow();
   00082|     let automatic = job_block(&workflow, "auto-release");
   00083|     let manual = job_block(&workflow, "manual-release");
   00084|     let policy = repository_file("scripts/self-development-loop.rs");
   00085|     let preflight = repository_file("scripts/check-self-development-release.rs");
   00086|     let status = repository_file(".github/workflows/self-development-status.yml");
   00087| 
   00088|     assert!(policy.contains("SelfDevelopmentReleaseStatus"));
   00089|     assert!(policy.contains("Blocked"));
   00090|     assert!(preflight.contains("set_output(\"should_release\", \"false\")"));
   00091|     // Issue #1066: work is not deferred in this repository, however hard it is.
   00092|     // An ineligible cycle fails the status check from the first push, so there
   00093|     // is no state in which the status reports success while nothing was done.
   00094|     assert!(
   00095|         preflight.contains("SelfDevelopmentReleaseStatus::Blocked"),
   00096|         "the preflight must classify an ineligible cycle as blocked"
   00097|     );
   00098|     assert!(
   00099|         preflight.contains("return Err(reason)"),
   00100|         "a blocked cycle must fail the check rather than report success"
   00101|     );
   00102|     for forbidden in [
   00103|         "Deferred",
   00104|         "Overdue",
   00105|         "DEFERRAL_BUDGET_DAYS",
   00106|         "DEFERRAL_BUDGET_FRAGMENTS",
   00107|     ] {
   00108|         assert!(
   00109|             !policy.contains(forbidden)
   00110|                 && !preflight.contains(forbidden)
   00111|                 && !status.contains(forbidden),
   00112|             "the self-development path must carry no deferral machinery, found `{forbidden}`"
   00113|         );
   00114|     }
   00115|     assert!(
   00116|         !preflight.contains("::notice title=Release deferred::"),
   00117|         "an ineligible cycle must not be downgraded to a notice"
   00118|     );
   00119|     assert!(
   00120|         status.contains("scripts/check-self-development-release.rs"),
   00121|         "the floor is checked by the status workflow"
   00122|     );
   00123|     assert!(
   00124|         status.contains("branches: [main]") && status.contains("schedule:"),
   00125|         "the status runs on every push to main and on a schedule, so red stays visible"
   00126|     );
   00127|     for (job_name, job) in [("auto-release", automatic), ("manual-release", manual)] {
   00128|         assert!(
   00129|             !job.contains("check-self-development-release.rs") && !job.contains("release_gate"),
   00130|             "{job_name} must not gate the release on the self-development floor"
   00131|         );
   00132|     }
   00133|     assert!(manual.contains("scripts/version-and-commit.rs"));
   00134|     let version_script = repository_file("scripts/version-and-commit.rs");
   00135|     assert!(
   00136|         !version_script.contains("ensure_self_development_release("),
   00137|         "the manual path must not gate either; the record is kept, the gate is not"
   00138|     );
   00139|     assert!(version_script.contains("record_release_with_policy"));
   00140| }
