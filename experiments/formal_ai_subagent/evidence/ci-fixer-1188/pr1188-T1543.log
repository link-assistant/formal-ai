   00161|     assert!(macos.contains("actions/upload-artifact@v7"));
   00162|     // Issue #1039 moved the download to `scripts/download-artifact-with-retry.sh`
   00163|     // so a transient storage failure retries instead of reddening a slice that
   00164|     // never ran a test. What this test pins is that the slices *reuse the one
   00165|     // archive* rather than each building their own -- the mechanism that
   00166|     // fetches it is free to change, and the retry is covered by issue #1039.
   00167|     assert!(macos.contains("scripts/download-artifact-with-retry.sh"));
   00168|     assert!(macos.contains("cargo nextest --manifest-path rust/Cargo.toml run --archive-file"));
   00169|     assert!(macos.contains("--extract-to \"$GITHUB_WORKSPACE\""));
   00170|     assert!(macos.contains("--archive-file"));
   00171|     assert!(macos.contains("git rev-parse 'HEAD^{tree}'"));
   00172|     assert!(macos.contains("macos-core-tests/tree"));
   00173|     assert!(repository_path("experiments/issue_1014_nextest_archive/run.sh").is_file());
