   00309| /// The directory component of `path`, or `.` when it names no directory.
   00310| ///
   00311| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00312| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00313| /// happily hand back a `~` that the shell then declines to expand once it is no
   00314| /// longer the first character of the word.
   00315| fn parent_of(path: &str) -> String {
   00316|     if path.contains(['"', '\'', '\\']) {
   00317|         return format!("\"$(dirname -- {path})\"");
   00318|     }
   00319|     match path.rsplit_once('/') {
   00320|         Some(("", _)) => String::from("/"),
   00321|         Some((parent, _)) => parent.to_owned(),
   00322|         None => String::from(CURRENT_DIRECTORY),
   00323|     }
   00324| }
