   00282| fn has_shell_expansion(word: &str) -> bool {
   00283|     let mut quote = None;
   00284|     let mut escaped = false;
   00285|     for character in word.chars() {
   00286|         if escaped {
   00287|             escaped = false;
   00288|             continue;
   00289|         }
   00290|         if character == '\\' && quote != Some('\'') {
   00291|             escaped = true;
   00292|             continue;
   00293|         }
   00294|         if let Some(delimiter) = quote {
   00295|             if character == delimiter {
   00296|                 quote = None;
   00297|             }
   00298|             continue;
   00299|         }
   00300|         if character == '"' || character == '\'' {
   00301|             quote = Some(character);
   00302|         } else if "*?[$".contains(character) {
   00303|             return true;
   00304|         }
   00305|     }
   00306|     false
   00307| }
