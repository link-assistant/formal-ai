   00326| /// Plan the next step of the verified recipe for `command`.
   00327| ///
   00328| /// Returns `None` when the command declares no effect (every read-only intent),
   00329| /// or when the client advertised no shell tool — in which case the caller's
   00330| /// single-shot path still produces the honest "I can run this when you give me a
   00331| /// shell" answer rather than this module inventing a second one.
   00332| pub(super) fn plan_step(
   00333|     command: &str,
   00334|     messages: &[ChatMessage],
   00335|     tool_names: &[&str],
   00336|     prompt: &str,
   00337| ) -> Option<AgenticPlan> {
   00338|     let recipe = expand(command)?;
   00339|     let tool = tool_for(tool_names, Capability::Run)?;
   00340|     let progress = Progress::scan(messages);
   00341|     let taken = progress.run_outputs.len();
   00342| 
   00343|     // The workspace gets the last word before anything else is planned: a step
   00344|     // that exited non-zero ends the recipe where it stopped.
   00345|     if let Some(index) = taken.checked_sub(1) {
   00346|         let observed = &progress.run_outputs[index];
   00347|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00348|             return Some(AgenticPlan::Final(blocked_report(
   00349|                 &recipe,
   00350|                 recipe.steps().get(index).map_or(command, String::as_str),
   00351|                 observed,
   00352|                 prompt,
   00353|                 index >= recipe.action,
   00354|             )));
   00355|         }
   00356|     }
   00357|     if let Some(step) = recipe.steps().get(taken) {
   00358|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00359|     }
   00360|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00361| }
   00362| 
   00363| /// The report for a recipe that stopped: which check stopped it, with what
   00364| /// status, and the fact that the action did not run.
   00365| ///
   00366| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00367| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00368| /// record of what a false completion claim costs; a recipe that names the check
   00369| /// it stopped on avoids both.
   00370| fn blocked_report(
   00371|     recipe: &VerifiedAction,
   00372|     check: &str,
   00373|     observed: &str,
   00374|     prompt: &str,
   00375|     attempted: bool,
   00376| ) -> String {
   00377|     let language = tool_result::response_language(prompt);
   00378|     let intent = if attempted {
   00379|         "mutating_action_observed_failure"
   00380|     } else {
   00381|         "mutating_action_blocked"
   00382|     };
   00383|     let Some(mut answer) = seed::localized_response(intent, language) else {
   00384|         return tool_result::render(check, observed, prompt);
   00385|     };
   00386|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00387|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00388|     answer = answer.replace(
   00389|         EXIT_CODE_PLACEHOLDER,
   00390|         &tool_result::reported_exit_code(observed)
   00391|             .map_or_else(String::new, |code| code.to_string()),
   00392|     );
   00393|     answer
   00394| }
   00395| 
   00396| /// The report for a recipe that finished: the action that ran, and the checks
   00397| /// that were observed to hold afterwards.
   00398| ///
   00399| /// The claim rests on those checks and names them, because a claim the reader
   00400| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00401| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00402|     let language = tool_result::response_language(prompt);
   00403|     let checks = recipe
   00404|         .postconditions()
   00405|         .iter()
   00406|         .map(|check| format!("`{check}`"))
   00407|         .collect::<Vec<_>>()
   00408|         .join(", ");
   00409|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00410|         || recipe.action().to_owned(),
   00411|         |answer| {
   00412|             answer
   00413|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00414|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00415|         },
   00416|     )
   00417| }
   00418| 
   00419| /// The ordered steps `command` is carried out as.
   00420| ///
   00421| /// `None` when no seed intent declares an effect for it — every read-only
   00422| /// intent, and every mutating one whose operands are not the source/destination
   00423| /// pair the effect is written against.
   00424| ///
   00425| /// Read-only intents keep their single-shot path, which is why this is the same
   00426| /// question the planner asks: a caller that wants to know whether a command is
   00427| /// carried out as a recipe asks for the recipe.
   00428| #[must_use]
   00429| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00430|     expand(command).map(|recipe| recipe.steps)
   00431| }
