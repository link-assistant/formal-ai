   00237| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00238|     let mut words = Vec::new();
   00239|     let mut start = None;
   00240|     let mut quote = None;
   00241|     let mut escaped = false;
   00242|     for (index, character) in text.char_indices() {
   00243|         if start.is_none() && character.is_whitespace() {
   00244|             continue;
   00245|         }
   00246|         if start.is_none() {
   00247|             start = Some(index);
   00248|         }
   00249|         if escaped {
   00250|             escaped = false;
   00251|             continue;
   00252|         }
   00253|         if character == '\\' && quote != Some('\'') {
   00254|             escaped = true;
   00255|             continue;
   00256|         }
   00257|         if let Some(delimiter) = quote {
   00258|             if character == delimiter {
   00259|                 quote = None;
   00260|             }
   00261|             continue;
   00262|         }
   00263|         if character == '"' || character == '\'' {
   00264|             quote = Some(character);
   00265|             continue;
   00266|         }
   00267|         if character.is_whitespace() {
   00268|             words.push(&text[start.take()?..index]);
   00269|         } else if ";|&<>()`".contains(character) {
   00270|             return None;
   00271|         }
   00272|     }
   00273|     if quote.is_some() || escaped {
   00274|         return None;
   00275|     }
   00276|     if let Some(start) = start {
   00277|         words.push(&text[start..]);
   00278|     }
   00279|     Some(words)
   00280| }
