   00186| /// Separate declared options from shell words while preserving operand quoting.
   00187| fn effect_operands<'a>(
   00188|     text: &'a str,
   00189|     effect: &seed::ShellIntentEffect,
   00190| ) -> Option<(Vec<&'a str>, Vec<String>)> {
   00191|     let words = shell_words(text)?;
   00192|     let mut operands = Vec::new();
   00193|     let mut flags = Vec::new();
   00194|     let mut options = true;
   00195|     let mut index = 0;
   00196|     while index < words.len() {
   00197|         let raw = words[index];
   00198|         let word = raw.trim_matches(['\'', '"']);
   00199|         if options && word == "--" {
   00200|             options = false;
   00201|         } else if options && word.starts_with('-') && word != "-" {
   00202|             if let Some(option) = effect.value_options.iter().find(|option| {
   00203|                 word == option.as_str()
   00204|                     || word.strip_prefix(option.as_str()).is_some_and(|suffix| {
   00205|                         suffix.starts_with('=') || (!option.starts_with("--") && !suffix.is_empty())
   00206|                     })
   00207|             }) {
   00208|                 if word == option.as_str() {
   00209|                     index += 1;
   00210|                     if index >= words.len() {
   00211|                         return None;
   00212|                     }
   00213|                 }
   00214|                 flags.push(option.clone());
   00215|             } else if effect.flags.iter().any(|flag| flag == word) {
   00216|                 flags.push(word.to_owned());
   00217|             } else if !word.starts_with("--") {
   00218|                 let bundled: Vec<String> = word[1..]
   00219|                     .chars()
   00220|                     .map(|letter| format!("-{letter}"))
   00221|                     .collect();
   00222|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) {
   00223|                     return None;
   00224|                 }
   00225|                 flags.extend(bundled);
   00226|             } else {
   00227|                 return None;
   00228|             }
   00229|         } else {
   00230|             operands.push(raw);
   00231|         }
   00232|         index += 1;
   00233|     }
   00234|     Some((operands, flags))
   00235| }
