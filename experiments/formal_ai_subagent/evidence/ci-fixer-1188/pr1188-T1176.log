   00034| /** Run `prompt` over one file `name` holding `source`; the tools act as the Agent CLI's do. */
   00035| async function drive(prompt, source, name = 'f.txt') {
   00036|   let file = source;
   00037|   const messages = [{ role: 'user', content: prompt }];
   00038|   const calls = [];
   00039|   for (let step = 0; step < 6; step += 1) {
   00040|     const plan = await planChatStep(messages, ['read', 'edit', 'bash', 'write']);
   00041|     if (!plan || plan.kind === 'final') return { calls, file, answer: plan ? plan.answer : null };
   00042|     const [call] = plan.calls;
   00043|     const args = JSON.parse(call.arguments);
   00044|     let result = '';
   00045|     if (call.tool === 'read') result = file;
   00046|     if (call.tool === 'edit') file = file.replace(args.oldString, () => args.newString);
   00047|     if (call.tool === 'write') file = args.content;
   00048|     if (call.tool === 'bash') result = `${createHash('sha256').update(file).digest('hex')}  ${name}\n`;
   00049|     calls.push(call.tool);
   00050|     const id = `call_${step}`;
   00051|     messages.push({ role: 'assistant', content: '', tool_calls: [{ id, type: 'function', function: { name: call.tool, arguments: call.arguments } }] });
   00052|     messages.push({ role: 'tool', tool_call_id: id, content: result });
   00053|   }
   00054|   return { calls, file, answer: null };
   00055| }
