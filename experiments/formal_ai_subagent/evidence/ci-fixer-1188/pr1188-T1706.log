   00192| /// Parse `data/seed/shell-intents.lino` into the semantic shell-intent vocabulary.
   00193| #[must_use]
   00194| pub fn shell_intent_vocabulary() -> ShellIntentVocabulary {
   00195|     let tree = parse_lino(SHELL_INTENTS_LINO);
   00196|     let mut vocab = ShellIntentVocabulary::default();
   00197|     let Some(root) = tree.children.first() else {
   00198|         return vocab;
   00199|     };
   00200|     for group in &root.children {
   00201|         match group.name.as_str() {
   00202|             "name_leads" => vocab.name_leads = collect_language_values(group, "lead"),
   00203|             "argument_noise" => {
   00204|                 vocab.argument_noise = collect_language_values(group, "word");
   00205|             }
   00206|             "cue_fillers" => {
   00207|                 vocab.cue_fillers = collect_language_values(group, "word")
   00208|                     .into_iter()
   00209|                     .map(|word| word.to_lowercase())
   00210|                     .collect();
   00211|             }
   00212|             "local_search_scopes" => {
   00213|                 vocab.local_search_scopes = collect_language_values(group, "scope");
   00214|             }
   00215|             "local_path_search" => {
   00216|                 group
   00217|                     .find_child_value("command_template")
   00218|                     .clone_into(&mut vocab.local_path_search_command_template);
   00219|                 vocab.local_path_search_actions = group
   00220|                     .children
   00221|                     .iter()
   00222|                     .find(|child| child.name == "actions")
   00223|                     .map(|node| collect_language_values(node, "action"))
   00224|                     .unwrap_or_default();
   00225|                 vocab.local_path_search_scopes = group
   00226|                     .children
   00227|                     .iter()
   00228|                     .find(|child| child.name == "scopes")
   00229|                     .map(|node| {
   00230|                         node.children
   00231|                             .iter()
   00232|                             .filter(|child| child.name == "scope")
   00233|                             .map(|scope| LocalPathSearchScope {
   00234|                                 name: scope.id.clone(),
   00235|                                 root: scope.find_child_value("root").to_owned(),
   00236|                                 cues: collect_language_values(scope, "cue")
   00237|                                     .into_iter()
   00238|                                     .map(|cue| cue.to_lowercase())
   00239|                                     .collect(),
   00240|                             })
   00241|                             .collect()
   00242|                     })
   00243|                     .unwrap_or_default();
   00244|                 vocab.local_path_search_kinds = group
   00245|                     .children
   00246|                     .iter()
   00247|                     .find(|child| child.name == "kinds")
   00248|                     .map(|node| {
   00249|                         node.children
   00250|                             .iter()
   00251|                             .filter(|child| child.name == "kind")
   00252|                             .map(|kind| LocalPathSearchKind {
   00253|                                 predicate: kind.find_child_value("predicate").to_owned(),
   00254|                                 cues: collect_language_values(kind, "cue")
   00255|                                     .into_iter()
   00256|                                     .map(|cue| cue.to_lowercase())
   00257|                                     .collect(),
   00258|                             })
   00259|                             .collect()
   00260|                     })
   00261|                     .unwrap_or_default();
   00262|             }
   00263|             "workspace_commands" => {
   00264|                 vocab.workspace_commands = group
   00265|                     .children
   00266|                     .iter()
   00267|                     .filter(|child| child.name == "workspace")
   00268|                     .map(|node| WorkspaceCommands {
   00269|                         marker: node.find_child_value("marker").to_owned(),
   00270|                         test: node.find_child_value("test").to_owned(),
   00271|                         install: node.find_child_value("install").to_owned(),
   00272|                         build: node.find_child_value("build").to_owned(),
   00273|                     })
   00274|                     .collect();
   00275|             }
   00276|             "path_objects" => {
   00277|                 vocab.path_objects = collect_language_values(group, "object")
   00278|                     .into_iter()
   00279|                     .map(|object| object.to_lowercase())
   00280|                     .collect();
   00281|             }
   00282|             "directory_listing" => {
   00283|                 let part = |name: &str, child: &str| {
   00284|                     group
   00285|                         .children
   00286|                         .iter()
   00287|                         .find(|node| node.name == name)
   00288|                         .map(|node| {
   00289|                             collect_language_values(node, child)
   00290|                                 .into_iter()
   00291|                                 .map(|value| value.to_lowercase())
   00292|                                 .collect()
   00293|                         })
   00294|                         .unwrap_or_default()
   00295|                 };
   00296|                 vocab.directory_listing = DirectoryListingVocabulary {
   00297|                     verbs: part("verbs", "verb"),
   00298|                     questions: part("questions", "question"),
   00299|                     objects: part("objects", "object"),
   00300|                     scopes: part("scopes", "scope"),
   00301|                 };
   00302|             }
   00303|             "intents" => {
   00304|                 vocab.intents = group
   00305|                     .children
   00306|                     .iter()
   00307|                     .filter(|c| c.name == "intent")
   00308|                     .map(parse_intent)
   00309|                     .collect();
   00310|             }
   00311|             _ => {}
   00312|         }
   00313|     }
   00314|     vocab
   00315| }
