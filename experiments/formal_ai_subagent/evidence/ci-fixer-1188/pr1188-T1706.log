   00317| /// Parse a single `intent` node into a [`ShellIntent`].
   00318| fn parse_intent(node: &LinoNode) -> ShellIntent {
   00319|     ShellIntent {
   00320|         command: node.find_child_value("command").to_owned(),
   00321|         argument: match node.find_child_value("argument") {
   00322|             "path" => ShellIntentArgument::Path,
   00323|             "name_lead" => ShellIntentArgument::NameLead,
   00324|             "one_path" => ShellIntentArgument::OnePath,
   00325|             "two_paths" => ShellIntentArgument::TwoPaths,
   00326|             "remainder" => ShellIntentArgument::Remainder,
   00327|             "search_query" => ShellIntentArgument::SearchQuery,
   00328|             _ => ShellIntentArgument::None,
   00329|         },
   00330|         cues: collect_language_values(node, "cue")
   00331|             .into_iter()
   00332|             .map(|cue| cue.to_lowercase())
   00333|             .collect(),
   00334|         effect: node
   00335|             .children
   00336|             .iter()
   00337|             .find(|child| child.name == "effect")
   00338|             .map(parse_intent_effect)
   00339|             .unwrap_or_default(),
   00340|         destructive: node.find_child_value("destructive") == "true",
   00341|     }
   00342| }
   00343| 
   00344| /// Read the ordered `before` / `prepare` / `after` templates of one `effect` block.
   00345| fn parse_intent_effect(node: &LinoNode) -> ShellIntentEffect {
   00346|     let templates = |name: &str| -> Vec<String> {
   00347|         node.children
   00348|             .iter()
   00349|             .filter(|child| child.name == name)
   00350|             .map(|child| child.id.clone())
   00351|             .collect()
   00352|     };
   00353|     ShellIntentEffect {
   00354|         before: templates("before"),
   00355|         prepare: templates("prepare"),
   00356|         after: templates("after"),
   00357|     }
   00358| }
   00359| 
   00360| /// Collect every `<child_name>` id nested under the `language` children of `group`,
   00361| /// pooled across all languages (intent detection is language-agnostic).
   00362| fn collect_language_values(group: &LinoNode, child_name: &str) -> Vec<String> {
   00363|     group
   00364|         .children
   00365|         .iter()
   00366|         .filter(|c| c.name == "language")
   00367|         .flat_map(|lang| {
   00368|             lang.children
   00369|                 .iter()
   00370|                 .filter(|c| c.name == child_name)
   00371|                 .map(|c| c.id.clone())
   00372|         })
   00373|         .collect()
   00374| }
