   00084| /// One intent → command mapping: the command to emit, how to fill its argument, and
   00085| /// the multilingual cue phrases (lowercased) that signal the intent.
   00086| #[derive(Debug, Clone, Default)]
   00087| pub struct ShellIntent {
   00088|     /// The concrete command to emit, e.g. `pwd`, `df -h`, `wc -l`.
   00089|     pub command: String,
   00090|     /// How the command's argument (if any) is recovered from the prompt.
   00091|     pub argument: ShellIntentArgument,
   00092|     /// Cue phrases, pooled across languages and lowercased for substring matching.
   00093|     pub cues: Vec<String>,
   00094|     /// The pre/post conditions this intent's command must satisfy, empty for the
   00095|     /// read-only intents that only report what they observe.
   00096|     pub effect: ShellIntentEffect,
   00097|     /// `destructive true`: the command destroys its operand (`rm`, `rmdir`), so
   00098|     /// it is never composed for a request about text inside a file.
   00099|     pub destructive: bool,
   00100| }
