Replaced ``fn render_template(mut template: String, substitutions: &[(&str, &str)]) -> String {
    for (placeholder, value) in substitutions {
        template = template
            .replace(&format!("`{placeholder}`"), &code_span(value))
            .replace(placeholder, value);
    }
    template
}`` with ``fn render_template(template: String, substitutions: &[(&str, &str)]) -> String {
    let values: Vec<(&str, String, String)> = substitutions.iter()
        .map(|(slot, value)| (*slot, (*value).to_owned(), code_span(value))).collect();
    render_template_values(&template, &values)
}

/// Substitute only seed-owned slots; inserted literal values are never templates.
fn render_template_values(mut template: &str, values: &[(&str, String, String)]) -> String {
    let mut rendered = String::new();
    while !template.is_empty() {
        let found = values.iter().find_map(|(slot, plain, quoted)| {
            let fenced = format!("`{slot}`");
            if template.starts_with(&fenced) { return Some((fenced.len(), quoted.as_str())); }
            template.starts_with(slot).then_some((slot.len(), plain.as_str()))
        });
        if let Some((length, value)) = found {
            rendered.push_str(value);
            template = &template[length..];
        } else {
            let character = template.chars().next().expect("nonempty template");
            rendered.push(character);
            template = &template[character.len_utf8()..];
        }
    }
    rendered
}`` in `rust/src/agentic_coding/code_task.rs` and observed the result.
