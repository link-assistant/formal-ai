   00272| /// A placeholder the seed sentence wraps in backticks becomes a `CommonMark`
   00273| /// code span: a value holding a backtick run gets a longer fence, padded when
   00274| /// it starts or ends with a backtick, so the inserted text reads back verbatim.
   00275| fn code_span_item(value: &str) -> String {
   00276|     let longest = value
   00277|         .split(|character| character != '`')
   00278|         .map(str::len)
   00279|         .max()
   00280|         .unwrap_or(0);
   00281|     if longest == 0 {
   00282|         return format!("`{value}`");
   00283|     }
   00284|     let fence = "`".repeat(longest + 1);
   00285|     let pad = if value.starts_with('`') || value.ends_with('`') {
   00286|         " "
   00287|     } else {
   00288|         ""
   00289|     };
   00290|     format!("{fence}{pad}{value}{pad}{fence}")
   00291| }
   00292| 
   00293| fn code_span(value: &str) -> String {
   00294|     code_span_item(value)
   00295| }
