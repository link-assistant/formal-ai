   00325| fn requested_identifier(task: &str, path: &str, kind: RustItemKind) -> Option<String> {
   00326|     let normalized = task.to_lowercase();
   00327|     if kind != RustItemKind::Constant
   00328|         && let Some(name) = slot_identifier(&normalized, seed::ROLE_CODING_NAME_SLOT)
   00329|         && valid_identifier(&name)
   00330|     {
   00331|         return Some(name);
   00332|     }
   00333|     let without_path = task.replacen(path, "", 1);
   00334|     let mut candidates = identifier_tokens(&without_path)
   00335|         .filter(|candidate| valid_identifier(candidate))
   00336|         .collect::<Vec<_>>();
   00337|     if kind == RustItemKind::Constant {
   00338|         candidates.retain(|candidate| {
   00339|             candidate.chars().any(|character| character == '_')
   00340|                 && candidate
   00341|                     .chars()
   00342|                     .all(|character| character.is_ascii_uppercase() || character == '_')
   00343|         });
   00344|     } else {
   00345|         candidates.retain(|candidate| candidate.contains('_'));
   00346|     }
   00347|     candidates.into_iter().next().map(str::to_owned)
   00348| }
