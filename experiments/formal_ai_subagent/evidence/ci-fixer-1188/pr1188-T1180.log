   00383| fn identifier_tokens(text: &str) -> impl Iterator<Item = &str> {
   00384|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00385|         .filter(|token| !token.is_empty())
   00386| }
   00387| 
   00388| fn valid_identifier(identifier: &str) -> bool {
   00389|     let mut characters = identifier.chars();
   00390|     let Some(first) = characters.next() else {
   00391|         return false;
   00392|     };
   00393|     (first.is_ascii_alphabetic() || first == '_')
   00394|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00395|         && !seed::lexicon()
   00396|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00397|             .iter()
   00398|             .any(|reserved| reserved == identifier)
   00399| }
