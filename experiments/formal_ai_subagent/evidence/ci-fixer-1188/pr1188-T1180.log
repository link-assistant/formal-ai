   00401| fn numeric_literals(text: &str) -> Vec<String> {
   00402|     let chars = text.char_indices().collect::<Vec<_>>();
   00403|     let mut values = Vec::new();
   00404|     let mut index = 0;
   00405|     while index < chars.len() {
   00406|         let (start, character) = chars[index];
   00407|         if !character.is_ascii_digit()
   00408|             || index
   00409|                 .checked_sub(1)
   00410|                 .is_some_and(|prior| chars[prior].1.is_ascii_alphabetic())
   00411|         {
   00412|             index += 1;
   00413|             continue;
   00414|         }
   00415|         let mut end_index = index + 1;
   00416|         while end_index < chars.len()
   00417|             && (chars[end_index].1.is_ascii_digit() || chars[end_index].1 == '.')
   00418|         {
   00419|             end_index += 1;
   00420|         }
   00421|         if end_index < chars.len() && chars[end_index].1.is_ascii_alphabetic() {
   00422|             index = end_index + 1;
   00423|             continue;
   00424|         }
   00425|         let end = chars
   00426|             .get(end_index)
   00427|             .map_or(text.len(), |(offset, _)| *offset);
   00428|         let value = text[start..end].trim_end_matches('.');
   00429|         if !value.is_empty() {
   00430|             values.push(value.to_owned());
   00431|         }
   00432|         index = end_index;
   00433|     }
   00434|     values
   00435| }
