   00350| fn slot_identifier(normalized: &str, role: &str) -> Option<String> {
   00351|     seed::lexicon()
   00352|         .role_word_forms(role)
   00353|         .into_iter()
   00354|         .find_map(|form| match form.slot() {
   00355|             Slot::Prefix => {
   00356|                 let prefix = form.before_slot().trim().to_lowercase();
   00357|                 let start = normalized.find(&prefix)?.checked_add(prefix.len())?;
   00358|                 identifier_tokens(normalized.get(start..)?)
   00359|                     .next()
   00360|                     .map(str::to_owned)
   00361|             }
   00362|             Slot::Suffix => {
   00363|                 let suffix = form.after_slot().trim().to_lowercase();
   00364|                 let end = normalized.find(&suffix)?;
   00365|                 identifier_tokens(normalized.get(..end)?)
   00366|                     .last()
   00367|                     .map(str::to_owned)
   00368|             }
   00369|             Slot::Circumfix => {
   00370|                 let before = form.before_slot().trim().to_lowercase();
   00371|                 let after = form.after_slot().trim().to_lowercase();
   00372|                 let start = normalized.find(&before)?.checked_add(before.len())?;
   00373|                 let remainder = normalized.get(start..)?;
   00374|                 let end = remainder.find(&after)?;
   00375|                 identifier_tokens(remainder.get(..end)?)
   00376|                     .next()
   00377|                     .map(str::to_owned)
   00378|             }
   00379|             Slot::Bare => None,
   00380|         })
   00381| }
