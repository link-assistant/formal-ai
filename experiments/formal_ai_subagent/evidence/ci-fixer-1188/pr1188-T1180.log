   00247| /// Render scalar slots and explicitly typed lists without interpreting scalar text.
   00248| #[allow(clippy::literal_string_with_formatting_args)]
   00249| pub(super) fn render_seeded_change_with_lists(
   00250|     intent: &str,
   00251|     task: &str,
   00252|     path: &str,
   00253|     slots: &[(&str, &str)],
   00254|     lists: &[(&str, &[String])],
   00255| ) -> Option<String> {
   00256|     let language = super::tool_result::response_language(task);
   00257|     let template = seed::localized_response(intent, language)?;
   00258|     let mut substitutions = vec![("{path}", path)];
   00259|     substitutions.extend_from_slice(slots);
   00260|     let mut values: Vec<(&str, String, String)> = substitutions
   00261|         .into_iter()
   00262|         .filter(|(slot, _)| !lists.iter().any(|(listed, _)| listed == slot))
   00263|         .map(|(slot, value)| (slot, value.to_owned(), code_span(value)))
   00264|         .collect();
