   00306| fn rust_path(task: &str) -> Option<String> {
   00307|     let end = task.find(".rs")?.checked_add(3)?;
   00308|     let start = task[..end]
   00309|         .char_indices()
   00310|         .rev()
   00311|         .take_while(|(_, character)| is_path_character(*character))
   00312|         .last()
   00313|         .map_or(0, |(index, _)| index);
   00314|     let path = task.get(start..end)?;
   00315|     (!path.is_empty()
   00316|         && !path.starts_with('/')
   00317|         && !path.split('/').any(|component| component == ".."))
   00318|     .then(|| path.to_owned())
   00319| }
   00320| 
   00321| const fn is_path_character(character: char) -> bool {
   00322|     character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00323| }
