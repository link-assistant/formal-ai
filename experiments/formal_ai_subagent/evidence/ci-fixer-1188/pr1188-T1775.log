   00014| struct AppendWorkspace(std::path::PathBuf);
   00015| 
   00016| impl AppendWorkspace {
   00017|     fn new() -> Self {
   00018|         static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
   00019|         let sequence = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
   00020|         let root = std::env::temp_dir().join(format!(
   00021|             "formal-ai-plan-event-{}-{sequence}",
   00022|             std::process::id()
   00023|         ));
   00024|         std::fs::create_dir(&root).expect("append workspace");
   00025|         Self(root)
   00026|     }
   00027| 
   00028|     fn path(&self) -> &std::path::Path {
   00029|         &self.0
   00030|     }
   00031| }
   00032| 
   00033| impl Drop for AppendWorkspace {
   00034|     fn drop(&mut self) {
   00035|         let _ = std::fs::remove_dir_all(&self.0);
   00036|     }
   00037| }
