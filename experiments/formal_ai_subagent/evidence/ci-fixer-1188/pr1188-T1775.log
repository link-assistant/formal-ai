   00587| /// The answer to `Run <command>` once the command ran with no output.
   00588| fn quiet_run(command: &str) -> Option<String> {
   00589|     let mut messages = vec![ChatMessage::user(format!("Run {command}"))];
   00590|     let Some(AgenticPlan::ToolCalls(calls)) = plan_chat_step(&messages, &TOOLS) else {
   00591|         panic!("{command} is planned");
   00592|     };
   00593|     let arguments: serde_json::Value =
   00594|         serde_json::from_str(&calls[0].arguments).expect("tool arguments are JSON");
   00595|     assert_eq!(arguments["command"], command);
   00596|     messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00597|         "c0",
   00598|         "bash",
   00599|         calls[0].arguments.clone(),
   00600|     )]));
   00601|     messages.push(ChatMessage::tool_result("c0", "bash", ""));
   00602|     match plan_chat_step(&messages, &TOOLS) {
   00603|         Some(AgenticPlan::Final(answer)) => Some(answer),
   00604|         _ => None,
   00605|     }
   00606| }
