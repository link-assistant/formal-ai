   00277| /// The `contraction` / `expansion` pairs `data/seed/languages.lino` seeds.
   00278| fn seeded_contractions() -> Vec<(String, String)> {
   00279|     let languages = formal_ai::seed::seed_files()
   00280|         .into_iter()
   00281|         .find(|(path, _)| *path == "data/seed/languages.lino")
   00282|         .map(|(_, text)| text)
   00283|         .expect("languages.lino is seeded");
   00284|     let mut pairs = Vec::new();
   00285|     let mut contracted = None;
   00286|     for line in languages.lines() {
   00287|         let Some((key, value)) = line.trim().split_once(' ') else {
   00288|             continue;
   00289|         };
   00290|         let value = value.trim_matches('"').to_owned();
   00291|         match key {
   00292|             "contraction" => contracted = Some(value),
   00293|             "expansion" => {
   00294|                 if let Some(pair) = contracted.take() {
   00295|                     pairs.push((pair, value));
   00296|                 }
   00297|             }
   00298|             _ => {}
   00299|         }
   00300|     }
   00301|     pairs
   00302| }
