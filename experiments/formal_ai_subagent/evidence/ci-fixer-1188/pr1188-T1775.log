   00039| /// One driven session: the workspace afterwards, the bash commands and tools
   00040| /// it ran, and its final answer.
   00041| pub struct Run {
   00042|     pub(crate) files: BTreeMap<String, String>,
   00043|     pub(crate) tools: Vec<String>,
   00044|     pub(crate) commands: Vec<String>,
   00045|     pub(crate) answer: Option<String>,
   00046| }
   00047| 
   00048| fn path_of(arguments: &serde_json::Value) -> String {
   00049|     ["filePath", "file_path", "path"]
   00050|         .iter()
   00051|         .find_map(|key| arguments[key].as_str())
   00052|         .unwrap_or_default()
   00053|         .to_owned()
   00054| }
   00055| 
   00056| /// The Agent CLI's tools over an in-memory workspace; bash knows
   00057| /// `sha256sum --`, `cat` and a passing `node --test`.
   00058| fn execute(
   00059|     files: &mut BTreeMap<String, String>,
   00060|     tool: &str,
   00061|     arguments: &serde_json::Value,
   00062| ) -> String {
   00063|     match tool {
   00064|         "read" => files
   00065|             .get(&path_of(arguments))
   00066|             .cloned()
   00067|             .unwrap_or_else(|| format!("Error: File not found: {}", path_of(arguments))),
   00068|         "write" => {
   00069|             let content = arguments["content"].as_str().unwrap_or_default().to_owned();
   00070|             files.insert(path_of(arguments), content);
   00071|             String::new()
   00072|         }
   00073|         "edit" => {
   00074|             let path = path_of(arguments);
   00075|             let text = files.get(&path).cloned().unwrap_or_default();
   00076|             let old = arguments["oldString"].as_str().unwrap_or_default();
   00077|             let new = arguments["newString"].as_str().unwrap_or_default();
   00078|             if text.matches(old).count() != 1 {
   00079|                 return "Error: oldString not found in content".to_owned();
   00080|             }
   00081|             files.insert(path, text.replacen(old, new, 1));
   00082|             String::new()
   00083|         }
   00084|         "bash" => {
   00085|             let command = arguments["command"].as_str().unwrap_or_default();
   00086|             if command.starts_with("mkdir -p -- .formal-ai && (lock=") {
   00087|                 let directory = tempfile::tempdir().expect("append workspace");
   00088|                 std::fs::create_dir(directory.path().join(".formal-ai")).expect("event directory");
   00089|                 let event_path = ".formal-ai/general-change-plan.lino";
   00090|                 if let Some(before) = files.get(event_path) {
   00091|                     std::fs::write(directory.path().join(event_path), before)
   00092|                         .expect("earlier stream");
   00093|                 }
   00094|                 let output = std::process::Command::new("sh")
   00095|                     .args(["-c", command])
   00096|                     .current_dir(directory.path())
   00097|                     .output()
   00098|                     .expect("real shell append");
   00099|                 let stream = std::fs::read_to_string(directory.path().join(event_path))
   00100|                     .expect("appended stream");
   00101|                 files.insert(event_path.to_owned(), stream);
   00102|                 return format!(
   00103|                     "Output: {}\nError: {}\nExit Code: {}",
   00104|                     String::from_utf8_lossy(&output.stdout),
   00105|                     String::from_utf8_lossy(&output.stderr),
   00106|                     output.status.code().unwrap_or(-1)
   00107|                 );
   00108|             }
   00109|             if let Some(path) = command.strip_prefix("sha256sum -- ") {
   00110|                 let text = files.get(path).cloned().unwrap_or_default();
   00111|                 return format!("{}  {path}\n", sha256_hex(text.as_bytes()));
   00112|             }
   00113|             // The file operations a copy recipe runs (G82).
   00114|             if let Some(path) = command.strip_prefix("test -e ") {
   00115|                 return if files.contains_key(path) {
   00116|                     String::new()
   00117|                 } else {
   00118|                     "Output: \nError: \nExit Code: 1".to_owned()
   00119|                 };
   00120|             }
   00121|             if let Some(path) = command.strip_prefix("test ! -e ") {
   00122|                 return if files.contains_key(path) {
   00123|                     "Output: \nError: \nExit Code: 1".to_owned()
   00124|                 } else {
   00125|                     String::new()
   00126|                 };
   00127|             }
   00128|             if command == "mkdir -p -- ." {
   00129|                 return String::new();
   00130|             }
   00131|             if let Some((from, to)) = command
   00132|                 .strip_prefix("cp ")
   00133|                 .and_then(|rest| rest.split_once(' '))
   00134|             {
   00135|                 let text = files.get(from).cloned().unwrap_or_default();
   00136|                 files.insert(to.to_owned(), text);
   00137|                 return String::new();
   00138|             }
   00139|             // A replace of every occurrence of a plain word (G84).
   00140|             if let Some((old, new, path)) = perl_replace(command) {
   00141|                 let text = files.get(path).cloned().unwrap_or_default();
   00142|                 files.insert(path.to_owned(), text.replace(old, new));
   00143|                 return String::new();
   00144|             }
   00145|             // A suite slower than the driver's timeout comes back killed (G77).
   00146|             if command == "node --test slow.test.mjs" {
   00147|                 return "Output: TAP version 13\nError: \nSignal: SIGTERM\nTimeout: 60000 ms"
   00148|                     .to_owned();
   00149|             }
   00150|             if command.starts_with("node --test ") {
   00151|                 return "# tests 1\n# pass 1\n# fail 0\n".to_owned();
   00152|             }
   00153|             command.strip_prefix("cat ").map_or_else(
   00154|                 || format!("Error: {command} is not simulated"),
   00155|                 |path| files.get(path).cloned().unwrap_or_default(),
   00156|             )
   00157|         }
   00158|         _ => format!("Error: {tool} is not simulated"),
   00159|     }
   00160| }
   00161| 
   00162| /// The old word, new word and path of `perl -pi -e 's/OLD/NEW/g' -- PATH`.
   00163| fn perl_replace(command: &str) -> Option<(&str, &str, &str)> {
   00164|     let (expression, path) = command
   00165|         .strip_prefix("perl -pi -e 's/")?
   00166|         .split_once("/g' -- ")?;
   00167|     let (old, new) = expression.split_once('/')?;
   00168|     let word = |text: &str| !text.is_empty() && text.chars().all(char::is_alphanumeric);
   00169|     (word(old) && word(new)).then_some((old, new, path))
   00170| }
