   00172| pub fn drive(prompt: &str, workspace: &[(&str, &str)]) -> Run {
   00173|     let mut run = Run {
   00174|         files: workspace
   00175|             .iter()
   00176|             .map(|(path, text)| ((*path).to_owned(), (*text).to_owned()))
   00177|             .collect(),
   00178|         tools: Vec::new(),
   00179|         commands: Vec::new(),
   00180|         answer: None,
   00181|     };
   00182|     let mut messages = vec![ChatMessage::user(prompt)];
   00183|     for index in 0..16 {
   00184|         let calls = match plan_chat_step(&messages, &TOOLS) {
   00185|             Some(AgenticPlan::ToolCalls(calls)) => calls,
   00186|             Some(AgenticPlan::Final(text)) => {
   00187|                 run.answer = Some(text);
   00188|                 break;
   00189|             }
   00190|             None => break,
   00191|         };
   00192|         let call = calls[0].clone();
   00193|         let arguments: serde_json::Value =
   00194|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00195|         if call.tool == "bash" {
   00196|             run.commands
   00197|                 .push(arguments["command"].as_str().unwrap_or_default().to_owned());
   00198|         }
   00199|         run.tools.push(call.tool.clone());
   00200|         let result = execute(&mut run.files, &call.tool, &arguments);
   00201|         let id = format!("call_{index}");
   00202|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00203|             id.clone(),
   00204|             call.tool.clone(),
   00205|             call.arguments.clone(),
   00206|         )]));
   00207|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00208|     }
   00209|     run
   00210| }
