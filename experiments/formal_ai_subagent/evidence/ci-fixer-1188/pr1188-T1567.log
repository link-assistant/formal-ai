   00109| /// `Fix the typo 'smal' in README.md`: the seeded `typo_fix_lead` with one
   00110| /// quoted word and one path, and no stated correction. The correction is
   00111| /// discovered ([`super::spelling::corrected_spelling`]), and the change is the
   00112| /// word-scoped replacement a stated correction would have made.
   00113| fn grounded_typo_fix(task: &str) -> Option<ComputedChange> {
   00114|     if !mentions("typo_fix_lead", task) {
   00115|         return None;
   00116|     }
   00117|     let (target, word) = quoted_payload_and_path(task)?;
   00118|     if !is_identifier_word(&word) {
   00119|         return None;
   00120|     }
   00121|     let correction = super::spelling::corrected_spelling(&word)?;
   00122|     Some(ComputedChange {
   00123|         target,
   00124|         intent: "coding_text_replaced",
   00125|         slots: vec![("{old}", word.clone()), ("{new}", correction.clone())],
   00126|         computation: Computation::TypoFix { word, correction },
   00127|     })
   00128| }
