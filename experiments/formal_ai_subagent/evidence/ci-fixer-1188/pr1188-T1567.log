   00374| /// `Delete the functions a and b from util.rs`: the seeded
   00375| /// `coding_text_remove_action` and `coding_declaration_noun` with no add
   00376| /// action, no quoted text and one named path. The names are the request's
   00377| /// identifiers; `removed_declarations` keeps those the file itself declares
   00378| /// as functions (mirrors `groundedDeclarationRemoval`, PR #1188 dogfooding).
   00379| fn grounded_declaration_removal(task: &str) -> Option<ComputedChange> {
   00380|     if !mentions("coding_text_remove_action", task)
   00381|         || mentions("coding_member_add_action", task)
   00382|         || !mentions("coding_declaration_noun", task)
   00383|         || !quoted_segment_spans(task).is_empty()
   00384|     {
   00385|         return None;
   00386|     }
   00387|     let mut paths: Vec<String> = super::positional_edit::unquoted_path_tokens(task)
   00388|         .iter()
   00389|         .map(|token| clean_path_token(token.text).to_owned())
   00390|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00391|         .collect();
   00392|     paths.sort();
   00393|     paths.dedup();
   00394|     let [target] = paths.as_slice() else {
   00395|         return None;
   00396|     };
   00397|     let mut names: Vec<String> = Vec::new();
   00398|     for token in tokens(task) {
   00399|         if clean_path_token(token.text) == target {
   00400|             continue;
   00401|         }
   00402|         for name in identifier_tokens(token.text) {
   00403|             if !names.iter().any(|known| known == name) {
   00404|                 names.push(name.to_owned());
   00405|             }
   00406|         }
   00407|     }
   00408|     if names.is_empty() {
   00409|         return None;
   00410|     }
   00411|     Some(ComputedChange {
   00412|         target: target.clone(),
   00413|         intent: "coding_text_remove",
   00414|         slots: vec![("{old}", names.join("`, `"))],
   00415|         computation: Computation::DeclarationRemoval { names },
   00416|     })
   00417| }
