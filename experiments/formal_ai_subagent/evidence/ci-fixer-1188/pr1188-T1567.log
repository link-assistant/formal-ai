   00419| /// `Change the value of "debug" to true in config.json`: the seeded
   00420| /// `config_value_lead` names a setting; the edit request's old clause names its
   00421| /// key (quoted, or its last identifier) and the new clause its value.
   00422| ///
   00423| /// `Change MAXIMUM_RATIO from 8 to 16 in p.rs` states the value the key holds
   00424| /// now (the seeded `file_edit_old_lead_cue`): the line assigning the key that
   00425| /// value is the one changed, and a key assigned nowhere leaves the stated
   00426| /// value itself, when it occurs once as a word (PR #1188 G2).
   00427| fn grounded_setting(task: &str) -> Option<ComputedChange> {
   00428|     let (target, old_clause, value) = compose_edit_request(task)?;
   00429|     let stated = super::workspace_setting::stated_old_value(&old_clause);
   00430|     if stated.is_none() && !mentions("config_value_lead", task) {
   00431|         return None;
   00432|     }
   00433|     // `set the contents of note.txt to hello` writes the file; its contents are
   00434|     // not a key (PR #1188 G68, issue #745).
   00435|     if stated.is_none() && mentions("file_contents_source_cue", task) {
   00436|         return None;
   00437|     }
   00438|     let key_clause = stated
   00439|         .as_ref()
   00440|         .map_or(old_clause.as_str(), |(key, _)| key.as_str());
   00441|     let quoted = quoted_segments(key_clause);
   00442|     let key = match quoted.as_slice() {
   00443|         [key] => key.clone(),
   00444|         _ => identifier_tokens(key_clause).next_back()?.to_owned(),
   00445|     };
   00446|     let value = value.trim().to_owned();
   00447|     if value.is_empty() {
   00448|         return None;
   00449|     }
   00450|     Some(ComputedChange {
   00451|         target,
   00452|         intent: "setting",
   00453|         slots: vec![("{old}", key.clone()), ("{new}", value.clone())],
   00454|         computation: Computation::Setting {
   00455|             key,
   00456|             value,
   00457|             held: stated.map(|(_, held)| held),
   00458|         },
   00459|     })
   00460| }
