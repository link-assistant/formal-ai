   00559| impl ComputedChange {
   00560|     /// The seeded answer when the text a replace or removal names is gone.
   00561|     fn absent_text_answer(&self, task: &str, source: &str) -> Option<String> {
   00562|         if !matches!(self.intent, "coding_text_replaced" | "coding_text_remove") {
   00563|             return None;
   00564|         }
   00565|         let slot = |name: &str| {
   00566|             self.slots
   00567|                 .iter()
   00568|                 .find(|(key, _)| *key == name)
   00569|                 .map(|(_, value)| value.as_str())
   00570|         };
   00571|         super::replace_list::absent_text_answer(
   00572|             task,
   00573|             &self.target,
   00574|             source,
   00575|             slot("{old}")?,
   00576|             slot("{new}"),
   00577|         )
