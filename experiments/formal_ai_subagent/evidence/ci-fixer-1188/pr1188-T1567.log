   00661|     /// The smallest unique edit carrying the change, when there is one.
   00662|     fn edit(&self, source: &str, updated: &str) -> Option<(String, String)> {
   00663|         match &self.computation {
   00664|             Computation::EndInsertion { .. } if source.is_empty() => None,
   00665|             Computation::EndInsertion { at_end, .. } => compact_end_edit(source, updated, *at_end),
   00666|             Computation::LineReplacement { context, .. } => {
   00667|                 context_lines_edit(source, updated, context.as_deref())
   00668|             }
   00669|             Computation::Removal { .. }
   00670|             | Computation::LineRemoval { .. }
   00671|             | Computation::Setting { .. }
   00672|             | Computation::TypoFix { .. }
   00673|             | Computation::DeclarationRemoval { .. }
   00674|             | Computation::Line(_)
   00675|             | Computation::Section { .. }
   00676|             | Computation::ReplaceList { .. } => changed_lines_edit(source, updated),
   00677|         }
   00678|     }
   00679| }
