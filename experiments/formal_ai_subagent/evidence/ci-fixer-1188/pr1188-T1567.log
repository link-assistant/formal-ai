   00651|     /// Whether the request states the change's whole extent (named
   00652|     /// declarations, a numbered range), so it may remove most of a file.
   00653|     const fn bounded(&self) -> bool {
   00654|         match &self.computation {
   00655|             Computation::DeclarationRemoval { .. } => true,
   00656|             Computation::Line(operation) => operation.bounded(),
   00657|             _ => false,
