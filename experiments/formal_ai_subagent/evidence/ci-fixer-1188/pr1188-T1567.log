   00948| /// The one path a colon-ended request line names, with nothing else quoted
   00949| /// (mirrors `blockPayloadAndPath`).
   00950| fn block_target(head: &str) -> Option<String> {
   00951|     let mut paths: Vec<&str> = super::positional_edit::unquoted_path_tokens(head)
   00952|         .iter()
   00953|         .map(|token| clean_path_token(token.text))
   00954|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00955|         .collect();
   00956|     paths.sort_unstable();
   00957|     paths.dedup();
   00958|     let [path] = paths.as_slice() else {
   00959|         return None;
   00960|     };
   00961|     quoted_segment_spans(head)
   00962|         .iter()
   00963|         .all(|segment| segment.text == *path)
   00964|         .then(|| (*path).to_owned())
   00965| }
   00966| 
   00967| /// The seeded `file_edit_blank_line` with one named path and no quoted text:
   00968| /// the payload is the empty string (mirrors `blankLineAndPath`).
   00969| fn blank_line_and_path(task: &str) -> Option<(String, String)> {
   00970|     if !quoted_segment_spans(task).is_empty() || !mentions("file_edit_blank_line", task) {
   00971|         return None;
   00972|     }
   00973|     let mut paths: Vec<String> = super::positional_edit::unquoted_path_tokens(task)
   00974|         .iter()
   00975|         .map(|token| clean_path_token(token.text).to_owned())
   00976|         .filter(|path| looks_like_file_path(path) && safe_relative_path(path))
   00977|         .collect();
   00978|     paths.sort();
   00979|     paths.dedup();
   00980|     match paths.as_slice() {
   00981|         [path] => Some((path.clone(), String::new())),
   00982|         _ => None,
   00983|     }
   00984| }
