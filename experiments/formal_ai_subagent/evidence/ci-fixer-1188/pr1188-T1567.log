   00580|     /// The file after the change, or `None` when it cannot apply.
   00581|     fn compute(&self, source: &str, missing: bool) -> Option<String> {
   00582|         match &self.computation {
   00583|             Computation::EndInsertion {
   00584|                 text,
   00585|                 at_end,
   00586|                 indentation,
   00587|             } => Some(inserted_at_end(
   00588|                 source,
   00589|                 &appended_block(source, text, indentation.as_deref()),
   00590|                 *at_end,
   00591|             )),
   00592|             Computation::Removal { text } => {
   00593|                 (!missing).then(|| removed_literal(source, text)).flatten()
   00594|             }
   00595|             Computation::LineRemoval { text, containing } => (!missing)
   00596|                 .then(|| removed_lines(source, text, *containing))
   00597|                 .flatten(),
   00598|             Computation::Setting { key, value, held } => (!missing)
   00599|                 .then(|| {
   00600|                     super::workspace_setting::assigned_setting(
   00601|                         source,
   00602|                         key,
   00603|                         value,
   00604|                         &self.target,
   00605|                         held.as_deref(),
   00606|                     )
   00607|                 })
   00608|                 .flatten(),
   00609|             Computation::LineReplacement {
   00610|                 old,
   00611|                 new,
   00612|                 context,
   00613|                 rebase,
   00614|             } => (!missing)
   00615|                 .then(|| {
   00616|                     let new = if *rebase {
   00617|                         super::positional_edit::rebased_block(new, line_indentation(source, old))
   00618|                     } else {
   00619|                         new.clone()
   00620|                     };
   00621|                     super::workspace_setting::replaced_lines(source, old, &new, context.as_deref())
   00622|                 })
   00623|                 .flatten(),
   00624|             Computation::TypoFix { word, correction } => (!missing)
   00625|                 .then(|| {
   00626|                     execute_scoped_workspace_rewrite(source, word, correction, RewriteScope::Word)
   00627|                         .ok()
   00628|                         .map(|execution| execution.output)
   00629|                 })
   00630|                 .flatten(),
   00631|             Computation::DeclarationRemoval { names } => (!missing)
   00632|                 .then(|| removed_declarations(source, names).map(|(updated, _)| updated))
   00633|                 .flatten(),
   00634|             Computation::Line(operation) => (!missing).then(|| operation.compute(source)).flatten(),
   00635|             Computation::Section {
   00636|                 heading,
   00637|                 text,
   00638|                 at_end,
   00639|             } => (!missing)
   00640|                 .then(|| {
   00641|                     super::markdown_section::inserted_in_section(source, heading, text, *at_end)
   00642|                 })
   00643|                 .flatten()
   00644|                 .map(|(updated, _)| updated),
   00645|             Computation::ReplaceList { pairs } => (!missing)
   00646|                 .then(|| super::replace_list::replaced_in_order(source, pairs))
   00647|                 .flatten(),
   00648|         }
   00649|     }
