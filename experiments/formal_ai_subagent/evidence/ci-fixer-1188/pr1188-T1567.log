   00336| /// Several quoted literals, joined only by seeded joiners and commas, are the
   00337| /// lines added, each its own line, as written (PR #1188 G53, G54).
   00338| fn quoted_lines_and_path(task: &str) -> Option<(String, String)> {
   00339|     let (target, payloads) = named_target_and_payloads(task)?;
   00340|     if payloads.len() < 2 {
   00341|         return None;
   00342|     }
   00343|     let text = super::positional_edit::joined_literal_lines(task, &target)?;
   00344|     Some((target, text))
   00345| }
