   00524| /// The smallest unique changed run of lines, or the lines from the context's
   00525| /// line through the change.
   00526| ///
   00527| /// When the changed run repeats, the run is widened up to the context's line:
   00528| /// the context occurs once, so the widened run does not (mirrors
   00529| /// `contextLinesEdit`).
   00530| fn context_lines_edit(
   00531|     source: &str,
   00532|     updated: &str,
   00533|     context: Option<&str>,
   00534| ) -> Option<(String, String)> {
   00535|     let compact = changed_lines_edit(source, updated);
   00536|     let Some(context) = context.filter(|_| compact.is_none()) else {
   00537|         return compact;
   00538|     };
   00539|     let mut found = source.match_indices(context).map(|(at, _)| at);
   00540|     let (Some(at), None) = (found.next(), found.next()) else {
   00541|         return None;
   00542|     };
   00543|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00544|     let suffix = source[start..]
   00545|         .bytes()
   00546|         .rev()
   00547|         .zip(updated[start..].bytes().rev())
   00548|         .take_while(|(left, right)| left == right)
   00549|         .count();
   00550|     let end = source[source.len() - suffix..]
   00551|         .find('\n')
   00552|         .map_or(source.len(), |newline| source.len() - suffix + newline);
   00553|     Some((
   00554|         source[start..end].to_owned(),
   00555|         updated[start..updated.len() - (source.len() - end)].to_owned(),
   00556|     ))
   00557| }
