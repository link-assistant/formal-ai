   00681| /// The file after the insertion; a file without a final newline keeps none.
   00682| /// Lines under an append request, at the indentation they were given.
   00683| ///
   00684| /// Only when the file already has lines indented exactly so (a `.lino` table
   00685| /// appended among its siblings); else at the file's top level, since the
   00686| /// indentation of lines written under a request is otherwise only its layout
   00687| /// (PR #1188 G16).
   00688| fn appended_block(source: &str, text: &str, indentation: Option<&str>) -> String {
   00689|     match indentation {
   00690|         Some(indentation) if super::positional_edit::indents_lines_at(source, indentation) => {
   00691|             super::positional_edit::rebased_block(text, indentation)
   00692|         }
   00693|         _ => text.to_owned(),
   00694|     }
   00695| }
   00696| 
   00697| /// The indentation of the first line that is `text` but for its indentation.
   00698| fn line_indentation<'a>(source: &'a str, text: &str) -> &'a str {
   00699|     source
   00700|         .split('\n')
   00701|         .find(|line| line.trim() == text.trim())
   00702|         .map_or("", super::positional_edit::leading_indentation)
   00703| }
   00704| 
   00705| fn inserted_at_end(source: &str, text: &str, at_end: bool) -> String {
   00706|     if source.is_empty() {
   00707|         [text, "\n"].concat()
   00708|     } else if at_end && source.ends_with('\n') {
   00709|         [source, text, "\n"].concat()
   00710|     } else if at_end {
   00711|         [source, "\n", text].concat()
   00712|     } else {
   00713|         [text, "\n", source].concat()
   00714|     }
   00715| }
   00716| 
   00717| /// The smallest unique run of whole lines at the insertion end, and what it
   00718| /// becomes, so the edit tool carries the change rather than the whole file.
   00719| fn compact_end_edit(source: &str, updated: &str, at_end: bool) -> Option<(String, String)> {
   00720|     let starts = source
   00721|         .match_indices('\n')
   00722|         .map(|(index, _)| index + 1)
   00723|         .filter(|start| *start < source.len());
   00724|     let cuts: Vec<usize> = if at_end {
   00725|         std::iter::once(0).chain(starts).rev().collect()
   00726|     } else {
   00727|         starts.chain(std::iter::once(source.len())).collect()
   00728|     };
   00729|     for cut in cuts {
   00730|         let anchor = if at_end {
   00731|             &source[cut..]
   00732|         } else {
   00733|             &source[..cut]
   00734|         };
   00735|         if anchor.trim().is_empty() {
   00736|             continue;
   00737|         }
   00738|         if anchor.len() > MAX_ANCHOR_BYTES {
   00739|             break;
   00740|         }
   00741|         if source.matches(anchor).count() != 1 {
   00742|             continue;
   00743|         }
   00744|         let replacement = if at_end {
   00745|             &updated[cut..]
   00746|         } else {
   00747|             &updated[..updated.len() - (source.len() - cut)]
   00748|         };
   00749|         return Some((anchor.to_owned(), replacement.to_owned()));
   00750|     }
   00751|     None
   00752| }
