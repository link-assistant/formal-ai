   00754| impl ComputedChange {
   00755|     /// The seed sentence that states the change made to `source`: lines that
   00756|     /// only contained the payload are reported as lines, with their count;
   00757|     /// every other change keeps its own intent and slots.
   00758|     fn reported(&self, source: &str) -> (&'static str, Vec<(&'static str, String)>) {
   00759|         if let Computation::LineRemoval { text, containing } = &self.computation {
   00760|             let lines: Vec<&str> = source.split_inclusive('\n').map(bare_line).collect();
   00761|             let removed: Vec<&str> = removed_line_indices(source, text, *containing)
   00762|                 .into_iter()
   00763|                 .map(|index| lines[index])
   00764|                 .collect();
   00765|             if removed.iter().any(|line| line != text) {
   00766|                 return (
   00767|                     "line",
   00768|                     vec![
   00769|                         ("{old}", text.clone()),
   00770|                         ("{count}", removed.len().to_string()),
   00771|                     ],
   00772|                 );
   00773|             }
   00774|         }
   00775|         if let Computation::Section {
   00776|             heading,
   00777|             text,
   00778|             at_end,
   00779|         } = &self.computation
   00780|             && let Some((_, follows)) =
   00781|                 super::markdown_section::inserted_in_section(source, heading, text, *at_end)
   00782|         {
   00783|             return (
   00784|                 self.intent,
   00785|                 vec![("{new}", text.clone()), ("{anchor}", follows)],
   00786|             );
   00787|         }
   00788|         if let Computation::DeclarationRemoval { names } = &self.computation
   00789|             && let Some((_, declared)) = removed_declarations(source, names)
   00790|         {
   00791|             return (self.intent, vec![("{old}", declared.join("`, `"))]);
   00792|         }
   00793|         if let Computation::Line(operation) = &self.computation
   00794|             && let Some(reported) = operation.reported(source)
   00795|         {
   00796|             return reported;
   00797|         }
   00798|         (self.intent, self.slots.clone())
   00799|     }
   00800| 
   00801|     /// Preserve removed names and lines as explicit list values for the summary.
   00802|     fn reported_values(&self, source: &str) -> Option<Vec<String>> {
   00803|         match &self.computation {
   00804|             Computation::DeclarationRemoval { names } => {
   00805|                 removed_declarations(source, names).map(|(_, values)| values)
   00806|             }
   00807|             Computation::Line(operation) => operation.reported_values(source),
   00808|             _ => None,
   00809|         }
   00810|     }
   00811| }
