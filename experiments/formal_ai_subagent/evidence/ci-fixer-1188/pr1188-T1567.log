   00893| /// `Append the line third to notes.txt`: no quoted text, one path, and the
   00894| /// seeded `file_edit_line_lead`; the line is the words after the lead up to
   00895| /// the last destination cue before the path (`go to bed to notes.txt` keeps
   00896| /// `go to bed`). A request without a lead is declined, never guessed.
   00897| fn line_payload_and_path(task: &str) -> Option<(String, String)> {
   00898|     if !quoted_segment_spans(task).is_empty() {
   00899|         return None;
   00900|     }
   00901|     let tokens = tokens(task);
   00902|     let paths: Vec<(usize, &str)> = tokens
   00903|         .iter()
   00904|         .enumerate()
   00905|         .map(|(index, token)| (index, clean_path_token(token.text)))
   00906|         .filter(|(_, path)| looks_like_file_path(path) && safe_relative_path(path))
   00907|         .collect();
   00908|     let (path_index, target) = *paths.first()?;
   00909|     if paths.iter().any(|(_, path)| *path != target) {
   00910|         return None;
   00911|     }
   00912|     let mut leads: Vec<Vec<String>> = seed::lexicon()
   00913|         .words_for_role("file_edit_line_lead")
   00914|         .iter()
   00915|         .map(|lead| {
   00916|             lead.to_lowercase()
   00917|                 .split_whitespace()
   00918|                 .map(str::to_owned)
   00919|                 .collect::<Vec<_>>()
   00920|         })
   00921|         .filter(|words| !words.is_empty())
   00922|         .collect();
   00923|     leads.sort_by_key(|words| std::cmp::Reverse(words.len()));
   00924|     let lead_end = (0..path_index).find_map(|index| {
   00925|         leads
   00926|             .iter()
   00927|             .find(|words| {
   00928|                 words.iter().enumerate().all(|(offset, word)| {
   00929|                     index + offset < path_index
   00930|                         && clean_cue_token(tokens[index + offset].text) == *word
   00931|                 })
   00932|             })
   00933|             .map(|words| index + words.len())
   00934|     })?;
   00935|     let destinations = bare_surfaces("file_write_destination_cue");
   00936|     let end = (lead_end..path_index)
   00937|         .rev()
   00938|         .find(|index| destinations.contains(&clean_cue_token(tokens[*index].text)))?;
   00939|     if end <= lead_end {
   00940|         return None;
   00941|     }
   00942|     Some((
   00943|         target.to_owned(),
   00944|         task[tokens[lead_end].start..tokens[end - 1].end].to_owned(),
   00945|     ))
   00946| }
