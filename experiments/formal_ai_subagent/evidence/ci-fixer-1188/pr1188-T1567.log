   00347| /// `Delete the line 'x' from notes.txt`: the seeded `coding_text_remove_action`
   00348| /// with one quoted payload and one path, and no add action alongside it.
   00349| fn grounded_removal(task: &str) -> Option<ComputedChange> {
   00350|     if !mentions("coding_text_remove_action", task) || mentions("coding_member_add_action", task) {
   00351|         return None;
   00352|     }
   00353|     let (target, text) = quoted_payload_and_path(task)?;
   00354|     // A request that names a line removes whole lines, never only the
   00355|     // payload inside one (PR #1188 G60).
   00356|     let computation = if names_line(task) {
   00357|         let containing =
   00358|             seed::lexicon().mentions_role("line_containment_cue", &outside_quotes(task));
   00359|         Computation::LineRemoval {
   00360|             text: text.clone(),
   00361|             containing,
   00362|         }
   00363|     } else {
   00364|         Computation::Removal { text: text.clone() }
   00365|     };
   00366|     Some(ComputedChange {
   00367|         target,
   00368|         intent: "coding_text_remove",
   00369|         slots: vec![("{old}", text)],
   00370|         computation,
   00371|     })
   00372| }
