   00267| /// `Append 'x' to notes.txt`, `Prepend "x" to a.md`: positioned by the seeded
   00268| /// `file_edit_position_end` / `file_edit_position_start` meanings.
   00269| pub(super) fn grounded_end_insertion(task: &str) -> Option<ComputedChange> {
   00270|     // `Append these lines to f:` followed by lines: the first line is the
   00271|     // request and the lines under it are the text added, verbatim (PR #1188).
   00272|     let block = super::positional_edit::introduced_block(task);
   00273|     // Position cues are read outside the quoted payload: a line saying "at the
   00274|     // start of x" is text being appended (PR #1188 G64).
   00275|     let cues = block
   00276|         .as_ref()
   00277|         .map_or_else(|| outside_quotes(task), |block| sentence_words(block.head));
   00278|     let lexicon = seed::lexicon();
   00279|     let at_end = lexicon.mentions_role("file_edit_position_end", &cues);
   00280|     if at_end == lexicon.mentions_role("file_edit_position_start", &cues) {
   00281|         return None;
   00282|     }
   00283|     // `… at the end of the section '## Usage' in README.md` (PR #1188 G35).
   00284|     if block.is_none()
   00285|         && let Some(section) = super::markdown_section::section_scope(task, &outside_quotes(task))
   00286|     {
   00287|         let text = super::positional_edit::unescape_prose_newlines(&section.text);
   00288|         return Some(ComputedChange {
   00289|             target: section.target,
   00290|             intent: "file_edit_position_after",
   00291|             slots: vec![
   00292|                 ("{new}", text.clone()),
   00293|                 ("{anchor}", section.heading.clone()),
   00294|             ],
   00295|             computation: Computation::Section {
   00296|                 heading: section.heading,
   00297|                 text,
   00298|                 at_end,
   00299|             },
   00300|         });
   00301|     }
   00302|     let (target, text, indentation) = if let Some(block) = block {
   00303|         let indentation = (!block.verbatim).then(|| block.indentation.to_owned());
   00304|         (block_target(block.head)?, block.text, indentation)
   00305|     } else if let Some((target, text)) = quoted_lines_and_path(task) {
   00306|         (target, text, None)
   00307|     } else {
   00308|         let (target, text) = quoted_payload_and_path(task)
   00309|             .or_else(|| blank_line_and_path(task))
   00310|             .or_else(|| line_payload_and_path(task))?;
   00311|         (
   00312|             target,
   00313|             super::positional_edit::unescape_prose_newlines(&text),
   00314|             None,
   00315|         )
   00316|     };
   00317|     Some(ComputedChange {
   00318|         target,
   00319|         // An empty line has no text to quote back; it is stated in its own words.
   00320|         intent: if text.is_empty() {
   00321|             "file_edit_blank_line"
   00322|         } else if at_end {
   00323|             "file_edit_position_end"
   00324|         } else {
   00325|             "file_edit_position_start"
   00326|         },
   00327|         slots: vec![("{new}", text.clone())],
   00328|         computation: Computation::EndInsertion {
   00329|             text,
   00330|             at_end,
   00331|             indentation,
   00332|         },
   00333|     })
   00334| }
