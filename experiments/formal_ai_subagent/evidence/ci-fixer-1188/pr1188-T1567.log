   00813| /// Read, compute, edit (or write), check the digest, state the change.
   00814| pub(super) fn plan_computed_change_step(
   00815|     task: &str,
   00816|     current_turn: &[ChatMessage],
   00817|     tool_names: &[&str],
   00818|     change: &ComputedChange,
   00819| ) -> Option<AgenticPlan> {
   00820|     let target = change.target.as_str();
   00821|     let Some(read) = result_for_path(current_turn, Capability::Read, target, None) else {
   00822|         let tool = tool_for(tool_names, Capability::Read)?;
   00823|         return Some(plan_one(tool, read_arguments(target)));
   00824|     };
   00825|     // A read that came back as the client's file block is the file, whatever
   00826|     // its text says: a ledger that quotes error lines is not a missing file.
   00827|     let missing = super::code_artifact::source_from_agent_read_result(&read).is_none()
   00828|         && super::tool_result::failure_message(&read, false, true).is_some();
   00829|     let source = if missing {
   00830|         String::new()
   00831|     } else {
   00832|         source_from_read_result(&read)
   00833|     };
   00834|     if let Some(answer) = super::edit_scope::scoped_decline(task, target, &source) {
   00835|         return Some(AgenticPlan::Final(answer));
   00836|     }
   00837|     let Some(updated) = change
   00838|         .compute(&source, missing)
   00839|         .filter(|updated| *updated != source)
   00840|     else {
   00841|         // Text the change names that the file no longer holds is the answer (G87).
   00842|         let absent = if missing {
   00843|             None
   00844|         } else {
   00845|             change.absent_text_answer(task, &source)
   00846|         };
   00847|         return Some(AgenticPlan::Final(match absent {
   00848|             Some(answer) => answer,
   00849|             None => render_seeded_outcome("coding_workspace_verification_failed", task, target)?,
   00850|         }));
   00851|     };
   00852|     // A change that would drop most of the file is refused unless its request
   00853|     // states that extent (PR #1188 T29).
   00854|     if !change.bounded() && drops_most_of_file(&source, &updated) {
   00855|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00856|             "coding_workspace_fragment_refused",
   00857|             task,
   00858|             target,
   00859|         )?));
   00860|     }
   00861|     let (intent, reported) = change.reported(&source);
   00862|     let slots: Vec<(&str, &str)> = reported
   00863|         .iter()
   00864|         .map(|(slot, value)| (*slot, value.as_str()))
   00865|         .collect();
   00866|     let values = change.reported_values(&source);
   00867|     let list_slots: Vec<(&str, &[String])> = values
   00868|         .as_deref()
   00869|         .map(|values| vec![(concat!("{", "old", "}"), values)])
   00870|         .unwrap_or_default();
   00871|     let verified = VerifiedChange {
   00872|         target,
   00873|         expected: &updated,
   00874|         intent,
   00875|         slots: &slots,
   00876|         list_slots: &list_slots,
   00877|     };
   00878|     if let Some((old, new)) = change.edit(&source, &updated)
   00879|         && let Some(tool) = tool_for(tool_names, Capability::Edit)
   00880|     {
   00881|         if result_for_edit(current_turn, target, &old, &new).is_none() {
   00882|             return Some(plan_one(tool, edit_arguments(target, &old, &new)));
   00883|         }
   00884|         return plan_digest_verification(task, current_turn, tool_names, &verified);
   00885|     }
   00886|     if result_for_path(current_turn, Capability::Write, target, Some(&updated)).is_none() {
   00887|         let tool = tool_for(tool_names, Capability::Write)?;
   00888|         return Some(plan_one(tool, write_arguments(target, &updated)));
   00889|     }
   00890|     plan_digest_verification(task, current_turn, tool_names, &verified)
   00891| }
