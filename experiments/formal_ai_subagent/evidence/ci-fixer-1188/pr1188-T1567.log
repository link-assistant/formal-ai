   00164| /// Whether the request is about text inside a file: it quotes a payload that
   00165| /// is not a path, or names a line (the seeded `line` meaning) or another unit
   00166| /// of text (`file_text_unit`: word, phrase, occurrence, text, in every
   00167| /// registered language) outside its quotes. A destructive shell intent never
   00168| /// reads such a request as deleting the file (PR #1188).
   00169| pub(super) fn edits_inside_a_file(prompt: &str) -> bool {
   00170|     if quoted_segment_spans(prompt)
   00171|         .iter()
   00172|         .map(|segment| segment.text.trim())
   00173|         .any(|text| !text.is_empty() && !super::shell_command::looks_like_a_path(text))
   00174|     {
   00175|         return true;
   00176|     }
   00177|     let outside = crate::engine::normalize_prompt(
   00178|         &crate::solver_handlers::text_outside_quoted_segments(&without_path_words(prompt)),
   00179|     )
   00180|     .to_lowercase();
   00181|     seed::lexicon()
   00182|         .meaning("line")
   00183|         .is_some_and(|meaning| meaning.evidenced_in(&outside))
   00184|         || seed::lexicon().mentions_role("file_text_unit", &outside)
   00185| }
   00186| 
   00187| /// Whether the request names a line outside its quotes: the seeded `line`
   00188| /// meaning (`the line containing '…'`, `lines`, `строку`, `पंक्ति`, `的行`).
   00189| pub(super) fn names_line(task: &str) -> bool {
   00190|     // A path's own words are no line: `x-line.lino` names a file (PR #1188 G83).
   00191|     seed::lexicon()
   00192|         .meaning("line")
   00193|         .is_some_and(|meaning| meaning.evidenced_in(&outside_quotes(&without_path_words(task))))
   00194| }
   00195| 
   00196| /// `task` with every unquoted path token blanked.
   00197| ///
   00198| /// A path's own words (`x-line.lino`, `line-budget.lino`) never read as the
   00199| /// words of the request (PR #1188 G83; mirrors `withoutPathWords`).
   00200| pub(super) fn without_path_words(task: &str) -> String {
   00201|     let segments = quoted_segment_spans(task);
   00202|     let mut out = task.to_owned();
   00203|     for token in super::write_request::tokens(task).iter().rev() {
   00204|         if segments
   00205|             .iter()
   00206|             .any(|segment| token.start < segment.end && token.end > segment.start)
   00207|         {
   00208|             continue;
   00209|         }
   00210|         let path = super::write_request::clean_path_token(token.text);
   00211|         if super::write_request::looks_like_file_path(path) {
   00212|             out.replace_range(token.start..token.end, &" ".repeat(token.end - token.start));
   00213|         }
   00214|     }
   00215|     out
   00216| }
