   00462| /// `Replace the line 'x' with 'y' in f`: the seeded `line` meaning outside
   00463| /// the quotes, both clauses quoted. A line replacement never touches text
   00464| /// inside a longer line (T32: `text pays` became `text "pay"s`). With a seeded
   00465| /// anchor context (`the line 'x' that follows the line 'z'`), the first such
   00466| /// line after `z` is the one replaced (T62).
   00467| fn grounded_line_replacement(task: &str) -> Option<ComputedChange> {
   00468|     if !names_line(task)
   00469|         || seed::lexicon().mentions_role(
   00470|             seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00471|             &task.to_lowercase(),
   00472|         )
   00473|     {
   00474|         return None;
   00475|     }
   00476|     let context = super::positional_edit::anchor_context(task);
   00477|     let request = context.as_ref().map_or_else(
   00478|         || task.to_owned(),
   00479|         |(start, end, _)| [&task[..*start], " ", &task[*end..]].concat(),
   00480|     );
   00481|     let (target, original, replacement) = compose_edit_request(&request)?;
   00482|     if super::positional_edit::compose_positional_insert(task).is_some() {
   00483|         return None;
   00484|     }
   00485|     let quoted: Vec<String> = quoted_segments(&request)
   00486|         .iter()
   00487|         .map(String::as_str)
   00488|         .map(super::positional_edit::unescape_prose_newlines)
   00489|         .collect();
   00490|     // Lines under the request (G22) replace the line as its siblings, unless
   00491|     // they were fenced or quoted.
   00492|     let block =
   00493|         super::positional_edit::introduced_block(task).filter(|block| block.text == replacement);
   00494|     // Listed lines (`the three lines 'a', 'b' and 'c'`) are quoted one by one (G80).
   00495|     let listed = !quoted.contains(&original);
   00496|     if (listed
   00497|         && !original
   00498|             .split('\n')
   00499|             .all(|line| quoted.iter().any(|text| text == line)))
   00500|         || (block.is_none() && !quoted.contains(&replacement))
   00501|         || original.is_empty()
   00502|         || original == replacement
   00503|     {
   00504|         return None;
   00505|     }
   00506|     Some(ComputedChange {
   00507|         target,
   00508|         intent: "coding_text_replaced",
   00509|         // Listed lines are named one by one, not as one span holding line breaks.
   00510|         slots: vec![
   00511|             ("{old}", original.clone()),
   00512|             ("{new}", replacement.clone()),
   00513|         ],
   00514|         computation: Computation::LineReplacement {
   00515|             listed,
   00516|             old: original,
   00517|             new: replacement,
   00518|             context: context.map(|(_, _, text)| text),
   00519|             rebase: block.is_some_and(|block| !block.verbatim),
   00520|         },
   00521|     })
   00522| }
