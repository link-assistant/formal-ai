   00040| /// How a computed change derives the file's new bytes.
   00041| #[derive(Debug, Clone, PartialEq, Eq)]
   00042| pub(super) enum Computation {
   00043|     /// Quoted text placed as the last (`at_end`) or the first line; lines
   00044|     /// given under the request keep their shared `indentation` when the file
   00045|     /// has lines indented exactly so (PR #1188 G16).
   00046|     EndInsertion {
   00047|         text: String,
   00048|         at_end: bool,
   00049|         indentation: Option<String>,
   00050|     },
   00051|     /// Every line that is exactly `text`, else its one in-line occurrence.
   00052|     Removal { text: String },
   00053|     /// Whole lines (the request names a line): see `removed_line_indices`.
   00054|     LineRemoval { text: String, containing: bool },
   00055|     /// The one line assigning `key` (holding `held`, when stated) gets
   00056|     /// `value`, in the file's own quoting.
   00057|     Setting {
   00058|         key: String,
   00059|         value: String,
   00060|         held: Option<String>,
   00061|     },
   00062|     /// Every line that is `old` becomes `new` (the request names a line), or
   00063|     /// only the first one after `context`.
   00064|     LineReplacement {
   00065|         listed: bool,
   00066|         old: String,
   00067|         new: String,
   00068|         context: Option<String>,
   00069|         rebase: bool,
   00070|     },
   00071|     /// Every whole-word `word` becomes its discovered `correction`.
   00072|     TypoFix { word: String, correction: String },
   00073|     /// The functions the file declares under these names go whole, with the
   00074|     /// comment and attribute lines directly above them.
   00075|     DeclarationRemoval { names: Vec<String> },
   00076|     /// A whole-line operation: numbered, adjacent, moved or swapped lines.
   00077|     Line(LineOperation),
   00078|     /// `text` placed at one end of the Markdown section under `heading`
   00079|     /// (PR #1188 G35).
   00080|     Section {
   00081|         heading: String,
   00082|         text: String,
   00083|         at_end: bool,
   00084|     },
   00085|     /// Each `(old, new)` pair replaced everywhere, in order (PR #1188 G82).
   00086|     ReplaceList { pairs: Vec<(String, String)> },
   00087| }
