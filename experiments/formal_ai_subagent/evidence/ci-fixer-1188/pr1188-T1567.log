   00089| /// A computed change: the file, how its bytes are computed, and the seed
   00090| /// sentence (intent and slots) that states it.
   00091| #[derive(Debug, Clone, PartialEq, Eq)]
   00092| pub(super) struct ComputedChange {
   00093|     pub(super) target: String,
   00094|     pub(super) computation: Computation,
   00095|     pub(super) intent: &'static str,
   00096|     pub(super) slots: Vec<(&'static str, String)>,
   00097| }
