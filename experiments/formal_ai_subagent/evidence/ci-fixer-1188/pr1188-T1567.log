   00130| fn mentions(role: &str, task: &str) -> bool {
   00131|     seed::lexicon().mentions_role(role, &sentence_words(task))
   00132| }
   00133| 
   00134| /// The marks that end a sentence or a clause.
   00135| const SENTENCE_MARKS: [char; 11] = [
   00136|     '.', '!', '?', ';', ':', ',', '\u{0964}', '\u{0965}', '\u{3002}', '\u{ff01}', '\u{ff1f}',
   00137| ];
   00138| 
   00139| /// The lowered request with the marks that end a sentence or clause set off
   00140| /// as spaces, so a verb that closes its sentence (`… पंक्ति हटाओ।`, `…
   00141| /// удали.`) is still a whole word. A dot inside a token (`t.md`) is not
   00142| /// followed by a space and stays.
   00143| pub(super) fn sentence_words(task: &str) -> String {
   00144|     let lowered = task.to_lowercase();
   00145|     let characters: Vec<char> = lowered.chars().collect();
   00146|     let mut out = String::with_capacity(lowered.len());
   00147|     let mut index = 0;
   00148|     while index < characters.len() {
   00149|         let mut end = index;
   00150|         while end < characters.len() && SENTENCE_MARKS.contains(&characters[end]) {
   00151|             end += 1;
   00152|         }
   00153|         if end > index && characters.get(end).is_none_or(|next| next.is_whitespace()) {
   00154|             out.push(' ');
   00155|             index = end;
   00156|         } else {
   00157|             out.push(characters[index]);
   00158|             index += 1;
   00159|         }
   00160|     }
   00161|     out
   00162| }
