   00099| /// The first computed change `task` asks for, if any.
   00100| pub(super) fn grounded_computed_change(task: &str) -> Option<ComputedChange> {
   00101|     grounded_end_insertion(task)
   00102|         .or_else(|| grounded_removal(task))
   00103|         .or_else(|| grounded_declaration_removal(task))
   00104|         .or_else(|| grounded_line_replacement(task))
   00105|         .or_else(|| grounded_setting(task))
   00106|         .or_else(|| grounded_typo_fix(task))
   00107| }
