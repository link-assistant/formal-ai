   00082| #[test]
   00083| fn lines_under_a_request_keep_their_structure() {
   00084|     let rebased = drive(
   00085|         "Insert the following lines after the line 'b' in f.lino:\ntable q\n  row 1",
   00086|         LINO,
   00087|         "f.lino",
   00088|     );
   00089|     assert_eq!(
   00090|         rebased.file,
   00091|         "meanings\n  table a\n    row x\n  b\n  table q\n    row 1\nc\n"
   00092|     );
   00093|     let fenced = drive(
   00094|         "Insert these lines after the line 'b' in f.lino:\n```\ntable q\n```",
   00095|         LINO,
   00096|         "f.lino",
   00097|     );
   00098|     assert_eq!(
   00099|         fenced.file,
   00100|         "meanings\n  table a\n    row x\n  b\ntable q\nc\n"
   00101|     );
   00102|     let appended = drive(
   00103|         "Append these lines to f.lino:\n  table z\n    row 9",
   00104|         LINO,
   00105|         "f.lino",
   00106|     );
   00107|     assert_eq!(appended.file, [LINO, "  table z\n    row 9\n"].concat());
   00108|     // G93: an indentation the file already uses is kept, whatever the anchor's.
   00109|     let given = drive(
   00110|         "Insert these lines after the line containing 'row x' in f.lino:\n  table q\n    row 1",
   00111|         LINO,
   00112|         "f.lino",
   00113|     );
   00114|     assert_eq!(
   00115|         given.file,
   00116|         "meanings\n  table a\n    row x\n  table q\n    row 1\n  b\nc\n"
   00117|     );
   00118| }
