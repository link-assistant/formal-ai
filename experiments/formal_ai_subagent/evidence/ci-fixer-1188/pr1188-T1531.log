   00001| //! PR #1188 TEACH-D: the edit-composer gaps Formal AI showed as a subagent
   00002| //! (`experiments/formal_ai_subagent/gaps.md` G16, G19, G20, G21, G22, G24,
   00003| //! G28, G31). Before: lines under an insert request lost their indentation
   00004| //! (G16); an ordinal line was only read (G19); a Spanish line operation
   00005| //! answered in English (G20); a quoted path-shaped anchor was taken for the
   00006| //! file (G21); `with these three lines in f:` replaced the line by the words
   00007| //! (G22); a file rename rewrote the word `the` (G24); an empty line beside
   00008| //! an anchor only read the file (G31). Twin of
   00009| //! `rust/tests/web/pull-request-1188-edit-composer-gaps.test.mjs`.
   00010| 
   00011| use formal_ai::agentic_coding::general_planner::compose_edit_request;
   00012| use formal_ai::agentic_coding::{AgenticPlan, plan_chat_step};
   00013| use formal_ai::protocol::{ChatMessage, ToolCall};
   00014| use formal_ai::source_fetch::sha256_hex;
   00015| 
   00016| const TOOLS: [&str; 4] = ["read", "edit", "bash", "write"];
   00017| const THREE: &str = "one\ntwo\nthree\n";
   00018| const LINO: &str = "meanings\n  table a\n    row x\n  b\nc\n";
   00019| 
   00020| /// The calls made (a shell call by its command), the file afterwards, and the
   00021| /// final answer.
   00022| struct Run {
   00023|     calls: Vec<String>,
   00024|     file: String,
   00025|     answer: Option<String>,
   00026| }
   00027| 
   00028| /// Run `prompt` over one file `name` holding `source`; the tools act on it the
   00029| /// way the Agent CLI's do.
   00030| fn drive(prompt: &str, source: &str, name: &str) -> Run {
   00031|     let mut file = source.to_owned();
   00032|     let mut messages = vec![ChatMessage::user(prompt)];
   00033|     let mut calls = Vec::new();
   00034|     let mut answer = None;
   00035|     for index in 0..6 {
   00036|         let planned = match plan_chat_step(&messages, &TOOLS) {
   00037|             Some(AgenticPlan::ToolCalls(planned)) => planned,
   00038|             Some(AgenticPlan::Final(text)) => {
   00039|                 answer = Some(text);
   00040|                 break;
   00041|             }
   00042|             None => break,
   00043|         };
   00044|         let call = planned[0].clone();
   00045|         let arguments: serde_json::Value =
   00046|             serde_json::from_str(&call.arguments).expect("tool arguments are JSON");
   00047|         let result = match call.tool.as_str() {
   00048|             "read" => file.clone(),
   00049|             "edit" => {
   00050|                 let old = arguments["oldString"].as_str().unwrap_or_default();
   00051|                 let new = arguments["newString"].as_str().unwrap_or_default();
   00052|                 file = file.replacen(old, new, 1);
   00053|                 String::new()
   00054|             }
   00055|             "write" => {
   00056|                 arguments["content"].as_str().unwrap_or_default().clone_into(&mut file);
   00057|                 String::new()
   00058|             }
   00059|             "bash" => format!("{}  {name}\n", sha256_hex(file.as_bytes())),
   00060|             _ => String::new(),
   00061|         };
   00062|         calls.push(if call.tool == "bash" {
   00063|             arguments["command"].as_str().unwrap_or_default().to_owned()
   00064|         } else {
   00065|             call.tool.clone()
   00066|         });
   00067|         let id = format!("call_{index}");
   00068|         messages.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00069|             id.clone(),
   00070|             call.tool.clone(),
   00071|             call.arguments.clone(),
   00072|         )]));
   00073|         messages.push(ChatMessage::tool_result(id, call.tool.clone(), result));
   00074|     }
   00075|     Run {
   00076|         calls,
   00077|         file,
   00078|         answer,
   00079|     }
   00080| }
