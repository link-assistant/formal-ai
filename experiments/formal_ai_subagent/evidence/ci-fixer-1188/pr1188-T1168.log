   00709| impl LineOperation {
   00710|     /// The one-based lines a numbered operation names in `source`, earlier
   00711|     /// first; `None` for any other operation or a count past the file.
   00712|     fn resolved_lines(&self, source: &str) -> Option<(usize, usize)> {
   00713|         let count = file_lines(source).0.len();
   00714|         let (first, last, from_end) = match self {
   00715|             Self::RangeRemoval {
   00716|                 first,
   00717|                 last,
   00718|                 from_end,
   00719|             } => (*first, *last, *from_end),
   00720|             Self::NumberedInsertion { line, from_end, .. } => (*line, *line, *from_end),
   00721|             _ => return None,
   00722|         };
   00723|         Some((
   00724|             resolved_line(first, count, from_end)?,
   00725|             resolved_line(last, count, from_end)?,
   00726|         ))
   00727|     }
   00728| }
