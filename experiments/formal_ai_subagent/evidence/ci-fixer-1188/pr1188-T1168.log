   00166| /// The request outside its quotes as words, numbers and dashes. A path is one
   00167| /// opaque piece; a Han ideograph is a word of its own.
   00168| fn line_pieces(task: &str) -> Vec<Piece> {
   00169|     let outside = text_outside_quoted_segments(task);
   00170|     let mut pieces = Vec::new();
   00171|     for token in tokens(&outside) {
   00172|         let path = clean_path_token(token.text);
   00173|         if is_ascii_printable(path) && looks_like_file_path(path) {
   00174|             pieces.push(Piece::Path);
   00175|             continue;
   00176|         }
   00177|         let mut run = String::new();
   00178|         let mut kind: Option<Run> = None;
   00179|         for character in token.text.chars() {
   00180|             let next = if character.is_ascii_digit() {
   00181|                 Some(Run::Number)
   00182|             } else if DASHES.contains(&character) {
   00183|                 Some(Run::Dash)
   00184|             } else if is_han(character) {
   00185|                 Some(Run::Han)
   00186|             } else if character.is_ascii_punctuation() || WIDE_PUNCTUATION.contains(&character) {
   00187|                 None
   00188|             } else {
   00189|                 Some(Run::Word)
   00190|             };
   00191|             if next != kind || matches!(next, Some(Run::Dash | Run::Han)) {
   00192|                 flush_piece(&mut pieces, &mut run, kind);
   00193|             }
   00194|             if let Some(next) = next {
   00195|                 kind = Some(next);
   00196|                 run.push(character);
   00197|             } else {
   00198|                 kind = None;
   00199|             }
   00200|         }
   00201|         flush_piece(&mut pieces, &mut run, kind);
   00202|     }
   00203|     pieces
   00204| }
   00205| 
   00206| fn flush_piece(pieces: &mut Vec<Piece>, run: &mut String, kind: Option<Run>) {
   00207|     if run.is_empty() {
   00208|         return;
   00209|     }
   00210|     let piece = match kind {
   00211|         Some(Run::Dash) => Piece::Dash,
   00212|         Some(Run::Number) if run.len() <= MAX_NUMBER_DIGITS => run
   00213|             .parse()
   00214|             .map_or_else(|_| Piece::Word(run.clone()), Piece::Number),
   00215|         _ => Piece::Word(run.to_lowercase()),
   00216|     };
   00217|     pieces.push(piece);
   00218|     run.clear();
   00219| }
