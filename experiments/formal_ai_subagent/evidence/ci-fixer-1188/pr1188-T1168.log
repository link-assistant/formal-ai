   00465| /// The file's lines without their `\n`, and whether it ended in one.
   00466| fn file_lines(source: &str) -> (Vec<&str>, bool) {
   00467|     let trailing = source.ends_with('\n');
   00468|     let body = source.strip_suffix('\n').unwrap_or(source);
   00469|     let lines = if source.is_empty() {
   00470|         Vec::new()
   00471|     } else {
   00472|         body.split('\n').collect()
   00473|     };
   00474|     (lines, trailing)
   00475| }
   00476| 
   00477| fn joined_lines(lines: &[&str], trailing: bool) -> String {
   00478|     if lines.is_empty() {
   00479|         return String::new();
   00480|     }
   00481|     let mut out = lines.join("\n");
   00482|     if trailing {
   00483|         out.push('\n');
   00484|     }
   00485|     out
   00486| }
   00487| 
   00488| fn bare(line: &str) -> &str {
   00489|     line.strip_suffix('\r').unwrap_or(line)
   00490| }
