   00234| /// Every line number or range the request names, one-based and inclusive.
   00235| ///
   00236| /// A seeded `numbered_line_noun` comes before the number (`line 12`, `lines
   00237| /// 3-5`, `lines from 3 to 5`, `строки с 3 по 5`), or, after a seeded lead,
   00238| /// after it (`第3到5行`).
   00239| pub(super) fn numbered_lines(task: &str) -> Vec<(usize, usize)> {
   00240|     let pieces = line_pieces(task);
   00241|     let nouns = role_words("numbered_line_noun");
   00242|     let leads = role_words("numbered_line_lead");
   00243|     let connectors = role_words("line_range_connector");
   00244|     let word_in = |index: usize, words: &[String]| is_word_in(&pieces, index, words);
   00245|     let number_at = |index: usize| match pieces.get(index) {
   00246|         Some(Piece::Number(number)) => Some(*number),
   00247|         _ => None,
   00248|     };
   00249|     let mut found = Vec::new();
   00250|     let mut index = 0;
   00251|     while index < pieces.len() {
   00252|         let Some(first) = number_at(index) else {
   00253|             index += 1;
   00254|             continue;
   00255|         };
   00256|         let mut end = index;
   00257|         let joint = index + 1;
   00258|         if matches!(pieces.get(joint), Some(Piece::Dash)) || word_in(joint, &connectors) {
   00259|             let second = if word_in(joint + 1, &leads) {
   00260|                 joint + 2
   00261|             } else {
   00262|                 joint + 1
   00263|             };
   00264|             if number_at(second).is_some() {
   00265|                 end = second;
   00266|             }
   00267|         }
   00268|         let mut led = 0;
   00269|         while led < 2 && index > led && word_in(index - 1 - led, &leads) {
   00270|             led += 1;
   00271|         }
   00272|         let noun_before = index
   00273|             .checked_sub(1 + led)
   00274|             .is_some_and(|noun| word_in(noun, &nouns));
   00275|         if noun_before || (led > 0 && word_in(end + 1, &nouns)) {
   00276|             found.push((first, number_at(end).unwrap_or(first)));
   00277|             index = end + 1;
   00278|         } else {
   00279|             index += 1;
   00280|         }
   00281|     }
   00282|     found
   00283| }
