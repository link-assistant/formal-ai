   00226| fn role_words(role: &str) -> Vec<String> {
   00227|     seed::lexicon()
   00228|         .words_for_role(role)
   00229|         .into_iter()
   00230|         .map(|word| word.to_lowercase())
   00231|         .collect()
   00232| }
