   00376| /// The one run of lines a read request names (PR #1188 G33).
   00377| ///
   00378| /// One-based and inclusive, counted from the end when `from_end`: a numbered
   00379| /// line or range (`lines 2-3`), a seeded ordinal line (`the last line`), or a
   00380| /// count between a seeded head or tail cue and a line noun (`the first 2
   00381| /// lines`, `последние 2 строки`).
   00382| #[derive(Debug, Clone, Copy, PartialEq, Eq)]
   00383| pub(super) struct LineSlice {
   00384|     pub(super) from: usize,
   00385|     pub(super) to: usize,
   00386|     pub(super) from_end: bool,
   00387| }
   00388| 
   00389| /// The [`LineSlice`] `task` names, if exactly one.
   00390| pub(super) fn line_slice(task: &str) -> Option<LineSlice> {
   00391|     let numbered = numbered_lines(task);
   00392|     if let [(from, to)] = numbered.as_slice() {
   00393|         return Some(LineSlice {
   00394|             from: *from,
   00395|             to: *to,
   00396|             from_end: false,
   00397|         });
   00398|     }
   00399|     if numbered.len() > 1 {
   00400|         return None;
   00401|     }
   00402|     let outside = text_outside_quoted_segments(task).to_lowercase();
   00403|     if let [ordinal] = ordinal_lines(&outside).as_slice() {
   00404|         return Some(LineSlice {
   00405|             from: ordinal.value,
   00406|             to: ordinal.value,
   00407|             from_end: ordinal.from_end,
   00408|         });
   00409|     }
   00410|     let pieces = line_pieces(task);
   00411|     let nouns = role_words("numbered_line_noun");
   00412|     let (heads, tails) = (
   00413|         role_words("line_slice_head_cue"),
   00414|         role_words("line_slice_tail_cue"),
   00415|     );
   00416|     let mut slices = Vec::new();
   00417|     for (index, piece) in pieces.iter().enumerate().skip(1) {
   00418|         let Piece::Number(count) = *piece else {
   00419|             continue;
   00420|         };
   00421|         if count == 0 || !is_word_in(&pieces, index + 1, &nouns) {
   00422|             continue;
   00423|         }
   00424|         if is_word_in(&pieces, index - 1, &heads) {
   00425|             slices.push(LineSlice {
   00426|                 from: 1,
   00427|                 to: count,
   00428|                 from_end: false,
   00429|             });
   00430|         } else if is_word_in(&pieces, index - 1, &tails) {
   00431|             slices.push(LineSlice {
   00432|                 from: count,
   00433|                 to: 1,
   00434|                 from_end: true,
   00435|             });
   00436|         }
   00437|     }
   00438|     match slices.as_slice() {
   00439|         [slice] => Some(*slice),
   00440|         _ => None,
   00441|     }
   00442| }
