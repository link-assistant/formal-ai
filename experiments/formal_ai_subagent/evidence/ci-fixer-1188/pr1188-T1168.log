   00115| /// The one workspace path the request names and its quoted payloads.
   00116| ///
   00117| /// A path the request leaves unquoted is the file; only when it names none
   00118| /// does a quoted literal that is exactly one path name it, so `Delete the
   00119| /// lines containing 'src/x.rs' from list.txt` edits `list.txt` (PR #1188 T35).
   00120| pub(super) fn named_target_and_payloads(task: &str) -> Option<(String, Vec<String>)> {
   00121|     let segments = quoted_segment_spans(task);
   00122|     let is_path = |path: &str| looks_like_file_path(path) && safe_relative_path(path);
   00123|     let mut unquoted: Vec<&str> = Vec::new();
   00124|     for token in tokens(task) {
   00125|         if segments
   00126|             .iter()
   00127|             .any(|segment| token.start < segment.end && token.end > segment.start)
   00128|         {
   00129|             continue;
   00130|         }
   00131|         let path = clean_path_token(token.text);
   00132|         if is_path(path) && !unquoted.contains(&path) {
   00133|             unquoted.push(path);
   00134|         }
   00135|     }
   00136|     let mut quoted: Vec<&str> = Vec::new();
   00137|     for segment in &segments {
   00138|         if is_path(&segment.text) && !quoted.contains(&segment.text.as_str()) {
   00139|             quoted.push(&segment.text);
   00140|         }
   00141|     }
   00142|     let target = match (unquoted.as_slice(), quoted.as_slice()) {
   00143|         ([path], _) | ([], [path]) => (*path).to_owned(),
   00144|         _ => return None,
   00145|     };
   00146|     let payloads = segments
   00147|         .iter()
   00148|         .map(|segment| segment.text.clone())
   00149|         .filter(|text| *text != target && !text.trim().is_empty())
   00150|         .collect();
   00151|     Some((target, payloads))
   00152| }
