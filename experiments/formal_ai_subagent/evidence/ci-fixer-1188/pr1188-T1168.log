   00444| /// The lines of `source` a [`LineSlice`] names, with the file's own one-based
   00445| /// numbers of the first and last, or `None` when the file has none of them.
   00446| pub(super) fn sliced_lines(source: &str, slice: LineSlice) -> Option<(usize, usize, String)> {
   00447|     let (lines, _) = file_lines(source);
   00448|     let count = lines.len();
   00449|     let first = if slice.from_end {
   00450|         (count + 1).saturating_sub(slice.from).max(1)
   00451|     } else {
   00452|         slice.from
   00453|     };
   00454|     let last = count.min(if slice.from_end {
   00455|         (count + 1).saturating_sub(slice.to)
   00456|     } else {
   00457|         slice.to
   00458|     });
   00459|     if first == 0 || first > last {
   00460|         return None;
   00461|     }
   00462|     Some((first, last, lines[first - 1..last].join("\n")))
   00463| }
