   00560|                     index.checked_sub(1)?
   00561|                 } else {
   00562|                     index + 1
   00563|                 };
   00564|                 (matches && other < lines.len() && fits(other)).then_some((index, other))
   00565|             })
   00566|             .collect()
   00567|     };
   00568|     let mut found = pairs(true);
   00569|     if found.is_empty() {
   00570|         found = pairs(false);
   00571|     }
   00572|     match found.as_slice() {
   00573|         [pair] => Some(*pair),
   00574|         _ => None,
   00575|     }
   00576| }
