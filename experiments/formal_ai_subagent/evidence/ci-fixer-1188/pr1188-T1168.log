   00221| /// Whether the piece at `index` is one of `words`.
   00222| fn is_word_in(pieces: &[Piece], index: usize, words: &[String]) -> bool {
   00223|     matches!(pieces.get(index), Some(Piece::Word(word)) if words.contains(word))
   00224| }
