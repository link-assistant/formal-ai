   00526|     let (lines, trailing) = file_lines(source);
   00527|     if line < 1 || line > lines.len() {
   00528|         return None;
   00529|     }
   00530|     let at = if after { line } else { line - 1 };
   00531|     let inserted: Vec<&str> = text.split('\n').collect();
