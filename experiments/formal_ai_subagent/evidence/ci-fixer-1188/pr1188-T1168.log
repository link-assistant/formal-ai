   00640|                 }
   00641|             }
   00642|             Self::AdjacentRemoval {
   00643|                 anchor,
   00644|                 neighbour,
   00645|                 above,
   00646|             } => removed_adjacent(source, anchor, neighbour.as_deref(), *above),
   00647|             Self::Move {
   00648|                 text,
   00649|                 destination,
   00650|                 anchor,
   00651|             } => moved_line(source, text, *destination, anchor.as_deref()),
   00652|             Self::Swap { first, second } => swapped_lines(source, first, second),
   00653|         }
   00654|     }
