   00285| /// A line named by a seeded ordinal right before a seeded line noun.
   00286| struct Ordinal {
   00287|     /// The one-based count, from the start or (`from_end`) from the end.
   00288|     value: usize,
   00289|     from_end: bool,
   00290|     /// The byte span of the ordinal and its noun in the lowered request.
   00291|     start: usize,
   00292|     end: usize,
   00293| }
   00294| 
   00295| /// A letter or digit outside the Han block, which a word boundary may not split.
   00296| fn joins_word(character: Option<char>) -> bool {
   00297|     character.is_some_and(|character| character.is_alphanumeric() && !is_han(character))
   00298| }
   00299| 
   00300| /// The one-based number a seeded line ordinal counts to: the digits its
   00301| /// cardinal meaning (`defined-by one`) spells.
   00302| fn ordinal_value(meaning: &seed::Meaning) -> Option<usize> {
   00303|     let lexicon = seed::lexicon();
   00304|     meaning.defined_by.iter().find_map(|slug| {
   00305|         let cardinal = lexicon.meaning(slug)?;
   00306|         if !cardinal.has_role("cardinal_number_word") {
   00307|             return None;
   00308|         }
   00309|         cardinal
   00310|             .words()
   00311|             .filter(|text| {
   00312|                 !text.is_empty()
   00313|                     && text.len() <= MAX_NUMBER_DIGITS
   00314|                     && text.bytes().all(|byte| byte.is_ascii_digit())
   00315|             })
   00316|             .find_map(|text| text.parse().ok())
   00317|     })
   00318| }
   00319| 
   00320| /// Every line the request names by a seeded ordinal before a line noun.
   00321| ///
   00322| /// `the first line`, `последнюю строку`, `第一行`, `la última línea`; a
   00323| /// `line_ordinal_last` ordinal counts from the end (PR #1188 G19).
   00324| fn ordinal_lines(lowered: &str) -> Vec<Ordinal> {
   00325|     let nouns: Vec<String> = role_words("numbered_line_noun")
   00326|         .into_iter()
   00327|         .filter(|noun| !noun.is_empty())
   00328|         .collect();
   00329|     let mut found = Vec::new();
   00330|     for (role, from_end) in [("line_ordinal", false), ("line_ordinal_last", true)] {
   00331|         for meaning in seed::lexicon().meanings_with_role(role) {
   00332|             let Some(value) = ordinal_value(meaning) else {
   00333|                 continue;
   00334|             };
   00335|             for surface in meaning.words().map(str::to_lowercase) {
   00336|                 if surface.is_empty() {
   00337|                     continue;
   00338|                 }
   00339|                 for (at, _) in lowered.match_indices(surface.as_str()) {
   00340|                     if joins_word(lowered[..at].chars().next_back()) {
   00341|                         continue;
   00342|                     }
   00343|                     let rest = &lowered[at + surface.len()..];
   00344|                     let gap = rest.len() - rest.trim_start().len();
   00345|                     if gap == 0 && joins_word(rest.chars().next()) {
   00346|                         continue;
   00347|                     }
   00348|                     let noun = nouns.iter().find(|noun| {
   00349|                         rest[gap..].starts_with(noun.as_str())
   00350|                             && !joins_word(rest[gap + noun.len()..].chars().next())
   00351|                     });
   00352|                     if let Some(noun) = noun {
   00353|                         found.push(Ordinal {
   00354|                             value,
   00355|                             from_end,
   00356|                             start: at,
   00357|                             end: at + surface.len() + gap + noun.len(),
   00358|                         });
   00359|                     }
   00360|                 }
   00361|             }
   00362|         }
   00363|     }
   00364|     found
   00365| }
