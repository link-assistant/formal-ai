   00585|     let (one, two) = adjacent_pair(&lines, anchor, neighbour, above)?;
   00586|     let kept: Vec<&str> = lines
   00587|         .iter()
   00588|         .enumerate()
   00589|         .filter(|(index, _)| *index != one && *index != two)
   00590|         .map(|(_, line)| *line)
   00591|         .collect();
