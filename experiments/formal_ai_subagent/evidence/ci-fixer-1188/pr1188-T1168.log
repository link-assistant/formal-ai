   00595| /// The line `text` names taken out and put back at the start, the end, or
   00596| /// beside the line `anchor` names among the rest.
   00597| fn moved_line(
   00598|     source: &str,
   00599|     text: &str,
   00600|     destination: Destination,
   00601|     anchor: Option<&str>,
   00602| ) -> Option<String> {
   00603|     let (lines, trailing) = file_lines(source);
   00604|     let from = unique_line(&lines, text)?;
   00605|     let mut rest = lines;
   00606|     let moved = rest.remove(from);
   00607|     let at = match destination {
   00608|         Destination::Start => 0,
   00609|         Destination::End => rest.len(),
   00610|         Destination::After => unique_line(&rest, anchor?)? + 1,
   00611|         Destination::Before => unique_line(&rest, anchor?)?,
   00612|     };
   00613|     rest.insert(at, moved);
   00614|     Some(joined_lines(&rest, trailing))
   00615| }
