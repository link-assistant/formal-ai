   00919|                 LineOperation::Move {
   00920|                     text: text.clone(),
   00921|                     destination: if after {
   00922|                         Destination::After
   00923|                     } else {
   00924|                         Destination::Before
   00925|                     },
   00926|                     anchor: Some(anchor.clone()),
   00927|                 },
   00928|                 if after {
   00929|                     "line_moved_after"
   00930|                 } else {
   00931|                     "line_moved_before"
   00932|                 },
   00933|                 vec![(OLD_SLOT, text.clone()), (ANCHOR_SLOT, anchor.clone())],
   00934|             ))
   00935|         }
   00936|         _ => None,
   00937|     }
   00938| }
