   00536| /// The line `anchor` names and the line directly above (or below) it, when
   00537| /// exactly one such pair exists and the neighbour, if named, is that line.
   00538| fn adjacent_pair(
   00539|     lines: &[&str],
   00540|     anchor: &str,
   00541|     neighbour: Option<&str>,
   00542|     above: bool,
   00543| ) -> Option<(usize, usize)> {
   00544|     let fits = |index: usize| {
   00545|         let line = bare(lines[index]);
   00546|         neighbour.is_none_or(|neighbour| {
   00547|             line == neighbour || line.trim() == neighbour.trim() || line.contains(neighbour)
   00548|         })
   00549|     };
