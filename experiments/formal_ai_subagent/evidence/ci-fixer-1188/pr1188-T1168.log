   00551|         (0..lines.len())
   00552|             .filter_map(|index| {
   00553|                 let line = bare(lines[index]);
   00554|                 let matches = if exact {
   00555|                     line == anchor
   00556|                 } else {
   00557|                     line.contains(anchor)
   00558|                 };
