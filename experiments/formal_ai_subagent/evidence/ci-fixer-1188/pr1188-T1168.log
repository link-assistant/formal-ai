   00154| /// One Han ideograph, a word of its own.
   00155| const fn is_han(character: char) -> bool {
   00156|     matches!(
   00157|         character,
   00158|         '\u{3400}'..='\u{4dbf}' | '\u{4e00}'..='\u{9fff}' | '\u{f900}'..='\u{faff}'
   00159|     )
   00160| }
   00161| 
   00162| fn is_ascii_printable(text: &str) -> bool {
   00163|     !text.is_empty() && text.bytes().all(|byte| (0x21..=0x7e).contains(&byte))
   00164| }
