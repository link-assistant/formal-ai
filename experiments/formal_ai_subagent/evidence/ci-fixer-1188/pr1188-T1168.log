   00492| /// The one line that is exactly `text`, else the one line containing it;
   00493| /// `None` when there are none or several.
   00494| fn unique_line(lines: &[&str], text: &str) -> Option<usize> {
   00495|     let exact: Vec<usize> = (0..lines.len())
   00496|         .filter(|index| bare(lines[*index]) == text)
   00497|         .collect();
   00498|     if !exact.is_empty() {
   00499|         return only(&exact);
   00500|     }
   00501|     let containing: Vec<usize> = (0..lines.len())
   00502|         .filter(|index| bare(lines[*index]).contains(text))
   00503|         .collect();
   00504|     only(&containing)
   00505| }
   00506| 
   00507| const fn only(indices: &[usize]) -> Option<usize> {
   00508|     match indices {
