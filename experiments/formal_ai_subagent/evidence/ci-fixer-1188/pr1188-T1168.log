   00023| /// A digit run longer than this is not a line number.
   00024| /// The seed frames' slots, spelled so no literal reads as a format argument
   00025| /// beside a binding of the same name.
   00026| const LINES_SLOT: &str = concat!("{", "lines", "}");
   00027| const OLD_SLOT: &str = concat!("{", "old", "}");
   00028| const ANCHOR_SLOT: &str = concat!("{", "anchor", "}");
   00029| const NEW_SLOT: &str = concat!("{", "new", "}");
   00030| const LINE_SLOT: &str = concat!("{", "line", "}");
   00031| const MAX_NUMBER_DIGITS: usize = 9;
   00032| /// A file below this many lines is too short for "most of it" to mean anything.
   00033| const MIN_GUARDED_LINES: usize = 8;
   00034| const DASHES: [char; 3] = ['-', '\u{2013}', '\u{2014}'];
   00035| /// Punctuation beyond ASCII that separates the pieces of a request.
   00036| const WIDE_PUNCTUATION: [char; 15] = [
   00037|     '\u{ab}', '\u{bb}', '\u{964}', '\u{965}', '\u{2018}', '\u{2019}', '\u{201c}', '\u{201d}',
   00038|     '\u{3001}', '\u{3002}', '\u{ff01}', '\u{ff0c}', '\u{ff1a}', '\u{ff1b}', '\u{ff1f}',
   00039| ];
