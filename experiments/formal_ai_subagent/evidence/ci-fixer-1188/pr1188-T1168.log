   00662|     /// The seed sentence for the lines actually removed, when the operation
   00663|     /// reports them from the file rather than from the request.
   00664|     pub(super) fn reported(&self, source: &str) -> Option<(&'static str, Slots)> {
   00665|         match self {
   00666|             Self::RangeRemoval { from_end: true, .. } => {
   00667|                 let (first, last) = self.resolved_lines(source)?;
   00668|                 let lines = if first == last {
   00669|                     first.to_string()
   00670|                 } else {
   00671|                     format!("{first}-{last}")
   00672|                 };
   00673|                 return Some(("numbered_lines_removed", vec![(LINES_SLOT, lines)]));
   00674|             }
   00675|             Self::NumberedInsertion {
   00676|                 text,
   00677|                 after,
   00678|                 from_end: true,
   00679|                 ..
   00680|             } => {
   00681|                 let (line, _) = self.resolved_lines(source)?;
