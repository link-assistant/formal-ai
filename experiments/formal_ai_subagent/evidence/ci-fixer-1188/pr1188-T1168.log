   00629| impl LineOperation {
   00630|     /// The file after the operation, or `None` when it cannot apply.
   00631|     pub(super) fn compute(&self, source: &str) -> Option<String> {
   00632|         match self {
   00633|             Self::RangeRemoval { .. } | Self::NumberedInsertion { .. } => {
   00634|                 let (first, last) = self.resolved_lines(source)?;
