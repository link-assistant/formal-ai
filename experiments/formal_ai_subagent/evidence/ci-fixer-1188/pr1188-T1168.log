   00894|                     destination: if at_start {
   00895|                         Destination::Start
   00896|                     } else {
   00897|                         Destination::End
   00898|                     },
   00899|                     anchor: None,
   00900|                 },
   00901|                 if at_start {
   00902|                     "line_moved_start"
   00903|                 } else {
   00904|                     "line_moved_end"
   00905|                 },
