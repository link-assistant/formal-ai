   00367| /// Line `line` of a file of `count` lines, counted from its end when `from_end`.
   00368| const fn resolved_line(line: usize, count: usize, from_end: bool) -> Option<usize> {
   00369|     if from_end {
   00370|         (count + 1).checked_sub(line)
   00371|     } else {
   00372|         Some(line)
   00373|     }
   00374| }
