   00617| /// The two named lines exchanged.
   00618| fn swapped_lines(source: &str, first: &str, second: &str) -> Option<String> {
   00619|     let (mut lines, trailing) = file_lines(source);
   00620|     let one = unique_line(&lines, first)?;
   00621|     let two = unique_line(&lines, second)?;
   00622|     if one == two {
   00623|         return None;
   00624|     }
   00625|     lines.swap(one, two);
   00626|     Some(joined_lines(&lines, trailing))
