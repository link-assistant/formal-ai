   00106| /// The source text of one row of the language table, from its `slug` line
   00107| /// to the next row.
   00108| fn row_text(slug: &str) -> &'static str {
   00109|     let opening = format!("slug: \"{slug}\",");
   00110|     let start = LANGUAGES_SOURCE
   00111|         .find(&opening)
   00112|         .unwrap_or_else(|| panic!("no row for {slug}"));
   00113|     let rest = &LANGUAGES_SOURCE[start..];
   00114|     rest.find("ProgramLanguage {")
   00115|         .map_or(rest, |end| &rest[..end])
   00116| }
