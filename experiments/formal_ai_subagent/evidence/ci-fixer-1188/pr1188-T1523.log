   00076| /// R1165-6: the catalog rows run with the derived commands, for a task the
   00077| /// page never documented too (Kotlin `FizzBuzz`).
   00078| #[test]
   00079| fn a_derived_command_is_the_catalog_command_of_every_task() {
   00080|     let kotlin: Vec<String> = documented_run_commands("kotlin", "hello_world")
