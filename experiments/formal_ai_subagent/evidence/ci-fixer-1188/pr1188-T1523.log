   00001| //! Issue #1165 R1165-6: no language row hard-codes a compile or run command
   00002| //! that a captured documentation page states.
   00003| //!
   00004| //! The policy seed's `command_procedure` rows name, per language and role,
   00005| //! the captured page and the `command_verb` its command line starts with;
   00006| //! `documented_language_commands` derives the command from that page with
   00007| //! the page's file name bound to the catalog's, and the catalog's language
   00008| //! rows take it from there. The browser twins are in
   00009| //! `rust/tests/web/issue-1165-documented-commands.test.mjs`.
   00010| 
   00011| use formal_ai::discovery_production::{
   00012|     SourcedCommand, command_procedures, documented_language_commands, documented_pairs,
   00013|     documented_run_commands,
   00014| };
   00015| 
   00016| const RUST_BOOK: &str = "https://doc.rust-lang.org/book/ch01-02-hello-world.html";
   00017| const TS_HANDBOOK: &str = "https://raw.githubusercontent.com/microsoft/TypeScript-Website/v2/packages/documentation/copy/en/handbook-v2/Basics.md";
   00018| const ORACLE: &str = "https://docs.oracle.com/javase/tutorial/getStarted/cupojava/unix.html";
   00019| const KOTLINLANG: &str = "https://kotlinlang.org/docs/command-line.html";
   00020| 
   00021| /// Every command the procedure rows derive, as
   00022| /// `(language, save_as, role, command, page)`.
   00023| const DERIVED: [(&str, &str, &str, &str, &str); 6] = [
   00024|     ("rust", "main.rs", "run", "./main", RUST_BOOK),
   00025|     (
   00026|         "typescript",
   00027|         "hello.ts",
   00028|         "check",
   00029|         "tsc hello.ts",
   00030|         TS_HANDBOOK,
   00031|     ),
   00032|     ("java", "Main.java", "check", "javac Main.java", ORACLE),
   00033|     ("java", "Main.java", "run", "java Main", ORACLE),
   00034|     (
   00035|         "kotlin",
   00036|         "Main.kt",
   00037|         "check",
   00038|         "kotlinc Main.kt -include-runtime -d Main.jar",
   00039|         KOTLINLANG,
   00040|     ),
   00041|     ("kotlin", "Main.kt", "run", "java -jar Main.jar", KOTLINLANG),
   00042| ];
   00043| 
   00044| /// The catalog's language table, read as source text.
   00045| const LANGUAGES_SOURCE: &str = include_str!("../../src/coding/catalog/languages.rs");
   00046| 
   00047| /// R1165-6: each `command_procedure` row derives the catalog command from
   00048| /// its captured page, the page's file name bound to the catalog's
   00049| /// (kotlinlang's `hello.kt` and Oracle's `HelloWorldApp` become `Main`).
   00050| #[test]
   00051| fn each_command_procedure_row_derives_the_catalog_command_from_its_page() {
   00052|     for (language, save_as) in [
   00053|         ("rust", "main.rs"),
   00054|         ("typescript", "hello.ts"),
   00055|         ("java", "Main.java"),
   00056|         ("kotlin", "Main.kt"),
   00057|     ] {
   00058|         let expected: Vec<SourcedCommand> = DERIVED
   00059|             .iter()
   00060|             .filter(|row| row.0 == language)
   00061|             .map(|&(_, _, role, command, page)| SourcedCommand {
   00062|                 role,
   00063|                 command: command.to_owned(),
   00064|                 source: page.to_owned(),
   00065|             })
   00066|             .collect();
   00067|         assert_eq!(
   00068|             documented_language_commands(language, save_as),
   00069|             expected,
   00070|             "{language}"
   00071|         );
   00072|     }
   00073|     assert!(documented_language_commands("go", "main.go").is_empty());
   00074| }
