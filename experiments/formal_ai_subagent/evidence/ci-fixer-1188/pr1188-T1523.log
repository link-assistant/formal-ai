   00096|     assert_eq!(recipe.path, "Main.kt");
   00097|     assert_eq!(
   00098|         recipe.commands,
   00099|         [
   00100|             "kotlinc Main.kt -include-runtime -d Main.jar",
   00101|             "java -jar Main.jar"
