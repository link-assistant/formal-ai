   00118| /// R1165-6: every command a captured page states is derived by a
   00119| /// `command_procedure` row, and the language table states none of them.
   00120| #[test]
   00121| fn no_language_row_hard_codes_a_command_a_captured_page_states() {
   00122|     let procedures: Vec<(String, String)> = command_procedures()
   00123|         .into_iter()
   00124|         .map(|row| (row.language, row.role))
   00125|         .collect();
   00126|     assert_eq!(
   00127|         procedures,
   00128|         DERIVED
   00129|             .iter()
   00130|             .map(|row| (row.0.to_owned(), row.2.to_owned()))
   00131|             .collect::<Vec<_>>()
   00132|     );
   00133|     let mut stated = 0;
   00134|     for (task, language) in documented_pairs() {
   00135|         let commands = documented_run_commands(&language, &task);
   00136|         let last = commands.len().saturating_sub(1);
   00137|         for (index, command) in commands.iter().enumerate() {
   00138|             if command.documented.is_none() {
   00139|                 continue;
   00140|             }
   00141|             stated += 1;
   00142|             let role = if index == last { "run" } else { "check" };
   00143|             assert!(
   00144|                 procedures.contains(&(language.clone(), role.to_owned())),
   00145|                 "{language} {role}: its page states it, so a command_procedure row must derive it"
   00146|             );
   00147|         }
   00148|     }
   00149|     assert!(stated >= DERIVED.len());
   00150|     for (language, _, _, command, _) in DERIVED {
   00151|         assert!(
   00152|             !row_text(language).contains(&format!("\"{command}\"")),
   00153|             "the {language} row still states \"{command}\""
   00154|         );
   00155|     }
   00156| }
