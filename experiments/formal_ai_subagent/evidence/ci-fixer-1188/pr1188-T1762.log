   00201| /// Separate declared options from shell words while preserving operand quoting.
   00202| fn effect_operands<'a>(
   00203|     text: &'a str,
   00204|     effect: &seed::ShellIntentEffect,
   00205| ) -> Option<(Vec<&'a str>, Vec<String>)> {
   00206|     let words = shell_words(text)?;
   00207|     let mut operands = Vec::new();
   00208|     let mut flags = Vec::new();
   00209|     let mut options = true;
   00210|     let mut index = 0;
   00211|     while index < words.len() {
   00212|         let raw = words[index];
   00213|         let word = raw.trim_matches(['\'', '"']);
   00214|         if options && word == "--" {
   00215|             options = false;
   00216|         } else if options && word.starts_with('-') && word != "-" {
   00217|             if let Some(option) = effect.value_options.iter().find(|option| {
   00218|                 word == option.as_str()
   00219|                     || word.strip_prefix(option.as_str()).is_some_and(|suffix| {
   00220|                         suffix.starts_with('=') || (!option.starts_with("--") && !suffix.is_empty())
   00221|                     })
   00222|             }) {
   00223|                 if word == option.as_str() {
   00224|                     index += 1;
   00225|                     if index >= words.len() {
   00226|                         return None;
   00227|                     }
   00228|                 }
   00229|                 flags.push(option.clone());
   00230|             } else if effect.flags.iter().any(|flag| flag == word) {
   00231|                 flags.push(word.to_owned());
   00232|             } else if !word.starts_with("--") {
   00233|                 let bundled: Vec<String> = word[1..]
   00234|                     .chars()
   00235|                     .map(|letter| format!("-{letter}"))
   00236|                     .collect();
   00237|                 if !bundled.iter().all(|flag| effect.flags.contains(flag)) {
   00238|                     return None;
   00239|                 }
   00240|                 flags.extend(bundled);
   00241|             } else {
   00242|                 return None;
   00243|             }
   00244|         } else {
   00245|             operands.push(raw);
   00246|         }
   00247|         index += 1;
   00248|     }
   00249|     Some((operands, flags))
   00250| }
