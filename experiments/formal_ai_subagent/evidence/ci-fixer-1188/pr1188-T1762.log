   00324| /// The directory component of `path`, or `.` when it names no directory.
   00325| ///
   00326| /// Written as text rather than through [`std::path::Path`] on purpose: the
   00327| /// operand is a shell word that may still be rooted at `~`, and `Path` would
   00328| /// happily hand back a `~` that the shell then declines to expand once it is no
   00329| /// longer the first character of the word.
   00330| fn parent_of(path: &str) -> String {
   00331|     if path.contains(['"', '\'', '\\']) {
   00332|         return format!("\"$(dirname -- {path})\"");
   00333|     }
   00334|     match path.rsplit_once('/') {
   00335|         Some(("", _)) => String::from("/"),
   00336|         Some((parent, _)) => parent.to_owned(),
   00337|         None => String::from(CURRENT_DIRECTORY),
   00338|     }
   00339| }
