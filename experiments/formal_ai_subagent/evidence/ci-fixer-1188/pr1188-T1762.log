   00252| fn shell_words(text: &str) -> Option<Vec<&str>> {
   00253|     let mut words = Vec::new();
   00254|     let mut start = None;
   00255|     let mut quote = None;
   00256|     let mut escaped = false;
   00257|     for (index, character) in text.char_indices() {
   00258|         if start.is_none() && character.is_whitespace() {
   00259|             continue;
   00260|         }
   00261|         if start.is_none() {
   00262|             start = Some(index);
   00263|         }
   00264|         if escaped {
   00265|             escaped = false;
   00266|             continue;
   00267|         }
   00268|         if character == '\\' && quote != Some('\'') {
   00269|             escaped = true;
   00270|             continue;
   00271|         }
   00272|         if let Some(delimiter) = quote {
   00273|             if character == delimiter {
   00274|                 quote = None;
   00275|             }
   00276|             continue;
   00277|         }
   00278|         if character == '"' || character == '\'' {
   00279|             quote = Some(character);
   00280|             continue;
   00281|         }
   00282|         if character.is_whitespace() {
   00283|             words.push(&text[start.take()?..index]);
   00284|         } else if ";|&<>()`".contains(character) {
   00285|             return None;
   00286|         }
   00287|     }
   00288|     if quote.is_some() || escaped {
   00289|         return None;
   00290|     }
   00291|     if let Some(start) = start {
   00292|         words.push(&text[start..]);
   00293|     }
   00294|     Some(words)
   00295| }
