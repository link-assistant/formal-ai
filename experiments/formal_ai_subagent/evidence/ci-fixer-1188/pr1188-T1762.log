   00137|             && (sources.len() > 1
   00138|                 || sources.iter().any(|source| has_shell_expansion(source))
   00139|                 || destination.trim_matches(['\'', '"']).ends_with('/'))
   00140|         {
   00141|             collection = Some((sources.join(" "), destination));
