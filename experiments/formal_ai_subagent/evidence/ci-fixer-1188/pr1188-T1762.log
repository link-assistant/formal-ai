   00297| fn has_shell_expansion(word: &str) -> bool {
   00298|     let mut quote = None;
   00299|     let mut escaped = false;
   00300|     for character in word.chars() {
   00301|         if escaped {
   00302|             escaped = false;
   00303|             continue;
   00304|         }
   00305|         if character == '\\' && quote != Some('\'') {
   00306|             escaped = true;
   00307|             continue;
   00308|         }
   00309|         if let Some(delimiter) = quote {
   00310|             if character == delimiter {
   00311|                 quote = None;
   00312|             }
   00313|             continue;
   00314|         }
   00315|         if character == '"' || character == '\'' {
   00316|             quote = Some(character);
   00317|         } else if "*?[$".contains(character) {
   00318|             return true;
   00319|         }
   00320|     }
   00321|     false
   00322| }
