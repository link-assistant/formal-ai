   00341| /// Plan the next step of the verified recipe for `command`.
   00342| ///
   00343| /// Returns `None` when the command declares no effect (every read-only intent),
   00344| /// or when the client advertised no shell tool — in which case the caller's
   00345| /// single-shot path still produces the honest "I can run this when you give me a
   00346| /// shell" answer rather than this module inventing a second one.
   00347| pub(super) fn plan_step(
   00348|     command: &str,
   00349|     messages: &[ChatMessage],
   00350|     tool_names: &[&str],
   00351|     prompt: &str,
   00352| ) -> Option<AgenticPlan> {
   00353|     let recipe = expand(command)?;
   00354|     let tool = tool_for(tool_names, Capability::Run)?;
   00355|     let progress = Progress::scan(messages);
   00356|     let taken = progress.run_outputs.len();
   00357| 
   00358|     // The workspace gets the last word before anything else is planned: a step
   00359|     // that exited non-zero ends the recipe where it stopped.
   00360|     if let Some(index) = taken.checked_sub(1) {
   00361|         let observed = &progress.run_outputs[index];
   00362|         if tool_result::step_outcome(observed) == tool_result::StepOutcome::Failed {
   00363|             return Some(AgenticPlan::Final(blocked_report(
   00364|                 &recipe,
   00365|                 recipe.steps().get(index).map_or(command, String::as_str),
   00366|                 observed,
   00367|                 prompt,
   00368|                 index >= recipe.action,
   00369|             )));
   00370|         }
   00371|     }
   00372|     if let Some(step) = recipe.steps().get(taken) {
   00373|         return Some(plan_one(tool, json!({ "command": step }).to_string()));
   00374|     }
   00375|     Some(AgenticPlan::Final(completed_report(&recipe, prompt)))
   00376| }
   00377| 
   00378| /// The report for a recipe that stopped: which check stopped it, with what
   00379| /// status, and the fact that the action did not run.
   00380| ///
   00381| /// A blocked move is not a failed move, and saying so is the point. Issue #824
   00382| /// is the record of what over-refusal costs and issue #916 rung `R916-01` is the
   00383| /// record of what a false completion claim costs; a recipe that names the check
   00384| /// it stopped on avoids both.
   00385| fn blocked_report(
   00386|     recipe: &VerifiedAction,
   00387|     check: &str,
   00388|     observed: &str,
   00389|     prompt: &str,
   00390|     attempted: bool,
   00391| ) -> String {
   00392|     let language = tool_result::response_language(prompt);
   00393|     let intent = if attempted {
   00394|         "mutating-action-observed-failure"
   00395|     } else {
   00396|         "mutating_action_blocked"
   00397|     };
   00398|     let Some(mut answer) = seed::localized_response(intent, language) else {
   00399|         return tool_result::render(check, observed, prompt);
   00400|     };
   00401|     answer = answer.replace(ACTION_PLACEHOLDER, recipe.action());
   00402|     answer = answer.replace(CHECK_PLACEHOLDER, check);
   00403|     answer = answer.replace(
   00404|         EXIT_CODE_PLACEHOLDER,
   00405|         &tool_result::reported_exit_code(observed)
   00406|             .map_or_else(String::new, |code| code.to_string()),
   00407|     );
   00408|     answer
   00409| }
   00410| 
   00411| /// The report for a recipe that finished: the action that ran, and the checks
   00412| /// that were observed to hold afterwards.
   00413| ///
   00414| /// The claim rests on those checks and names them, because a claim the reader
   00415| /// cannot re-run is the narration issue #916 rung `R916-01` was written against.
   00416| fn completed_report(recipe: &VerifiedAction, prompt: &str) -> String {
   00417|     let language = tool_result::response_language(prompt);
   00418|     let checks = recipe
   00419|         .postconditions()
   00420|         .iter()
   00421|         .map(|check| format!("`{check}`"))
   00422|         .collect::<Vec<_>>()
   00423|         .join(", ");
   00424|     seed::localized_response("mutating_action_completed", language).map_or_else(
   00425|         || recipe.action().to_owned(),
   00426|         |answer| {
   00427|             answer
   00428|                 .replace(ACTION_PLACEHOLDER, recipe.action())
   00429|                 .replace(CHECKS_PLACEHOLDER, &checks)
   00430|         },
   00431|     )
   00432| }
   00433| 
   00434| /// The ordered steps `command` is carried out as.
   00435| ///
   00436| /// `None` when no seed intent declares an effect for it — every read-only
   00437| /// intent, and every mutating one whose operands are not the source/destination
   00438| /// pair the effect is written against.
   00439| ///
   00440| /// Read-only intents keep their single-shot path, which is why this is the same
   00441| /// question the planner asks: a caller that wants to know whether a command is
   00442| /// carried out as a recipe asks for the recipe.
   00443| #[must_use]
   00444| pub fn verified_recipe(command: &str) -> Option<Vec<String>> {
   00445|     expand(command).map(|recipe| recipe.steps)
   00446| }
