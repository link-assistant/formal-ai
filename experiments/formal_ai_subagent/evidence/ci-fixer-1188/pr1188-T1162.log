   00224|     if let Some((target, _)) = super::workspace_line_operation::named_target_and_payloads(task)
   00225|         && !targets.contains(&target)
   00226|     {
   00227|         targets.push(target);
   00228|     }
   00229|     targets.iter().any(|target| {
   00230|         [
