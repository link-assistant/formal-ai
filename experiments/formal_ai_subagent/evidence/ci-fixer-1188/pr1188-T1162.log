   00719| // This is a seed-template placeholder, not a Rust formatting argument.
   00720| #[allow(clippy::literal_string_with_formatting_args)]
   00721| fn composite_module_change(task: &str) -> Option<CompositeModuleChange> {
   00722|     let lowered = task.to_lowercase();
   00723|     if !seed::lexicon().mentions_role(seed::ROLE_CODING_MODULE_REGISTRATION_ACTION, &lowered) {
   00724|         return None;
   00725|     }
   00726|     let generated = rust_source_for_task(task)?;
   00727|     let registration_path = rust_paths(task)
   00728|         .into_iter()
   00729|         .find(|path| path != &generated.path)?;
   00730|     let module = generated.path.rsplit('/').next()?.strip_suffix(".rs")?;
   00731|     if !valid_identifier(module) {
   00732|         return None;
   00733|     }
   00734|     let registration =
   00735|         render_rust_template("coding_source_module_registration", &[("{module}", module)])?;
   00736|     Some(CompositeModuleChange {
   00737|         source_path: generated.path,
   00738|         source: generated.content,
   00739|         registration_path,
   00740|         registration,
   00741|     })
   00742| }
