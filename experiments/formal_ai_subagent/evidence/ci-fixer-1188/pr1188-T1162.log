   00055| /// The template slots the seed sentences that state a rewrite fill.
   00056| const OLD_SLOT: &str = concat!("{", "old", "}");
   00057| const NEW_SLOT: &str = concat!("{", "new", "}");
   00058| const ANCHOR_SLOT: &str = concat!("{", "anchor", "}");
   00059| 
   00060| impl GroundedRewrite {
   00061|     /// The intent whose seed sentence states this change rather than merely
   00062|     /// reporting that the file was touched.
   00063|     const fn stated_intent(&self) -> &'static str {
   00064|         match self.stated {
   00065|             Some((intent, _)) => intent,
   00066|             None if self.renaming => "coding_identifier_renamed",
   00067|             None => "coding_text_replaced",
   00068|         }
   00069|     }
   00070| 
   00071|     /// The operands the seed sentence names, as template slots.
   00072|     fn stated_slots(&self) -> Vec<(&str, &str)> {
   00073|         match &self.stated {
   00074|             Some((_, slots)) => slots
   00075|                 .iter()
   00076|                 .map(|(slot, value)| (*slot, value.as_str()))
   00077|                 .collect(),
   00078|             None => vec![
   00079|                 (OLD_SLOT, self.pattern.as_str()),
   00080|                 (NEW_SLOT, self.replacement.as_str()),
   00081|             ],
   00082|         }
   00083|     }
   00084| }
