   00900|         argument_matches_path(&value, path)
   00901|             && argument_matches(&value, &["oldString", "old_string", "old_str", "old"], old)
   00902|             && argument_matches(&value, &["newString", "new_string", "new_str", "new"], new)
   00903|     })
   00904| }
   00905| 
   00906| fn argument_matches_path(value: &Value, expected: &str) -> bool {
   00907|     ["path", "filePath", "file_path"].iter().any(|key| {
   00908|         value
   00909|             .get(key)
   00910|             .and_then(Value::as_str)
   00911|             .is_some_and(|observed| workspace_path_matches(expected, observed))
   00912|     })
   00913| }
   00914| 
   00915| fn argument_matches(value: &Value, keys: &[&str], expected: &str) -> bool {
   00916|     keys.iter()
   00917|         .any(|key| value.get(key).and_then(Value::as_str) == Some(expected))
   00918| }
   00919| 
   00920| fn workspace_path_matches(expected: &str, observed: &str) -> bool {
   00921|     if observed == expected {
   00922|         return true;
   00923|     }
   00924|     let expected = Path::new(expected);
   00925|     let observed = Path::new(observed);
   00926|     expected.is_relative() && observed.is_absolute() && observed.ends_with(expected)
   00927| }
