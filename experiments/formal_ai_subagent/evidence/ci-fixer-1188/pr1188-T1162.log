   00112|     // so the read and write evidence gathered for it must survive the ping
   00113|     // (issue #1138): slicing at the last user message -- the cue itself --
   00114|     // restarted the read--write pair on every ping.
   00115|     let current_turn = &messages[super::planner::evidence_window_start(messages)..];
   00116|     // `Append the contents of a.txt to b.txt`: the source is read, and the
   00117|     // request is restated with its lines as the block placed (PR #1188 G50).
   00118|     let sourced = match sourced_request(task, current_turn) {
   00119|         Some(Sourced::Read(path)) => {
   00120|             let tool = tool_for(tool_names, Capability::Read)?;
   00121|             return Some(plan_one(tool, read_arguments(&path)));
   00122|         }
   00123|         Some(Sourced::Task(sourced)) => Some(sourced),
   00124|         None => None,
   00125|     };
   00126|     let task = sourced.as_deref().unwrap_or(task);
   00127| 
   00128|     if let Some(change) = composite_module_change(task) {
   00129|         return plan_composite_step(task, current_turn, tool_names, &change);
   00130|     }
   00131|     // Numbered lines moved to another file: placed there, then removed (G85).
   00132|     if let Some(order) = super::line_range_move::line_range_move(task) {
   00133|         return super::line_range_move::plan_line_range_move_step(
   00134|             task,
   00135|             current_turn,
   00136|             tool_names,
   00137|             &order,
   00138|         );
   00139|     }
   00140|     if let Some(change) = super::workspace_computed_change::grounded_line_change(task) {
   00141|         return super::workspace_computed_change::plan_computed_change_step(
   00142|             task,
   00143|             current_turn,
   00144|             tool_names,
   00145|             &change,
   00146|         );
   00147|     }
   00148|     if let Some(inserts) = insert_sequence(task) {
   00149|         return super::positional_edit::plan_insert_sequence_step(
   00150|             task,
   00151|             current_turn,
   00152|             tool_names,
   00153|             &inserts,
   00154|         );
   00155|     }
   00156|     // Several replacements asked in one sentence are made in order (G82).
   00157|     if let Some(change) = super::workspace_computed_change::grounded_replace_list(task) {
   00158|         return super::workspace_computed_change::plan_computed_change_step(
   00159|             task,
   00160|             current_turn,
   00161|             tool_names,
   00162|             &change,
   00163|         );
   00164|     }
