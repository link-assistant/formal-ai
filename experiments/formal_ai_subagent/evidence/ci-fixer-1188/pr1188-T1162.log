   00861| pub(super) fn result_for_path(
   00862|     messages: &[ChatMessage],
   00863|     capability: Capability,
   00864|     path: &str,
   00865|     expected_content: Option<&str>,
   00866| ) -> Option<String> {
   00867|     matching_result(messages, |name, arguments| {
   00868|         if tool_capability(name) != Some(capability) {
   00869|             return false;
   00870|         }
   00871|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
   00872|             return false;
   00873|         };
   00874|         let matches_path = ["path", "filePath", "file_path"].iter().any(|key| {
   00875|             value
   00876|                 .get(key)
   00877|                 .and_then(Value::as_str)
   00878|                 .is_some_and(|observed| workspace_path_matches(path, observed))
   00879|         });
   00880|         matches_path
   00881|             && expected_content.is_none_or(|expected| {
   00882|                 value.get("content").and_then(Value::as_str) == Some(expected)
   00883|             })
   00884|     })
   00885| }
