   00300|                 task,
   00301|                 current_turn,
   00302|                 tool_names,
   00303|                 &VerifiedChange {
   00304|                     target: &rewrite.target,
   00305|                     expected: &updated,
   00306|                     intent: rewrite.stated_intent(),
   00307|                     slots: &rewrite.stated_slots(),
   00308|                 },
   00309|             );
   00310|         }
   00311|     } else if tool_for(tool_names, Capability::Edit).is_some()
   00312|         && let Some(command) = repeated_identifier_rewrite_command(rewrite)
   00313|         && let Some(tool) = tool_for(tool_names, Capability::Run)
   00314|     {
   00315|         if result_for_command(current_turn, &command).is_none() {
   00316|             return Some(plan_one(tool, json!({"command": command}).to_string()));
