   00936| pub(super) fn plan_digest_verification(
   00937|     task: &str,
   00938|     current_turn: &[ChatMessage],
   00939|     tool_names: &[&str],
   00940|     change: &VerifiedChange<'_>,
   00941| ) -> Option<AgenticPlan> {
   00942|     let command = ["sha256sum -- ", change.target].concat();
   00943|     let Some(observed) = result_for_command(current_turn, &command) else {
   00944|         let tool = tool_for(tool_names, Capability::Run)?;
   00945|         return Some(plan_one(tool, json!({"command": command}).to_string()));
   00946|     };
   00947|     let digest = crate::source_fetch::sha256_hex(change.expected.as_bytes());
   00948|     if observed.split_whitespace().next() != Some(digest.as_str()) {
   00949|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00950|             "coding_workspace_verification_failed",
   00951|             task,
   00952|             change.target,
   00953|         )?));
   00954|     }
   00955|     Some(AgenticPlan::Final(render_seeded_change(
   00956|         change.intent,
   00957|         task,
   00958|         change.target,
   00959|         change.slots,
   00960|     )?))
   00961| }
