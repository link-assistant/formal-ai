   00887| pub(super) fn result_for_edit(
   00888|     messages: &[ChatMessage],
   00889|     path: &str,
   00890|     old: &str,
   00891|     new: &str,
   00892| ) -> Option<String> {
   00893|     matching_result(messages, |name, arguments| {
   00894|         if tool_capability(name) != Some(Capability::Edit) {
   00895|             return false;
   00896|         }
   00897|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
   00898|             return false;
