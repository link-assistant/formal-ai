   00837| fn rust_paths(task: &str) -> Vec<String> {
   00838|     let mut paths = Vec::new();
   00839|     for (suffix, _) in task.match_indices(".rs") {
   00840|         let end = suffix + 3;
   00841|         let start = task[..end]
   00842|             .char_indices()
   00843|             .rev()
   00844|             .take_while(|(_, character)| {
   00845|                 character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00846|             })
   00847|             .last()
   00848|             .map_or(0, |(index, _)| index);
   00849|         let path = &task[start..end];
   00850|         if !path.is_empty()
   00851|             && !path.starts_with('/')
   00852|             && !path.split('/').any(|component| component == "..")
   00853|             && !paths.iter().any(|existing| existing == path)
   00854|         {
   00855|             paths.push(path.to_owned());
   00856|         }
   00857|     }
   00858|     paths
   00859| }
