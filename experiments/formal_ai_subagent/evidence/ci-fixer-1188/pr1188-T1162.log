   00166|         return plan_rewrite_step(task, current_turn, tool_names, &rewrite);
   00167|     }
   00168|     let change = super::workspace_computed_change::grounded_computed_change(task)?;
   00169|     super::workspace_computed_change::plan_computed_change_step(
   00170|         task,
   00171|         current_turn,
   00172|         tool_names,
   00173|         &change,
   00174|     )
   00175| }
