   00963| fn matching_result(
   00964|     messages: &[ChatMessage],
   00965|     matches: impl Fn(&str, &str) -> bool,
   00966| ) -> Option<String> {
   00967|     messages
   00968|         .iter()
   00969|         .enumerate()
   00970|         .rev()
   00971|         .find_map(|(index, message)| {
   00972|             if !message.role.eq_ignore_ascii_case("tool") {
   00973|                 return None;
   00974|             }
   00975|             let id = message.tool_call_id.as_deref()?;
   00976|             let call = messages[..index]
   00977|                 .iter()
   00978|                 .rev()
   00979|                 .flat_map(|prior| prior.tool_calls.iter().rev())
   00980|                 .find(|call| call.id == id)?;
   00981|             matches(&call.function.name, &call.function.arguments)
   00982|                 .then(|| message.content.plain_text())
   00983|         })
   00984| }
