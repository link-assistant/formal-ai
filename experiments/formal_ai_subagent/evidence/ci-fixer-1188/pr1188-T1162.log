   00744| fn insert_registration(source: &str, registration: &str) -> String {
   00745|     if source
   00746|         .lines()
   00747|         .any(|line| line.trim() == registration.trim())
   00748|     {
   00749|         return source.to_owned();
   00750|     }
   00751|     let mut updated = source.to_owned();
   00752|     if !updated.is_empty() && !updated.ends_with('\n') {
   00753|         updated.push('\n');
   00754|     }
   00755|     updated.push_str(registration);
   00756|     updated
   00757| }
   00758| 
   00759| fn compact_registration_edit(source: &str, registration: &str) -> Option<(String, String)> {
   00760|     const MAX_SUFFIX_BYTES: usize = 4096;
   00761|     let mut starts = source
   00762|         .match_indices('\n')
   00763|         .map(|(index, _)| index + 1)
   00764|         .filter(|start| *start < source.len())
   00765|         .collect::<Vec<_>>();
   00766|     starts.insert(0, 0);
   00767|     for start in starts.into_iter().rev() {
   00768|         let suffix = &source[start..];
   00769|         if suffix.len() > MAX_SUFFIX_BYTES {
   00770|             break;
   00771|         }
   00772|         if source.match_indices(suffix).count() != 1 {
   00773|             continue;
   00774|         }
   00775|         let mut replacement = suffix.to_owned();
   00776|         if !replacement.ends_with('\n') {
   00777|             replacement.push('\n');
   00778|         }
   00779|         replacement.push_str(registration);
   00780|         return Some((suffix.to_owned(), replacement));
   00781|     }
   00782|     None
   00783| }
