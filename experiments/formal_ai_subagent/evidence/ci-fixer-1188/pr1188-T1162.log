   00481| /// The file after `rewrite`, or `None` when it cannot apply. A positional
   00482| /// insertion replaces its one anchor occurrence; an anchor found zero or
   00483| /// several times does not say where the line goes.
   00484| /// The rewrite as the request wrote it, when the file holds no unescaped
   00485| /// pattern but holds the pattern as written (source code quoting `'\n'`,
   00486| /// PR #1188 G65).
   00487| fn as_written(source: &str, rewrite: &GroundedRewrite) -> Option<GroundedRewrite> {
   00488|     let (pattern, replacement) = rewrite.verbatim.clone()?;
   00489|     if (rewrite.pattern != pattern && source.contains(&rewrite.pattern))
   00490|         || !source.contains(&pattern)
   00491|     {
   00492|         return None;
   00493|     }
   00494|     Some(GroundedRewrite {
   00495|         pattern,
   00496|         replacement,
   00497|         verbatim: None,
   00498|         ..rewrite.clone()
   00499|     })
   00500| }
   00501| 
   00502| fn rewritten_source(source: &str, rewrite: &GroundedRewrite) -> Option<String> {
   00503|     if rewrite.single_pass {
   00504|         return source
   00505|             .contains(rewrite.pattern.as_str())
   00506|             .then(|| source.replace(rewrite.pattern.as_str(), &rewrite.replacement));
   00507|     }
   00508|     if rewrite.unique {
   00509|         let (start, old, new) = anchored_lines(source, rewrite)?;
   00510|         return Some([&source[..start], new.as_str(), &source[start + old.len()..]].concat());
   00511|     }
   00512|     execute_scoped_workspace_rewrite(
   00513|         source,
   00514|         &rewrite.pattern,
   00515|         &rewrite.replacement,
   00516|         rewrite.scope,
   00517|     )
   00518|     .ok()
   00519|     .map(|execution| execution.output)
   00520| }
   00521| 
   00522| /// A positional insertion's one anchor occurrence widened to the whole lines
   00523| /// it sits on, as `(start, old_lines, new_lines)`, or `None` unless the anchor
   00524| /// occurs exactly once. The inserted text is a line, so an anchor that is only
   00525| /// part of a line (`after the line containing '| T20 |'`) must not split it.
   00526| fn anchored_lines(source: &str, rewrite: &GroundedRewrite) -> Option<(usize, String, String)> {
   00527|     let (pattern, replacement) = (rewrite.pattern.as_str(), rewrite.replacement.as_str());
   00528|     let mut found = source.match_indices(pattern).map(|(at, _)| at);
   00529|     let (Some(at), None) = (found.next(), found.next()) else {
   00530|         return None;
   00531|     };
   00532|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00533|     let tail = at + pattern.len();
   00534|     let end = if pattern.ends_with('\n') {
   00535|         tail - 1
   00536|     } else {
   00537|         source[tail..]
   00538|             .find('\n')
   00539|             .map_or(source.len(), |newline| tail + newline)
   00540|     };
   00541|     let old = &source[start..end];
   00542|     let new = replacement.strip_prefix(pattern).map_or_else(
   00543|         || [&replacement[..replacement.len() - pattern.len()], old].concat(),
   00544|         |rest| [old, rest].concat(),
   00545|     );
   00546|     Some((start, old.to_owned(), new))
   00547| }
   00548| 
   00549| /// The smallest run of whole lines holding every change from `source` to
   00550| /// `updated`, as an edit pair, when that run occurs once in `source`.
   00551| pub(super) fn changed_lines_edit(source: &str, updated: &str) -> Option<(String, String)> {
   00552|     const MAX_EDIT_BYTES: usize = 4096;
   00553|     let prefix = source
   00554|         .bytes()
   00555|         .zip(updated.bytes())
   00556|         .take_while(|(left, right)| left == right)
   00557|         .count();
   00558|     let limit = source.len().min(updated.len()) - prefix;
   00559|     let suffix = source
   00560|         .bytes()
   00561|         .rev()
   00562|         .zip(updated.bytes().rev())
   00563|         .take(limit)
   00564|         .take_while(|(left, right)| left == right)
   00565|         .count();
   00566|     // Byte positions only meet `\n`, so `start` and `end` fall on line -- and
   00567|     // therefore character -- boundaries even when the first or last differing
   00568|     // byte sits inside a multi-byte character.
   00569|     let bytes = source.as_bytes();
   00570|     let line_start = |before: usize| {
   00571|         bytes[..before]
   00572|             .iter()
   00573|             .rposition(|byte| *byte == b'\n')
   00574|             .map_or(0, |at| at + 1)
   00575|     };
   00576|     let mut start = line_start(prefix);
   00577|     let end = bytes[source.len() - suffix..]
   00578|         .iter()
   00579|         .position(|byte| *byte == b'\n')
   00580|         .map_or(source.len(), |at| source.len() - suffix + at);
   00581|     // Lines inserted between two lines change none: the line above carries
   00582|     // them.
   00583|     if start == end && start > 0 {
   00584|         start = line_start(start - 1);
   00585|     }
   00586|     let old = &source[start..end];
   00587|     let new = &updated[start..updated.len() - (source.len() - end)];
   00588|     (!old.is_empty() && old.len() <= MAX_EDIT_BYTES && source.matches(old).count() == 1)
   00589|         .then(|| (old.to_owned(), new.to_owned()))
   00590| }
   00591| 
   00592| /// `Insert 'x' after the line 'y' in f`: the anchor line, replaced once by the
   00593| /// anchor beside the new line, stated by the position meaning that placed it.
   00594| fn grounded_positional_insert(task: &str) -> Option<GroundedRewrite> {
   00595|     let (target, anchor, replacement) = super::positional_edit::compose_positional_insert(task)?;
   00596|     let after_anchor = [anchor.as_str(), "\n"].concat();
   00597|     let (after, inserted) = if let Some(inserted) = replacement.strip_prefix(&after_anchor) {
   00598|         (true, inserted.to_owned())
   00599|     } else {
   00600|         let before_anchor = ["\n", anchor.as_str()].concat();
   00601|         (false, replacement.strip_suffix(&before_anchor)?.to_owned())
   00602|     };
   00603|     let intent = super::positional_edit::insert_intent(after, &inserted);
   00604|     Some(GroundedRewrite {
   00605|         target,
   00606|         stated: Some((
   00607|             intent,
   00608|             vec![(NEW_SLOT, inserted), (ANCHOR_SLOT, anchor.clone())],
   00609|         )),
   00610|         pattern: anchor,
   00611|         replacement,
   00612|         scope: RewriteScope::Substring,
   00613|         renaming: false,
   00614|         unique: true,
   00615|         single_pass: false,
   00616|         verbatim: None,
   00617|     })
   00618| }
   00619| 
   00620| /// Every insert the request asks for, each its own anchored edit.
   00621| ///
   00622| /// Several clauses (`…, and insert …`), an anchor named by the line it
   00623| /// follows (T31, T34), lines rebased on the anchor (G16), or one insert whose
   00624| /// anchor is a whole line also found inside others (`the line 'b'`).
   00625| fn insert_sequence(task: &str) -> Option<Vec<PositionalInsert>> {
   00626|     super::positional_edit::positional_inserts(task)
   00627| }
   00628| 
   00629| fn grounded_rewrite(task: &str) -> Option<GroundedRewrite> {
   00630|     if let Some(positional) = grounded_positional_insert(task) {
   00631|         return Some(positional);
   00632|     }
   00633|     let (target, old_clause, new_clause) = compose_edit_request(task)?;
   00634|     let renaming = seed::lexicon().mentions_role(
   00635|         seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00636|         &task.to_lowercase(),
   00637|     );
   00638|     // A request that names a line replaces whole lines
   00639|     // (`grounded_line_replacement`).
   00640|     if !renaming && super::workspace_computed_change::names_line(task) {
   00641|         return None;
   00642|     }
   00643|     // Both operands have to be literals the request actually quoted, so prose
   00644|     // ("replace the old header with something clearer") is never rewritten as
   00645|     // bytes. What that cannot be is a count: requiring the request to hold
   00646|     // *exactly* two quoted segments made every other pair of delimiters in the
   00647|     // prompt disqualify the edit, and this repository's own prose backticks the
   00648|     // file it names. The issue #1028 ladder node "In the file
   00649|     // `src/protocol_memory.rs`, replace \"request_history\" with
   00650|     // \"conversation_history\"" quotes three things and states one replacement.
   00651|     // Asking whether each clause *is* quoted keeps the guarantee and drops the
   00652|     // arithmetic.
   00653|     // The edit request unescapes `\n` / `\t` in its literals, so the quoted
   00654|     // segments are compared unescaped too: a multi-line replacement written
   00655|     // with `\n` was otherwise not "quoted", and the general fallback wrote its
   00656|     // new text over the whole file (PR #1188 sub-agent gap 3).
   00657|     let quoted: Vec<String> = quoted_segments(task)
   00658|         .iter()
   00659|         .map(String::as_str)
   00660|         .map(super::positional_edit::unescape_prose_newlines)
   00661|         .collect();
   00662|     // A literal quoted whole counts even when backtick spans inside it pair
   00663|     // among themselves (PR #1188 G63).
   00664|     let is_quoted =
   00665|         |value: &String| quoted.contains(value) || crate::normal_markov::quotes_whole(task, value);
   00666|     let operands = if is_quoted(&old_clause) && is_quoted(&new_clause) {
   00667|         Some((old_clause, new_clause))
   00668|     } else if renaming {
   00669|         Some((
   00670|             identifier_tokens(&old_clause).next_back()?.to_owned(),
   00671|             identifier_tokens(&new_clause).next()?.to_owned(),
   00672|         ))
   00673|     } else {
   00674|         None
   00675|     }?;
   00676|     let (old, new) = operands;
   00677|     let as_quoted = |text: &str| {
   00678|         quoted_segments(task)
   00679|             .into_iter()
   00680|             .find(|raw| raw != text && super::positional_edit::unescape_prose_newlines(raw) == text)
   00681|             .unwrap_or_else(|| text.to_owned())
   00682|     };
   00683|     let verbatim = (as_quoted(&old) != old || as_quoted(&new) != new)
   00684|         .then(|| (as_quoted(&old), as_quoted(&new)));
   00685|     // A rename names a *word*, so the edit is word-scoped whichever way the
   00686|     // request spelled its operands. Without that scope the most ordinary rename
   00687|     // there is -- giving a name a prefix or a suffix -- has to be refused, since
   00688|     // an unanchored substring rewrite that reintroduces its own pattern never
   00689|     // terminates.
   00690|     //
   00691|     // A word replaced by a longer word that contains it (`smal` → `small`, a
   00692|     // typo fix) is only safe word by word for the same reason.
   00693|     let words = is_identifier_word(&old) && is_identifier_word(&new);
   00694|     let scope = if words && (renaming || new.contains(&old)) {
   00695|         RewriteScope::Word
   00696|     } else {
   00697|         RewriteScope::Substring
   00698|     };
   00699|     if old.is_empty() || old == new {
   00700|         return None;
   00701|     }
   00702|     // A new text holding the old one (`key 3` → `key 33`) is replaced in one
   00703|     // pass over the file, never rewritten again inside its own result (PR
   00704|     // #1188 G78).
   00705|     let single_pass = scope == RewriteScope::Substring && new.contains(&old);
   00706|     Some(GroundedRewrite {
   00707|         target,
   00708|         pattern: old,
   00709|         replacement: new,
   00710|         scope,
   00711|         renaming: renaming && scope == RewriteScope::Word,
   00712|         unique: false,
   00713|         single_pass,
   00714|         stated: None,
   00715|         verbatim,
   00716|     })
   00717| }
