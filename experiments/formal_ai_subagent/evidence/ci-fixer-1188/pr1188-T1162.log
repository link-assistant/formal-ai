   00030| #[derive(Debug, Clone, PartialEq, Eq)]
   00031| struct GroundedRewrite {
   00032|     target: String,
   00033|     pattern: String,
   00034|     replacement: String,
   00035|     /// How the pattern is allowed to match. Renaming an identifier is a
   00036|     /// word-scoped edit; replacing a quoted literal is a substring one -- or a
   00037|     /// word-scoped one when the new word contains the old (`smal` → `small`).
   00038|     scope: RewriteScope,
   00039|     /// Whether the request renamed a name (a word-scoped rename).
   00040|     renaming: bool,
   00041|     /// Whether the pattern must occur exactly once (a positional insertion's
   00042|     /// anchor), replaced once rather than everywhere.
   00043|     unique: bool,
   00044|     /// Whether the replacement holds the pattern, so it is applied in one
   00045|     /// pass rather than rewritten until no pattern is left (PR #1188 G78).
   00046|     single_pass: bool,
   00047|     /// The seed sentence that states the change, when it is not the
   00048|     /// rename/replace one (a positional insertion's).
   00049|     stated: Option<(&'static str, Vec<(&'static str, String)>)>,
   00050|     /// The pattern and replacement as the request wrote them, when it wrote
   00051|     /// `\n` / `\t` escapes the rewrite unescaped (see [`as_written`]).
   00052|     verbatim: Option<(String, String)>,
   00053| }
