   00785| fn repeated_identifier_rewrite_command(rewrite: &GroundedRewrite) -> Option<String> {
   00786|     if !shell_safe_identifier(&rewrite.pattern) || !shell_safe_identifier(&rewrite.replacement) {
   00787|         return None;
   00788|     }
   00789|     // The in-memory execution and the command the client runs have to agree on
   00790|     // what a match is, so a word-scoped rewrite asks for whole words too.
   00791|     let pattern = match rewrite.scope {
   00792|         RewriteScope::Substring => rewrite.pattern.clone(),
   00793|         RewriteScope::Word => format!("\\b{}\\b", rewrite.pattern),
   00794|     };
   00795|     // `perl -pi -e`, not `sed -i` (issue #1110). GNU and BSD sed disagree about
   00796|     // both halves of that command: BSD `-i` reads the script as its backup
   00797|     // suffix, and BSD sed has no `\b`. On macOS every rename therefore failed
   00798|     // with `bad flag in substitute command`, the file was left unchanged, and
   00799|     // Formal AI reported the mismatch as its own verification failure -- a
   00800|     // confident failure report instead of a rename. perl's `-pi -e` and `\b`
   00801|     // mean the same thing on both, and perl ships with macOS and the runners.
   00802|     // Both identifiers are `[A-Za-z0-9_]` by `shell_safe_identifier`, so
   00803|     // neither side can carry a regex or shell metacharacter.
   00804|     // Assembled from named parts rather than one template string: the prose
   00805|     // detector reads `perl -pi -e ...` as a multi-word phrase (two alphabetic
   00806|     // runs, one of three letters) and would have it live in `data/seed`, which
   00807|     // is the wrong home for a shell invocation. Naming the pieces says what
   00808|     // each is, and none of them reads as a sentence.
   00809|     let script = format!("'s/{pattern}/{}/g'", rewrite.replacement);
   00810|     Some(["perl", "-pi", "-e", &script, "--", &rewrite.target].join(" "))
   00811| }
   00812| 
   00813| fn shell_safe_identifier(identifier: &str) -> bool {
   00814|     !identifier.is_empty()
   00815|         && identifier
   00816|             .chars()
   00817|             .all(|character| character.is_ascii_alphanumeric() || character == '_')
   00818| }
   00819| 
   00820| pub(super) fn identifier_tokens(text: &str) -> impl DoubleEndedIterator<Item = &str> {
   00821|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00822|         .filter(|token| valid_identifier(token))
   00823| }
   00824| 
   00825| fn valid_identifier(identifier: &str) -> bool {
   00826|     let mut characters = identifier.chars();
   00827|     characters
   00828|         .next()
   00829|         .is_some_and(|first| first.is_ascii_alphabetic() || first == '_')
   00830|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00831|         && !seed::lexicon()
   00832|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00833|             .iter()
   00834|             .any(|reserved| reserved == identifier)
   00835| }
