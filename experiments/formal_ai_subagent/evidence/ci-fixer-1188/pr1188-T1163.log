   00320|             task,
   00321|             current_turn,
   00322|             tool_names,
   00323|             &VerifiedChange {
   00324|                 target: &rewrite.target,
   00325|                 expected: &updated,
   00326|                 intent: rewrite.stated_intent(),
   00327|                 slots: &rewrite.stated_slots(),
   00328|             },
   00329|         );
   00330|     }
   00331| 
   00332|     if result_for_path(
   00333|         current_turn,
   00334|         Capability::Write,
   00335|         &rewrite.target,
   00336|         Some(&updated),
