   00838| fn rust_paths(task: &str) -> Vec<String> {
   00839|     let mut paths = Vec::new();
   00840|     for (suffix, _) in task.match_indices(".rs") {
   00841|         let end = suffix + 3;
   00842|         let start = task[..end]
   00843|             .char_indices()
   00844|             .rev()
   00845|             .take_while(|(_, character)| {
   00846|                 character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/')
   00847|             })
   00848|             .last()
   00849|             .map_or(0, |(index, _)| index);
   00850|         let path = &task[start..end];
   00851|         if !path.is_empty()
   00852|             && !path.starts_with('/')
   00853|             && !path.split('/').any(|component| component == "..")
   00854|             && !paths.iter().any(|existing| existing == path)
   00855|         {
   00856|             paths.push(path.to_owned());
   00857|         }
   00858|     }
   00859|     paths
   00860| }
