   00901|         argument_matches_path(&value, path)
   00902|             && argument_matches(&value, &["oldString", "old_string", "old_str", "old"], old)
   00903|             && argument_matches(&value, &["newString", "new_string", "new_str", "new"], new)
   00904|     })
   00905| }
