   00964| fn matching_result(
   00965|     messages: &[ChatMessage],
   00966|     matches: impl Fn(&str, &str) -> bool,
   00967| ) -> Option<String> {
   00968|     messages
   00969|         .iter()
   00970|         .enumerate()
   00971|         .rev()
   00972|         .find_map(|(index, message)| {
   00973|             if !message.role.eq_ignore_ascii_case("tool") {
   00974|                 return None;
   00975|             }
   00976|             let id = message.tool_call_id.as_deref()?;
   00977|             let call = messages[..index]
   00978|                 .iter()
   00979|                 .rev()
   00980|                 .flat_map(|prior| prior.tool_calls.iter().rev())
   00981|                 .find(|call| call.id == id)?;
   00982|             matches(&call.function.name, &call.function.arguments)
   00983|                 .then(|| message.content.plain_text())
   00984|         })
   00985| }
