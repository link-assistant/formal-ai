   00745| fn insert_registration(source: &str, registration: &str) -> String {
   00746|     if source
   00747|         .lines()
   00748|         .any(|line| line.trim() == registration.trim())
   00749|     {
   00750|         return source.to_owned();
   00751|     }
   00752|     let mut updated = source.to_owned();
   00753|     if !updated.is_empty() && !updated.ends_with('\n') {
   00754|         updated.push('\n');
   00755|     }
   00756|     updated.push_str(registration);
   00757|     updated
   00758| }
   00759| 
   00760| fn compact_registration_edit(source: &str, registration: &str) -> Option<(String, String)> {
   00761|     const MAX_SUFFIX_BYTES: usize = 4096;
   00762|     let mut starts = source
   00763|         .match_indices('\n')
   00764|         .map(|(index, _)| index + 1)
   00765|         .filter(|start| *start < source.len())
   00766|         .collect::<Vec<_>>();
   00767|     starts.insert(0, 0);
   00768|     for start in starts.into_iter().rev() {
   00769|         let suffix = &source[start..];
   00770|         if suffix.len() > MAX_SUFFIX_BYTES {
   00771|             break;
   00772|         }
   00773|         if source.match_indices(suffix).count() != 1 {
   00774|             continue;
   00775|         }
   00776|         let mut replacement = suffix.to_owned();
   00777|         if !replacement.ends_with('\n') {
   00778|             replacement.push('\n');
   00779|         }
   00780|         replacement.push_str(registration);
   00781|         return Some((suffix.to_owned(), replacement));
   00782|     }
   00783|     None
   00784| }
