   00862| pub(super) fn result_for_path(
   00863|     messages: &[ChatMessage],
   00864|     capability: Capability,
   00865|     path: &str,
   00866|     expected_content: Option<&str>,
   00867| ) -> Option<String> {
   00868|     matching_result(messages, |name, arguments| {
   00869|         if tool_capability(name) != Some(capability) {
   00870|             return false;
   00871|         }
   00872|         let Ok(value) = serde_json::from_str::<Value>(arguments) else {
   00873|             return false;
   00874|         };
   00875|         let matches_path = ["path", "filePath", "file_path"].iter().any(|key| {
   00876|             value
   00877|                 .get(key)
   00878|                 .and_then(Value::as_str)
   00879|                 .is_some_and(|observed| workspace_path_matches(path, observed))
   00880|         });
   00881|         matches_path
   00882|             && expected_content.is_none_or(|expected| {
   00883|                 value.get("content").and_then(Value::as_str) == Some(expected)
   00884|             })
   00885|     })
   00886| }
