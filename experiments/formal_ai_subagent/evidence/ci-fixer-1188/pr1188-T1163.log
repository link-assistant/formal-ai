   00482| /// The file after `rewrite`, or `None` when it cannot apply. A positional
   00483| /// insertion replaces its one anchor occurrence; an anchor found zero or
   00484| /// several times does not say where the line goes.
   00485| /// The rewrite as the request wrote it, when the file holds no unescaped
   00486| /// pattern but holds the pattern as written (source code quoting `'\n'`,
   00487| /// PR #1188 G65).
   00488| fn as_written(source: &str, rewrite: &GroundedRewrite) -> Option<GroundedRewrite> {
   00489|     let (pattern, replacement) = rewrite.verbatim.clone()?;
   00490|     if (rewrite.pattern != pattern && source.contains(&rewrite.pattern))
   00491|         || !source.contains(&pattern)
   00492|     {
   00493|         return None;
   00494|     }
   00495|     Some(GroundedRewrite {
   00496|         pattern,
   00497|         replacement,
   00498|         verbatim: None,
   00499|         ..rewrite.clone()
   00500|     })
   00501| }
   00502| 
   00503| fn rewritten_source(source: &str, rewrite: &GroundedRewrite) -> Option<String> {
   00504|     if rewrite.single_pass {
   00505|         return source
   00506|             .contains(rewrite.pattern.as_str())
   00507|             .then(|| source.replace(rewrite.pattern.as_str(), &rewrite.replacement));
   00508|     }
   00509|     if rewrite.unique {
   00510|         let (start, old, new) = anchored_lines(source, rewrite)?;
   00511|         return Some([&source[..start], new.as_str(), &source[start + old.len()..]].concat());
   00512|     }
   00513|     execute_scoped_workspace_rewrite(
   00514|         source,
   00515|         &rewrite.pattern,
   00516|         &rewrite.replacement,
   00517|         rewrite.scope,
   00518|     )
   00519|     .ok()
   00520|     .map(|execution| execution.output)
   00521| }
