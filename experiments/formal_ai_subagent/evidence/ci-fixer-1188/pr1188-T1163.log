   00208| /// Whether `answer` is one of this module's seeded verification-failure
   00209| /// renderings for `task`'s targets.
   00210| ///
   00211| /// The rendering is deterministic in the task and the target, so equality
   00212| /// against it is a structural test with no phrase table: it recognises the
   00213| /// failure report in whatever language the seed rendered it. The delivery
   00214| /// route uses it to keep such prose out of the files it writes -- a report
   00215| /// that a check failed is chat, never the `result=` line of an effect file
   00216| /// (issue #1138: the binary-tree ladder's effect files carried the failure
   00217| /// template and every leaf read as an unverified result).
   00218| pub(super) fn is_verification_failure_answer(task: &str, answer: &str) -> bool {
   00219|     let task = unwrap_transport_quotes(task);
   00220|     let mut targets: Vec<String> = compose_edit_request(task)
   00221|         .map(|(target, _, _)| target)
   00222|         .into_iter()
   00223|         .chain(rust_paths(task))
   00224|         .collect();
   00225|     if let Some((target, _)) = super::workspace_line_operation::named_target_and_payloads(task)
   00226|         && !targets.contains(&target)
   00227|     {
   00228|         targets.push(target);
   00229|     }
   00230|     targets.iter().any(|target| {
   00231|         [
   00232|             "coding_workspace_verification_failed",
   00233|             "coding_workspace_fragment_refused",
   00234|         ]
   00235|         .iter()
   00236|         .any(|intent| {
   00237|             render_seeded_outcome(intent, task, target).is_some_and(|rendered| rendered == answer)
   00238|         })
   00239|     })
   00240| }
