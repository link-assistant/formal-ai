   00523| /// A positional insertion's one anchor occurrence widened to the whole lines
   00524| /// it sits on, as `(start, old_lines, new_lines)`, or `None` unless the anchor
   00525| /// occurs exactly once. The inserted text is a line, so an anchor that is only
   00526| /// part of a line (`after the line containing '| T20 |'`) must not split it.
   00527| fn anchored_lines(source: &str, rewrite: &GroundedRewrite) -> Option<(usize, String, String)> {
   00528|     let (pattern, replacement) = (rewrite.pattern.as_str(), rewrite.replacement.as_str());
   00529|     let mut found = source.match_indices(pattern).map(|(at, _)| at);
   00530|     let (Some(at), None) = (found.next(), found.next()) else {
   00531|         return None;
   00532|     };
   00533|     let start = source[..at].rfind('\n').map_or(0, |newline| newline + 1);
   00534|     let tail = at + pattern.len();
   00535|     let end = if pattern.ends_with('\n') {
   00536|         tail - 1
   00537|     } else {
   00538|         source[tail..]
   00539|             .find('\n')
   00540|             .map_or(source.len(), |newline| tail + newline)
   00541|     };
   00542|     let old = &source[start..end];
   00543|     let new = replacement.strip_prefix(pattern).map_or_else(
   00544|         || [&replacement[..replacement.len() - pattern.len()], old].concat(),
   00545|         |rest| [old, rest].concat(),
   00546|     );
   00547|     Some((start, old.to_owned(), new))
   00548| }
   00549| 
   00550| /// The smallest run of whole lines holding every change from `source` to
   00551| /// `updated`, as an edit pair, when that run occurs once in `source`.
   00552| pub(super) fn changed_lines_edit(source: &str, updated: &str) -> Option<(String, String)> {
   00553|     const MAX_EDIT_BYTES: usize = 4096;
   00554|     let prefix = source
   00555|         .bytes()
   00556|         .zip(updated.bytes())
   00557|         .take_while(|(left, right)| left == right)
   00558|         .count();
   00559|     let limit = source.len().min(updated.len()) - prefix;
   00560|     let suffix = source
   00561|         .bytes()
   00562|         .rev()
   00563|         .zip(updated.bytes().rev())
   00564|         .take(limit)
   00565|         .take_while(|(left, right)| left == right)
   00566|         .count();
   00567|     // Byte positions only meet `\n`, so `start` and `end` fall on line -- and
   00568|     // therefore character -- boundaries even when the first or last differing
   00569|     // byte sits inside a multi-byte character.
   00570|     let bytes = source.as_bytes();
   00571|     let line_start = |before: usize| {
   00572|         bytes[..before]
   00573|             .iter()
   00574|             .rposition(|byte| *byte == b'\n')
   00575|             .map_or(0, |at| at + 1)
   00576|     };
   00577|     let mut start = line_start(prefix);
   00578|     let end = bytes[source.len() - suffix..]
   00579|         .iter()
   00580|         .position(|byte| *byte == b'\n')
   00581|         .map_or(source.len(), |at| source.len() - suffix + at);
   00582|     // Lines inserted between two lines change none: the line above carries
   00583|     // them.
   00584|     if start == end && start > 0 {
   00585|         start = line_start(start - 1);
   00586|     }
   00587|     let old = &source[start..end];
   00588|     let new = &updated[start..updated.len() - (source.len() - end)];
   00589|     (!old.is_empty() && old.len() <= MAX_EDIT_BYTES && source.matches(old).count() == 1)
   00590|         .then(|| (old.to_owned(), new.to_owned()))
   00591| }
   00592| 
   00593| /// `Insert 'x' after the line 'y' in f`: the anchor line, replaced once by the
   00594| /// anchor beside the new line, stated by the position meaning that placed it.
   00595| fn grounded_positional_insert(task: &str) -> Option<GroundedRewrite> {
   00596|     let (target, anchor, replacement) = super::positional_edit::compose_positional_insert(task)?;
   00597|     let after_anchor = [anchor.as_str(), "\n"].concat();
   00598|     let (after, inserted) = if let Some(inserted) = replacement.strip_prefix(&after_anchor) {
   00599|         (true, inserted.to_owned())
   00600|     } else {
   00601|         let before_anchor = ["\n", anchor.as_str()].concat();
   00602|         (false, replacement.strip_suffix(&before_anchor)?.to_owned())
   00603|     };
   00604|     let intent = super::positional_edit::insert_intent(after, &inserted);
   00605|     Some(GroundedRewrite {
   00606|         target,
   00607|         stated: Some((
   00608|             intent,
   00609|             vec![(NEW_SLOT, inserted), (ANCHOR_SLOT, anchor.clone())],
   00610|         )),
   00611|         pattern: anchor,
   00612|         replacement,
   00613|         scope: RewriteScope::Substring,
   00614|         renaming: false,
   00615|         unique: true,
   00616|         single_pass: false,
   00617|         verbatim: None,
   00618|     })
   00619| }
   00620| 
   00621| /// Every insert the request asks for, each its own anchored edit.
   00622| ///
   00623| /// Several clauses (`…, and insert …`), an anchor named by the line it
   00624| /// follows (T31, T34), lines rebased on the anchor (G16), or one insert whose
   00625| /// anchor is a whole line also found inside others (`the line 'b'`).
   00626| fn insert_sequence(task: &str) -> Option<Vec<PositionalInsert>> {
   00627|     super::positional_edit::positional_inserts(task)
   00628| }
   00629| 
   00630| fn grounded_rewrite(task: &str) -> Option<GroundedRewrite> {
   00631|     if let Some(positional) = grounded_positional_insert(task) {
   00632|         return Some(positional);
   00633|     }
   00634|     let (target, old_clause, new_clause) = compose_edit_request(task)?;
   00635|     let renaming = seed::lexicon().mentions_role(
   00636|         seed::ROLE_CODING_IDENTIFIER_RENAME_ACTION,
   00637|         &task.to_lowercase(),
   00638|     );
   00639|     // A request that names a line replaces whole lines
   00640|     // (`grounded_line_replacement`).
   00641|     if !renaming && super::workspace_computed_change::names_line(task) {
   00642|         return None;
   00643|     }
   00644|     // Both operands have to be literals the request actually quoted, so prose
   00645|     // ("replace the old header with something clearer") is never rewritten as
   00646|     // bytes. What that cannot be is a count: requiring the request to hold
   00647|     // *exactly* two quoted segments made every other pair of delimiters in the
   00648|     // prompt disqualify the edit, and this repository's own prose backticks the
   00649|     // file it names. The issue #1028 ladder node "In the file
   00650|     // `src/protocol_memory.rs`, replace \"request_history\" with
   00651|     // \"conversation_history\"" quotes three things and states one replacement.
   00652|     // Asking whether each clause *is* quoted keeps the guarantee and drops the
   00653|     // arithmetic.
   00654|     // The edit request unescapes `\n` / `\t` in its literals, so the quoted
   00655|     // segments are compared unescaped too: a multi-line replacement written
   00656|     // with `\n` was otherwise not "quoted", and the general fallback wrote its
   00657|     // new text over the whole file (PR #1188 sub-agent gap 3).
   00658|     let quoted: Vec<String> = quoted_segments(task)
   00659|         .iter()
   00660|         .map(String::as_str)
   00661|         .map(super::positional_edit::unescape_prose_newlines)
   00662|         .collect();
   00663|     // A literal quoted whole counts even when backtick spans inside it pair
   00664|     // among themselves (PR #1188 G63).
   00665|     let is_quoted =
   00666|         |value: &String| quoted.contains(value) || crate::normal_markov::quotes_whole(task, value);
   00667|     let operands = if is_quoted(&old_clause) && is_quoted(&new_clause) {
   00668|         Some((old_clause, new_clause))
   00669|     } else if renaming {
   00670|         Some((
   00671|             identifier_tokens(&old_clause).next_back()?.to_owned(),
   00672|             identifier_tokens(&new_clause).next()?.to_owned(),
   00673|         ))
   00674|     } else {
   00675|         None
   00676|     }?;
   00677|     let (old, new) = operands;
   00678|     let as_quoted = |text: &str| {
   00679|         quoted_segments(task)
   00680|             .into_iter()
   00681|             .find(|raw| raw != text && super::positional_edit::unescape_prose_newlines(raw) == text)
   00682|             .unwrap_or_else(|| text.to_owned())
   00683|     };
   00684|     let verbatim = (as_quoted(&old) != old || as_quoted(&new) != new)
   00685|         .then(|| (as_quoted(&old), as_quoted(&new)));
   00686|     // A rename names a *word*, so the edit is word-scoped whichever way the
   00687|     // request spelled its operands. Without that scope the most ordinary rename
   00688|     // there is -- giving a name a prefix or a suffix -- has to be refused, since
   00689|     // an unanchored substring rewrite that reintroduces its own pattern never
   00690|     // terminates.
   00691|     //
   00692|     // A word replaced by a longer word that contains it (`smal` → `small`, a
   00693|     // typo fix) is only safe word by word for the same reason.
   00694|     let words = is_identifier_word(&old) && is_identifier_word(&new);
   00695|     let scope = if words && (renaming || new.contains(&old)) {
   00696|         RewriteScope::Word
   00697|     } else {
   00698|         RewriteScope::Substring
   00699|     };
   00700|     if old.is_empty() || old == new {
   00701|         return None;
   00702|     }
   00703|     // A new text holding the old one (`key 3` → `key 33`) is replaced in one
   00704|     // pass over the file, never rewritten again inside its own result (PR
   00705|     // #1188 G78).
   00706|     let single_pass = scope == RewriteScope::Substring && new.contains(&old);
   00707|     Some(GroundedRewrite {
   00708|         target,
   00709|         pattern: old,
   00710|         replacement: new,
   00711|         scope,
   00712|         renaming: renaming && scope == RewriteScope::Word,
   00713|         unique: false,
   00714|         single_pass,
   00715|         stated: None,
   00716|         verbatim,
   00717|     })
   00718| }
