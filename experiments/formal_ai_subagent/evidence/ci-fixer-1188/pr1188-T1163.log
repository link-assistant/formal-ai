   00888| pub(super) fn result_for_edit(
   00889|     messages: &[ChatMessage],
   00890|     path: &str,
   00891|     old: &str,
   00892|     new: &str,
   00893| ) -> Option<String> {
   00894|     matching_result(messages, |name, arguments| {
   00895|         if tool_capability(name) != Some(Capability::Edit) {
   00896|             return false;
