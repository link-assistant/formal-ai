   00113|     // so the read and write evidence gathered for it must survive the ping
   00114|     // (issue #1138): slicing at the last user message -- the cue itself --
   00115|     // restarted the read--write pair on every ping.
   00116|     let current_turn = &messages[super::planner::evidence_window_start(messages)..];
   00117|     // `Append the contents of a.txt to b.txt`: the source is read, and the
   00118|     // request is restated with its lines as the block placed (PR #1188 G50).
   00119|     let sourced = match sourced_request(task, current_turn) {
   00120|         Some(Sourced::Read(path)) => {
   00121|             let tool = tool_for(tool_names, Capability::Read)?;
   00122|             return Some(plan_one(tool, read_arguments(&path)));
   00123|         }
   00124|         Some(Sourced::Task(sourced)) => Some(sourced),
   00125|         None => None,
   00126|     };
   00127|     let task = sourced.as_deref().unwrap_or(task);
   00128| 
   00129|     if let Some(change) = composite_module_change(task) {
   00130|         return plan_composite_step(task, current_turn, tool_names, &change);
   00131|     }
   00132|     // Numbered lines moved to another file: placed there, then removed (G85).
   00133|     if let Some(order) = super::line_range_move::line_range_move(task) {
   00134|         return super::line_range_move::plan_line_range_move_step(
   00135|             task,
   00136|             current_turn,
   00137|             tool_names,
   00138|             &order,
   00139|         );
   00140|     }
   00141|     if let Some(change) = super::workspace_computed_change::grounded_line_change(task) {
   00142|         return super::workspace_computed_change::plan_computed_change_step(
   00143|             task,
   00144|             current_turn,
   00145|             tool_names,
   00146|             &change,
   00147|         );
   00148|     }
   00149|     if let Some(inserts) = insert_sequence(task) {
   00150|         return super::positional_edit::plan_insert_sequence_step(
   00151|             task,
   00152|             current_turn,
   00153|             tool_names,
   00154|             &inserts,
   00155|         );
   00156|     }
   00157|     // Several replacements asked in one sentence are made in order (G82).
   00158|     if let Some(change) = super::workspace_computed_change::grounded_replace_list(task) {
   00159|         return super::workspace_computed_change::plan_computed_change_step(
   00160|             task,
   00161|             current_turn,
   00162|             tool_names,
   00163|             &change,
   00164|         );
   00165|     }
   00166|     if let Some(rewrite) = grounded_rewrite(task) {
   00167|         return plan_rewrite_step(task, current_turn, tool_names, &rewrite);
   00168|     }
   00169|     let change = super::workspace_computed_change::grounded_computed_change(task)?;
   00170|     super::workspace_computed_change::plan_computed_change_step(
   00171|         task,
   00172|         current_turn,
   00173|         tool_names,
   00174|         &change,
   00175|     )
   00176| }
