   00907| fn argument_matches_path(value: &Value, expected: &str) -> bool {
   00908|     ["path", "filePath", "file_path"].iter().any(|key| {
   00909|         value
   00910|             .get(key)
   00911|             .and_then(Value::as_str)
   00912|             .is_some_and(|observed| workspace_path_matches(expected, observed))
   00913|     })
   00914| }
   00915| 
   00916| fn argument_matches(value: &Value, keys: &[&str], expected: &str) -> bool {
   00917|     keys.iter()
   00918|         .any(|key| value.get(key).and_then(Value::as_str) == Some(expected))
   00919| }
   00920| 
   00921| fn workspace_path_matches(expected: &str, observed: &str) -> bool {
   00922|     if observed == expected {
   00923|         return true;
   00924|     }
   00925|     let expected = Path::new(expected);
   00926|     let observed = Path::new(observed);
   00927|     expected.is_relative() && observed.is_absolute() && observed.ends_with(expected)
   00928| }
