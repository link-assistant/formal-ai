   00106| pub(super) fn plan_workspace_change_step(
   00107|     task: &str,
   00108|     messages: &[ChatMessage],
   00109|     tool_names: &[&str],
   00110| ) -> Option<AgenticPlan> {
   00111|     let task = unwrap_transport_quotes(task);
