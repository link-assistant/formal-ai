   00288|             anchored_lines(&source, rewrite).map(|(_, old, new)| (old, new))
   00289|         } else if source.matches(rewrite.pattern.as_str()).count() == 1 {
   00290|             Some((rewrite.pattern.clone(), rewrite.replacement.clone()))
   00291|         } else {
   00292|             changed_lines_edit(&source, &updated)
   00293|         };
