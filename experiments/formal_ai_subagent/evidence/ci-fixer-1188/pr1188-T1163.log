   00937| pub(super) fn plan_digest_verification(
   00938|     task: &str,
   00939|     current_turn: &[ChatMessage],
   00940|     tool_names: &[&str],
   00941|     change: &VerifiedChange<'_>,
   00942| ) -> Option<AgenticPlan> {
   00943|     let command = ["sha256sum -- ", change.target].concat();
   00944|     let Some(observed) = result_for_command(current_turn, &command) else {
   00945|         let tool = tool_for(tool_names, Capability::Run)?;
   00946|         return Some(plan_one(tool, json!({"command": command}).to_string()));
   00947|     };
   00948|     let digest = crate::source_fetch::sha256_hex(change.expected.as_bytes());
   00949|     if observed.split_whitespace().next() != Some(digest.as_str()) {
   00950|         return Some(AgenticPlan::Final(render_seeded_outcome(
   00951|             "coding_workspace_verification_failed",
   00952|             task,
   00953|             change.target,
   00954|         )?));
   00955|     }
   00956|     Some(AgenticPlan::Final(render_seeded_change(
   00957|         change.intent,
   00958|         task,
   00959|         change.target,
   00960|         change.slots,
   00961|     )?))
   00962| }
