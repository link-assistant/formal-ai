   00786| fn repeated_identifier_rewrite_command(rewrite: &GroundedRewrite) -> Option<String> {
   00787|     if !shell_safe_identifier(&rewrite.pattern) || !shell_safe_identifier(&rewrite.replacement) {
   00788|         return None;
   00789|     }
   00790|     // The in-memory execution and the command the client runs have to agree on
   00791|     // what a match is, so a word-scoped rewrite asks for whole words too.
   00792|     let pattern = match rewrite.scope {
   00793|         RewriteScope::Substring => rewrite.pattern.clone(),
   00794|         RewriteScope::Word => format!("\\b{}\\b", rewrite.pattern),
   00795|     };
   00796|     // `perl -pi -e`, not `sed -i` (issue #1110). GNU and BSD sed disagree about
   00797|     // both halves of that command: BSD `-i` reads the script as its backup
   00798|     // suffix, and BSD sed has no `\b`. On macOS every rename therefore failed
   00799|     // with `bad flag in substitute command`, the file was left unchanged, and
   00800|     // Formal AI reported the mismatch as its own verification failure -- a
   00801|     // confident failure report instead of a rename. perl's `-pi -e` and `\b`
   00802|     // mean the same thing on both, and perl ships with macOS and the runners.
   00803|     // Both identifiers are `[A-Za-z0-9_]` by `shell_safe_identifier`, so
   00804|     // neither side can carry a regex or shell metacharacter.
   00805|     // Assembled from named parts rather than one template string: the prose
   00806|     // detector reads `perl -pi -e ...` as a multi-word phrase (two alphabetic
   00807|     // runs, one of three letters) and would have it live in `data/seed`, which
   00808|     // is the wrong home for a shell invocation. Naming the pieces says what
   00809|     // each is, and none of them reads as a sentence.
   00810|     let script = format!("'s/{pattern}/{}/g'", rewrite.replacement);
   00811|     Some(["perl", "-pi", "-e", &script, "--", &rewrite.target].join(" "))
   00812| }
   00813| 
   00814| fn shell_safe_identifier(identifier: &str) -> bool {
   00815|     !identifier.is_empty()
   00816|         && identifier
   00817|             .chars()
   00818|             .all(|character| character.is_ascii_alphanumeric() || character == '_')
   00819| }
   00820| 
   00821| pub(super) fn identifier_tokens(text: &str) -> impl DoubleEndedIterator<Item = &str> {
   00822|     text.split(|character: char| !character.is_ascii_alphanumeric() && character != '_')
   00823|         .filter(|token| valid_identifier(token))
   00824| }
   00825| 
   00826| fn valid_identifier(identifier: &str) -> bool {
   00827|     let mut characters = identifier.chars();
   00828|     characters
   00829|         .next()
   00830|         .is_some_and(|first| first.is_ascii_alphabetic() || first == '_')
   00831|         && characters.all(|character| character.is_ascii_alphanumeric() || character == '_')
   00832|         && !seed::lexicon()
   00833|             .words_for_role(seed::ROLE_IDENTIFIER_RESERVED_WORD)
   00834|             .iter()
   00835|             .any(|reserved| reserved == identifier)
   00836| }
