   00298|                 return Some(plan_one(tool, edit_arguments(&rewrite.target, &old, &new)));
   00299|             }
   00300|             return plan_digest_verification(
   00301|                 task,
   00302|                 current_turn,
   00303|                 tool_names,
   00304|                 &VerifiedChange {
   00305|                     target: &rewrite.target,
   00306|                     expected: &updated,
   00307|                     intent: rewrite.stated_intent(),
   00308|                     slots: &rewrite.stated_slots(),
   00309|                 },
   00310|             );
   00311|         }
   00312|     } else if tool_for(tool_names, Capability::Edit).is_some()
   00313|         && let Some(command) = repeated_identifier_rewrite_command(rewrite)
   00314|         && let Some(tool) = tool_for(tool_names, Capability::Run)
   00315|     {
   00316|         if result_for_command(current_turn, &command).is_none() {
   00317|             return Some(plan_one(tool, json!({"command": command}).to_string()));
   00318|         }
