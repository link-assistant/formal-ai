   00722| fn composite_module_change(task: &str) -> Option<CompositeModuleChange> {
   00723|     let lowered = task.to_lowercase();
   00724|     if !seed::lexicon().mentions_role(seed::ROLE_CODING_MODULE_REGISTRATION_ACTION, &lowered) {
   00725|         return None;
   00726|     }
   00727|     let generated = rust_source_for_task(task)?;
   00728|     let registration_path = rust_paths(task)
   00729|         .into_iter()
   00730|         .find(|path| path != &generated.path)?;
   00731|     let module = generated.path.rsplit('/').next()?.strip_suffix(".rs")?;
   00732|     if !valid_identifier(module) {
   00733|         return None;
   00734|     }
   00735|     let registration =
   00736|         render_rust_template("coding_source_module_registration", &[("{module}", module)])?;
   00737|     Some(CompositeModuleChange {
   00738|         source_path: generated.path,
   00739|         source: generated.content,
   00740|         registration_path,
   00741|         registration,
   00742|     })
   00743| }
