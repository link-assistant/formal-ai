>> edit {"filePath":".github/workflows/issue-1028-agent-ladder.yml","file_path":".github/workflows/issue-1028-agent-ladder.yml","new":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","newString":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","new_str":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","new_string":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          export LADDER_SOURCE_COMMIT LADDER_SOURCE_TREE\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","old":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","oldString":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","old_str":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","old_string":"name: Issue 1028 Agent CLI binary-tree ladder\n\n# Issue #1085 (D4): the ladder runs on pull requests that touch it or the\n# agentic coding modules (leaf level), weekly over every level, and on\n# dispatch. The deepest level whose nodes all pass is compared with\n# data/meta/ladder-ratchet.lino and may only move deeper.\n#\n# PR #1188: the depth-five run measured its 32 leaves one after another in one\n# job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).\n# Leaves are independent -- each starts from a reset worktree and only a\n# depth-4 composite reads its children's effects -- so the default run is now\n#   plan     consults the green ledger (lookup only), warms the binary cache\n#            and lists the legs: sixteen depth-4 subtrees of two leaves each\n#            for depth five, and individual requirement nodes in all mode;\n#   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;\n#   compare  green only when every leg succeeded (check-shard-results.sh), the\n#            legs join into one run (combine-shards.py refuses a missing or\n#            overlapping leg), and that run holds the recorded ratchet. Its\n#            success, not the plan's, records the inputs green.\n# Weekly all mode measures every node in bounded independent legs. Leaves\n# and requirement nodes run in parallel; depth-four composites consume this\n# run's validated leaf effects and diffs in a second artifact-fed wave.\n# The final join checks the exact 63-node plan, corpus and source identity.\non:\n  # Issue #1187 R2: a bot pull request's checks start through dispatch\n  # (.github/actions/dispatch-checks); mode and pull-request are its inputs.\n  workflow_dispatch:\n    inputs:\n      mode:\n        description: 'checks: run the pull-request checks on the dispatched branch'\n        required: false\n        default: checks\n        type: choice\n        options: [checks]\n      pull-request:\n        description: 'Pull request the dispatched checks report for'\n        required: false\n        default: ''\n        type: string\n      depth:\n        description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'\n        required: false\n        default: '5'\n        type: choice\n        options: ['0', '1', '2', '3', '4', '5', 'all']\n      node_filter:\n        description: 'Optional node path (for example 2.1.2.2.1)'\n        required: false\n        default: ''\n        type: string\n      skip_build:\n        description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'\n        required: false\n        default: false\n        type: boolean\n      authored_rules:\n        description: 'Per-leaf authored mappings visible to the agent'\n        required: false\n        default: 'disabled'\n        type: choice\n        options: ['disabled', 'enabled']\n  pull_request:\n    # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request\n    # never triggers this repository's own pipeline.\n    branches-ignore: ['e2e/**']\n    paths:\n      - 'experiments/issue_1028_agent_cli_ladder/**'\n      - 'rust/src/agentic_coding/**'\n      - 'data/meta/ladder-ratchet.lino'\n      - '.github/workflows/issue-1028-agent-ladder.yml'\n  schedule:\n    - cron: '23 3 * * 0'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: issue-1028-agent-cli-binary-tree-${{ github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\njobs:\n  plan:\n    name: Plan the Agent CLI ladder\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      already-green: ${{ steps.ledger.outputs.already-green }}\n      legs: ${{ steps.plan.outputs.legs || '[]' }}\n      leg-count: ${{ steps.plan.outputs.leg-count }}\n      composites: ${{ steps.plan.outputs.composites || '[]' }}\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      # Lookup only (`record: 'false'`): a green plan says nothing about the\n      # ladder, so the compare job records the verdict for these inputs.\n      - name: Skip when identical inputs already passed\n        id: ledger\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: ${{ github.ref != 'refs/heads/main' }}\n          record: 'false'\n\n      - name: List the ladder legs\n        id: plan\n        if: ${{ steps.ledger.outputs.already-green != 'true' }}\n        run: |\n          set -euo pipefail\n          plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\")\n          {\n            echo \"legs=$(jq -c '.legs' <<< \"$plan\")\"\n            echo \"composites=$(jq -c '.composites' <<< \"$plan\")\"\n            echo \"leg-count=$(jq '(.legs | length) + (.composites | length)' <<< \"$plan\")\"\n          } >> \"$GITHUB_OUTPUT\"\n          echo \"$plan\"\n\n      # Reused across every workflow that only needs to *run* the binary: the\n      # cache key is the content of the sources it is built from, so a push that\n      # changed neither pays nothing (issue #1107). Warmed once here so every\n      # leg restores it instead of each compiling it.\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}\n\n  ladder:\n    name: Agent CLI ladder ${{ matrix.leg.id }}\n    needs: [plan]\n    if: ${{ needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    # The previous 63-node serial walk is now at most two leaves or one\n    # requirement per leg. Keep a generous exception while real cold/all-mode\n    # observations establish the 30-minute retirement criterion. With the\n    # artifact-fed composite wave, the static workflow DAG remains 225 minutes.\n    timeout-minutes: 135\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.legs) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n        run: experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  leaf-evidence:\n    name: Validate the current-run leaf evidence\n    needs: [plan, ladder]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n      - name: Every primary leg measured its nodes\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder primary wave\n        run: bash scripts/check-shard-results.sh\n      - name: Download exactly the measured leaf legs\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-depth-5-*\n          path: ${{ runner.temp }}/leaf-legs\n      - name: Validate and join the complete leaf dependency set\n        run: |\n          set -euo pipefail\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 \"$NODE_FILTER\" > \"$RUNNER_TEMP/leaf-plan.json\"\n          count=$(jq '.legs | length' \"$RUNNER_TEMP/leaf-plan.json\")\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/leaf-legs\" \"$RUNNER_TEMP/current-leaves\" \"$count\" \"$RUNNER_TEMP/leaf-plan.json\"\n      - name: Upload validated leaves for the composite wave\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n          retention-days: 3\n          if-no-files-found: error\n\n  composites:\n    name: Agent CLI composite ${{ matrix.leg.id }}\n    needs: [plan, leaf-evidence]\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}\n    runs-on: ubuntu-latest\n    # One composite per machine; verification consumes only the current\n    # run's two validated child effects and diffs.\n    timeout-minutes: 30\n    strategy:\n      fail-fast: false\n      matrix:\n        leg: ${{ fromJSON(needs.plan.outputs.composites) }}\n    env:\n      TREE_DEPTH: ${{ matrix.leg.depth }}\n      NODE_FILTER: ${{ matrix.leg.filter }}\n      # A fresh directory, not the committed evidence under docs/: the compare\n      # job joins exactly what this leg measured.\n      OUT: ${{ github.workspace }}/agent-tree-run\n      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: \"false\"\n      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          no-cache: true\n\n      # Each leaf's edit is compiled by verify-node.sh; the dependency crates\n      # are the same on every leg, so the first leaf of each leg restores them\n      # from the shared compiler cache instead of compiling them cold.\n      - uses: ./.github/actions/setup-sccache\n\n      # verify-node.sh compiles every leaf's edit, so the toolchain must meet\n      # the crate's rust-version whether or not the binary came from cache:\n      # formal-ai-binary installs one only on a cache miss, and a runner image\n      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run\n      # 37710079109) although their edits were valid.\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - uses: ./.github/actions/formal-ai-binary\n        if: ${{ inputs.skip_build != true }}\n\n      - name: Install pinned Agent CLI\n        run: bun add -g @link-assistant/agent@0.26.0\n\n      - name: Download validated current-run leaves\n        uses: actions/download-artifact@v8\n        env:\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          name: issue-1028-agent-cli-current-leaves\n          path: ${{ runner.temp }}/current-leaves\n\n      - name: Run recursive Agent CLI tree\n        id: tree\n        env:\n          AGENT: agent\n          LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves\n          TEST_BUDGET_SECONDS: 1200\n        run: |\n          scripts/run-with-budget-warning.sh \\\n            \"$TEST_BUDGET_SECONDS\" \"Agent CLI composite verification\" \\\n            experiments/issue_1028_agent_cli_ladder/run.sh\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh \"$OUT\"\n\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}\n          path: ${{ github.workspace }}/agent-tree-run\n          retention-days: 3\n          if-no-files-found: error\n\n  compare:\n    name: Compare the measured ladder with the record\n    needs: [plan, ladder, leaf-evidence, composites]\n    # Not `always()`: a run superseded by a newer push is the one\n    # cancellation that is not a defect, and it skips the verdict.\n    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    env:\n      TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}\n      NODE_FILTER: ${{ inputs.node_filter || '' }}\n      OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run\n    steps:\n      - uses: actions/checkout@v7\n        with:\n          persist-credentials: false\n\n      # Enabled off, recording on: this job never skips, and its own success\n      # is what marks these inputs green for the plan job's next lookup.\n      - name: Record the verdict for these inputs\n        uses: ./.github/actions/green-ledger\n        with:\n          check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}\n          paths: >-\n            rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions\n          enabled: 'false'\n\n      - name: Every ladder leg finished\n        env:\n          NEEDS_JSON: ${{ toJSON(needs) }}\n          JOBS: plan ladder\n          CHECK: Agent CLI ladder\n          COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}\n        run: |\n          if [[ \"$COMPOSITE_LEGS\" != '[]' ]]; then\n            export JOBS=\"$JOBS leaf-evidence composites\"\n          fi\n          bash scripts/check-shard-results.sh\n\n      - name: Download every leg's evidence\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: issue-1028-agent-cli-binary-tree-*\n          path: ${{ runner.temp }}/agent-tree-legs\n\n      # The committed evidence under $OUT is a previous run's; the joined run\n      # replaces it so nothing stale is compared or uploaded.\n      - name: Join the legs into one run\n        env:\n          LEG_COUNT: ${{ needs.plan.outputs.leg-count }}\n        run: |\n          set -euo pipefail\n          rm -rf \"$OUT\"\n          export LADDER_SOURCE_COMMIT=\"$(git rev-parse HEAD)\"\n          export LADDER_SOURCE_TREE=\"$(git rev-parse 'HEAD^{tree}')\"\n          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py \"$TREE_DEPTH\" \"$NODE_FILTER\" > \"$RUNNER_TEMP/ladder-plan.json\"\n          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \\\n            \"$RUNNER_TEMP/agent-tree-legs\" \"$OUT\" \"$LEG_COUNT\" \"$RUNNER_TEMP/ladder-plan.json\"\n\n      # A ladder that ran and measured fewer leaves than the record is still\n      # compared -- that is the regression this gate exists to catch.\n      - name: Compare the measured ladder with the record\n        run: |\n          set -euo pipefail\n          result=\"$OUT/ladder-result.lino\"\n          [[ -f \"$result\" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }\n          field() { sed -n \"s/^  $1 \\\"\\(.*\\)\\\"$/\\1/p\" \"$result\"; }\n          recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)\n          measured_leaves=$(field leaf_nodes_passing)\n          selected_leaves=$(field leaf_nodes_selected)\n          authored_rules_enabled=$(field authored_rules_enabled)\n          echo \"leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves\"\n          cat \"$result\" >> \"$GITHUB_STEP_SUMMARY\"\n          # Only a full-width run is comparable with the record: a filtered or\n          # shallower run selects fewer leaves and would always look worse.\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == true ]]; then\n            if (( measured_leaves < recorded_leaves )); then\n              echo \"::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes.\"\n              exit 1\n            fi\n            if (( measured_leaves > recorded_leaves )); then\n              echo \"::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$selected_leaves\" == 32 && \"$authored_rules_enabled\" == false ]]; then\n            measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)\n            recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)\n            if [[ \"$recorded_without_rules\" == not_measured ]]; then\n              echo \"::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino\"\n              exit 1\n            fi\n            if (( measured_without_rules < recorded_without_rules )); then\n              echo \"::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules\"\n              exit 1\n            fi\n            if (( measured_without_rules > recorded_without_rules )); then\n              echo \"::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit\"\n            fi\n          fi\n          if [[ \"$TREE_DEPTH\" == all ]]; then\n            deepest=$(field deepest_passing_level)\n            recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)\n            echo \"deepest passing level: recorded $recorded_depth, this run $deepest\"\n            if [[ \"$recorded_depth\" != none && \"$deepest\" == none ]]; then\n              echo \"::error::no level passed completely; the record is level $recorded_depth\"\n              exit 1\n            fi\n            if [[ \"$recorded_depth\" != none && \"$deepest\" != none ]] && (( deepest < recorded_depth )); then\n              echo \"::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)\"\n              exit 1\n            fi\n          fi\n\n      - name: Show the Agent CLI evidence on failure\n        if: failure()\n        run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run\n      - name: Upload tree evidence\n        if: ${{ always() }}\n        uses: actions/upload-artifact@v7\n        with:\n          name: issue-1028-agent-cli-binary-tree\n          path: docs/case-studies/issue-1028/agent-tree-run\n          retention-days: 14\n          if-no-files-found: warn\n","path":".github/workflows/issue-1028-agent-ladder.yml"}
