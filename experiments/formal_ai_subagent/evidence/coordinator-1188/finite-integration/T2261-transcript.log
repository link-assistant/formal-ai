   <file>
   00001| name: Issue 1028 Agent CLI binary-tree ladder
   00002| 
   00003| # Issue #1085 (D4): the ladder runs on pull requests that touch it or the
   00004| # agentic coding modules (leaf level), weekly over every level, and on
   00005| # dispatch. The deepest level whose nodes all pass is compared with
   00006| # data/meta/ladder-ratchet.lino and may only move deeper.
   00007| #
   00008| # PR #1188: the depth-five run measured its 32 leaves one after another in one
   00009| # job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).
   00010| # Leaves are independent -- each starts from a reset worktree and only a
   00011| # depth-4 composite reads its children's effects -- so the default run is now
   00012| #   plan     consults the green ledger (lookup only), warms the binary cache
   00013| #            and lists the legs: sixteen depth-4 subtrees of two leaves each
   00014| #            for depth five, and individual requirement nodes in all mode;
   00015| #   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;
   00016| #   compare  green only when every leg succeeded (check-shard-results.sh), the
   00017| #            legs join into one run (combine-shards.py refuses a missing or
   00018| #            overlapping leg), and that run holds the recorded ratchet. Its
   00019| #            success, not the plan's, records the inputs green.
   00020| # Weekly all mode measures every node in bounded independent legs. Leaves
   00021| # and requirement nodes run in parallel; depth-four composites consume this
   00022| # run's validated leaf effects and diffs in a second artifact-fed wave.
   00023| # The final join checks the exact 63-node plan, corpus and source identity.
   00024| on:
   00025|   # Issue #1187 R2: a bot pull request's checks start through dispatch
   00026|   # (.github/actions/dispatch-checks); mode and pull-request are its inputs.
   00027|   workflow_dispatch:
   00028|     inputs:
   00029|       mode:
   00030|         description: 'checks: run the pull-request checks on the dispatched branch'
   00031|         required: false
   00032|         default: checks
   00033|         type: choice
   00034|         options: [checks]
   00035|       pull-request:
   00036|         description: 'Pull request the dispatched checks report for'
   00037|         required: false
   00038|         default: ''
   00039|         type: string
   00040|       depth:
   00041|         description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'
   00042|         required: false
   00043|         default: '5'
   00044|         type: choice
   00045|         options: ['0', '1', '2', '3', '4', '5', 'all']
   00046|       node_filter:
   00047|         description: 'Optional node path (for example 2.1.2.2.1)'
   00048|         required: false
   00049|         default: ''
   00050|         type: string
   00051|       skip_build:
   00052|         description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'
   00053|         required: false
   00054|         default: false
   00055|         type: boolean
   00056|       authored_rules:
   00057|         description: 'Per-leaf authored mappings visible to the agent'
   00058|         required: false
   00059|         default: 'disabled'
   00060|         type: choice
   00061|         options: ['disabled', 'enabled']
   00062|   pull_request:
   00063|     # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request
   00064|     # never triggers this repository's own pipeline.
   00065|     branches-ignore: ['e2e/**']
   00066|     paths:
   00067|       - 'experiments/issue_1028_agent_cli_ladder/**'
   00068|       - 'rust/src/agentic_coding/**'
   00069|       - 'data/meta/ladder-ratchet.lino'
   00070|       - '.github/workflows/issue-1028-agent-ladder.yml'
   00071|   schedule:
   00072|     - cron: '23 3 * * 0'
   00073| 
   00074| permissions:
   00075|   contents: read
   00076| 
   00077| concurrency:
   00078|   group: issue-1028-agent-cli-binary-tree-${{ github.ref }}
   00079|   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
   00080| 
   00081| jobs:
   00082|   plan:
   00083|     name: Plan the Agent CLI ladder
   00084|     runs-on: ubuntu-latest
   00085|     timeout-minutes: 30
   00086|     outputs:
   00087|       already-green: ${{ steps.ledger.outputs.already-green }}
   00088|       legs: ${{ steps.plan.outputs.legs || '[]' }}
   00089|       leg-count: ${{ steps.plan.outputs.leg-count }}
   00090|       composites: ${{ steps.plan.outputs.composites || '[]' }}
   00091|     env:
   00092|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00093|       NODE_FILTER: ${{ inputs.node_filter || '' }}
   00094|     steps:
   00095|       - uses: actions/checkout@v7
   00096|         with:
   00097|           persist-credentials: false
   00098|       # Lookup only (`record: 'false'`): a green plan says nothing about the
   00099|       # ladder, so the compare job records the verdict for these inputs.
   00100|       - name: Skip when identical inputs already passed
   00101|         id: ledger
   00102|         uses: ./.github/actions/green-ledger
   00103|         with:
   00104|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00105|           paths: >-
   00106|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00107|           enabled: ${{ github.ref != 'refs/heads/main' }}
   00108|           record: 'false'
   00109| 
   00110|       - name: List the ladder legs
   00111|         id: plan
   00112|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00113|         run: |
   00114|           set -euo pipefail
   00115|           plan=$(python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py "$TREE_DEPTH" "$NODE_FILTER")
   00116|           {
   00117|             echo "legs=$(jq -c '.legs' <<< "$plan")"
   00118|             echo "composites=$(jq -c '.composites' <<< "$plan")"
   00119|             echo "leg-count=$(jq '(.legs | length) + (.composites | length)' <<< "$plan")"
   00120|           } >> "$GITHUB_OUTPUT"
   00121|           echo "$plan"
   00122| 
   00123|       # Reused across every workflow that only needs to *run* the binary: the
   00124|       # cache key is the content of the sources it is built from, so a push that
   00125|       # changed neither pays nothing (issue #1107). Warmed once here so every
   00126|       # leg restores it instead of each compiling it.
   00127|       - uses: ./.github/actions/formal-ai-binary
   00128|         if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}
   00129| 
   00130|   ladder:
   00131|     name: Agent CLI ladder ${{ matrix.leg.id }}
   00132|     needs: [plan]
   00133|     if: ${{ needs.plan.outputs.already-green != 'true' }}
   00134|     runs-on: ubuntu-latest
   00135|     # The previous 63-node serial walk is now at most two leaves or one
   00136|     # requirement per leg. Keep a generous exception while real cold/all-mode
   00137|     # observations establish the 30-minute retirement criterion. With the
   00138|     # artifact-fed composite wave, the static workflow DAG remains 225 minutes.
   00139|     timeout-minutes: 135
   00140|     strategy:
   00141|       fail-fast: false
   00142|       matrix:
   00143|         leg: ${{ fromJSON(needs.plan.outputs.legs) }}
   00144|     env:
   00145|       TREE_DEPTH: ${{ matrix.leg.depth }}
   00146|       NODE_FILTER: ${{ matrix.leg.filter }}
   00147|       # A fresh directory, not the committed evidence under docs/: the compare
   00148|       # job joins exactly what this leg measured.
   00149|       OUT: ${{ github.workspace }}/agent-tree-run
   00150|       LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: "false"
   00151|       AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00152|     steps:
   00153|       - uses: actions/checkout@v7
   00154|         with:
   00155|           persist-credentials: false
   00156| 
   00157|       - name: Setup Bun
   00158|         uses: oven-sh/setup-bun@v2
   00159|         with:
   00160|           bun-version-file: .bun-version
   00161|           no-cache: true
   00162| 
   00163|       # Each leaf's edit is compiled by verify-node.sh; the dependency crates
   00164|       # are the same on every leg, so the first leaf of each leg restores them
   00165|       # from the shared compiler cache instead of compiling them cold.
   00166|       - uses: ./.github/actions/setup-sccache
   00167| 
   00168|       # verify-node.sh compiles every leaf's edit, so the toolchain must meet
   00169|       # the crate's rust-version whether or not the binary came from cache:
   00170|       # formal-ai-binary installs one only on a cache miss, and a runner image
   00171|       # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run
   00172|       # 37710079109) although their edits were valid.
   00173|       - name: Setup Rust
   00174|         uses: dtolnay/rust-toolchain@stable
   00175| 
   00176|       - uses: ./.github/actions/formal-ai-binary
   00177|         if: ${{ inputs.skip_build != true }}
   00178| 
   00179|       - name: Install pinned Agent CLI
   00180|         run: bun add -g @link-assistant/agent@0.26.0
   00181| 
   00182|       - name: Run recursive Agent CLI tree
   00183|         id: tree
   00184|         env:
   00185|           AGENT: agent
   00186|         run: experiments/issue_1028_agent_cli_ladder/run.sh
   00187| 
   00188|       - name: Show the Agent CLI evidence on failure
   00189|         if: failure()
   00190|         run: scripts/dump-agent-cli-evidence.sh "$OUT"
   00191| 
   00192|       - name: Upload tree evidence
   00193|         if: ${{ always() }}
   00194|         uses: actions/upload-artifact@v7
   00195|         with:
   00196|           name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}
   00197|           path: ${{ github.workspace }}/agent-tree-run
   00198|           retention-days: 3
   00199|           if-no-files-found: error
   00200| 
   00201|   leaf-evidence:
   00202|     name: Validate the current-run leaf evidence
   00203|     needs: [plan, ladder]
   00204|     if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}
   00205|     runs-on: ubuntu-latest
   00206|     timeout-minutes: 15
   00207|     env:
   00208|       NODE_FILTER: ${{ inputs.node_filter || '' }}
   00209|     steps:
   00210|       - uses: actions/checkout@v7
   00211|         with:
   00212|           persist-credentials: false
   00213|       - name: Every primary leg measured its nodes
   00214|         env:
   00215|           NEEDS_JSON: ${{ toJSON(needs) }}
   00216|           JOBS: plan ladder
   00217|           CHECK: Agent CLI ladder primary wave
   00218|         run: bash scripts/check-shard-results.sh
   00219|       - name: Download exactly the measured leaf legs
   00220|         uses: actions/download-artifact@v8
   00221|         env:
   00222|           NODE_OPTIONS: --disable-warning=DEP0005
   00223|         with:
   00224|           pattern: issue-1028-agent-cli-binary-tree-depth-5-*
   00225|           path: ${{ runner.temp }}/leaf-legs
   00226|       - name: Validate and join the complete leaf dependency set
   00227|         run: |
   00228|           set -euo pipefail
   00229|           python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 "$NODE_FILTER" > "$RUNNER_TEMP/leaf-plan.json"
   00230|           count=$(jq '.legs | length' "$RUNNER_TEMP/leaf-plan.json")
   00231|           export LADDER_SOURCE_COMMIT="$(git rev-parse HEAD)"
   00232|           export LADDER_SOURCE_TREE="$(git rev-parse 'HEAD^{tree}')"
   00233|           python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \
   00234|             "$RUNNER_TEMP/leaf-legs" "$RUNNER_TEMP/current-leaves" "$count" "$RUNNER_TEMP/leaf-plan.json"
   00235|       - name: Upload validated leaves for the composite wave
   00236|         uses: actions/upload-artifact@v7
   00237|         with:
   00238|           name: issue-1028-agent-cli-current-leaves
   00239|           path: ${{ runner.temp }}/current-leaves
   00240|           retention-days: 3
   00241|           if-no-files-found: error
   00242| 
   00243|   composites:
   00244|     name: Agent CLI composite ${{ matrix.leg.id }}
   00245|     needs: [plan, leaf-evidence]
   00246|     if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}
   00247|     runs-on: ubuntu-latest
   00248|     # One composite per machine; verification consumes only the current
   00249|     # run's two validated child effects and diffs.
   00250|     timeout-minutes: 30
   00251|     strategy:
   00252|       fail-fast: false
   00253|       matrix:
   00254|         leg: ${{ fromJSON(needs.plan.outputs.composites) }}
   00255|     env:
   00256|       TREE_DEPTH: ${{ matrix.leg.depth }}
   00257|       NODE_FILTER: ${{ matrix.leg.filter }}
   00258|       # A fresh directory, not the committed evidence under docs/: the compare
   00259|       # job joins exactly what this leg measured.
   00260|       OUT: ${{ github.workspace }}/agent-tree-run
   00261|       LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: "false"
   00262|       AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00263|     steps:
   00264|       - uses: actions/checkout@v7
   00265|         with:
   00266|           persist-credentials: false
   00267| 
   00268|       - name: Setup Bun
   00269|         uses: oven-sh/setup-bun@v2
   00270|         with:
   00271|           bun-version-file: .bun-version
   00272|           no-cache: true
   00273| 
   00274|       # Each leaf's edit is compiled by verify-node.sh; the dependency crates
   00275|       # are the same on every leg, so the first leaf of each leg restores them
   00276|       # from the shared compiler cache instead of compiling them cold.
   00277|       - uses: ./.github/actions/setup-sccache
   00278| 
   00279|       # verify-node.sh compiles every leaf's edit, so the toolchain must meet
   00280|       # the crate's rust-version whether or not the binary came from cache:
   00281|       # formal-ai-binary installs one only on a cache miss, and a runner image
   00282|       # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run
   00283|       # 37710079109) although their edits were valid.
   00284|       - name: Setup Rust
   00285|         uses: dtolnay/rust-toolchain@stable
   00286| 
   00287|       - uses: ./.github/actions/formal-ai-binary
   00288|         if: ${{ inputs.skip_build != true }}
   00289| 
   00290|       - name: Install pinned Agent CLI
   00291|         run: bun add -g @link-assistant/agent@0.26.0
   00292| 
   00293|       - name: Download validated current-run leaves
   00294|         uses: actions/download-artifact@v8
   00295|         env:
   00296|           NODE_OPTIONS: --disable-warning=DEP0005
   00297|         with:
   00298|           name: issue-1028-agent-cli-current-leaves
   00299|           path: ${{ runner.temp }}/current-leaves
   00300| 
   00301|       - name: Run recursive Agent CLI tree
   00302|         id: tree
   00303|         env:
   00304|           AGENT: agent
   00305|           LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves
   00306|           TEST_BUDGET_SECONDS: 1200
   00307|         run: |
   00308|           scripts/run-with-budget-warning.sh \
   00309|             "$TEST_BUDGET_SECONDS" "Agent CLI composite verification" \
   00310|             experiments/issue_1028_agent_cli_ladder/run.sh
   00311| 
   00312|       - name: Show the Agent CLI evidence on failure
   00313|         if: failure()
   00314|         run: scripts/dump-agent-cli-evidence.sh "$OUT"
   00315| 
   00316|       - name: Upload tree evidence
   00317|         if: ${{ always() }}
   00318|         uses: actions/upload-artifact@v7
   00319|         with:
   00320|           name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}
   00321|           path: ${{ github.workspace }}/agent-tree-run
   00322|           retention-days: 3
   00323|           if-no-files-found: error
   00324| 
   00325|   compare:
   00326|     name: Compare the measured ladder with the record
   00327|     needs: [plan, ladder, leaf-evidence, composites]
   00328|     # Not `always()`: a run superseded by a newer push is the one
   00329|     # cancellation that is not a defect, and it skips the verdict.
   00330|     if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}
   00331|     runs-on: ubuntu-latest
   00332|     timeout-minutes: 15
   00333|     env:
   00334|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00335|       NODE_FILTER: ${{ inputs.node_filter || '' }}
   00336|       OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run
   00337|     steps:
   00338|       - uses: actions/checkout@v7
   00339|         with:
   00340|           persist-credentials: false
   00341| 
   00342|       # Enabled off, recording on: this job never skips, and its own success
   00343|       # is what marks these inputs green for the plan job's next lookup.
   00344|       - name: Record the verdict for these inputs
   00345|         uses: ./.github/actions/green-ledger
   00346|         with:
   00347|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00348|           paths: >-
   00349|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00350|           enabled: 'false'
   00351| 
   00352|       - name: Every ladder leg finished
   00353|         env:
   00354|           NEEDS_JSON: ${{ toJSON(needs) }}
   00355|           JOBS: plan ladder
   00356|           CHECK: Agent CLI ladder
   00357|           COMPOSITE_LEGS: ${{ needs.plan.outputs.composites }}
   00358|         run: |
   00359|           if [[ "$COMPOSITE_LEGS" != '[]' ]]; then
   00360|             export JOBS="$JOBS leaf-evidence composites"
   00361|           fi
   00362|           bash scripts/check-shard-results.sh
   00363| 
   00364|       - name: Download every leg's evidence
   00365|         uses: actions/download-artifact@v8
   00366|         env:
   00367|           # v8's bundled unzip dependency still calls Buffer(); suppress only
   00368|           # that reviewed upstream diagnostic, never all Node warnings:
   00369|           # https://github.com/actions/download-artifact/issues/484
   00370|           NODE_OPTIONS: --disable-warning=DEP0005
   00371|         with:
   00372|           pattern: issue-1028-agent-cli-binary-tree-*
   00373|           path: ${{ runner.temp }}/agent-tree-legs
   00374| 
   00375|       # The committed evidence under $OUT is a previous run's; the joined run
   00376|       # replaces it so nothing stale is compared or uploaded.
   00377|       - name: Join the legs into one run
   00378|         env:
   00379|           LEG_COUNT: ${{ needs.plan.outputs.leg-count }}
   00380|         run: |
   00381|           set -euo pipefail
   00382|           rm -rf "$OUT"
   00383|           export LADDER_SOURCE_COMMIT="$(git rev-parse HEAD)"
   00384|           export LADDER_SOURCE_TREE="$(git rev-parse 'HEAD^{tree}')"
   00385|           python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py "$TREE_DEPTH" "$NODE_FILTER" > "$RUNNER_TEMP/ladder-plan.json"
   00386|           python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \
   00387|             "$RUNNER_TEMP/agent-tree-legs" "$OUT" "$LEG_COUNT" "$RUNNER_TEMP/ladder-plan.json"
   00388| 
   00389|       # A ladder that ran and measured fewer leaves than the record is still
   00390|       # compared -- that is the regression this gate exists to catch.
   00391|       - name: Compare the measured ladder with the record
   00392|         run: |
   00393|           set -euo pipefail
   00394|           result="$OUT/ladder-result.lino"
   00395|           [[ -f "$result" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }
   00396|           field() { sed -n "s/^  $1 \"\(.*\)\"$/\1/p" "$result"; }
   00397|           recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)
   00398|           measured_leaves=$(field leaf_nodes_passing)
   00399|           selected_leaves=$(field leaf_nodes_selected)
   00400|           authored_rules_enabled=$(field authored_rules_enabled)
   00401|           echo "leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves"
   00402|           cat "$result" >> "$GITHUB_STEP_SUMMARY"
   00403|           # Only a full-width run is comparable with the record: a filtered or
   00404|           # shallower run selects fewer leaves and would always look worse.
   00405|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == true ]]; then
   00406|             if (( measured_leaves < recorded_leaves )); then
   00407|               echo "::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes."
   00408|               exit 1
   00409|             fi
   00410|             if (( measured_leaves > recorded_leaves )); then
   00411|               echo "::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit"
   00412|             fi
   00413|           fi
   00414|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == false ]]; then
   00415|             measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)
   00416|             recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)
   00417|             if [[ "$recorded_without_rules" == not_measured ]]; then
   00418|               echo "::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino"
   00419|               exit 1
   00420|             fi
   00421|             if (( measured_without_rules < recorded_without_rules )); then
   00422|               echo "::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules"
   00423|               exit 1
   00424|             fi
   00425|             if (( measured_without_rules > recorded_without_rules )); then
   00426|               echo "::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit"
   00427|             fi
   00428|           fi
   00429|           if [[ "$TREE_DEPTH" == all ]]; then
   00430|             deepest=$(field deepest_passing_level)
   00431|             recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)
   00432|             echo "deepest passing level: recorded $recorded_depth, this run $deepest"
   00433|             if [[ "$recorded_depth" != none && "$deepest" == none ]]; then
   00434|               echo "::error::no level passed completely; the record is level $recorded_depth"
   00435|               exit 1
   00436|             fi
   00437|             if [[ "$recorded_depth" != none && "$deepest" != none ]] && (( deepest < recorded_depth )); then
   00438|               echo "::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)"
   00439|               exit 1
   00440|             fi
   00441|           fi
   00442| 
