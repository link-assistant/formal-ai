   00246| fn plan_event_append_command(plan: &GeneralChangePlan) -> String {
   00247|     let event = plan.links_notation();
   00248|     let identity = event.lines().nth(1).unwrap_or_default();
   00249|     let path = super::general_planner::shell_quote(PLAN_PATH);
   00250|     let identity = super::general_planner::shell_quote(identity);
   00251|     let event = super::general_planner::shell_quote(&event);
   00252|     super::work_item_steps::fill(
   00253|         "plan-event-append-command",
   00254|         &[
   00255|             (
   00256|                 concat!("{", "lock_path", "}"),
   00257|                 &super::general_planner::shell_quote(&format!("{PLAN_PATH}.lock")),
   00258|             ),
   00259|             ("{path}", &path),
   00260|             (concat!("{", "identity", "}"), &identity),
   00261|             (concat!("{", "event", "}"), &event),
   00262|         ],
   00263|     )
   00264| }
