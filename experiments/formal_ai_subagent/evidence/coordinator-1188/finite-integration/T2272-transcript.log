   00613| fn finish_general_change(
   00614|     plan: &GeneralChangePlan,
   00615|     progress: &Progress,
   00616|     resolved_from_work_item: bool,
   00617|     result: &mut Option<FinalResult>,
   00618| ) -> AgenticPlan {
   00619|     if plan.mode == GeneralPlanMode::RepositoryWorkItem {
   00620|         return record(
   00621|             AgenticPlan::Final(plan.planned_not_executed_answer()),
   00622|             FinalDisposition::Gap,
   00623|             "repository_work_not_executed",
   00624|             result,
   00625|         );
   00626|     }
   00627|     // The workspace gets the last word over a completion claim: a verification
   00628|     // command that exited non-zero replaces the claim with its own report.
   00629|     if let Some(report) = progress
   00630|         .latest_run_output_for(&plan.verification_command)
   00631|         .filter(|output| !literal_verification_matches(plan, output))
   00632|         .and_then(|output| {
   00633|             tool_result::failed_verification(
   00634|                 std::slice::from_ref(output),
   00635|                 &plan.verification_command,
   00636|                 &plan.goal,
   00637|             )
   00638|         })
   00639|     {
   00640|         return AgenticPlan::Final(report);
   00641|     }
   00642|     if progress.successful_run_count_for(&plan.verification_command) == 0 {
   00643|         return AgenticPlan::Final(general_plan_unverified(plan));
   00644|     }
   00645|     if plan.mode == GeneralPlanMode::LiteralFile {
   00646|         let observed = progress
   00647|             .latest_successful_run_output_for(&plan.verification_command)
   00648|             .and_then(tool_result::observed_payload);
   00649|         let exact_literal = progress
   00650|             .latest_successful_run_output_for(&plan.verification_command)
   00651|             .is_some_and(|output| literal_verification_matches(plan, output));
   00652|         if !exact_literal && observed.as_deref().map(str::trim) != Some(plan.content.trim()) {
   00653|             return AgenticPlan::Final(general_plan_mismatch(
   00654|                 plan,
   00655|                 observed.as_deref().unwrap_or_default(),
   00656|             ));
   00657|         }
   00658|     }
   00659|     if resolved_from_work_item && plan.mode == GeneralPlanMode::LiteralFile {
   00660|         return record(
   00661|             AgenticPlan::Final(work_item_completion(plan, progress)),
   00662|             FinalDisposition::Finding,
   00663|             "work_item_completion_verified",
   00664|             result,
   00665|         );
   00666|     }
   00667|     record(
   00668|         AgenticPlan::Final(general_plan_completed(plan)),
   00669|         FinalDisposition::Finding,
   00670|         "general_plan_completed_verified",
   00671|         result,
   00672|     )
   00673| }
