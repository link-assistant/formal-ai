   00145|             && progress.previous_attempt().is_some_and(|previous| {
   00146|                 previous.capability == Capability::Write && !previous.succeeded
   00147|             });
   00148|         if !recovering_missing_write {
   00149|             return AgenticPlan::Final(tool_result::render_failure(
   00150|                 capability_label(failure.capability),
   00151|                 &failure.detail,
   00152|                 &plan.goal,
   00153|             ));
   00154|         }
   00155|     }
