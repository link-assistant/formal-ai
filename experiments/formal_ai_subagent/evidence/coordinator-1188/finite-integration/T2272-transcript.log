   00161|         && let (Some(tool), Some(arguments)) = (
   00162|             tool_for(tool_names, Capability::Write),
   00163|             progress
   00164|                 .previous_attempt()
   00165|                 .and_then(|attempt| attempt.arguments.as_deref()),
   00166|         )
