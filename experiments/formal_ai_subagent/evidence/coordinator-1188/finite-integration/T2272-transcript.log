   00273| fn plan_event_step(
   00274|     plan: &GeneralChangePlan,
   00275|     progress: &Progress,
   00276|     tool_names: &[&str],
   00277| ) -> Option<AgenticPlan> {
   00278|     let event = plan.links_notation();
   00279|     let identity = event.lines().nth(1).unwrap_or_default();
   00280|     let run = shell_command_tool(tool_names);
   00281|     let aliases = super::work_item_steps::fill("plan-event-shell-aliases", &[]);
   00282|     let atomic_shell = run.is_some_and(|name| {
   00283|         let leaf = name
   00284|             .rsplit("__")
   00285|             .next()
   00286|             .unwrap_or(name)
   00287|             .rsplit(['.', '/', ':'])
   00288|             .next()
   00289|             .unwrap_or(name);
   00290|         aliases
   00291|             .split_whitespace()
   00292|             .any(|alias| leaf.eq_ignore_ascii_case(alias))
   00293|     });
   00294|     if let (Some(read), Some(write)) = (
   00295|         tool_for(tool_names, Capability::Read),
   00296|         tool_for(tool_names, Capability::Write),
   00297|     ) && !atomic_shell
   00298|     {
   00299|         let prior = progress
   00300|             .successful_read_output_for(PLAN_PATH)
   00301|             .map(super::code_artifact::source_from_read_result);
   00302|         if let Some(expected) = progress.successful_write_content_for(PLAN_PATH) {
   00303|             if prior
   00304|                 .as_deref()
   00305|                 .is_some_and(|prior| prior.starts_with(&expected))
   00306|             {
   00307|                 return None;
   00308|             }
   00309|             if progress.last() == Some(Capability::Read)
   00310|                 && progress
   00311|                     .latest_successful_arguments(Capability::Read)
   00312|                     .and_then(tool_argument_path)
   00313|                     .as_deref()
   00314|                     == Some(PLAN_PATH)
   00315|             {
   00316|                 return Some(unverified_plan_event(plan));
   00317|             }
   00318|             return Some(plan_one(read, read_arguments(PLAN_PATH)));
   00319|         }
   00320|         if prior
   00321|             .as_deref()
   00322|             .is_some_and(|prior| prior.lines().any(|line| line == identity))
   00323|         {
   00324|             return (!prior.as_deref().is_some_and(|prior| prior.contains(&event)))
   00325|                 .then(|| unverified_plan_event(plan));
   00326|         }
   00327|         let missing = progress.latest_failure().is_some_and(|failure| {
   00328|             failure.capability == Capability::Read
   00329|                 && failure
   00330|                     .arguments
   00331|                     .as_deref()
   00332|                     .and_then(tool_argument_path)
   00333|                     .as_deref()
   00334|                     == Some(PLAN_PATH)
   00335|                 && absent_plan_event(&failure.detail)
   00336|         });
   00337|         if prior.is_none() && !missing {
   00338|             return Some(plan_one(read, read_arguments(PLAN_PATH)));
   00339|         }
   00340|         let mut stream = prior.unwrap_or_default();
   00341|         if !stream.is_empty() && !stream.ends_with('\n') {
   00342|             stream.push('\n');
   00343|         }
   00344|         stream.push_str(&event);
   00345|         return Some(plan_one(write, write_arguments(PLAN_PATH, &stream)));
   00346|     }
   00347|     let Some(run) = run else {
   00348|         return Some(AgenticPlan::Final(plan.planned_not_executed_answer()));
   00349|     };
   00350|     let append = plan_event_append_command(plan);
   00351|     if progress.successful_run_count_for(&append) == 0 {
   00352|         return Some(plan_one(run, json!({"command": append}).to_string()));
   00353|     }
   00354|     let observed = progress
   00355|         .latest_successful_run_output_for(&append)
   00356|         .and_then(tool_result::observed_payload);
   00357|     (!observed.is_some_and(|observed| observed.contains(event.trim_end())))
   00358|         .then(|| unverified_plan_event(plan))
   00359| }
