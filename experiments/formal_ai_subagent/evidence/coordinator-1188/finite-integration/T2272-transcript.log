   00519| /// The REST segments of a GitHub work-item URL — `{owner}`, `{repo}`, the REST
   00520| /// spelling of the kind (`issues` / `pulls`), and the number. `None` for a
   00521| /// URL that is not one, in which case the REST fallbacks are simply not
   00522| /// planned for it.
   00523| fn rest_segments(target: &str) -> Option<(String, String, &'static str, String)> {
   00524|     let mut segments = target.trim_end_matches('/').rsplit('/');
   00525|     let number = segments.next()?.to_owned();
   00526|     let kind = match segments.next()? {
   00527|         "issue" | "issues" => "issues",
   00528|         "pull" | "pulls" => "pulls",
   00529|         _ => return None,
   00530|     };
   00531|     let repo = segments.next()?.to_owned();
   00532|     let owner = segments.next()?.to_owned();
   00533|     (!number.is_empty() && number.chars().all(|character| character.is_ascii_digit()))
   00534|         .then_some((owner, repo, kind, number))
   00535| }
