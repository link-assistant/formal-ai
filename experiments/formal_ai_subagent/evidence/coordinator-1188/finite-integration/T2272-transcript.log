   00042| fn general_change_step(
   00043|     messages: &[ChatMessage],
   00044|     tool_names: &[&str],
   00045|     plan: &GeneralChangePlan,
   00046|     resolved_from_work_item: bool,
   00047|     result: &mut Option<FinalResult>,
   00048| ) -> AgenticPlan {
   00049|     // A literal-file write reads its target first unless the request names a
   00050|     // whole-file write, and never replaces an existing file unasked (PR #1188 T96).
   00051|     if let Some(guarded) = super::literal_write_guard::guarded_step(plan, messages, tool_names) {
   00052|         return guarded;
   00053|     }
   00054|     let progress = Progress::scan(messages);
   00055|     // Reading the work item is an attempt to find out whether anything *can* be
   00056|     // executed, not a step the request named. A read that comes back missing or
   00057|     // empty therefore answers that question — the capability is unavailable —
   00058|     // and the run continues to record the reference. Reporting the fetch as the
   00059|     // run's failure would replace the honest terminal state of issue #904 with
   00060|     // a transport message about a URL the user never asked to see.
   00061|     let work_item_unreadable = plan.mode == GeneralPlanMode::RepositoryWorkItem
   00062|         && progress.latest_failure().is_some_and(|failure| {
   00063|             failure.capability == Capability::Fetch || failure.is_work_item_read()
   00064|         });
   00065|     let target_missing = progress.latest_failure().is_some_and(|failure| {
   00066|         super::literal_write_guard::is_guard_read(
   00067|             plan,
   00068|             failure
   00069|                 .arguments
   00070|                 .as_deref()
   00071|                 .and_then(tool_argument_path)
   00072|                 .as_deref(),
   00073|             failure.capability,
   00074|         )
   00075|     });
   00076|     let event_missing = progress.latest_failure().is_some_and(|failure| {
   00077|         failure.capability == Capability::Read
   00078|             && failure
   00079|                 .arguments
   00080|                 .as_deref()
   00081|                 .and_then(tool_argument_path)
   00082|                 .as_deref()
   00083|                 == Some(PLAN_PATH)
   00084|             && absent_plan_event(&failure.detail)
   00085|     });
   00086|     if let Some(failure) = progress
   00087|         .latest_failure()
   00088|         .filter(|_| !work_item_unreadable && !target_missing && !event_missing)
   00089|     {
   00090|         if failure.capability == Capability::Write {
   00091|             let path = failure.arguments.as_deref().and_then(tool_argument_path);
   00092|             if let (Some(path), Some(read_tool)) =
   00093|                 (path.as_deref(), tool_for(tool_names, Capability::Read))
   00094|                 && progress.failed_write_count_for(path) == 1
   00095|             {
   00096|                 return plan_one(read_tool, read_arguments(path));
   00097|             }
