   00675| /// The completion a resolved work item earns: the harness voice the execution
   00676| /// recipe already uses — the artifact created, the command that verified it,
   00677| /// the output that command produced. A literal file the work item spelled out
   00678| /// is an artifact whose side effects belong to the requesting client, so it is
   00679| /// reported through the same recipe shape a composed program is (issue #1133,
   00680| /// the literal-file run). A task the user typed into the conversation keeps
   00681| /// the seeded conversational claim; its words are pinned by issues #905
   00682| /// and #916.
   00683| fn work_item_completion(plan: &GeneralChangePlan, progress: &Progress) -> String {
   00684|     let recipe = crate::engine::ExecutionRecipe {
   00685|         language: "text".to_owned(),
   00686|         source: plan.content.clone(),
   00687|         path: plan.target.clone(),
   00688|         supporting_files: Vec::new(),
   00689|         commands: vec![plan.verification_command.clone()],
   00690|     };
   00691|     let outputs = progress
   00692|         .latest_successful_run_output_for(&plan.verification_command)
   00693|         .map(|output| vec![output.to_owned()])
   00694|         .unwrap_or_default();
   00695|     recipe.final_answer(&outputs, None)
   00696| }
   00697| 
   00698| /// The completion claim is the sentence the issue quotes as the false report,
   00699| /// so it is seeded like every other outcome of this state machine rather than
   00700| /// typed into Rust: the words live in `data/seed/`, and the reply follows the
   00701| /// language the request was written in.
   00702| fn general_plan_completed(plan: &GeneralChangePlan) -> String {
   00703|     let language = crate::language::detect(&plan.goal).slug();
   00704|     let mut answer =
   00705|         crate::seed::localized_response("general_plan_completed", language).unwrap_or_default();
   00706|     answer = answer.replace("{target}", &plan.target);
   00707|     answer = answer.replace("{command}", &plan.verification_command);
   00708|     answer = answer.replace(PLAN_PATH_PLACEHOLDER, PLAN_PATH);
   00709|     answer.replace(
   00710|         PLAN_PLACEHOLDER,
   00711|         &crate::issue_report::fenced_block(
   00712|             crate::issue_report::LINO_FENCE_LANGUAGE,
   00713|             &plan.links_notation(),
   00714|         ),
   00715|     )
   00716| }
