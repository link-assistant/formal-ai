   00408| /// The step that reads the work item, through whichever client tool reaches it.
   00409| ///
   00410| /// GitHub's structured CLI read comes first when the client can run it. Unlike
   00411| /// model-backed `WebFetch` tools, it returns source bytes rather than asking a
   00412| /// nested model to interpret the whole solve request. This keeps the read in
   00413| /// the checkout's credential and prevents a fetched issue from being solved
   00414| /// once inside the fetch tool and then misread as issue text by the outer plan.
   00415| ///
   00416| /// A client with no run capability falls back to its fetch tool. That call
   00417| /// carries a data-declared extraction instruction rather than the user's solve
   00418| /// request, so required `prompt` fields cannot recursively execute the task.
   00419| /// A protocol-hosted fetch tool runs server-side, so the fetch itself is the
   00420| /// read and `gh` is never planned ahead of it (issue #904).
   00421| fn plan_work_item_read(
   00422|     messages: &[ChatMessage],
   00423|     tool_names: &[&str],
   00424|     target: &str,
   00425|     progress: &Progress,
   00426| ) -> Option<AgenticPlan> {
   00427|     let fetch = tool_for(tool_names, Capability::Fetch);
   00428|     if fetch.is_some_and(super::capability_router::is_hosted_research_tool) {
   00429|         return fetch
   00430|             .filter(|_| !progress.attempted_fetch_of(target))
   00431|             .map(|tool| plan_one(tool, work_item_fetch_arguments(target)));
   00432|     }
   00433|     if !progress.attempted_work_item_read_of(target)
   00434|         && let Some(run) = shell_command_tool(tool_names)
   00435|     {
   00436|         return Some(plan_one(
   00437|             run,
   00438|             json!({ "command": issue_view_command(target) }).to_string(),
   00439|         ));
   00440|     }
   00441|     // A read that failed — or one a client echoed without its status, which
   00442|     // the sentinel now exposes (issue #1155) — must not end the retrieval
   00443|     // while another route to the same text is untried. The fallbacks walk in
   00444|     // the issue's order: the client's fetch tool on the issue URL, the
   00445|     // credential-free REST read (`curl` needs no `gh` and no token for a
   00446|     // public repository — exactly the case an unauthenticated `gh` used to
   00447|     // end a session for), the authenticated REST read, and last the prepared
   00448|     // pull request's own page, whose title and body restate the issue.
   00449|     if !progress.attempted_fetch_of(target)
   00450|         && let Some(tool) = fetch
   00451|     {
   00452|         return Some(plan_one(tool, work_item_fetch_arguments(target)));
   00453|     }
   00454|     if let Some(run) = shell_command_tool(tool_names) {
   00455|         for fallback in [
   00456|             issue_rest_read_command(target),
   00457|             issue_api_read_command(target),
   00458|         ]
   00459|         .into_iter()
   00460|         .flatten()
   00461|         {
   00462|             if !progress.has_run(&fallback) {
   00463|                 return Some(plan_one(run, json!({ "command": fallback }).to_string()));
   00464|             }
   00465|         }
   00466|     }
   00467|     if let Some(prepared_pull) = prepared_pull_reference(messages)
   00468|         && prepared_pull != target
   00469|         && !progress.attempted_fetch_of(&prepared_pull)
   00470|         && let Some(tool) = fetch
   00471|     {
   00472|         return Some(plan_one(tool, work_item_fetch_arguments(&prepared_pull)));
   00473|     }
   00474|     None
   00475| }
   00476| 
   00477| /// The pull-request URL the prompt names beside the work item ("Your prepared
   00478| /// Pull Request: …"), when it names one. It is the last resort of the read
   00479| /// fallbacks (issue #1155): the PR's title and body restate the issue it
   00480| /// resolves.
