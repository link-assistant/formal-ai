   00361| /// Plan the next step from what the fetched work item actually asks for.
   00362| ///
   00363| /// The real corpus decides the shape here. The issues Hive Mind dispatches say
   00364| /// *"implement a Hello World program in Scala"* — a described artifact in a
   00365| /// named language, not literal bytes — so the same coding catalog that answers
   00366| /// that request when a user types it directly answers it here, through the
   00367| /// execution recipe its [`SymbolicAnswer`](crate::solver::SymbolicAnswer)
   00368| /// carries. The literal-file composer follows, for a work item that does spell
   00369| /// out a path and its contents.
   00370| ///
   00371| /// Returning [`None`] means the work item named nothing this sandbox can
   00372| /// produce — an unsupported language, or prose with no artifact in it at all —
   00373| /// which keeps `planned_not_executed` truthful rather than inventing an
   00374| /// artifact the issue never asked for.
   00375| fn plan_work_item_execution(
   00376|     objective: &str,
   00377|     messages: &[ChatMessage],
   00378|     tool_names: &[&str],
   00379| ) -> Option<AgenticPlan> {
   00380|     // The default configuration is the right one: the recipe wanted here is the
   00381|     // same `write_program` answer a user typing this request directly would get,
   00382|     // and the client — not this solver — owns execution. Opting into agent mode
   00383|     // would only add the policy branches that answer *about* agent actions.
   00384|     let mut answer = crate::solver::UniversalSolver::default().solve(objective);
   00385|     // The issue that asks for the program may also ask for the workflow that
   00386|     // runs it (issue #1133, requirement 6 of every Hello World task): the
   00387|     // recipe then carries the workflow as a supporting file, running the same
   00388|     // commands the harness verifies.
   00389|     if let Some(recipe) = answer.execution_recipe.as_mut()
   00390|         && super::ci_workflow::requested_in(objective)
   00391|     {
   00392|         super::ci_workflow::attach(recipe);
   00393|     }
   00394|     if let Some(step) =
   00395|         super::command_reroute::plan_symbolic_command_reroute(messages, tool_names, &answer)
   00396|     {
   00397|         return Some(step);
   00398|     }
   00399|     let executable = compose_general_change_plan(objective)
   00400|         .filter(|executable| executable.mode != GeneralPlanMode::RepositoryWorkItem)?;
   00401|     Some(plan_work_item_change_step(
   00402|         messages,
   00403|         tool_names,
   00404|         &executable,
   00405|     ))
   00406| }
