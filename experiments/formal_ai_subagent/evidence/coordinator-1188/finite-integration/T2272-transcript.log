   00132|             && let Some(output) = progress.latest_run_output_for(&plan.verification_command)
   00133|             && let Some(report) = tool_result::failed_verification(
   00134|                 std::slice::from_ref(output),
   00135|                 &plan.verification_command,
   00136|                 &plan.goal,
   00137|             )
   00138|         {
   00139|             return AgenticPlan::Final(report);
   00140|         }
