   00099|             // the preferred read-before-retry recovery, but its failure must
   00100|             // not swallow the user's primary literal-file write.
   00101|             if path.as_deref() == Some(PLAN_PATH)
   00102|                 && plan.mode == GeneralPlanMode::LiteralFile
   00103|                 && tool_for(tool_names, Capability::Read).is_none()
   00104|                 && progress.failed_write_count_for(PLAN_PATH) == 1
   00105|                 && let Some(write_tool) = tool_for(tool_names, Capability::Write)
   00106|             {
   00107|                 return plan_one(write_tool, write_arguments(&plan.target, &plan.content));
   00108|             }
   00109|             // Recovery is exhausted, but the failed call is not the last word:
   00110|             // run the check the plan itself named so the report can carry the
   00111|             // status the workspace answered with rather than a transport
   00112|             // message alone (issue #916, rung R916-01).
