   00604| // Exact declared data can describe failures without reporting an execution failure.
   00605| // Explicit harness errors and nonzero status always remain authoritative.
   00606| fn literal_verification_matches(plan: &GeneralChangePlan, output: &str) -> bool {
   00607|     plan.mode == GeneralPlanMode::LiteralFile
   00608|         && !tool_result::harness_reported_failure(output)
   00609|         && tool_result::reported_exit_code(output).is_none_or(|code| code == 0)
   00610|         && output.trim() == plan.content.trim()
   00611| }
