   00114|                 && !plan.verification_command.trim().is_empty()
   00115|                 && progress.run_count_for(&plan.verification_command) == 0
   00116|                 && let Some(run_tool) = shell_command_tool(tool_names)
   00117|             {
   00118|                 return plan_one(
   00119|                     run_tool,
   00120|                     json!({ "command": plan.verification_command }).to_string(),
   00121|                 );
   00122|             }
   00123|             return AgenticPlan::Final(tool_result::render_failure(
   00124|                 path.as_deref().unwrap_or("write"),
   00125|                 &failure.detail,
   00126|                 &plan.goal,
   00127|             ));
   00128|         }
   00129|         // A failed run is reported as the command that failed and the status it
   00130|         // exited with, not as an anonymous "run" step (issues #905 and #908).
