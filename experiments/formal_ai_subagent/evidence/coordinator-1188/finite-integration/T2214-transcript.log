   00001| name: Issue 1028 Agent CLI binary-tree ladder
   00002| 
   00003| # Issue #1085 (D4): the ladder runs on pull requests that touch it or the
   00004| # agentic coding modules (leaf level), weekly over every level, and on
   00005| # dispatch. The deepest level whose nodes all pass is compared with
   00006| # data/meta/ladder-ratchet.lino and may only move deeper.
   00007| #
   00008| # PR #1188: the depth-five run measured its 32 leaves one after another in one
   00009| # job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).
   00010| # Leaves are independent -- each starts from a reset worktree and only a
   00011| # depth-4 composite reads its children's effects -- so the default run is now
   00012| #   plan     consults the green ledger (lookup only), warms the binary cache
   00013| #            and lists the legs: sixteen depth-4 subtrees of two leaves each
   00014| #            for the whole depth-five tree, one leg for anything else;
   00015| #   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;
   00016| #   compare  green only when every leg succeeded (check-shard-results.sh), the
   00017| #            legs join into one run (combine-shards.py refuses a missing or
   00018| #            overlapping leg), and that run holds the recorded ratchet. Its
   00019| #            success, not the plan's, records the inputs green.
   00020| # Weekly all mode measures every node in bounded independent legs. Leaves
   00021| # and requirement nodes run in parallel; depth-four composites consume this
   00022| # run's validated leaf effects and diffs in a second artifact-fed wave.
   00023| # The final join checks the exact 63-node plan, corpus and source identity.
   00024| on:
   00025|   # Issue #1187 R2: a bot pull request's checks start through dispatch
   00026|   # (.github/actions/dispatch-checks); mode and pull-request are its inputs.
   00027|   workflow_dispatch:
   00028|     inputs:
   00029|       mode:
   00030|         description: 'checks: run the pull-request checks on the dispatched branch'
   00031|         required: false
   00032|         default: checks
   00033|         type: choice
   00034|         options: [checks]
   00035|       pull-request:
   00036|         description: 'Pull request the dispatched checks report for'
   00037|         required: false
   00038|         default: ''
   00039|         type: string
   00040|       depth:
   00041|         description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'
   00042|         required: false
   00043|         default: '5'
   00044|         type: choice
   00045|         options: ['0', '1', '2', '3', '4', '5', 'all']
   00046|       node_filter:
   00047|         description: 'Optional node path (for example 2.1.2.2.1)'
   00048|         required: false
   00049|         default: ''
   00050|         type: string
   00051|       skip_build:
   00052|         description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'
   00053|         required: false
   00054|         default: false
   00055|         type: boolean
   00056|       authored_rules:
   00057|         description: 'Per-leaf authored mappings visible to the agent'
   00058|         required: false
   00059|         default: 'disabled'
   00060|         type: choice
   00061|         options: ['disabled', 'enabled']
   00062|   pull_request:
   00063|     # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request
   00064|     # never triggers this repository's own pipeline.
   00065|     branches-ignore: ['e2e/**']
   00066|     paths:
   00067|       - 'experiments/issue_1028_agent_cli_ladder/**'
   00068|       - 'rust/src/agentic_coding/**'
   00069|       - 'data/meta/ladder-ratchet.lino'
   00070|       - '.github/workflows/issue-1028-agent-ladder.yml'
   00071|   schedule:
   00072|     - cron: '23 3 * * 0'
   00073| 
   00074| permissions:
   00075|   contents: read
   00076| 
   00077| concurrency:
   00078|   group: issue-1028-agent-cli-binary-tree-${{ github.ref }}
   00079|   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
   00080| 
   00081| jobs:
   00082|   plan:
   00083|     name: Plan the Agent CLI ladder
   00084|     runs-on: ubuntu-latest
   00085|     timeout-minutes: 30
   00086|     outputs:
   00087|       already-green: ${{ steps.ledger.outputs.already-green }}
   00088|       legs: ${{ steps.plan.outputs.legs || '[]' }}
   00089|       leg-count: ${{ steps.plan.outputs.leg-count }}
   00090|     env:
   00091|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00092|       NODE_FILTER: ${{ inputs.node_filter || '' }}
   00093|     steps:
   00094|       - uses: actions/checkout@v7
   00095|         with:
   00096|           persist-credentials: false
   00097|       # Lookup only (`record: 'false'`): a green plan says nothing about the
   00098|       # ladder, so the compare job records the verdict for these inputs.
   00099|       - name: Skip when identical inputs already passed
   00100|         id: ledger
   00101|         uses: ./.github/actions/green-ledger
   00102|         with:
   00103|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00104|           paths: >-
   00105|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00106|           enabled: ${{ github.ref != 'refs/heads/main' }}
   00107|           record: 'false'
   00108| 
   00109|       - name: List the ladder legs
   00110|         id: plan
   00111|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00112|         run: |
   00113|           set -euo pipefail
   00114|           if [[ "$TREE_DEPTH" == 5 && -z "$NODE_FILTER" ]]; then
   00115|             # Every depth-4 node: the 32 leaves as sixteen pairs. 45 minutes
   00116|             # holds two leaves even when both compile cold and time out.
   00117|             legs=$(jq -cn '[range(0; 16)
   00118|               | [(. / 8 | floor) % 2 + 1, (. / 4 | floor) % 2 + 1, (. / 2 | floor) % 2 + 1, . % 2 + 1]
   00119|               | map(tostring) | join(".") | {filter: ., cap: 45}]')
   00120|           else
   00121|             legs=$(jq -cn --arg filter "$NODE_FILTER" '[{filter: $filter, cap: 180}]')
   00122|           fi
   00123|           echo "legs=$legs" >> "$GITHUB_OUTPUT"
   00124|           echo "leg-count=$(jq 'length' <<< "$legs")" >> "$GITHUB_OUTPUT"
   00125|           echo "$legs"
   00126| 
   00127|       # Reused across every workflow that only needs to *run* the binary: the
   00128|       # cache key is the content of the sources it is built from, so a push that
   00129|       # changed neither pays nothing (issue #1107). Warmed once here so every
   00130|       # leg restores it instead of each compiling it.
   00131|       - uses: ./.github/actions/formal-ai-binary
   00132|         if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}
   00133| 
   00134|   ladder:
   00135|     name: Agent CLI ladder ${{ matrix.leg.filter || 'tree' }}
   00136|     needs: [plan]
   00137|     if: ${{ needs.plan.outputs.already-green != 'true' }}
   00138|     runs-on: ubuntu-latest
   00139|     # 45 minutes for a two-leaf leg; 180 is the ceiling for the one-leg modes
   00140|     # (scheduled `all` run walks every level of the tree in sequence).
   00141|     # Static value so the CI wall-clock gate can measure the worst-case ceiling.
   00142|     timeout-minutes: 180
   00143|     strategy:
   00144|       fail-fast: false
   00145|       matrix:
   00146|         leg: ${{ fromJSON(needs.plan.outputs.legs) }}
   00147|     env:
   00148|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00149|       NODE_FILTER: ${{ matrix.leg.filter }}
   00150|       # A fresh directory, not the committed evidence under docs/: the compare
   00151|       # job joins exactly what this leg measured.
   00152|       OUT: ${{ github.workspace }}/agent-tree-run
   00153|       LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: "false"
   00154|       AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00155|     steps:
   00156|       - uses: actions/checkout@v7
   00157|         with:
   00158|           persist-credentials: false
   00159| 
   00160|       - name: Setup Bun
   00161|         uses: oven-sh/setup-bun@v2
   00162|         with:
   00163|           bun-version-file: .bun-version
   00164|           no-cache: true
   00165| 
   00166|       # Each leaf's edit is compiled by verify-node.sh; the dependency crates
   00167|       # are the same on every leg, so the first leaf of each leg restores them
   00168|       # from the shared compiler cache instead of compiling them cold.
   00169|       - uses: ./.github/actions/setup-sccache
   00170| 
   00171|       # verify-node.sh compiles every leaf's edit, so the toolchain must meet
   00172|       # the crate's rust-version whether or not the binary came from cache:
   00173|       # formal-ai-binary installs one only on a cache miss, and a runner image
   00174|       # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run
   00175|       # 37710079109) although their edits were valid.
   00176|       - name: Setup Rust
   00177|         uses: dtolnay/rust-toolchain@stable
   00178| 
   00179|       - uses: ./.github/actions/formal-ai-binary
   00180|         if: ${{ inputs.skip_build != true }}
   00181| 
   00182|       - name: Install pinned Agent CLI
   00183|         run: bun add -g @link-assistant/agent@0.26.0
   00184| 
   00185|       - name: Run recursive Agent CLI tree
   00186|         id: tree
   00187|         env:
   00188|           AGENT: agent
   00189|         run: experiments/issue_1028_agent_cli_ladder/run.sh
   00190| 
   00191|       - name: Show the Agent CLI evidence on failure
   00192|         if: failure()
   00193|         run: scripts/dump-agent-cli-evidence.sh "$OUT"
   00194| 
   00195|       - name: Upload tree evidence
   00196|         if: ${{ always() }}
   00197|         uses: actions/upload-artifact@v7
   00198|         with:
   00199|           name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.filter || 'tree' }}
   00200|           path: ${{ github.workspace }}/agent-tree-run
   00201|           retention-days: 3
   00202|           if-no-files-found: error
   00203| 
   00204|   compare:
   00205|     name: Compare the measured ladder with the record
   00206|     needs: [plan, ladder]
   00207|     # Not `always()`: a run superseded by a newer push is the one
   00208|     # cancellation that is not a defect, and it skips the verdict.
   00209|     if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}
   00210|     runs-on: ubuntu-latest
   00211|     timeout-minutes: 15
   00212|     env:
   00213|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00214|       OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run
   00215|     steps:
   00216|       - uses: actions/checkout@v7
   00217|         with:
   00218|           persist-credentials: false
   00219| 
   00220|       # Enabled off, recording on: this job never skips, and its own success
   00221|       # is what marks these inputs green for the plan job's next lookup.
   00222|       - name: Record the verdict for these inputs
   00223|         uses: ./.github/actions/green-ledger
   00224|         with:
   00225|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00226|           paths: >-
   00227|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00228|           enabled: 'false'
   00229| 
   00230|       - name: Every ladder leg finished
   00231|         env:
   00232|           NEEDS_JSON: ${{ toJSON(needs) }}
   00233|           JOBS: plan ladder
   00234|           CHECK: Agent CLI ladder
   00235|         run: bash scripts/check-shard-results.sh
   00236| 
   00237|       - name: Download every leg's evidence
   00238|         uses: actions/download-artifact@v8
   00239|         env:
   00240|           # v8's bundled unzip dependency still calls Buffer(); suppress only
   00241|           # that reviewed upstream diagnostic, never all Node warnings:
   00242|           # https://github.com/actions/download-artifact/issues/484
   00243|           NODE_OPTIONS: --disable-warning=DEP0005
   00244|         with:
   00245|           pattern: issue-1028-agent-cli-binary-tree-*
   00246|           path: ${{ runner.temp }}/agent-tree-legs
   00247| 
   00248|       # The committed evidence under $OUT is a previous run's; the joined run
   00249|       # replaces it so nothing stale is compared or uploaded.
   00250|       - name: Join the legs into one run
   00251|         env:
   00252|           LEG_COUNT: ${{ needs.plan.outputs.leg-count }}
   00253|         run: |
   00254|           set -euo pipefail
   00255|           rm -rf "$OUT"
   00256|           python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \
   00257|             "$RUNNER_TEMP/agent-tree-legs" "$OUT" "$LEG_COUNT"
   00258| 
   00259|       # A ladder that ran and measured fewer leaves than the record is still
   00260|       # compared -- that is the regression this gate exists to catch.
   00261|       - name: Compare the measured ladder with the record
   00262|         run: |
   00263|           set -euo pipefail
   00264|           result="$OUT/ladder-result.lino"
   00265|           [[ -f "$result" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }
   00266|           field() { sed -n "s/^  $1 \"\(.*\)\"$/\1/p" "$result"; }
   00267|           recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)
   00268|           measured_leaves=$(field leaf_nodes_passing)
   00269|           selected_leaves=$(field leaf_nodes_selected)
   00270|           authored_rules_enabled=$(field authored_rules_enabled)
   00271|           echo "leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves"
   00272|           cat "$result" >> "$GITHUB_STEP_SUMMARY"
   00273|           # Only a full-width run is comparable with the record: a filtered or
   00274|           # shallower run selects fewer leaves and would always look worse.
   00275|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == true ]]; then
   00276|             if (( measured_leaves < recorded_leaves )); then
   00277|               echo "::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes."
   00278|               exit 1
   00279|             fi
   00280|             if (( measured_leaves > recorded_leaves )); then
   00281|               echo "::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit"
   00282|             fi
   00283|           fi
   00284|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == false ]]; then
   00285|             measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)
   00286|             recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)
   00287|             if [[ "$recorded_without_rules" == not_measured ]]; then
   00288|               echo "::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino"
   00289|               exit 1
   00290|             fi
   00291|             if (( measured_without_rules < recorded_without_rules )); then
   00292|               echo "::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules"
   00293|               exit 1
   00294|             fi
   00295|             if (( measured_without_rules > recorded_without_rules )); then
   00296|               echo "::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit"
   00297|             fi
   00298|           fi
   00299|           if [[ "$TREE_DEPTH" == all ]]; then
   00300|             deepest=$(field deepest_passing_level)
   00301|             recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)
   00302|             echo "deepest passing level: recorded $recorded_depth, this run $deepest"
   00303|             if [[ "$recorded_depth" != none && "$deepest" == none ]]; then
   00304|               echo "::error::no level passed completely; the record is level $recorded_depth"
   00305|               exit 1
   00306|             fi
   00307|             if [[ "$recorded_depth" != none && "$deepest" != none ]] && (( deepest < recorded_depth )); then
   00308|               echo "::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)"
   00309|               exit 1
