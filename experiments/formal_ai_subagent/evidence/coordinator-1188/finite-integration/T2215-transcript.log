   <file>
   00001| name: Issue 1028 Agent CLI binary-tree ladder
   00002| 
   00003| # Issue #1085 (D4): the ladder runs on pull requests that touch it or the
   00004| # agentic coding modules (leaf level), weekly over every level, and on
   00005| # dispatch. The deepest level whose nodes all pass is compared with
   00006| # data/meta/ladder-ratchet.lino and may only move deeper.
   00007| #
   00008| # PR #1188: the depth-five run measured its 32 leaves one after another in one
   00009| # job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).
   00010| # Leaves are independent -- each starts from a reset worktree and only a
   00011| # depth-4 composite reads its children's effects -- so the default run is now
   00012| #   plan     consults the green ledger (lookup only), warms the binary cache
   00013| #            and lists the legs: sixteen depth-4 subtrees of two leaves each
   00014| #            for the whole depth-five tree, one leg for anything else;
   00015| #   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;
   00016| #   compare  green only when every leg succeeded (check-shard-results.sh), the
   00017| #            legs join into one run (combine-shards.py refuses a missing or
   00018| #            overlapping leg), and that run holds the recorded ratchet. Its
   00019| #            success, not the plan's, records the inputs green.
   00020| # Weekly all mode measures every node in bounded independent legs. Leaves
   00021| # and requirement nodes run in parallel; depth-four composites consume this
   00022| # run's validated leaf effects and diffs in a second artifact-fed wave.
   00023| # The final join checks the exact 63-node plan, corpus and source identity.
   00024| on:
   00025|   # Issue #1187 R2: a bot pull request's checks start through dispatch
   00026|   # (.github/actions/dispatch-checks); mode and pull-request are its inputs.
   00027|   workflow_dispatch:
   00028|     inputs:
   00029|       mode:
   00030|         description: 'checks: run the pull-request checks on the dispatched branch'
   00031|         required: false
   00032|         default: checks
   00033|         type: choice
   00034|         options: [checks]
   00035|       pull-request:
   00036|         description: 'Pull request the dispatched checks report for'
   00037|         required: false
   00038|         default: ''
   00039|         type: string
   00040|       depth:
   00041|         description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'
   00042|         required: false
   00043|         default: '5'
   00044|         type: choice
   00045|         options: ['0', '1', '2', '3', '4', '5', 'all']
   00046|       node_filter:
   00047|         description: 'Optional node path (for example 2.1.2.2.1)'
   00048|         required: false
   00049|         default: ''
   00050|         type: string
   00051|       skip_build:
   00052|         description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'
   00053|         required: false
   00054|         default: false
   00055|         type: boolean
   00056|       authored_rules:
   00057|         description: 'Per-leaf authored mappings visible to the agent'
   00058|         required: false
   00059|         default: 'disabled'
   00060|         type: choice
   00061|         options: ['disabled', 'enabled']
   00062|   pull_request:
   00063|     # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request
   00064|     # never triggers this repository's own pipeline.
   00065|     branches-ignore: ['e2e/**']
   00066|     paths:
   00067|       - 'experiments/issue_1028_agent_cli_ladder/**'
   00068|       - 'rust/src/agentic_coding/**'
   00069|       - 'data/meta/ladder-ratchet.lino'
   00070|       - '.github/workflows/issue-1028-agent-ladder.yml'
   00071|   schedule:
   00072|     - cron: '23 3 * * 0'
   00073| 
   00074| permissions:
   00075|   contents: read
   00076| 
   00077| concurrency:
   00078|   group: issue-1028-agent-cli-binary-tree-${{ github.ref }}
   00079|   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
   00080| 
   00081| jobs:
   00082|   plan:
   00083|     name: Plan the Agent CLI ladder
   00084|     runs-on: ubuntu-latest
   00085|     timeout-minutes: 30
   00086|     outputs:
   00087|       already-green: ${{ steps.ledger.outputs.already-green }}
   00088|       legs: ${{ steps.plan.outputs.legs || '[]' }}
   00089|       leg-count: ${{ steps.plan.outputs.leg-count }}
   00090|       composites: ${{ steps.plan.outputs.composites || '[]' }}
   00091|     env:
   00092|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00093|       NODE_FILTER: ${{ inputs.node_filter || '' }}
   00094|     steps:
   00095|       - uses: actions/checkout@v7
   00096|         with:
   00097|           persist-credentials: false
   00098|       # Lookup only (`record: 'false'`): a green plan says nothing about the
   00099|       # ladder, so the compare job records the verdict for these inputs.
   00100|       - name: Skip when identical inputs already passed
   00101|         id: ledger
   00102|         uses: ./.github/actions/green-ledger
   00103|         with:
   00104|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00105|           paths: >-
   00106|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00107|           enabled: ${{ github.ref != 'refs/heads/main' }}
   00108|           record: 'false'
   00109| 
   00110|       - name: List the ladder legs
   00111|         id: plan
   00112|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00113|         run: |
   00114|           set -euo pipefail
   00115|           if [[ "$TREE_DEPTH" == 5 && -z "$NODE_FILTER" ]]; then
   00116|             # Every depth-4 node: the 32 leaves as sixteen pairs. 45 minutes
   00117|             # holds two leaves even when both compile cold and time out.
   00118|             legs=$(jq -cn '[range(0; 16)
   00119|               | [(. / 8 | floor) % 2 + 1, (. / 4 | floor) % 2 + 1, (. / 2 | floor) % 2 + 1, . % 2 + 1]
   00120|               | map(tostring) | join(".") | {filter: ., cap: 45}]')
   00121|           else
   00122|             legs=$(jq -cn --arg filter "$NODE_FILTER" '[{filter: $filter, cap: 180}]')
   00123|           fi
   00124|           echo "legs=$legs" >> "$GITHUB_OUTPUT"
   00125|           echo "leg-count=$(jq 'length' <<< "$legs")" >> "$GITHUB_OUTPUT"
   00126|           echo "$legs"
   00127| 
   00128|       # Reused across every workflow that only needs to *run* the binary: the
   00129|       # cache key is the content of the sources it is built from, so a push that
   00130|       # changed neither pays nothing (issue #1107). Warmed once here so every
   00131|       # leg restores it instead of each compiling it.
   00132|       - uses: ./.github/actions/formal-ai-binary
   00133|         if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}
   00134| 
   00135|   ladder:
   00136|     name: Agent CLI ladder ${{ matrix.leg.filter || 'tree' }}
   00137|     needs: [plan]
   00138|     if: ${{ needs.plan.outputs.already-green != 'true' }}
   00139|     runs-on: ubuntu-latest
   00140|     # 45 minutes for a two-leaf leg; 180 is the ceiling for the one-leg modes
   00141|     # (scheduled `all` run walks every level of the tree in sequence).
   00142|     # Static value so the CI wall-clock gate can measure the worst-case ceiling.
   00143|     timeout-minutes: 180
   00144|     strategy:
   00145|       fail-fast: false
   00146|       matrix:
   00147|         leg: ${{ fromJSON(needs.plan.outputs.legs) }}
   00148|     env:
   00149|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00150|       NODE_FILTER: ${{ matrix.leg.filter }}
   00151|       # A fresh directory, not the committed evidence under docs/: the compare
   00152|       # job joins exactly what this leg measured.
   00153|       OUT: ${{ github.workspace }}/agent-tree-run
   00154|       LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: "false"
   00155|       AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00156|     steps:
   00157|       - uses: actions/checkout@v7
   00158|         with:
   00159|           persist-credentials: false
   00160| 
   00161|       - name: Setup Bun
   00162|         uses: oven-sh/setup-bun@v2
   00163|         with:
   00164|           bun-version-file: .bun-version
   00165|           no-cache: true
   00166| 
   00167|       # Each leaf's edit is compiled by verify-node.sh; the dependency crates
   00168|       # are the same on every leg, so the first leaf of each leg restores them
   00169|       # from the shared compiler cache instead of compiling them cold.
   00170|       - uses: ./.github/actions/setup-sccache
   00171| 
   00172|       # verify-node.sh compiles every leaf's edit, so the toolchain must meet
   00173|       # the crate's rust-version whether or not the binary came from cache:
   00174|       # formal-ai-binary installs one only on a cache miss, and a runner image
   00175|       # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run
   00176|       # 37710079109) although their edits were valid.
   00177|       - name: Setup Rust
   00178|         uses: dtolnay/rust-toolchain@stable
   00179| 
   00180|       - uses: ./.github/actions/formal-ai-binary
   00181|         if: ${{ inputs.skip_build != true }}
   00182| 
   00183|       - name: Install pinned Agent CLI
   00184|         run: bun add -g @link-assistant/agent@0.26.0
   00185| 
   00186|       - name: Run recursive Agent CLI tree
   00187|         id: tree
   00188|         env:
   00189|           AGENT: agent
   00190|         run: experiments/issue_1028_agent_cli_ladder/run.sh
   00191| 
   00192|       - name: Show the Agent CLI evidence on failure
   00193|         if: failure()
   00194|         run: scripts/dump-agent-cli-evidence.sh "$OUT"
   00195| 
   00196|       - name: Upload tree evidence
   00197|         if: ${{ always() }}
   00198|         uses: actions/upload-artifact@v7
   00199|         with:
   00200|           name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.filter || 'tree' }}
   00201|           path: ${{ github.workspace }}/agent-tree-run
   00202|           retention-days: 3
   00203|           if-no-files-found: error
   00204| 
   00205|   compare:
   00206|     name: Compare the measured ladder with the record
   00207|     needs: [plan, ladder]
   00208|     # Not `always()`: a run superseded by a newer push is the one
   00209|     # cancellation that is not a defect, and it skips the verdict.
   00210|     if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}
   00211|     runs-on: ubuntu-latest
   00212|     timeout-minutes: 15
   00213|     env:
   00214|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00215|       OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run
   00216|     steps:
   00217|       - uses: actions/checkout@v7
   00218|         with:
   00219|           persist-credentials: false
   00220| 
   00221|       # Enabled off, recording on: this job never skips, and its own success
   00222|       # is what marks these inputs green for the plan job's next lookup.
   00223|       - name: Record the verdict for these inputs
   00224|         uses: ./.github/actions/green-ledger
   00225|         with:
   00226|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00227|           paths: >-
   00228|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00229|           enabled: 'false'
   00230| 
   00231|       - name: Every ladder leg finished
   00232|         env:
   00233|           NEEDS_JSON: ${{ toJSON(needs) }}
   00234|           JOBS: plan ladder
   00235|           CHECK: Agent CLI ladder
   00236|         run: bash scripts/check-shard-results.sh
   00237| 
   00238|       - name: Download every leg's evidence
   00239|         uses: actions/download-artifact@v8
   00240|         env:
   00241|           # v8's bundled unzip dependency still calls Buffer(); suppress only
   00242|           # that reviewed upstream diagnostic, never all Node warnings:
   00243|           # https://github.com/actions/download-artifact/issues/484
   00244|           NODE_OPTIONS: --disable-warning=DEP0005
   00245|         with:
   00246|           pattern: issue-1028-agent-cli-binary-tree-*
   00247|           path: ${{ runner.temp }}/agent-tree-legs
   00248| 
   00249|       # The committed evidence under $OUT is a previous run's; the joined run
   00250|       # replaces it so nothing stale is compared or uploaded.
   00251|       - name: Join the legs into one run
   00252|         env:
   00253|           LEG_COUNT: ${{ needs.plan.outputs.leg-count }}
   00254|         run: |
   00255|           set -euo pipefail
   00256|           rm -rf "$OUT"
   00257|           python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \
   00258|             "$RUNNER_TEMP/agent-tree-legs" "$OUT" "$LEG_COUNT"
   00259| 
   00260|       # A ladder that ran and measured fewer leaves than the record is still
   00261|       # compared -- that is the regression this gate exists to catch.
   00262|       - name: Compare the measured ladder with the record
   00263|         run: |
   00264|           set -euo pipefail
   00265|           result="$OUT/ladder-result.lino"
   00266|           [[ -f "$result" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }
   00267|           field() { sed -n "s/^  $1 \"\(.*\)\"$/\1/p" "$result"; }
   00268|           recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)
   00269|           measured_leaves=$(field leaf_nodes_passing)
   00270|           selected_leaves=$(field leaf_nodes_selected)
   00271|           authored_rules_enabled=$(field authored_rules_enabled)
   00272|           echo "leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves"
   00273|           cat "$result" >> "$GITHUB_STEP_SUMMARY"
   00274|           # Only a full-width run is comparable with the record: a filtered or
   00275|           # shallower run selects fewer leaves and would always look worse.
   00276|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == true ]]; then
   00277|             if (( measured_leaves < recorded_leaves )); then
   00278|               echo "::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes."
   00279|               exit 1
   00280|             fi
   00281|             if (( measured_leaves > recorded_leaves )); then
   00282|               echo "::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit"
   00283|             fi
   00284|           fi
   00285|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == false ]]; then
   00286|             measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)
   00287|             recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)
   00288|             if [[ "$recorded_without_rules" == not_measured ]]; then
   00289|               echo "::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino"
   00290|               exit 1
   00291|             fi
   00292|             if (( measured_without_rules < recorded_without_rules )); then
   00293|               echo "::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules"
   00294|               exit 1
   00295|             fi
   00296|             if (( measured_without_rules > recorded_without_rules )); then
   00297|               echo "::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit"
   00298|             fi
   00299|           fi
   00300|           if [[ "$TREE_DEPTH" == all ]]; then
   00301|             deepest=$(field deepest_passing_level)
   00302|             recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)
   00303|             echo "deepest passing level: recorded $recorded_depth, this run $deepest"
   00304|             if [[ "$recorded_depth" != none && "$deepest" == none ]]; then
   00305|               echo "::error::no level passed completely; the record is level $recorded_depth"
   00306|               exit 1
   00307|             fi
   00308|             if [[ "$recorded_depth" != none && "$deepest" != none ]] && (( deepest < recorded_depth )); then
   00309|               echo "::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)"
   00310|               exit 1
   00311|             fi
   00312|           fi
   00313| 
   00314|       - name: Show the Agent CLI evidence on failure
   00315|         if: failure()
   00316|         run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run
   00317|       - name: Upload tree evidence
   00318|         if: ${{ always() }}
   00319|         uses: actions/upload-artifact@v7
   00320|         with:
   00321|           name: issue-1028-agent-cli-binary-tree
   00322|           path: docs/case-studies/issue-1028/agent-tree-run
   00323|           retention-days: 14
   00324|           if-no-files-found: warn
   00325| 
   
