   00025| /// The delivery half of a request, separated from the work it asks for.
   00026| struct DeliveryBinding {
   00027|     /// The path the answer has to be written to.
   00028|     target: String,
   00029|     /// The exact opening line the caller pinned, when it pinned one.
   00030|     first_line: Option<String>,
   00031|     /// Exact `key=value` lines declared in the delivery sentence.
   00032|     field_lines: Vec<String>,
   00033|     /// Everything the request says that is not about delivery.
   00034|     residual: String,
   00035| }
