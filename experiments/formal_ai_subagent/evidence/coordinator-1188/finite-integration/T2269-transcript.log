   00122| fn parse_obligation(request: &str) -> Option<DeliveryBinding> {
   00123|     let mut target = None;
   00124|     let mut first_line = None;
   00125|     let mut field_lines = Vec::new();
   00126|     let mut residual = String::new();
   00127|     let mut later_obligation = false;
   00128|     // Sentences and delivery cues are read with every multi-word quoted
   00129|     // payload masked: `Append "/// Append an empty line to notes.txt." to
   00130|     // src/lib.rs.` is one sentence about src/lib.rs, not a delivery to the
   00131|     // notes.txt its payload mentions (PR #1188 sub-agent gap 2). The pinned
   00132|     // line, field lines and the work before the delivery are read from the
   00133|     // request itself, where the quoted text is intact.
   00134|     let masked = masked_multi_word_quotes(request);
   00135|     for sentence in sentences(&masked) {
   00136|         let start = masked[sentence.span.clone()]
   00137|             .find(sentence.text)
   00138|             .map_or(sentence.span.start, |at| sentence.span.start + at);
   00139|         let text = request
   00140|             .get(start..start + sentence.text.len())
   00141|             .unwrap_or(sentence.text);
   00142|         if let Some(line) = pinned_first_line(text) {
   00143|             if target.is_some() && !later_obligation {
   00144|                 first_line = first_line.or(Some(line));
   00145|                 continue;
   00146|             }
   00147|             residual.push_str(&request[sentence.span]);
   00148|             continue;
   00149|         }
   00150|         // A sentence states the work rather than a place to put it when it
   00151|         // asks for an artifact to be authored, or when the path it names is
   00152|         // where the work happens rather than where an answer goes. Both make
   00153|         // that path an operand, and reading either as a delivery is
   00154|         // destructive: the ladder's leaf says "Edit the tracked file
   00155|         // `src/engine_responses.rs`: add \"Good morning\" to the
   00156|         // GREETING_EXAMPLES list", so delivery wrote its own status line over
   00157|         // the source, the write returned success, and the node reported done
   00158|         // having deleted the file it was asked to edit.
   00159|         let delivered = (!carries_authoring_task(&crate::engine::normalize_prompt(sentence.text)))
   00160|             .then(|| delivered_write_target(sentence.text))
   00161|             .flatten()
   00162|             .filter(|target| {
   00163|                 !names_callable_artifact(text, target)
   00164|                     && super::function_expectation::test_expectation_question(text, &mut None)
   00165|                         .is_none()
   00166|             });
   00167|         if let Some(named) = delivered {
   00168|             if target.is_none() {
   00169|                 field_lines = exact_field_lines(text, &named);
   00170|                 target = Some(named);
   00171|                 if let Some(work) = work_before_delivery(text) {
   00172|                     residual.push_str(work);
   00173|                     residual.push_str(". ");
   00174|                 }
   00175|                 continue;
   00176|             }
   00177|             // A constraint in the next sentence belongs to this later output,
   00178|             // not to the first output selected by this recursive pass. Leave
   00179|             // both sentences in the residual so the nested pass sees them
   00180|             // together and can bind them correctly.
   00181|             later_obligation = true;
   00182|         }
   00183|         residual.push_str(&request[sentence.span]);
   00184|     }
   00185|     let residual = residual.trim().to_owned();
   00186|     (!residual.is_empty())
   00187|         .then_some(())
   00188|         .and(target)
   00189|         .map(|target| DeliveryBinding {
   00190|             target,
   00191|             first_line,
   00192|             field_lines,
   00193|             residual,
   00194|         })
   00195| }
