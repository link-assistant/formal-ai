   00233| /// The part of a delivery sentence that is not about delivery.
   00234| ///
   00235| /// Two sentences are the tidy way to ask for work and its delivery, and the
   00236| /// ladder's own nodes are written that way. English does not require it: "Break
   00237| /// the customer import rewrite into sub-tasks and record what you work out in
   00238| /// `import-split.md`" coordinates both halves into one sentence, and the
   00239| /// delivery half starts at the write action cue. Reading the sentence as
   00240| /// delivery and stopping there drops the work along with it, the residual comes
   00241| /// out empty, and the request is answered in the transcript with nothing
   00242| /// written -- which is the same silence issue #1066 is about, arrived at from
   00243| /// the other side.
   00244| ///
   00245| /// Returns [`None`] when the sentence opens with its cue, which is the shape
   00246| /// where there is genuinely no work in front of the delivery.
   00247| fn work_before_delivery(sentence: &str) -> Option<&str> {
   00248|     let start = first_action_cue_start(&tokens(sentence))?;
   00249|     let work = without_trailing_separator(sentence.get(..start)?.trim());
   00250|     work.chars().any(char::is_alphanumeric).then_some(work)
   00251| }
   00252| 
   00253| /// `work` with the connective that introduced the delivery clause removed.
   00254| ///
   00255| /// The connective belongs to the clause it opens, so it is delivery's, not the
   00256| /// work's. Which words those are is not a fact about writing files: it is the
   00257| /// vocabulary that ends one clause and starts the next, which the seed already
   00258| /// spells out in every registered language under
   00259| /// [`crate::seed::ROLE_SKILL_PROCEDURE_CLAUSE_SEPARATOR`].
   00260| ///
   00261| /// The separator has to be a whole word. "Run the import command record it in
   00262| /// `x.md`" ends its work on *command*, and a match on the last three letters
   00263| /// would hand back "Run the import comm".
   00264| fn without_trailing_separator(work: &str) -> &str {
   00265|     let lowered = work.to_lowercase();
   00266|     bare_surfaces(crate::seed::ROLE_SKILL_PROCEDURE_CLAUSE_SEPARATOR)
   00267|         .iter()
   00268|         .filter(|separator| lowered.ends_with(separator.as_str()))
   00269|         .filter_map(|separator| work.get(..work.len() - separator.len()))
   00270|         .filter(|kept| kept.ends_with(char::is_whitespace))
   00271|         .map(str::trim_end)
   00272|         .min_by_key(|kept| kept.len())
   00273|         .unwrap_or(work)
   00274| }
