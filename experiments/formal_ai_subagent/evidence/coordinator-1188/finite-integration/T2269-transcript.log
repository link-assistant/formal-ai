   00071| /// Split a request into its delivery obligation and the investigation left over.
   00072| ///
   00073| /// The obligation is read one sentence at a time, and a sentence carries it only
   00074| /// when it applies a seed-defined write action *to* a seed-cued target path. Both
   00075| /// halves are required and both must be in the same sentence: "Read the file
   00076| /// `Cargo.toml`. Record what you find in `notes/report.md`." cues two paths, and
   00077| /// only the second one is being written to. Scoping the pair to a sentence is
   00078| /// what tells them apart, and it is the same scoping
   00079| /// [`super::shell_command`] uses to tell a command that is named from one that
   00080| /// is ordered (issue #907).
   00081| ///
   00082| /// A sentence that asks for an artifact to be authored is never the delivery
   00083| /// half, however write-shaped it looks. "Today's date is Sunday. Create a file
   00084| /// `main.py` that prints Hello, world!" applies a write action to a cued path,
   00085| /// and reading it as delivery inverts the request: the caller's work becomes the
   00086| /// destination and their passing statement becomes the investigation, so the
   00087| /// Python file was written with prose about the date. The authoring test is
   00088| /// [`super::shell_command::carries_authoring_task`], the one requirement 3 of
   00089| /// issue #907 already states in exactly these terms.
   00090| ///
   00091| /// Declines when the residual is empty: a request whose every sentence is about
   00092| /// delivery states no work to do, so there is nothing to record.
   00093| /// A call-shaped authoring request binds its path as a code operand.
   00094| fn names_callable_artifact(sentence: &str, target: &str) -> bool {
   00095|     let normalized = crate::engine::normalize_prompt(sentence);
   00096|     let lexicon = crate::seed::lexicon();
   00097|     let operand = normalized.split_whitespace().find(|word| {
   00098|         lexicon.mentions_role("coding-source-artifact-kind", word)
   00099|             || lexicon.mentions_role("evidence-report-artifact-kind", word)
   00100|     });
   00101|     if operand.is_some_and(|word| lexicon.mentions_role("coding-source-artifact-kind", word))
   00102|         && (lexicon.mentions_role("coding_request_verb", &normalized)
   00103|             || lexicon.mentions_role("coding_member_add_action", &normalized))
   00104|     {
   00105|         return true;
   00106|     }
   00107|     let Some(call) = super::module_function::signature(sentence) else {
   00108|         return false;
   00109|     };
   00110|     if !super::module_function::paths_in(&sentence[call.at..])
   00111|         .iter()
   00112|         .any(|path| path == target)
   00113|     {
   00114|         return false;
   00115|     }
   00116|     let prefix = crate::engine::normalize_prompt(&sentence[..call.at]);
   00117|     let lexicon = crate::seed::lexicon();
   00118|     lexicon.mentions_role("coding_request_verb", &prefix)
   00119|         || lexicon.mentions_role("coding_member_add_action", &prefix)
   00120| }
