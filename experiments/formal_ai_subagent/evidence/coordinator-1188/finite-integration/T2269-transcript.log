   00470| thread_local! {
   00471|     /// Probe answers already computed on this thread, keyed by the inputs they
   00472|     /// were computed from.
   00473|     static DELIVERY_PROBE_ANSWERS: RefCell<HashMap<(String, String, String), bool>> =
   00474|         RefCell::new(HashMap::new());
   00475| }
   00476| 
   00477| /// How many probe answers one thread remembers before starting over.
   00478| const DELIVERY_PROBE_MEMO_CAPACITY: usize = 512;
   00479| 
   00480| fn probe_settled_routes(task: &str, target: &str, tool_names: &[&str]) -> bool {
   00481|     let mut probe = vec![ChatMessage::user(task)];
   00482|     for turn in 0..DELIVERY_PROBE_TURNS {
   00483|         let Some(AgenticPlan::ToolCalls(calls)) =
   00484|             plan_settled_routes(task, &probe, tool_names, &mut None)
   00485|         else {
   00486|             return false;
   00487|         };
   00488|         for (index, call) in calls.iter().enumerate() {
   00489|             if planned_destination(&call.arguments).is_some_and(|path| path == target) {
   00490|                 return true;
   00491|             }
   00492|             let id = format!("delivery-probe-{turn}-{index}");
   00493|             probe.push(ChatMessage::assistant_tool_calls(vec![ToolCall::function(
   00494|                 &id,
   00495|                 &call.tool,
   00496|                 call.arguments.clone(),
   00497|             )]));
   00498|             probe.push(ChatMessage::tool_result(id, &call.tool, "ok"));
   00499|         }
   00500|     }
   00501|     false
   00502| }
   00503| 
   00504| /// The file a planned call names as its destination, whether the call writes
   00505| /// those bytes itself or runs a command that writes them.
   00506| fn planned_destination(arguments: &str) -> Option<String> {
   00507|     planned_write_path(arguments).or_else(|| planned_command_output_path(arguments))
   00508| }
   00509| 
   00510| /// The destination a planned command names for its own output.
   00511| ///
   00512| /// A command carries its destination in the option that names it, exactly as a
   00513| /// write call carries it in `path`, and `formal-ai statement-audit --root .
   00514| /// --output statement-audit.lino` produces that file as surely as a write would.
   00515| /// A delivery that cannot see it peels "and write statement-audit.lino" off the
   00516| /// request and records its own status line over the report the command had just
   00517| /// written -- which is what issue #1069's agent-CLI audit run did, on the turn
   00518| /// after the audit succeeded.
   00519| fn planned_command_output_path(arguments: &str) -> Option<String> {
   00520|     let command = super::tool_result::command_argument(arguments)?;
   00521|     let parts = command.split_whitespace().collect::<Vec<_>>();
   00522|     let index = parts.iter().position(|part| *part == OUTPUT_OPTION)?;
   00523|     parts.get(index + 1).map(|path| (*path).to_owned())
   00524| }
   00525| 
   00526| /// The option a command names its output destination with.
   00527| const OUTPUT_OPTION: &str = "--output";
   00528| 
   00529| /// The file a planned call writes, under whichever key its client expects.
   00530| fn planned_write_path(arguments: &str) -> Option<String> {
   00531|     let value = serde_json::from_str::<serde_json::Value>(arguments).ok()?;
   00532|     ["path", "filePath", "file_path", "absolute_path"]
   00533|         .iter()
   00534|         .find_map(|key| {
   00535|             value
   00536|                 .get(*key)
   00537|                 .and_then(serde_json::Value::as_str)
   00538|                 .map(str::to_owned)
   00539|         })
   00540| }
   00541| 
   00542| /// Render an answer under the constraints attached to its destination.
   00543| fn render_obligation(obligation: &DeliveryBinding, answer: &str) -> String {
   00544|     if !obligation.field_lines.is_empty() {
   00545|         let result = substantive_result_line(answer, &obligation.residual);
   00546|         let observed_results = exact_field_values(answer, "result");
   00547|         let mut next_observed = observed_results.iter();
   00548|         let mut rendered = String::new();
   00549|         for field in &obligation.field_lines {
   00550|             rendered.push_str(field);
   00551|             if field.ends_with('=') {
   00552|                 if field == "result=" {
   00553|                     let combined = combined_observation(&observed_results, &obligation.residual)
   00554|                         .unwrap_or_else(|| result.to_owned());
   00555|                     rendered.push_str(&non_hollow_result(&combined, &obligation.residual));
   00556|                 } else {
   00557|                     rendered.push_str(next_observed.next().map_or(result, String::as_str));
   00558|                 }
   00559|             }
   00560|             rendered.push('\n');
   00561|         }
   00562|         return rendered;
   00563|     }
   00564|     let answer = non_hollow_result(answer, &obligation.residual);
   00565|     obligation.first_line.as_ref().map_or_else(
   00566|         || format!("{}\n", answer.trim_end()),
   00567|         |line| format!("{line}\n\n{}\n", answer.trim_end()),
   00568|     )
   00569| }
   00570| 
   00571| /// Values carried on exact machine-readable lines in an observation.
   00572| ///
   00573| /// Multi-file reads deliberately render one bare `key=value` line per input so
   00574| /// a later delivery can preserve those bytes. Display headings and prose are
   00575| /// ignored; only a line whose prefix is exact participates.
   00576| fn exact_field_values(answer: &str, key: &str) -> Vec<String> {
   00577|     let prefix = format!("{key}=");
   00578|     answer
   00579|         .lines()
   00580|         .map(str::trim)
   00581|         .filter_map(|line| line.strip_prefix(&prefix))
   00582|         .map(str::to_owned)
   00583|         .collect()
   00584| }
   00585| 
   00586| /// State how multiple exact observations compose while retaining each value.
   00587| fn combined_observation(values: &[String], request: &str) -> Option<String> {
   00588|     match values {
   00589|         [] => None,
   00590|         [only] => Some(only.clone()),
   00591|         many => {
   00592|             let values = many.join("; ");
   00593|             let language = crate::language::detect(request);
   00594|             crate::seed::render_response(
   00595|                 "evidence_exact_composition",
   00596|                 language.slug(),
   00597|                 &[("values", &values)],
   00598|             )
   00599|             .or(Some(values))
   00600|         }
   00601|     }
   00602| }
   00603| 
   00604| /// Keep a terse but decisive source token machine-checkable as a concrete result.
   00605| ///
   00606| /// Structured result consumers reasonably distinguish an observation from a
   00607| /// placeholder by requiring a short natural-language statement. A source line
   00608| /// can still answer the question completely with only a path and one sentinel,
   00609| /// so retain it verbatim and add context instead of discarding or paraphrasing
   00610| /// the evidence.
   00611| fn non_hollow_result(result: &str, task: &str) -> String {
   00612|     let result = result.trim_end();
   00613|     let language = crate::language::detect(task).slug();
   00614|     let intent = if result.ends_with(':') || result.ends_with('：') {
   00615|         "coding_repository_source_observation"
   00616|     } else if result.split_whitespace().count() >= 4 {
   00617|         return result.to_owned();
   00618|     } else {
   00619|         "coding_repository_result_observation"
   00620|     };
   00621|     crate::seed::render_response(intent, language, &[("result", result)])
   00622|         .unwrap_or_else(|| result.to_owned())
   00623| }
   00624| 
   00625| /// The observation carried by a successfully written evidence artifact.
   00626| ///
   00627| /// Remove only the destination's machine header. The remaining bytes are the
   00628| /// grounded answer the nested delivery wrote and can feed another artifact.
   00629| fn written_observation(obligation: &DeliveryBinding, content: &str) -> String {
   00630|     let mut lines = content.lines();
   00631|     if obligation.first_line.as_deref().is_some_and(|first_line| {
   00632|         lines
   00633|             .clone()
   00634|             .next()
   00635|             .is_some_and(|line| line.trim() == first_line)
   00636|     }) {
   00637|         lines.next();
   00638|     }
   00639|     lines.collect::<Vec<_>>().join("\n").trim().to_owned()
   00640| }
   00641| 
   00642| /// The concrete line of an answer that best addresses the requested fact.
   00643| ///
   00644| /// Grouped grep output is transport-ordered, not relevance-ordered. Release
   00645| /// notes can therefore precede the source declaration a workspace question
   00646| /// asked for. Rank otherwise substantive lines by overlap with the request's
   00647| /// seed-derived fact terms. The final fact term is the requested property, and
   00648| /// a declaration answers a storage/representation question more directly than
   00649| /// a later method that happens to use that property.
   00650| fn substantive_result_line<'a>(answer: &'a str, task: &str) -> &'a str {
   00651|     let mut current_source_authority = 0;
   00652|     let mut candidates = Vec::new();
   00653|     for raw_line in answer.lines() {
   00654|         let line = raw_line.trim();
   00655|         if looks_like_result_path_heading(line) {
   00656|             current_source_authority = source_authority(line);
   00657|             continue;
   00658|         }
   00659|         if !line.is_empty()
   00660|             && line != "```text"
   00661|             && line != "```"
   00662|             && !line.ends_with("command completed. Output:")
   00663|             && !is_match_count(line)
   00664|         {
   00665|             candidates.push((line, current_source_authority.max(source_authority(line))));
   00666|         }
   00667|     }
   00668|     let terms = super::workspace_inspection::workspace_inspection_terms_for_task(task);
   00669|     let lexicon = crate::seed::lexicon();
   00670|     let condition_requested =
   00671|         lexicon.mentions_role(crate::seed::ROLE_CODING_CONDITION_SUBJECT_KIND, task);
   00672|     let implementation_requested = lexicon.mentions_role(
   00673|         crate::seed::ROLE_CODING_SOURCE_IMPLEMENTATION_SUBJECT_KIND,
   00674|         task,
   00675|     );
   00676|     let serialized_relationship = super::workspace_inspection::serialized_relationship_term(task);
   00677|     trace_route(
   00678|         "evidence_record_relationship",
   00679|         serialized_relationship.as_deref().unwrap_or("none"),
   00680|     );
   00681|     trace_route("evidence_record_terms", &terms.join(","));
   00682|     let Some(&(mut selected, selected_authority)) = candidates.first() else {
   00683|         return "";
   00684|     };
   00685|     let mut selected_score = relevance_score(
   00686|         selected,
   00687|         &terms,
   00688|         condition_requested,
   00689|         implementation_requested,
   00690|         serialized_relationship.as_deref(),
   00691|         selected_authority,
   00692|     );
   00693|     for (candidate, authority) in candidates.into_iter().skip(1) {
   00694|         let score = relevance_score(
   00695|             candidate,
   00696|             &terms,
   00697|             condition_requested,
   00698|             implementation_requested,
   00699|             serialized_relationship.as_deref(),
   00700|             authority,
   00701|         );
   00702|         if score > selected_score {
   00703|             selected = candidate;
   00704|             selected_score = score;
   00705|         }
   00706|     }
   00707|     trace_route("evidence_record_selected", selected);
   00708|     selected
   00709| }
   00710| 
   00711| fn relevance_score(
   00712|     line: &str,
   00713|     terms: &[String],
   00714|     condition_requested: bool,
   00715|     implementation_requested: bool,
   00716|     serialized_relationship: Option<&str>,
   00717|     source_authority: usize,
   00718| ) -> (
   00719|     usize,
   00720|     usize,
   00721|     usize,
   00722|     usize,
   00723|     usize,
   00724|     usize,
   00725|     usize,
   00726|     usize,
   00727|     usize,
   00728|     usize,
   00729| ) {
   00730|     let words = line
   00731|         .split(|character: char| !character.is_ascii_alphanumeric())
   00732|         .filter(|word| !word.is_empty())
   00733|         .map(str::to_ascii_lowercase)
   00734|         .collect::<Vec<_>>();
   00735|     let matches = |term: &str| {
   00736|         words.iter().any(|word| word == term)
   00737|             || term
   00738|                 .split('_')
   00739|                 .all(|part| words.iter().any(|word| word == part))
   00740|     };
   00741|     let overlap = terms.iter().filter(|term| matches(term)).count();
   00742|     let requested_property = usize::from(terms.last().is_some_and(|term| matches(term)));
   00743|     let declaration_shape = if looks_like_declaration(line) {
   00744|         1 + usize::from(!looks_like_local_binding(line))
   00745|             + usize::from(looks_like_exposed_declaration(line))
   00746|     } else {
   00747|         0
   00748|     };
   00749|     let bound_requested = terms
   00750|         .iter()
   00751|         .any(|term| crate::seed::lexicon().mentions_role(crate::seed::ROLE_CODING_BOUND_CUE, term));
   00752|     let semantic_overlap = usize::from(
   00753|         bound_requested
   00754|             && words.iter().any(|word| {
   00755|                 crate::seed::lexicon().mentions_role(crate::seed::ROLE_CODING_BOUND_CUE, word)
   00756|             }),
   00757|     );
   00758|     let code_shape = usize::from(line.contains(['{', '}', '(', ')', ';', '=', '<', '>']));
   00759|     let direct_serialized_identity =
   00760|         usize::from(serialized_relationship.is_some_and(|relationship| {
   00761|             words
   00762|                 .windows(2)
   00763|                 .any(|pair| pair[0] == relationship && pair[1] == "id")
   00764|         }));
   00765|     (
   00766|         usize::from(implementation_requested && !is_quoted_or_commented_source(source_text(line))),
   00767|         direct_serialized_identity,
   00768|         requested_property,
   00769|         usize::from(condition_requested && looks_like_condition(line)),
   00770|         source_authority,
   00771|         usize::from(condition_requested && looks_like_instance_condition(line)),
   00772|         declaration_shape,
   00773|         semantic_overlap,
   00774|         overlap,
   00775|         code_shape,
   00776|     )
   00777| }
   00778| 
   00779| /// Whether a source quotation is shaped as a boolean decision.
   00780| ///
   00781| /// This intentionally recognises syntax classes rather than identifiers: a
   00782| /// condition may begin with a control-flow keyword or continue a compound
   00783| /// expression on its own line. Calls and declarations without a decision
   00784| /// operator remain ordinary source facts.
   00785| fn looks_like_condition(line: &str) -> bool {
   00786|     let source = source_text(line);
   00787|     if is_quoted_or_commented_source(source) {
   00788|         return false;
   00789|     }
   00790|     ["if ", "while ", "match ", "when "]
   00791|         .iter()
   00792|         .any(|prefix| source.starts_with(prefix))
   00793|         || ["&&", "||", "==", "!=", ">=", "<="]
   00794|             .iter()
   00795|             .any(|operator| source.contains(operator))
   00796|         || source.starts_with('!')
   00797| }
   00798| 
   00799| /// An instance-qualified predicate describes the invariant of the inspected
   00800| /// object more directly than a construction-time check of a similarly named
   00801| /// local value. Recognize common member-access syntax without depending on a
   00802| /// project identifier or a particular natural-language request.
   00803| fn looks_like_instance_condition(line: &str) -> bool {
   00804|     let source = source_text(line);
   00805|     ["self.", "this.", "self->", "this->", "$this->"]
   00806|         .iter()
   00807|         .any(|receiver| source.contains(receiver))
   00808| }
   00809| 
   00810| /// Local bindings can repeat the type of the model field a representation
   00811| /// question asks about. They are declarations, but a public/type-level
   00812| /// declaration is the more authoritative description when both are present.
   00813| fn looks_like_local_binding(line: &str) -> bool {
   00814|     let source = source_text(line);
   00815|     ["let ", "var ", "auto ", "local "]
   00816|         .iter()
   00817|         .any(|prefix| source.starts_with(prefix))
   00818| }
   00819| 
   00820| /// An exposed declaration describes the model's supported representation more
   00821| /// authoritatively than an unqualified function parameter with the same name
   00822| /// and type.
   00823| fn looks_like_exposed_declaration(line: &str) -> bool {
   00824|     let source = source_text(line);
   00825|     source.split_whitespace().next().is_some_and(|keyword| {
   00826|         matches!(keyword, "pub" | "public" | "export" | "exported") || keyword.starts_with("pub(")
   00827|     })
   00828| }
   00829| 
   00830| /// Recognize a source declaration without assuming a particular language.
   00831| ///
   00832| /// Grep renders matches as `Line N: source`; discard that transport prefix,
   00833| /// then recognize an identifier-bearing left side followed by a single colon.
   00834| /// Namespace/generic punctuation such as `sum::<usize>()` is deliberately not
   00835| /// a declaration.
   00836| fn looks_like_declaration(line: &str) -> bool {
   00837|     let source = source_text(line);
   00838|     if is_quoted_or_commented_source(source) {
   00839|         return false;
   00840|     }
   00841|     let Some((left, right)) = source.split_once(':') else {
   00842|         return false;
   00843|     };
   00844|     !right.starts_with(':')
   00845|         && !left.contains(['(', ')', '=', '+'])
   00846|         && left.split_whitespace().next_back().is_some_and(|name| {
   00847|             !name.is_empty()
   00848|                 && name
   00849|                     .chars()
   00850|                     .all(|character| character.is_ascii_alphanumeric() || character == '_')
   00851|         })
   00852| }
   00853| 
   00854| fn source_text(line: &str) -> &str {
   00855|     line.split_once(": ")
   00856|         .map_or(line, |(_, source)| source)
   00857|         .trim()
   00858| }
   00859| 
   00860| fn is_quoted_or_commented_source(source: &str) -> bool {
   00861|     source.starts_with("//")
   00862|         || source.starts_with("/*")
   00863|         || source.starts_with('*')
   00864|         || source.starts_with('#')
   00865|         || source.starts_with("<!--")
   00866|         || source
   00867|             .chars()
   00868|             .next()
   00869|             .is_some_and(|character| matches!(character, '"' | '\'' | '`'))
   00870| }
   00871| 
   00872| fn is_match_count(line: &str) -> bool {
   00873|     line.strip_prefix("Found ")
   00874|         .and_then(|rest| rest.strip_suffix(" matches"))
   00875|         .is_some_and(|count| count.chars().all(|character| character.is_ascii_digit()))
   00876| }
   00877| 
   00878| fn looks_like_result_path_heading(line: &str) -> bool {
   00879|     line.ends_with(':') && (line.starts_with('/') || line.starts_with("./"))
   00880| }
   00881| 
   00882| /// Prefer a production source fact when an otherwise equivalent test merely
   00883| /// asserts that fact. If every match is outside `src`, the ordinary semantic
   00884| /// ranking remains decisive.
   00885| fn source_authority(path_or_line: &str) -> usize {
   00886|     usize::from(
   00887|         path_or_line
   00888|             .trim_end_matches(':')
   00889|             .split(['/', '\\'])
   00890|             .any(|component| component == "src"),
   00891|     )
   00892| }
   00893| 
   00894| /// What Formal AI answers about the residual, when it reaches a conclusion.
   00895| ///
   00896| /// The layering is the one [`super::general_execution`] already uses: the
   00897| /// agentic planner is a client of the symbolic engine, not a replacement for
   00898| /// it. Declining on an inconclusive answer is what keeps the delivery honest --
   00899| /// the caller asked for what was found out, and "nothing was" is not something
   00900| /// to write to a file and call evidence.
   00901| ///
   00902| /// An answer that defers to the open web
   00903| /// ([`crate::engine::SymbolicAnswer::defers_to_the_open_web`]) is declined for
   00904| /// the same reason, and it is the sharper of the two cases because the text
   00905| /// reads like prose about the subject. "Today's date is Sunday. Create a file
   00906| /// `main.py` that prints Hello, world!" put the first sentence to the engine,
   00907| /// which described the search it would run for it; delivering that description
   00908| /// wrote a paragraph about `DuckDuckGo` into the caller's Python file. Where the
   00909| /// engine would search, this route has nothing to record and stands aside, and
   00910| /// the request goes on to the routes that recognise it.
   00911| ///
   00912| /// An answer that announces an enumeration and enumerates nothing
   00913| /// ([`crate::engine::SymbolicAnswer::announces_a_list_it_does_not_make`]) is
   00914| /// declined last, and it is the case this whole route is most exposed to: the
   00915| /// text is non-empty, so it survives every check made of the file afterwards,
   00916| /// and a harness reading the file finds a heading with no list and calls the
   00917| /// node proved.
   00918| fn symbolic_answer(residual: &str) -> Option<FinalResult> {
   00919|     // Any gap (`capability_gap`, `write_program_skill_gap`) is such a refusal
   00920|     // (PR #1188 G102).
   00921|     let answer = crate::engine::FormalAiEngine.answer(residual);
   00922|     // A gap refusal is a definite statement about the surface, not a finding
   00923|     // to record: left through, the delivery wrote the refusal into the file
   00924|     // the caller named (issue #1138).
   00925|     if answer.intent.ends_with(GAP_INTENT_SUFFIX)
   00926|         || answer.is_inconclusive()
   00927|         || answer.defers_to_the_open_web()
   00928|         || answer.announces_a_list_it_does_not_make()
   00929|     {
   00930|         return None;
   00931|     }
   00932|     let text = answer.answer.trim().to_owned();
   00933|     (!text.is_empty()).then_some(FinalResult {
   00934|         text,
   00935|         disposition: FinalDisposition::Finding,
   00936|         origin: answer.intent,
   00937|         payload_role: FinalPayloadRole::Finding,
   00938|         artifact: None,
   00939|     })
   00940| }
   00941| 
   00942| /// The suffix of an intent that reports a gap: a refusal, never content.
   00943| const GAP_INTENT_SUFFIX: &str = "_gap";
   00944| 
   00945| /// The same conversation with the served request reduced to `residual`.
   00946| ///
   00947| /// Only the request text changes: every tool result the investigation has
   00948| /// already collected stays in place, so the residual is re-planned with the
   00949| /// progress it has actually made rather than from scratch. The turn reduced is
   00950| /// the request the run is serving -- the last user message that is not a
   00951| /// continuation cue. Reducing the cue itself (issue #1138) put the residual at
   00952| /// the end of the transcript, where every evidence window opened after it and
   00953| /// the investigation re-read what it had already read, forever.
   00954| fn with_residual_request(messages: &[ChatMessage], residual: &str) -> Option<Vec<ChatMessage>> {
   00955|     let index = messages.iter().rposition(|message| {
   00956|         message.role == "user"
   00957|             && !super::planner::is_continuation_cue(&message.content.plain_text())
   00958|     })?;
   00959|     let mut residual_messages = messages.to_vec();
   00960|     residual_messages[index].content = MessageContent::Text(residual.to_owned());
   00961|     // Every user message after the served request is a continuation ping
   00962|     // (the rposition above makes it so). Dropping them -- while keeping every
   00963|     // assistant turn and tool result in between -- leaves the residual as the
   00964|     // transcript's last user message. Left in place, the ping resumed the
   00965|     // standing task through its summary envelope, which re-entered this peel
   00966|     // with an identical residual and overflowed the stack (issue #1069).
   00967|     residual_messages.truncate(index + 1);
   00968|     residual_messages.extend(
