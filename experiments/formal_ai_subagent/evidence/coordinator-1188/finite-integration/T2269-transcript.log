   00037| /// `text` with every quoted segment that holds whitespace replaced, delimiters
   00038| /// included, by as many `x` as it has bytes, so spans still index the
   00039| /// original.
   00040| ///
   00041| /// A single-token quote -- a backticked path or name -- stays readable. The
   00042| /// lines under a colon-ended first line are the request's payload, whatever
   00043| /// they say, so they are masked the same way, line breaks kept (PR #1188 G95:
   00044| /// a row that read "append ... to gaps.md" was taken for a delivery, and the
   00045| /// answer was written over that file).
   00046| fn masked_multi_word_quotes(text: &str) -> String {
   00047|     let mut masked = text.to_owned();
   00048|     for segment in crate::normal_markov::quoted_segment_spans(text) {
   00049|         if segment.text.chars().any(char::is_whitespace) {
   00050|             masked.replace_range(
   00051|                 segment.start..segment.end,
   00052|                 &"x".repeat(segment.end - segment.start),
   00053|             );
   00054|         }
   00055|     }
   00056|     let end = super::positional_edit::instruction_end(text);
   00057|     let payload: String = masked[end..]
   00058|         .chars()
   00059|         .map(|character| {
   00060|             if character.is_whitespace() {
   00061|                 character.to_string()
   00062|             } else {
   00063|                 "x".repeat(character.len_utf8())
   00064|             }
   00065|         })
   00066|         .collect();
   00067|     masked.replace_range(end.., &payload);
   00068|     masked
   00069| }
