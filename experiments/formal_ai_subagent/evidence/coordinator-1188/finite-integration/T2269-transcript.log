   00276| /// Plan the next step of a "find this out and record it at PATH" request.
   00277| ///
   00278| /// Three states, in the order they occur:
   00279| ///
   00280| /// * the write has already been attempted — report what happened, truthfully;
   00281| /// * the router still wants tool calls for the residual — pass them through, so
   00282| ///   the investigation runs under the ordinary routes;
   00283| /// * the router has an answer — write it to the named path, under the pinned
   00284| ///   first line when the caller pinned one.
   00285| pub(super) fn plan_evidence_record_step(
   00286|     task: &str,
   00287|     messages: &[ChatMessage],
   00288|     tool_names: &[&str],
   00289|     result: &mut Option<FinalResult>,
   00290| ) -> Option<AgenticPlan> {
   00291|     let obligation = parse_obligation(task)?;
   00292|     // A later producer of the same target owns its bytes.
   00293|     if let Some(reason) = later_route_delivering(task, &obligation, tool_names) {
   00294|         trace_route("evidence_record", reason);
   00295|         return None;
   00296|     }
   00297|     let write_tool = tool_for(tool_names, Capability::Write)?;
   00298|     let progress = Progress::scan(messages);
   00299|     match super::task_obligations::observed_file_outcome(task, &obligation.target, messages) {
   00300|         ObligationOutcome::Satisfied { .. } => {
   00301|             trace_route("evidence_record", "already_written");
   00302|             return Some(record(
   00303|                 AgenticPlan::Final(
   00304|                     progress
   00305|                         .successful_write_content_for(&obligation.target)
   00306|                         .map(|content| written_observation(&obligation, &content))
   00307|                         .filter(|answer| !answer.is_empty())
   00308|                         .unwrap_or_else(|| {
   00309|                             format!("Recorded the findings in `{}`.", obligation.target)
   00310|                         }),
   00311|                 ),
   00312|                 FinalDisposition::Finding,
   00313|                 "evidence_record_observed",
   00314|                 result,
   00315|             ));
   00316|         }
   00317|         ObligationOutcome::Refuted { .. } | ObligationOutcome::Unsatisfiable { .. } => {
   00318|             trace_route("evidence_record", "write_not_observed");
   00319|             return Some(record(
   00320|                 AgenticPlan::Final(format!(
   00321|                     "The findings could not be recorded in `{}`: the write step failed.",
   00322|                     obligation.target
   00323|                 )),
   00324|                 FinalDisposition::Failure,
   00325|                 "evidence_record_write_failed",
   00326|                 result,
   00327|             ));
   00328|         }
   00329|         ObligationOutcome::Unattempted => {}
   00330|     }
   00331|     // A successful checkout inspection is already the grounded answer this
   00332|     // delivery exists to persist. Optional research prose elsewhere in a
   00333|     // harness must not reopen the question on the web before the result is
   00334|     // written. Preserve recursive delivery ordering, though: when the residual
   00335|     // names another output, let that inner obligation consume the observation
   00336|     // first so one result still reaches every requested artifact.
   00337|     let observed = parse_obligation(&obligation.residual)
   00338|         .is_none()
   00339|         .then(|| {
   00340|             super::workspace_inspection::workspace_inspection_search_for_task(&obligation.residual)
   00341|         })
   00342|         .flatten()
   00343|         .and_then(|_| progress.latest_successful_output(Capability::Grep))
   00344|         .filter(|answer| !substantive_result_line(answer, &obligation.residual).is_empty())
   00345|         .map(str::to_owned);
   00346|     let residual_messages = with_residual_request(messages, &obligation.residual)?;
   00347|     let is_workspace_observation = observed.is_some();
   00348|     let answer = match observed {
   00349|         Some(answer) => answer,
   00350|         None => match plan_chat_step_resolved(&residual_messages, tool_names) {
   00351|             Some(resolved) => {
   00352|                 if !resolved.can_deliver() {
   00353|                     trace_route("evidence_record", "residual_not_finding");
   00354|                     return Some(resolved.into_plan(result));
   00355|                 }
   00356|                 let AgenticPlan::Final(answer) = resolved.plan else {
   00357|                     unreachable!()
   00358|                 };
   00359|                 if progress.latest_failure().is_some() {
   00360|                     return Some(record(
   00361|                         AgenticPlan::Final(answer),
   00362|                         FinalDisposition::Failure,
   00363|                         "evidence_record_residual_failed",
   00364|                         result,
   00365|                     ));
   00366|                 }
   00367|                 answer
   00368|             }
   00369|             None => {
   00370|                 trace_route("evidence_record", "symbolic_residual");
   00371|                 symbolic_answer(&obligation.residual)?.text
   00372|             }
   00373|         },
   00374|     };
   00375|     trace_route("evidence_record", &obligation.target);
   00376|     let delivered_answer = if is_workspace_observation {
   00377|         substantive_result_line(&answer, &obligation.residual)
   00378|     } else {
   00379|         &answer
   00380|     };
   00381|     let content = render_obligation(&obligation, delivered_answer);
   00382|     Some(plan_one(
   00383|         write_tool,
   00384|         write_arguments(&obligation.target, &content),
   00385|     ))
   00386| }
