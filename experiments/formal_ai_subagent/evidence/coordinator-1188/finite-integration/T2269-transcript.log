   00388| /// How far the probe below follows a route before concluding it delivers
   00389| /// nothing.
   00390| ///
   00391| /// A route reaches the file the caller named early or not at all: the recipes
   00392| /// write their artifact first, and the literal-file composer records its plan
   00393| /// and then writes it. The bound is what keeps a routing question from costing
   00394| /// a whole run.
   00395| const DELIVERY_PROBE_TURNS: usize = 4;
   00396| 
   00397| /// How a route below this one already produces `target` from the whole request,
   00398| /// or `None` when none of them does.
   00399| ///
   00400| /// A composed change plan states the file it was compiled for, so asking it is
   00401| /// exact and costs nothing -- and it is the only one of the two that sees a file
   00402| /// a shell *redirect* produces, since "Run 'printf learned-output' and write its
   00403| /// exact stdout to reports/learned.txt" is delivered by `>` and never by a write
   00404| /// call at all.
   00405| ///
   00406| /// Everything else is asked by running it rather than by listing it: plan the
   00407| /// request through the routes below, answer each planned call with a bare
   00408| /// success, and see whether `target` is among the files they write. That is what
   00409| /// reaches the recipes, which declare nothing and are recognised from the
   00410| /// artifact they write. A route's own state machine is what decides --
   00411| /// `plan_general_change_step` records its plan before writing the file the
   00412| /// caller named, so a first step alone would report that nobody owns
   00413| /// `policy/retention.md`, and a table of routes that "own an artifact" would
   00414| /// have to carry that knowledge secondhand and go stale.
   00415| ///
   00416| /// The probe starts from a conversation holding the request and nothing else, so
   00417| /// the answer depends on the request alone and does not drift as the real run
   00418| /// accumulates results: a recipe that owns a destination owns it on every turn,
   00419| /// and its mid-run plan to read the file back would otherwise look like nobody
   00420| /// owning it.
   00421| fn later_route_delivering(
   00422|     task: &str,
   00423|     obligation: &DeliveryBinding,
   00424|     tool_names: &[&str],
   00425| ) -> Option<&'static str> {
   00426|     // A schema or opening-line declaration constrains bytes that still have to
   00427|     // be derived from the residual investigation; it is not itself the file's
   00428|     // payload. The broad literal parser can nevertheless recover the words
   00429|     // after "with"/"exactly" as content. Do not let that lossy interpretation
   00430|     // displace the evidence transaction. A true literal write has no residual
   00431|     // finding to derive, so it never reaches this function.
   00432|     let derived_delivery = obligation.first_line.is_some() || !obligation.field_lines.is_empty();
   00433|     if derived_delivery {
   00434|         return None;
   00435|     }
   00436|     if let Some(plan) = compose_general_change_plan(task)
   00437|         && plan.target == obligation.target
   00438|     {
   00439|         return Some("declined_composed_target");
   00440|     }
   00441|     settled_route_delivers(task, &obligation.target, tool_names).then_some("declined_settled_route")
   00442| }
   00443| 
   00444| /// Whether planning the whole request through the routes below this one walks
   00445| /// into a call that writes `target`.
   00446| fn settled_route_delivers(task: &str, target: &str, tool_names: &[&str]) -> bool {
   00447|     let key = (
   00448|         task.to_owned(),
   00449|         target.to_owned(),
   00450|         tool_names.join("\u{1f}"),
   00451|     );
   00452|     if let Some(known) = DELIVERY_PROBE_ANSWERS.with_borrow(|answers| answers.get(&key).copied()) {
   00453|         return known;
   00454|     }
   00455|     let answer = probe_settled_routes(task, target, tool_names);
   00456|     DELIVERY_PROBE_ANSWERS.with_borrow_mut(|answers| {
   00457|         // The router is consulted once per turn with the same request, and a
   00458|         // long-lived server sees many requests. Recomputing per turn made the
   00459|         // issue #1028 ladder suite ten times slower; keeping every answer it
   00460|         // ever gave would trade that for unbounded memory. Start over instead --
   00461|         // the answers are derived, so losing them costs one recomputation.
   00462|         if answers.len() >= DELIVERY_PROBE_MEMO_CAPACITY {
   00463|             answers.clear();
   00464|         }
   00465|         answers.insert(key, answer);
   00466|     });
   00467|     answer
   00468| }
