   00197| /// Literal `key=value` field constraints carried by one delivery sentence.
   00198| fn exact_field_lines(sentence: &str, target: &str) -> Vec<String> {
   00199|     let fields = sentence
   00200|         .split('`')
   00201|         .enumerate()
   00202|         .filter(|(index, _)| index % 2 == 1)
   00203|         .map(|(_, quoted)| quoted.trim())
   00204|         .filter(|quoted| *quoted != target)
   00205|         .filter(|quoted| !quoted.chars().any(char::is_whitespace))
   00206|         .filter(|quoted| {
   00207|             quoted.split_once('=').is_some_and(|(key, _)| {
   00208|                 key.chars()
   00209|                     .next()
   00210|                     .is_some_and(|character| character.is_ascii_alphabetic())
   00211|                     && key
   00212|                         .chars()
   00213|                         .all(|character| character.is_ascii_alphanumeric() || character == '_')
   00214|             })
   00215|         })
   00216|         .map(str::to_owned)
   00217|         .collect::<Vec<_>>();
   00218| 
   00219|     // A field may be quoted once as a source reference and again as the output
   00220|     // field the caller declares: "`left_result=` followed by the child's
   00221|     // `result=` value, and `result=` followed by the composition". The final
   00222|     // occurrence is the declaration's position in the output list. Keep that
   00223|     // occurrence only, so the source reference cannot create an extra field or
   00224|     // move the aggregate ahead of later child fields.
   00225|     fields
   00226|         .iter()
   00227|         .enumerate()
   00228|         .filter(|(index, field)| !fields[index + 1..].contains(field))
   00229|         .map(|(_, field)| field.clone())
   00230|         .collect()
   00231| }
