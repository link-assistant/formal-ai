   00342| fn compose_repository_work_plan(request: &str) -> Option<GeneralChangePlan> {
   00343|     let target = repository_work_reference(request)?;
   00344|     // Hive Mind's objective field (`Issue to solve: <url>`, then the prepared
   00345|     // branch and "Proceed.") carries its verb in the delimiter, which
   00346|     // `objective_text` has already stripped. An objective that opens with the
   00347|     // work-item reference itself is therefore that field: the reference is
   00348|     // the request (issues #1154 and #1155 replay this exact prompt).
   00349|     let opens_with_reference = request
   00350|         .split_whitespace()
   00351|         .next()
   00352|         .and_then(repository_work_reference)
   00353|         .is_some();
   00354|     if !opens_with_reference && !mentions_bare_role(request, seed::ROLE_SOFTWARE_AUTHORING_ACTION) {
   00355|         return None;
   00356|     }
   00357|     let response_language = language(request);
   00358|     let intent = formalize_intent(request, response_language, None);
   00359|     Some(GeneralChangePlan {
   00360|         id: stable_id(
   00361|             "repository_work_item_plan",
   00362|             &format!("{}:{target}", intent.impulse_id),
   00363|         ),
   00364|         mode: GeneralPlanMode::RepositoryWorkItem,
   00365|         goal: intent.source_text,
   00366|         target: target.clone(),
   00367|         content: String::new(),
   00368|         // A work item names an issue, not an artifact, so step one reads the
   00369|         // issue — that text is where the artifact is named, and planning
   00370|         // without it would fabricate one (issue #904, follow-up). Recording the
   00371|         // reference stays step two, and the plan still names no verification
   00372|         // command: reading back the record this run wrote observes only its own
   00373|         // write.
   00374|         steps: vec![
   00375|             work_item_step(Capability::Fetch, "read", response_language, &target),
   00376|             work_item_step(Capability::Write, "action", response_language, PLAN_PATH),
   00377|         ],
   00378|         verification_command: String::new(),
   00379|         terminal_state: PlanTerminalState::PlannedNotExecuted,
   00380|     })
   00381| }
   00382| /// One step of a repository work-item plan, with its seeded action and
   00383| /// evidence. `slug` is `read` (the fetch of the work item) or `action` (the
   00384| /// record written afterwards).
   00385| fn work_item_step(capability: Capability, slug: &str, lang: &str, target: &str) -> GeneralPlanStep {
   00386|     let evidence = if slug == "read" {
   00387|         "general_plan_repository_read_evidence"
   00388|     } else {
   00389|         "general_plan_repository_evidence"
   00390|     };
   00391|     GeneralPlanStep {
   00392|         capability,
   00393|         action: command_plan_text(&format!("general_plan_repository_{slug}"), lang, target),
   00394|         expected_evidence: command_plan_text(evidence, lang, target),
   00395|         command: None,
   00396|     }
   00397| }
   00398| /// Extract a concrete GitHub issue or pull-request URL structurally.
   00399| ///
   00400| /// The software action itself comes from the multilingual seed. URL host/path
   00401| /// segments are protocol identifiers, not natural-language routing phrases.
   00402| pub(super) fn repository_work_reference(request: &str) -> Option<String> {
   00403|     request.split_whitespace().find_map(|token| {
   00404|         // Sentence punctuation in any registered script: a URL that ends a
   00405|         // Chinese sentence carries `。` the way an English one carries `.`.
   00406|         let url = token.trim_matches(|character: char| {
   00407|             matches!(
   00408|                 character,
   00409|                 '<' | '>'
   00410|                     | '('
   00411|                     | ')'
   00412|                     | '['
   00413|                     | ']'
   00414|                     | '{'
   00415|                     | '}'
   00416|                     | ','
   00417|                     | ';'
   00418|                     | '.'
   00419|                     | '"'
   00420|                     | '\''
   00421|                     | '。'
   00422|                     | '，'
   00423|                     | '、'
   00424|                     | '；'
   00425|                     | '：'
   00426|                     | '（'
   00427|                     | '）'
   00428|                     | '「'
   00429|                     | '」'
   00430|                     | '«'
   00431|                     | '»'
   00432|                     | '।'
   00433|             )
   00434|         });
   00435|         let path = url
   00436|             .strip_prefix("https://github.com/")
   00437|             .or_else(|| url.strip_prefix("http://github.com/"))?;
   00438|         let segments: Vec<&str> = path.split('/').collect();
   00439|         (segments.len() == 4
   00440|             && !segments[0].is_empty()
   00441|             && !segments[1].is_empty()
   00442|             && matches!(segments[2], "issues" | "pull")
   00443|             && segments[3]
   00444|                 .chars()
   00445|                 .all(|character| character.is_ascii_digit()))
   00446|         .then(|| url.to_owned())
   00447|     })
   00448| }
   00449| /// Recover a command-output file request from a structural, seed-backed frame.
   00450| ///
   00451| /// The command must immediately follow a seed-defined run verb and be enclosed
   00452| /// in single quotes, double quotes, or backticks. The suffix must name a
   00453| /// seed-defined command-output reference, a file-write action, and a safe target
   00454| /// introduced by a write target/destination cue. Requiring every element keeps
   00455| /// an incidental quoted phrase or filename from becoming executable.
   00456| fn parse_command_output_request(request: &str) -> Option<(String, String)> {
   00457|     let toks = tokens(request);
   00458|     let run_verbs = seed::terminal_command_vocabulary().run_verbs;
   00459|     let actions = bare_surfaces(seed::ROLE_FILE_WRITE_ACTION_CUE);
   00460|     let targets = bare_surfaces(seed::ROLE_FILE_WRITE_TARGET_CUE);
   00461|     let destinations = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);
   00462|     for run in toks
   00463|         .iter()
   00464|         .filter(|token| run_verbs.contains(&clean_cue_token(token.text)))
   00465|     {
   00466|         let tail = request.get(run.end..)?;
   00467|         let leading = tail.len() - tail.trim_start().len();
   00468|         let quoted = tail.get(leading..)?;
   00469|         let quote = quoted.chars().next()?;
   00470|         if !matches!(quote, '\'' | '"' | '`') {
   00471|             continue;
   00472|         }
   00473|         let body = quoted.get(quote.len_utf8()..)?;
   00474|         let Some(close) = body.find(quote) else {
   00475|             continue;
   00476|         };
   00477|         let command = body.get(..close)?.trim();
   00478|         if command.is_empty() || command.contains(['\n', '\r', '\0']) {
   00479|             continue;
   00480|         }
   00481|         let suffix_offset = run.end + leading + quote.len_utf8() + close + quote.len_utf8();
   00482|         let suffix = request.get(suffix_offset..)?;
   00483|         if !mentions_bare_role(suffix, seed::ROLE_FILE_WRITE_COMMAND_OUTPUT_REFERENCE) {
   00484|             continue;
   00485|         }
   00486|         let suffix_tokens = tokens(suffix);
   00487|         let has_write_action = suffix_tokens
   00488|             .iter()
   00489|             .any(|token| actions.contains(&clean_cue_token(token.text)));
   00490|         if !has_write_action {
   00491|             continue;
   00492|         }
   00493|         let target = suffix_tokens.iter().enumerate().find_map(|(index, token)| {
   00494|             let cleaned = clean_path_token(token.text);
   00495|             let looks_like_file = looks_like_file_path(cleaned);
   00496|             let previous = index
   00497|                 .checked_sub(1)
   00498|                 .map(|position| &suffix_tokens[position])?;
   00499|             let cue = clean_cue_token(previous.text);
   00500|             (looks_like_file
   00501|                 && safe_relative_path(cleaned)
   00502|                 && (targets.contains(&cue) || destinations.contains(&cue)))
   00503|             .then(|| cleaned.to_owned())
   00504|         });
   00505|         if let Some(target) = target {
   00506|             return Some((target, command.to_owned()));
   00507|         }
   00508|     }
   00509|     None
   00510| }
   00511| pub(super) fn mentions_bare_role(text: &str, role: &str) -> bool {
   00512|     let lower = text.to_lowercase();
   00513|     seed::lexicon()
   00514|         .role_word_forms(role)
   00515|         .iter()
   00516|         .filter(|form| form.slot() == Slot::Bare)
   00517|         .any(|form| {
   00518|             let needle = form.text.to_lowercase();
   00519|             let Some(start) = lower.find(&needle) else {
   00520|                 return false;
   00521|             };
   00522|             if !needle.is_ascii() {
   00523|                 return true;
   00524|             }
   00525|             let end = start + needle.len();
   00526|             let before_ok = start == 0
   00527|                 || lower[..start]
   00528|                     .chars()
   00529|                     .next_back()
   00530|                     .is_some_and(|character| !character.is_alphanumeric());
   00531|             let after_ok = end == lower.len()
   00532|                 || lower[end..]
   00533|                     .chars()
   00534|                     .next()
   00535|                     .is_some_and(|character| !character.is_alphanumeric());
   00536|             before_ok && after_ok
   00537|         })
   00538| }
   00539| pub(super) fn shell_quote(value: &str) -> String {
   00540|     format!("'{}'", value.replace('\'', "'\\''"))
   00541| }
   00542| fn command_plan_text(intent: &str, language: &str, target: &str) -> String {
   00543|     seed::localized_response(intent, language)
   00544|         .unwrap_or_else(|| intent.to_owned())
   00545|         .replace(TARGET_PLACEHOLDER, target)
   00546| }
   00547| /// Whether `lower` (an already-lowercased request) is a file **write / create**
   00548| /// intent — a write verb applied to something file-shaped. This is the single
   00549| /// signal the router uses to keep a file-creation request from ever being
   00550| /// misrouted to the file-read recipe (issue #681): a request to *produce* a file
   00551| /// is a write, never a read of the not-yet-existing target.
   00552| ///
   00553| /// This is intentionally the same structural parse used to compose the eventual
   00554| /// write plan. A request is classified as a write only when the seed-defined
   00555| /// action/target/content roles yield a safe target and non-empty payload. One
   00556| /// parser for classification and composition cannot drift into claiming an
   00557| /// operation that the planner is unable to execute.
   00558| #[must_use]
   00559| pub(crate) fn has_file_write_intent(lower: &str) -> bool {
   00560|     parse_write_request(lower).is_some()
   00561| }
   00562| /// Whether a request explicitly marks its recovered payload as authoritative
   00563| /// literal bytes rather than a description of another workspace operation.
   00564| ///
   00565| /// The marker is seed-backed and multilingual. Requiring both the narrow marker
   00566| /// role and a successfully composed literal-file plan prevents arbitrary prose
   00567| /// containing "exactly" from changing planner precedence.
   00568| pub(super) fn has_authoritative_literal_write(request: &str) -> bool {
   00569|     let normalized = request.to_lowercase();
   00570|     let authoritative = first_prefix_lead_end(
   00571|         &normalized,
   00572|         seed::ROLE_FILE_WRITE_AUTHORITATIVE_CONTENT_LEAD,
   00573|     )
   00574|     .is_some()
   00575|         || literal_payload(request).is_some();
   00576|     authoritative
   00577|         && compose_general_change_plan(request)
   00578|             .is_some_and(|plan| plan.mode == GeneralPlanMode::LiteralFile)
   00579| }
   00580| /// Recover the `(target, content)` of a write request from its wording.
   00581| ///
   00582| /// The recogniser is entirely seed-driven (issue #680). It locates the target
   00583| /// file by a `file_write_target_cue`/`file_write_destination_cue` that directly
   00584| /// precedes a file-looking, safe relative path, then recovers the content two
   00585| /// ways:
   00586| ///
   00587| /// * **Marker-led** — a `file_write_content_lead` phrase ("containing", "with
   00588| ///   the following", …) introduces the payload. The content is the span after
   00589| ///   the marker (when the file precedes it) or the span between the marker and
   00590| ///   the file clause (when the content precedes the file).
   00591| /// * **Destination-led** — the "write CONTENT to FILE" shape, where a
   00592| ///   `file_write_action_cue` opens the request and a *destination* cue (not a
   00593| ///   positional target cue) routes the preceding span into the file.
   00594| /// * **Action-led** — the "write FILE saying CONTENT" shape, where a
   00595| ///   `file_write_action_cue` ("write"/"create"/"save"/…) directly names the file
   00596| ///   and a content-lead marker introduces the payload after it. An action cue
   00597| ///   licenses the file just like a target cue, but only marker-led content is
   00598| ///   accepted for it, so a bare "create app.rs" (no content) still falls through
   00599| ///   to the ordinary solver rather than fabricating an empty file.
   00600| ///
   00601| /// Both byte offsets index the lowercased copy, which is byte-length preserving
   00602| /// for en/ru/hi/zh, so the same offsets slice the original request and the
   00603| /// recovered content keeps its case and punctuation.
   00604| fn parse_write_request(request: &str) -> Option<(String, String)> {
   00605|     let toks = tokens(request);
   00606|     if let Some(literal) = literal_payload(request) {
   00607|         // A closed whole-file payload supplies the content. Only target cues
   00608|         // before it bind the file; its internal prose is authored data.
   00609|         if let Some(binding) = ranked_bindings(&toks).into_iter().find(|candidate| {
   00610|             toks[candidate.index].end <= literal.start && candidate.cue_end <= literal.start
   00611|         }) {
   00612|             return Some((
   00613|                 binding.path,
   00614|                 clean_content(&request[literal.start..literal.end]).unwrap_or(literal.text),
   00615|             ));
   00616|         }
   00617|     }
   00618|     // A cue between two file-shaped tokens can belong to either of them, and the
   00619|     // ranking only says which reading to try first. The reading that recovers a
   00620|     // payload is the one the sentence supports, so the candidates are taken in
   00621|     // order and the first that parses is the answer. A sentence that offers one
   00622|     // candidate reaches exactly the branch it always did.
   00623|     ranked_bindings(&toks)
   00624|         .into_iter()
   00625|         .find_map(|binding| parse_write_request_bound(request, &toks, &binding))
   00626| }
   00627| 
   00628| /// Read `request` as a write delivered through one particular binding.
   00629| fn parse_write_request_bound(
   00630|     request: &str,
   00631|     toks: &[Token<'_>],
   00632|     binding: &WriteBinding,
   00633| ) -> Option<(String, String)> {
   00634|     let lowered = request.to_lowercase();
   00635|     let dest_cues = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);
   00636|     let file_index = binding.index;
   00637|     let target = binding.path.clone();
   00638|     // The clause is the cue and its path together, so it begins at whichever of
   00639|     // them the language puts first.
   00640|     let clause_start = if binding.cue_precedes {
   00641|         binding.cue_start
   00642|     } else {
   00643|         toks[file_index].start
   00644|     };
   00645|     let cue_is_destination = binding.family == CueFamily::Destination;
   00646|     // Marker-led content. The payload sits after the marker, bounded by the file
   00647|     // clause when the marker comes first ("write the following: hello to x.txt")
   00648|     // and running to the end when the clause comes first ("store file x.txt
   00649|     // containing hello").
   00650|     //
   00651|     // A marker that *precedes* the clause additionally needs a write verb, which
   00652|     // is the same rule the destination-led and assignment-shaped branches below
   00653|     // already apply — without it a read request whose object happens to be a
   00654|     // content-lead surface claims a write. The issue-#671 matrix caught
   00655|     // `show me the contents of the file beta.md` planning
   00656|     // `write(beta.md, "of the")`, destroying the fixture it was asked to read.
   00657|     // A marker inside a sentence that specifies a document to compose introduces
   00658|     // that document's structure, not its bytes; see
   00659|     // [`super::note_composition::composed_document_specification_span`]. Reading
   00660|     // it as a literal payload is what wrote "the selected tree level, node
   00661|     // outcomes, test results, and session id." into the ladder's final proof
   00662|     // file (issue #1066), and it claimed the request too, so the note the caller
   00663|     // asked for was never composed.
   00664|     let specification = super::note_composition::composed_document_specification_span(request);
   00665|     if let Some((_, marker_end)) = first_content_lead_end(&lowered)
   00666|         && !specification.is_some_and(|span| span.contains(&marker_end))
   00667|         && positions_share_statement(request, marker_end, clause_start)
   00668|     {
   00669|         let marker_leads = marker_end <= clause_start;
   00670|         let statement_end = if marker_leads {
   00671|             end_of_statement(request, marker_end, clause_start)
   00672|         } else {
   00673|             end_of_statement(request, marker_end, request.len())
   00674|         };
   00675|         // A circumfix marker states where its payload ends as well as where it
   00676|         // begins, and the closing literal is grammar rather than bytes: the
   00677|         // Hindi "जिसमें Gemfile.lock हो" would otherwise write the verb into the
   00678|         // file with the content.
   00679|         let payload_end = content_lead_close(&lowered, marker_end)
   00680|             .map_or(statement_end, |close| close.min(statement_end));
   00681|         let marker_span = request.get(marker_end..payload_end);
   00682|         if (!marker_leads || first_action_cue_end(toks).is_some())
   00683|             && let Some(content) = marker_span.and_then(clean_content).filter(|content| {
   00684|                 is_literal_content(content)
   00685|                     && (!names_deferred_work_product(content)
   00686|                         || first_prefix_lead_end(
   00687|                             &lowered,
   00688|                             seed::ROLE_FILE_WRITE_AUTHORITATIVE_CONTENT_LEAD,
   00689|                         )
   00690|                         .is_some()
   00691|                         || literal_payload(request).is_some())
   00692|             })
   00693|         {
   00694|             return Some((target, content));
   00695|         }
   00696|     }
   00697|     let content_span = if cue_is_destination && binding.cue_precedes {
   00698|         let action_end = first_action_cue_end(toks)?;
   00699|         (action_end <= clause_start && positions_share_statement(request, action_end, clause_start))
   00700|             .then(|| request.get(action_end..clause_start))?
   00701|     } else if cue_is_destination {
   00702|         // The same shape read from the other side. A language that marks its
   00703|         // destination with a postposition and closes the clause with the verb —
   00704|         // "notes/attribution.md में Gemfile.lock लिखो" — states the payload
   00705|         // between the two, exactly as the prepositional wording states it
   00706|         // between the verb and the preposition.
   00707|         let action_start = action_cue_start_after(toks, binding.cue_end)?;
   00708|         (binding.cue_end <= action_start
   00709|             && positions_share_statement(request, binding.cue_end, action_start))
   00710|         .then(|| request.get(binding.cue_end..action_start))?
   00711|     } else if let Some(value_lead) = toks
   00712|         .iter()
   00713|         .skip(file_index + 1)
   00714|         .find(|token| dest_cues.contains(&clean_cue_token(token.text)))
   00715|     {
   00716|         // Assignment shape: "set the contents of FILE to VALUE". The target
   00717|         // cue identifies the file object and a following destination cue
   00718|         // introduces its literal value. Requiring a write action before the
   00719|         // file keeps an unrelated "contents of FILE" read request out.
   00720|         let action_end = first_action_cue_end(toks)?;
   00721|         (action_end <= clause_start
   00722|             && positions_share_statement(request, action_end, clause_start)
   00723|             && positions_share_statement(request, clause_start, value_lead.start))
   00724|         .then(|| request.get(value_lead.end..))?
   00725|     } else {
   00726|         None
   00727|     };
   00728|     let content = clean_content(content_span?)?;
   00729|     // A recovered payload that is *only* a non-referential subject ("save it to
   00730|     // FILE", "write this to FILE") names no literal content — the pronoun points
   00731|     // back at content the request expects the recipe to still compose. Treating
   00732|     // it as a literal write both fabricates the wrong file (the string "it") and
   00733|     // steals the request from the keyword recipe that would author the real
   00734|     // artifact, so fall through instead (issue #663).
   00735|     //
   00736|     // The same is true of a payload that names the *work product* rather than
   00737|     // supplying it: "save the answer to FILE" states where an answer goes, not
   00738|     // what it says (issue #1066).
   00739|     if is_non_referential_content(&content)
   00740|         || names_deferred_work_product(&content)
   00741|         || !is_literal_content(&content)
   00742|     {
   00743|         return None;
   00744|     }
   00745|     Some((target, content))
   00746| }
   00747| /// Where the statement that begins at `from` ends, never past `limit`.
   00748| ///
   00749| /// A literal payload is something the request *states*, and a statement ends
   00750| /// where its sentence does. Bounding the span by the file clause alone reads
   00751| /// across every sentence in between: "Draft a handover memo containing the
   00752| /// migration status, the outstanding blockers, and the on-call owner. Leave the
   00753| /// memo in `handover/2026-q3.md`" put the marker in the first sentence and the
   00754| /// clause in the second, so the recovered payload ended with the words *Leave
   00755| /// the memo* and the caller's memo opened by instructing them to leave it
   00756| /// (issue #1066).
   00757| ///
   00758| /// The clause bound still applies inside the sentence, because "write the
   00759| /// following: hello to `x.txt`" states marker, payload and clause in one
   00760| /// breath. This only refuses to look further than the sentence the marker is in.
   00761| ///
   00762| /// A marker that says nothing more on its own line is the exception, because
   00763| /// there the payload is a *block* rather than a phrase: "Create file
   00764| /// `rules.lino` containing\n<three lines of lino>" leaves the marker with an
   00765| /// empty tail, and a newline ends a sentence, so the sentence bound would
   00766| /// recover nothing at all. When the marker's own line has no word left on it,
   00767| /// the statement is the block that follows and runs to `limit`, which is what
   00768| /// this route always did for block payloads.
   00769| ///
   00770| /// The sentence is the one *prose* reads, so a semicolon inside the payload
   00771| /// joins its two halves instead of ending it. Reading the payload at the scope
   00772| /// shell routing reads at cut issue #918's minimal-core invariant in half at
   00773| /// its semicolon.
   00774| fn end_of_statement(request: &str, from: usize, limit: usize) -> usize {
   00775|     let Some(sentence) = prose_sentences(request)
   00776|         .into_iter()
   00777|         .find(|sentence| sentence.span.contains(&from))
   00778|     else {
   00779|         return limit;
   00780|     };
   00781|     if let Some(literal) = crate::normal_markov::quoted_segment_spans(request)
   00782|         .into_iter()
   00783|         .find(|segment| {
   00784|             segment.start >= from
   00785|                 && segment.start < sentence.span.end
   00786|                 && segment.end > sentence.span.end
   00787|         })
   00788|     {
   00789|         return literal.end.min(limit);
   00790|     }
   00791|     let says_more = request
   00792|         .get(from..sentence.span.end)
   00793|         .is_some_and(|tail| tail.chars().any(char::is_alphanumeric));
   00794|     if says_more && !payload_continues_past_its_first_line(request, from, sentence.span.end) {
   00795|         sentence.span.end.min(limit)
   00796|     } else {
   00797|         limit
   00798|     }
   00799| }
   00800| /// Whether two write-request cues belong to one prose statement.
   00801| ///
   00802| /// Literal-write roles are structural only inside the statement that relates
   00803| /// them. Without this check, a content lead in one issue-description paragraph
   00804| /// can pair with an incidental file-shaped token in a later paragraph and turn
   00805| /// repository policy prose into an executable write (issue #1069).
   00806| ///
   00807| /// [`end_of_statement`] deliberately lets a marker-only line introduce the
   00808| /// block below it. Reusing that boundary here preserves that supported block
   00809| /// shape while rejecting ordinary completed sentences between the two cues.
   00810| fn positions_share_statement(request: &str, left: usize, right: usize) -> bool {
   00811|     let (from, limit) = if left <= right {
   00812|         (left, right)
   00813|     } else {
   00814|         (right, left)
   00815|     };
   00816|     from == limit || end_of_statement(request, from, limit) == limit
   00817| }
   00818| /// Whether a recovered payload says anything at all. A span of nothing but
   00819| /// punctuation is what a mis-parse leaves behind — the `opencode` leg of the
   00820| /// issue-#671 matrix recovered a single `"`, the tail of a quoted prompt after
   00821| /// its trailing content-lead marker — and writing it would replace real file
   00822| /// bytes with a stray delimiter.
   00823| fn is_literal_content(content: &str) -> bool {
   00824|     content.chars().any(char::is_alphanumeric)
   00825| }
   00826| /// Whether a recovered write payload is nothing but a non-referential subject —
   00827| /// a bare pronoun/function word ("it", "this", "that", …) that refers back to
   00828| /// context rather than naming literal content. The surfaces carry the
   00829| /// [`seed::ROLE_NON_REFERENTIAL_SUBJECT`] role; only whole-word
   00830| /// ([`Slot::Bare`]) forms are rejected, so legitimate content that merely
   00831| /// *begins* with such a word ("to be or not to be") is still accepted.
   00832| fn is_non_referential_content(content: &str) -> bool {
   00833|     let lower = content.to_lowercase();
   00834|     seed::lexicon()
   00835|         .role_word_forms(seed::ROLE_NON_REFERENTIAL_SUBJECT)
   00836|         .iter()
   00837|         .any(|form| form.slot() == Slot::Bare && lower == form.text)
   00838| }
   00839| /// Whether a recovered write payload names the result of work the same request
   00840| /// asks for, instead of supplying bytes (issue #1066).
   00841| ///
   00842| /// "Save the answer to `out/e.md`" and "leave observable evidence to
   00843| /// `out/e.md`" have the destination-led shape of a literal write -- a write
   00844| /// verb, a span, a destination cue, a path -- and supply no literal. Taking the
   00845| /// span at face value wrote the words *the answer* into the file and, worse,
   00846| /// claimed the request as finished, so the investigation that would have
   00847| /// produced the real bytes never ran.
   00848| ///
   00849| /// The surfaces carry [`seed::ROLE_FILE_WRITE_DEFERRED_CONTENT_REFERENCE`] as
   00850| /// [`Slot::Suffix`] forms, because the head noun is what defers and the
   00851| /// modifiers in front of it ("observable", "final") are the caller's, not the
   00852| /// lexicon's.
   00853| ///
   00854| /// Applied to marker-led content too: “with the observed result” uses a content
   00855| /// marker syntactically, but still names work that has not happened. Explicit
   00856| /// bytes remain expressible through the authoritative-content marker, whose
   00857| /// distinct role is routed before derived-delivery planning.
   00858| fn names_deferred_work_product(content: &str) -> bool {
   00859|     let lower = content
   00860|         .trim()
   00861|         .trim_end_matches(['.', '!', '?', '。', '！', '？'])
   00862|         .trim_end()
   00863|         .to_lowercase();
   00864|     seed::lexicon()
   00865|         .role_word_forms(seed::ROLE_FILE_WRITE_DEFERRED_CONTENT_REFERENCE)
   00866|         .iter()
   00867|         .any(|form| match form.slot() {
   00868|             Slot::Bare => lower == form.text,
   00869|             Slot::Suffix => ends_with_head_noun(&lower, form.after_slot().trim_start()),
   00870|             Slot::Prefix | Slot::Circumfix => false,
   00871|         })
   00872| }
   00873| /// Whether `content` ends with `noun` standing as its own word.
   00874| ///
   00875| /// English and Russian separate a head noun from its modifiers with a space, so
   00876| /// the character before the match settles it. Chinese writes the same phrase
   00877| /// with no separator at all, which is why the boundary is stated as "not an
   00878| /// ASCII alphanumeric" rather than "whitespace": demanding a space would never
   00879| /// match 结论, and demanding nothing would match the tail of an unrelated
   00880| /// English word.
   00881| fn ends_with_head_noun(content: &str, noun: &str) -> bool {
   00882|     !noun.is_empty()
   00883|         && content.strip_suffix(noun).is_some_and(|before| {
   00884|             before
   00885|                 .chars()
   00886|                 .next_back()
   00887|                 .is_none_or(|character| !character.is_ascii_alphanumeric())
   00888|         })
   00889| }
   00890| /// Resolve an edit target named in a request through the workspace self-AST
   00891| /// census (issue #673).
   00892| ///
   00893| /// Before the census existed, the planner could only edit a file the request spelt
   00894| /// out in full, and its own self-inspection was pinned to a single hardcoded module
   00895| /// (`src/agentic_coding/planner.rs`). Now any `path`, `path:symbol`, unambiguous
   00896| /// module suffix, or uniquely-declared item name resolves to the real module path
   00897| /// through [`crate::self_ast_census`], so the planner can address every module of
   00898| /// the workspace by the same mechanism.
   00899| ///
   00900| /// The token must *address* the workspace to be resolved: it has to carry a
   00901| /// directory component (`agentic_coding/source_links.rs`) or a `path:symbol`
   00902| /// pair (`self_ast_census.rs:resolve_census_target`). A bare file name such as
   00903| /// `main.rs` is left exactly as the request spelt it, because the request may be
   00904| /// about the *client's* working directory rather than this workspace, and an
   00905| /// ordinary word that happens to match an item name is never mistaken for an edit
   00906| /// target. The census itself fails closed on anything ambiguous.
   00907| #[must_use]
   00908| pub fn resolve_census_target(reference: &str) -> Option<CensusResolution> {
   00909|     let addresses_workspace =
   00910|         reference.contains('/') || (reference.contains(':') && !reference.contains("://"));
   00911|     if !addresses_workspace {
   00912|         return None;
   00913|     }
   00914|     self_ast_census::workspace().resolve(reference)
   00915| }
   00916| /// Whether `text` carries a software-authoring verb (implement, resolve,
   00917| /// develop, …) in any seeded language.
   00918| #[must_use]
   00919| pub fn mentions_software_authoring(text: &str) -> bool {
   00920|     mentions_bare_role(text, seed::ROLE_SOFTWARE_AUTHORING_ACTION)
   00921| }
   00922| const fn capability_slug(capability: Capability) -> &'static str {
   00923|     match capability {
   00924|         Capability::Search => "Search",
   00925|         Capability::Fetch => "Fetch",
   00926|         Capability::Read => "Read",
   00927|         Capability::Write => "Write",
   00928|         Capability::Edit => "Edit",
