   00168|     for segment in quoted
   00169|         .iter()
   00170|         .rev()
   00171|         .filter(|segment| segment.end <= literal.start)
   00172|     {
   00173|         prefix.replace_range(
   00174|             segment.start..segment.end,
   00175|             &" ".repeat(segment.end - segment.start),
   00176|         );
   00177|     }
   00178|     let normalized = crate::engine::normalize_prompt(&prefix);
   00179|     let lexicon = crate::seed::lexicon();
   00180|     let overwrite = lexicon.mentions_role("file_overwrite_consent", &normalized);
   00181|     let lead = first_content_lead_end(&prefix.to_lowercase());
   00182|     if lead.is_none() && !overwrite {
   00183|         return None;
   00184|     }
