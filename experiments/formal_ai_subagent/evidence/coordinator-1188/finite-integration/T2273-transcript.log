   00161|     let literal = quoted.iter().find(|segment| {
   00162|         request[segment.end..].chars().all(|character| {
   00163|             character.is_whitespace()
   00164|                 || matches!(character, '.' | '!' | '?' | '。' | '！' | '？' | '।')
   00165|         })
   00166|     })?;
