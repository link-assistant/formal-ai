   00097|     /// Render the plan shape consumed by the driver and documented by the meta fixture.
   00098|     #[must_use]
   00099|     pub fn links_notation(&self) -> String {
   00100|         let mut out = String::from("general_change_plan\n");
   00101|         field(&mut out, "id", &self.id);
   00102|         field(&mut out, "execution_mode", self.mode.slug());
   00103|         field(&mut out, "terminal_state", self.terminal_state.slug());
   00104|         field(&mut out, "goal", &self.goal);
   00105|         field(&mut out, "target", &self.target);
   00106|         for (index, step) in self.steps.iter().enumerate() {
   00107|             let _ = writeln!(out, "  step {}", index + 1);
   00108|             field_nested(&mut out, "capability", capability_slug(step.capability));
   00109|             field_nested(&mut out, "action", &step.action);
   00110|             field_nested(&mut out, "expected_evidence", &step.expected_evidence);
   00111|             if let Some(command) = &step.command {
   00112|                 field_nested(&mut out, "command", command);
   00113|             }
   00114|         }
   00115|         if !self.verification_command.is_empty() {
   00116|             field(&mut out, "verification_command", &self.verification_command);
   00117|         }
   00118|         out
   00119|     }
