   00195|     let action_end = first_action_cue_end(&words)?;
   00196|     let action = crate::engine::normalize_prompt(&prefix[action_start..action_end]);
   00197|     (overwrite || lexicon.mentions_role("file_whole_write_action", &action))
   00198|         .then(|| literal.clone())
