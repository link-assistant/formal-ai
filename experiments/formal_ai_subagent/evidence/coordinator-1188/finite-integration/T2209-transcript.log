   00259|   fi
   00260| elif [[ -n "$NODE_FILTER" ]]; then
   00261|   # A filter names a subtree; a fixed depth selects that subtree's nodes at the
   00262|   # depth. `R` at depth 5 is all 32 leaves, a depth-4 node is its two leaves,
