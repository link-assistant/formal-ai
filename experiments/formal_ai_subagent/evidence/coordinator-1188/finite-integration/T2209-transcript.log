   00267|     filter_depth=$(awk -F. '{ print NF }' <<< "$NODE_FILTER")
   00268|   fi
   00269|   if (( filter_depth > TREE_DEPTH )); then
   00270|     expected=0
   00271|   else
   00272|     expected=$((1 << (TREE_DEPTH - filter_depth)))
   00273|   fi
   00274| else
   00275|   expected=$((1 << TREE_DEPTH))
   00276| fi
   00277| [[ "$selected_count" -eq "$expected" ]] || { echo "expected $expected selected nodes, got $selected_count" >&2; exit 1; }
