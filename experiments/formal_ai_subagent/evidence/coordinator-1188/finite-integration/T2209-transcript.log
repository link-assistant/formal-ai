   00292|   # known outputs for this node so a failed attempt cannot retain a prior
   00293|   # attempt's proof or effect and appear to have passed.
   00294|   rm -f "$session_dir/agent-stream.jsonl"
   00295|   rm -f "$session_dir/agent-stderr.log"
