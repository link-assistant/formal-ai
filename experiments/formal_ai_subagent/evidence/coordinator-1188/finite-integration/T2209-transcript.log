   00298|   rm -f "$session_dir/effect.lino"
   00299|   node_number=$(python3 - "$id" <<'PY'
   00300| import sys
   00301| node=sys.argv[1]
   00302| if node == 'R':
   00303|     print(0)
   00304| else:
   00305|     bits=''.join('0' if x == '1' else '1' for x in node.split('.'))
   00306|     print(int(bits, 2) + 1)
   00307| PY
   00308| )
   00309|   port=$((BASE_PORT + node_number))
   00310| 
   00311|   # Cleaning the scratch checkout is not what the ladder measures, and it must
   00312|   # never decide a node's verdict. `rm -rf` reports ENOTEMPTY for a directory
   00313|   # that gained a file while the walk was inside it, which is what a just-killed
   00314|   # server flushing its last write looks like; the trap runs under `set -e`, so
   00315|   # that single failure ended the whole run after a node the log had already
   00316|   # recorded as PASS. Retry briefly, then leave the directory to the operating
   00317|   # system's temporary sweeper rather than failing the node.
   00318|   cleanup_one() {
