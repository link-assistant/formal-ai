   00330|   reset_work || { printf '%s\tFAIL\tworktree_reset\n' "$id" | tee -a "$RUN_LOG"; return 1; }
   00331|   mkdir -p "$work/.agent-ladder"
   00332| 
   00333|   local child_diffs="" leaf_span=""
   00334|   if [[ "$depth" -eq 4 ]]; then
   00335|     local left_effect_source="${VERIFIED_EFFECTS[$left]:-}"
   00336|     local right_effect_source="${VERIFIED_EFFECTS[$right]:-}"
   00337|     if [[ ! -s "$left_effect_source" || ! -s "$right_effect_source" ]]; then
   00338|       printf '%s\tFAIL\tmissing_current_run_child_effect\n' "$id" | tee -a "$RUN_LOG"
   00339|       return 1
   00340|     fi
   00341|     # Issue #1085 (D4): a composite must also merge both children's diffs.
   00342|     if [[ ! -s "$OUT/$left/change.diff" || ! -s "$OUT/$right/change.diff" ]]; then
   00343|       printf '%s\tFAIL\tmissing_current_run_child_diff\n' "$id" | tee -a "$RUN_LOG"
   00344|       return 1
   00345|     fi
   00346|     child_diffs="$OUT/$left/change.diff $OUT/$right/change.diff"
