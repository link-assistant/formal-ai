   00151| python3 - "$OUT/leaves.tsv" "$NODES" <<'PY'
   00152| import sys
   00153| from pathlib import Path
   00154| leaves = {}
   00155| for line in Path(sys.argv[1]).read_text().splitlines():
   00156|     leaf, text, change_path, change_marker, change_guard, requirement = line.split('\t', 5)
   00157|     leaves[int(leaf[1:])] = (text, change_path, change_marker, change_guard, requirement)
   00158| 
   00159| def child(path, branch):
   00160|     return path + ("." if path else "") + str(branch)
   00161| 
   00162| def leaf_index(path):
   00163|     bits = ''.join('0' if p == '1' else '1' for p in path.split('.'))
   00164|     return int(bits, 2) + 1
   00165| 
   00166| def requirement_text(start, end):
   00167|     listed = ' '.join(f'({k}) {leaves[k][4]}' for k in range(start, end + 1))
   00168|     return ('Deliver these requirements in this repository; each names behaviour '
   00169|             'or a declaration, never a file, so find the declaration in the '
   00170|             'source tree first: ' + listed)
   00171| def emit(path, depth, out):
   00172|     if depth == 0:
   00173|         # Issue #1085 (D4): the root and every node down to depth 3 are
   00174|         # requirement-shaped; the prompt names behaviour, never a file.
   00175|         text = 'Root task: ' + requirement_text(1, 32)
   00176|         criterion = 'requirement_changes'
   00177|         node_id = 'R'
   00178|     elif depth == 5:
   00179|         i = leaf_index(path)
   00180|         node_id = path
   00181|         leaf_text, criterion_path, criterion_marker, criterion_guard, _requirement = leaves[i]
   00182|         text = f'Atomic task L{i:02d}: {leaf_text}'
   00183|         criterion = 'tracked_source_change'
   00184|     else:
   00185|         node_id = path
   00186|         bits = ''.join('0' if p == '1' else '1' for p in path.split('.'))
   00187|         prefix = int(bits, 2)
   00188|         span = 2 ** (5 - depth)
   00189|         start = prefix * span + 1
   00190|         end = (prefix + 1) * span
   00191|         if depth <= 3:
   00192|             text = f'Decomposition node {path}: ' + requirement_text(start, end)
   00193|             criterion = 'requirement_changes'
   00194|         else:
   00195|             text = f'Complete recursive decomposition node {path}, covering atomic tasks L{start:02d}–L{end:02d}; both child nodes must produce independently checkable evidence.'
   00196|             criterion = 'new_composite_effect'
   00197|     if depth < 5:
   00198|         criterion_path = ''
   00199|         criterion_marker = ''
   00200|         criterion_guard = ''
   00201|     left = child(path, 1) if depth < 5 else ''
   00202|     right = child(path, 2) if depth < 5 else ''
   00203|     out.append((node_id, depth, text, criterion, left, right, criterion_path,
   00204|                 criterion_marker, criterion_guard))
   00205|     if depth < 5:
   00206|         emit(child(path,1), depth+1, out)
   00207|         emit(child(path,2), depth+1, out)
   00208| 
   00209| rows=[]
   00210| emit('',0,rows)
   00211| # `depth` is an int, and str.join refuses a non-str item, so joining the row
   00212| # straight raised TypeError before a single node was ever selected. Render
   00213| # every field before joining rather than trusting the tuple to be all strings.
   00214| # Empty optional fields belong to the in-memory row, but emitting their trailing
   00215| # separators makes the committed TSV fail git's whitespace check. Readers pad
