   00222| python3 - "$NODES" "$TREE_DEPTH" "$NODE_FILTER" > "$OUT/selected.tsv" <<'PY'
   00223| import sys
   00224| from pathlib import Path
   00225| rows=[]
   00226| for line in Path(sys.argv[1]).read_text().splitlines():
   00227|     fields = line.split('\t', 8)
   00228|     if not 6 <= len(fields) <= 9:
   00229|         raise ValueError(f'node row has {len(fields)} fields, expected 6 through 9: {line!r}')
   00230|     fields.extend([''] * (9 - len(fields)))
   00231|     (node, depth, text, criterion, left, right,
   00232|      criterion_path, criterion_marker, criterion_guard) = fields
   00233|     rows.append((node, int(depth), text, criterion, left, right,
   00234|                  criterion_path, criterion_marker, criterion_guard))
   00235| mode=sys.argv[2]
   00236| filt=sys.argv[3]
   00237| levels=list(range(5,-1,-1)) if mode=='all' else [int(mode)]
   00238| for level in levels:
   00239|     for row in rows:
   00240|         node, depth, *_ = row
   00241|         in_focused_subtree = (
   00242|             not filt
   00243|             or filt == 'R'
   00244|             or node == filt
   00245|             or node.startswith(filt + '.')
   00246|         )
   00247|         if depth == level and in_focused_subtree:
   00248|             print('\t'.join(map(str,row)).rstrip('\t'))
   00249| PY
