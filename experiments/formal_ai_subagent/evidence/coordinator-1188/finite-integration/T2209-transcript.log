   00381| 
   00382|   # The model's limits come from the server, not from the client's built-in
   00383|   # table. The Agent CLI ships a `formal-ai` model with a 60000-token context,
   00384|   # and Formal AI counts one token per character, so a single read and write of
   00385|   # a 25 KB source file crossed the CLI's compaction threshold: the session was
   00386|   # summarized, the read and write evidence vanished, and the leaf re-planned
   00387|   # read -> write until its budget ran out without a proof (run 37663996930,
   00388|   # 15 of 32 leaves `missing_proof`; PR #1188 dogfooding). The served
   00389|   # `/v1/models` states the real window and output cap.
   00390|   limits="$(curl -fsS "http://127.0.0.1:$port/api/openai/v1/models" \
   00391|     | python3 -c 'import json, sys; m = json.load(sys.stdin)["models"][0]; print(m["context_window_tokens"], m["max_output_tokens"])' \
   00392|     2>/dev/null || true)"
   00393|   model_limit=""
   00394|   if [[ "$limits" =~ ^([0-9]+)\ ([0-9]+)$ ]]; then
   00395|     model_limit="$(printf ',\"limit\":{\"context\":%s,\"output\":%s}' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")"
   00396|   fi
   00397|   config="$(printf '{\"provider\":{\"formalai\":{\"name\":\"Formal AI\",\"npm\":\"@ai-sdk/openai-compatible\",\"options\":{\"baseURL\":\"http://127.0.0.1:%s/api/openai/v1\",\"apiKey\":\"local\"},\"models\":{\"formal-ai\":{\"name\":\"Formal AI\"%s}}}},\"model\":\"formalai/formal-ai\"}' "$port" "$model_limit")"
