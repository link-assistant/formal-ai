   00363| PY
   00364| )
   00365|   fi
   00366| 
   00367|   # `setsid` gives the server its own process group so `kill -- -pid` takes
   00368|   # its children with it. macOS has no setsid; there the plain kill in
   00369|   # cleanup_one still stops the server, so a developer can run one node.
   00370|   "${SETSID[@]}" env FORMAL_AI_AGENT_MODE=1 FORMAL_AI_TRACE_REQUESTS=1 \
   00371|     FORMAL_AI_MEMORY_PATH="$STAGE/memory/node-$id/memory.lino" \
   00372|     FORMAL_AI_DREAMING=0 "$BIN" serve --agent-mode --host 127.0.0.1 --port "$port" \
   00373|     >"$session_dir/formal-ai.log" 2>&1 &
   00374|   server_pid=$!
   00375| 
   00376|   if ! curl -fsS --retry 30 --retry-delay 1 --retry-connrefused "http://127.0.0.1:$port/health" >/dev/null; then
   00377|     printf '%s\tFAIL\tformal_ai_server_start\n' "$id" | tee -a "$RUN_LOG"
