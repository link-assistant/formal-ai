   00107| # Return the shared worktree to the base commit with nothing left over from the
   00108| # previous node. A leftover would let one node inherit another's edit, so a tree
   00109| # that is still dirty after the reset is a hard failure, not a warning.
   00110| reset_work() {
   00111|   git -C "$WORK" checkout -q --detach "$BASE_SHA"
   00112|   git -C "$WORK" reset -q --hard "$BASE_SHA"
   00113|   git -C "$WORK" clean -qfdx
   00114|   local leftover
   00115|   leftover=$(git -C "$WORK" status --porcelain)
   00116|   if [[ -n "$leftover" ]]; then
   00117|     echo "reset_work: worktree still dirty after reset:" >&2
   00118|     printf '%s\n' "$leftover" >&2
   00119|     return 1
   00120|   fi
   00121| }
