   00131| /// uses, so the request's own language answers it.
   00132| fn failed_step_answer(label: &str, raw: &str, request: &str) -> Option<String> {
   00133|     super::tool_result::harness_reported_failure(raw)
   00134|         .then(|| super::tool_result::render(label, raw, request))
   00135| }
