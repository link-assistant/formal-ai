   00772| /// an unchecked Markdown box: syntax rather than natural-language domain data.
   00773| fn file_analysis_pattern() -> String {
   00774|     let mut alternatives = vec![String::from(r"\[\s*\]")];
   00775|     alternatives.extend(
   00776|         seed::lexicon()
   00777|             .words_for_role(seed::ROLE_FILE_ANALYSIS_GAP_MARKER)
   00778|             .into_iter()
   00779|             .filter(|surface| !surface.trim().is_empty())
   00780|             .map(|surface| regex_escape(&surface)),
   00781|     );
   00782|     alternatives.sort();
   00783|     alternatives.dedup();
   00784|     format!("(?i)(?:{})", alternatives.join("|"))
