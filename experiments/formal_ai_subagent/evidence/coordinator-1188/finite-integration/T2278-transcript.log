   00594| fn directory_for_list_read(prompt: &str) -> Option<String> {
   00595|     let tokens = prompt
   00596|         .split_whitespace()
   00597|         .map(clean_file_token)
   00598|         .collect::<Vec<_>>();
   00599|     for window in tokens.windows(3) {
   00600|         if window[0].eq_ignore_ascii_case("the")
   00601|             && !window[1].is_empty()
   00602|             && (window[2].eq_ignore_ascii_case("folder")
   00603|                 || window[2].eq_ignore_ascii_case("directory"))
   00604|         {
   00605|             return Some(window[1].clone());
   00606|         }
   00607|         if (window[0].eq_ignore_ascii_case("in") || window[0].eq_ignore_ascii_case("inside"))
   00608|             && window[1].eq_ignore_ascii_case("the")
   00609|             && !window[2].is_empty()
   00610|         {
   00611|             return Some(window[2].clone());
   00612|         }
   00613|     }
   00614|     for window in tokens.windows(2) {
   00615|         let lower = window[0].to_ascii_lowercase();
   00616|         if !window[0].is_empty()
   00617|             && (window[1].eq_ignore_ascii_case("folder")
   00618|                 || window[1].eq_ignore_ascii_case("directory"))
   00619|             && !["the", "a", "this", "current"].contains(&lower.as_str())
   00620|         {
   00621|             return Some(window[0].clone());
   00622|         }
   00623|     }
