   00699| /// Whether a recorded path argument denotes the path the planner asked for.
   00700| ///
   00701| /// The transcript holds the argument the *client's* schema accepted, not the one
   00702| /// the planner planned with: [`crate::protocol_responses`] rewrites `path` to
   00703| /// Gemini's `absolute_path` and absolutises it, so a recorded
   00704| /// `/work/alpha.txt` has to answer a planned `alpha.txt`.
   00705| fn same_path(recorded: &str, planned: &str) -> bool {
   00706|     if recorded == planned {
   00707|         return true;
   00708|     }
   00709|     let planned = planned.trim_start_matches("./");
   00710|     recorded
   00711|         .trim_start_matches("./")
   00712|         .strip_suffix(planned)
   00713|         .is_some_and(|prefix| prefix.is_empty() || prefix.ends_with('/'))
   00714| }
