   00085| /// The issue-#627 file-reading recipe: direct filename requests use an advertised
   00086| /// `read` tool, shell-shaped `cat` requests use the run tool, and multi-step
   00087| /// "list then read" prompts walk `bash(ls)` → `read(file)` → final content.
   00088| pub(super) fn plan_file_read_step(
   00089|     task: &FileReadTask,
   00090|     messages: &[ChatMessage],
   00091|     tool_names: &[&str],
   00092|     result: &mut Option<FinalResult>,
   00093| ) -> AgenticPlan {
   00094|     let read_tool = tool_for(tool_names, Capability::Read);
   00095|     let run_tool = tool_for(tool_names, Capability::Run);
   00096|     let grep_tool = tool_for(tool_names, Capability::Grep);
   00097|     let tools = FileReadTools {
   00098|         read: read_tool,
   00099|         run: run_tool,
   00100|         grep: grep_tool,
   00101|     };
   00102|     let records = tool_result_records(messages);
   00103|     let request = crate::protocol::latest_user_request(messages).unwrap_or_default();
   00104| 
   00105|     match task {
   00106|         FileReadTask::Direct {
   00107|             path,
   00108|             mode,
   00109|             prefer_run,
   00110|         } => plan_direct_file_read(path, mode, *prefer_run, tools, &records, &request, result),
   00111|         FileReadTask::DirectMany { paths, mode } => {
   00112|             exact::plan_direct_file_reads(paths, mode, tools, &records, &request, result)
   00113|         }
   00114|         FileReadTask::ListThenRead {
   00115|             directory,
   00116|             selection,
   00117|             mode,
   00118|         } => plan_list_then_read(
   00119|             directory, *selection, mode, tools, &records, &request, result,
   00120|         ),
   00121|     }
   00122| }
