   00519| fn leading_cat_path(prompt: &str) -> Option<String> {
   00520|     let trimmed = prompt.trim().trim_matches('`').trim();
   00521|     let mut parts = trimmed.split_whitespace();
   00522|     let command = parts.next()?;
   00523|     if !command.eq_ignore_ascii_case("cat") {
   00524|         return None;
   00525|     }
   00526|     parts
   00527|         .next()
   00528|         .map(clean_file_token)
   00529|         .filter(|path| !path.is_empty())
   00530| }
   00531| 
   00532| fn first_local_file_path(prompt: &str) -> Option<String> {
   00533|     local_file_paths(prompt).into_iter().next()
   00534| }
   00535| 
   00536| fn local_file_paths(prompt: &str) -> Vec<String> {
   00537|     let mut paths = prompt
   00538|         .split_whitespace()
   00539|         .map(clean_file_token)
   00540|         .filter(|token| looks_like_local_file_path(token))
   00541|         .collect::<Vec<_>>();
