   00627| fn tool_result_records(messages: &[ChatMessage]) -> Vec<ToolResultRecord> {
   00628|     // Only results produced *within the current user turn* ground a read. A
   00629|     // client loops tool calls without a new user message, so the current turn is
   00630|     // everything after the last user message; a `cat 1.txt` result from an
   00631|     // earlier turn must never be replayed as the answer to a later `read 1.txt`
   00632|     // (issue #755 — read/list determinism). Without this bound the recipe short
   00633|     // -circuits on a stale, unrelated result and skips the fresh read entirely.
   00634|     let turn_start = messages
   00635|         .iter()
   00636|         .rposition(|message| message.role.eq_ignore_ascii_case("user"))
   00637|         .map_or(0, |index| index + 1);
   00638|     let mut records = Vec::new();
   00639|     for (index, message) in messages.iter().enumerate().skip(turn_start) {
   00640|         if !message.role.eq_ignore_ascii_case("tool") {
   00641|             continue;
   00642|         }
   00643|         let (capability, arguments) =
   00644|             tool_result_call(messages, index).map_or((None, serde_json::Value::Null), |call| {
   00645|                 (
   00646|                     tool_capability(&call.function.name),
   00647|                     serde_json::from_str(&call.function.arguments)
   00648|                         .unwrap_or(serde_json::Value::Null),
   00649|                 )
   00650|             });
   00651|         records.push(ToolResultRecord {
   00652|             capability,
   00653|             arguments,
   00654|             content: message.content.plain_text(),
   00655|         });
   00656|     }
   00657|     records
   00658| }
   00659| 
   00660| fn tool_result_call(messages: &[ChatMessage], index: usize) -> Option<&ToolCall> {
   00661|     let call_id = messages[index].tool_call_id.as_ref()?;
   00662|     messages[..index]
   00663|         .iter()
   00664|         .flat_map(|prior| prior.tool_calls.iter())
   00665|         .find(|call| &call.id == call_id)
   00666| }
