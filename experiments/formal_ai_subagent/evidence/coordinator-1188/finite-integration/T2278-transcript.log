   00546| /// A path token as prose wrote it, stripped of the punctuation the sentence put
   00547| /// around it.
   00548| ///
   00549| /// The terminating dot is delegated to
   00550| /// [`trim_trailing_sentence_dot`](super::file_path_shape::trim_trailing_sentence_dot)
   00551| /// so the read route, the write-request parser and the shell route all draw the
   00552| /// same boundary between a path and the sentence carrying it.
   00553| fn clean_file_token(token: &str) -> String {
   00554|     peel_sentence_punctuation(token, |token| {
   00555|         token
   00556|             .trim_matches('`')
   00557|             .trim_matches('"')
   00558|             .trim_matches('\'')
   00559|             .trim_matches(|c: char| {
   00560|                 matches!(
   00561|                     c,
   00562|                     ',' | ';' | ':' | '!' | '?' | ')' | '(' | '[' | ']' | '{' | '}'
   00563|                 )
   00564|             })
   00565|     })
   00566|     .to_owned()
   00567| }
   00568| 
   00569| fn looks_like_local_file_path(token: &str) -> bool {
   00570|     if token.is_empty()
   00571|         || token.contains("://")
   00572|         || token.starts_with("http:")
   00573|         || token.starts_with("https:")
   00574|         || is_dotted_number(token)
   00575|     {
   00576|         return false;
   00577|     }
   00578|     if token.contains('/') {
   00579|         return token.chars().all(is_file_path_char);
   00580|     }
   00581|     let Some((stem, extension)) = token.rsplit_once('.') else {
   00582|         return false;
   00583|     };
   00584|     !stem.is_empty()
   00585|         && !extension.is_empty()
   00586|         && extension.len() <= 12
   00587|         && token.chars().all(is_file_path_char)
   00588| }
   00589| 
   00590| const fn is_file_path_char(character: char) -> bool {
   00591|     character.is_ascii_alphanumeric() || matches!(character, '_' | '-' | '.' | '/' | '\\' | '@')
   00592| }
