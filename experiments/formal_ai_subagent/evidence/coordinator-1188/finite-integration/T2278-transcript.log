   00329| /// Shell syntax that chains, pipes or redirects commands.
   00330| const SHELL_OPERATORS: [&str; 5] = ["&&", "||", ";", "|", ">"];
   00331| 
   00332| pub(super) fn file_read_task_for(prompt: &str) -> Option<FileReadTask> {
   00333|     let lower = prompt.to_lowercase();
   00334| 
   00335|     // Issue #681: a file-creation / write request must never be routed to the read
   00336|     // recipe — the target does not exist yet, so reading it is always the wrong
   00337|     // tool. When the request is a write intent, decline here and let the router
   00338|     // fall through to the general write/create planner. This is the general rule
   00339|     // ("write intent beats read intent"), not a per-phrase special case: the same
   00340|     // gate catches create/write/save/generate across every supported language.
   00341|     if has_file_write_intent(&lower) {
   00342|         return None;
   00343|     }
   00344|     // A command quoted after a run prefix that chains, pipes or redirects is
   00345|     // run as written, not read file by file (PR #1188 G62).
   00346|     if super::shell_command::explicit_passthrough_command(prompt).is_some_and(|command| {
   00347|         SHELL_OPERATORS
   00348|             .iter()
   00349|             .any(|operator| command.contains(operator))
   00350|     }) {
   00351|         return None;
   00352|     }
   00353| 
   00354|     if let Some(path) = leading_cat_path(prompt) {
   00355|         return Some(FileReadTask::Direct {
   00356|             path,
   00357|             mode: FileReadMode::Full,
   00358|             prefer_run: false,
   00359|         });
   00360|     }
   00361| 
   00362|     if asks_to_read_every_file(&lower) {
   00363|         return Some(FileReadTask::ListThenRead {
   00364|             directory: String::from("."),
   00365|             selection: FileSelection::All,
   00366|             mode: FileReadMode::Summary,
   00367|         });
   00368|     }
   00369| 
   00370|     if asks_to_list_then_read(&lower) {
   00371|         return Some(FileReadTask::ListThenRead {
   00372|             directory: directory_for_list_read(prompt).unwrap_or_else(|| String::from(".")),
   00373|             selection: selection_for_prompt(&lower),
   00374|             mode: mode_for_prompt(prompt),
   00375|         });
   00376|     }
   00377| 
   00378|     if asks_to_read_file_in_folder(&lower) {
   00379|         return Some(FileReadTask::ListThenRead {
   00380|             directory: directory_for_list_read(prompt).unwrap_or_else(|| String::from(".")),
   00381|             selection: FileSelection::First,
   00382|             mode: mode_for_prompt(prompt),
   00383|         });
   00384|     }
   00385| 
   00386|     // A read cue and a path in the same sentence are about each other, and that
   00387|     // is the ordinary case: "выведи sample.txt", "show me the contents of
   00388|     // beta.md". Answering it from the sentence rather than from the whole prompt
   00389|     // is what keeps the two-obligation requests below from being decided by a
   00390|     // cue that belongs to a different clause (issue #1066).
   00391|     let read_paths = read_paths_named_beside_their_cue(prompt);
   00392|     if read_paths.len() > 1 {
   00393|         return Some(FileReadTask::DirectMany {
   00394|             paths: read_paths,
   00395|             mode: mode_for_prompt(prompt),
   00396|         });
   00397|     }
   00398|     if let Some(path) = read_paths.into_iter().next() {
   00399|         return Some(FileReadTask::Direct {
   00400|             path,
   00401|             mode: mode_for_prompt(prompt),
   00402|             prefer_run: false,
   00403|         });
   00404|     }
   00405| 
   00406|     // Issue #1066: "write intent beats read intent" is decided above over the
   00407|     // whole prompt, which settles a request that is only a write. It does not
   00408|     // settle a request that is both -- "find X out, and leave the answer in
   00409|     // FILE" -- because there the read cue and the path belong to different
   00410|     // sentences and different obligations. "Leave observable evidence in
   00411|     // `.agent-ladder/node-1.2-proof.md`. The first line must be exactly
   00412|     // `node_path=1.2`" carries the read cue *first line* in the sentence that
   00413|     // constrains the file's opening, and the only path in the prompt is the one
   00414|     // the caller asked to have written. Opening it reads a file that does not
   00415|     // exist yet, and the run ends by recording the resulting error as its
   00416|     // evidence. Where cue and path were never in one sentence, a path the
   00417|     // request states as a write destination is therefore not a read target.
   00418|     if has_file_read_intent(&lower)
   00419|         && let Some(path) = first_local_file_path(prompt)
   00420|         && !write_request::is_stated_write_target(prompt, &path)
   00421|     {
   00422|         return Some(FileReadTask::Direct {
   00423|             path,
   00424|             mode: mode_for_prompt(prompt),
   00425|             prefer_run: false,
   00426|         });
   00427|     }
   00428| 
   00429|     None
   00430| }
   00431| 
   00432| /// The first path a request names in the same sentence as a read cue.
   00433| ///
   00434| /// Sentence scope is what separates a cue that is *about* the path from one that
   00435| /// merely shares a prompt with it, the same scoping
   00436| /// [`super::evidence_record`] uses to split a delivery obligation from the work
   00437| /// it delivers, and [`super::shell_command`] uses to tell a named command from an
   00438| /// ordered one (issue #907).
   00439| fn read_paths_named_beside_their_cue(prompt: &str) -> Vec<String> {
   00440|     sentences(prompt)
   00441|         .into_iter()
   00442|         .find_map(|sentence| {
   00443|             has_file_read_intent(&sentence.text.to_lowercase())
   00444|                 .then(|| local_file_paths(sentence.text))
   00445|         })
   00446|         .unwrap_or_default()
   00447| }
   00448| 
   00449| fn has_file_read_intent(lower: &str) -> bool {
   00450|     seed::lexicon().mentions_role(seed::ROLE_FILE_READ_ACTION_CUE, lower)
   00451| }
   00452| 
   00453| fn asks_to_read_every_file(lower: &str) -> bool {
   00454|     (lower.contains("read every file") || lower.contains("read all files"))
   00455|         && (lower.contains("summarize") || lower.contains("summary") || lower.contains("here"))
   00456| }
   00457| 
   00458| fn asks_to_list_then_read(lower: &str) -> bool {
   00459|     let lists_files = lower.contains("list the files")
   00460|         || lower.contains("list files")
   00461|         || lower.contains("ls the folder")
   00462|         || lower.split_whitespace().any(|word| word == "ls");
   00463|     let reads_after = lower.contains("read")
   00464|         || lower.contains("contents")
   00465|         || lower.contains("content")
   00466|         || lower.contains("show me");
   00467|     lists_files && reads_after
   00468| }
   00469| 
   00470| fn asks_to_read_file_in_folder(lower: &str) -> bool {
   00471|     lower.contains("read the file") && (lower.contains(" folder") || lower.contains(" directory"))
   00472| }
   00473| 
   00474| fn selection_for_prompt(lower: &str) -> FileSelection {
   00475|     if lower.contains("last") {
   00476|         FileSelection::Last
   00477|     } else {
   00478|         FileSelection::First
   00479|     }
   00480| }
   00481| 
   00482| fn mode_for_prompt(prompt: &str) -> FileReadMode {
   00483|     // Inspection verbs are multilingual seed data, so normalization must fold
   00484|     // every script that has case rather than only ASCII. Otherwise a capitalized
   00485|     // Russian imperative misses the same semantic role its lowercase form hits.
   00486|     let lower = prompt.to_lowercase();
   00487|     if lower.contains("first line") {
   00488|         return FileReadMode::FirstLine;
   00489|     }
   00490|     if let Some(key) = extract_value_key(prompt) {
   00491|         return FileReadMode::ExtractValue(key);
   00492|     }
   00493|     if let Some(key) = exact::exact_line_key(prompt) {
   00494|         return FileReadMode::ExtractValue(key);
   00495|     }
   00496|     if seed::lexicon().mentions_role(seed::ROLE_WORKSPACE_INSPECTION_ACTION, &lower) {
   00497|         return FileReadMode::Audit;
   00498|     }
   00499|     if lower.contains("summarize") || lower.contains("summary") {
   00500|         return FileReadMode::Summary;
   00501|     }
   00502|     super::workspace_line_operation::line_slice(prompt)
   00503|         .map_or(FileReadMode::Full, FileReadMode::LineSlice)
   00504| }
   00505| 
   00506| fn extract_value_key(prompt: &str) -> Option<String> {
   00507|     let lower = prompt.to_ascii_lowercase();
   00508|     let marker = "value of ";
   00509|     let start = lower.find(marker)? + marker.len();
   00510|     let rest = &prompt[start..];
   00511|     let key = rest
   00512|         .split_whitespace()
   00513|         .next()
   00514|         .unwrap_or_default()
   00515|         .trim_matches(|c: char| !is_file_path_char(c));
   00516|     (!key.is_empty()).then(|| key.to_owned())
   00517| }
