   00679| fn grep_result_for_path<'a>(
   00680|     records: &'a [ToolResultRecord],
   00681|     path: &str,
   00682|     pattern: &str,
   00683| ) -> Option<&'a str> {
   00684|     records
   00685|         .iter()
   00686|         .find(|record| {
   00687|             record.capability == Some(Capability::Grep)
   00688|                 && path_argument(&record.arguments)
