   00668| fn read_result_for_path<'a>(records: &'a [ToolResultRecord], path: &str) -> Option<&'a str> {
   00669|     records
   00670|         .iter()
   00671|         .find(|record| {
   00672|             record.capability == Some(Capability::Read)
   00673|                 && path_argument(&record.arguments)
   00674|                     .is_some_and(|recorded| same_path(&recorded, path))
   00675|         })
   00676|         .map(|record| record.content.as_str())
   00677| }
