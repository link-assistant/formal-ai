   00001| name: Issue 1028 Agent CLI binary-tree ladder
   00002| 
   00003| # Issue #1085 (D4): the ladder runs on pull requests that touch it or the
   00004| # agentic coding modules (leaf level), weekly over every level, and on
   00005| # dispatch. The deepest level whose nodes all pass is compared with
   00006| # data/meta/ladder-ratchet.lino and may only move deeper.
   00007| #
   00008| # PR #1188: the depth-five run measured its 32 leaves one after another in one
   00009| # job, 72-82 minutes (runs 37652295748, 37663996930; ~250s per passing leaf).
   00010| # Leaves are independent -- each starts from a reset worktree and only a
   00011| # depth-4 composite reads its children's effects -- so the default run is now
   00012| #   plan     consults the green ledger (lookup only), warms the binary cache
   00013| #            and lists the legs: sixteen depth-4 subtrees of two leaves each
   00014| #            for the whole depth-five tree, one leg for anything else;
   00015| #   ladder   one leg per subtree, each the unchanged run.sh with NODE_FILTER;
   00016| #   compare  green only when every leg succeeded (check-shard-results.sh), the
   00017| #            legs join into one run (combine-shards.py refuses a missing or
   00018| #            overlapping leg), and that run holds the recorded ratchet. Its
   00019| #            success, not the plan's, records the inputs green.
   00020| # The scheduled `all` mode stays one leg: each level builds on the level below
   00021| # in the same run, so its levels cannot run side by side.
   00022| on:
   00023|   # Issue #1187 R2: a bot pull request's checks start through dispatch
   00024|   # (.github/actions/dispatch-checks); mode and pull-request are its inputs.
   00025|   workflow_dispatch:
   00026|     inputs:
   00027|       mode:
   00028|         description: 'checks: run the pull-request checks on the dispatched branch'
   00029|         required: false
   00030|         default: checks
   00031|         type: choice
   00032|         options: [checks]
   00033|       pull-request:
   00034|         description: 'Pull request the dispatched checks report for'
   00035|         required: false
   00036|         default: ''
   00037|         type: string
   00038|       depth:
   00039|         description: 'Tree depth to verify: 0=root, 1=2 nodes, 2=4, 3=8, 4=16, 5=32, all=5..0'
   00040|         required: false
   00041|         default: '5'
   00042|         type: choice
   00043|         options: ['0', '1', '2', '3', '4', '5', 'all']
   00044|       node_filter:
   00045|         description: 'Optional node path (for example 2.1.2.2.1)'
   00046|         required: false
   00047|         default: ''
   00048|         type: string
   00049|       skip_build:
   00050|         description: 'Skip cargo build --manifest-path rust/Cargo.toml only when a compatible release binary is already present'
   00051|         required: false
   00052|         default: false
   00053|         type: boolean
   00054|       authored_rules:
   00055|         description: 'Per-leaf authored mappings visible to the agent'
   00056|         required: false
   00057|         default: 'disabled'
   00058|         type: choice
   00059|         options: ['disabled', 'enabled']
   00060|   pull_request:
   00061|     # Issue #1187 R4: an isolated e2e/<purpose>/<run>/<name> pull request
   00062|     # never triggers this repository's own pipeline.
   00063|     branches-ignore: ['e2e/**']
   00064|     paths:
   00065|       - 'experiments/issue_1028_agent_cli_ladder/**'
   00066|       - 'rust/src/agentic_coding/**'
   00067|       - 'data/meta/ladder-ratchet.lino'
   00068|       - '.github/workflows/issue-1028-agent-ladder.yml'
   00069|   schedule:
   00070|     - cron: '23 3 * * 0'
   00071| 
   00072| permissions:
   00073|   contents: read
   00074| 
   00075| concurrency:
   00076|   group: issue-1028-agent-cli-binary-tree-${{ github.ref }}
   00077|   cancel-in-progress: ${{ github.event_name == 'pull_request' }}
   00078| 
   00079| jobs:
   00080|   plan:
   00081|     name: Plan the Agent CLI ladder
   00082|     runs-on: ubuntu-latest
   00083|     timeout-minutes: 30
   00084|     outputs:
   00085|       already-green: ${{ steps.ledger.outputs.already-green }}
   00086|       legs: ${{ steps.plan.outputs.legs || '[]' }}
   00087|       leg-count: ${{ steps.plan.outputs.leg-count }}
   00088|     env:
   00089|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00090|       NODE_FILTER: ${{ inputs.node_filter || '' }}
   00091|     steps:
   00092|       - uses: actions/checkout@v7
   00093|         with:
   00094|           persist-credentials: false
   00095|       # Lookup only (`record: 'false'`): a green plan says nothing about the
   00096|       # ladder, so the compare job records the verdict for these inputs.
   00097|       - name: Skip when identical inputs already passed
   00098|         id: ledger
   00099|         uses: ./.github/actions/green-ledger
   00100|         with:
   00101|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00102|           paths: >-
   00103|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00104|           enabled: ${{ github.ref != 'refs/heads/main' }}
   00105|           record: 'false'
   00106| 
   00107|       - name: List the ladder legs
   00108|         id: plan
   00109|         if: ${{ steps.ledger.outputs.already-green != 'true' }}
   00110|         run: |
   00111|           set -euo pipefail
   00112|           if [[ "$TREE_DEPTH" == 5 && -z "$NODE_FILTER" ]]; then
   00113|             # Every depth-4 node: the 32 leaves as sixteen pairs. 45 minutes
   00114|             # holds two leaves even when both compile cold and time out.
   00115|             legs=$(jq -cn '[range(0; 16)
   00116|               | [(. / 8 | floor) % 2 + 1, (. / 4 | floor) % 2 + 1, (. / 2 | floor) % 2 + 1, . % 2 + 1]
   00117|               | map(tostring) | join(".") | {filter: ., cap: 45}]')
   00118|           else
   00119|             legs=$(jq -cn --arg filter "$NODE_FILTER" '[{filter: $filter, cap: 180}]')
   00120|           fi
   00121|           echo "legs=$legs" >> "$GITHUB_OUTPUT"
   00122|           echo "leg-count=$(jq 'length' <<< "$legs")" >> "$GITHUB_OUTPUT"
   00123|           echo "$legs"
   00124| 
   00125|       # Reused across every workflow that only needs to *run* the binary: the
   00126|       # cache key is the content of the sources it is built from, so a push that
   00127|       # changed neither pays nothing (issue #1107). Warmed once here so every
   00128|       # leg restores it instead of each compiling it.
   00129|       - uses: ./.github/actions/formal-ai-binary
   00130|         if: ${{ (inputs.skip_build != true) && steps.ledger.outputs.already-green != 'true' }}
   00131| 
   00132|   ladder:
   00133|     name: Agent CLI ladder ${{ matrix.leg.filter || 'tree' }}
   00134|     needs: [plan]
   00135|     if: ${{ needs.plan.outputs.already-green != 'true' }}
   00136|     runs-on: ubuntu-latest
   00137|     # 45 minutes for a two-leaf leg; 180 is the ceiling for the one-leg modes
   00138|     # (scheduled `all` run walks every level of the tree in sequence).
   00139|     # Static value so the CI wall-clock gate can measure the worst-case ceiling.
   00140|     timeout-minutes: 180
   00141|     strategy:
   00142|       fail-fast: false
   00143|       matrix:
   00144|         leg: ${{ fromJSON(needs.plan.outputs.legs) }}
   00145|     env:
   00146|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00147|       NODE_FILTER: ${{ matrix.leg.filter }}
   00148|       # A fresh directory, not the committed evidence under docs/: the compare
   00149|       # job joins exactly what this leg measured.
   00150|       OUT: ${{ github.workspace }}/agent-tree-run
   00151|       LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: "false"
   00152|       AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00153|     steps:
   00154|       - uses: actions/checkout@v7
   00155|         with:
   00156|           persist-credentials: false
   00157| 
   00158|       - name: Setup Bun
   00159|         uses: oven-sh/setup-bun@v2
   00160|         with:
   00161|           bun-version-file: .bun-version
   00162|           no-cache: true
   00163| 
   00164|       # Each leaf's edit is compiled by verify-node.sh; the dependency crates
   00165|       # are the same on every leg, so the first leaf of each leg restores them
   00166|       # from the shared compiler cache instead of compiling them cold.
   00167|       - uses: ./.github/actions/setup-sccache
   00168| 
   00169|       # verify-node.sh compiles every leaf's edit, so the toolchain must meet
   00170|       # the crate's rust-version whether or not the binary came from cache:
   00171|       # formal-ai-binary installs one only on a cache miss, and a runner image
   00172|       # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run
   00173|       # 37710079109) although their edits were valid.
   00174|       - name: Setup Rust
   00175|         uses: dtolnay/rust-toolchain@stable
   00176| 
   00177|       - uses: ./.github/actions/formal-ai-binary
   00178|         if: ${{ inputs.skip_build != true }}
   00179| 
   00180|       - name: Install pinned Agent CLI
   00181|         run: bun add -g @link-assistant/agent@0.26.0
   00182| 
   00183|       - name: Run recursive Agent CLI tree
   00184|         id: tree
   00185|         env:
   00186|           AGENT: agent
   00187|         run: experiments/issue_1028_agent_cli_ladder/run.sh
   00188| 
   00189|       - name: Show the Agent CLI evidence on failure
   00190|         if: failure()
   00191|         run: scripts/dump-agent-cli-evidence.sh "$OUT"
   00192| 
   00193|       - name: Upload tree evidence
   00194|         if: ${{ always() }}
   00195|         uses: actions/upload-artifact@v7
   00196|         with:
   00197|           name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.filter || 'tree' }}
   00198|           path: ${{ github.workspace }}/agent-tree-run
   00199|           retention-days: 3
   00200|           if-no-files-found: error
   00201| 
   00202|   compare:
   00203|     name: Compare the measured ladder with the record
   00204|     needs: [plan, ladder]
   00205|     # Not `always()`: a run superseded by a newer push is the one
   00206|     # cancellation that is not a defect, and it skips the verdict.
   00207|     if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' }}
   00208|     runs-on: ubuntu-latest
   00209|     timeout-minutes: 15
   00210|     env:
   00211|       TREE_DEPTH: ${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}
   00212|       OUT: ${{ github.workspace }}/docs/case-studies/issue-1028/agent-tree-run
   00213|     steps:
   00214|       - uses: actions/checkout@v7
   00215|         with:
   00216|           persist-credentials: false
   00217| 
   00218|       # Enabled off, recording on: this job never skips, and its own success
   00219|       # is what marks these inputs green for the plan job's next lookup.
   00220|       - name: Record the verdict for these inputs
   00221|         uses: ./.github/actions/green-ledger
   00222|         with:
   00223|           check: agent-ladder-1028-depth-${{ inputs.depth || (github.event_name == 'schedule' && 'all') || '5' }}-rules-${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
   00224|           paths: >-
   00225|             rust/src data rust/build.rs rust/Cargo.toml rust/Cargo.lock experiments/issue_1028_agent_cli_ladder scripts .github/workflows/issue-1028-agent-ladder.yml .github/actions
   00226|           enabled: 'false'
   00227| 
   00228|       - name: Every ladder leg finished
   00229|         env:
   00230|           NEEDS_JSON: ${{ toJSON(needs) }}
   00231|           JOBS: plan ladder
   00232|           CHECK: Agent CLI ladder
   00233|         run: bash scripts/check-shard-results.sh
   00234| 
   00235|       - name: Download every leg's evidence
   00236|         uses: actions/download-artifact@v8
   00237|         env:
   00238|           # v8's bundled unzip dependency still calls Buffer(); suppress only
   00239|           # that reviewed upstream diagnostic, never all Node warnings:
   00240|           # https://github.com/actions/download-artifact/issues/484
   00241|           NODE_OPTIONS: --disable-warning=DEP0005
   00242|         with:
   00243|           pattern: issue-1028-agent-cli-binary-tree-*
   00244|           path: ${{ runner.temp }}/agent-tree-legs
   00245| 
   00246|       # The committed evidence under $OUT is a previous run's; the joined run
   00247|       # replaces it so nothing stale is compared or uploaded.
   00248|       - name: Join the legs into one run
   00249|         env:
   00250|           LEG_COUNT: ${{ needs.plan.outputs.leg-count }}
   00251|         run: |
   00252|           set -euo pipefail
   00253|           rm -rf "$OUT"
   00254|           python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \
   00255|             "$RUNNER_TEMP/agent-tree-legs" "$OUT" "$LEG_COUNT"
   00256| 
   00257|       # A ladder that ran and measured fewer leaves than the record is still
   00258|       # compared -- that is the regression this gate exists to catch.
   00259|       - name: Compare the measured ladder with the record
   00260|         run: |
   00261|           set -euo pipefail
   00262|           result="$OUT/ladder-result.lino"
   00263|           [[ -f "$result" ]] || { echo '::error::the run wrote no ladder-result.lino'; exit 1; }
   00264|           field() { sed -n "s/^  $1 \"\(.*\)\"$/\1/p" "$result"; }
   00265|           recorded_leaves=$(sed -n 's/^  leaf_nodes_passing //p' data/meta/ladder-ratchet.lino)
   00266|           measured_leaves=$(field leaf_nodes_passing)
   00267|           selected_leaves=$(field leaf_nodes_selected)
   00268|           authored_rules_enabled=$(field authored_rules_enabled)
   00269|           echo "leaf nodes passing: recorded $recorded_leaves, this run $measured_leaves of $selected_leaves"
   00270|           cat "$result" >> "$GITHUB_STEP_SUMMARY"
   00271|           # Only a full-width run is comparable with the record: a filtered or
   00272|           # shallower run selects fewer leaves and would always look worse.
   00273|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == true ]]; then
   00274|             if (( measured_leaves < recorded_leaves )); then
   00275|               echo "::error::$measured_leaves of 32 leaves passed; the record is $recorded_leaves (data/meta/ladder-ratchet.lino). A leaf Formal AI could change no longer changes."
   00276|               exit 1
   00277|             fi
   00278|             if (( measured_leaves > recorded_leaves )); then
   00279|               echo "::notice::leaf nodes passing improved to $measured_leaves; raise leaf_nodes_passing in data/meta/ladder-ratchet.lino in a reviewed commit"
   00280|             fi
   00281|           fi
   00282|           if [[ "$selected_leaves" == 32 && "$authored_rules_enabled" == false ]]; then
   00283|             measured_without_rules=$(field leaf_nodes_passing_without_authored_rules)
   00284|             recorded_without_rules=$(sed -n 's/^  leaf_nodes_passing_without_authored_rules //p' data/meta/ladder-ratchet.lino)
   00285|             if [[ "$recorded_without_rules" == not_measured ]]; then
   00286|               echo "::error::the first complete rule-disabled run measured $measured_without_rules of 32; record that exact value as leaf_nodes_passing_without_authored_rules in data/meta/ladder-ratchet.lino"
   00287|               exit 1
   00288|             fi
   00289|             if (( measured_without_rules < recorded_without_rules )); then
   00290|               echo "::error::$measured_without_rules of 32 leaves passed without authored rules; the record is $recorded_without_rules"
   00291|               exit 1
   00292|             fi
   00293|             if (( measured_without_rules > recorded_without_rules )); then
   00294|               echo "::notice::rule-disabled leaves improved to $measured_without_rules; raise leaf_nodes_passing_without_authored_rules in a reviewed commit"
   00295|             fi
   00296|           fi
   00297|           if [[ "$TREE_DEPTH" == all ]]; then
   00298|             deepest=$(field deepest_passing_level)
   00299|             recorded_depth=$(sed -n 's/^  deepest_passing_level //p' data/meta/ladder-ratchet.lino)
   00300|             echo "deepest passing level: recorded $recorded_depth, this run $deepest"
   00301|             if [[ "$recorded_depth" != none && "$deepest" == none ]]; then
   00302|               echo "::error::no level passed completely; the record is level $recorded_depth"
   00303|               exit 1
   00304|             fi
   00305|             if [[ "$recorded_depth" != none && "$deepest" != none ]] && (( deepest < recorded_depth )); then
   00306|               echo "::error::deepest passing level $deepest is shallower than the recorded $recorded_depth (level 5 is the leaves)"
   00307|               exit 1
   00308|             fi
   00309|           fi
   00310| 
   00311|       - name: Show the Agent CLI evidence on failure
   00312|         if: failure()
   00313|         run: scripts/dump-agent-cli-evidence.sh docs/case-studies/issue-1028/agent-tree-run
   00314|       - name: Upload tree evidence
   00315|         if: ${{ always() }}
   00316|         uses: actions/upload-artifact@v7
   00317|         with:
   00318|           name: issue-1028-agent-cli-binary-tree
   00319|           path: docs/case-studies/issue-1028/agent-tree-run
   00320|           retention-days: 14
