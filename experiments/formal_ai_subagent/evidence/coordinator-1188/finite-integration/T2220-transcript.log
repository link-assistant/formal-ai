    name: Validate the current-run leaf evidence
    needs: [plan, ladder]
    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      NODE_FILTER: ${{ inputs.node_filter || '' }}
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - name: Every primary leg measured its nodes
        env:
          NEEDS_JSON: ${{ toJSON(needs) }}
          JOBS: plan ladder
          CHECK: Agent CLI ladder primary wave
        run: bash scripts/check-shard-results.sh
      - name: Download exactly the measured leaf legs
        uses: actions/download-artifact@v8
        env:
          NODE_OPTIONS: --disable-warning=DEP0005
        with:
          pattern: issue-1028-agent-cli-binary-tree-depth-5-*
          path: ${{ runner.temp }}/leaf-legs
      - name: Validate and join the complete leaf dependency set
        run: |
          set -euo pipefail
          python3 experiments/issue_1028_agent_cli_ladder/plan-legs.py 5 "$NODE_FILTER" > "$RUNNER_TEMP/leaf-plan.json"
          count=$(jq '.legs | length' "$RUNNER_TEMP/leaf-plan.json")
          python3 experiments/issue_1028_agent_cli_ladder/combine-shards.py \
            "$RUNNER_TEMP/leaf-legs" "$RUNNER_TEMP/current-leaves" "$count" "$RUNNER_TEMP/leaf-plan.json"
      - name: Upload validated leaves for the composite wave
        uses: actions/upload-artifact@v7
        with:
          name: issue-1028-agent-cli-current-leaves
          path: ${{ runner.temp }}/current-leaves
          retention-days: 3
          if-no-files-found: error

  composites:
    name: Agent CLI composite ${{ matrix.leg.id }}
    needs: [plan, leaf-evidence]
    if: ${{ !cancelled() && needs.plan.outputs.already-green != 'true' && needs.plan.outputs.composites != '[]' }}
    runs-on: ubuntu-latest
    # One composite per machine; verification consumes only the current
    # run's two validated child effects and diffs.
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        leg: ${{ fromJSON(needs.plan.outputs.composites) }}
    env:
      TREE_DEPTH: ${{ matrix.leg.depth }}
      NODE_FILTER: ${{ matrix.leg.filter }}
      # A fresh directory, not the committed evidence under docs/: the compare
      # job joins exactly what this leg measured.
      OUT: ${{ github.workspace }}/agent-tree-run
      LADDER_CHILD_EVIDENCE: ${{ runner.temp }}/current-leaves
      LINK_ASSISTANT_AGENT_SUMMARIZE_SESSION: "false"
      AUTHORED_RULES: ${{ inputs.authored_rules || (github.event_name == 'schedule' && 'disabled') || 'enabled' }}
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version-file: .bun-version
          no-cache: true

      # Each leaf's edit is compiled by verify-node.sh; the dependency crates
      # are the same on every leg, so the first leaf of each leg restores them
      # from the shared compiler cache instead of compiling them cold.
      - uses: ./.github/actions/setup-sccache

      # verify-node.sh compiles every leaf's edit, so the toolchain must meet
      # the crate's rust-version whether or not the binary came from cache:
      # formal-ai-binary installs one only on a cache miss, and a runner image
      # still on rustc 1.98.1 failed thirteen leaves as uncompilable (run
      # 37710079109) although their edits were valid.
      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable

      - uses: ./.github/actions/formal-ai-binary
        if: ${{ inputs.skip_build != true }}

      - name: Install pinned Agent CLI
        run: bun add -g @link-assistant/agent@0.26.0

      - name: Download validated current-run leaves
        uses: actions/download-artifact@v8
        env:
          NODE_OPTIONS: --disable-warning=DEP0005
        with:
          name: issue-1028-agent-cli-current-leaves
          path: ${{ runner.temp }}/current-leaves

      - name: Run recursive Agent CLI tree
        id: tree
        env:
          AGENT: agent
        run: experiments/issue_1028_agent_cli_ladder/run.sh

      - name: Show the Agent CLI evidence on failure
        if: failure()
        run: scripts/dump-agent-cli-evidence.sh "$OUT"

      - name: Upload tree evidence
        if: ${{ always() }}
        uses: actions/upload-artifact@v7
        with:
          name: issue-1028-agent-cli-binary-tree-${{ matrix.leg.id }}
          path: ${{ github.workspace }}/agent-tree-run
          retention-days: 3
          if-no-files-found: error

