   00680|     records
   00681|         .iter()
   00682|         .find(|record| {
   00683|             record.capability == Some(Capability::Grep)
   00684|                 && path_argument(&record.arguments)
   00685|                     .is_some_and(|recorded| same_path(&recorded, path))
   00686|                 && record
   00687|                     .arguments
   00688|                     .get("pattern")
