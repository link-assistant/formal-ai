   00698| /// the planner planned with: [`crate::protocol_responses`] rewrites `path` to
   00699| /// Gemini's `absolute_path` and absolutises it, so a recorded
   00700| /// `/work/alpha.txt` has to answer a planned `alpha.txt`.
   00701| fn same_path(recorded: &str, planned: &str) -> bool {
   00702|     if recorded == planned {
   00703|         return true;
   00704|     }
