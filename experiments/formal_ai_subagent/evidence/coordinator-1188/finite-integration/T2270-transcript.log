   00134| // The eight parameters are the read plan's own slots (path, mode, tool
   00135| // availability, prior records, request); bundling them would invent a struct
   00136| // only this planner reads.
   00137| #[allow(clippy::too_many_arguments)]
   00138| fn plan_direct_file_read(
   00139|     path: &str,
   00140|     mode: &FileReadMode,
   00141|     prefer_run: bool,
   00142|     read_tool: Option<&str>,
   00143|     run_tool: Option<&str>,
   00144|     grep_tool: Option<&str>,
   00145|     records: &[ToolResultRecord],
   00146|     request: &str,
   00147|     result: &mut Option<FinalResult>,
   00148| ) -> AgenticPlan {
   00149|     if mode == &FileReadMode::Audit {
   00150|         return exact::plan_direct_file_reads(
   00151|             &[path.to_owned()],
   00152|             mode,
   00153|             read_tool,
   00154|             run_tool,
   00155|             grep_tool,
   00156|             records,
   00157|             request,
   00158|             result,
   00159|         );
   00160|     }
   00161|     let read_command = read_command_for(path, mode);
   00162|     let exact_run = exact::exact_line_key(request).is_some() && run_tool.is_some();
   00163|     let recorded = if exact_run {
   00164|         run_record_for_command(records, &read_command).map(|raw| {
   00165|             (
   00166|                 read_command.as_str(),
   00167|                 raw,
   00168|                 super::tool_result::strip_transport_envelope(raw),
   00169|             )
   00170|         })
   00171|     } else {
   00172|         read_result_for_path(records, path)
   00173|             .map(|raw| (path, raw, raw.to_owned()))
   00174|             .or_else(|| {
   00175|                 run_record_for_command(records, &read_command).map(|raw| {
   00176|                     (
   00177|                         read_command.as_str(),
   00178|                         raw,
   00179|                         super::tool_result::strip_transport_envelope(raw),
   00180|                     )
   00181|                 })
   00182|             })
   00183|     };
   00184|     if let Some((label, raw, content)) = recorded {
   00185|         if let Some(failure) = failed_step_answer(label, raw, request) {
   00186|             return AgenticPlan::Final(failure);
   00187|         }
   00188|         let content = if label == path {
   00189|             super::code_artifact::source_from_read_result(&content)
   00190|         } else {
   00191|             content
   00192|         };
   00193|         return record(
   00194|             AgenticPlan::Final(file_read_final_answer(
   00195|                 mode,
   00196|                 &[(path.to_owned(), content)],
   00197|                 request,
   00198|             )),
   00199|             FinalDisposition::Finding,
   00200|             "file_read_observed",
   00201|             result,
   00202|         );
   00203|     }
   00204| 
   00205|     if (prefer_run || exact_run)
   00206|         && let Some(tool) = run_tool
   00207|     {
   00208|         return plan_one(
   00209|             tool,
   00210|             json!({ "command": read_command_for(path, mode) }).to_string(),
   00211|         );
   00212|     }
   00213| 
   00214|     if let Some(tool) = read_tool {
   00215|         return plan_one(tool, read_arguments(path, mode));
   00216|     }
   00217|     if let Some(tool) = run_tool {
   00218|         return plan_one(
   00219|             tool,
   00220|             json!({ "command": read_command_for(path, mode) }).to_string(),
   00221|         );
   00222|     }
   00223| 
   00224|     AgenticPlan::Final(format!(
   00225|         "I can read `{path}` when the client advertises a file read tool or a shell tool."
   00226|     ))
   00227| }
