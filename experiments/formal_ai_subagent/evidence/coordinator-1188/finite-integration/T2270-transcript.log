   00077| /// The issue-#627 file-reading recipe: direct filename requests use an advertised
   00078| /// `read` tool, shell-shaped `cat` requests use the run tool, and multi-step
   00079| /// "list then read" prompts walk `bash(ls)` → `read(file)` → final content.
   00080| pub(super) fn plan_file_read_step(
   00081|     task: &FileReadTask,
   00082|     messages: &[ChatMessage],
   00083|     tool_names: &[&str],
   00084|     result: &mut Option<FinalResult>,
   00085| ) -> AgenticPlan {
   00086|     let read_tool = tool_for(tool_names, Capability::Read);
   00087|     let run_tool = tool_for(tool_names, Capability::Run);
   00088|     let grep_tool = tool_for(tool_names, Capability::Grep);
   00089|     let records = tool_result_records(messages);
   00090|     let request = crate::protocol::latest_user_request(messages).unwrap_or_default();
   00091| 
   00092|     match task {
   00093|         FileReadTask::Direct {
   00094|             path,
   00095|             mode,
   00096|             prefer_run,
   00097|         } => plan_direct_file_read(
   00098|             path,
   00099|             mode,
   00100|             *prefer_run,
   00101|             read_tool,
   00102|             run_tool,
   00103|             grep_tool,
   00104|             &records,
   00105|             &request,
   00106|             result,
   00107|         ),
   00108|         FileReadTask::DirectMany { paths, mode } => exact::plan_direct_file_reads(
   00109|             paths, mode, read_tool, run_tool, grep_tool, &records, &request, result,
   00110|         ),
   00111|         FileReadTask::ListThenRead {
   00112|             directory,
   00113|             selection,
   00114|             mode,
   00115|         } => plan_list_then_read(
   00116|             directory, *selection, mode, read_tool, run_tool, &records, &request, result,
   00117|         ),
   00118|     }
   00119| }
