   00565| fn looks_like_local_file_path(token: &str) -> bool {
   00566|     if token.is_empty()
   00567|         || token.contains("://")
   00568|         || token.starts_with("http:")
   00569|         || token.starts_with("https:")
   00570|         || is_dotted_number(token)
   00571|     {
   00572|         return false;
   00573|     }
   00574|     if token.contains('/') {
   00575|         return token.chars().all(is_file_path_char);
   00576|     }
   00577|     let Some((stem, extension)) = token.rsplit_once('.') else {
   00578|         return false;
   00579|     };
   00580|     !stem.is_empty()
   00581|         && !extension.is_empty()
   00582|         && extension.len() <= 12
   00583|         && token.chars().all(is_file_path_char)
   00584| }
