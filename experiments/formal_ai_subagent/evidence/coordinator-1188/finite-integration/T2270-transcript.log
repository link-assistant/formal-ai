   00623| fn tool_result_records(messages: &[ChatMessage]) -> Vec<ToolResultRecord> {
   00624|     // Only results produced *within the current user turn* ground a read. A
   00625|     // client loops tool calls without a new user message, so the current turn is
   00626|     // everything after the last user message; a `cat 1.txt` result from an
   00627|     // earlier turn must never be replayed as the answer to a later `read 1.txt`
   00628|     // (issue #755 — read/list determinism). Without this bound the recipe short
   00629|     // -circuits on a stale, unrelated result and skips the fresh read entirely.
   00630|     let turn_start = messages
   00631|         .iter()
   00632|         .rposition(|message| message.role.eq_ignore_ascii_case("user"))
   00633|         .map_or(0, |index| index + 1);
   00634|     let mut records = Vec::new();
   00635|     for (index, message) in messages.iter().enumerate().skip(turn_start) {
   00636|         if !message.role.eq_ignore_ascii_case("tool") {
   00637|             continue;
   00638|         }
   00639|         let (capability, arguments) =
   00640|             tool_result_call(messages, index).map_or((None, serde_json::Value::Null), |call| {
   00641|                 (
   00642|                     tool_capability(&call.function.name),
   00643|                     serde_json::from_str(&call.function.arguments)
   00644|                         .unwrap_or(serde_json::Value::Null),
   00645|                 )
   00646|             });
   00647|         records.push(ToolResultRecord {
   00648|             capability,
   00649|             arguments,
   00650|             content: message.content.plain_text(),
   00651|         });
   00652|     }
   00653|     records
   00654| }
