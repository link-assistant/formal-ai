   00542| /// A path token as prose wrote it, stripped of the punctuation the sentence put
   00543| /// around it.
   00544| ///
   00545| /// The terminating dot is delegated to
   00546| /// [`trim_trailing_sentence_dot`](super::file_path_shape::trim_trailing_sentence_dot)
   00547| /// so the read route, the write-request parser and the shell route all draw the
   00548| /// same boundary between a path and the sentence carrying it.
   00549| fn clean_file_token(token: &str) -> String {
   00550|     peel_sentence_punctuation(token, |token| {
   00551|         token
   00552|             .trim_matches('`')
   00553|             .trim_matches('"')
   00554|             .trim_matches('\'')
   00555|             .trim_matches(|c: char| {
   00556|                 matches!(
   00557|                     c,
   00558|                     ',' | ';' | ':' | '!' | '?' | ')' | '(' | '[' | ']' | '{' | '}'
   00559|                 )
   00560|             })
   00561|     })
   00562|     .to_owned()
   00563| }
