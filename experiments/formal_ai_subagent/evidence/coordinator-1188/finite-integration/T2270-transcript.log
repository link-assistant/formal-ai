   00656| fn tool_result_call(messages: &[ChatMessage], index: usize) -> Option<&ToolCall> {
   00657|     let call_id = messages[index].tool_call_id.as_ref()?;
   00658|     messages[..index]
   00659|         .iter()
   00660|         .flat_map(|prior| prior.tool_calls.iter())
   00661|         .find(|call| &call.id == call_id)
   00662| }
