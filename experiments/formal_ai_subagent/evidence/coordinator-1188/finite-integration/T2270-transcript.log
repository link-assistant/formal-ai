   00767| /// Build the audit query from semantic seed data. The one structural member is
   00768| /// an unchecked Markdown box: syntax rather than natural-language domain data.
   00769| fn file_analysis_pattern() -> String {
   00770|     let mut alternatives = vec![String::from(r"\[\s*\]")];
   00771|     alternatives.extend(
   00772|         seed::lexicon()
   00773|             .words_for_role(seed::ROLE_FILE_ANALYSIS_GAP_MARKER)
   00774|             .into_iter()
   00775|             .filter(|surface| !surface.trim().is_empty())
