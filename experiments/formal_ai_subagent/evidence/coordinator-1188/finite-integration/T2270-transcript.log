   00121| /// The report for a recorded step the harness itself judged failed (rung
   00122| /// `R916-01`).
   00123| ///
   00124| /// A read whose command exited non-zero has no contents to show: issue #905
   00125| /// watched `cat hello.txt` exit 1 and still be answered with "Contents of
   00126| /// `hello.txt`:" wrapped around the transport envelope, so the missing file read
   00127| /// as an empty one. The report is the seed-localized one every other route
   00128| /// uses, so the request's own language answers it.
   00129| fn failed_step_answer(label: &str, raw: &str, request: &str) -> Option<String> {
   00130|     super::tool_result::harness_reported_failure(raw)
   00131|         .then(|| super::tool_result::render(label, raw, request))
   00132| }
