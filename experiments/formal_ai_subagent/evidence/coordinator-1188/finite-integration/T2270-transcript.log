   00325| /// Shell syntax that chains, pipes or redirects commands.
   00326| const SHELL_OPERATORS: [&str; 5] = ["&&", "||", ";", "|", ">"];
   00327| 
   00328| pub(super) fn file_read_task_for(prompt: &str) -> Option<FileReadTask> {
   00329|     let lower = prompt.to_lowercase();
   00330| 
   00331|     // Issue #681: a file-creation / write request must never be routed to the read
   00332|     // recipe — the target does not exist yet, so reading it is always the wrong
   00333|     // tool. When the request is a write intent, decline here and let the router
   00334|     // fall through to the general write/create planner. This is the general rule
   00335|     // ("write intent beats read intent"), not a per-phrase special case: the same
   00336|     // gate catches create/write/save/generate across every supported language.
   00337|     if has_file_write_intent(&lower) {
   00338|         return None;
   00339|     }
   00340|     // A command quoted after a run prefix that chains, pipes or redirects is
   00341|     // run as written, not read file by file (PR #1188 G62).
   00342|     if super::shell_command::explicit_passthrough_command(prompt).is_some_and(|command| {
   00343|         SHELL_OPERATORS
   00344|             .iter()
   00345|             .any(|operator| command.contains(operator))
   00346|     }) {
   00347|         return None;
   00348|     }
   00349| 
   00350|     if let Some(path) = leading_cat_path(prompt) {
   00351|         return Some(FileReadTask::Direct {
   00352|             path,
   00353|             mode: FileReadMode::Full,
   00354|             prefer_run: false,
   00355|         });
   00356|     }
   00357| 
   00358|     if asks_to_read_every_file(&lower) {
   00359|         return Some(FileReadTask::ListThenRead {
   00360|             directory: String::from("."),
   00361|             selection: FileSelection::All,
   00362|             mode: FileReadMode::Summary,
   00363|         });
   00364|     }
   00365| 
   00366|     if asks_to_list_then_read(&lower) {
   00367|         return Some(FileReadTask::ListThenRead {
   00368|             directory: directory_for_list_read(prompt).unwrap_or_else(|| String::from(".")),
   00369|             selection: selection_for_prompt(&lower),
   00370|             mode: mode_for_prompt(prompt),
   00371|         });
   00372|     }
   00373| 
   00374|     if asks_to_read_file_in_folder(&lower) {
   00375|         return Some(FileReadTask::ListThenRead {
   00376|             directory: directory_for_list_read(prompt).unwrap_or_else(|| String::from(".")),
   00377|             selection: FileSelection::First,
   00378|             mode: mode_for_prompt(prompt),
   00379|         });
   00380|     }
   00381| 
   00382|     // A read cue and a path in the same sentence are about each other, and that
   00383|     // is the ordinary case: "выведи sample.txt", "show me the contents of
   00384|     // beta.md". Answering it from the sentence rather than from the whole prompt
   00385|     // is what keeps the two-obligation requests below from being decided by a
   00386|     // cue that belongs to a different clause (issue #1066).
   00387|     let read_paths = read_paths_named_beside_their_cue(prompt);
   00388|     if read_paths.len() > 1 {
   00389|         return Some(FileReadTask::DirectMany {
   00390|             paths: read_paths,
   00391|             mode: mode_for_prompt(prompt),
   00392|         });
   00393|     }
   00394|     if let Some(path) = read_paths.into_iter().next() {
   00395|         return Some(FileReadTask::Direct {
   00396|             path,
   00397|             mode: mode_for_prompt(prompt),
   00398|             prefer_run: false,
   00399|         });
   00400|     }
   00401| 
   00402|     // Issue #1066: "write intent beats read intent" is decided above over the
   00403|     // whole prompt, which settles a request that is only a write. It does not
   00404|     // settle a request that is both -- "find X out, and leave the answer in
   00405|     // FILE" -- because there the read cue and the path belong to different
   00406|     // sentences and different obligations. "Leave observable evidence in
   00407|     // `.agent-ladder/node-1.2-proof.md`. The first line must be exactly
   00408|     // `node_path=1.2`" carries the read cue *first line* in the sentence that
   00409|     // constrains the file's opening, and the only path in the prompt is the one
   00410|     // the caller asked to have written. Opening it reads a file that does not
   00411|     // exist yet, and the run ends by recording the resulting error as its
   00412|     // evidence. Where cue and path were never in one sentence, a path the
   00413|     // request states as a write destination is therefore not a read target.
   00414|     if has_file_read_intent(&lower)
   00415|         && let Some(path) = first_local_file_path(prompt)
   00416|         && !write_request::is_stated_write_target(prompt, &path)
   00417|     {
   00418|         return Some(FileReadTask::Direct {
   00419|             path,
   00420|             mode: mode_for_prompt(prompt),
   00421|             prefer_run: false,
   00422|         });
   00423|     }
   00424| 
   00425|     None
   00426| }
   00427| 
   00428| /// The first path a request names in the same sentence as a read cue.
   00429| ///
   00430| /// Sentence scope is what separates a cue that is *about* the path from one that
   00431| /// merely shares a prompt with it, the same scoping
   00432| /// [`super::evidence_record`] uses to split a delivery obligation from the work
   00433| /// it delivers, and [`super::shell_command`] uses to tell a named command from an
   00434| /// ordered one (issue #907).
   00435| fn read_paths_named_beside_their_cue(prompt: &str) -> Vec<String> {
   00436|     sentences(prompt)
   00437|         .into_iter()
   00438|         .find_map(|sentence| {
   00439|             has_file_read_intent(&sentence.text.to_lowercase())
   00440|                 .then(|| local_file_paths(sentence.text))
   00441|         })
   00442|         .unwrap_or_default()
   00443| }
   00444| 
   00445| fn has_file_read_intent(lower: &str) -> bool {
   00446|     seed::lexicon().mentions_role(seed::ROLE_FILE_READ_ACTION_CUE, lower)
   00447| }
   00448| 
   00449| fn asks_to_read_every_file(lower: &str) -> bool {
   00450|     (lower.contains("read every file") || lower.contains("read all files"))
   00451|         && (lower.contains("summarize") || lower.contains("summary") || lower.contains("here"))
   00452| }
   00453| 
   00454| fn asks_to_list_then_read(lower: &str) -> bool {
   00455|     let lists_files = lower.contains("list the files")
   00456|         || lower.contains("list files")
   00457|         || lower.contains("ls the folder")
   00458|         || lower.split_whitespace().any(|word| word == "ls");
   00459|     let reads_after = lower.contains("read")
   00460|         || lower.contains("contents")
   00461|         || lower.contains("content")
   00462|         || lower.contains("show me");
   00463|     lists_files && reads_after
   00464| }
   00465| 
   00466| fn asks_to_read_file_in_folder(lower: &str) -> bool {
   00467|     lower.contains("read the file") && (lower.contains(" folder") || lower.contains(" directory"))
   00468| }
   00469| 
   00470| fn selection_for_prompt(lower: &str) -> FileSelection {
   00471|     if lower.contains("last") {
   00472|         FileSelection::Last
   00473|     } else {
   00474|         FileSelection::First
   00475|     }
   00476| }
   00477| 
   00478| fn mode_for_prompt(prompt: &str) -> FileReadMode {
   00479|     // Inspection verbs are multilingual seed data, so normalization must fold
   00480|     // every script that has case rather than only ASCII. Otherwise a capitalized
   00481|     // Russian imperative misses the same semantic role its lowercase form hits.
   00482|     let lower = prompt.to_lowercase();
   00483|     if lower.contains("first line") {
   00484|         return FileReadMode::FirstLine;
   00485|     }
   00486|     if let Some(key) = extract_value_key(prompt) {
   00487|         return FileReadMode::ExtractValue(key);
   00488|     }
   00489|     if let Some(key) = exact::exact_line_key(prompt) {
   00490|         return FileReadMode::ExtractValue(key);
   00491|     }
   00492|     if seed::lexicon().mentions_role(seed::ROLE_WORKSPACE_INSPECTION_ACTION, &lower) {
   00493|         return FileReadMode::Audit;
   00494|     }
   00495|     if lower.contains("summarize") || lower.contains("summary") {
   00496|         return FileReadMode::Summary;
   00497|     }
   00498|     super::workspace_line_operation::line_slice(prompt)
   00499|         .map_or(FileReadMode::Full, FileReadMode::LineSlice)
   00500| }
   00501| 
   00502| fn extract_value_key(prompt: &str) -> Option<String> {
   00503|     let lower = prompt.to_ascii_lowercase();
   00504|     let marker = "value of ";
   00505|     let start = lower.find(marker)? + marker.len();
   00506|     let rest = &prompt[start..];
   00507|     let key = rest
   00508|         .split_whitespace()
   00509|         .next()
   00510|         .unwrap_or_default()
   00511|         .trim_matches(|c: char| !is_file_path_char(c));
   00512|     (!key.is_empty()).then(|| key.to_owned())
   00513| }
   00514| 
   00515| fn leading_cat_path(prompt: &str) -> Option<String> {
   00516|     let trimmed = prompt.trim().trim_matches('`').trim();
   00517|     let mut parts = trimmed.split_whitespace();
   00518|     let command = parts.next()?;
   00519|     if !command.eq_ignore_ascii_case("cat") {
   00520|         return None;
   00521|     }
   00522|     parts
   00523|         .next()
   00524|         .map(clean_file_token)
   00525|         .filter(|path| !path.is_empty())
   00526| }
   00527| 
   00528| fn first_local_file_path(prompt: &str) -> Option<String> {
   00529|     local_file_paths(prompt).into_iter().next()
   00530| }
   00531| 
   00532| fn local_file_paths(prompt: &str) -> Vec<String> {
   00533|     let mut paths = prompt
   00534|         .split_whitespace()
   00535|         .map(clean_file_token)
   00536|         .filter(|token| looks_like_local_file_path(token))
   00537|         .collect::<Vec<_>>();
   00538|     paths.dedup();
   00539|     paths
   00540| }
