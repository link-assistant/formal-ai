   00147| # the unit tests, the 32 rule files under rules/ and this run read one source.
   00148| cp "$ROOT/experiments/issue_1028_agent_cli_ladder/leaves.tsv" "$OUT/leaves.tsv"
   00149| 
   00150| python3 - "$OUT/leaves.tsv" "$NODES" <<'PY'
   00151| import sys
   00152| from pathlib import Path
   00153| leaves = {}
   00154| for line in Path(sys.argv[1]).read_text().splitlines():
   00155|     leaf, text, change_path, change_marker, change_guard, requirement = line.split('\t', 5)
   00156|     leaves[int(leaf[1:])] = (text, change_path, change_marker, change_guard, requirement)
   00157| 
   00158| def child(path, branch):
   00159|     return path + ("." if path else "") + str(branch)
   00160| 
   00161| def leaf_index(path):
   00162|     bits = ''.join('0' if p == '1' else '1' for p in path.split('.'))
   00163|     return int(bits, 2) + 1
   00164| 
   00165| def requirement_text(start, end):
   00166|     listed = ' '.join(f'({k}) {leaves[k][4]}' for k in range(start, end + 1))
   00167|     return ('Deliver these requirements in this repository; each names behaviour '
   00168|             'or a declaration, never a file, so find the declaration in the '
   00169|             'source tree first: ' + listed)
   00170| def emit(path, depth, out):
   00171|     if depth == 0:
   00172|         # Issue #1085 (D4): the root and every node down to depth 3 are
   00173|         # requirement-shaped; the prompt names behaviour, never a file.
   00174|         text = 'Root task: ' + requirement_text(1, 32)
   00175|         criterion = 'requirement_changes'
   00176|         node_id = 'R'
   00177|     elif depth == 5:
   00178|         i = leaf_index(path)
   00179|         node_id = path
   00180|         leaf_text, criterion_path, criterion_marker, criterion_guard, _requirement = leaves[i]
   00181|         text = f'Atomic task L{i:02d}: {leaf_text}'
   00182|         criterion = 'tracked_source_change'
   00183|     else:
   00184|         node_id = path
   00185|         bits = ''.join('0' if p == '1' else '1' for p in path.split('.'))
   00186|         prefix = int(bits, 2)
   00187|         span = 2 ** (5 - depth)
   00188|         start = prefix * span + 1
   00189|         end = (prefix + 1) * span
   00190|         if depth <= 3:
   00191|             text = f'Decomposition node {path}: ' + requirement_text(start, end)
   00192|             criterion = 'requirement_changes'
   00193|         else:
   00194|             text = f'Complete recursive decomposition node {path}, covering atomic tasks L{start:02d}–L{end:02d}; both child nodes must produce independently checkable evidence.'
   00195|             criterion = 'new_composite_effect'
   00196|     if depth < 5:
   00197|         criterion_path = ''
   00198|         criterion_marker = ''
   00199|         criterion_guard = ''
   00200|     left = child(path, 1) if depth < 5 else ''
   00201|     right = child(path, 2) if depth < 5 else ''
   00202|     out.append((node_id, depth, text, criterion, left, right, criterion_path,
   00203|                 criterion_marker, criterion_guard))
   00204|     if depth < 5:
   00205|         emit(child(path,1), depth+1, out)
   00206|         emit(child(path,2), depth+1, out)
   00207| 
   00208| rows=[]
   00209| emit('',0,rows)
   00210| # `depth` is an int, and str.join refuses a non-str item, so joining the row
   00211| # straight raised TypeError before a single node was ever selected. Render
   00212| # every field before joining rather than trusting the tuple to be all strings.
   00213| # Empty optional fields belong to the in-memory row, but emitting their trailing
   00214| # separators makes the committed TSV fail git's whitespace check. Readers pad
   00215| # omitted tail fields back to the eight-field schema below.
   00216| Path(sys.argv[2]).write_text(
   00217|     '\n'.join('\t'.join(map(str, r)).rstrip('\t') for r in rows) + '\n'
   00218| )
   00219| PY
