   00294|   rm -f "$session_dir/agent-stderr.log"
   00295|   rm -f "$session_dir/formal-ai.log"
   00296|   rm -f "$session_dir/proof.md"
   00297|   rm -f "$session_dir/effect.lino"
   00298|   node_number=$(python3 - "$id" <<'PY'
   00299| import sys
   00300| node=sys.argv[1]
   00301| if node == 'R':
   00302|     print(0)
   00303| else:
   00304|     bits=''.join('0' if x == '1' else '1' for x in node.split('.'))
   00305|     print(int(bits, 2) + 1)
   00306| PY
   00307| )
   00308|   port=$((BASE_PORT + node_number))
   00309| 
   00310|   # Cleaning the scratch checkout is not what the ladder measures, and it must
   00311|   # never decide a node's verdict. `rm -rf` reports ENOTEMPTY for a directory
   00312|   # that gained a file while the walk was inside it, which is what a just-killed
   00313|   # server flushing its last write looks like; the trap runs under `set -e`, so
   00314|   # that single failure ended the whole run after a node the log had already
   00315|   # recorded as PASS. Retry briefly, then leave the directory to the operating
   00316|   # system's temporary sweeper rather than failing the node.
   00317|   cleanup_one() {
