   00221| python3 - "$NODES" "$TREE_DEPTH" "$NODE_FILTER" > "$OUT/selected.tsv" <<'PY'
   00222| import sys
   00223| from pathlib import Path
   00224| rows=[]
   00225| for line in Path(sys.argv[1]).read_text().splitlines():
   00226|     fields = line.split('\t', 8)
   00227|     if not 6 <= len(fields) <= 9:
   00228|         raise ValueError(f'node row has {len(fields)} fields, expected 6 through 9: {line!r}')
   00229|     fields.extend([''] * (9 - len(fields)))
   00230|     (node, depth, text, criterion, left, right,
   00231|      criterion_path, criterion_marker, criterion_guard) = fields
   00232|     rows.append((node, int(depth), text, criterion, left, right,
   00233|                  criterion_path, criterion_marker, criterion_guard))
   00234| mode=sys.argv[2]
   00235| filt=sys.argv[3]
   00236| levels=list(range(5,-1,-1)) if mode=='all' else [int(mode)]
   00237| for level in levels:
   00238|     for row in rows:
   00239|         node, depth, *_ = row
   00240|         in_focused_subtree = (
   00241|             not filt
   00242|             or filt == 'R'
   00243|             or node == filt
   00244|             or node.startswith(filt + '.')
   00245|         )
   00246|         if depth == level and in_focused_subtree:
   00247|             print('\t'.join(map(str,row)).rstrip('\t'))
   00248| PY
   00249| 
   00250| selected_count=$(wc -l < "$OUT/selected.tsv" | tr -d ' ')
   00251| expected=1
   00252| if [[ "$TREE_DEPTH" = all ]]; then
   00253|   if [[ -z "$NODE_FILTER" || "$NODE_FILTER" = R ]]; then
   00254|     expected=63
   00255|   else
   00256|     filter_depth=$(awk -F. '{ print NF }' <<< "$NODE_FILTER")
   00257|     expected=$(( (1 << (6 - filter_depth)) - 1 ))
   00258|   fi
   00259| elif [[ -n "$NODE_FILTER" ]]; then
   00260|   # A filter names a subtree; a fixed depth selects that subtree's nodes at the
   00261|   # depth. `R` at depth 5 is all 32 leaves, a depth-4 node is its two leaves,
   00262|   # a leaf is itself. The old `expected=1` rejected every filter above a leaf.
   00263|   if [[ "$NODE_FILTER" == R ]]; then
