   00042| # A full depth-five run is over half an hour of real Agent CLI turns, and it
   00043| # shares `target/` with whatever else is building on the machine. A rebuild or a
   00044| # cache prune inside that window swaps -- or removes -- the binary under
   00045| # measurement, and a node that fails because its server never started is
   00046| # indistinguishable in the log from a node that failed on its merits. Copy the
   00047| # binary out once, and every node is measured against the same bytes.
   00048| STAGE="$(mktemp -d)"
   00049| WORK="$STAGE/work"
   00050| cleanup_stage() {
   00051|   git -C "$ROOT" worktree remove --force "$WORK" >/dev/null 2>&1 || true
   00052|   git -C "$ROOT" worktree prune >/dev/null 2>&1 || true
   00053|   rm -rf "$STAGE"
   00054| }
   00055| trap cleanup_stage EXIT
   00056| cp "$BIN" "$STAGE/formal-ai"
   00057| BIN="$STAGE/formal-ai"
