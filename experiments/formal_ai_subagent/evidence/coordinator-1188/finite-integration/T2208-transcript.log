   00329|   reset_work || { printf '%s\tFAIL\tworktree_reset\n' "$id" | tee -a "$RUN_LOG"; return 1; }
   00330|   mkdir -p "$work/.agent-ladder"
   00331| 
   00332|   local child_diffs="" leaf_span=""
   00333|   if [[ "$depth" -eq 4 ]]; then
   00334|     local left_effect_source="${VERIFIED_EFFECTS[$left]:-}"
   00335|     local right_effect_source="${VERIFIED_EFFECTS[$right]:-}"
   00336|     if [[ ! -s "$left_effect_source" || ! -s "$right_effect_source" ]]; then
   00337|       printf '%s\tFAIL\tmissing_current_run_child_effect\n' "$id" | tee -a "$RUN_LOG"
   00338|       return 1
   00339|     fi
   00340|     # Issue #1085 (D4): a composite must also merge both children's diffs.
   00341|     if [[ ! -s "$OUT/$left/change.diff" || ! -s "$OUT/$right/change.diff" ]]; then
   00342|       printf '%s\tFAIL\tmissing_current_run_child_diff\n' "$id" | tee -a "$RUN_LOG"
   00343|       return 1
   00344|     fi
   00345|     child_diffs="$OUT/$left/change.diff $OUT/$right/change.diff"
   00346|     mkdir -p "$work/.agent-ladder/verified-children"
   00347|     cp "$left_effect_source" "$work/.agent-ladder/verified-children/node-$left.lino"
   00348|     cp "$right_effect_source" "$work/.agent-ladder/verified-children/node-$right.lino"
   00349|     git -C "$work" add .agent-ladder/verified-children
   00350|     git -C "$work" commit -qm ladder-verified-child-effects
   00351|   elif [[ "$depth" -le 3 ]]; then
   00352|     leaf_span=$(python3 - "$id" "$depth" <<'PY'
   00353| import sys
   00354| node, depth = sys.argv[1], int(sys.argv[2])
   00355| if node == 'R':
   00356|     print('1-32')
   00357| else:
   00358|     bits = ''.join('0' if p == '1' else '1' for p in node.split('.'))
   00359|     span = 2 ** (5 - depth)
   00360|     start = int(bits, 2) * span + 1
   00361|     print(f'{start}-{start + span - 1}')
   00362| PY
   00363| )
   00364|   fi
   00365| 
   00366|   # `setsid` gives the server its own process group so `kill -- -pid` takes
   00367|   # its children with it. macOS has no setsid; there the plain kill in
   00368|   # cleanup_one still stops the server, so a developer can run one node.
   00369|   "${SETSID[@]}" env FORMAL_AI_AGENT_MODE=1 FORMAL_AI_TRACE_REQUESTS=1 \
   00370|     FORMAL_AI_MEMORY_PATH="$STAGE/memory/node-$id/memory.lino" \
   00371|     FORMAL_AI_DREAMING=0 "$BIN" serve --agent-mode --host 127.0.0.1 --port "$port" \
   00372|     >"$session_dir/formal-ai.log" 2>&1 &
   00373|   server_pid=$!
   00374| 
   00375|   if ! curl -fsS --retry 30 --retry-delay 1 --retry-connrefused "http://127.0.0.1:$port/health" >/dev/null; then
   00376|     printf '%s\tFAIL\tformal_ai_server_start\n' "$id" | tee -a "$RUN_LOG"
   00377|     tail -100 "$session_dir/formal-ai.log" >&2 || true
