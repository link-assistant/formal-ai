   00265|   else
   00266|     filter_depth=$(awk -F. '{ print NF }' <<< "$NODE_FILTER")
   00267|   fi
   00268|   if (( filter_depth > TREE_DEPTH )); then
   00269|     expected=0
   00270|   else
   00271|     expected=$((1 << (TREE_DEPTH - filter_depth)))
   00272|   fi
   00273| else
   00274|   expected=$((1 << TREE_DEPTH))
   00275| fi
   00276| [[ "$selected_count" -eq "$expected" ]] || { echo "expected $expected selected nodes, got $selected_count" >&2; exit 1; }
