   00020| def result(path):
   00021|     values = {}
   00022|     for line in Path(path).read_text().splitlines():
   00023|         parts = line.strip().split(" ", 1)
   00024|         if len(parts) == 2 and parts[0] in FIELDS:
   00025|             if parts[0] in values:
   00026|                 fail(f"duplicate result field: {parts[0]}")
   00027|             values[parts[0]] = parts[1].strip().strip('"')
   00028|     return values
