   00006| FIELDS = ("requested_depth", "node_filter", "authored_rules_enabled", "source_commit", "source_tree",
   00007|           "tree_sha256", "leaves_sha256", "selected_nodes", "failures", "deepest_passing_level",
   00008|           "leaf_nodes_selected", "leaf_nodes_passing", "leaf_nodes_passing_without_authored_rules")
