   00030| 
   00031| def corpus(path):
   00032|     rows = {}
   00033|     for row in (Path(path) / "tree.tsv").read_text().splitlines():
   00034|         node, depth, *_ = row.split("\t")
   00035|         if not re.fullmatch(r"R|[12](\.[12]){0,4}", node) or int(depth) != (0 if node == "R" else node.count(".") + 1):
   00036|             fail(f"invalid canonical tree node: {node}")
   00037|         if node in rows:
   00038|             fail(f"duplicate tree node: {node}")
   00039|         rows[node] = (int(depth), row)
   00040|     if len(rows) != 63 or sum(depth == 5 for depth, _ in rows.values()) != 32:
   00041|         fail("the canonical corpus must contain all 63 nodes and 32 leaves")
   00042|     return rows
   00043| 
   00044| 
   00045| def selected(tree, mode, prefix):
   00046|     if mode not in [str(depth) for depth in range(6)] + ["all"]:
   00047|         fail(f"invalid requested depth: {mode}")
   00048|     if prefix not in ("none", "R") and not re.fullmatch(r"[12](\.[12]){0,4}", prefix):
   00049|         fail(f"invalid node filter: {prefix}")
   00050|     return {node for node, (depth, _) in tree.items()
   00051|             if (mode == "all" or depth == int(mode))
   00052|             and (prefix in ("none", "R") or node == prefix or node.startswith(prefix + "."))}
   00053| 
   00054| 
   00055| def observations(path):
   00056|     verdicts = {}
   00057|     for row in (Path(path) / "run.log").read_text().splitlines():
   00058|         fields = row.split("\t")
   00059|         if len(fields) != 3 or fields[1] not in ("PASS", "FAIL"):
   00060|             continue
   00061|         if fields[0] in verdicts:
   00062|             fail(f"duplicate measured node: {fields[0]}")
   00063|         verdicts[fields[0]] = fields[1]
   00064|     return verdicts
   00065| 
   00066| 
   00067| def counts(tree, chosen, verdicts, rules):
   00068|     leaf = {node for node in chosen if tree[node][0] == 5}
   00069|     deepest = "none"
   00070|     for depth in range(5, -1, -1):
   00071|         level = {node for node in chosen if tree[node][0] == depth}
   00072|         if not level:
   00073|             continue
   00074|         if any(verdicts[node] != "PASS" for node in level):
   00075|             break
   00076|         deepest = str(depth)
   00077|     values = {"selected_nodes": str(len(chosen)), "failures": str(sum(verdicts[node] == "FAIL" for node in chosen)),
   00078|               "deepest_passing_level": deepest, "leaf_nodes_selected": str(len(leaf)),
   00079|               "leaf_nodes_passing": str(sum(verdicts[node] == "PASS" for node in leaf))}
   00080|     if rules == "false":
   00081|         values["leaf_nodes_passing_without_authored_rules"] = values["leaf_nodes_passing"]
   00082|     return values
