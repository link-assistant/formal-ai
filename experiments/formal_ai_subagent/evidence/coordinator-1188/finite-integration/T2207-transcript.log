   00001| #!/usr/bin/env python3
   00002| """Join the evidence of a sharded Agent CLI ladder run into one run.
   00003| 
   00004| PR #1188: the depth-five ladder ran its 32 leaves one after another in a single
   00005| job (72-82 minutes on runs 37652295748 and later). Leaves are independent --
   00006| each starts from a reset worktree, and only a depth-4 composite reads its
   00007| children's effects -- so `.github/workflows/issue-1028-agent-ladder.yml` runs
   00008| them as sixteen `NODE_FILTER` subtrees of two leaves each. Every shard writes
   00009| the same evidence layout `run.sh` always wrote; this script joins them back
   00010| into exactly that layout, so the ratchet comparison and the uploaded artifact
   00011| read one run as before.
   00012| 
   00013| The join refuses, with a non-zero exit, anything that is not one whole run:
   00014| a shard count that differs from the plan, a shard without its result, shards
   00015| that disagree about the depth or the authored-rules mode, or two shards that
   00016| claim the same node. A ladder that silently lost a shard would select fewer
   00017| than 32 leaves, and the comparison only judges a full-width run -- so a lost
   00018| shard would otherwise turn the ratchet off instead of failing it.
   00019| 
   00020| Usage: combine-shards.py <shards-dir> <out-dir> <expected-shard-count>
   00021|   shards-dir  one sub-directory per shard, each a shard's `$OUT`
   00022|   out-dir     where the joined evidence is written
   00023| """
   00024| 
   00025| import shutil
   00026| import sys
   00027| from pathlib import Path
   00028| 
   00029| FIELDS = (
   00030|     "requested_depth",
   00031|     "node_filter",
   00032|     "authored_rules_enabled",
   00033|     "selected_nodes",
   00034|     "failures",
   00035|     "deepest_passing_level",
   00036|     "leaf_nodes_selected",
   00037|     "leaf_nodes_passing",
   00038|     "leaf_nodes_passing_without_authored_rules",
   00039| )
   00040| SUMMED = (
   00041|     "selected_nodes",
   00042|     "failures",
   00043|     "leaf_nodes_selected",
   00044|     "leaf_nodes_passing",
   00045|     "leaf_nodes_passing_without_authored_rules",
   00046| )
   00047| 
   00048| 
   00049| def read_result(path: Path) -> dict:
   00050|     result = {}
   00051|     for line in path.read_text().splitlines():
   00052|         parts = line.strip().split(" ", 1)
   00053|         if len(parts) == 2 and parts[0] in FIELDS:
   00054|             result[parts[0]] = parts[1].strip().strip('"')
   00055|     return result
   00056| 
   00057| 
   00058| def fail(message: str) -> None:
   00059|     print(f"::error title=Agent CLI ladder shards do not form one run::{message}")
   00060|     raise SystemExit(1)
   00061| 
   00062| 
   00063| def main() -> None:
   00064|     if len(sys.argv) != 4:
   00065|         fail("usage: combine-shards.py <shards-dir> <out-dir> <expected-shard-count>")
   00066|     shards_dir, out_dir, expected = Path(sys.argv[1]), Path(sys.argv[2]), int(sys.argv[3])
   00067|     shards = sorted(path.parent for path in shards_dir.glob("*/ladder-result.lino"))
   00068|     if len(shards) != expected:
   00069|         fail(f"the plan has {expected} shard(s), {len(shards)} wrote a ladder-result.lino")
   00070| 
   00071|     results = [read_result(shard / "ladder-result.lino") for shard in shards]
   00072|     for key in ("requested_depth", "authored_rules_enabled"):
   00073|         values = {result.get(key) for result in results}
   00074|         if len(values) != 1:
   00075|             fail(f"shards disagree on {key}: {sorted(map(str, values))}")
   00076|     filters = [result.get("node_filter", "none") for result in results]
   00077|     if len(set(filters)) != len(filters):
   00078|         fail(f"two shards measured the same subtree: {filters}")
   00079| 
   00080|     out_dir.mkdir(parents=True, exist_ok=True)
   00081|     seen_nodes: dict[str, Path] = {}
   00082|     selected_rows: list[str] = []
   00083|     run_rows: list[str] = []
   00084|     for shard in shards:
   00085|         rows = (shard / "selected.tsv").read_text().splitlines()
   00086|         for row in rows:
   00087|             node = row.split("\t", 1)[0]
   00088|             if node in seen_nodes:
   00089|                 fail(f"node {node} was measured by {seen_nodes[node].name} and {shard.name}")
   00090|             seen_nodes[node] = shard
   00091|             if (shard / node).is_dir():
   00092|                 shutil.copytree(shard / node, out_dir / node, dirs_exist_ok=False)
   00093|         selected_rows.extend(rows)
   00094|         run_rows.extend((shard / "run.log").read_text().splitlines())
   00095|     for shared in ("tree.tsv", "leaves.tsv"):
   00096|         source = shards[0] / shared
   00097|         if source.is_file():
   00098|             shutil.copyfile(source, out_dir / shared)
   00099|     (out_dir / "selected.tsv").write_text("".join(f"{row}\n" for row in selected_rows))
   00100|     (out_dir / "run.log").write_text("".join(f"{row}\n" for row in run_rows))
   00101| 
   00102|     combined = {
   00103|         "requested_depth": results[0]["requested_depth"],
   00104|         # One shard is the run as dispatched; many shards split the whole tree.
   00105|         "node_filter": filters[0] if len(results) == 1 else "none",
   00106|         "authored_rules_enabled": results[0]["authored_rules_enabled"],
   00107|     }
   00108|     for key in SUMMED:
   00109|         present = [result[key] for result in results if key in result]
   00110|         if present:
   00111|             if len(present) != len(results):
   00112|                 fail(f"only some shards report {key}")
   00113|             combined[key] = str(sum(int(value) for value in present))
   00114|     # A level passed only when it passed in every shard; in a fixed-depth run
   00115|     # each shard reports that depth or none.
   00116|     levels = {result.get("deepest_passing_level", "none") for result in results}
   00117|     combined["deepest_passing_level"] = levels.pop() if len(levels) == 1 else "none"
   00118| 
   00119|     lines = ["ladder_result"]
   00120|     lines.extend(f'  {key} "{combined[key]}"' for key in FIELDS if key in combined)
   00121|     (out_dir / "ladder-result.lino").write_text("\n".join(lines) + "\n")
   00122| 
   00123|     table = "\n".join(
   00124|         "| " + " | ".join(row.split("\t", 2)) + " |"
   00125|         for row in run_rows
   00126|         if row.count("\t") == 2
   00127|     )
   00128|     (out_dir / "README.md").write_text(
   00129|         "# Agent CLI binary-tree ladder run\n\n"
   00130|         f"Joined from {len(shards)} shard(s) (`combine-shards.py`, PR #1188).\n\n"
   00131|         + "".join(f"- {key.replace('_', ' ')}: {combined[key]}\n" for key in FIELDS if key in combined)
   00132|         + "\n| node | verdict | detail |\n| --- | --- | --- |\n"
   00133|         + (table or "| - | - | no node ran |")
   00134|         + "\n"
   00135|     )
   00136|     print((out_dir / "ladder-result.lino").read_text(), end="")
   00137| 
   00138| 
   00139| if __name__ == "__main__":
   00140|     main()
   00141| 
   
