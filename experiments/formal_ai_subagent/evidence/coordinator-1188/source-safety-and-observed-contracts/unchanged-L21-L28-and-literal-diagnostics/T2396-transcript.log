      "result": "<file>\n00001| //! The executed half of the procedural \"how to X\" handler — issue #991.\n00002| //!\n00003| //! [`crate::solver_handler_how::try_how_to_procedure`] records the *plan*: the\n00004| //! services it would consult and the gates it would apply. That plan is still\n00005| //! the right answer when nothing can be retrieved, but issue #991 requires the\n00006| //! native path to actually run the same bounded source-selection and synthesis\n00007| //! contract the browser worker runs, and to answer from the captured bytes when\n00008| //! it succeeds.\n00009| //!\n00010| //! This module is that seam. It reads the user's service opt-outs, walks the\n00011| //! enabled registry services through [`crate::how_to_guide`], persists the\n00012| //! per-service accessibility record, and answers with the synthesised guide —\n00013| //! falling back to the discovery plan, unchanged, whenever the evidence is\n00014| //! insufficient. Nothing here reaches the network by itself: every byte arrives\n00015| //! through [`CachedSourceClient`], so an offline run replays committed captures\n00016| //! and a live run refreshes them along the identical code path.\n00017| \n00018| use crate::engine::SymbolicAnswer;\n00019| use crate::event_log::EventLog;\n00020| use crate::how_to_guide::{GuideBounds, HowToGuide, ServicePreferences, synthesize_how_to_guide};\n00021| use crate::seed::external_service_settings_keys;\n00022| use crate::service_accessibility::{ServiceAccessibilityCache, unix_now};\n00023| use crate::solver_handler_how::{procedural_how_to_task, try_how_to_procedure};\n00024| use crate::solver_handlers::finalize_simple;\n00025| use crate::source_fetch::{CachedSourceClient, CurlSourceTransport, SourceTransport};\n00026| \n00027| /// Comma-separated `settings_key`s the environment opts out of, mirroring the\n00028| /// browser settings toggles for runtimes that have no settings UI (the CLI, the\n00029| /// HTTP server, and the test suites).\n00030| pub const DISABLED_SERVICES_ENV: &str = \"FORMAL_AI_DISABLED_SERVICES\";\n00031| \n00032| /// Environment override for where the capture cache and the accessibility\n00033| /// record live; the same variable the executed web search reads.\n00034| const CACHE_DIR_ENV: &str = \"FORMAL_AI_SOURCE_CACHE_DIR\";\n00035| \n00036| /// Service opt-outs declared by the environment.\n00037| ///\n00038| /// Only keys the registry actually declares are honoured, so a typo disables\n00039| /// nothing silently: it is reported as `settings:unknown_service_key` instead.\n00040| #[must_use]\n00041| pub fn service_preferences_from_env(log: &mut EventLog) -> ServicePreferences {\n00042|     let Ok(raw) = std::env::var(DISABLED_SERVICES_ENV) else {\n00043|         return ServicePreferences::default();\n00044|     };\n00045|     let declared = external_service_settings_keys();\n00046|     let mut preferences = ServicePreferences::default();\n00047|     for key in raw.split(',').map(str::trim).filter(|key| !key.is_empty()) {\n00048|         if declared.iter().any(|declared| declared == key) {\n00049|             log.append(\"settings:service_disabled\", key.to_owned());\n00050|             preferences = preferences.with(key, false);\n00051|         } else {\n00052|             log.append(\"settings:unknown_service_key\", key.to_owned());\n00053|         }\n00054|     }\n00055|     preferences\n00056| }\n00057| \n00058| /// Execute the recognised procedural request through a caller-supplied capture\n00059| /// client, the caller's settings, and the caller's accessibility record.\n00060| ///\n00061| /// This seam keeps tests deterministic: the same call replays a committed\n00062| /// capture tree offline and refreshes it online, and both runs must produce the\n00063| /// identical guide, trace, and evidence.\n00064| pub fn try_how_to_procedure_with_client<T: SourceTransport>(\n00065|     prompt: &str,\n00066|     normalized: &str,\n00067|     log: &mut EventLog,\n00068|     client: &CachedSourceClient<T>,\n00069|     preferences: &ServicePreferences,\n00070|     availability: &mut ServiceAccessibilityCache,\n00071| ) -> Option<SymbolicAnswer> {\n00072|     if crate::legality_warning::assess(prompt, normalized).is_some() {\n00073|         return None;\n00074|     }\n00075|     let task = procedural_how_to_task(normalized)?;\n00076|     let bounds = GuideBounds::default();\n00077|     let guide = synthesize_how_to_guide(\n00078|         &task,\n00079|         client,\n00080|         preferences,\n00081|         &bounds,\n00082|         availability,\n00083|         unix_now(),\n00084|     );\n00085|     if let Err(error) = availability.save() {\n00086|         log.append(\"service_accessibility:save_failed\", error.to_string());\n00087|     }\n00088|     guide.record(log);\n00089|     if !guide.is_sufficient() {\n00090|         // Not enough corroborated procedure to assert steps. The discovery plan\n00091|         // is still a truthful answer, and it is exactly what the runtime\n00092|         // answered before this handler existed, so the fallback is a strict\n00093|         // superset of the prior behaviour rather than a replacement.\n00094|         log.append(\"procedural_how_to:fallback\", \"discovery_plan\".to_owned());\n00095|         return try_how_to_procedure(prompt, normalized, log);\n00096|     }\n00097|     Some(answer_synthesized_guide(prompt, &guide, log))\n00098| }\n00099| \n00100| /// Use the process source cache and the environment's settings.\n00101| ///\n00102| /// Transport is enabled only after the runtime has explicitly opted into live\n00103| /// fetches. Offline mode still replays valid captures, so a committed QA\n00104| /// capture tree produces the full guide with no network at all.\n00105| pub fn try_how_to_procedure_with_offline(\n00106|     prompt: &str,\n00107|     normalized: &str,\n00108|     log: &mut EventLog,\n00109|     offline: bool,\n00110| ) -> Option<SymbolicAnswer> {\n00111|     let cache_dir = std::env::var(CACHE_DIR_ENV).unwrap_or_else(|_| String::from(\"data\"));\n00112|     let client = CachedSourceClient::new(&cache_dir, CurlSourceTransport).with_online(!offline);\n00113|     let preferences = service_preferences_from_env(log);\n00114|     let mut availability = ServiceAccessibilityCache::load(&cache_dir);\n00115|     try_how_to_procedure_with_client(\n00116|         prompt,\n00117|         normalized,\n00118|         log,\n00119|         &client,\n00120|         &preferences,\n00121|         &mut availability,\n00122|     )\n00123| }\n00124| \n00125| fn answer_synthesized_guide(\n00126|     prompt: &str,\n00127|     guide: &HowToGuide,\n00128|     log: &mut EventLog,\n00129| ) -> SymbolicAnswer {\n00130|     finalize_simple(\n00131|         prompt,\n00132|         log,\n00133|         \"procedural_how_to\",\n00134|         \"response:procedural_how_to_guide\",\n00135|         &guide.markdown(),\n00136|         0.82,\n00137|     )\n00138| }\n00139| \n\n(End of file - total 139 lines)\n</file>"
