      "result": "<file>\n00001| //! Writing and undoing the global client configuration files.\n00002| //!\n00003| //! `formal-ai with --global <tool>` edits the client's own settings file in\n00004| //! place, so the rendering of those files — and the backups that make `--undo`\n00005| //! exact — lives apart from the per-run invocation rendering.\n00006| \n00007| use std::error::Error;\n00008| use std::fmt::Write as _;\n00009| use std::fs;\n00010| use std::path::Path;\n00011| \n00012| use serde_json::Value;\n00013| use toml_edit::{DocumentMut, Item, Table, value as toml_value};\n00014| \n00015| use crate::seed::{ClientIntegration, ConfigFormat};\n00016| \n00017| use super::command::ensure_trailing_newline;\n00018| use super::global_verify::{probe_headless_start, verify_written_config};\n00019| use super::{\n00020|     EMPTY_BACKUP_SENTINEL, ERROR_PLACEHOLDER, RENDERED_PLACEHOLDER, RenderContext,\n00021|     WithFormalAiArgs, backup_path, codex_model_catalog, global_config_path, render_context,\n00022|     render_template, write_file,\n00023| };\n00024| \n00025| /// Opening marker of the block a shell profile lets formal-ai own, per tool.\n00026| /// Kept as data next to its closing counterpart so every reader and writer of a\n00027| /// managed block agrees on one spelling.\n00028| const MANAGED_BLOCK_START_PREFIX: &str = \"# >>> formal-ai \";\n00029| const MANAGED_BLOCK_END_PREFIX: &str = \"# <<< formal-ai \";\n00030| \n00031| pub(super) fn managed_block_start(tool: &str) -> String {\n00032|     format!(\"{MANAGED_BLOCK_START_PREFIX}{tool}\")\n00033| }\n00034| \n00035| pub(super) fn managed_block_end(tool: &str) -> String {\n00036|     format!(\"{MANAGED_BLOCK_END_PREFIX}{tool}\")\n00037| }\n00038| \n00039| pub(super) fn write_global_config(\n00040|     integration: &ClientIntegration,\n00041|     args: &WithFormalAiArgs,\n00042| ) -> Result<(), Box<dyn Error>> {\n00043|     let mut context = render_context(integration, args)?;\n00044|     let global_config = integration.global_config_for(&context.protocol);\n00045|     if !global_config.model_catalog_path.is_empty() {\n00046|         let catalog_path = global_config_path(&global_config.model_catalog_path)?;\n00047|         let catalog_backup = backup_path(&catalog_path, &global_config.backup_suffix);\n00048|         ensure_backup(&catalog_path, &catalog_backup)?;\n00049|         context.model_catalog_path = catalog_path.display().to_string();\n00050|         write_file(&catalog_path, &codex_model_catalog(&context.model)?)?;\n00051|     }\n00052|     let path = global_config_path(&global_config.path)?;\n00053|     let backup_path = backup_path(&path, &global_config.backup_suffix);\n00054|     ensure_backup(&path, &backup_path)?;\n00055|     let existing = fs::read_to_string(&path).unwrap_or_default();\n00056|     let next = match global_config.format {\n00057|         ConfigFormat::Toml => {\n00058|             render_toml_settings(&global_config.toml_settings, &existing, &context)?\n00059|         }\n00060|         ConfigFormat::Json => {\n00061|             merge_json_settings(&global_config.json_settings, &existing, &context)?\n00062|         }\n00063|         ConfigFormat::ShellEnv => {\n00064|             merge_shell_env_config(&integration.id, global_config, &existing, &context)\n00065|         }\n00066|     };\n00067|     if next == existing {\n00068|         println!(\n00069|             \"{} already configured at {}\",\n00070|             integration.id,\n00071|             path.display()\n00072|         );\n00073|     } else {\n00074|         write_file(&path, &next)?;\n00075|         println!(\"configured {} at {}\", integration.id, path.display());\n00076|     }\n00077|     for companion in &global_config.companion_files {\n00078|         write_companion_file(&integration.id, companion, &context)?;\n00079|     }\n00080|     // Writing is not configuring: the client is only ready once the files read\n00081|     // back the startup contract the seed declares (issue #909).\n00082|     verify_written_config(integration, global_config, &context)?;\n00083|     if args.verify {\n00084|         probe_headless_start(integration, global_config, &context)?;\n00085|     }\n00086|     Ok(())\n00087| }\n00088| \n00089| /// Materialise a companion settings file belonging to the same global install.\n00090| ///\n00091| /// Environment alone is not always a configuration: gemini-cli reads\n00092| /// `GEMINI_DEFAULT_AUTH_TYPE` as a *default* and still refuses to start headlessly\n00093| /// unless a settings file records the selection, so `--global` reported success and\n00094| /// the client then failed with `Invalid auth method selected.` (issue #909). The\n00095| /// companion is backed up before it is touched, exactly like the main file, so\n00096| /// `--undo` stays exact.\n00097| fn write_companion_file(\n00098|     integration_id: &str,\n00099|     companion: &crate::seed::ClientIntegrationCompanionFile,\n00100|     context: &RenderContext,\n00101| ) -> Result<(), Box<dyn Error>> {\n00102|     let path = global_config_path(&companion.path)?;\n00103|     ensure_backup(&path, &backup_path(&path, &companion.backup_suffix))?;\n00104|     let existing = fs::read_to_string(&path).unwrap_or_default();\n00105|     let next = match companion.format {\n00106|         ConfigFormat::Toml => render_toml_settings(&companion.toml_settings, &existing, context)?,\n00107|         ConfigFormat::Json => merge_json_settings(&companion.json_settings, &existing, context)?,\n00108|         // A companion carries settings; environment belongs to the profile block the\n00109|         // main config writes. The seed parser rejects a `shell_env` companion, so\n00110|         // reaching here means there is nothing of its own to write.\n00111|         ConfigFormat::ShellEnv => existing.clone(),\n00112|     };\n00113|     if next == existing {\n00114|         println!(\"{integration_id} already configured at {}\", path.display());\n00115|     } else {\n00116|         write_file(&path, &next)?;\n00117|         println!(\"configured {integration_id} at {}\", path.display());\n00118|     }\n00119|     Ok(())\n00120| }\n00121| \n00122| pub(super) fn undo_global_config(\n00123|     integration: &ClientIntegration,\n00124|     args: &WithFormalAiArgs,\n00125| ) -> Result<(), Box<dyn Error>> {\n00126|     let context = render_context(integration, args)?;\n00127|     let global_config = integration.global_config_for(&context.protocol);\n00128|     let path = global_config_path(&global_config.path)?;\n00129|     let config_backup_path = backup_path(&path, &global_config.backup_suffix);\n00130|     let mut restored = if config_backup_path.exists() {\n00131|         restore_backup(&path, &config_backup_path)?;\n00132|         true\n00133|     } else {\n00134|         false\n00135|     };\n00136|     if !global_config.model_catalog_path.is_empty() {\n00137|         let catalog_path = global_config_path(&global_config.model_catalog_path)?;\n00138|         let catalog_backup_path = backup_path(&catalog_path, &global_config.backup_suffix);\n00139|         if catalog_backup_path.exists() {\n00140|             restore_backup(&catalog_path, &catalog_backup_path)?;\n00141|             restored = true;\n00142|         }\n00143|     }\n00144|     for companion in &global_config.companion_files {\n00145|         let companion_path = global_config_path(&companion.path)?;\n00146|         let companion_backup = backup_path(&companion_path, &companion.backup_suffix);\n00147|         if companion_backup.exists() {\n00148|             restore_backup(&companion_path, &companion_backup)?;\n00149|             restored = true;\n00150|         }\n00151|     }\n00152|     if !restored {\n00153|         println!(\n00154|             \"no formal-ai backup for {} at {}\",\n00155|             integration.id,\n00156|             path.display()\n00157|         );\n00158|         return Ok(());\n00159|     }\n00160|     println!(\n00161|         \"restored {} from {}\",\n00162|         integration.id,\n00163|         config_backup_path.display()\n00164|     );\n00165|     Ok(())\n00166| }\n00167| \n00168| fn restore_backup(path: &Path, backup_path: &Path) -> Result<(), Box<dyn Error>> {\n00169|     if !backup_path.exists() {\n00170|         return Ok(());\n00171|     }\n00172|     let backup = fs::read_to_string(backup_path)?;\n00173|     if backup == EMPTY_BACKUP_SENTINEL {\n00174|         match fs::remove_file(path) {\n00175|             Ok(()) => {}\n00176|             Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}\n00177|             Err(error) => return Err(error.into()),\n00178|         }\n00179|     } else {\n00180|         write_file(path, &backup)?;\n00181|     }\n00182|     fs::remove_file(backup_path)?;\n00183|     Ok(())\n00184| }\n00185| \n00186| fn ensure_backup(path: &Path, backup_path: &Path) -> Result<(), Box<dyn Error>> {\n00187|     if backup_path.exists() {\n00188|         return Ok(());\n00189|     }\n00190|     if let Some(parent) = backup_path.parent() {\n00191|         fs::create_dir_all(parent)?;\n00192|     }\n00193|     if path.exists() {\n00194|         fs::copy(path, backup_path)?;\n00195|     } else {\n00196|         fs::write(backup_path, EMPTY_BACKUP_SENTINEL)?;\n00197|     }\n00198|     Ok(())\n00199| }\n00200| \n00201| pub(super) fn render_toml_settings(\n00202|     settings: &[(String, String)],\n00203|     existing: &str,\n00204|     context: &RenderContext,\n00205| ) -> Result<String, Box<dyn Error>> {\n00206|     let mut document = if existing.trim().is_empty() {\n00207|         DocumentMut::new()\n00208|     } else {\n00209|         existing.parse::<DocumentMut>()?\n00210|     };\n00211|     for (path, value) in settings {\n00212|         set_toml_string(\n00213|             document.as_table_mut(),\n00214|             &render_template(path, context),\n00215|             &render_template(value, context),\n00216|         )?;\n00217|     }\n00218|     Ok(ensure_trailing_newline(document.to_string()))\n00219| }\n00220| \n00221| fn set_toml_string(\n00222|     table: &mut Table,\n00223|     dotted_path: &str,\n00224|     value: &str,\n00225| ) -> Result<(), Box<dyn Error>> {\n00226|     let parts = dotted_path\n00227|         .split('.')\n00228|         .map(str::trim)\n00229|         .filter(|part| !part.is_empty())\n00230|         .collect::<Vec<_>>();\n00231|     let Some((last, parents)) = parts.split_last() else {\n00232|         return Err(\"empty TOML setting path\".into());\n00233|     };\n00234|     let parent = table_at_path_mut(table, parents);\n00235|     parent[*last] = toml_value(value);\n00236|     Ok(())\n00237| }\n00238| \n00239| fn table_at_path_mut<'a>(mut table: &'a mut Table, parts: &[&str]) -> &'a mut Table {\n00240|     for part in parts {\n00241|         let item = table\n00242|             .entry(part)\n00243|             .or_insert_with(|| Item::Table(Table::new()));\n00244|         if !item.is_table() {\n00245|             *item = Item::Table(Table::new());\n00246|         }\n00247|         table = item.as_table_mut().expect(\"table item\");\n00248|     }\n00249|     table\n00250| }\n00251| \n00252| fn merge_json_settings(\n00253|     settings: &[(String, String)],\n00254|     existing: &str,\n00255|     context: &RenderContext,\n00256| ) -> Result<String, Box<dyn Error>> {\n00257|     let mut base = if existing.trim().is_empty() {\n00258|         Value::Object(serde_json::Map::new())\n00259|     } else {\n00260|         serde_json::from_str(existing)?\n00261|     };\n00262|     let overlay = json_settings_value(settings, context)?;\n00263|     merge_json_value(&mut base, overlay);\n00264|     Ok(format!(\"{}\\n\", serde_json::to_string_pretty(&base)?))\n00265| }\n00266| \n00267| pub(super) fn render_json_settings(\n00268|     settings: &[(String, String)],\n00269|     context: &RenderContext,\n00270| ) -> Result<String, Box<dyn Error>> {\n00271|     Ok(format!(\n00272|         \"{}\\n\",\n00273|         serde_json::to_string_pretty(&json_settings_value(settings, context)?)?\n00274|     ))\n00275| }\n00276| \n00277| fn json_settings_value(\n00278|     settings: &[(String, String)],\n00279|     context: &RenderContext,\n00280| ) -> Result<Value, Box<dyn Error>> {\n00281|     let mut value = Value::Object(serde_json::Map::new());\n00282|     for (path, setting_value) in settings {\n00283|         set_json_setting(&mut value, path, setting_value, context)?;\n00284|     }\n00285|     Ok(value)\n00286| }\n00287| \n00288| fn set_json_setting(\n00289|     root: &mut Value,\n00290|     dotted_path: &str,\n00291|     value: &str,\n00292|     context: &RenderContext,\n00293| ) -> Result<(), Box<dyn Error>> {\n00294|     let parts = dotted_path\n00295|         .split('.')\n00296|         .map(str::trim)\n00297|         .filter(|part| !part.is_empty())\n00298|         .map(|part| render_template(part, context))\n00299|         .collect::<Vec<_>>();\n00300|     let Some((last, parents)) = parts.split_last() else {\n00301|         return Err(\"empty JSON setting path\".into());\n00302|     };\n00303| \n00304|     let mut current = root;\n00305|     for part in parents {\n00306|         let object = current\n00307|             .as_object_mut()\n00308|             .ok_or(\"JSON setting path conflicts with a scalar value\")?;\n00309|         current = object\n00310|             .entry(part.clone())\n00311|             .or_insert_with(|| Value::Object(serde_json::Map::new()));\n00312|     }\n00313|     let object = current\n00314|         .as_object_mut()\n00315|         .ok_or(\"JSON setting path conflicts with a scalar value\")?;\n00316|     let rendered = render_template(value, context);\n00317|     let setting = if let Some(literal) = rendered.strip_prefix(\"json:\") {\n00318|         serde_json::from_str(literal)\n00319|             .map_err(|error| invalid_typed_json_setting_error(&rendered, &error))?\n00320|     } else {\n00321|         Value::String(rendered)\n00322|     };\n00323|     object.insert(last.clone(), setting);\n00324|     Ok(())\n00325| }\n00326| \n00327| fn invalid_typed_json_setting_error(rendered: &str, error: &serde_json::Error) -> String {\n00328|     crate::seed::response_for(\"client_integration_invalid_typed_json_setting\", \"en\")\n00329|         .unwrap_or_else(|| \"client_integration_invalid_typed_json_setting\".to_owned())\n00330|         .replace(RENDERED_PLACEHOLDER, rendered)\n00331|         .replace(ERROR_PLACEHOLDER, &error.to_string())\n00332| }\n00333| \n00334| fn merge_json_value(base: &mut Value, overlay: Value) {\n00335|     match (base, overlay) {\n00336|         (Value::Object(base_map), Value::Object(overlay_map)) => {\n00337|             for (key, overlay_value) in overlay_map {\n00338|                 match base_map.get_mut(&key) {\n00339|                     Some(base_value) => merge_json_value(base_value, overlay_value),\n00340|                     None => {\n00341|                         base_map.insert(key, overlay_value);\n00342|                     }\n00343|                 }\n00344|             }\n00345|         }\n00346|         (base_value, overlay_value) => *base_value = overlay_value,\n00347|     }\n00348| }\n00349| \n00350| fn merge_shell_env_config(\n00351|     integration_id: &str,\n00352|     global_config: &crate::seed::ClientIntegrationGlobalConfig,\n00353|     existing: &str,\n00354|     context: &RenderContext,\n00355| ) -> String {\n00356|     let mut next = remove_managed_block(existing, integration_id);\n00357|     if !next.is_empty() && !next.ends_with('\\n') {\n00358|         next.push('\\n');\n00359|     }\n00360|     let _ = writeln!(next, \"{}\", managed_block_start(integration_id));\n00361|     for env in &global_config.shell_env {\n00362|         next.push_str(\"export \");\n00363|         next.push_str(&render_template(&env.key, context));\n00364|         next.push('=');\n00365|         next.push_str(&shell_double_quote(&render_template(&env.value, context)));\n00366|         next.push('\\n');\n00367|     }\n00368|     let _ = writeln!(next, \"{}\", managed_block_end(integration_id));\n00369|     next\n00370| }\n00371| \n00372| fn remove_managed_block(existing: &str, tool: &str) -> String {\n00373|     let start = managed_block_start(tool);\n00374|     let end = managed_block_end(tool);\n00375|     let mut out = String::new();\n00376|     let mut skipping = false;\n00377|     for line in existing.lines() {\n00378|         if line == start {\n00379|             skipping = true;\n00380|             continue;\n00381|         }\n00382|         if skipping {\n00383|             if line == end {\n00384|                 skipping = false;\n00385|             }\n00386|             continue;\n00387|         }\n00388|         out.push_str(line);\n00389|         out.push('\\n');\n00390|     }\n00391|     out\n00392| }\n00393| \n00394| fn shell_double_quote(value: &str) -> String {\n00395|     let escaped = value.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\");\n00396|     format!(\"\\\"{escaped}\\\"\")\n00397| }\n00398| \n\n(End of file - total 398 lines)\n</file>"
