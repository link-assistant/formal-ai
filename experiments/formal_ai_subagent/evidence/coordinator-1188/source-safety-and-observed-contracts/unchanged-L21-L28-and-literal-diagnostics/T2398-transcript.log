me_and(|path| temp_dirs.iter().any(|temp| path.starts_with(&temp.path)));\n00539|     if preserve_temp {\n00540|         for temp in temp_dirs {\n00541|             temp.preserve();\n00542|         }\n00543|     } else {\n00544|         drop(temp_dirs);\n00545|     }\n00546|     require_completed(\n00547|         completion_passed,\n00548|         status_success,\n00549|         &status_label,\n00550|         &resolved_command,\n00551|     )\n00552| }\n00553| \n00554| fn temp_scoped_path(root: &Path, relative: &str) -> Result<PathBuf, Box<dyn Error>> {\n00555|     let path = Path::new(relative);\n00556|     if path.as_os_str().is_empty() || path.is_absolute() {\n00557|         return Err(format!(\"temporary config path must be relative: {relative}\").into());\n00558|     }\n00559|     for component in path.components() {\n00560|         match component {\n00561|             Component::Normal(_) | Component::CurDir => {}\n00562|             Component::ParentDir | Component::RootDir | Component::Prefix(_) => {\n00563|                 return Err(format!(\"temporary config path escapes its root: {relative}\").into());\n00564|             }\n00565|         }\n00566|     }\n00567|     Ok(root.join(path))\n00568| }\n00569| \n00570| /// Render one client invocation from the seed-declared contract plus the\n00571| /// caller's parsed request.\n00572| ///\n00573| /// Every attempt goes through here, so a completion retry re-renders the same\n00574| /// option set with only the prompt substituted instead of rebuilding an argv\n00575| /// from the correction text alone.\n00576| fn build_invocation_args(\n00577|     integration: &ClientIntegration,\n00578|     caller: &CallerArgs,\n00579|     context: &RenderContext,\n00580|     options: InvocationOptions,\n00581|     orchestration_resume: Option<&str>,\n00582| ) -> Vec<String> {\n00583|     let invocation = &integration.invocation;\n00584|     let mut args = invocation\n00585|         .prepend_args\n00586|         .iter()\n00587|         .chain(invocation.args.iter())\n00588|         .map(|arg| render_template(arg, context))\n00589|         .collect::<Vec<_>>();\n00590|     if options.orchestration {\n00591|         for (from, to) in &invocation.orchestration_arg_replacements {\n00592|             let rendered_from = render_template(from, context);\n00593|             if let Some(argument) = args.iter_mut().find(|argument| **argument == rendered_from) {\n00594|                 *argument = render_template(to, context);\n00595|             }\n00596|         }\n00597|     }\n00598|     // A request with no text still runs headless when stdin is a pipe: the\n00599|     // prompt arrives on stdin, so injecting the client's interactive flags\n00600|     // would hang a scripted invocation.\n00601|     let interactive = options.force_interactive\n00602|         || (!options.force_non_interactive && !caller.has_text() && options.stdin_is_terminal);\n00603|     let mode_args: &[String] =\n00604|         if interactive && invocation.interactive_args_require_prompt && caller.prompt().is_none() {\n00605|             &[]\n00606|         } else if interactive {\n00607|             &invocation.interactive_args\n00608|         } else {\n00609|             &invocation.non_interactive_args\n00610|         };\n00611|     let rendered_mode_args = mode_args\n00612|         .iter()\n00613|         .map(|arg| render_template(arg, context))\n00614|         .collect::<Vec<_>>();\n00615|     if invocation.mode_arg_position == Some(ModeArgPosition::BeforeInvocation) {\n00616|         args.splice(0..0, rendered_mode_args.iter().cloned());\n00617|     }\n00618|     if !options.keep_summarization {\n00619|         args.extend(\n00620|             invocation\n00621|                 .no_summarize_args\n00622|                 .iter()\n00623|                 .map(|arg| render_template(arg, context)),\n00624|         );\n00625|     }\n00626|     let caller_options = caller.options();\n00627|     let mut effective_user_args = Vec::new();\n00628|     if options.orchestration {\n00629|         effective_user_args.extend(overlay_args(\n00630|             &invocation.orchestration_args,\n00631|             caller,\n00632|             context,\n00633|         ));\n00634|     }\n00635|     if let Some(session_id) = orchestration_resume {\n00636|         effective_user_args.extend(\n00637|             invocation\n00638|                 .resume_args\n00639|                 .iter()\n00640|                 .map(|argument| argument.replace(concat!(\"{\", \"session_id\", \"}\"), session_id)),\n00641|         );\n00642|     }\n00643|     effective_user_args.extend(caller_options.iter().cloned());\n00644|     if invocation.mode_arg_position != Some(ModeArgPosition::BeforeInvocation) {\n00645|         effective_user_args.extend(rendered_mode_args);\n00646|     }\n00647|     if let Some(prompt) = caller.prompt() {\n00648|         effective_user_args.push(prompt.to_owned());\n00649|     }\n00650|     if invocation.model_arg.is_empty() || contains_model_arg(&caller_options) {\n00651|         args.extend(effective_user_args);\n00652|         return args;\n00653|     }\n00654| \n00655|     let model_arg = render_template(&invocation.model_arg, context);\n00656|     let model_value = context.model_selector.clone();\n00657|     match invocation.model_arg_position {\n00658|         Some(ModelArgPosition::AfterFirstArg)\n00659|             if invocation.mode_arg_position == Some(ModeArgPosition::BeforeInvocation)\n00660|                 && !args.is_empty() =>\n00661|         {\n00662|             args.insert(1, model_value);\n00663|             args.insert(1, model_arg);\n00664|             args.extend(effective_user_args);\n00665|         }\n00666|         Some(ModelArgPosition::AfterFirstArg) if !effective_user_args.is_empty() => {\n00667|             args.push(effective_user_args[0].clone());\n00668|             args.push(model_arg);\n00669|             args.push(model_value);\n00670|             args.ext