   00001| #!/usr/bin/env node
   00002| // Generate data/meta/debug-stage-sources.lino (issue #667, R383): for every
   00003| // solver event kind that becomes a stage of a turn (js/server/solver-trace.mjs
   00004| // `thinkingStepsFromEvents`, the port of rust/src/event_log.rs
   00005| // `thinking_steps_for_answer`), the functions that append it in the Rust
   00006| // solver and in the JavaScript server's solver chain. The step-through debug
   00007| // session reads the table to name the code behind each stage
   00008| // (js/server/debug-stage-sources.mjs, rust/src/server/debug_stage_sources.rs).
   00009| //
   00010| // An append site is a call that names its kind as a string literal, or as a
   00011| // string constant of the same file:
   00012| //   - Rust: `<log>.append("<kind>", …)`;
   00013| //   - JavaScript: `solverEvent("<kind>", …)` and `<log>.push({ kind: "<kind>", … })`.
   00014| // Its function is the nearest enclosing definition (`fn` / `function`) that is
   00015| // less indented than the call. Sites are listed once per function, sorted.
   00016| //
   00017| // Usage:
   00018| //   node scripts/generate-debug-stage-sources.mjs --write   regenerate the table
   00019| //   node scripts/generate-debug-stage-sources.mjs --check   fail when the committed
   00020| //                                                           table drifts (CI gate)
   00021| 
   00022| import { writeFileSync } from 'node:fs';
   00023| import path from 'node:path';
   00024| 
   00025| import { STAGE_SOURCES, definedName, readText, treeFiles } from '../js/server/debug-stage-sources.mjs';
   00026| import { REPO_ROOT } from '../js/server/lino.mjs';
   00027| import { thinkingStepsFromEvents } from '../js/server/solver-trace.mjs';
   00028| 
   00029| /** The runtimes: where their solver code lives and where a solve starts. */
   00030| const RUNTIMES = [
   00031|   {
   00032|     name: 'rust',
   00033|     keyword: 'fn',
   00034|     trees: [{ path: 'rust/src', extension: '.rs' }],
   00035|     // Every protocol turn is solved here (`solve_with_history`).
   00036|     entries: [{ path: 'rust/src/solver.rs', symbol: 'solve_with_history_probability_store_and_intent_cache' }],
   00037|     sites: [/\.append\(\s*("[^"\\]*"|[A-Z][A-Z0-9_]*)\s*,/g],
   00038|     constant: /^\s*(?:pub(?:\([a-z]+\))?\s+)?const ([A-Z][A-Z0-9_]*): &str = ("[^"\\]*");/,
   00039|   },
   00040|   {
   00041|     name: 'js',
   00042|     keyword: 'function',
   00043|     trees: [
   00044|       { path: 'js/worker', extension: '.js' },
   00045|       { path: 'js/agentic/crate', extension: '.mjs' },
   00046|       { path: 'js/server', extension: '.mjs' },
   00047|     ],
   00048|     // The JavaScript server's native log (js/server/solve.mjs `solveSymbolic`).
   00049|     entries: [{ path: 'js/server/solver-log.mjs', symbol: 'nativeSolverLog' }],
   00050|     sites: [
   00051|       /solverEvent\(\s*("[^"\\]*"|'[^'\\]*'|[A-Z][A-Z0-9_]*)\s*,/g,
   00052|       /\.push\(\s*\{\s*kind:\s*("[^"\\]*"|'[^'\\]*'|[A-Z][A-Z0-9_]*)\s*,/g,
   00053|     ],
   00054|     constant: /^\s*(?:export\s+)?const ([A-Z][A-Z0-9_]*) = ("[^"\\]*"|'[^'\\]*');/,
   00055|   },
   00056| ];
   00057| 
   00058| const HEADER = `# Which functions emit each stage of a debugged turn (issue #667, R383).
   00059| #
   00060| # Generated by scripts/generate-debug-stage-sources.mjs from the source tree;
   00061| # do not edit by hand (CI runs it with --check). For every solver event kind
   00062| # that becomes a thinking step (\`step\`), the functions that append it in each
   00063| # runtime, and each runtime's source trees and solver entry. The step-through
   00064| # debug session (js/server/debug-stage-sources.mjs, Rust twin
   00065| # rust/src/server/debug_stage_sources.rs) picks one per stage: the only one,
   00066| # else the one fewest calls from the turn's routed handler, else from the entry.
   00067| `;
   00068| 
   00069| const unquote = (token) => token.replace(/^["'](.*)["']$/, '$1');
   00070| 
   00071| /** The line index of character `offset` in `text`. */
   00072| const lineAt = (text, offset) => text.slice(0, offset).split('\n').length - 1;
   00073| 
   00074| /** The nearest enclosing definition of line `index`: less indented, at or above it. */
   00075| function enclosing(lines, index, keyword) {
   00076|   const indent = lines[index].length - lines[index].trimStart().length;
   00077|   for (let at = index; at >= 0; at -= 1) {
   00078|     const name = definedName(lines[at], keyword);
   00079|     if (name && lines[at].length - lines[at].trimStart().length < indent) return name;
   00080|   }
   00081|   return null;
   00082| }
   00083| 
   00084| /** Every `(kind, path, symbol)` append site of one runtime. */
   00085| function appendSites(runtime) {
   00086|   const sites = [];
   00087|   for (const tree of runtime.trees) {
   00088|     for (const file of treeFiles(REPO_ROOT, tree.path, tree.extension)) {
   00089|       const text = readText(REPO_ROOT, file) ?? '';
   00090|       const lines = text.split('\n');
   00091|       const constants = new Map();
   00092|       for (const line of lines) {
   00093|         const match = runtime.constant.exec(line);
   00094|         if (match) constants.set(match[1], unquote(match[2]));
   00095|       }
   00096|       for (const pattern of runtime.sites) {
   00097|         for (const match of text.matchAll(pattern)) {
   00098|           const kind = /^["']/.test(match[1]) ? unquote(match[1]) : constants.get(match[1]);
   00099|           const symbol = kind ? enclosing(lines, lineAt(text, match.index), runtime.keyword) : null;
   00100|           if (symbol) sites.push({ kind, path: file, symbol });
   00101|         }
   00102|       }
   00103|     }
   00104|   }
   00105|   return sites;
   00106| }
   00107| 
   00108| /** The thinking step an event kind becomes, or null when curation drops it. */
   00109| function stepFor(kind) {
   00110|   const steps = thinkingStepsFromEvents([{ kind, payload: kind }], kind);
   00111|   return steps.find((step) => step.source_event === kind)?.step ?? null;
   00112| }
   00113| 
   00114| export function renderStageSources() {
   00115|   const out = [HEADER.trimEnd(), 'debug_stage_sources'];
   00116|   const events = new Map();
   00117|   for (const runtime of RUNTIMES) {
   00118|     out.push(`  runtime ${runtime.name}`, `    keyword ${runtime.keyword}`);
   00119|     for (const tree of runtime.trees) out.push(`    tree "${tree.path}" "${tree.extension}"`);
   00120|     for (const entry of runtime.entries) out.push(`    entry "${entry.path}" ${entry.symbol}`);
   00121|     for (const site of appendSites(runtime)) {
   00122|       if (!events.has(site.kind)) events.set(site.kind, new Map());
   00123|       const rows = events.get(site.kind);
   00124|       if (!rows.has(runtime.name)) rows.set(runtime.name, new Set());
   00125|       rows.get(runtime.name).add(`"${site.path}" ${site.symbol}`);
   00126|     }
   00127|   }
   00128|   for (const kind of [...events.keys()].sort()) {
   00129|     const step = stepFor(kind);
   00130|     if (!step) continue;
   00131|     out.push(`  event "${kind}"`, `    step ${step}`);
   00132|     for (const runtime of RUNTIMES) {
   00133|       for (const row of [...(events.get(kind).get(runtime.name) ?? [])].sort()) out.push(`    ${runtime.name} ${row}`);
   00134|     }
   00135|   }
   00136|   return `${out.join('\n')}\n`;
   00137| }
   00138| 
   00139| if (import.meta.url === `file://${process.argv[1]}`) {
   00140|   const mode = process.argv[2];
   00141|   if (mode !== '--write' && mode !== '--check') {
   00142|     console.error('usage: node scripts/generate-debug-stage-sources.mjs --write|--check');
   00143|     process.exit(2);
   00144|   }
   00145|   const text = renderStageSources();
   00146|   if (readText(REPO_ROOT, STAGE_SOURCES) !== text) {
   00147|     if (mode === '--write') {
   00148|       writeFileSync(path.join(REPO_ROOT, STAGE_SOURCES), text);
   00149|       console.log(`${STAGE_SOURCES} written`);
   00150|     } else {
   00151|       console.error(`::error file=${STAGE_SOURCES}::${STAGE_SOURCES} drifted from the source tree; run node scripts/generate-debug-stage-sources.mjs --write`);
   00152|       process.exit(1);
   00153|     }
   00154|   } else {
   00155|     console.log(`${STAGE_SOURCES} is current`);
   00156|   }
   00157| }
