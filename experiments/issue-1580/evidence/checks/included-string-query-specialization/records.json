[
  {
    "name": "retained-producer-inverse",
    "argv": [
      "node",
      "--input-type=module",
      "-e",
      "import fs from 'node:fs';import assert from 'node:assert/strict';import YAML from 'yaml';import {execFileSync} from 'node:child_process';import {createHash} from 'node:crypto';\nconst file='data/benchmarks/fast-pull-request-retained-jobs.json';\nconst old=YAML.parse(execFileSync('git',['show','HEAD:.github/workflows/security.yml'],{encoding:'utf8'})).jobs.codeql;\nconst current=YAML.parse(fs.readFileSync('.github/workflows/security.yml','utf8')).jobs.codeql;\nconst payload=job=>({steps:job.steps,uses:job.uses,with:job.with,strategy:job.strategy});\nconst reverted=structuredClone(current), steps=reverted.steps.filter(step=>step.name==='Observe included Rust string payloads');assert.equal(steps.length,1);\nassert.equal(steps[0]['timeout-minutes'],4);assert.equal(steps[0].if,\"${{ github.job == 'codeql-readonly' && matrix.language == 'rust' && inputs.macro-contexts }}\");\nsteps[0].run=steps[0].run.replace(' --trace-evaluation','');assert.deepEqual(reverted,old);\nconst manifest=JSON.parse(fs.readFileSync(file,'utf8')), rows=manifest.jobs.filter(row=>row.file==='security.yml'&&row.id==='codeql');assert.equal(rows.length,1);\nconst hash=job=>createHash('sha256').update(JSON.stringify(payload(job))).digest('hex');assert.equal(rows[0].payloadSha256,hash(old));rows[0].payloadSha256=hash(current);\nfs.writeFileSync(file,JSON.stringify(manifest,null,2)+'\\n');console.log(JSON.stringify({onlyInvestigationTraceArgumentAdded:true,timeoutUnchanged:true,productionAdmissionUnchanged:true,payloadSha256:rows[0].payloadSha256}));"
    ],
