+{"parentUuid":"7eb3e1cf-5176-4067-be38-8c2f740e6836","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/tmp/gh-issue-solver-1784464066233/scripts/self-hosting-metric.rs","snippet":"1\t//! Deterministically measure release work backed by committed Formal AI sessions.\n2\t//!\n3\t//! Run with `rust-script scripts/self-hosting-metric.rs --since <tag>`. A commit\n4\t//! is attributed only when it records both of these Git trailers:\n5\t//!\n6\t//! - `Formal-AI-Session: <session-id>`\n7\t//! - `Formal-AI-Evidence: <repo-relative-path>`\n8\t//!\n9\t//! The evidence must exist in that commit and contain both `formal-ai` and the\n10\t//! recorded session id. Changed lines are additions plus deletions reported by\n11\t//! `git show --numstat`; merge commits and binary files do not contribute.\n12\t\n13\t#![allow(dead_code)]\n14\t\n15\tuse std::env;\n16\tuse std::fs::{self, OpenOptions};\n17\tuse std::io::Write;\n18\tuse std::path::{Component, Path, PathBuf};\n19\tuse std::process::Command;\n20\t\n21\tconst SESSION_TRAILER: &str = \"Formal-AI-Session\";\n22\tconst EVIDENCE_TRAILER: &str = \"Formal-AI-Evidence\";\n23\tconst DEFAULT_LEDGER: &str = \"data/meta/self-hosting-ledger.lino\";\n24\tconst DEFAULT_TRAILING_WINDOW: usize = 3;\n25\t\n26\t#[derive(Clone, Debug, Eq, PartialEq)]\n27\tpub struct Measurement {\n28\t    pub self_authored_lines: u64,\n29\t    pub changed_lines: u64,\n30\t    pub self_authored_commits: u64,\n31\t    pub commits: u64,\n32\t    pub percentage_basis_points: u64,\n33\t}\n34\t\n35\t#[derive(Clone, Debug, Eq, PartialEq)]\n36\tpub struct ReleaseRow {\n37\t    pub tag: String,\n38\t    pub since: String,\n39\t    pub until: String,\n40\t    pub self_authored_lines: u64,\n41\t    pub changed_lines: u64,\n42\t    pub self_authored_commits: u64,\n43\t    pub commits: u64,\n44\t    pub percentage_basis_points: u64,\n45\t    pub trailing_window: usize,\n46\t    pub trailing_percentage_basis_points: u64,\n47\t}\n48\t\n49\tpub fn format_percentage(basis_points: u64) -> String {\n50\t    format!(\"{}.{:02}%\", basis_points / 100, basis_points % 100)\n51\t}\n52\t\n53\tpub fn measure(repo: &Path, since: &str, until: &str) -> Result<Measurement, String> {\n54\t    let range = format!(\"{since}..{until}\");\n55\t    let output = git(repo, &[\"rev-list\", \"--reverse\", \"--no-merges\", &range])?;\n56\t    let commits = output\n57\t        .lines()\n58\t        .filter(|line| !line.is_empty())\n59\t        .collect::<Vec<_>>();\n60\t    let mut changed_lines = 0_u64;\n61\t    let mut self_authored_lines = 0_u64;\n62\t    let mut self_authored_commits = 0_u64;\n63\t\n64\t    for commit in &commits {\n65\t        let lines = changed_lines_for_commit(repo, commit)?;\n66\t        changed_lines = changed_lines\n67\t            .checked_add(lines)\n68\t            .ok_or_else(|| \"changed-line total overflowed u64\".to_owned())?;\n69\t        if commit_has_formal_ai_evidence(repo, commit)? {\n70\t            self_authored_lines = self_authored_lines\n71\t                .checked_add(lines)\n72\t                .ok_or_else(|| \"self-authored line total overflowed u64\".to_owned())?;\n73\t            self_authored_commits += 1;\n74\t        }\n75\t    }\n76\t\n77\t    Ok(Measurement {\n78\t        self_authored_lines,\n79\t        changed_lines,\n80\t        self_authored_commits,\n81\t        commits: commits.len() as u64,\n82\t        percentage_basis_points: percentage_basis_points(self_authored_lines, changed_lines),\n83\t    })\n84\t}\n85\t\n86\tfn changed_lines_for_commit(repo: &Path, commit: &str) -> Result<u64, String> {\n87\t    let output = git(\n88\t        repo,\n89\t        &[\"show\", \"--format=\", \"--numstat\", \"--no-renames\", commit],\n90\t    )?;\n91\t    output.lines().try_fold(0_u64, |total, line| {\n92\t        let mut fields = line.split('\\t');\n93\t        let additions = fields.next().unwrap_or_default();\n94\t        let deletions = fields.next().unwrap_or_default();\n95\t        if additions == \"-\" || deletions == \"-\" {\n96\t            return Ok(total);\n97\t        }\n98\t        let additions = additions\n99\t            .parse::<u64>()\n100\t            .map_err(|error| format!(\"invalid numstat additions in {commit}: {error}\"))?;\n101\t        let deletions = deletions\n102\t            .parse::<u64>()\n103\t            .map_err(|error| format!(\"invalid numstat deletions in {commit}: {error}\"))?;\n104\t        total\n105\t            .checked_add(additions)\n106\t            .and_then(|sum| sum.checked_add(deletions))\n107\t            .ok_or_else(|| format!(\"changed-line count overflowed in {commit}\"))\n108\t    })\n109\t}\n110\t\n111\tfn commit_has_formal_ai_evidence(repo: &Path, commit: &str) -> Result<bool, String> {\n112\t    let sessions = trailer_values(repo, commit, SESSION_TRAILER)?;\n113\t    let evidence_paths = trailer_values(repo, commit, EVIDENCE_TRAILER)?;\n114\t    if sessions.is_empty() && evidence_paths.is_empty() {\n115\t        return Ok(false);\n116\t    }\n117\t    if sessions.is_empty() || evidence_paths.is_empty() {\n118\t        return Err(format!(\n119\t            \"commit {commit} must record both {SESSION_TRAILER} and {EVIDENCE_TRAILER}\"\n120\t        ));\n121\t    }\n122\t\n123\t    let mut evidence = Vec::with_capacity(evidence_paths.len());\n124\t    for path in evidence_paths {\n125\t        validate_evidence_path(&path)?;\n126\t        let object = format!(\"{commit}:{path}\");\n127\t        let content = git(repo, &[\"show\", &object])?;\n128\t        if !content.to_ascii_lowercase().contains(\"formal-ai\") {\n129\t            return Err(format!(\n130\t                \"evidence {path} in commit {commit} does not identify formal-ai\"\n131\t            ));\n132\t        }\n133\t        evidence.push((path, content));\n134\t    }\n135\t\n136\t    for session in sessions {\n137\t        if !evidence\n138\t            .iter()\n139\t            .any(|(_, content)| content.contains(&session))\n140\t        {\n141\t            return Err(format!(\n142\t                \"no committed {EVIDENCE_TRAILER} in {commit} records session {session}\"\n143\t            ));\n144\t        }\n145\t    }\n146\t    Ok(true)\n147\t}\n148\t\n149\tfn trailer_values(repo: &Path, commit: &str, key: &str) -> Result<Vec<String>, String> {\n150\t    let format = format!(\"%(trailers:key={key},valueonly,separator=%x1f)\");\n151\t    let format_arg = format!(\"--format={format}\");\n152\t    let output = git(repo, &[\"show\", \"-s\", &format_arg, commit])?;\n153\t    Ok(output\n154\t        .trim()\n155\t        .split('\\x1f')\n156\t        .map(str::trim)\n157\t        .filter(|value| !value.is_empty())\n158\t        .map(str::to_owned)\n159\t        .collect())\n160\t}\n161\t\n162\tfn validate_evidence_path(path: &str) -> Result<(), String> {\n163\t    let candidate = Path::new(path);\n164\t    if path.contains(':')\n165\t        || path.contains('\\n')\n166\t        || candidate.is_absolute()\n167\t        || candidate\n168\t            .components()\n169\t            .any(|component| !matches!(component, Component::Normal(_)))\n170\t    {\n171\t        return Err(format!(\n172\t            \"{EVIDENCE_TRAILER} must be a normal repo-relative path: {path}\"\n173\t        ));\n174\t    }\n175\t    Ok(())\n176\t}\n177\t\n178\tfn percentage_basis_points(numerator: u64, denominator: u64) -> u64 {\n179\t    if denominator == 0 {\n180\t        return 0;\n181\t    }\n182\t    let rounded =\n183\t        (u128::from(numerator) * 10_000 + u128::from(denominator) / 2) / u128::from(denominator);\n184\t    u64::try_from(rounded).expect(\"percentage basis points fit in u64\")\n185\t}\n186\t\n187\tpub fn record_release(\n188\t    repo: &Path,\n189\t    ledger: &Path,\n190\t    tag: &str,\n191\t    since: &str,\n192\t    until: &str,\n193\t    trailing_window: usize,\n194\t) -> Result<ReleaseRow, String> {\n195\t    if trailing_window == 0 {\n196\t        return Err(\"trailing window must be greater than zero\".to_owned());\n197\t    }\n198\t    let rows = read_release_rows(ledger)?;\n199\t    let measurement = measure(repo, since, until)?;\n200\t    let until_commitish = format!(\"{until}^{{commit}}\");\n201\t    let canonical_until = git(repo, &[\"rev-parse\", &until_commitish])?\n202\t        .trim()\n203\t        .to_owned();\n204\t    let mut window_rows = rows\n205\t        .iter()\n206\t        .rev()\n207\t        .take(trailing_window.saturating_sub(1))\n208\t        .cloned()\n209\t        .collect::<Vec<_>>();\n210\t    window_rows.reverse();\n211\t    let mut row = ReleaseRow {\n212\t        tag: tag.to_owned(),\n213\t        since: since.to_owned(),\n214\t        until: canonical_until,\n215\t        self_authored_lines: measurement.self_authored_lines,\n216\t        changed_lines: measurement.changed_lines,\n\n... [244 lines truncated] ..."},"type":"attachment","uuid":"c2c42a9b-349b-44d1-93d7-f4e65c453375","timestamp":"2026-07-19T12:41:47.196Z","userType":"external","entrypoint":"sdk-cli","cwd":"/tmp/gh-issue-solver-1784464066233","sessionId":"b7b0a7df-eaec-4996-8eac-65c1201e46d2","version":"2.1.214","gitBranch":"issue-796-9da6718935fa"}
