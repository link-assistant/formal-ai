bview\",\n          \"id\": \"formal-ai.chatView\",\n          \"name\": \"Chat\"\n        }\n      ]\n    },\n    \"menus\": {\n      \"view/title\": [\n        {\n          \"command\": \"formal-ai.toggleServer\",\n          \"when\": \"view == formal-ai.chatView\",\n          \"group\": \"navigation@1\"\n        },\n        {\n          \"command\": \"formal-ai.openNetworkView\",\n          \"when\": \"view == formal-ai.chatView\",\n          \"group\": \"navigation@2\"\n        }\n      ]\n    },\n    \"configuration\": {\n      \"title\": \"formal-ai\",\n      \"properties\": {\n        \"formal-ai.server.enabled\": {\n          \"type\": \"boolean\",\n          \"default\": false,\n          \"markdownDescription\": \"Start a local OpenAI-compatible `formal-ai serve` process and route chat through `POST /v1/chat/completions`. Desktop (Node) host only; ignored in the web host, which always runs the in-process symbolic agent.\"\n        },\n        \"formal-ai.server.host\": {\n          \"type\": \"string\",\n          \"default\": \"127.0.0.1\",\n          \"description\": \"Loopback host the local server binds to (desktop host only).\"\n        },\n        \"formal-ai.server.port\": {\n          \"type\": \"number\",\n          \"default\": 18080,\n          \"minimum\": 1,\n          \"maximum\": 65535,\n          \"description\": \"Port the local server binds to (desktop host only).\"\n        },\n        \"formal-ai.docker.image\": {\n          \"type\": \"string\",\n          \"default\": \"konard/box-dind:2.1.1\",\n          \"description\": \"Docker image used to sandbox code-execution tool calls (desktop host only, when a permitted tool runs).\"\n        },\n        \"formal-ai.tools.allowByDefault\": {\n          \"type\": \"boolean\",\n          \"default\": false,\n          \"description\": \"Grant write, edit, host shell, and sandboxed code-execution tool calls by default. Read-only file and web tools remain available when this is off.\"\n        