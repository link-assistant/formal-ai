-    branches:
-      - main
-    paths:
-      - '.github/**'
+    branches: [main]
+    paths: ['.github/**']
   pull_request:
-    types: [opened, synchronize, reopened]
-    paths:
-      - '.github/**'
-  workflow_dispatch:
+    paths: ['.github/**']
 
-# Least-privilege default; these jobs only read the checked-out tree.
+# Keep the workflow read-only unless a job explicitly needs an additional scope.
