[2026-08-15T18:03:05Z INFO  rust_script] input: File("assemble-requirements", "/tmp/gh-issue-solver-1786801324779/scripts/assemble-requirements.rs", "#!/usr/bin/env rust-script\n//! Assemble `REQUIREMENTS.md` from one shard per issue.\n//!\n//! Issue #991: `REQUIREMENTS.md` was the repository's worst append-only\n//! document. Every issue adds a `## Issue #N ...` section, every branch adds it\n//! at the end of the same file, and so two unrelated issues collide on the same\n//! end-of-file region. `scripts/analyze-merge-conflicts.py` counted 64 manual\n//! resolutions in this one file.\n//!\n//! The fix is to give each section its own file under `docs/requirements/` and\n//! make `REQUIREMENTS.md` a derived artifact. Two branches writing requirements\n//! for two different issues now create two different files and cannot conflict.\n//!\n//! Shards are assembled in a total order read entirely from the file name, so\n//! there is no shared index file to conflict on either:\n//!\n//! | prefix      | position | sorted by                             |\n//! | ----------- | -------- | ------------------------------------- |\n//! | `preamble-` | first    | file name                             |\n//! | `issue-`    | middle   | zero-padded issue number, then slug    |\n//! | `doctrine-` | last     | file name                             |\n//!\n//! Usage:\n//!   rust-script scripts/assemble-requirements.rs           # check REQUIREMENTS.md is current\n//!   rust-script scripts/assemble-requirements.rs --write   # rebuild REQUIREMENTS.md\n//!   rust-script scripts/assemble-requirements.rs --split   # re-shard REQUIREMENTS.md\n//!\n//! ```cargo\n//! [dependencies]\n//! ```\n\nuse std::fs;\nuse std::path::{Path, PathBuf};\n\n#[cfg(not(test))]\nconst DOCUMENT: &str = \"REQUIREMENTS.md\";\nconst SHARDS: &str = \"docs/requirements\";\nconst BANNER: &str = \"<!-- Generated by `rust-script scripts/assemble-requirements.rs --write` from `docs/requirements/`. Edit the shard for your issue, never this file: see `data/meta/merge-conflict-policy.lino`. -->\";\n\n/// Where a shard sits in the assembled document, read from its file name.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]\nenum Group {\n    Preamble,\n    Issue(u32),\n    Doctrine,\n}\n\n/// The total order of a shard: group first, then the file name inside it.\nfn shard_order(file_name: &str) -> Option<(Group, String)> {\n    let stem = file_name.strip_suffix(\".md\")?;\n    let group = if let Some(rest) = stem.strip_prefix(\"issue-\") {\n        let digits: String = rest.chars().take_while(char::is_ascii_digit).collect();\n        Group::Issue(digits.parse().ok()?)\n    } else if stem.starts_with(\"preamble-\") {\n        Group::Preamble\n    } else if stem.starts_with(\"doctrine-\") {\n        Group::Doctrine\n    } else {\n        return None;\n    };\n    Some((group, stem.to_string()))\n}\n\n/// The issue number a section heading claims, if it names one.\nfn heading_issue(heading: &str) -> Option<u32> {\n    let rest = heading.split_once(\"Issue #\")?.1;\n    let digits: String = rest.chars().take_while(char::is_ascii_digit).collect();\n    digits.parse().ok()\n}\n\n/// A file-name-safe slug for a section heading.\nfn slug(heading: &str) -> String {\n    let mut slug = String::new();\n    for character in heading.chars() {\n        if character.is_ascii_alphanumeric() {\n            slug.push(character.to_ascii_lowercase());\n        } else if !slug.ends_with('-') {\n            slug.push('-');\n        }\n    }\n    slug.trim_matches('-').to_string()\n}\n\n/// Split a document into its leading preamble and its `## ` sections.\nfn sections(document: &str) -> (String, Vec<String>) {\n    let mut preamble = String::new();\n    let mut sections: Vec<String> = Vec::new();\n    for line in document.lines() {\n        if line.starts_with(\"## \") {\n            sections.push(String::new());\n        }\n        let target = sections.last_mut().unwrap_or(&mut preamble);\n        target.push_str(line);\n        target.push('\\n');\n    }\n    (preamble, sections)\n}\n\n/// The shard file name for a section, derived from its heading.\nfn shard_name(heading: &str) -> String {\n    let title = heading.trim_start_matches('#').trim();\n    match heading_issue(heading) {\n        Some(issue) => {\n            let subject = title\n                .strip_prefix(&format!(\"Issue #{issue}\"))\n                .unwrap_or(title);\n            format!(\"issue-{issue:04}-{}.md\", slug(subject))\n        }\n        None => format!(\"doctrine-{}.md\", slug(title)),\n    }\n}\n\n/// Whether a markdown link target is resolved against the file that holds it.\n///\n/// An absolute URL, an in-page anchor, and a root-anchored path all mean the\n/// same thing wherever the text ends up, so only these are left untouched.\nfn is_document_relative(target: &str) -> bool {\n    !(target.is_empty()\n        || target.starts_with('#')\n        || target.starts_with('/')\n        || target.contains(\"://\")\n        || target.starts_with(\"mailto:\"))\n}\n\n/// Resolve `.` and `..` segments textually, without touching the filesystem.\nfn normalize(path: &str) -> String {\n    let mut parts: Vec<&str> = Vec::new();\n    for part in path.split('/') {\n        match part {\n            \"\" | \".\" => {}\n            \"..\" if matches!(parts.last(), Some(&last) if last != \"..\") => {\n                parts.pop();\n            }\n            other => parts.push(other),\n        }\n    }\n    parts.join(\"/\")\n}\n\n/// A shard's link target as the repository root sees it.\n///\n/// A shard is a document in its own right: it is read in an editor and rendered\n/// on its own page, so its links are written relative to `docs/requirements/`.\n/// `REQUIREMENTS.md` is assembled at the repository root, so the same target\n/// has to be rebased on the way in.\nfn to_root_relative(target: &str) -> String {\n    if !is_document_relative(target) {\n        return target.to_string();\n    }\n    normalize(&format!(\"{SHARDS}/{target}\"))\n}\n\n/// The inverse: a root document's link target as a shard has to write it.\nfn to_shard_relative(target: &str) -> String {\n    if !is_document_relative(target) {\n        return target.to_string();\n    }\n    let target = normalize(target);\n    let base: Vec<&str> = SHARDS.split('/').collect();\n    let parts: Vec<&str> = target.split('/').collect();\n    let shared = base\n        .iter()\n        .zip(&parts)\n        .take_while(|(left, right)| left == right)\n        .count();\n    let mut rebased: Vec<&str> = vec![\"..\"; base.len() - shared];\n    rebased.extend(&parts[shared..]);\n    // A link to the shard directory itself has nothing left to say once it is\n    // rebased into that directory; an empty target is a broken link, `.` is not.\n    if rebased.is_empty() {\n        return \".\".to_string();\n    }\n    rebased.join(\"/\")\n}\n\n/// Rewrite every markdown link target in `body` through `rebase`.\n///\n/// Only `](target)` is rewritten; a reference definition or an autolink names no\n/// relative path in this document, and a target holding a `)` is left alone\n/// rather than guessed at.\nfn rewrite_links(body: &str, rebase: &dyn Fn(&str) -> String) -> String {\n    let mut rewritten = String::with_capacity(body.len());\n    let mut rest = body;\n    while let Some(open) = rest.find(\"](\") {\n        let after = &rest[open + 2..];\n        let Some(close) = after.find(')') else {\n            break;\n        };\n        let (target, title) = match after[..close].split_once(char::is_whitespace) {\n            Some((target, title)) => (target, format!(\" {title}\")),\n            None => (&after[..close], String::new()),\n        };\n        rewritten.push_str(&rest[..open + 2]);\n        rewritten.push_str(&rebase(target));\n        rewritten.push_str(&title);\n        rewritten.push(')');\n        rest = &after[close + 1..];\n    }\n    rewritten.push_str(rest);\n    rewritten\n}\n\n/// Read the shard directory in assembly order.\nfn ordered_shards(directory: &Path) -> Result<Vec<PathBuf>, String> {\n    let mut shards: Vec<(Group, String, PathBuf)> = Vec::new();\n    let entries =\n        fs::read_dir(directory).map_err(|error| format!(\"cannot read {SHARDS}: {error}\"))?;\n    for entry in entries {\n        let path = entry.map_err(|error| error.to_string())?.path();\n        let Some(file_name) = path.file_name().and_then(|name| name.to_str()) else {\n            continue;\n        };\n        if !file_name.ends_with(\".md\") || file_name == \"README.md\" {\n            continue;\n        }\n        let (group, key) = shard_order(file_name).ok_or_else(|| {\n            format!(\n                \"{SHARDS}/{file_name} must start with `preamble-`, `issue-NNNN-` or `doctrine-`\"\n            )\n        })?;\n        shards.push((group, key, path));\n    }\n    shards.sort();\n    Ok(shards.into_iter().map(|(_, _, path)| path).collect())\n}\n\n/// The document the shards currently describe.\nfn assemble(shards: &[PathBuf]) -> Result<String, String> {\n    let mut document = format!(\"{BANNER}\\n\\n\");\n    for (index, shard) in shards.iter().enumerate() {\n        let body = fs::read_to_string(shard)\n            .map_err(|error| format!(\"cannot read {}: {error}\", shard.display()))?;\n        let body = rewrite_links(body.trim_end_matches('\\n'), &to_root_relative);\n        let body = body.as_str();\n        if index > 0 {\n            document.push('\\n');\n        }\n        document.push_str(body);\n        document.push('\\n');\n    }\n    Ok(document)\n}\n\n/// Every rule a shard directory has to satisfy.\nfn shard_violations(shards: &[PathBuf], read: &dyn Fn(&Path) -> String) -> Vec<String> {\n    let mut failures = Vec::new();\n    for shard in shards {\n        let name = shard\n            .file_name()\n            .and_then(|name| name.to_str())\n            .unwrap_or_default();\n        let body = read(shard);\n        let heading = body.lines().next().unwrap_or_default();\n        let Some(issue) = heading_issue(heading) else {\n            continue;\n        };\n        if !heading.starts_with(\"## \") {\n            continue;\n        }\n        if !name.starts_with(&format!(\"issue-{issue:04}-\")) {\n            failures.push(format!(\n                \"{SHARDS}/{name} starts with the heading `{heading}`, so it must be named \\\n                 `issue-{issue:04}-<slug>.md`\"\n            ));\n        }\n    }\n    failures\n}\n\n/// Every document-relative link target in `body`, anchors stripped.\nfn document_relative_targets(body: &str) -> Vec<String> {\n    let mut targets = Vec::new();\n    let mut rest = body;\n    while let Some(open) = rest.find(\"](\") {\n        let after = &rest[open + 2..];\n        let Some(close) = after.find(')') else {\n            break;\n        };\n        let target = after[..close]\n            .split_whitespace()\n            .next()\n            .unwrap_or_default()\n            .split('#')\n            .next()\n            .unwrap_or_default();\n        if is_document_relative(target) {\n            targets.push(target.to_string());\n        }\n        rest = &after[close + 1..];\n    }\n    targets\n}\n\n/// A shard's relative links have to resolve from the shard's own directory.\n///\n/// A shard is read on its own page as well as through the assembled document,\n/// and the repository's link checker reads it there. Checking it here names the\n/// shard that broke the link instead of reporting a path that exists nowhere.\nfn link_violations(\n    shards: &[PathBuf],\n    read: &dyn Fn(&Path) -> String,\n    exists: &dyn Fn(&Path) -> bool,\n) -> Vec<String> {\n    let mut failures = Vec::new();\n    for shard in shards {\n        let directory = shard.parent().unwrap_or(Path::new(\".\"));\n        let name = shard\n            .file_name()\n            .and_then(|name| name.to_str())\n            .unwrap_or_default();\n        for target in document_relative_targets(&read(shard)) {\n            if !exists(&directory.join(&target)) {\n                failures.push(format!(\n                    \"{SHARDS}/{name} links to `{target}`, which does not exist relative to \\\n                     {SHARDS}/. Write shard links relative to the shard; assembly rebases \\\n                     them to `{}`.\",\n                    to_root_relative(&target)\n                ));\n            }\n        }\n    }\n    failures\n}\n\n/// Write the current document out as one file per section.\n#[cfg(not(test))]\nfn split(root: &Path) -> Result<usize, String> {\n    let document = fs::read_to_string(root.join(DOCUMENT))\n        .map_err(|error| format!(\"cannot read {DOCUMENT}: {error}\"))?;\n    let document = document.strip_prefix(BANNER).unwrap_or(&document);\n    let (preamble, sections) = sections(document.trim_start());\n    let directory = root.join(SHARDS);\n    fs::create_dir_all(&directory).map_err(|error| error.to_string())?;\n\n    let mut written = 0;\n    let title = preamble.lines().next().unwrap_or(\"# Requirements\");\n    let name = format!(\"preamble-{}.md\", slug(title));\n    write_shard(\n        &directory.join(&name),\n        &rewrite_links(&preamble, &to_shard_relative),\n    )?;\n    written += 1;\n\n    for section in &sections {\n        let heading = section.lines().next().unwrap_or_default();\n        write_shard(\n            &directory.join(shard_name(heading)),\n            &rewrite_links(section, &to_shard_relative),\n        )?;\n        written += 1;\n    }\n    Ok(written)\n}\n\n#[cfg(not(test))]\nfn write_shard(path: &Path, body: &str) -> Result<(), String> {\n    if path.exists() {\n        return Err(format!(\n            \"{} already exists; two sections produced the same shard name\",\n            path.display()\n        ));\n    }\n    let body = format!(\"{}\\n\", body.trim_end_matches('\\n'));\n    fs::write(path, body).map_err(|error| format!(\"cannot write {}: {error}\", path.display()))\n}\n\n#[cfg(not(test))]\nfn main() {\n    let root = std::env::current_dir().expect(\"Failed to get current directory\");\n    let mode = std::env::args().nth(1).unwrap_or_default();\n\n    if mode == \"--split\" {\n        match split(&root) {\n            Ok(written) => {\n                println!(\"\\nWrote {written} shard(s) to {SHARDS}/.\\n\");\n                return;\n            }\n            Err(error) => {\n                println!(\"::error::{error}\");\n                std::process::exit(1);\n            }\n        }\n    }\n\n    let shards = ordered_shards(&root.join(SHARDS)).unwrap_or_else(|error| {\n        println!(\"::error::{error}\");\n        std::process::exit(1);\n    });\n    let read = |path: &Path| fs::read_to_string(path).unwrap_or_default();\n    let mut failures = shard_violations(&shards, &read);\n    failures.extend(link_violations(&shards, &read, &|path| path.exists()));\n    if !failures.is_empty() {\n        for failure in &failures {\n            println!(\"::error::{failure}\");\n        }\n        std::process::exit(1);\n    }\n\n    let assembled = assemble(&shards).unwrap_or_else(|error| {\n        println!(\"::error::{error}\");\n        std::process::exit(1);\n    });\n    let document = root.join(DOCUMENT);\n    let current = fs::read_to_string(&document).unwrap_or_default();\n\n    if mode == \"--write\" {\n        if current == assembled {\n            println!(\"\\n{DOCUMENT} is already current ({} shards).\\n\", shards.len());\n        } else {\n            fs::write(&document, &assembled).expect(\"Failed to write REQUIREMENTS.md\");\n            println!(\"\\nRebuilt {DOCUMENT} from {} shards.\\n\", shards.len());\n        }\n        return;\n    }\n\n    println!(\"\\nChecking {DOCUMENT} against {SHARDS}/ ({} shards)...\\n\", shards.len());\n    if current == assembled {\n        println!(\"{DOCUMENT} matches its shards.\\n\");\n        return;\n    }\n    println!(\"::error::{DOCUMENT} does not match {SHARDS}/.\");\n    println!(\"\\nRun: rust-script scripts/assemble-requirements.rs --write\\n\");\n    std::process::exit(1);\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn the_preamble_sorts_first_then_issues_by_number_then_doctrine() {\n        let mut names = vec![\n            \"doctrine-compiled-logic.md\",\n            \"issue-0991-how-to-synthesis.md\",\n            \"preamble-requirements-for-issue-1.md\",\n            \"issue-0016-multilingual.md\",\n            \"issue-0016-follow-up.md\",\n        ];\n        names.sort_by_key(|name| shard_order(name).expect(\"named correctly\"));\n        assert_eq!(\n            names,\n            [\n                \"preamble-requirements-for-issue-1.md\",\n                \"issue-0016-follow-up.md\",\n                \"issue-0016-multilingual.md\",\n                \"issue-0991-how-to-synthesis.md\",\n                \"doctrine-compiled-logic.md\",\n            ]\n        );\n    }\n\n    #[test]\n    fn issue_numbers_order_numerically_not_lexicographically() {\n        assert!(shard_order(\"issue-0016-a.md\") < shard_order(\"issue-0117-a.md\"));\n        assert!(shard_order(\"issue-0991-a.md\") < shard_order(\"issue-1000-a.md\"));\n    }\n\n    #[test]\n    fn an_unprefixed_shard_name_is_rejected() {\n        assert_eq!(shard_order(\"current-scope-boundary.md\"), None);\n        assert_eq!(shard_order(\"issue-0991-notes.txt\"), None);\n    }\n\n    #[test]\n    fn a_heading_names_the_first_issue_it_mentions() {\n        assert_eq!(\n            heading_issue(\"## Issue #16 Follow-Up: Universal Data/Seed (PR #17 reopen)\"),\n            Some(16)\n        );\n        assert_eq!(\n            heading_issue(\"## Issue #398 PR Review Standards (comment 4663407299)\"),\n            Some(398)\n        );\n        assert_eq!(heading_issue(\"## Current Scope Boundary\"), None);\n    }\n\n    #[test]\n    fn a_shard_name_is_derived_from_its_heading() {\n        assert_eq!(\n            shard_name(\"## Issue #991 Dynamic Multi-Source How-To Synthesis\"),\n            \"issue-0991-dynamic-multi-source-how-to-synthesis.md\"\n        );\n        assert_eq!(\n            shard_name(\"## Standing Doctrine: Compiled Logic (2026-08-04)\"),\n            \"doctrine-standing-doctrine-compiled-logic-2026-08-04.md\"\n        );\n    }\n\n    #[test]\n    fn splitting_keeps_the_preamble_apart_from_the_sections() {\n        let (preamble, sections) = sections(\"# Title\\n\\nIntro.\\n\\n## One\\n\\na\\n\\n## Two\\n\\nb\\n\");\n        assert_eq!(preamble, \"# Title\\n\\nIntro.\\n\\n\");\n        assert_eq!(sections, [\"## One\\n\\na\\n\\n\", \"## Two\\n\\nb\\n\"]);\n    }\n\n    #[test]\n    fn assembly_separates_sections_by_exactly_one_blank_line() {\n        let directory = std::env::temp_dir().join(\"assemble-requirements-blank-lines\");\n        let _ = fs::remove_dir_all(&directory);\n        fs::create_dir_all(&directory).expect(\"temp dir\");\n        fs::write(directory.join(\"preamble-a.md\"), \"# Title\\n\\nIntro.\\n\").expect(\"write\");\n        fs::write(directory.join(\"issue-0002-b.md\"), \"## Issue #2\\n\\nb\\n\\n\\n\").expect(\"write\");\n        let shards = ordered_shards(&directory).expect(\"ordered\");\n        assert_eq!(\n            assemble(&shards).expect(\"assembled\"),\n            format!(\"{BANNER}\\n\\n# Title\\n\\nIntro.\\n\\n## Issue #2\\n\\nb\\n\")\n        );\n        let _ = fs::remove_dir_all(&directory);\n    }\n\n    #[test]\n    fn a_shard_link_is_rebased_to_the_repository_root_and_back() {\n        for (shard, root) in [\n            (\"../upload-memory.md\", \"docs/upload-memory.md\"),\n            (\"../design/coverage-ratchet.md\", \"docs/design/coverage-ratchet.md\"),\n            (\n                \"../requirements-traceability.md\",\n                \"docs/requirements-traceability.md\",\n            ),\n            (\"../../scripts/close-total.py\", \"scripts/close-total.py\"),\n            (\"issue-0709-fusion.md\", \"docs/requirements/issue-0709-fusion.md\"),\n        ] {\n            assert_eq!(to_root_relative(shard), root, \"{shard} assembles to {root}\");\n            assert_eq!(to_shard_relative(root), shard, \"{root} shards to {shard}\");\n        }\n    }\n\n    #[test]\n    fn a_link_to_the_shard_directory_itself_stays_a_link() {\n        assert_eq!(to_shard_relative(SHARDS), \".\");\n    }\n\n    #[test]\n    fn a_link_that_means_the_same_thing_everywhere_is_left_alone() {\n        for target in [\n            \"https://example.org/a.md\",\n            \"#an-anchor\",\n            \"/docs/absolute.md\",\n            \"mailto:someone@example.org\",\n        ] {\n            assert_eq!(to_root_relative(target), target);\n            assert_eq!(to_shard_relative(target), target);\n        }\n    }\n\n    #[test]\n    fn rewriting_touches_the_target_and_nothing_else() {\n        let shard = \"See [`docs/upload-memory.md`](../upload-memory.md) and \\\n                     [the spec](https://example.org) (a note) — cost: $1 (approx).\\n\";\n        let root = \"See [`docs/upload-memory.md`](docs/upload-memory.md) and \\\n                    [the spec](https://example.org) (a note) — cost: $1 (approx).\\n\";\n        assert_eq!(rewrite_links(shard, &to_root_relative), root);\n        assert_eq!(rewrite_links(root, &to_shard_relative), shard);\n    }\n\n    #[test]\n    fn a_link_title_survives_rewriting() {\n        assert_eq!(\n            rewrite_links(\"[a](../b.md \\\"Title\\\")\", &to_root_relative),\n            \"[a](docs/b.md \\\"Title\\\")\"\n        );\n    }\n\n    #[test]\n    fn a_shard_link_that_resolves_only_from_the_repository_root_fails() {\n        let shards = [PathBuf::from(\"docs/requirements/issue-0018-memory.md\")];\n        let read = |_path: &Path| \"## Issue #18\\n\\nSee [it](docs/upload-memory.md).\\n\".to_string();\n        let exists = |path: &Path| path == Path::new(\"docs/upload-memory.md\");\n        let failures = link_violations(&shards, &read, &exists);\n        assert_eq!(failures.len(), 1, \"{failures:?}\");\n        assert!(failures[0].contains(\"docs/upload-memory.md\"), \"{failures:?}\");\n    }\n\n    #[test]\n    fn a_shard_link_that_resolves_from_the_shard_passes() {\n        let shards = [PathBuf::from(\"docs/requirements/issue-0018-memory.md\")];\n        let read = |_path: &Path| \"## Issue #18\\n\\nSee [it](../upload-memory.md#top).\\n\".to_string();\n        let exists = |path: &Path| path == Path::new(\"docs/requirements/../upload-memory.md\");\n        assert!(link_violations(&shards, &read, &exists).is_empty());\n    }\n\n    #[test]\n    fn a_shard_named_for_the_wrong_issue_fails() {\n        let shards = [PathBuf::from(\"docs/requirements/issue-0991-copy.md\")];\n        let read = |_path: &Path| \"## Issue #709 Multi-Source Search Fusion\\n\".to_string();\n        let failures = shard_violations(&shards, &read);\n        assert!(\n            failures.iter().any(|failure| failure.contains(\"issue-0709-\")),\n            \"{failures:?}\"\n        );\n    }\n\n    #[test]\n    fn a_shard_named_for_its_own_issue_passes() {\n        let shards = [PathBuf::from(\"docs/requirements/issue-0709-fusion.md\")];\n        let read = |_path: &Path| \"## Issue #709 Multi-Source Search Fusion\\n\".to_string();\n        assert!(shard_violations(&shards, &read).is_empty());\n    }\n}\n", "/tmp/gh-issue-solver-1786801324779/scripts")
