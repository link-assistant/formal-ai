[2026-07-22T21:42:51.150Z] [INFO]         "content": "438\t/// The trailing share a release cut at `until` would record.\n439\t///\n440\t/// Same arithmetic `record_release_with_policy` performs, without writing\n441\t/// anything, so a pull request can be told what its merge would do to the\n442\t/// ratchet while its commits can still be amended.\n443\tpub fn project_trailing_basis_points(\n444\t    repo: &Path,\n445\t    ledger: &Path,\n446\t    since: &str,\n447\t    until: &str,\n448\t    trailing_window: usize,\n449\t) -> Result<u64, String> {\n450\t    if trailing_window == 0 {\n451\t        return Err(\"trailing window must be greater than zero\".to_owned());\n452\t    }\n453\t    let measurement = measure_with_policy(repo, since, until, EvidencePolicy::Lenient)?;\n454\t    let rows = read_release_rows(ledger)?;\n455\t    let mut window_rows = rows\n456\t        .iter()\n457\t        .filter(|row| row.metric_version == METRIC_VERSION)\n458\t        .rev()\n459\t        .take(trailing_window.saturating_sub(1))\n460\t        .cloned()\n461\t        .collect::<Vec<_>>();\n462\t    window_rows.reverse();\n463\t    window_rows.push(ReleaseRow {\n464\t        metric_version: METRIC_VERSION,\n465\t        tag: String::new(),\n466\t        since: since.to_owned(),\n467\t        until: until.to_owned(),\n468\t        self_authored_lines: measurement.self_authored_lines,\n469\t        changed_lines: measurement.changed_lines,\n470\t        self_authored_commits: measurement.self_authored_commits,\n471\t        commits: measurement.commits,\n472\t        percentage_basis_points: measurement.percentage_basis_points,\n473\t        trailing_window,\n474\t        trailing_percentage_basis_points: 0,\n475\t    });\n476\t    Ok(weighted_percentage(&window_rows))\n477\t}\n478\t\n479\t/// Whether merging `head` would lower the share the next release records."
