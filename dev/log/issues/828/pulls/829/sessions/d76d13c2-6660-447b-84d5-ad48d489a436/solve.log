[2026-07-22T21:51:03.483Z] [INFO]     "originalFile": "#!/usr/bin/env bash\n# Issue #828 self-hosting evidence: drive Formal AI, through the Agent CLI, to\n# author a genuine change plan for the very fix this branch ships — isolating\n# each agent-CLI E2E server's memory so its deterministic tool planning stops\n# reading the shared ~/.formal-ai/memory.lino. The plan Formal AI composes and\n# its session record are committed as self-authored artifacts; the raw Agent CLI\n# transcript and server trace are the excluded evidence bundle that binds them\n# to a real `ses_...` session id (see CONTRIBUTING.md \"Recording self-authorship\").\n#\n# This dogfoods the branch's own fix: the server below runs with an isolated,\n# empty memory (FORMAL_AI_MEMORY_PATH + FORMAL_AI_DREAMING=0), exactly the\n# invariant every E2E script now enforces.\nset -euo pipefail\n\nROOT=\"$(cd \"$(dirname \"$0\")/../..\" && pwd)\"\nBIN=\"${BIN:-$ROOT/target/release/formal-ai}\"\nAGENT=\"${AGENT:-agent}\"\nPORT=\"${PORT:-8828}\"\nOUT=\"${OUT:-$ROOT/docs/case-studies/issue-828/self-hosting-evidence}\"\nTASK='Create file memory-isolation-invariant.md documenting that every agent CLI end-to-end server must set FORMAL_AI_MEMORY_PATH to a private path and FORMAL_AI_DREAMING=0 so deterministic tool planning never reads the shared home memory'\n\ncommand -v \"$AGENT\" >/dev/null\n[[ -x \"$BIN\" ]] || { echo \"build first: cargo build --release --bin formal-ai\" >&2; exit 2; }\nmkdir -p \"$OUT\"\nwork=\"$(mktemp -d)\"\nmem=\"$(mktemp -d)\"\ncleanup() { kill \"${server_pid:-}\" 2>/dev/null || true; rm -rf \"$work\" \"$mem\"; }\ntrap cleanup EXIT\ngit -C \"$work\" init -q\ngit -C \"$work\" config user.email self-coding@example.invalid\ngit -C \"$work\" config user.name self-coding-fixture\ntouch \"$work/README.md\"\ngit -C \"$work\" add README.md\ngit -C \"$work\" commit -qm fixture\n\n# Private, empty memory + no dreaming: the exact isolation invariant issue #828\n# adds to every E2E server, dogfooded here.\nFORMAL_AI_AGENT_MODE=1 FORMAL_AI_TRACE_REQUESTS=1 \\\n  FORMAL_AI_MEMORY_PATH=\"$mem/memory.lino\" FORMAL_AI_DREAMING=0 \\\n  \"$BIN\" serve --host 127.0.0.1 --port \"$PORT\" >\"$OUT/formal-ai.log\" 2>&1 &\nserver_pid=$!\ncurl -fsS --retry 30 --retry-delay 1 --retry-connrefused \\\n  \"http://127.0.0.1:$PORT/health\" >/dev/null\nconfig=\"$(printf '{\"provider\":{\"formalai\":{\"name\":\"Formal AI\",\"npm\":\"@ai-sdk/openai-compatible\",\"options\":{\"baseURL\":\"http://127.0.0.1:%s/api/openai/v1\",\"apiKey\":\"local\"},\"models\":{\"formal-ai\":{\"name\":\"Formal AI\"}}}},\"model\":\"formalai/formal-ai\"}' \"$PORT\")\"\n(cd \"$work\" && FORMAL_AI_API_KEY=local LINK_ASSISTANT_AGENT_CONFIG_CONTENT=\"$config\" \\\n  \"$AGENT\" --model formalai/formal-ai --permission-mode auto \\\n  --output-format stream-json --compact-json --disable-stdin --prompt \"$TASK\" \\\n  >\"$OUT/agent-stream.raw.log\" 2>\"$OUT/agent-stderr.log\")\n\"$ROOT/scripts/classify-agent-cli-stderr.sh\" \"$OUT/agent-stderr.log\"\ngrep '^{' \"$OUT/agent-stream.raw.log\" >\"$OUT/agent-stream.jsonl\"\nrm \"$OUT/agent-stream.raw.log\" \"$OUT/agent-stderr.log\"\n\n# Formal AI's own authored artifacts: the change plan it composed and the\n# replayable session record. These are the self-authored, counted lines.\ncp \"$work/.formal-ai/general-change-plan.lino\" \"$OUT/general-change-plan.lino\"\ncp \"$work/memory-isolation-invariant.md\" \"$OUT/memory-isolation-invariant.md\"\n\"$BIN\" agent --task \"$TASK\" --session-json \"$OUT/session.json\" >/dev/null\n\necho \"issue #828 self-hosting evidence written to $OUT\"\necho \"session id(s): $(grep -o 'ses_[A-Za-z0-9]*' \"$OUT/agent-stream.jsonl\" | sort -u | tr '\\n' ' ')\"\n",
[2026-07-22T21:51:03.483Z] [INFO]     "userModified": false
[2026-07-22T21:51:03.483Z] [INFO]   }
[2026-07-22T21:51:03.483Z] [INFO] }
