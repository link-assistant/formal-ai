[2026-07-22T21:02:10.925Z] [INFO]         "content": "255\t  # === LINT AND FORMAT CHECK ===\n256\t  # Lint runs independently of changelog check - it's a fast check that should always run\n257\t  # See: https://github.com/link-assistant/hive-mind/pull/1024 for why this dependency was removed\n258\t  lint:\n259\t    name: Lint and Format Check\n260\t    runs-on: ubuntu-latest\n261\t    timeout-minutes: 10\n262\t    needs: [detect-changes, cargo-lock]\n263\t    # Note: !cancelled() is required because detect-changes is skipped on workflow_dispatch,\n264\t    # and without it, this job would also be skipped even though its condition includes workflow_dispatch.\n265\t    # See: https://github.com/actions/runner/issues/491\n266\t    if: |\n267\t      !cancelled() && (\n268\t        needs.cargo-lock.result == 'success' && (\n269\t          github.event_name == 'push' ||\n270\t          github.event_name == 'workflow_dispatch' ||\n271\t          needs.detect-changes.outputs.rs-changed == 'true' ||\n272\t          needs.detect-changes.outputs.toml-changed == 'true' ||\n273\t          needs.detect-changes.outputs.docs-changed == 'true' ||\n274\t          needs.detect-changes.outputs.workflow-changed == 'true'\n275\t        )\n276\t      )\n277\t    steps:\n278\t      - uses: actions/checkout@v6\n279\t        with:\n280\t          fetch-depth: 0\n281\t\n282\t      - name: Setup Rust\n283\t        uses: dtolnay/rust-toolchain@stable\n284\t        with:\n285\t          components: rustfmt, clippy\n286\t\n287\t      - name: Install rust-script\n288\t        run: ./scripts/install-rust-script.sh\n289\t\n290\t      - name: Cache cargo registry\n291\t        uses: actions/cache@v5\n292\t        with:\n293\t          path: |\n294\t            ~/.cargo/registry\n295\t            ~/.cargo/git\n296\t            target\n297\t          key: ${{ runner.os }}-cargo-lint-${{ hashFiles('**/Cargo.lock') }}\n298\t          restore-keys: |\n299\t            ${{ runner.os }}-cargo-lint-\n300\t\n301\t      - name: Check formatting\n302\t        run: cargo fmt --all -- --check\n303\t\n304\t      - name: Run Clippy\n305\t        run: cargo clippy --all-targets --all-features\n306\t\n307\t      # Warning-band annotations are limited to files this pull request changed,\n308\t      # so unchanged files stop repeating the same warning on every run.\n309\t      # The 1000-line hard limit still applies to the whole repository.\n310\t      - name: Collect changed files\n311\t        id: changed-files\n312\t        env:\n313\t          BASE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event.before }}\n314\t        run: |\n315\t          {\n316\t            echo 'files<<CHANGED_FILES_EOF'\n317\t            if [ -n \"$BASE_SHA\" ] && git cat-file -e \"$BASE_SHA^{commit}\" 2>/dev/null; then\n318\t              git diff --name-only \"$BASE_SHA\" HEAD\n319\t            else\n320\t              # No usable base (e.g. workflow_dispatch): fall back to annotating every warning.\n321\t              git ls-files\n322\t            fi\n323\t            echo 'CHANGED_FILES_EOF'\n324\t          } >> \"$GITHUB_OUTPUT\"\n325\t\n326\t      - name: Build documentation\n327\t        # Fail-closed rustdoc gate: rustdoc-only lints (for example\n328\t        # rustdoc::private_intra_doc_links) are not reported by clippy or\n329\t        # `cargo test --doc`, so they must be caught here, before release,\n330\t        # instead of in the post-release deploy-docs job.\n331\t        env:\n332\t          RUSTDOCFLAGS: -D warnings\n333\t        run: cargo doc --no-deps --all-features\n334\t\n335\t      - name: Check file size limit\n336\t        env:\n337\t          CHANGED_FILES: ${{ steps.changed-files.outputs.files }}\n338\t        run: rust-script scripts/check-file-size.rs\n339\t\n340\t  # === TEST ===\n341\t  # Test runs independently of changelog check and only for code-affecting changes\n342\t  test:\n343\t    name: Test (${{ matrix.os }})\n344\t    runs-on: ${{ matrix.os }}\n345\t    timeout-minutes: 20\n346\t    needs: [detect-changes, cargo-lock]\n347\t    # Note: !cancelled() is required because detect-changes is skipped on workflow_dispatch,\n348\t    # and without it, this job would also be skipped even though its condition includes workflow_dispatch.\n349\t    # See: https://github.com/actions/runner/issues/491\n350\t    if: |\n351\t      !cancelled() && (\n352\t        needs.cargo-lock.result == 'success' && (\n353\t          github.event_name == 'push' ||\n354\t          github.event_name == 'workflow_dispatch' ||\n355\t          needs.detect-changes.outputs.any-code-changed == 'true' ||\n356\t          needs.detect-changes.outputs.rs-changed == 'true' ||\n357\t          needs.detect-changes.outputs.toml-changed == 'true' ||\n358\t          needs.detect-changes.outputs.workflow-changed == 'true'\n359\t        )\n360\t      )\n361\t    strategy:\n362\t      fail-fast: false\n363\t      matrix:\n364\t        os: [ubuntu-latest, macos-latest, windows-latest]\n365\t    steps:\n366\t      - uses: actions/checkout@v6\n367\t\n368\t      - name: Setup Rust\n369\t        uses: dtolnay/rust-toolchain@stable\n370\t\n371\t      - name: Cache cargo registry on Windows\n372\t        if: runner.os == 'Windows'\n373\t        uses: actions/cache@v5\n374\t        with:\n375\t          path: |\n376\t            ~/.cargo/registry\n377\t            ~/.cargo/git\n378\t          key: ${{ runner.os }}-cargo-test-registry-${{ hashFiles('**/Cargo.lock') }}\n379\t          restore-keys: |\n380\t            ${{ runner.os }}-cargo-test-registry-\n381\t\n382\t      - name: Cache cargo registry and target on Unix\n383\t        if: runner.os != 'Windows'\n384\t        uses: actions/cache@v5\n385\t        with:\n386\t          path: |\n387\t            ~/.cargo/registry\n388\t            ~/.cargo/git\n389\t            target\n390\t          key: ${{ runner.os }}-cargo-test-${{ hashFiles('**/Cargo.lock') }}\n391\t          restore-keys: |\n392\t            ${{ runner.os }}-cargo-test-\n393\t\n394\t      - name: Run tests\n395\t        run: cargo test --all-features --verbose\n396\t\n397\t      - name: Run doc tests\n398\t        run: cargo test --doc --verbose\n399\t\n400\t  # === CODE COVERAGE ===\n401\t  # Generate and upload code coverage using cargo-llvm-cov\n402\t  coverage:\n403\t    name: Code Coverage\n404\t    runs-on: ubuntu-latest"
