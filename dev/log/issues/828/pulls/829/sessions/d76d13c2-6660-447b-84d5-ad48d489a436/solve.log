[2026-07-22T21:35:06.983Z] [INFO]         "content": "        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  # Cancel superseded runs on PR branches to save CI minutes, but never cancel a\n  # run on main: that branch drives the release pipeline (crates.io publish, tag\n  # creation, desktop builds, Pages deploy), and cancelling it mid-flight can\n  # leave a release half-published. desktop-release.yml uses cancel-in-progress:\n  # false for the same reason (issue #479).\n  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n  CARGO_NET_RETRY: '10'\n  CARGO_HTTP_MULTIPLEXING: 'false'\n  CARGO_TERM_COLOR: always\n  RUSTFLAGS: -Dwarnings\n  # Support both CARGO_REGISTRY_TOKEN (cargo's native env var) and CARGO_TOKEN (for backwards compatibility)\n  CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n  CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n  # Default prepared Docker image published by releases for single-line bot startup.\n  GHCR_IMAGE: ghcr.io/${{ github.repository }}\n  # Optional: set repository variable DOCKERHUB_IMAGE to namespace/image to publish Docker Hub releases.\n  DOCKERHUB_IMAGE: ${{ vars.DOCKERHUB_IMAGE }}\n\njobs:\n  # === DETECT CHANGES - determines which jobs should run ===\n  detect-changes:\n    name: Detect Changes\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    if: github.event_name != 'workflow_dispatch'\n    outputs:\n      rs-changed: ${{ steps.changes.outputs.rs-changed }}\n      toml-changed: ${{ steps.changes.outputs.toml-changed }}\n      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n      workflow-changed: ${{ steps.changes.outputs.workflow-changed }}\n      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Detect changes\n        id: changes\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          GITHUB_EVENT_BEFORE: ${{ github.event.before }}\n        run: rust-script scripts/detect-code-changes.rs\n\n  # === CHANGELOG CHECK - only runs on PRs with code changes ===\n  # Docs-only PRs (./docs folder, markdown files) don't require changelog fragments",
