s_added: Vec<&String> = changed_files\n139:    let fragment_added_count = fragments_added.len();\n141:    println!(\"Changelog fragments added: {}\", fragment_added_count);\n142:    if fragment_added_count > 0 {\n143:        for file in &fragments_added {\n149:    // Check if source files changed but no fragment was added\n150:    if source_changed_count > 0 && fragment_added_count == 0 {\n151:        eprintln!(\"::error::No changelog fragment found in this PR. Please add a changelog entry in changelog.d/\");",
