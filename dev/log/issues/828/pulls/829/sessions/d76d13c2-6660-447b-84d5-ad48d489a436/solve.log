[2026-07-22T21:58:34.257Z] [INFO]       "content": "      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Detect changes\n        id: changes\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          GITHUB_EVENT_BEFORE: ${{ github.event.before }}\n        run: rust-script scripts/detect-code-changes.rs\n\n  # === CHANGELOG CHECK - only runs on PRs with code changes ===\n  # Docs-only PRs (./docs folder, markdown files) don't require changelog fragments\n  changelog:\n    name: Changelog Fragment Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    needs: [detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Check for changelog fragments\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: rust-script scripts/check-changelog-fragment.rs\n\n  # === SELF-HOSTING EVIDENCE CHECK ===\n  # Issue #808: run 29723467001 failed the whole Auto Release job with\n  # \"no committed Formal-AI-Evidence in 10e65ae2 records session\n  # issue-804-claude-20260720\". The invariant (CONTRIBUTING.md: every commit\n  # carrying Formal-AI-Session must also carry a Formal-AI-Evidence file that\n  # contains \"formal-ai\" and the exact session id) was only ever enforced at\n  # release time, on main, after merge -- where nothing can be fixed without a\n  # new PR. This job runs the *same* code path over the PR's own commits so a\n  # violating commit is rejected before it can break a release.\n  evidence-check:\n    name: Self-Hosting Evidence Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    if: github.event_name == 'pull_request'\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Validate Formal-AI trailers on this pull request\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: |\n          set -euo pipefail\n          base=\"origin/${GITHUB_BASE_REF}\"\n          merge_base=\"$(git merge-base \"$base\" HEAD)\"\n          echo \"Validating commits in ${merge_base}..HEAD\"\n          rust-script scripts/self-hosting-metric.rs --since \"$merge_base\" --until HEAD\n\n      # Issue #812: `Auto Release` died on main with \"self-hosting ratchet would\n      # fall from 32.68% to 18.24% for v0.301.0\" -- after every contributing\n      # commit was already immutable, and while the only way to move the measured\n      # range forward (cutting a tag) was what it blocked. Enforcement belongs\n      # here, where the commits can still be amended. The check is differential:\n      # it compares the release share projected *with* this branch against the\n      # one projected for the base alone, so a regression already on main cannot\n      # block unrelated pull requests.\n      - name: Check the self-hosting ratchet against the merge base\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: |\n          set -euo pipefail\n          base=\"origin/${GITHUB_BASE_REF}\"\n          rust-script scripts/self-hosting-metric.rs --check-ratchet \"$base\" --until HEAD\n\n  # === DOCKER IMAGE CHECK ===\n  # Issue #808: the Dockerfile was only ever built inside `auto-release` /\n  # `manual-release`, i.e. after the crate had already been published to\n  # crates.io. A broken Dockerfile therefore produced a half-finished release\n  # (crate published, no image, no GitHub Release) and could not be caught\n  # before merge. scripts/verify-docker-runtime.sh, which the image installs as",
