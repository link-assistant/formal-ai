[2026-07-22T21:02:47.309Z] [INFO]         "content": "60\t# shape as GitHub CLI.\n61\tcat > \"$FAKE_BIN/gh\" <<EOF\n62\t#!/usr/bin/env bash\n63\tprintf '%s\\n' \"\\$*\" >> \"$GH_LOG\"\n64\tprintf '%s\\n' 'https://github.com/link-assistant/formal-ai/issues/999999'\n65\tEOF\n66\tchmod +x \"$FAKE_BIN/gh\"\n67\t\n68\tFORMAL_AI_AGENT_MODE=1 FORMAL_AI_TRACE_REQUESTS=1 \\\n69\t  \"$BIN\" serve --host 127.0.0.1 --port \"$PORT\" > \"$LOG\" 2>&1 &\n70\tSRV=$!\n71\ttrap 'kill $SRV 2>/dev/null; rm -rf \"$WORKDIR\"' EXIT\n72\t\n73\tif ! curl -sS --retry 30 --retry-delay 1 --retry-connrefused --max-time 40 \\\n74\t     \"http://127.0.0.1:$PORT/health\" >/dev/null 2>&1; then\n75\t  echo \"!! server never came up on port $PORT\"\n76\t  tail -80 \"$LOG\"\n77\t  exit 1\n78\tfi\n79\t\n80\tfail() {\n81\t  echo \"!! $*\" >&2\n82\t  echo \"== Agent CLI log ==\" >&2\n83\t  tail -160 \"$AGENT_LOG\" >&2\n84\t  echo \"== formal-ai server log ==\" >&2\n85\t  tail -200 \"$LOG\" >&2\n86\t  exit 1\n87\t}\n88\t\n89\trun_turn() {\n90\t  local label=\"$1\"\n91\t  local prompt=\"$2\"\n92\t  shift 2\n93\t  echo \"== $label: $prompt ==\" | tee -a \"$AGENT_LOG\"\n94\t  FORMAL_AI_BASE_URL=\"http://127.0.0.1:$PORT/v1\" \\\n95\t    LINK_ASSISTANT_AGENT_DISABLE_AUTOUPDATE=1 \\\n96\t    PATH=\"$FAKE_BIN:$PATH\" timeout 180 \"$AGENT\" \\\n97\t    --prompt \"$prompt\" \\\n98\t    --disable-stdin \\\n99\t    --model formal-ai/formal-ai \\\n100\t    --no-summarize-session \\\n101\t    \"$@\" >> \"$AGENT_LOG\" 2>&1 || fail \"$label failed\"\n102\t}\n103\t\n104\trun_turn research \"When are the next elections in the USA?\"\n105\trun_turn report \"Report this problem\" --continue --no-fork\n106\trun_turn report_destination \"GitHub issue\" --continue --no-fork\n107\trun_turn report_context \"Both logs\" --continue --no-fork\n108\trun_turn recall \"What were we talking about?\" --continue --no-fork\n109\trun_turn follow_up \"Learn about it.\" --continue --no-fork\n110\t\n111\tif [ ! -f \"$GH_LOG\" ]; then\n112\t  # Distinguish the two ways this can happen: the request never reached the\n113\t  # server's report handler because opencode compacted the session (harness\n114\t  # problem), versus the handler saw the prompt and declined to act (product\n115\t  # problem). Guessing between them is why this took two runs to diagnose.\n116\t  if grep -q 'summarizing conversations' \"$LOG\"; then\n117\t    echo \"!! diagnosis: the session was auto-summarised mid-run; the report prompt\" >&2\n118\t    echo \"!! was replaced by opencode's own continuation before reaching the server.\" >&2\n119\t  fi\n120\t  fail \"report request did not execute gh\"\n121\tfi\n122\tgrep -q 'issue create --repo link-assistant/formal-ai' \"$GH_LOG\" \\\n123\t  || fail \"gh invocation did not target the Formal AI repository\"\n124\tgrep -qi 'election' \"$AGENT_LOG\" \\\n125\t  || fail \"conversation recall did not preserve the election topic\"\n126\tgrep -q '999999' \"$AGENT_LOG\" \\\n127\t  || fail \"report confirmation did not surface the created issue URL\"\n128\t\n129\tposts=\"$(grep -c 'POST /v1/chat/completions' \"$LOG\" || true)\"\n130\t[ \"$posts\" -ge 11 ] || fail \"expected at least 11 chat rounds, got $posts\"\n131\tsearches=\"$(grep -c 'agentic_outcome: planned ToolCalls.*websearch' \"$LOG\" || true)\"\n132\t[ \"$searches\" -ge 2 ] || fail \"initial and contextual research did not both reach websearch\"\n133\t\n134\techo \"== issue #687 E2E OK: report executed, recall retained context, follow-up researched it ($posts rounds) ==\""
