[2026-07-22T21:02:17.210Z] [INFO]         "content": "224\t  # === CARGO.LOCK GUARD ===\n225\t  # Binary crates must commit Cargo.lock so CI and release jobs resolve the same\n226\t  # dependency graph every run. This also prevents cache keys based on\n227\t  # hashFiles('**/Cargo.lock') from silently degrading to the empty hash.\n228\t  cargo-lock:\n229\t    name: Cargo.lock Guard\n230\t    runs-on: ubuntu-latest\n231\t    timeout-minutes: 5\n232\t    needs: [detect-changes]\n233\t    if: |\n234\t      !cancelled() && (\n235\t        github.event_name == 'push' ||\n236\t        github.event_name == 'workflow_dispatch' ||\n237\t        needs.detect-changes.outputs.rs-changed == 'true' ||\n238\t        needs.detect-changes.outputs.toml-changed == 'true' ||\n239\t        needs.detect-changes.outputs.docs-changed == 'true' ||\n240\t        needs.detect-changes.outputs.workflow-changed == 'true' ||\n241\t        needs.detect-changes.outputs.any-code-changed == 'true'\n242\t      )\n243\t    steps:\n244\t      - uses: actions/checkout@v6\n245\t\n246\t      - name: Setup Rust\n247\t        uses: dtolnay/rust-toolchain@stable\n248\t\n249\t      - name: Install rust-script\n250\t        run: ./scripts/install-rust-script.sh\n251\t\n252\t      - name: Check committed Cargo.lock for binary crates\n253\t        run: rust-script scripts/check-cargo-lock.rs"
[2026-07-22T21:02:17.210Z] [INFO]       }
[2026-07-22T21:02:17.210Z] [INFO]     ]
