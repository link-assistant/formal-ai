[2026-07-22T21:41:28.251Z] [INFO]         "content": "479\t/// Whether merging `head` would lower the share the next release records.\n480\t///\n481\t/// The comparison is *differential*: the projection including `head` against the\n482\t/// projection for `base` alone. An absolute threshold would repeat the issue\n483\t/// #812 outage in a new place — a regression already merged into `main` would\n484\t/// then fail every subsequent pull request, none of which could fix it. A\n485\t/// pull request is only answerable for its own delta, and a no-op pull request\n486\t/// is always neutral.\n487\t///\n488\t/// `since` is the last tag in the ledger, so the projected range is the one the\n489\t/// release will actually measure. Returns the message when the share falls.\n490\tpub fn ratchet_check(\n491\t    repo: &Path,\n492\t    ledger: &Path,\n493\t    base: &str,\n494\t    head: &str,\n495\t    trailing_window: usize,\n496\t) -> Result<Option<String>, String> {\n497\t    let Some(since) = read_release_rows(ledger)?.last().map(|row| row.tag.clone()) else {\n498\t        // No release has ever been recorded: there is no ratchet to fall from.\n499\t        return Ok(None);\n500\t    };\n501\t    // A checkout without tags (shallow clone, fork without `fetch-tags`) cannot\n502\t    // measure the release range. Skip loudly rather than fail: this gate exists\n503\t    // to catch regressions, and turning a missing tag into a red check would be\n504\t    // exactly the kind of false positive issue #812 is about.\n505\t    if git(\n506\t        repo,\n507\t        &[\n508\t            \"rev-parse\",\n509\t            \"--verify\",\n510\t            \"--quiet\",\n511\t            &format!(\"{since}^{{commit}}\"),\n512\t        ],\n513\t    )\n514\t    .is_err()\n515\t    {\n516\t        eprintln!(\"warning: skipping ratchet check: {since} is not present in this checkout\");\n517\t        return Ok(None);\n518\t    }\n519\t    let baseline = project_trailing_basis_points(repo, ledger, &since, base, trailing_window)?;\n520\t    let candidate = project_trailing_basis_points(repo, ledger, &since, head, trailing_window)?;\n521\t    if candidate >= baseline {\n522\t        return Ok(None);\n523\t    }\n524\t    Ok(Some(format!(\n525\t        \"merging this branch would lower the projected self-hosting share of the next release from \\\n526\t         {} to {}; record Formal-AI-Session and Formal-AI-Evidence trailers on the commits that \\\n527\t         Formal AI authored, or split unattributed work out of this branch\",\n528\t        format_percentage(baseline),"
[2026-07-22T21:41:28.251Z] [INFO]       }
