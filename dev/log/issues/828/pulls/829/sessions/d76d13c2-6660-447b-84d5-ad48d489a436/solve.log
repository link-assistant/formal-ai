[2026-07-22T21:30:43.853Z] [INFO]         "content": "1\t#!/usr/bin/env bash\n2\t# Boot formal-ai serve, wait for health, run a curl against it, tear down.\n3\t# All in one process tree so the environment does not reap the server.\n4\t#\n5\t# Sibling of run_agent_cli.sh: this one skips the agent CLI and just POSTs a\n6\t# hand-written /v1/chat/completions payload — useful when isolating server-side\n7\t# behaviour (SSE framing, tool_call planner, permission gate) from the CLI.\n8\tset -uo pipefail\n9\tROOT=\"$(cd \"$(dirname \"$0\")/../..\" && pwd)\"\n10\tBIN=\"${BIN:-$ROOT/target/release/formal-ai}\"\n11\tPORT=\"${PORT:-8734}\"\n12\tLOG=\"/tmp/formal-ai-serve-$PORT.log\"\n13\t\n14\tFORMAL_AI_AGENT_MODE=1 \"$BIN\" serve --host 127.0.0.1 --port \"$PORT\" > \"$LOG\" 2>&1 &\n15\tSRV=$!\n16\ttrap 'kill $SRV 2>/dev/null' EXIT\n17\t\n18\t# Wait for readiness without foreground sleep (curl retry handles the backoff).\n19\tcurl -sS --retry 30 --retry-delay 1 --retry-connrefused --max-time 40 \\\n20\t  \"http://127.0.0.1:$PORT/health\" >/dev/null 2>&1 || { echo \"server never came up\"; cat \"$LOG\"; exit 1; }\n21\techo \"== server up ==\"\n22\t\n23\tcurl -sS \"http://127.0.0.1:$PORT/v1/chat/completions\" \\\n24\t  -H 'content-type: application/json' -H 'authorization: Bearer x' \\\n25\t  -d '{\"model\":\"formal-ai\",\"messages\":[{\"role\":\"user\",\"content\":\"Create a file hi.txt with content hello\"}],\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"write\",\"description\":\"Write a file\",\"parameters\":{\"type\":\"object\",\"properties\":{\"filePath\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"}}}}}]}'\n26\techo\n27\t"
