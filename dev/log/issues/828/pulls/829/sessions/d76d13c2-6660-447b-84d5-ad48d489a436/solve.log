[2026-07-22T22:01:50.814Z] [INFO]         "content": "1\t#!/usr/bin/env bash\n2\t# Automated real-extension E2E for issue #763. A small development extension\n3\t# invokes the official command and exports its inherited config for a tool round trip.\n4\tset -euo pipefail\n5\t\n6\tROOT=\"$(cd \"$(dirname \"$0\")/../..\" && pwd)\"\n7\tBIN=\"${BIN:-$ROOT/target/debug/formal-ai}\"\n8\tCODE=\"${CODE:-code}\"\n9\tSERVER_PORT=\"${SERVER_PORT:-8872}\"\n10\tPROXY_PORT=\"${PROXY_PORT:-8873}\"\n11\tOUT=\"${OUT:-$ROOT/docs/case-studies/issue-763/opencode-vscode-e2e}\"\n12\tWORK=\"$(mktemp -d)\"\n13\tSTATE=\"$(mktemp -d)\"\n14\tSERVER_LOG=\"$OUT/formal-ai.log\"\n15\tPROXY_LOG=\"$OUT/proxy.jsonl\"\n16\tSIGNAL=\"$OUT/extension-driver.json\"\n17\tVSCODE_LOG=\"$OUT/vscode.log\"\n18\tOPENCODE_LOG=\"$OUT/opencode.log\"\n19\tEXPORTED_CONFIG=\"$OUT/opencode-config.json\"\n20\tPROMPT=\"Use a tool to list the files in the current directory, then report the result.\"\n21\t\n22\tcleanup() {\n23\t  kill \"${proxy_pid:-}\" \"${server_pid:-}\" 2>/dev/null || true\n24\t  rm -rf \"$WORK\" \"$STATE\"\n25\t}\n26\ttrap cleanup EXIT\n27\t\n28\tcommand -v \"$CODE\" >/dev/null\n29\tcommand -v opencode >/dev/null\n30\ttest -x \"$BIN\" || {\n31\t  echo \"build first: cargo build --bin formal-ai\" >&2\n32\t  exit 2\n33\t}\n34\tmkdir -p \"$OUT\"\n35\t: >\"$PROXY_LOG\"\n36\t: >\"$SIGNAL\"\n37\t: >\"$VSCODE_LOG\"\n38\t: >\"$OPENCODE_LOG\"\n39\tprintf '%s\\n' 'OPENCODE_VSCODE_MARKER_763' >\"$WORK/issue-763-marker.txt\"\n40\t\n41\t\"$CODE\" --user-data-dir \"$STATE/user\" --extensions-dir \"$STATE/extensions\" \\\n42\t  --install-extension sst-dev.opencode --force >\"$OUT/extension-install.log\"\n43\t\n44\tFORMAL_AI_AGENT_MODE=1 FORMAL_AI_TRACE_REQUESTS=1 \"$BIN\" serve \\\n45\t  --host 127.0.0.1 --port \"$SERVER_PORT\" >\"$SERVER_LOG\" 2>&1 &\n46\tserver_pid=$!\n47\tcurl -fsS --retry 30 --retry-delay 1 --retry-connrefused \\\n48\t  \"http://127.0.0.1:$SERVER_PORT/health\" >/dev/null\n49\t\n50\t\"$BIN\" proxy --listen \"127.0.0.1:$PROXY_PORT\" \\\n51\t  --upstream \"http://127.0.0.1:$SERVER_PORT\" --log \"$PROXY_LOG\" &\n52\tproxy_pid=$!\n53\tcurl -fsS --retry 30 --retry-delay 1 --retry-connrefused \\\n54\t  \"http://127.0.0.1:$PROXY_PORT/health\" >/dev/null\n55\t"
