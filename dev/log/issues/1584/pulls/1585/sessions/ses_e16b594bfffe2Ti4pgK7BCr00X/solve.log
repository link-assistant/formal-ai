[2026-11-17T11:35:35.633Z] [INFO]       "input": {
[2026-11-17T11:35:35.633Z] [INFO]         "command": "gh issue view 'https://github.com/link-assistant/formal-ai/issues/1584' --json title --jq .title && echo && gh issue view 'https://github.com/link-assistant/formal-ai/issues/1584' --json body --jq .body; printf '\n__formal_ai_exit=%s\n' $?"
