[2026-07-20T08:33:40.968Z] [INFO]         "content": "58\t\n59\tpermissions:\n60\t  contents: read\n61\t\n62\tconcurrency:\n63\t  # The workflow_run path (the automatic one) carries neither release.tag_name\n64\t  # nor inputs.tag, so this fell through to the always-unique run_id and never\n65\t  # actually deduped: concurrent runs for the same tag raced each other on\n66\t  # `gh release upload --clobber` and on finalize's SHA256SUMS.txt. Key on the\n67\t  # commit for that path, which is what resolve maps to a tag.\n68\t  group: desktop-release-${{ github.event.release.tag_name || github.event.inputs.tag || github.event.workflow_run.head_sha || github.run_id }}\n69\t  cancel-in-progress: false\n70\t\n71\tenv:\n72\t  GIT_CONFIG_COUNT: '1'\n73\t  GIT_CONFIG_KEY_0: init.defaultBranch\n74\t  GIT_CONFIG_VALUE_0: main\n75\t  CARGO_NET_RETRY: '10'\n76\t  CARGO_HTTP_MULTIPLEXING: 'false'\n77\t  RUSTFLAGS: -Dwarnings\n78\t\n79\tjobs:\n80\t  resolve:\n81\t    name: Resolve target release\n82\t    runs-on: ubuntu-latest\n83\t    timeout-minutes: 10\n84\t    permissions:\n85\t      contents: read\n86\t    # For workflow_run, continue after ANY completed main-branch pipeline except\n87\t    # cancelled/skipped runs (issue #479). We intentionally do NOT gate on\n88\t    # conclusion == 'success': the auto-release publishes the GitHub release in an\n89\t    # EARLY pipeline job, so a LATER job failing (e.g. the E2E Pages probe timing\n90\t    # out) still leaves a real, asset-less release that desktop assets must heal.\n91\t    # Gating on full-pipeline green meant one unrelated late failure suppressed\n92\t    # every desktop build -> \"Not available in latest release\". The actual\n93\t    # decision to build is delegated to scripts/desktop-release-resolve.sh, whose\n94\t    # idempotency guard skips when the resolved release already carries desktop\n95\t    # assets, so running on a non-success conclusion is safe and self-healing.\n96\t    if: >-\n97\t      github.event_name != 'workflow_run' ||\n98\t      (github.event.workflow_run.head_branch == 'main' &&\n99\t       github.event.workflow_run.conclusion != 'cancelled' &&\n100\t       github.event.workflow_run.conclusion != 'skipped')\n101\t    outputs:\n102\t      tag: ${{ steps.pick.outputs.tag }}\n103\t      should_build: ${{ steps.pick.outputs.should_build }}\n104\t    steps:\n105\t      # Check out the repo so the resolve logic lives in a unit-tested script\n106\t      # (scripts/desktop-release-resolve.sh) instead of being inlined here. The\n107\t      # script only needs to *exist*; it queries the GitHub API for everything\n108\t      # else, so checking out the default ref is sufficient.\n109\t      - uses: actions/checkout@v6\n110\t\n111\t      - name: Resolve tag and whether desktop assets are needed\n112\t        id: pick\n113\t        env:\n114\t          GH_TOKEN: ${{ github.token }}\n115\t          EVENT: ${{ github.event_name }}\n116\t          INPUT_TAG: ${{ github.event.inputs.tag }}\n117\t          RELEASE_TAG: ${{ github.event.release.tag_name }}\n118\t          REPO: ${{ github.repository }}\n119\t          WORKFLOW_RUN_HEAD_SHA: ${{ github.event.workflow_run.head_sha }}\n120\t        # Issue #479: the automated release tags a CHILD \"chore: release vX.Y.Z\"\n121\t        # commit whose first parent is the completed CI head SHA, so matching the\n122\t        # tag to the head SHA directly always failed and desktop assets were\n123\t        # never built. desktop-release-resolve.sh resolves the latest release\n124\t        # instead (with a defensive exact-SHA tier and an idempotency guard) and\n125\t        # emits verbose ::group:: diagnostics for future debugging.\n126\t        run: bash scripts/desktop-release-resolve.sh\n127\t\n128\t  build:\n129\t    name: Build ${{ matrix.label }}\n130\t    needs: resolve\n131\t    if: needs.resolve.outputs.should_build == 'true'\n132\t    strategy:\n133\t      fail-fast: false\n134\t      matrix:\n135\t        include:\n136\t