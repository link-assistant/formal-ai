ains(\"Unexpected npm stderr\"));\n\n    let desktop = workflow(\"desktop-release.yml\");\n    assert_eq!(\n        desktop\n            .matches(\"scripts/install-node-dependencies.sh\")\n            .count(),\n        2\n    );",
