[2026-07-20T08:26:23.611Z] [INFO]           "+          echo \"Validating commits in ${merge_base}..HEAD\"",
[2026-07-20T08:26:23.611Z] [INFO]           "+          rust-script scripts/self-hosting-metric.rs --since \"$merge_base\" --until HEAD",
