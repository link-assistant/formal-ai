[2026-07-20T08:38:03.706Z] [INFO]           " ",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # === DOCKER IMAGE CHECK ===",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # Issue #808: the Dockerfile was only ever built inside `auto-release` /",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # `manual-release`, i.e. after the crate had already been published to",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # crates.io. A broken Dockerfile therefore produced a half-finished release",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # (crate published, no image, no GitHub Release) and could not be caught",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # before merge. scripts/verify-docker-runtime.sh, which the image installs as",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # `verify-formal-ai-dind`, had no caller in CI at all. This job builds the",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # image without pushing and runs that verifier inside it, so both the build",
[2026-07-20T08:38:03.706Z] [INFO]           "+  # and the runtime contract gate the pull request.",
[2026-07-20T08:38:03.706Z] [INFO]           "+  docker-build:",
[2026-07-20T08:38:03.706Z] [INFO]           "+    name: Docker Image Build & Runtime Check",
[2026-07-20T08:38:03.706Z] [INFO]           "+    runs-on: ubuntu-latest",
[2026-07-20T08:38:03.706Z] [INFO]           "+    # The image compiles the crate in a builder stage; 30 minutes is not enough",
[2026-07-20T08:38:03.706Z] [INFO]           "+    # on a cold layer cache.",
[2026-07-20T08:38:03.706Z] [INFO]           "+    timeout-minutes: 60",
[2026-07-20T08:38:03.706Z] [INFO]           "+    needs: [detect-changes]",
[2026-07-20T08:38:03.706Z] [INFO]           "+    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'",
[2026-07-20T08:38:03.706Z] [INFO]           "+    steps:",
[2026-07-20T08:38:03.706Z] [INFO]           "+      - uses: actions/checkout@v6",
[2026-07-20T08:38:03.706Z] [INFO]           "+",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # Same \"No space left on device\" class of failure the release job guards",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # against (issue #523): a full release build inside the image on top of a",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # multi-GB DinD base image does not fit on a stock runner.",
[2026-07-20T08:38:03.706Z] [INFO]           "+      - name: Free up runner disk space",
[2026-07-20T08:38:03.706Z] [INFO]           "+        run: bash scripts/free-runner-disk.sh",
[2026-07-20T08:38:03.706Z] [INFO]           "+",
[2026-07-20T08:38:03.706Z] [INFO]           "+      - name: Set up Docker Buildx",
[2026-07-20T08:38:03.706Z] [INFO]           "+        uses: docker/setup-buildx-action@v4",
[2026-07-20T08:38:03.706Z] [INFO]           "+",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # load: true (not push) so the image stays local and the check works",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # unchanged for pull requests from forks, which have no registry",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # credentials. The GHA layer cache keeps the common case off a cold build.",
[2026-07-20T08:38:03.706Z] [INFO]           "+      - name: Build image",
[2026-07-20T08:38:03.706Z] [INFO]           "+        uses: docker/build-push-action@v7",
[2026-07-20T08:38:03.706Z] [INFO]           "+        with:",
[2026-07-20T08:38:03.706Z] [INFO]           "+          context: .",
[2026-07-20T08:38:03.706Z] [INFO]           "+          push: false",
[2026-07-20T08:38:03.706Z] [INFO]           "+          load: true",
[2026-07-20T08:38:03.706Z] [INFO]           "+          tags: formal-ai:pr-check",
[2026-07-20T08:38:03.706Z] [INFO]           "+          cache-from: type=gha",
[2026-07-20T08:38:03.706Z] [INFO]           "+          cache-to: type=gha,mode=max",
[2026-07-20T08:38:03.706Z] [INFO]           "+",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # --privileged is required: verify-docker-runtime.sh asserts that the",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # inner Docker daemon started by the DinD entrypoint is reachable, which",
[2026-07-20T08:38:03.706Z] [INFO]           "+      # is the whole point of the dind image variant.",
[2026-07-20T08:38:03.706Z] [INFO]           "+      - name: Verify image runtime contract",
[2026-07-20T08:38:03.706Z] [INFO]           "+        run: |",
[2026-07-20T08:38:03.706Z] [INFO]           "+          set -euo pipefail",
[2026-07-20T08:38:03.706Z] [INFO]           "+          docker run --rm --privileged formal-ai:pr-check verify-formal-ai-dind",
[2026-07-20T08:38:03.706Z] [INFO]           "+",
[2026-07-20T08:38:03.706Z] [INFO]           "   # === VERSION CHECK - prevents manual version modification in PRs ===",
