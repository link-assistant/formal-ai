[2026-07-20T08:56:05.399Z] [INFO]     "newString": "      # Issue #808 / R5 (CI-CD-BEST-PRACTICES.md section 11): no secrets scan\n      # existed anywhere in this pipeline. secretlint is language-agnostic, so\n      # it applies to a Rust repository unchanged; .secretlintrc.json selects\n      # the recommended preset.\n      #\n      # The js template runs `secretlint \"**/*\"`. That does not scale here: the\n      # glob walks the working tree including `target/` and 152 MB of committed\n      # case-study logs, and the scan then outlives the rest of the job. Feed it\n      # the git index instead -- only tracked files can leak a secret through a\n      # push -- minus the captured third-party logs, which are reviewed when\n      # added and consist of redacted GitHub Actions output.\n      - name: Check for secrets\n        run: bash scripts/check-secrets.sh",
[2026-07-20T08:56:05.399Z] [INFO]     "originalFile": "name: CI/CD Pipeline\n\non:\n  push:\n    branches:\n      - main\n  pull_request:\n    types: [opened, synchronize, reopened]\n  workflow_dispatch:\n    inputs:\n      release_mode:\n        description: 'Manual release mode'\n        required: true\n        type: choice\n        default: 'instant'\n        options:\n          - instant\n          - changelog-pr\n      bump_type:\n        description: 'Version bump type'\n        required: true\n        type: choice\n        options:\n          - patch\n          - minor\n          - major\n      description:\n        description: 'Release description (optional)'\n        required: false\n        type: string\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.ref }}\n  # Cancel superseded runs on PR branches to save CI minutes, but never cancel a\n  # run on main: that branch drives the release pipeline (crates.io publish, tag\n  # creation, desktop builds, Pages deploy), and cancelling it mid-flight can\n  # leave a release half-published. desktop-release.yml uses cancel-in-progress:\n  # false for the same reason (issue #479).\n  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n  CARGO_NET_RETRY: '10'\n  CARGO_HTTP_MULTIPLEXING: 'false'\n  CARGO_TERM_COLOR: always\n  RUSTFLAGS: -Dwarnings\n  # Support both CARGO_REGISTRY_TOKEN (cargo's native env var) and CARGO_TOKEN (for backwards compatibility)\n  CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n  CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n  # Default prepared Docker image published by releases for single-line bot startup.\n  GHCR_IMAGE: ghcr.io/${{ github.repository }}\n  # Optional: set repository variable DOCKERHUB_IMAGE to namespace/image to publish Docker Hub releases.\n  DOCKERHUB_IMAGE: ${{ vars.DOCKERHUB_IMAGE }}\n\njobs:\n  # === DETECT CHANGES - determines which jobs should run ===\n  detect-changes:\n    name: Detect Changes\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    if: github.event_name != 'workflow_dispatch'\n    outputs:\n      rs-changed: ${{ steps.changes.outputs.rs-changed }}\n      toml-changed: ${{ steps.changes.outputs.toml-changed }}\n      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n      workflow-changed: ${{ steps.changes.outputs.workflow-changed }}\n      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Detect changes\n        id: changes\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          GITHUB_EVENT_BEFORE: ${{ github.event.before }}\n        run: rust-script scripts/detect-code-changes.rs\n\n  # === CHANGELOG CHECK - only runs on PRs with code changes ===\n  # Docs-only PRs (./docs folder, markdown files) don't require changelog fragments\n  changelog:\n    name: Changelog Fragment Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    needs: [detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Check for changelog fragments\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: rust-script scripts/check-changelog-fragment.rs\n\n  # === SELF-HOSTING EVIDENCE CHECK ===\n  # Issue #808: run 29723467001 failed the whole Auto Release job with\n  # \"no committed Formal-AI-Evidence in 10e65ae2 records session\n  # issue-804-claude-20260720\". The invariant (CONTRIBUTING.md: every commit\n  # carrying Formal-AI-Session must also carry a Formal-AI-Evidence file that\n  # contains \"formal-ai\" and the exact session id) was only ever enforced at\n  # release time, on main, after merge -- where nothing can be fixed without a\n  # new PR. This job runs the *same* code path over the PR's own commits so a\n  # violating commit is rejected before it can break a release.\n  evidence-check:\n    name: Self-Hosting Evidence Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    if: github.event_name == 'pull_request'\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Validate Formal-AI trailers on this pull request\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: |\n          set -euo pipefail\n          base=\"origin/${GITHUB_BASE_REF}\"\n          merge_base=\"$(git merge-base \"$base\" HEAD)\"\n          echo \"Validating commits in ${merge_base}..HEAD\"\n          rust-script scripts/self-hosting-metric.rs --since \"$merge_base\" --until HEAD\n\n  # === DOCKER IMAGE CHECK ===\n  # Issue #808: the Dockerfile was only ever built inside `auto-release` /\n  # `manual-release`, i.e. after the crate had already been published to\n  # crates.io. A broken Dockerfile therefore produced a half-finished release\n  # (crate published, no image, no GitHub Release) and could not be caught\n  # before merge. scripts/verify-docker-runtime.sh, which the image installs as\n  # `verify-formal-ai-dind`, had no caller in CI at all. This job builds the\n  # image without pushing and runs that verifier inside it, so both the build\n  # and the runtime contract gate the pull request.\n  docker-build:\n    name: Docker Image Build & Runtime Check\n    runs-on: ubuntu-latest\n    # The image compiles the crate in a builder stage; 30 minutes is not enough\n    # on a cold layer cache.\n    timeout-minutes: 60\n    needs: [detect-changes]\n    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n    steps:\n      - uses: actions/checkout@v6\n\n      # Same \"No space left on device\" class of failure the release job guards\n      # against (issue #523): a full release build inside the image on top of a\n      # multi-GB DinD base image does not fit on a stock runner.\n      - name: Free up runner disk space\n        run: bash scripts/free-runner-disk.sh\n\n      - name: Set up Docker Buildx\n        uses: docker/setup-buildx-action@v4\n\n      # load: true (not push) so the image stays local and the check works\n      # unchanged for pull requests from forks, which have no registry\n      # credentials. The GHA layer cache keeps the common case off a cold build.\n      - name: Build image\n        uses: docker/build-push-action@v7\n        with:\n          context: .\n          push: false\n          load: true\n          tags: formal-ai:pr-check\n          cache-from: type=gha\n          cache-to: type=gha,mode=max\n\n      # --privileged is required: verify-docker-runtime.sh asserts that the\n      # inner Docker daemon started by the DinD entrypoint is reachable, which\n      # is the whole point of the dind image variant.\n      - name: Verify image runtime contract\n        run: |\n          set -euo pipefail\n          docker run --rm --privileged formal-ai:pr-check verify-formal-ai-dind\n\n  # === VERSION CHECK - prevents manual version modification in PRs ===\n  # This ensures versions are only modified by the automated release pipeline\n  version-check:\n    name: Version Modification Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 5\n    if: github.event_name == 'pull_request'\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Check for manual version changes\n        env:\n          GITHUB_EVENT_NAME: ${{ github.event_name }}\n          GITHUB_HEAD_REF: ${{ github.head_ref }}\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: rust-script scripts/check-version-modification.rs\n\n  # === LINT AND FORMAT CHECK ===\n  # Lint runs independently of changelog check - it's a fast check that should always run\n  # See: https://github.com/link-assistant/hive-mind/pull/1024 for why this dependency was removed\n  lint:\n    name: Lint and Format Check\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    needs: [detect-changes]\n    # Note: always() is required because detect-changes is skipped on workflow_dispatch,\n    # and without always(), this job would also be skipped even though its condition includes workflow_dispatch.\n    # See: https://github.com/actions/runner/issues/491\n    if: |\n      !cancelled() && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.any-code-changed == 'true' ||\n        needs.detect-changes.outputs.rs-changed == 'true' ||\n        needs.detect-changes.outputs.toml-changed == 'true' ||\n        needs.detect-changes.outputs.docs-changed == 'true' ||\n        needs.detect-changes.outputs.workflow-changed == 'true'\n      )\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      # Issue #808 / R3: GitHub checks out refs/pull/N/merge, a merge preview\n      # computed at the last sync -- commits pushed to the base branch since\n      # then are NOT in it, so a pull request can be green against a base that\n      # no longer exists. Adopted from the js template, which is the only one of\n      # the three that ships this.\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash scripts/simulate-fresh-merge.sh\n\n      # Issue #808 / R5 (CI-CD-BEST-PRACTICES.md section 11): no secrets scan\n      # existed anywhere in this pipeline. secretlint is language-agnostic and\n      # needs no repository configuration for the recommended preset.\n      - name: Check for secrets\n        run: npx --yes -p secretlint -p @secretlint/secretlint-rule-preset-recommend secretlint \"**/*\"\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n        with:\n          components: rustfmt, clippy\n          targets: wasm32-unknown-unknown\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Cache cargo registry\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            target\n          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-\n\n      - name: Check formatting\n        run: cargo fmt --all -- --check\n\n      - name: Verify Cargo.lock is synchronized\n        run: cargo metadata --locked --format-version 1 > /dev/null\n\n      - name: Run Clippy\n        run: cargo clippy --all-targets --all-features\n\n      # rustdoc-only lints are not exercised by rustc, clippy, or doctests.\n      # Build the same public API docs deployed by Pages before release so a\n      # broken link cannot first surface after packages have been published.\n      - name: Validate Rust API documentation\n        env:\n          RUSTDOCFLAGS: -D warnings\n        run: cargo doc --no-deps --lib\n\n      # docs.rs builds with DOCS_RS set. Its transitive lindera-jieba build\n      # script is currently broken in that mode (lindera/lindera#750), so the\n      # published docs profile deliberately omits the optional meta-language\n      # runtime while normal/default builds retain it. Exercise that exact\n      # profile before a crate can be released.\n      - name: Validate docs.rs dependency profile\n        env:\n          DOCS_RS: 1\n          RUSTDOCFLAGS: -D warnings\n        run: cargo doc --no-deps --lib --no-default-features\n\n      - name: Check semantic grounding\n        run: cargo test --test unit semantic_grounding -- --nocapture\n\n      - name: Check file size limit\n        env:\n          FILE_SIZE_WARNING_BASE: ${{ github.event.pull_request.base.sha || github.event.before }}\n        run: rust-script scripts/check-file-size.rs\n\n      - name: Check associative terminology\n        run: rust-script scripts/check-associative-terminology.rs\n\n      # Issue #659 (R379): fail the build when src/ gains user-facing prose\n      # string literals instead of sourcing them from data/seed/*.lino. The\n      # committed allowlist (scripts/hardcoded-language-allowlist.txt) inventories\n      # today's debt; new literals are blocked and migrated-away rows must be\n      # pruned, so the debt only shrinks. See\n      # docs/design/no-hardcoded-natural-language.md.\n      - name: Check hardcoded natural language\n        run: rust-script scripts/check-hardcoded-language.rs\n\n      - name: Check worker JS line budget\n        run: rust-script scripts/check-worker-line-budget.rs\n\n      - name: Build Rust→WASM worker\n        run: sh src/web/wasm-worker/build.sh\n\n      - name: Check wasm-worker size budget\n        run: rust-script scripts/check-wasm-worker-size.rs\n\n      - name: Test release changelog collection\n        run: rust-script --test scripts/version-and-commit.rs\n\n      - name: Test fragment release map regeneration\n        run: node --test experiments/issue_738_fragment_release_map.test.mjs\n\n      - name: Check reconstructed changelog\n        run: node experiments/issue_711_rebuild_changelog.mjs --check\n\n      - name: Install web bundle dependencies\n        run: bun install --frozen-lockfile\n\n      - name: Build web vendor bundle\n        run: bun run build:web\n\n      - name: Check web bundles are current\n        run: git diff --exit-code -- src/web/vendor.bundle.js src/web/ocr.bundle.js src/web/app.js\n\n      - name: Setup Node\n        uses: actions/setup-node@v6\n        with:\n          node-version: 22\n          cache: npm\n          cache-dependency-path: tests/e2e/package-lock.json\n\n      - name: Install web test dependencies\n        run: npm ci --prefix tests/e2e\n\n      - name: Check i18n catalog coverage\n        run: npm run --prefix tests/e2e check:i18n\n\n      - name: Check language change parity\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: npm run --prefix tests/e2e check:language-parity\n\n      - name: Check language test coverage\n        env:\n          GITHUB_BASE_REF: ${{ github.base_ref }}\n        run: npm run --prefix tests/e2e check:language-test-coverage\n\n      - name: Check multilingual intent coverage\n        run: npm run --prefix tests/e2e check:intent-coverage\n\n      - name: Check web app for hook TDZ ordering bugs\n        run: npm run --prefix tests/e2e check:web-tdz\n\n      # Issue #511/#514: fail the build if src/web/app.js renders hardcoded\n      # user-facing prose instead of routing it through the i18n catalog (t()).\n      # This stops the per-tool permission / Services regression class from\n      # silently re-appearing.\n      - name: Check web app for hardcoded user-facing strings\n        run: npm run --prefix tests/e2e check:web-hardcoded-ui\n\n      # The terminal-command trigger vocabulary lives in\n      # data/seed/terminal-commands.lino; the JS worker loads the generated\n      # src/web/seed deployment mirror through seed_loader.js. This fails on\n      # worker wiring regressions or stale present mirrors, so the worker can\n      # never silently re-hardcode trigger phrases that have moved into seed data.\n      - name: Check terminal vocabulary worker seed wiring\n        run: node experiments/issue-513-sync-worker-terminal.mjs --check\n\n      # The VS Code extension host libraries (config/bridge/webview-html/\n      # chat-view/server-process) and the manifest are pure JS exercised by\n      # node's built-in test runner plus a static smoke check. They read only\n      # committed source (never the git-ignored dist-web/vendor mirrors), so no\n      # `npm ci` or prepare-resources step is required here.\n      - name: Run VS Code extension node tests\n        run: npm run vscode:test\n\n      # The signer test stubs @electron/osx-sign, so it runs on Linux without\n      # installing the desktop dependency tree while still exercising the real\n      # browser-runtime exclusion logic used by both macOS release targets.\n      - name: Run desktop packaging regression tests\n        run: node --test desktop/scripts/adhoc-sign-mac.test.cjs\n\n  # === TEST ===\n  # Test runs independently of the changelog check and gates on the change\n  # detector so it never burns runner time on non-code changes (issue #442).\n  #\n  # Previously this job ran whenever `changelog` was skipped. But `changelog`\n  # is skipped precisely when there are NO code changes (docs-only / .gitkeep /\n  # changelog-fragment-only commits), so `needs.changelog.result == 'skipped'`\n  # turned \"no code changed\" into \"run the full test suite\" — the exact\n  # opposite of what we want. Gate on the detect-changes outputs instead, the\n  # same way `lint` and `coverage` already do.\n  test:\n    name: Test (${{ matrix.os }})\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 15\n    needs: [detect-changes]\n    # Note: always() is required because detect-changes is skipped on\n    # workflow_dispatch; without it the skipped dependency would cascade and\n    # skip this job despite the workflow_dispatch condition below.\n    # See: https://github.com/actions/runner/issues/491\n    if: |\n      !cancelled() && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.any-code-changed == 'true' ||\n        needs.detect-changes.outputs.rs-changed == 'true' ||\n        needs.detect-changes.outputs.toml-changed == 'true' ||\n        needs.detect-changes.outputs.workflow-changed == 'true'\n      )\n    strategy:\n      fail-fast: false\n      matrix:\n        # Windows and macOS execution is dropped for now to speed up iteration;\n        # the tests themselves are kept and still run on Linux.\n        os: [ubuntu-latest]\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          # Needed by simulate-fresh-merge.sh, which merges origin/<base>.\n          fetch-depth: 0\n\n      # The tests are the check that most needs to run against the real merge\n      # result rather than a stale preview.\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash scripts/simulate-fresh-merge.sh\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      # Restore the cargo cache here, but leave cache writes to the lint/build\n      # jobs. This test job runs close to its timeout after the full suite, and\n      # saving a target-heavy cache in post-job cleanup can cancel an otherwise\n      # successful run.\n      - name: Restore cargo registry cache\n        uses: actions/cache/restore@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            target\n          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-\n\n      # The shared target cache can retain binaries for test files removed on\n      # another branch. Rebuild this package's artifacts while preserving its\n      # cached dependencies so Cargo never executes an orphaned test binary.\n      - name: Clean stale package test artifacts\n        run: cargo clean -p formal-ai\n\n      - name: Check LiNo data integrity\n        run: cargo test --test unit data_files -- --nocapture\n\n      - name: Run tests\n        run: cargo test --all-features --verbose\n\n      - name: Run doc tests\n        run: cargo test --doc --verbose\n\n  # === CODE COVERAGE ===\n  # Generate and upload code coverage using cargo-llvm-cov\n  coverage:\n    name: Code Coverage\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    needs: [detect-changes]\n    if: |\n      !cancelled() && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.rs-changed == 'true' ||\n        needs.detect-changes.outputs.toml-changed == 'true'\n      )\n    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n        with:\n          components: llvm-tools-preview\n\n      - name: Cache cargo registry\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            target\n          key: ${{ runner.os }}-cargo-coverage-${{ hashFiles('**/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-coverage-\n\n      - name: Install cargo-llvm-cov\n        uses: taiki-e/install-action@cargo-llvm-cov\n\n      - name: Clean stale coverage artifacts\n        run: cargo llvm-cov clean --workspace\n\n      - name: Generate code coverage\n        run: cargo llvm-cov --all-features --lcov --output-path lcov.info\n\n      - name: Retain LCOV report\n        uses: actions/upload-artifact@v7\n        with:\n          name: rust-lcov\n          path: lcov.info\n          if-no-files-found: error\n\n      - name: Detect Codecov configuration\n        id: codecov-config\n        env:\n          CODECOV_TOKEN: ${{ secrets.CODECOV_TOKEN }}\n        run: |\n          if [[ -n \"$CODECOV_TOKEN\" ]]; then\n            echo \"configured=true\" >> \"$GITHUB_OUTPUT\"\n          else\n            echo \"configured=false\" >> \"$GITHUB_OUTPUT\"\n          fi\n\n      - name: Upload coverage to Codecov when configured\n        if: steps.codecov-config.outputs.configured == 'true'\n        uses: codecov/codecov-action@v7\n        with:\n          token: ${{ secrets.CODECOV_TOKEN }}\n          files: lcov.info\n          disable_search: true\n          plugins: noop\n          fail_ci_if_error: true\n\n      - name: Report optional Codecov integration status\n        if: steps.codecov-config.outputs.configured != 'true'\n        run: echo \"::notice title=Codecov upload not configured::The LCOV report is retained as the rust-lcov workflow artifact; configure CODECOV_TOKEN to enable fail-closed remote upload.\"\n\n  # === BUILD ===\n  # Build package - only runs if lint and test pass\n  build:\n    name: Build Package\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    needs: [lint, test]\n    if: ${{ !cancelled() && needs.lint.result == 'success' && needs.test.result == 'success' }}\n    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Cache cargo registry\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            target\n          key: ${{ runner.os }}-cargo-build-${{ hashFiles('**/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-build-\n\n      - name: Build release\n        run: cargo build --release --verbose\n\n      - name: Check package\n        run: cargo package --list --allow-dirty\n\n      - name: Check crate package size\n        run: rust-script scripts/check-crate-package-size.rs\n\n  # === AUTO RELEASE ===\n  # Automatic release on push to main using changelog fragments\n  # This job automatically bumps version based on fragments in changelog.d/\n  auto-release:\n    name: Auto Release\n    needs: [lint, test, build]\n    # Note: always() ensures consistent behavior with other jobs that depend on jobs using always().\n    if: |\n      !cancelled() &&\n      github.event_name == 'push' &&\n      github.ref == 'refs/heads/main' &&\n      needs.build.result == 'success'\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      pages_sha: ${{ steps.release_pages_ref.outputs.sha }}\n      pages_version: ${{ steps.release_pages_ref.outputs.version }}\n    env:\n      DOCKERHUB_USERNAME: ${{ vars.DOCKERHUB_USERNAME || secrets.DOCKERHUB_USERNAME }}\n      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n    permissions:\n      contents: write\n      packages: write\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n          token: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Configure git\n        run: rust-script scripts/git-config.rs\n\n      - name: Determine bump type from changelog fragments\n        id: bump_type\n        run: rust-script scripts/get-bump-type.rs\n\n      - name: Check if version already released or no fragments\n        id: check\n        env:\n          HAS_FRAGMENTS: ${{ steps.bump_type.outputs.has_fragments }}\n          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n        run: rust-script scripts/check-release-needed.rs\n\n      - name: Collect changelog and bump version\n        id: version\n        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.skip_bump != 'true'\n        run: |\n          rust-script scripts/version-and-commit.rs \\\n            --bump-type \"${{ steps.bump_type.outputs.bump_type }}\"\n\n      - name: Get current version\n        id: current_version\n        if: steps.check.outputs.should_release == 'true'\n        run: rust-script scripts/get-version.rs\n\n      - name: Build release\n        if: steps.check.outputs.should_release == 'true'\n        run: cargo build --release\n\n      - name: Publish to Crates.io\n        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.crate_published != 'true'\n        id: publish-crate\n        env:\n          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n          CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n        run: rust-script scripts/publish-crate.rs\n\n      - name: Wait for Crate availability on Crates.io\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        run: rust-script scripts/wait-for-crate.rs --release-version \"${{ steps.current_version.outputs.version }}\"\n\n      - name: Smoke test the published crate\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        run: scripts/smoke-test-published-crate.sh \"${{ steps.current_version.outputs.version }}\"\n\n      # Same \"No space left on device\" runner crash as issue #523, which was only\n      # fixed for the Pages job. `Build release` above already filled `/` with a\n      # multi-GB `target/`, and the Docker build below compiles the crate a second\n      # time inside the image on top of a large base image. Without this the runner\n      # dies mid-build-push: the crate is published to crates.io but no image and\n      # no GitHub Release are produced (runs 29312084458 and 29485000765).\n      - name: Free up runner disk space\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        run: bash scripts/free-runner-disk.sh\n\n      - name: Log in to GitHub Container Registry\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        uses: docker/login-action@v4\n        with:\n          registry: ghcr.io\n          username: ${{ github.actor }}\n          password: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Set up Docker Buildx\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        uses: docker/setup-buildx-action@v4\n\n      - name: Extract GHCR Docker metadata\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        id: ghcr-meta\n        uses: docker/metadata-action@v6\n        with:\n          images: ${{ env.GHCR_IMAGE }}\n          tags: |\n            type=raw,value=latest\n            type=raw,value=${{ steps.current_version.outputs.version }}\n          labels: |\n            org.opencontainers.image.version=${{ steps.current_version.outputs.version }}\n\n      - name: Publish Docker image to GHCR\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        uses: docker/build-push-action@v7\n        with:\n          context: .\n          push: true\n          tags: ${{ steps.ghcr-meta.outputs.tags }}\n          labels: ${{ steps.ghcr-meta.outputs.labels }}\n\n      - name: Configure Docker Hub publishing\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        id: dockerhub\n        run: |\n          disable_dockerhub() {\n            echo \"enabled=false\" >> \"$GITHUB_OUTPUT\"\n            echo \"$1\"\n          }\n\n          if [ -z \"$DOCKERHUB_IMAGE\" ]; then\n            disable_dockerhub \"Docker Hub publishing disabled: DOCKERHUB_IMAGE repository variable is not set\"\n            exit 0\n          fi\n\n          if [ ! -f Dockerfile ]; then\n            disable_dockerhub \"Docker Hub publishing disabled: Dockerfile was not found at repository root\"\n            exit 0\n          fi\n\n          if [ -z \"$DOCKERHUB_USERNAME\" ] || [ -z \"$DOCKERHUB_TOKEN\" ]; then\n            echo \"::error::Docker Hub publishing requires DOCKERHUB_USERNAME and DOCKERHUB_TOKEN\"\n            echo \"Set DOCKERHUB_USERNAME as a repository variable or secret, and DOCKERHUB_TOKEN as a secret.\"\n            exit 1\n          fi\n\n          echo \"enabled=true\" >> \"$GITHUB_OUTPUT\"\n          echo \"docker_hub_url=https://hub.docker.com/r/${DOCKERHUB_IMAGE}\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Log in to Docker Hub\n        if: steps.dockerhub.outputs.enabled == 'true'\n        uses: docker/login-action@v4\n        with:\n          username: ${{ env.DOCKERHUB_USERNAME }}\n          password: ${{ env.DOCKERHUB_TOKEN }}\n\n      - name: Extract Docker metadata\n        if: steps.dockerhub.outputs.enabled == 'true'\n        id: docker-meta\n        uses: docker/metadata-action@v6\n        with:\n          images: ${{ env.DOCKERHUB_IMAGE }}\n          tags: |\n            type=raw,value=latest\n            type=raw,value=${{ steps.current_version.outputs.version }}\n          labels: |\n            org.opencontainers.image.version=${{ steps.current_version.outputs.version }}\n\n      - name: Publish Docker image to Docker Hub\n        if: steps.dockerhub.outputs.enabled == 'true'\n        uses: docker/build-push-action@v7\n        with:\n          context: .\n          push: true\n          tags: ${{ steps.docker-meta.outputs.tags }}\n          labels: ${{ steps.docker-meta.outputs.labels }}\n\n      - name: Create GitHub Release\n        if: |\n          steps.check.outputs.should_release == 'true' && (\n            steps.check.outputs.crate_published == 'true' ||\n            steps.publish-crate.outputs.publish_result == 'success'\n          )\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          GHCR_URL: https://github.com/${{ github.repository }}/pkgs/container/formal-ai\n          DOCKER_HUB_URL: ${{ steps.dockerhub.outputs.docker_hub_url }}\n        run: |\n          # Use new_version from version-and-commit when available (tag-checked), else fall back to Cargo.toml version\n          RELEASE_VERSION=\"${{ steps.version.outputs.new_version }}\"\n          if [ -z \"$RELEASE_VERSION\" ]; then\n            RELEASE_VERSION=\"${{ steps.current_version.outputs.version }}\"\n          fi\n\n          release_args=(\n            --release-version \"$RELEASE_VERSION\"\n            --repository \"${{ github.repository }}\"\n            --self-hosting-ledger data/meta/self-hosting-ledger.lino\n          )\n          release_args+=(--ghcr-url \"$GHCR_URL\")\n          if [ -n \"$DOCKER_HUB_URL\" ]; then\n            release_args+=(--docker-hub-url \"$DOCKER_HUB_URL\")\n          fi\n          rust-script scripts/create-github-release.rs \"${release_args[@]}\"\n\n      - name: Resolve Pages deploy ref\n        id: release_pages_ref\n        if: always()\n        run: |\n          sha=\"$(git rev-parse HEAD)\"\n          version=\"$(sed -n 's/^version[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' Cargo.toml | head -n 1)\"\n          if [ -z \"$version\" ]; then\n            echo \"::error file=Cargo.toml::Could not read formal-ai version from Cargo.toml\"\n            exit 1\n          fi\n          echo \"sha=${sha}\" >> \"$GITHUB_OUTPUT\"\n          echo \"version=${version}\" >> \"$GITHUB_OUTPUT\"\n          echo \"Pages deploy ref: ${sha} (formal-ai ${version})\"\n\n  # === MANUAL INSTANT RELEASE ===\n  # Manual release via workflow_dispatch - only after CI passes\n  manual-release:\n    name: Instant Release\n    needs: [lint, test, build]\n    # Note: always() is required to evaluate the condition when dependencies use always().\n    # The build job ensures lint and test passed before this job runs.\n    if: |\n      !cancelled() &&\n      github.event_name == 'workflow_dispatch' &&\n      github.event.inputs.release_mode == 'instant' &&\n      needs.build.result == 'success'\n    runs-on: ubuntu-latest\n    timeout-minutes: 30\n    outputs:\n      pages_sha: ${{ steps.release_pages_ref.outputs.sha }}\n      pages_version: ${{ steps.release_pages_ref.outputs.version }}\n    env:\n      DOCKERHUB_USERNAME: ${{ vars.DOCKERHUB_USERNAME || secrets.DOCKERHUB_USERNAME }}\n      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n    permissions:\n      contents: write\n      packages: write\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n          token: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Configure git\n        run: rust-script scripts/git-config.rs\n\n      - name: Version and commit\n        id: version\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          DESCRIPTION: ${{ github.event.inputs.description }}\n        run: rust-script scripts/version-and-commit.rs --bump-type \"${{ github.event.inputs.bump_type }}\" --description \"${{ github.event.inputs.description }}\"\n\n      - name: Build release\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        run: cargo build --release\n\n      - name: Publish to Crates.io\n        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n        id: publish-crate\n        env:\n          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n          CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n        run: rust-script scripts/publish-crate.rs\n\n      - name: Wait for Crate availability on Crates.io\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        run: rust-script scripts/wait-for-crate.rs --release-version \"${{ steps.version.outputs.new_version }}\"\n\n      - name: Smoke test the published crate\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        run: scripts/smoke-test-published-crate.sh \"${{ steps.version.outputs.new_version }}\"\n\n      # See the auto-release job: the Docker build below needs headroom that\n      # `Build release` has already consumed.\n      - name: Free up runner disk space\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        run: bash scripts/free-runner-disk.sh\n\n      - name: Log in to GitHub Container Registry\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        uses: docker/login-action@v4\n        with:\n          registry: ghcr.io\n          username: ${{ github.actor }}\n          password: ${{ secrets.GITHUB_TOKEN }}\n\n      - name: Set up Docker Buildx\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        uses: docker/setup-buildx-action@v4\n\n      - name: Extract GHCR Docker metadata\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        id: ghcr-meta\n        uses: docker/metadata-action@v6\n        with:\n          images: ${{ env.GHCR_IMAGE }}\n          tags: |\n            type=raw,value=latest\n            type=raw,value=${{ steps.version.outputs.new_version }}\n          labels: |\n            org.opencontainers.image.version=${{ steps.version.outputs.new_version }}\n\n      - name: Publish Docker image to GHCR\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        uses: docker/build-push-action@v7\n        with:\n          context: .\n          push: true\n          tags: ${{ steps.ghcr-meta.outputs.tags }}\n          labels: ${{ steps.ghcr-meta.outputs.labels }}\n\n      - name: Configure Docker Hub publishing\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        id: dockerhub\n        run: |\n          disable_dockerhub() {\n            echo \"enabled=false\" >> \"$GITHUB_OUTPUT\"\n            echo \"$1\"\n          }\n\n          if [ -z \"$DOCKERHUB_IMAGE\" ]; then\n            disable_dockerhub \"Docker Hub publishing disabled: DOCKERHUB_IMAGE repository variable is not set\"\n            exit 0\n          fi\n\n          if [ ! -f Dockerfile ]; then\n            disable_dockerhub \"Docker Hub publishing disabled: Dockerfile was not found at repository root\"\n            exit 0\n          fi\n\n          if [ -z \"$DOCKERHUB_USERNAME\" ] || [ -z \"$DOCKERHUB_TOKEN\" ]; then\n            echo \"::error::Docker Hub publishing requires DOCKERHUB_USERNAME and DOCKERHUB_TOKEN\"\n            echo \"Set DOCKERHUB_USERNAME as a repository variable or secret, and DOCKERHUB_TOKEN as a secret.\"\n            exit 1\n          fi\n\n          echo \"enabled=true\" >> \"$GITHUB_OUTPUT\"\n          echo \"docker_hub_url=https://hub.docker.com/r/${DOCKERHUB_IMAGE}\" >> \"$GITHUB_OUTPUT\"\n\n      - name: Log in to Docker Hub\n        if: steps.dockerhub.outputs.enabled == 'true'\n        uses: docker/login-action@v4\n        with:\n          username: ${{ env.DOCKERHUB_USERNAME }}\n          password: ${{ env.DOCKERHUB_TOKEN }}\n\n      - name: Extract Docker metadata\n        if: steps.dockerhub.outputs.enabled == 'true'\n        id: docker-meta\n        uses: docker/metadata-action@v6\n        with:\n          images: ${{ env.DOCKERHUB_IMAGE }}\n          tags: |\n            type=raw,value=latest\n            type=raw,value=${{ steps.version.outputs.new_version }}\n          labels: |\n            org.opencontainers.image.version=${{ steps.version.outputs.new_version }}\n\n      - name: Publish Docker image to Docker Hub\n        if: steps.dockerhub.outputs.enabled == 'true'\n        uses: docker/build-push-action@v7\n        with:\n          context: .\n          push: true\n          tags: ${{ steps.docker-meta.outputs.tags }}\n          labels: ${{ steps.docker-meta.outputs.labels }}\n\n      - name: Create GitHub Release\n        if: |\n          (steps.version.outputs.version_committed == 'true' ||\n            steps.version.outputs.already_released == 'true') &&\n          steps.publish-crate.outputs.publish_result == 'success'\n        env:\n          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          GHCR_URL: https://github.com/${{ github.repository }}/pkgs/container/formal-ai\n          DOCKER_HUB_URL: ${{ steps.dockerhub.outputs.docker_hub_url }}\n        run: |\n          release_args=(\n            --release-version \"${{ steps.version.outputs.new_version }}\"\n            --repository \"${{ github.repository }}\"\n            --self-hosting-ledger data/meta/self-hosting-ledger.lino\n          )\n          release_args+=(--ghcr-url \"$GHCR_URL\")\n          if [ -n \"$DOCKER_HUB_URL\" ]; then\n            release_args+=(--docker-hub-url \"$DOCKER_HUB_URL\")\n          fi\n          rust-script scripts/create-github-release.rs \"${release_args[@]}\"\n\n      - name: Resolve Pages deploy ref\n        id: release_pages_ref\n        if: always()\n        run: |\n          sha=\"$(git rev-parse HEAD)\"\n          version=\"$(sed -n 's/^version[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' Cargo.toml | head -n 1)\"\n          if [ -z \"$version\" ]; then\n            echo \"::error file=Cargo.toml::Could not read formal-ai version from Cargo.toml\"\n            exit 1\n          fi\n          echo \"sha=${sha}\" >> \"$GITHUB_OUTPUT\"\n          echo \"version=${version}\" >> \"$GITHUB_OUTPUT\"\n          echo \"Pages deploy ref: ${sha} (formal-ai ${version})\"\n\n  # === MANUAL CHANGELOG PR ===\n  changelog-pr:\n    name: Create Changelog PR\n    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changelog-pr'\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      contents: write\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          fetch-depth: 0\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Install rust-script\n        run: bash scripts/install-rust-script.sh\n\n      - name: Create changelog fragment\n        env:\n          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n          DESCRIPTION: ${{ github.event.inputs.description }}\n        run: rust-script scripts/create-changelog-fragment.rs --bump-type \"${{ github.event.inputs.bump_type }}\" --description \"${{ github.event.inputs.description }}\"\n\n      - name: Create Pull Request\n        uses: peter-evans/create-pull-request@v8\n        with:\n          token: ${{ secrets.GITHUB_TOKEN }}\n          commit-message: 'chore: add changelog for manual ${{ github.event.inputs.bump_type }} release'\n          branch: changelog-manual-release-${{ github.run_id }}\n          delete-branch: true\n          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\n          body: |\n            ## Manual Release Request\n\n            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\n\n            ### Release Details\n            - **Type:** ${{ github.event.inputs.bump_type }}\n            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\n            - **Triggered by:** @${{ github.actor }}\n\n            ### Next Steps\n            1. Review the changelog fragment in this PR\n            2. Merge this PR to main\n            3. The automated release workflow will publish to crates.io and create a GitHub release\n\n  # === E2E TESTS (LOCAL) ===\n  # Serve src/web with a local HTTP server and run Playwright tests against it.\n  # Runs on every PR so regressions are caught before merge.\n  test-e2e-local:\n    name: E2E Tests (local web app)\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    needs: [detect-changes]\n    if: |\n      !cancelled() && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.any-code-changed == 'true'\n      )\n    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          # Avoid racing lint/agent E2E for setup-bun's shared executable key.\n          no-cache: true\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n          cache-dependency-path: tests/e2e/package-lock.json\n\n      - name: Install web bundle dependencies\n        run: bun install --frozen-lockfile\n\n      - name: Build web vendor bundle\n        run: bun run build:web\n\n      - name: Install Playwright and dependencies\n        run: |\n          cd tests/e2e\n          npm ci\n\n      - name: Install Playwright browsers\n        run: |\n          cd tests/e2e\n          npx playwright install --with-deps chromium\n\n      - name: Sync data/seed into src/web/seed (deployment mirror)\n        run: scripts/sync-seed.sh\n\n      - name: Run local e2e tests\n        run: |\n          cd tests/e2e\n          npx playwright test --config=playwright.local.config.js\n\n      - name: Upload Playwright report on failure\n        if: failure()\n        uses: actions/upload-artifact@v7\n        with:\n          name: playwright-report-local\n          path: tests/e2e/playwright-report/\n          retention-days: 7\n\n      # The issue-347 spec regenerates the /download preview images and full-page\n      # captures on every run (proving the screenshots can be produced in CI).\n      # Publish them as an artifact so reviewers can compare against the committed\n      # baselines without running the suite locally.\n      - name: Upload generated /download screenshots\n        if: always()\n        uses: actions/upload-artifact@v7\n        with:\n          name: download-page-screenshots\n          path: |\n            docs/screenshots/issue-347/\n            src/web/download/assets/app-preview*.png\n          retention-days: 14\n\n  # === E2E: Agent CLI ↔ formal-ai OpenAI-compatible server ===\n  # Boot `formal-ai serve`, drive it with the real `@link-assistant/agent` CLI\n  # (talking over its OpenAI-compatible endpoint) and prove the CLI writes the\n  # requested Links Notation file end-to-end. This is the maintainer's\n  # requirement for issue #538: no hardcoded meaning answers, no deferral —\n  # the real toolchain must produce the enriched meaning on every commit.\n  test-agent-cli-e2e:\n    name: E2E Tests (agent CLI ↔ formal-ai)\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    needs: [detect-changes]\n    if: |\n      !cancelled() && (\n        github.event_name == 'push' ||\n        github.event_name == 'workflow_dispatch' ||\n        needs.detect-changes.outputs.any-code-changed == 'true' ||\n        needs.detect-changes.outputs.rs-changed == 'true' ||\n        needs.detect-changes.outputs.toml-changed == 'true' ||\n        needs.detect-changes.outputs.workflow-changed == 'true'\n      )\n    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Cache cargo registry\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            target\n          key: ${{ runner.os }}-cargo-agentcli-e2e-${{ hashFiles('**/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-agentcli-e2e-\n            ${{ runner.os }}-cargo-\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n          # Avoid racing lint/local E2E for setup-bun's shared executable key.\n          no-cache: true\n\n      - name: Install @link-assistant/agent CLI\n        # The E2E script talks to formal-ai through the same CLI users install\n        # locally. `bun add -g` puts the `agent` binary on PATH under\n        # ~/.bun/bin — the script's default AGENT=\"agent\" picks it up.\n        run: |\n          bun add -g @link-assistant/agent\n          echo \"$HOME/.bun/bin\" >> $GITHUB_PATH\n\n      - name: Install external agent CLIs\n        # OpenCode provides the second issue-715 learning harness. Issue #781\n        # additionally proves the same research loop through Claude Code's\n        # Anthropic transport and Codex's Responses transport, so all clients\n        # are mandatory and their E2E scripts fail rather than skip if missing.\n        run: bun add -g opencode-ai @anthropic-ai/claude-code @openai/codex\n\n      - name: Build formal-ai (release)\n        # The E2E script runs against target/release/formal-ai — that's the\n        # binary users invoke as `formal-ai serve`. Release mode also matches\n        # the local-dev instructions in the case study.\n        run: cargo build --release --bin formal-ai\n\n      # Each recipe axis of issue #538 is driven live through the real Agent CLI\n      # against the real formal-ai server — no in-repo simulation. Every step\n      # boots the server, drives the CLI with a *differently worded* request, and\n      # asserts the CLI exits 0, wrote the expected file, the file carries the\n      # requirement's canary string, and the loop walked ≥MIN_POSTS chat rounds.\n      # Running all three (two meaning concepts + one non-lexeme diagram axis)\n      # proves the recipe generalises live, not just for the tomato answer.\n      - name: Run agent CLI E2E — tomato meaning (search → fetch → write → verify)\n        # Distinct port per step to avoid collisions if a runner is shared.\n        # Canary: the Russian plural `томаты`, previously missing from `томат`.\n        env:\n          PORT: 8768\n          EXPECT_FILE: meanings-tomato-detail.lino\n          EXPECT_TEXT: томаты\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: Run agent CLI E2E — potato meaning (different wording, same recipe)\n        # A differently-worded request routed to a different concept proves the\n        # recipe is general, not pattern-matched to the tomato phrasing.\n        env:\n          PORT: 8769\n          TASK: \"Please make the potato word and meaning richer — record the singular/plural of each surface, add the missing plural form potatoes, and keep it grounded in Wikidata.\"\n          EXPECT_FILE: meanings-potato-detail.lino\n          EXPECT_TEXT: potatoes\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: Run agent CLI E2E — generated diagrams (non-lexeme axis, no web step)\n        # A no-web recipe (write → verify → final = 3 rounds) driven by the same\n        # CLI, proving the loop generalises beyond the meaning-detail axis.\n        env:\n          PORT: 8770\n          TASK: \"Generate the mermaid diagrams of our agentic recipes, split into parts, as a visual overview of how Formal AI drives its own tools.\"\n          EXPECT_FILE: agentic-recipes.md\n          EXPECT_TEXT: flowchart\n          MIN_POSTS: 3\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: Run agent CLI E2E — self-inspection CST/AST census (no web step)\n        # A self-referential no-web recipe (write → verify → final = 3 rounds): the\n        # server parses a real module of its own meta algorithm through the\n        # meta-language links network and writes the abstract-syntax node census,\n        # proving the loop can reason about itself over the live Agent CLI.\n        env:\n          PORT: 8771\n          TASK: \"Store the CST/AST of our Rust meta algorithm in our data so the system can reason about itself: parse the planner module and record its abstract-syntax node census in Links Notation.\"\n          EXPECT_FILE: self-ast.lino\n          EXPECT_TEXT: named_node_count\n          MIN_POSTS: 3\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — learn-from-source directive (issue #499, no web step)\"\n        # The user directive from issue #499 — \"here you can learn the trending\n        # topics from Google Trends\" — is itself the task. It routes through the\n        # seed learning_sources registry into the same write → verify → final\n        # learning recipe, proving one teaching directive drives the Agent CLI,\n        # not just a chat reply. Canary: the human-gated marker in the report.\n        env:\n          PORT: 8772\n          TASK: \"Here you can learn the trending topics from Google Trends: https://trends.google.com/trending/rss?geo=US\"\n          EXPECT_FILE: google-trends-learning.lino\n          EXPECT_TEXT: human_gated\n          MIN_POSTS: 3\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — general unpinned change plan (issue #654)\"\n        # No `*_TASK` constant names this request. The fallback planner derives the\n        # target, literal payload, evidence, and verification command from the\n        # formalized requirement, writes its plan event first, then executes it.\n        env:\n          PORT: 8773\n          TASK: \"Create file artifacts/general-agent-plan.txt containing general planner e2e passed\"\n          EXPECT_FILE: artifacts/general-agent-plan.txt\n          EXPECT_TEXT: general planner e2e passed\n          MIN_POSTS: 4\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — file-creation routes to write not read (issue #681)\"\n        # The exact reproduction from issue #681: a \"create a file … with the\n        # content …\" request used to emit a `read` on the not-yet-existing target\n        # and finish with \"File not found\", writing nothing. Driven live through\n        # the real CLI, the request must now walk the write/create plan (write plan\n        # → write target → verify → final = 4 posts) and leave hello.txt on disk\n        # carrying its content — never a read of the file it was asked to create.\n        env:\n          PORT: 8775\n          TASK: \"Create a file named hello.txt with the content hello world\"\n          EXPECT_FILE: hello.txt\n          EXPECT_TEXT: hello world\n          MIN_POSTS: 4\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — existing issue reference does not file a duplicate (issue #730)\"\n        # Use wording different from the captured case-study run. Mentioning an\n        # existing issue beside a file request must drive the complete write plan,\n        # never the report router's real `gh issue create` side effect.\n        env:\n          PORT: 8781\n          TASK: \"For existing issue-730, create file issue-730-finding.md containing provenance paths are portable\"\n          EXPECT_FILE: issue-730-finding.md\n          EXPECT_TEXT: provenance paths are portable\n          MIN_POSTS: 4\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — capability-first local code search (issue #758)\"\n        env:\n          PORT: 8782\n        run: experiments/agent_cli_e2e/run_issue_758.sh\n\n      - name: \"Run agent CLI E2E — generated programs use harness commands (issue #716)\"\n        # The exact screenshot reproduction must create the source in the real\n        # Agent CLI workspace, then ask that harness to compile and run it. The\n        # request trace preserves both shell calls so a prose-only response or\n        # server-private execution cannot satisfy this check.\n        env:\n          PORT: 8776\n          TASK: \"Give me hello world program in Rust\"\n          EXPECT_FILE: main.rs\n          EXPECT_TEXT: \"Hello, world!\"\n          MIN_POSTS: 4\n          EXPECT_SERVER_TEXTS: |-\n            rustc main.rs -o main\n            ./main\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — auto-learn client execution architecture (issue #716)\"\n        # Replay the same investigation through Formal AI's associative-memory\n        # adapter and real Agent CLI tools. The report remains review-gated; its\n        # evidence links make the architectural promotion auditable.\n        env:\n          PORT: 8777\n          TASK: \"Use Formal AI auto-learning to inspect the persisted issue 716 client-execution failures as an associative links network, rank the observations and architectural amendments, keep promotion human-review gated, and write client-execution-learning-report.lino.\"\n          EXPECT_FILE: client-execution-learning-report.lino\n          EXPECT_TEXT: \"lesson:typed-execution-artifact\"\n          MIN_POSTS: 3\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — declarative new-file phrasing (issue #712)\"\n        # The exact declarative shape from issue #712 previously fell through to\n        # the read router. The live CLI must execute the complete write plan and\n        # leave the requested file behind, proving this is more than a response-\n        # serialization fix.\n        env:\n          PORT: 8776\n          TASK: \"new file: notes.txt, contents: hello\"\n          EXPECT_FILE: notes.txt\n          EXPECT_TEXT: hello\n          MIN_POSTS: 4\n        run: experiments/agent_cli_e2e/run_agent_cli.sh\n\n      - name: \"Run agent CLI E2E — report action executes gh (issue #714)\"\n        timeout-minutes: 3\n        env:\n          PORT: 8780\n        run: experiments/issue_714_agentic_mode/run_report_e2e.sh\n\n      - name: \"Run agent CLI E2E — research, report, recall, and learn (issue #687)\"\n        # Continue four natural-language turns in one real Agent CLI session.\n        # A PATH-local fake gh proves shell execution without mutating GitHub.\n        env:\n          PORT: 8776\n        run: experiments/agent_cli_e2e/run_issue_687.sh\n\n      - name: \"Run agent CLI E2E — filed report stays readable and bounded (issue #771)\"\n        # The reported session answered a question from a whole scraped page and\n        # then filed it, producing a 51KB issue whose transcript escaped its own\n        # markdown. Asserts over the real transport that every turn stays inside\n        # an attributed block and the body fits GitHub's issue size limit.\n        env:\n          PORT: 8781\n        run: experiments/agent_cli_e2e/run_issue_771.sh\n\n      - name: \"Run four-client E2E — narrated compatibility research (issue #781)\"\n        # The exact reported marketplace question drives Agent, OpenCode,\n        # Claude Code, and Codex through their native transports. Each trace\n        # must show a narrated search, three separately narrated fetch turns,\n        # and a cited synthesis. Per-dialog JSONL preserves every exchange.\n        env:\n          PORT: 8783\n        run: experiments/agent_cli_e2e/run_issue_781.sh\n\n      - name: \"Run agent CLI E2E — auto-learning across two harnesses (issue #715)\"\n        # The derived report names its own promotion gate\n        # `..._and_agent_cli_e2e_pass`, so the gate is only honest if a real\n        # external Agent CLI runs the task — until this step it had only ever run\n        # in formal-ai's own in-process harness. Driving both CLIs and diffing the\n        # two reports byte for byte is what makes \"all harnesses supported in the\n        # similar way\" an assertion instead of a claim.\n        timeout-minutes: 5\n        env:\n          PORT: 8879\n        run: experiments/agent_cli_e2e/run_issue_715_learning.sh\n\n      - name: \"Run agent CLI E2E — self-hosting auto-learning (issue #657)\"\n        # The self-hosting metric measures the share of a release Formal AI\n        # authored, so deriving its own learning report only inside formal-ai's\n        # in-process harness would test the claim with the one harness that\n        # cannot show it. Here formal-ai serves as the model provider for both\n        # external CLIs — Formal AI executing issue #657's task using Formal AI,\n        # with no external model and no API key — and the two reports must match\n        # byte for byte.\n        timeout-minutes: 5\n        env:\n          PORT: 8881\n        run: experiments/agent_cli_e2e/run_issue_657_metric.sh\n\n      - name: \"Run agent CLI E2E — hardcoded-language auto-learning (issue #659)\"\n        # Formal AI is the model provider while two external Agent CLIs execute\n        # a differently worded version of issue #659's learning task. Both must\n        # derive the same review-gated artifact from persisted evidence.\n        timeout-minutes: 5\n        env:\n          PORT: 8882\n        run: experiments/agent_cli_e2e/run_issue_659_learning.sh\n\n      - name: \"Run agent CLI E2E — bulk-lexeme auto-learning (issue #660)\"\n        # Formal AI is the model provider while two external Agent CLIs derive\n        # the same review-gated lessons from issue #660's persisted evidence.\n        timeout-minutes: 5\n        env:\n          PORT: 8883\n        run: experiments/agent_cli_e2e/run_issue_660_learning.sh\n\n      - name: \"Run agent CLI E2E — handler-precedence auto-learning (issue #663)\"\n        # Formal AI serves as the model provider while the real Agent CLI\n        # executes a differently-worded version of issue #663's learning task and\n        # re-derives the specialized-handler precedence itself. The authored\n        # report must match the byte-for-byte committed evidence.\n        timeout-minutes: 5\n        env:\n          PORT: 8885\n        run: experiments/agent_cli_e2e/run_issue_663_learning.sh\n\n      - name: \"Run agent CLI E2E — repository statement audit (issue #661)\"\n        # The real Agent CLI delegates the repository scan to the public release\n        # binary in its own workspace, then consumes the command result before\n        # finishing. The artifact must expose weights, provenance-backed\n        # findings, requirement conflicts, and learned associations.\n        timeout-minutes: 5\n        env:\n          PORT: 8884\n        run: experiments/agent_cli_e2e/run_issue_661_statement_audit.sh\n\n      - name: \"Replay Hive Mind self-coding inner loop (issue #655)\"\n        env:\n          PORT: 8774\n        run: |\n          examples/self-coding/run.sh\n          cargo test self_coding_session_replays\n\n      - name: Upload E2E logs on failure\n        if: failure()\n        uses: actions/upload-artifact@v7\n        with:\n          name: agent-cli-e2e-logs\n          path: |\n            /tmp/formal-ai-serve-*.log\n            /tmp/agent-out-*.log\n          retention-days: 7\n\n  # === DEPLOY WEB APP ===\n  # Deploy the production web app from src/web/ to GitHub Pages after a successful build.\n  deploy-pages:\n    name: Deploy Web App to GitHub Pages\n    needs: [build, auto-release, manual-release]\n    outputs:\n      page_url: ${{ steps.deployment.outputs.page_url }}\n      pages_sha: ${{ steps.pages_ref.outputs.sha }}\n    if: |\n      !cancelled() &&\n      needs.build.result == 'success' && (\n        (github.event_name == 'push' && github.ref == 'refs/heads/main' && needs.auto-release.result == 'success') ||\n        (github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'instant' && needs.manual-release.result == 'success')\n      )\n    runs-on: ubuntu-latest\n    # 20 min (was 15): this job now also runs `cargo doc` for the /docs/api\n    # reference, which compiles the dependency tree on a cold cargo cache.\n    timeout-minutes: 20\n    permissions:\n      contents: read\n      pages: write\n      id-token: write\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Select Pages deployment ref\n        id: pages_ref\n        env:\n          PAGES_DEPLOY_SHA: ${{ needs.auto-release.outputs.pages_sha || needs.manual-release.outputs.pages_sha || github.sha }}\n        run: |\n          if [ -z \"$PAGES_DEPLOY_SHA\" ]; then\n            echo \"::error::Could not resolve Pages deployment SHA\"\n            exit 1\n          fi\n          echo \"sha=${PAGES_DEPLOY_SHA}\" >> \"$GITHUB_OUTPUT\"\n          echo \"Pages deployment SHA: ${PAGES_DEPLOY_SHA}\"\n\n      - uses: actions/checkout@v6\n        with:\n          ref: ${{ steps.pages_ref.outputs.sha }}\n\n      - name: Configure GitHub Pages\n        uses: actions/configure-pages@v6\n\n      - name: Setup Bun\n        uses: oven-sh/setup-bun@v2\n        with:\n          bun-version-file: .bun-version\n\n      - name: Install web bundle dependencies\n        run: bun install --frozen-lockfile\n\n      - name: Build web vendor bundle\n        run: bun run build:web\n\n      # === API DOCS (/docs/api) ===\n      # The documentation hub (/docs/) links to a Rust API reference at\n      # /docs/api/. Generate it with `cargo doc` here and copy it into the Pages\n      # artifact below so it deploys alongside the rest of the site (issue #479).\n      - name: Setup Rust\n        uses: dtolnay/rust-toolchain@stable\n\n      # Reclaim runner disk before the heavy doc build: `cargo doc` plus the web\n      # bundle, the docs copy and the Pages artifact tar need headroom, and\n      # without this the runner crashed with \"No space left on device\" (#523).\n      - name: Free up runner disk space\n        run: bash scripts/free-runner-disk.sh\n\n      # IMPORTANT (issue #523): cache only the downloaded crate sources, NOT the\n      # `target/` directory. The other Rust jobs (notably `lint`, which runs\n      # `cargo clippy --all-targets --all-features`) share the same cache key and\n      # populate `target/` with a multi-gigabyte debug tree. Restoring that here\n      # on top of the web bundle and then running `cargo doc` exhausted the\n      # runner disk. `cargo doc --no-deps --lib` rebuilds its own (much smaller)\n      # `target/` from the cached registry, so we keep the registry/git cache for\n      # download speed but never restore the bloated build artifacts.\n      - name: Cache cargo registry\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n          key: ${{ runner.os }}-cargo-docs-${{ hashFiles('**/Cargo.lock') }}\n          restore-keys: |\n            ${{ runner.os }}-cargo-docs-\n\n      - name: Generate Rust API docs (cargo doc)\n        env:\n          RUSTDOCFLAGS: -D warnings\n        run: |\n          # Document just the library (lib name: formal_ai). --no-deps keeps the\n          # output small and fast. Keep rustdoc fail-closed just like rustc so a\n          # green Pages deployment cannot conceal broken API links or markup.\n          cargo doc --no-deps --lib\n          # rustdoc emits the crate docs under target/doc/formal_ai/; add a root\n          # redirect so /docs/api/ lands on the crate root instead of 404ing.\n          cat > target/doc/index.html <<'HTML'\n          <!doctype html>\n          <html lang=\"en\">\n            <head>\n              <meta charset=\"utf-8\" />\n              <meta http-equiv=\"refresh\" content=\"0; url=formal_ai/index.html\" />\n              <link rel=\"canonical\" href=\"formal_ai/index.html\" />\n              <title>formal-ai API reference</title>\n            </head>\n            <body>\n              <p>Redirecting to the <a href=\"formal_ai/index.html\">formal-ai API reference</a>&hellip;</p>\n            </body>\n          </html>\n          HTML\n\n      - name: Sync data/seed into src/web/seed (deployment mirror)\n        run: scripts/sync-seed.sh\n\n      - name: Read formal-ai version from Cargo.toml\n        id: formal_ai_version\n        run: |\n          version=\"$(sed -n 's/^version[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' Cargo.toml | head -n 1)\"\n          if [ -z \"$version\" ]; then\n            echo \"::error file=Cargo.toml::Could not read formal-ai version from Cargo.toml\"\n            exit 1\n          fi\n          echo \"version=${version}\" >> \"$GITHUB_OUTPUT\"\n          echo \"Detected formal-ai version: ${version}\"\n\n      - name: Stamp GitHub Pages artifact\n        run: scripts/stamp-pages-artifact.sh src/web \"${{ steps.pages_ref.outputs.sha }}\" \"${{ steps.pages_ref.outputs.sha }}\" \"${{ steps.formal_ai_version.outputs.version }}\"\n\n      - name: Copy Rust API docs into the Pages artifact (/docs/api)\n        run: |\n          # Copy after stamping: rustdoc's HTML carries no version placeholders,\n          # and copying post-stamp keeps stamp-pages-artifact.sh from scanning\n          # the (large) generated tree.\n          mkdir -p src/web/docs/api\n          cp -R target/doc/. src/web/docs/api/\n\n      - name: Upload GitHub Pages artifact\n        uses: actions/upload-pages-artifact@v5\n        with:\n          path: src/web\n\n      - name: Deploy Pages artifact\n        id: deployment\n        uses: actions/deploy-pages@v5\n        env:\n          # deploy-pages v5 still imports core punycode. Keep every other Node\n          # warning visible while upstream issue #434 removes this dependency.\n          NODE_OPTIONS: --disable-warning=DEP0040\n\n  # === E2E TESTS (GITHUB PAGES) ===\n  # Run Playwright tests against the live GitHub Pages URL after deployment.\n  test-e2e-pages:\n    name: E2E Tests (GitHub Pages)\n    needs: [deploy-pages]\n    if: |\n      !cancelled() &&\n      needs.deploy-pages.result == 'success'\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v6\n        with:\n          node-version: '24.x'\n          cache: npm\n          cache-dependency-path: tests/e2e/package-lock.json\n\n      - name: Install Playwright and dependencies\n        run: |\n          cd tests/e2e\n          npm ci\n\n      - name: Install Playwright browsers\n        run: |\n          cd tests/e2e\n          npx playwright install --with-deps chromium\n\n      - name: Wait for GitHub Pages deployment\n        env:\n          PAGES_DEPLOY_SHA: ${{ needs.deploy-pages.outputs.pages_sha || github.sha }}\n        run: scripts/wait-for-pages-deployment.sh \"${{ needs.deploy-pages.outputs.page_url }}\" \"$PAGES_DEPLOY_SHA\"\n\n      - name: Run GitHub Pages e2e tests\n        run: |\n          cd tests/e2e\n          PAGES_URL=\"${{ needs.deploy-pages.outputs.page_url }}\" npx playwright test --config=playwright.pages.config.js\n\n      - name: Upload Playwright report on failure\n        if: failure()\n        uses: actions/upload-artifact@v7\n        with:\n          name: playwright-report-pages\n          path: tests/e2e/playwright-report/\n          retention-days: 7\n",
