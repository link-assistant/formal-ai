[2026-07-20T08:34:36.720Z] [INFO]         "content": "474\t\n475\t      - name: Upload checksum fragment\n476\t        uses: actions/upload-artifact@v7\n477\t        with:\n478\t          name: checksums-${{ matrix.label }}\n479\t          path: desktop/release/SHA256SUMS-${{ matrix.label }}.partial\n480\t          retention-days: 7\n481\t\n482\t  vscode:\n483\t    name: Package VS Code extension (.vsix)\n484\t    needs: resolve\n485\t    if: needs.resolve.outputs.should_build == 'true'\n486\t    runs-on: ubuntu-latest\n487\t    timeout-minutes: 15\n488\t    permissions:\n489\t      contents: write\n490\t      id-token: write\n491\t      attestations: write\n492\t    defaults:\n493\t      run:\n494\t        shell: bash\n495\t    steps:\n496\t      - uses: actions/checkout@v6\n497\t        with:\n498\t          # On pull requests there is no resolved tag: build the PR head, which\n499\t          # is the whole point of the dry run.\n500\t          ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}\n501\t\n502\t      - name: Setup Node\n503\t        uses: actions/setup-node@v6\n504\t        with:\n505\t          node-version: 22\n506\t\n507\t      # No committed lockfile under vscode/ (the extension's only deps are the\n508\t      # packaging dev-tools), so a plain install is used rather than `npm ci`.\n509\t      - name: Install extension dependencies\n510\t        run: scripts/install-node-dependencies.sh vscode\n511\t\n512\t      - name: Package the .vsix\n513\t        id: package\n514\t        working-directory: vscode\n515\t        run: |\n516\t          set -euo pipefail\n517\t          # `vscode:prepublish` (prepare-resources.mjs) syncs the extension\n518\t          # version from Cargo.toml and copies src/web + data/seed + desktop/lib\n519\t          # into the package, so the .vsix is fully self-contained and its\n520\t          # filename (formal-ai-vscode-<version>.vsix) matches the release\n521\t          # version the /download and /vscode pages resolve.\n522\t          npm run package\n523\t          vsix=\"$(ls formal-ai-vscode-*.vsix 2>/dev/null | head -n1)\"\n524\t          [ -n \"$vsix\" ] || { echo \"::error::vsce package produced no .vsix\" >&2; exit 1; }\n525\t          echo \"vsix=$vsix\" >> \"$GITHUB_OUTPUT\"\n526\t          echo \"Packaged: $vsix\"\n527\t\n528\t      - name: Collect .vsix checksum fragment\n529\t        working-directory: vscode\n530\t        run: |\n531\t          set -euo pipefail\n532\t          # Same `sha256sum`-format line (bare filename) as the desktop build job\n533\t          # so the consolidated SHA256SUMS.txt covers the .vsix too, and both the\n534\t          # /download verifier and install.sh can match it by name.\n535\t          node -e '\n536\t            const fs = require(\"fs\"); const cp = require(\"crypto\");\n537\t            const n = fs.readdirSync(\".\").filter((f) => /^formal-ai-vscode-.*\\.vsix$/.test(f)).sort()[0];\n538\t            if (!n) { process.exit(1); }\n539\t            const hash = cp.createHash(\"sha256\").update(fs.readFileSync(n)).digest(\"hex\");\n540\t            process.stdout.write(hash + \"  \" + n + \"\\n\");\n541\t          ' > SHA256SUMS-vscode.partial\n542\t          cat SHA256SUMS-vscode.partial\n543\t\n544\t      # Attest before publishing; see the same step in the desktop build job.\n545\t      - name: Attest build provenance\n546\t        uses: actions/attest@v4\n547\t        with:\n548\t          subject-path: vscode/formal-ai-vscode-*.vsix\n549\t\n550\t      - name: Upload .vsix to release\n551\t        working-directory: vscode\n552\t        env:\n553\t          GH_TOKEN: ${{ github.token }}\n554\t          REPO: ${{ github.repository }}\n555\t          TAG: ${{ needs.resolve.outputs.tag }}\n556\t        run: gh release upload \"$TAG\" \"${{ steps.package.outputs.vsix }}\" --repo \"$REPO\" --clobber\n557\t\n558\t      - name: Upload checksum fragment\n559\t        uses: actions/upload-artifact@v7\n560\t        with:\n561\t          name: checksums-vscode\n562\t          path: vscode/SHA256SUMS-vscode.partial\n563\t          retention-days: 7\n564\t\n565\t  finalize:\n566\t    name: Publish SHA256SUMS.txt + provenance\n567\t    needs: [resolve, build, vscode]\n568\t    # always() so a partial matrix (one arch failing under fail-fast:false) still\n569\t    # publishes checksums for the arches that did build.\n570\t    if: ${{ always() && needs.resolve.outputs.should_build == 'true' }}\n571\t    runs-on: ubuntu-latest\n572\t    timeout-minutes: 10\n573\t    permissions:"
