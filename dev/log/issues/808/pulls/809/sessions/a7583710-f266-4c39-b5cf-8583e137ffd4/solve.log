[2026-07-20T08:26:23.611Z] [INFO]           "+    timeout-minutes: 10",
[2026-07-20T08:26:23.611Z] [INFO]           "+    if: github.event_name == 'pull_request'",
[2026-07-20T08:26:23.611Z] [INFO]           "+    steps:",
