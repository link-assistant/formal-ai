[2026-07-20T08:56:14.261Z] [INFO]           "content": "#!/usr/bin/env bash\n# check-secrets.sh\n#\n# Scans tracked files for committed credentials with secretlint\n# (CI-CD-BEST-PRACTICES.md section 11 / issue #808).\n#\n# Usage:\n#   bash scripts/check-secrets.sh [extra secretlint args...]\n#\n# Exit code 0 = no secrets found; non-zero = secretlint reported a finding.\n#\n# Why the git index rather than the `secretlint \"**/*\"` glob the js template\n# uses: that glob walks the working tree, which here includes `target/`,\n# `node_modules/` and ~150 MB of committed case-study logs, and takes longer\n# than the rest of the pipeline. Only tracked files can leak a secret through a\n# push, so `git ls-files` is both the faster and the more precise input.\n#\n# Excluded: captured third-party CI/agent logs kept verbatim as evidence. They\n# are reviewed when added and consist of redacted GitHub Actions output; the\n# only thing rescanning them on every pull request buys is minutes.\nset -euo pipefail\n\ncd \"$(dirname \"$0\")/..\"\n\nmapfile -d '' files < <(\n  git ls-files -z |\n    grep -zv -e '^docs/case-studies/.*\\.log$' -e '^dev/log/.*ci-logs/.*\\.log$'\n)\n\necho \"Scanning ${#files[@]} tracked files for secrets...\"\n\nprintf '%s\\0' \"${files[@]}\" |\n  xargs -0 npx --yes \\\n    -p secretlint \\\n    -p @secretlint/secretlint-rule-preset-recommend \\\n    secretlint \"$@\"\n\necho \"No secrets found.\"\n"
