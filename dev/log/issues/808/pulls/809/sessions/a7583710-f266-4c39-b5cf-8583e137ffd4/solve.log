[2026-07-20T08:21:39.523Z] [INFO]         "name": "Bash",
[2026-07-20T08:21:39.523Z] [INFO]         "input": {
[2026-07-20T08:21:39.523Z] [INFO]           "command": "mkdir -p /tmp/gh-issue-solver-1784535043401/experiments && cd /tmp/gh-issue-solver-1784535043401/experiments && cat > stdout-loss.cjs <<'EOF'\n// Reproduces: process.stdout.write() to a PIPE is async-buffered; a subsequent\n// process.exit() discards the pending buffer, while process.stderr.write()\n// survives. This is why [adhoc-sign-mac] debug lines never reached CI logs.\nconst big = 'x'.repeat(200);\nfor (let i = 0; i < 200; i++) process.stdout.write(`STDOUT-${i} ${big}\\n`);\nfor (let i = 0; i < 200; i++) process.stderr.write(`STDERR-${i} ${big}\\n`);\nprocess.exit(1);\nEOF\nnode stdout-loss.cjs > out.txt 2> err.txt; echo \"exit=$?\"; echo \"stdout lines kept: $(grep -c STDOUT out.txt) / 200\"; echo \"stderr lines kept: $(grep -c STDERR err.txt) / 200\"",
[2026-07-20T08:21:39.523Z] [INFO]           "description": "Reproduce stdout loss on exit"
