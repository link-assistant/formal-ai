[2026-07-20T09:10:03.899Z] [INFO]           "command": "python3 - <<'PY'\np='.github/workflows/release.yml'\ns=open(p).read()\nold = \"\"\"  # Its own job rather than a step in `lint`: the scan walks every tracked file\n  # and is slower than clippy on this repository, and there is no reason for it\n  # to delay the lint verdict. Both run in parallel on a pull request.\n  secrets-scan:\n    name: Secrets Scan\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    needs: [detect-changes]\"\"\"\nnew = \"\"\"  # Scoped to the files the change touches, not the whole tree: measured, a\n  # full-tree `secretlint \"**/*\"` (what the js template runs) had not finished\n  # after 25 minutes on this repository, because the glob walks `target/` and\n  # ~150 MB of committed case-study logs. A gate that may not finish is itself a\n  # new CI failure mode. Scanning the diff catches a credential being\n  # *introduced*, which is the case that matters, and takes ~3 seconds; run\n  # `bash scripts/check-secrets.sh --all` locally to audit everything.\n  secrets-scan:\n    name: Secrets Scan\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    needs: [detect-changes]\"\"\"\nassert s.count(old)==1\ns=s.replace(old,new)\nold2 = \"\"\"      - name: Check for secrets\n        run: bash scripts/check-secrets.sh\"\"\"\nnew2 = \"\"\"      - name: Check for secrets\n        env:\n          BASE_REF: ${{ github.base_ref || github.event.before }}\n        run: bash scripts/check-secrets.sh\"\"\"\nassert s.count(old2)==1\ns=s.replace(old2,new2)\ns=s.replace(\"\"\"  secrets-scan:\n    name: Secrets Scan\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    needs: [detect-changes]\"\"\",\"\"\"  secrets-scan:\n    name: Secrets Scan\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    needs: [detect-changes]\"\"\")\ns=s.replace(\"\"\"    steps:\n      - uses: actions/checkout@v6\n\n      - name: Setup Node\n        uses: actions/setup-node@v6\n        with:\n          node-version: 22\n\n      - name: Check for secrets\"\"\",\"\"\"    steps:\n      - uses: actions/checkout@v6\n        with:\n          # check-secrets.sh diffs against the base branch / previous commit.\n          fetch-depth: 0\n\n      - name: Setup Node\n        uses: actions/setup-node@v6\n        with:\n          node-version: 22\n\n      - name: Check for secrets\"\"\")\nopen(p,'w').write(s)\nPY\nnode -e \"const y=require('./desktop/node_modules/js-yaml');const d=y.load(require('fs').readFileSync('.github/workflows/release.yml','utf8'));console.log('ok',Object.keys(d.jobs.secrets_scan||{}));\" ; sed -n '/  secrets-scan:/,/VERSION CHECK/p' .github/workflows/release.yml"
