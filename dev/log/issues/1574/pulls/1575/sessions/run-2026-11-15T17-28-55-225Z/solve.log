\n00023| pub struct VerifiedDraft {\\n00024|     pub id: String,\\n00025|     pub source: String,\\n00026|     pub assertion_count: usize,\\n00027|     pub source_urls: Vec<String>,\\n00028|     pub source_licenses: Vec<String>,\\n00029|     pub composition: String,\\n00030| }\\n00031| \\n00032| /// A typed, lowered candidate for which no executable semantic oracle was\\n00033| /// available. This must never be rendered as \\\"tests passed\\\".\\n00034| #[derive(Debug, Clone, PartialEq, Eq)]\\n00035| pub struct UnverifiedDraft {\\n00036|     pub id: String,\\n00037|     pub source: String,\\n00038|     pub source_urls: Vec<String>,\\n00039|     pub source_licenses: Vec<String>,\\n00040|     pub composition: String,\\n00041|     pub detail: String,\\n00042| }\\n00043| \\n00044| #[derive(Debug, Clone, Default, PartialEq, Eq)]\\n00045| pub struct CompositionOutcome {\\n00046|     pub selected: Option<VerifiedDraft>,\\n00047|     pub unverified: Vec<UnverifiedDraft>,\\n00048|     pub attempts: Vec<DraftAttempt>,\\n00049|     /// Source-backed pieces which were requested but unavailable. A blocked\\n00050|     /// part is data for rediscovery, never an empty-string program fragment.\\n00051|     pub blocked_needs: Vec<Need>,\\n00052|     pub research_trail: String,\\n00053| }\\n00054| \\n00055| #[derive(Debug, Clone, PartialEq, Eq)]\\n00056| pub(super) struct MissingFragment {\\n00057|     id: String,\\n00058| }\\n00059| \\n00060| impl MissingFragment {\\n00061|     fn new(id: &str) -> Self {\\n00062|         Self { id: id.to_owned() }\\n00063|     }\\n00064| }\\n00065| \\n00066| /// Catalog-bound rendering without a closure-captured argument lifetime.\\n00067| ///\\n00068| /// Each method call borrows its replacement slice independently. This matters\\n00069| /// for composition, where most calls pass temporary arrays containing local\\n00070| /// strings; a local closure would infer one shared lifetime for all calls and\\n00071| /// incorrectly keep the first temporary