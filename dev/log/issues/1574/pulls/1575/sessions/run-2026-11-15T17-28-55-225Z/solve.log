0| \\n00811| fn derived_examples(spec: &CodingTaskSpec, concepts: &ConceptMap) -> Vec<Example> {\\n00812|     let structures = concepts.structure_ids();\\n00813|     let has = |id: &str| structures.iter().any(|structure| structure == id);\\n00814|     let example = |arguments: &[&str], expected: &str| Example {\\n00815|         arguments: arguments.iter().map(|value| (*value).to_owned()).collect(),\\n00816|         expected: expected.to_owned(),\\n00817|     };\\n00818|     if has(\\\"tuple_of\\\") && has(\\\"reduce_sum\\\") && has(\\\"reduce_product\\\") {\\n00819|         return vec![\\n00820|             example(&[\\\"[]\\\"], \\\"(0, 1)\\\"),\\n00821|             example(&[\\\"[1, 2, 3]\\\"], \\\"(6, 6)\\\"),\\n00822|         ];\\n00823|     }\\n00824|     if has(\\\"quantifier_any\\\") && has(\\\"pairwise_distinct\\\") && has(\\\"predicate_abs_diff_lt\\\") {\\n00825|         return vec![\\n00826|             example(&[\\\"[1.0, 2.0, 3.0]\\\", \\\"0.5\\\"], \\\"False\\\"),\\n00827|             example(&[\\\"[1.0, 2.8, 3.0]\\\", \\\"0.3\\\"], \\\"True\\\"),\\n00828|         ];\\n00829|     }\\n00830|     if has(\\\"reduce_count\\\") && has(\\\"vowel_character_class\\\") {\\n00831|         return vec![example(&[\\\"'hello'\\\"], \\\"2\\\"), example(&[\\\"'sky'\\\"], \\\"0\\\")];\\n00832|     }\\n00833|     if has(\\\"set_intersection\\\") {\\n00834|         return vec![\\n00835|             example(&[\\\"(3, 4, 5, 6)\\\", \\\"(5, 7, 4, 10)\\\"], \\\"(4, 5)\\\"),\\n00836|             example(&[\\\"(1, 2)\\\", \\\"(3, 4)\\\"], \\\"()\\\"),\\n00837|         ];\\n00838|     }\\n00839|     if has(\\\"distinct_elements\\\") && (has(\\\"reduce_count\\\") || has(\\\"reduce_len\\\")) {\\n00840|         return vec![example(&[\\\"[1, 1, 2, 3]\\\"], \\\"3\\\"), example(&[\\\"[]\\\"], \\\"0\\\")];\\n00841|     }\\n00842|     if has(\\\"range_inclusive\\\") {\\n00843|         if spec.parameters.is_empty() {\\n00844|             if let Some(bound) = first_positive_integer(&spec.