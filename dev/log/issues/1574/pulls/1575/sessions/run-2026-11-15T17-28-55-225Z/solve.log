[must_use]\\n00116| pub fn compose(spec: &CodingTaskSpec, concepts: &ConceptMap) -> CompositionOutcome {\\n00117|     let catalog = FragmentCatalog::bootstrap();\\n00118|     let programs = crate::coding::composition_search::search_with_structures(\\n00119|         spec,\\n00120|         &catalog,\\n00121|         crate::coding::composition_search::SearchBounds::default(),\\n00122|         &concepts.structure_ids(),\\n00123|     );\\n00124|     compose_with_ir(spec, concepts, &catalog, programs)\\n00125| }\\n00126| \\n00127| /// Compose ordinary retrieved parts together with already-elaborated IR.\\n00128| ///\\n00129| /// Procedure retrieval calls this entry point so its ordered steps enter the\\n00130| /// same verification and least-action selection path as every other source.\\n00131| #[must_use]\\n00132| pub fn compose_with_ir(\\n00133|     spec: &CodingTaskSpec,\\n00134|     concepts: &ConceptMap,\\n00135|     catalog: &FragmentCatalog,\\n00136|     programs: impl IntoIterator<Item = ProgramIr>,\\n00137| ) -> CompositionOutcome {\\n00138|     let derived = if spec.examples.is_empty() {\\n00139|         derived_examples(spec, concepts)\\n00140|     } else {\\n00141|         Vec::new()\\n00142|     };\\n00143|     let examples = if spec.examples.is_empty() {\\n00144|         if derived.is_empty() {\\n00145|             source_examples(concepts)\\n00146|         } else {\\n00147|             derived.clone()\\n00148|         }\\n00149|     } else {\\n00150|         spec.examples.clone()\\n00151|     };\\n00152|     let mut drafts = Vec::new();\\n00153|     let mut blocked_needs = Vec::new();\\n00154|     for structure_id in concepts.structure_ids() {\\n00155|         let available = catalog.get(&structure_id).is_some()\\n00156|             || catalog.fragments().iter().any(|fragment| {\\n00157|                 fragment\\n00158|                     .supports\\n00159|                     .iter()\\n00160|                     .any(|supported| supported == &structure_id)\\n00161|             });\\n00162|         if !available {\\n00163|             blocked_needs.push(blocked_fragment_need(\\n00164|                 spec,\\n00165|                 &MissingFragment::new(&structure_id),\\n00166|             ));\\n00167|         }\\n00168|     }\\n00169|     for (search_rank, program) in programs.into_iter().enumerate() {\\n00170|         match ir_draft(spec, catalog, program, search_rank) {\\n00171|             Ok(Some(draft)) => {\\n00172|                 drafts.push(draft);\\n00173|             }\\n00174|             Ok(None) => {}\\n00175|             Err(missing) => blocked_needs.push(blocked_fragment_need(spec, &missing)),\\n00176|         }\\n00177|     }\\n00178|     if spec.language == \\\"python\\\" && spec.artifact_shape == ArtifactShape::Function {\\n00179|         match candidate_drafts(spec, concepts, catalog) {\\n00180|             Ok(found) => drafts.extend(found),\\n00181|             Err(missing) => blocked_needs.push(blocked_fragment_need(spec, &missing)),\\n00182|         }\\n00183|     }\\n00184|     // Issue #1487: examples derived from the requirement share its reading, so\\n00185|     // a negation, count, disjunction or comparison no discovered part reads\\n00186|     // cannot be checked by them. It stays an unresolved need and no draft is\\n00187|     // claimed; examples the request itself states, or a source documents,\\n00188|     // remain an independent oracle.\\n00189|     let unread = if derived.is_empty() {\\n00190|         String::new()\\n00191|     } else {\\n00192|         crate::coding::unread_structure::unread_structure(\\n00193|             &spec.requirement_sentences.join(\\\" \\\"),\\n00194|             &concepts.structure_ids(),\\n00195|         )\\n00196|     };\\n00197|     if !unread.is_empty() {\\n00198|         let raised_by = format!(\\\"composition:{}\\\", spec.name);\\n00199|         let subject = format!(\\\"structure:{unread}\\\");\\n00200|         blocked_needs.push(Need::raised(\\n00201|             NeedKind::Concept,\\n00202|             &subject,\\n00203|             &spec.prose_language,\\n00204|             &raised_by,\\n00205|         ));\\n00206|         drafts.clear();\\n00207|     }\\n00208|     if spec.language == \\\"python\\\"\\n00209|         && spec.artifact_shape == ArtifactShape::Function\\n00210|         && !examples.is_empty()\\n00211|         && !drafts.is_empty()\\n00212|         && let Err(missing) = template(catalog, \\\"python_test_entrypoint\\\", &[])\\n00213|     {\\n00214|         blocked_needs.push(blocked_fragment_need(spec, &missing));\\n00215|         drafts.clear();\\n00216|     }\\n00217|     blocked_needs.sort_by(|left, right| left.need_id.cmp(&right.need_id));\\n00218|     blocked_needs.dedup_by(|left, right| left.need_id == right.need_id);\\n00219|     let mut attempts = Vec::new();\\n00220|     let mut passing = Vec::new();\\n00221|     let mut unverified = Vec::new();\\n00222|     for draft in drafts {\\n00223|         if !syntax_is_valid(&spec.language, &draft.source) {\\n00224|             attempts.push(DraftAttempt {\\n00225|                 id: draft.id,\\n00226|                 passed: false,\\n00227|                 detail: crate::coding::python_render::runtime_template(\\n00228|                     \\\"coding_invalid_cst\\\",\\n00229|                     &[(\\\"language\\\", &spec.language)],\\n00230|                 )\\n00231|                 .unwrap_or_else(|| String::from(\\\"coding_invalid_cst\\\")),\\n00232|             });\\n00233|             continue;\\n00234|         }\\n00235|         if draft.typed_ir && spec.artifact_shape == ArtifactShape::Function && examples.is_empty() {\\n00236|             let detail = \\\"unverified:no_executable_oracle;typed_and_lowered\\\".to_owned();\\n00237|             attempts.push(DraftAttempt {\\n00238|                 id: draft.id.clone(),\\n00239|                 passed: false,\\n00240|                 detail: detail.clone(),\\n00241|             });\\n00242|             unverified.push((draft, detail));\\n00243|             continue;\\n00244|         }\\n00245|         let (passed, detail) = verify(spec, &draft, &examples, concepts, catalog);\\n00246|         attempts.push(DraftAttempt {\\n00247|             id: draft.id.clone(),\\n00248|             passed,\\n00249|             detail,\\n00250|         });\\n00251|         if passed {\\n00252|             passing.push(draft);\\n00253|         }\\n00254|     }\\n00255|     passing.sort_by(|left, right| {\\n00256|         right\\n00257|             .referenced_params\\n00258|             .cmp(&left.referenced_params)\\n00259|             .then_with(|| left.action_cost.cmp(&right.action_cost))\\n00260|             .then_with(|| left.source.len().cmp(&right.source.len()))\\n00261|             .then_with(|| left.search_rank.cmp(&right.search_rank))\\n00262|             .then_with(|| left.id.cmp(&right.id))\\n00263|     });\\n00264|     unverified.sort_by(|(left, _), (right, _)| {\\n00265|         right\\n00266|             .referenced_params\\n00267|             .cmp(&left.referenced_params)\\n00268|             .then_with(|| left.action_cost.cmp(&right.action_cost))\\n00269|             .then_with(|| left.source.len().cmp(&right.source.len()))\\n00270|             .then_with(|| left.search_rank.cmp(&right.search_rank))\\n00271|             .then_with(|| left.id.cmp(&right.id))\\n00272|     });\\n00273|     let selected = passing.into_iter().next().map(|draft| VerifiedDraft {\\n00274|         id: draft.id,\\n00275|         source: draft.source,\\n00276|         assertion_count: if spec.artifact_shape == ArtifactShape::Program {\\n00277|             1\\n00278|         } else {\\n00279|             examples.len()\\n00280|         },\\n00281|         source_urls: draft.source_urls,\\n00282|         source_licenses: draft.source_licenses,\\n00283|         composition: draft.composition,\\n00284|     });\\n00285|     let research_trail = if selected.is_some() {\\n00286|         render_comparison(&attempts)\\n00287|     } else {\\n00288|         render_failure_trail(spec, concepts, &examples, &attempts, &blocked_needs)\\n00289|     };\\n00290|     CompositionOutcome {\\n00291|         selected,\\n00292|         unverified: unverified\\n00293|             .into_iter()\\n00294|             .map(|(draft, detail)| UnverifiedDraft {\\n00295|                 id: draft.id,\\n00296|                 source: draft.source,\\n00297|                 source_urls: draft.source_urls,\\n00298|                 source_licenses: draft.source_licenses,\\n00299|                 composition: draft.composition,\\n00300|                 detail,\\n00301|             })\\n00302|             .collect(),\\n00303|         attempts,\\n00304|         blocked_needs,\\n00305|         research_trail,\\n00306|     }\\n00307| }\\n00308| \\n00309| /// Whether the top-level fragment's driving iteration is bounded by a\\n00310| /// constant: its sequence-typed slot is filled without reading any of the\\n00311| /// program's parameters. Returns 1 in that case, 0 otherwise.\\n00312| fn constant_bounded_domain(program: &ProgramIr, catalog: &FragmentCatalog) -> usize {\\n00313|     let mut current = &program.body;\\n00314|     while let IrNode::Return { value } | IrNode::Emit { value } = current {\\n00315|         current = value;\\n00316|     }\\n00317|     let IrNode::Apply {\\n00318|         fragment,\\n00319|         arguments,\\n00320|     } = current\\n00321|     else {\\n00322|         return 0;\\n00323|     };\\n00324|     let Some(definition) = catalog.get(fragment) else {\\n00325|         return 0;\\n00326|     };\\n00327|     let Some(slot) = definition\\n00328|         .signature\\n00329|         .iter()\\n00330|         .position(|ty| matches!(ty, IrType::Sequence(_)))\\n00331|     else {\\n00332|         return 0;\\n00333|     };\\n00334|     let Some(domain) = arguments.get(slot) else {\\n00335|         return 0;\\n00336|     };\\n00337|     let input_names = program\\n00338|         .parameters\\n00339|         .iter()\\n00340|         .map(|(name, _)| name.as_str())\\n00341|         .collect::<Vec<_>>();\\n00342|     let reads_input = |node: &IrNode| -> bool {\\n00343|         let mut stack = vec![node];\\n00344|         while let Some(current) = stack.pop() {\\n00345|             match current {\\n00346|                 IrNode::Parameter { name, .. } => {\\n00347|                     if input_names.contains(&name.as_str()) {\\n00348|                         return true;\\n00349|                     }\\n00350|                 }\\n00351|                 IrNode::Apply { arguments, .. } => stack.extend(arguments),\\n00352|                 IrNode::Literal { .. } => {}\\n00353|                 _ => return false,\\n00354|             }\\n00355|         }\\n00356|         false\\n00357|     };\\n00358|     usize::from(!reads_input(domain))\\n00359| }\\n00360| \\n00361| fn ir_draft(\\n00362|     spec: &CodingTaskSpec,\\n00363|     catalog: &FragmentCatalog,\\n00364|     program: ProgramIr,\\n00365|     search_rank: usize,\\n00366| ) -> Result<Option<Draft>, MissingFragment> {\\n00367|     if let Some(id) = program\\n00368|         .fragments\\n00369|         .iter()\\n00370|         .find(|fragment| catalog.get(fragment).is_none())\\n00371|     {\\n00372|         return Err(MissingFragment::new(id));\\n00373|     }\\n00374|     if program.type_check(catalog).is_err() {\\n00375|         return Ok(None);\\n00376|     }\\n00377|     let Some(lowering) = crate::coding::ir_lowering::lowering_for(&spec.language) else {\\n00378|         return Ok(None);\\n00379|     };\\n00380|     let Ok(source) = lowering.lower(&program, catalog) else {\\n00381|         return Ok(None);\\n00382|     };\\n00383|     // The prompt's declared surface travels with the derived artifact: a\\n00384|     // signature the task itself spelled out (annotations, return, imports)\\n00385|     // is echoed verbatim, never reconstructed from the unified types — the\\n00386|     // reconstruction would drop the spelling's own import (`List[float]`\\n00387|     // needs `from typing import List`) and with it the artifact's\\n00388|     // executability (issue #1085 upstream transfer, HumanEval/0).\\n00389|     let source = echo_declared_surface(spec, source);\\n00390|     let content_id = program.content_id();\\n00391|     let mut action_cost = program.action_cost();\\n00392|     // A draft whose driving iteration runs over a constant performs\\n00393|     // input-independent action: its work is bounded by the constant, not by\\n00394|     // the task's input, so agreement with the examples is coincidence. Such\\n00395|     // a draft owes the unexamined input as extra action.\\n00396|     action_cost += 4 * constant_bounded_domain(&program, catalog);\\n00397|     // A literal the search introduced is an assumption no oracle justified:\\n00398|     // each one owes extra action, so among verifying drafts the composition\\n00399|     // that reads the task's inputs outranks an equally cheap one that\\n00400|     // guesses a constant.\\n00401|     action_cost += crate::coding::composition_search::literal_leaves(&program.body);\\n00402|     let parameter_names: Vec<&str> = spec\\n00403|         .parameters\\n00404|         .iter()\\n00405|         .map(|parameter| parameter.name.as_str())\\n00406|         .collect();\\n00407|     let referenced_params =\\n00408|         crate::coding::composition_search::parameter_reads(&program.body, &parameter_names);\\n00409|     let composition = format!(\\n00410|         \\\"typed_search({})\\\",\\n00411|         program.composition_notation(|id| {\\n00412|             catalog\\n00413|                 .get(id)\\n00414|                 .is_some_and(|fragment| fragment.kind == FragmentKind::Meaning)\\n00415|         })\\n00416|     );\\n00417|     Ok(Some(Draft {\\n00418|         id: content_id,\\n00419|         source,\\n00420|         callable_name: program.name,\\n00421|         source_urls: program.source_urls,\\n00422|         source_licenses: program.source_licenses,\\n00423|         composition,\\n00424|         action_cost,\\n00425|         typed_ir: true,\\n00426|         search_rank,\\n00427|         referenced_params,\\n00428|     }))\\n00429| }\\n00430| \\n00431| #[cfg(feature = \\\"meta-language\\\")]\\n00432| fn syntax_is_valid(language: &str, source: &str) -> bool {\\n00433|     crate::coding::validated_program_cst(language, source).is_some()\\n00434| }\\n00435| \\n00436| #[cfg(not(feature = \\\"meta-language\\\"))]\\n00437| fn syntax_is_valid(_language: &str, _source: &str) -> bool {\\n00438|     true\\n00439| }\\n00440| \\n00441| /// Echo the prompt's declared signature into a lowered artifact. The search\\n00442| /// unifies types to find the composition; the surface the task declared —\\n00443| /// parameter spellings, the return annotation, the import block — stays the\\n00444| /// task's own words, ahead of anything the lowering hoisted.\\n00445| fn echo_declared_surface(spec: &CodingTaskSpec, source: String) -> String {\\n00446|     let declared_signature = spec\\n00447|         .parameters\\n00448|         .iter()\\n00449|         .any(|parameter| parameter.annotation.is_some())\\n00450|         || spec.return_annotation.is_some();\\n00451|     if !declared_signature && spec.imports.is_empty() {\\n00452|         return source;\\n00453|     }\\n00454|     let had_trailing_newline = source.ends_with('\\\\n');\\n00455|     let is_import_line = |line: &str| line.starts_with(\\\"import \\\") || line.starts_with(\\\"from \\\");\\n00456|     let mut rest = source.lines().peekable();\\n00457|     let mut imports: Vec<&str> = spec.imports.iter().map(String::as_str).collect();\\n00458|     while let Some(line) = rest.peek().copied() {\\n00459|         if !is_import_line(line) {\\n00460|             break;\\n00461|         }\\n00462|         if !imports.contains(&line) {\\n00463|             imports.push(line);\\n00464|         }\\n00465|         rest.next();\\n00466|     }\\n00467|     let mut lines: Vec<String> = imports.iter().map(|line| (*line).to_owned()).collect();\\n00468|     if !lines.is_empty() {\\n00469|         // Imports and the definition are separate paragraphs (PEP 8).\\n00470|         if rest.peek().is_some_and(|line| line.trim().is_empty()) {\\n00471|             rest.next();\\n00472|         }\\n00473|         lines.push(String::new());\\n00474|     }\\n00475|     lines.extend(rest.map(str::to_owned));\\n00476|     if declared_signature\\n00477|         && let Some(index) = lines.iter().position(|line| line.starts_with(\\\"def \\\"))\\n00478|         && let Some(rewritten) = echo_signature_line(spec, &lines[index])\\n00479|     {\\n00480|         lines[index] = rewritten;\\n00481|     }\\n00482|     let mut joined = lines.join(\\\"\\\\n\\\");\\n00483|     if had_trailing_newline {\\n00484|         joined.push('\\\\n');\\n00485|     }\\n00486|     joined\\n00487| }\\n00488| \\n00489| /// One `def` line with the declared spellings restored: parameters keep\\n00490| /// their declared annotation verbatim (open ones keep what the lowering\\n00491| /// rendered), and the declared return travels before the colon.\\n00492| fn echo_signature_line(spec: &CodingTaskSpec, line: &str) -> Option<String> {\\n00493|     let open = line.find('(')?;\\n00494|     // `matching_close_paren` returns the index one past the closing paren.\\n00495|     let close = matching_close_paren(line, open)?;\\n00496|     if line[close..].trim() != \\\":\\\" {\\n00497|         return None;\\n00498|     }\\n00499|     let rendered = split_top_level_commas(&line[open + 1..close - 1])\\n00500|         .iter()\\n00501|         .map(|raw| {\\n00502|             let name = raw.split(':').next().unwrap_or(raw).trim();\\n00503|             spec.parameters\\n00504|                 .iter()\\n00505|                 .find(|parameter| parameter.name == name)\\n00506|                 .and_then(|parameter| parameter.annotation.as_deref())\\n00507|                 .map_or_else(\\n00508|                     || (*raw).to_owned(),\\n00509|                     |annotation| format!(\\\"{}: {annotation}\\\", name.trim_start_matches('*')),\\n00510|                 )\\n00511|         })\\n00512|         .collect::<Vec<_>>()\\n00513|         .join(\\\", \\\");\\n00514|     let return_annotation = spec\\n00515|         .return_annotation\\n00516|         .as_deref()\\n00517|         .map_or_else(String::new, |annotation| format!(\\\" -> {annotation}\\\"));\\n00518|     Some(format!(\\\"{}({rendered}){return_annotation}:\\\", &line[..open]))\\n00519| }\\n00520| \\n00521| /// Distinct declared parameters a rendered draft's source names. Drafts\\n00522| /// assembled from retrieved parts have no IR to walk, so their identifiers\\n00523| /// are read from the rendered source with the same lexical scan the search\\n00524| /// uses for scope.\\n00525| fn source_referenced_parameters(spec: &CodingTaskSpec, source: &str) -> usize {\\n00526|     let tokens = crate::coding::composition_search::python_tokens(source);\\n00527|     spec.parameters\\n00528|         .iter()\\n00529|         .filter(|parameter| tokens.iter().any(|token| token =[REDACTED] &parameter.name))\\n00530|         .count()\\n00531| }\\n00532| \\n00533| fn candidate_drafts(\\n00534|     spec: &CodingTaskSpec,\\n00535|     concepts: &ConceptMap,\\n00536|     catalog: &FragmentCatalog,\\n00537| ) -> Result<Vec<Draft>, MissingFragment> {\\n00538|     concepts\\n00539|         .needs\\n00540|         .iter()\\n00541|         .flat_map(|need| need.candidates.iter())\\n00542|         .map(|candidate| candidate_draft(spec, candidate, catalog))\\n00543|         .filter_map(Result::transpose)\\n00544|         .collect()\\n00545| }\\n00546| \\n00547| fn candidate_draft(\\n00548|     spec: &CodingTaskSpec,\\n00549|     candidate: &CandidatePart,\\n00550|     catalog: &FragmentCatalog,\\n00551| ) -> Result<Option<Draft>, MissingFragment> {\\n00552|     let ren