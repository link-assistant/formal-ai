    if trimmed.strip_prefix(\\\"def \\\").is_none() {\\n00671|         return Some(trimmed.to_owned());\\n00672|     }\\n00673|     let first_line = trimmed.lines().next()?;\\n00674|     let open = first_line.find('(')?;\\n00675|     let close = first_line.rfind(')')?;\\n00676|     let original = first_line[open + 1..close]\\n00677|         .split(',')\\n00678|         .map(str::trim)\\n00679|         .collect::<Vec<_>>();\\n00680|     if original.len() != spec.parameters.len() {\\n00681|         return None;\\n00682|     }\\n00683|     let body = trimmed.lines().skip(1).collect::<Vec<_>>();\\n00684|     let indentation = body\\n00685|         .iter()\\n00686|         .filter(|line| !line.trim().is_empty())\\n00687|         .map(|line| line.len() - line.trim_start().len())\\n00688|         .min()\\n00689|         .unwrap_or(0);\\n00690|     let mut body = body\\n00691|         .iter()\\n00692|         .map(|line| line.get(indentation..).unwrap_or(line).to_owned())\\n00693|         .collect::<Vec<_>>()\\n00694|         .join(\\\"\\\\n\\\");\\n00695|     for (from, to) in original.iter().zip(&spec.parameters) {\\n00696|         body = body.replace(from, &to.name);\\n00697|     }\\n00698|     Some(body)\\n00699| }\\n00700| \\n00701| fn verify(\\n00702|     spec: &CodingTaskSpec,\\n00703|     draft: &Draft,\\n00704|     examples: &[Example],\\n00705|     concepts: &ConceptMap,\\n00706|     catalog: &FragmentCatalog,\\n00707| ) -> (bool, String) {\\n00708|     if spec.language == \\\"python\\\"\\n00709|         && spec.artifact_shape == ArtifactShape::Function\\n00710|         && examples.is_empty()\\n00711|     {\\n00712|         return (false, \\\"no executable examples or derived tests\\\".to_owned());\\n00713|     }\\n00714|     let mut script = draft.source.clone();\\n00715|     if spec.language == \\\"python\\\" && spec.artifact_shape == ArtifactShape::Function {\\n00716|         let Ok(entrypoint) = template(catalog, \\\"python_test_entrypoint\\\", &[]) else {\\n0