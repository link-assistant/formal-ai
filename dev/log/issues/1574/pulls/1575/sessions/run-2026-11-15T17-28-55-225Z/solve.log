[2026-11-15T17:22:55.839Z] [INFO]       "output": "<file>\n00001| use formal_ai::coding_task_spec::{ArtifactShape, CodingTaskSpec, Example, Parameter};\n00002| use formal_ai::composition::{VerifiedDraft, compose};\n00003| use formal_ai::concept_discovery::{\n00004|     ConceptMap, ConceptRequirement, StructuralMeaning, structural_meanings,\n00005| };\n00006| use formal_ai::needs::NeedState;\n00007| \n00008| fn task(\n00009|     name: &str,\n00010|     parameters: &[&str],\n00011|     requirement: &str,\n00012|     examples: &[(&[&str], &str)],\n00013| ) -> CodingTaskSpec {\n00014|     CodingTaskSpec {\n00015|         language: \"python\".to_owned(),\n00016|         artifact_shape: ArtifactShape::Function,\n00017|         callable_binding_origin: formal_ai::coding_task_spec::CallableBindingOrigin::Declared {\n00018|             signature: String::new(),\n00019|         },\n00020|         name: name.to_owned(),\n00021|         parameters: parameters\n00022|             .iter()\n00023|             .map(|name| Parameter {\n00024|                 name: (*name).to_owned(),\n00025|                 annotation: None,\n00026|             })\n00027|             .collect(),\n00028|         return_annotation: None,\n00029|         imports: Vec::new(),\n00030|         requirement_sentences: vec![requirement.to_owned()],\n00031|         examples: examples\n00032|             .iter()\n00033|             .map(|(arguments, expected)| Example {\n00034|                 arguments: arguments.iter().map(|value| (*value).to_owned()).collect(),\n00035|                 expected: (*expected).to_owned(),\n00036|             })\n00037|             .collect(),\n00038|         expected_stdout: None,\n00039|         prose_language: \"en\".to_owned(),\n00040|     }\n00041| }\n00042| \n00043| fn concepts(ids: &[&str]) -> ConceptMap {\n00044|     let registry = structural_meanings();\n00045|     let structures = ids\n00046|         .iter()\n00047|         .map(|id| {\n00048|             registry\n00049|                 .iter()\n00050|                 .find(|meaning| meaning.id == *id)\n00051|                 .cloned()\n00052|                 .unwrap_or_else(|| StructuralMeaning {\n00053|                     id: (*id).to_owned(),\n00054|                     idiom: String::new(),\n00055|                     grounding: String::new(),\n00056|                 })\n00057|         })\n00058|         .collect();\n00059|     ConceptMap {\n00060|         needs: vec![ConceptRequirement::new(\n00061|             \"held-out structural requirement\",\n00062|             \"en\",\n00063|             NeedState::Satisfied,\n00064|             structures,\n00065|             Vec::new(),\n00066|         )],\n00067|         evidence: Vec::new(),\n00068|     }\n00069| }\n00070| \n00071| fn selected(\n00072|     ids: &[&str],\n00073|     name: &str,\n00074|     parameters: &[&str],\n00075|     requirement: &str,\n00076|     examples: &[(&[&str], &str)],\n00077| ) -> VerifiedDraft {\n00078|     let outcome = compose(\n00079|         &task(name, parameters, requirement, examples),\n00080|         &concepts(ids),\n00081|     );\n00082|     let selected = outcome\n00083|         .selected\n00084|         .unwrap_or_else(|| panic!(\"no draft passed for {name}: {:#?}\", outcome.attempts));\n00085|     assert!(\n00086|         selected\n00087|             .source_urls\n00088|             .iter()\n00089|             .all(|url| url.starts_with(\"https://\")),\n00090|         \"{selected:#?}\"\n00091|     );\n00092|     assert!(\n00093|         selected.composition.starts_with(\"typed_search(\"),\n00094|         \"the held-out corpus must be produced by typed fragment search, not a legacy shape generator: {selected:#?}\"\n00095|     );\n00096|     selected\n00097| }\n00098| \n00099| #[test]\n00100| fn held_out_arithmetic_scan_and_geometry_schemas_execute() {\n00101|     selected(\n00102|         &[\"arithmetic_fractional_part\"],\n00103|         \"remainder_below_one\",\n00104|         &[\"quantity\"],\n00105|         \"Return the fractional remainder.\",\n00106|         &[(&[\"8.625\"], \"0.625\")],\n00107|     );\n00108|     selected(\n00109|         &[\"reduce_mean\", \"absolute_deviation\"],\n00110|         \"average_distance_from_center\",\n00111|         &[\"samples\"],\n00112|         \"Average the absolute distance from the mean.\",\n00113|         &[(&[\"[1, 2, 6]\"], \"2.0\")],\n00114|     );\n00115|     selected(\n00116|         &[\"running_prefix\", \"prefix_negative\", \"quantifier_any\"],\n00117|         \"ever_crosses_floor\",\n00118|         &[\"changes\"],\n00119|         \"Whether any running total falls below zero.\",\n00120|         &[(&[\"[3, -1, -5]\"], \"True\"), (&[\"[2, 1, 4]\"], \"False\")],\n00121|     );\n00122|     let geometry = selected(\n00123|         &[\"geometric_measure\"],\n00124|         \"half_product_measure\",\n00125|         &[\"base\", \"height\"],\n00126|         \"Calculate a geometric area from its dimensions.\",\n00127|         &[(&[\"6\", \"5\"], \"15.0\"), (&[\"4\", \"3\"], \"6.0\")],\n00128|     );\n00129|     assert!(geometry.source.contains('/') && geometry.source.contains('*'));\n00130| }\n00131| \n00132| #[test]\n00133| fn held_out_sequence_and_symmetry_schemas_execute() {\n00134|     selected(\n00135|         &[\"interpose_each\"],\n00136|         \"weave_marker\",\n00137|         &[\"values\", \"marker\"],\n00138|         \"Place the marker between consecutive values.\",\n00139|         &[(&[\"[3, 5, 8]\", \"0\"], \"[3, 0, 5, 0, 8]\")],\n00140|     );\n00141|     selected(\n00142|         &[\"balanced_delimiter_groups\"],\n00143|         \"partition_balanced_runs\",\n00144|         &[\"symbols\"],\n00145|         \"Separate adjacent balanced groups.\",\n00146|         &[(&[\"'(())()'\"], \"['(())', '()']\")],\n00147|     );\n00148|     selected(\n00149|         &[\"group_max_nesting\"],\n00150|         \"depth_per_run\",\n00151|         &[\"runs\"],\n00152|         \"Return maximum nesting for each group.\",\n00153|         &[(&[\"'(()) ()'\"], \"[2, 1]\")],\n00154|     );\n00155|     selected(\n00156|         &[\"prefix_enumeration\"],\n00157|         \"growing_leading_slices\",\n00158|         &[\"word\"],\n00159|         \"List all prefixes from shortest to longest.\",\n00160|         &[(&[\"'wxyz'\"], \"['w', 'wx', 'wxy', 'wxyz']\")],\n00161|     );\n00162|     selected(\n00163|         &[\"zero_based_range\", \"stringify_each\", \"join_with_space\"],\n00164|         \"render_counter_line\",\n00165|         &[\"limit\"],\n00166|         \"Create a space-delimited string starting at zero.\",\n00167|         &[(&[\"3\"], \"'0 1 2 3'\")],\n00168|     );\n00169|     selected(\n00170|         &[\"palindrome_extension\"],\n00171|         \"finish_mirror_word\",\n00172|         &[\"text\"],\n00173|         \"Append the minimum suffix needed for the shortest palindrome.\",\n00174|         &[(&[\"'race'\"], \"'racecar'\")],\n00175|     );\n00176|     selected(\n00177|         &[\"stable_longest\"],\n00178|         \"first_widest_label\",\n00179|         &[\"labels\"],\n00180|         \"Return the longest one, preserving the first tie.\",\n00181|         &[(&[\"['aa', 'bbbb', 'cccc']\"], \"'bbbb'\")],\n00182|     );\n00183| }\n00184| \n00185| #[test]\n00186| fn held_out_relation_ordering_and_pattern_schemas_execute() {\n00187|     selected(\n00188|         &[\"bounded_top\"],\n00189|         \"greatest_sample\",\n00190|         &[\"samples\", \"amount\"],\n00191|         \"Select the requested number of largest items.\",\n00192|         &[(&[\"[7, 1, 9, 3]\", \"2\"], \"[9, 7]\")],\n00193|     );\n00194|     selected(\n00195|         &[\"bounded_bottom\"],\n00196|         \"least_sample\",\n00197|         &[\"samples\", \"amount\"],\n00198|         \"Select the requested number of smallest items.\",\n00199|         &[(&[\"[7, 1, 9, 3]\", \"3\"], \"[1, 3, 7]\")],\n00200|     );\n00201|     selected(\n00202|         &[\"power_square_each\"],\n00203|         \"second_powers\",\n00204|         &[\"values\"],\n00205|         \"Square each member.\",\n00206|         &[(&[\"[-3, 0, 4]\"], \"[9, 0, 16]\")],\n00207|     );\n00208|     selected(\n00209|         &[\"keyed_sum_order\"],\n00210|         \"rank_rows_by_total\",\n00211|         &[\"rows\"],\n00212|         \"Sort rows in ascending order by row sum.\",\n00213|         &[(&[\"[[4, 1], [-2, 1], [3, 0]]\"], \"[[-2, 1], [3, 0], [4, 1]]\")],\n00214|     );\n00215|     selected(\n00216|         &[\"frequency_rank\"],\n00217|         \"two_frequent_tokens\",\n00218|         &[\"tokens\"],\n00219|         \"Return the most common tokens.\",\n00220|         &[(&[\"['z', 'a', 'z', 'b', 'a', 'z']\"], \"[('z', 3), ('a', 2)]\")],\n00221|     );\n00222| }\n00223| \n00224| #[test]\n00225| fn held_out_filter_predicate_and_string_window_schemas_execute() {\n00226|     selected(\n00227|         &[\"exclude_membership\"],\n00228|         \"drop_forbidden_symbols\",\n00229|         &[\"text\", \"forbidden\"],\n00230|         \"Exclude characters appearing in the second collection.\",\n00231|         &[(&[\"'stargazer'\", \"'az'\"], \"'strger'\")],\n00232|     );\n00233|     selected(\n00234|         &[\"duplicate_exists\"],\n00235|         \"has_repeated_member\",\n00236|         &[\"values\"],\n00237|         \"Whether the collection contains duplicates.\",\n00238|         &[(&[\"[4, 1, 4]\"], \"True\"), (&[\"[4, 1, 9]\"], \"False\")],\n00239|     );\n00240|     selected(\n00241|         &[\"one_bit_difference\"],\n00242|         \"single_toggle_apart\",\n00243|         &[\"left\", \"right\"],\n00244|         \"Whether two integers have one bit difference.\",\n00245|         &[(&[\"8\", \"12\"], \"True\"), (&[\"8\", \"14\"], \"False\")],\n00246|     );\n00247|     selected(\n00248|         &[\"remove_boundary_occurrences\"],\n00249|         \"trim_outer_matches\",\n00250|         &[\"text\", \"symbol\"],\n00251|         \"Remove the first and last occurrence of the symbol.\",\n00252|         &[(&