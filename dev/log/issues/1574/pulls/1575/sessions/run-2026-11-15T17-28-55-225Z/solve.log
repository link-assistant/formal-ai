in-progress: ${{ github.event_name == 'pull_request' }}\\n00306|     needs: shard-plan\\n00307|     runs-on: ubuntu-latest\\n00308|     timeout-minutes: 45\\n00309|     strategy:\\n00310|       fail-fast: false\\n00311|       matrix:\\n00312|         window: ${{ fromJSON(needs.shard-plan.outputs.windows) }}\\n00313|     steps:\\n00314|       - uses: actions/checkout@v7\\n00315|         with:\\n00316|           persist-credentials: false\\n00317| \\n00318|       - name: Setup Rust\\n00319|         uses: dtolnay/rust-toolchain@stable\\n00320| \\n00321|       - uses: ./.github/actions/cache-cargo-registry\\n00322| \\n00323|       - name: Setup Python\\n00324|         uses: actions/setup-python@v7\\n00325|         with:\\n00326|           python-version: '3.12'\\n00327| \\n00328|       - uses: ./.github/actions/formal-ai-binary\\n00329| \\n00330|       - name: Run the window\\n00331|         env:\\n00332|           SUITE: ${{ inputs.suite }}\\n00333|           OFFSET: ${{ matrix.window.offset }}\\n00334|           WINDOW: ${{ matrix.window.slice }}\\n00335|         run: |\\n00336|           set -euo pipefail\\n00337|           mkdir -p ci-logs\\n00338|           ./rust/target/release/formal-ai benchmark run \\\\\\n00339|             --suite \\\"${SUITE}\\\" \\\\\\n00340|             --offset \\\"${OFFSET}\\\" \\\\\\n00341|             --slice \\\"${WINDOW}\\\" \\\\\\n00342|             --online \\\\\\n00343|             --allow-install 2>&1 | tee \\\"ci-logs/shard-${OFFSET}.log\\\"\\n00344|           grep -E '^(shard )?suite=' \\\"ci-logs/shard-${OFFSET}.log\\\" >> \\\"${GITHUB_STEP_SUMMARY}\\\"\\n00345| \\n00346|       - name: Upload shard log\\n00347|         if: always()\\n00348|         uses: actions/upload-artifact@v7\\n00349|         with:\\n00350|           name: external-benchmarks-shard-${{ matrix.window.offset }}\\n00351|           path: ci-logs/shard-*.log\\n00352|           if-no-files-found: warn\\n00353| \\n00354|   shard-total:\\n00355|     name: Total of