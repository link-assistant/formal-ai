served.kind === 'success' ? recipeArtifactInventoryResult(inventoryObserved.output, sourcePaths, evidenceRoot, commitReference) : null;\n00166|   if (inventory === null) return gap(installed.refusal);\n00167|   if (paths.length !== 0 || inventory.ownedPaths.length !== 0) {\n00168|     const hygiene = preparedRecipeHygiene(sourcePaths, paths, inventory, commitReference);\n00169|     if (hygiene === null) return gap(installed.refusal);\n00170|     const commands = [hygiene.command, preparedWorkCommitCommand(hygiene, commitReference), hygiene.cleanCommand];\n00171|     for (const command of commands) {\n00172|       const result = observed(command);\n00173|       if (result.kind === 'failed') return gap(installed.refusal);\n00174|       if (result.kind === 'missing') return call(command);\n00175|     }\n00176|   }\n00177|   const staged = recipe.supporting_files.find(file=>installed.stagedPrefix!==''&&file.path.startsWith(installed.stagedPrefix)\n00178|     && /\\.ya?ml$/u.test(file.path) && /^name: ([^\\r\\n]+)$/mu.exec(file.source)?.[1]===workflow);\n00179|   if(staged){\n00180|     if(followup[0]!==undefined){\n00181|       const review=observed(followup[0]);\n00182|       if(review.kind==='missing')return call(followup[0]);if(review.kind==='failed')return gap(installed.refusal);\n00183|     }\n00184|     const command=recipeStagedReadyCommand(reference,workflow,staged,false),view=observed(command);\n00185|     if(view.kind==='missing')return call(command);\n00186|     const before=view.kind==='success'?recipeStagedReadyResult(view.output,reference,workflow,staged.path,false):null;\n00187|     if(before===null)return gap(installed.refusal);\n00188|     // Issue #1162: the description is written even when the pull request is already ready.\n00189|     if(followup[1]!==undefined){\n00190|       const edit=observed(followup[1]);\n00191|       if(edit.kind==='missing')return call(followup[1]);if(edit.kind==='failed')return gap(installed.refusal);\n00192|     }\n00193|  