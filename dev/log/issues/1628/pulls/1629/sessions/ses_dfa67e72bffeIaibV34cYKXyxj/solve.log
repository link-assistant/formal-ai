0256|       };\n00257|       references.add(reference);\n00258|     }\n00259|   }\n00260|   if (references.size > 1) return {\n00261|     kind: 'refused',\n00262|     reason: installed.refusal\n00263|   };\n00264|   return references.size === 0 ? {\n00265|     kind: 'absent'\n00266|   } : {\n00267|     kind: 'bound',\n00268|     reference: [...references][0]\n00269|   };\n00270| }\n00271| \n00272| /** Mirrors fn recipe_source_refusal: stale source bytes cannot certify a later recipe step. */\n00273| export function recipeSourceRefusal() {\n00274|   return resolvedFinalAnswer(policy().refusal, FinalDisposition.Gap, 'recipe-source-epoch-invalidated');\n00275| }\n00276| \n00277| /** Mirrors fn recipe_source_update_command; caller owns full recipe and exact probe. */\n00278| export function recipeSourceUpdateCommand(path, source, before) {\n00279|   if (before?.absent !== false || typeof source !== 'string' || !/^[a-f0-9]{64}$/u.test(before.sha256 ?? '') || !Array.isArray(before.identity) || before.identity.length !== 5\n00280|     || !before.identity.every(value => typeof value === 'string' && /^[0-9]+$/u.test(value))) return null;\n00281|   const installed = policy();\n00282|   return installed.command.replace(/\\{(?:source|plan)\\}/gu, slot => shellQuote(slot === '{source}' ? installed.updateSource : jsonText({\n00283|     path,\n00284|     source,\n00285|     before: {\n00286|       sha256: before.sha256,\n00287|       identity: before.identity\n00288|     }\n00289|   })));\n00290| }\n00291| \n00292| /** Mirrors fn recipe_source_update_result; exact command binding remains required. */\n00293| export function recipeSourceUpdateResult(output, path) {\n00294|   let value;\n00295|   try {\n00296|     value = JSON.parse(observedPayload(output));\n00297|   } catch {\n00298|     return false;\n00299|   }\n00300|   return value?.schema === 'workspace-source-update-v1' && value.path === path && value.success === true && value.complete === true;\n00301| }\n\n(End of file - t