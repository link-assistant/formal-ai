[2026-07-19T11:43:03.496Z] [INFO]           "+    let tool = tool_for(tool_names, Capability::Search)?;",
[2026-07-19T11:43:03.496Z] [INFO]           "+    Some(plan_one(tool, json!({ \"query\": open.join(\" \") }).to_string()))",
[2026-07-19T11:43:03.496Z] [INFO]           " }",
[2026-07-19T11:43:03.496Z] [INFO]           " ",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// The aspects of `query` that no fetched page supports.",
[2026-07-19T11:43:03.496Z] [INFO]           "+///",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// This is the loop's open-question signal, and it carries no vocabulary: an",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// aspect is a content token of the question, and it is covered when some page",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// actually mentions it. That is deliberately the same symbolic, non-neural",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// notion of aboutness [`relevance`] ranks sentences with, applied to the",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// question instead of the answer.",
[2026-07-19T11:43:03.496Z] [INFO]           "+///",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// Scripts that do not space-separate words tokenize to one long token, which",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// would report the whole question uncovered forever. For those the aspect is",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// the ideograph, matching the fallback [`relevance`] already uses.",
[2026-07-19T11:43:03.496Z] [INFO]           "+fn uncovered_aspects(query: &str, progress: &Progress) -> Vec<String> {",
[2026-07-19T11:43:03.496Z] [INFO]           "+    if progress.fetched_pages.is_empty() {",
[2026-07-19T11:43:03.496Z] [INFO]           "+        return Vec::new();",
[2026-07-19T11:43:03.496Z] [INFO]           "+    }",
[2026-07-19T11:43:03.496Z] [INFO]           "+    let evidence = progress",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .fetched_pages",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .iter()",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .map(|(_, text)| text.to_lowercase())",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .collect::<Vec<_>>()",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .join(\" \");",
[2026-07-19T11:43:03.496Z] [INFO]           "+    aspects_of(query)",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .into_iter()",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .filter(|aspect| !evidence.contains(&aspect.to_lowercase()))",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .collect()",
[2026-07-19T11:43:03.496Z] [INFO]           "+}",
[2026-07-19T11:43:03.496Z] [INFO]           "+",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// Shortest token treated as an aspect. One-character latin tokens are",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// initials and stray letters, not aspects of a question.",
[2026-07-19T11:43:03.496Z] [INFO]           "+const MIN_ASPECT_CHARS: usize = 2;",
[2026-07-19T11:43:03.496Z] [INFO]           "+",
[2026-07-19T11:43:03.496Z] [INFO]           "+fn aspects_of(query: &str) -> Vec<String> {",
[2026-07-19T11:43:03.496Z] [INFO]           "+    if crate::coding::contains_cjk(query) {",
[2026-07-19T11:43:03.496Z] [INFO]           "+        return query",
[2026-07-19T11:43:03.496Z] [INFO]           "+            .chars()",
[2026-07-19T11:43:03.496Z] [INFO]           "+            .filter(|character| character.is_alphanumeric())",
[2026-07-19T11:43:03.496Z] [INFO]           "+            .map(|character| character.to_string())",
[2026-07-19T11:43:03.496Z] [INFO]           "+            .collect();",
[2026-07-19T11:43:03.496Z] [INFO]           "+    }",
[2026-07-19T11:43:03.496Z] [INFO]           "+    let mut seen = std::collections::BTreeSet::new();",
[2026-07-19T11:43:03.496Z] [INFO]           "+    query",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .split(|character: char| !character.is_alphanumeric())",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .filter(|token| token.chars().count() >= MIN_ASPECT_CHARS)",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .map(str::to_lowercase)",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .filter(|token| seen.insert(token.clone()))",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .collect()",
[2026-07-19T11:43:03.496Z] [INFO]           "+}",
[2026-07-19T11:43:03.496Z] [INFO]           "+",
[2026-07-19T11:43:03.496Z] [INFO]           " /// Evidence at or below this many characters is already an answer, so it is",
[2026-07-19T11:43:03.496Z] [INFO]           " /// reported verbatim. Above it the fetch result is a whole web page — site",
[2026-07-19T11:43:03.496Z] [INFO]           " /// chrome, navigation and unrelated articles around the part that answers the"
[2026-07-19T11:43:03.496Z] [INFO]         ]
[2026-07-19T11:43:03.496Z] [INFO]       }
[2026-07-19T11:43:03.496Z] [INFO]     ],
[2026-07-19T11:43:03.496Z] [INFO]     "userModified": false,
[2026-07-19T11:43:03.496Z] [INFO]     "replaceAll": false
[2026-07-19T11:43:03.496Z] [INFO]   }
