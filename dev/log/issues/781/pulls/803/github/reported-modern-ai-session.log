[2026-07-19T11:43:03.496Z] [INFO]           "     }",
[2026-07-19T11:43:03.496Z] [INFO]           "-    tool_for(tool_names, Capability::Search)",
[2026-07-19T11:43:03.496Z] [INFO]           "-        .map(|tool| plan_one(tool, json!({ \"query\": query }).to_string()))",
[2026-07-19T11:43:03.496Z] [INFO]           "+    let open = uncovered_aspects(query, progress);",
