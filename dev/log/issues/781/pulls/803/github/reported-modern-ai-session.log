[2026-07-19T13:11:49.227Z] [INFO]           "+    // returned as-is instead of researched further. That is the intended",
[2026-07-19T13:11:49.227Z] [INFO]           "+    // trade: answering with what was actually found beats spending a round on",
[2026-07-19T13:11:49.227Z] [INFO]           "+    // a guess about what is missing.",
[2026-07-19T13:11:49.227Z] [INFO]           "+    //",
[2026-07-19T13:11:49.227Z] [INFO]           "     // This also makes the loop terminate on its own, independently of the round",
[2026-07-19T13:11:49.227Z] [INFO]           "     // budget: uncovered aspects only ever shrink as evidence accumulates.",
[2026-07-19T13:11:49.227Z] [INFO]           "-    if open.is_empty() || open.len() * 2 >= aspects_of(query).len() {",
[2026-07-19T13:11:49.227Z] [INFO]           "+    if open.len() != 1 || aspects_of(query).len() < 3 {",
[2026-07-19T13:11:49.227Z] [INFO]           "         return None;",
[2026-07-19T13:11:49.227Z] [INFO]           "     }",
[2026-07-19T13:11:49.227Z] [INFO]           "     let tool = tool_for(tool_names, Capability::Search)?;"
