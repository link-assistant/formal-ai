[2026-07-19T11:21:07.267Z] [INFO]         "type": "tool_result",
[2026-07-19T11:21:07.267Z] [INFO]         "content": "780\t        DocumentRecipe {\n781\t            path: google_trends_catalog::GOOGLE_TRENDS_CATALOG_PATH,\n782\t            verify_command: google_trends_catalog::verification_command(),\n783\t            final_answer,\n784\t            document,\n785\t        },\n786\t    )\n787\t}\n788\t\n789\t/// Tool results produced since the current user turn began.\n790\tpub(super) struct Progress {\n791\t    completed: Vec<Capability>,\n792\t    pub(super) fetched_text: Option<String>,\n793\t    pub(super) fetched_pages: Vec<(String, String)>,\n794\t    pub(super) search_output: Option<String>,\n795\t    pub(super) run_output: Option<String>,\n796\t    pub(super) fetch_result: Option<String>,\n797\t    pub(super) search_result: Option<String>,\n798\t}\n799\t\n800\timpl Progress {\n801\t    pub(super) fn scan(messages: &[ChatMessage]) -> Self {\n802\t        let mut completed = Vec::new();\n803\t        let mut fetched_text = None;\n804\t        let mut fetched_pages = Vec::new();\n805\t        let mut search_output = None;\n806\t        let mut run_output = None;\n807\t        let mut fetch_result = None;\n808\t        let mut search_result = None;\n809\t        // Ignore results from earlier user turns.\n810\t        let current_turn = messages\n811\t            .iter()\n812\t            .rposition(|message| message.role.eq_ignore_ascii_case(\"user\"))\n813\t            .map_or(0, |index| index + 1);\n814\t        for (index, message) in messages.iter().enumerate().skip(current_turn) {\n815\t            if !message.role.eq_ignore_ascii_case(\"tool\") {\n816\t                continue;\n817\t            }\n818\t            let Some(capability) = result_capability(messages, index) else {\n819\t                continue;\n820\t            };\n821\t            if capability == Capability::Fetch {\n822\t                let text = message.content.plain_text();\n823\t                fetch_result = Some(text.clone());\n824\t                if !looks_like_error(&text) && !text.trim().is_empty() {\n825\t                    if let Some(url) = result_tool_call(messages, index).and_then(fetch_call_url) {\n826\t                        fetched_pages.push((url, text.clone()));\n827\t                    }\n828\t                    fetched_text = Some(text);\n829\t                }\n830\t            }\n831\t            if capability == Capability::Search {\n832\t                let text = message.content.plain_text();\n833\t                search_result = Some(text.clone());\n834\t                if !looks_like_error(&text) && !text.trim().is_empty() {\n835\t                    search_output = Some(text);\n836\t                }\n837\t            }\n838\t            if capability == Capability::Run {\n839\t                run_output = Some(message.content.plain_text());\n840\t            }\n841\t            completed.push(capability);\n842\t        }\n843\t        Self {\n844\t            completed,\n845\t            fetched_text,\n846\t            fetched_pages,\n847\t            search_output,\n848\t            run_output,\n849\t            fetch_result,\n850\t            search_result,\n851\t        }\n852\t    }\n853\t\n854\t    /// Whether a prior tool result already covered `capability`.\n855\t    pub(super) fn done(&self, capability: Capability) -> bool {\n856\t        self.completed.contains(&capability)\n857\t    }\n858\t\n859\t    fn count(&self, capability: Capability) -> usize {\n860\t        self.completed\n861\t            .iter()\n862\t            .filter(|done| **done == capability)\n863\t            .count()\n864\t    }\n865\t\n866\t    pub(super) fn fetch_result(&self) -> Option<&str> {\n867\t        self.fetch_result.as_deref()\n868\t    }\n869\t\n870\t    pub(super) fn search_result(&self) -> Option<&str> {\n871\t        self.search_result.as_deref()\n872\t    }\n873\t}\n874\t\n875\tpub(super) fn plan_one(tool: &str, arguments: String) -> AgenticPlan {\n876\t    AgenticPlan::ToolCal