[2026-07-19T11:43:03.496Z] [INFO]           "+",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// Read the sources the latest search returned, skipping any already read.",
[2026-07-19T11:43:03.496Z] [INFO]           "+///",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// Skipping is what keeps a multi-round loop from stalling: a refined search",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// usually returns some of the same pages, and re-reading them would burn the",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// turn budget while adding no evidence. When nothing new remains, the round has",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// no work and the caller falls through to answering.",
[2026-07-19T11:43:03.496Z] [INFO]           "+fn plan_fetches(tool_names: &[&str], progress: &Progress) -> Option<AgenticPlan> {",
[2026-07-19T11:43:03.496Z] [INFO]           "+    let tool = tool_for(tool_names, Capability::Fetch)?;",
[2026-07-19T11:43:03.496Z] [INFO]           "+    let output = progress.search_output.as_deref()?;",
[2026-07-19T11:43:03.496Z] [INFO]           "+    let already: std::collections::BTreeSet<&str> = progress",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .fetched_pages",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .iter()",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .map(|(url, _)| url.as_str())",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .collect();",
[2026-07-19T11:43:03.496Z] [INFO]           "+    let calls = research_urls(output)",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .into_iter()",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .filter(|url| !already.contains(url.as_str()))",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .map(|url| PlannedToolCall {",
[2026-07-19T11:43:03.496Z] [INFO]           "+            tool: tool.to_owned(),",
[2026-07-19T11:43:03.496Z] [INFO]           "+            arguments: fetch_arguments(&url),",
[2026-07-19T11:43:03.496Z] [INFO]           "+        })",
[2026-07-19T11:43:03.496Z] [INFO]           "+        .collect::<Vec<_>>();",
[2026-07-19T11:43:03.496Z] [INFO]           "+    (!calls.is_empty()).then(|| AgenticPlan::ToolCalls(calls))",
[2026-07-19T11:43:03.496Z] [INFO]           "+}",
[2026-07-19T11:43:03.496Z] [INFO]           "+",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// Search again for the part of the question the evidence has not covered.",
[2026-07-19T11:43:03.496Z] [INFO]           "+///",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// The refinement is the uncovered aspects *alone*, not the original question",
[2026-07-19T11:43:03.496Z] [INFO]           "+/// repeated. Re-issuing the whole question returns the whole first result set",
