[2026-07-19T13:05:06.767Z] [INFO]     "originalFile": "agentic_coding_meta_recipe\n  record_type \"meta_recipe\"\n  topic \"agentic_coding\"\n  title \"Agentic-coding task loop\"\n  summary \"Machine-readable recipe for the deterministic agentic-coding loop (issue #468): how our Formal AI solves a task in agentic mode by emitting tool_calls, executing them, understanding tool errors, and looping to a finished Links Notation knowledge base — with no neural inference and no live network. The recipe is grounded: tests/unit/specification/agentic_meta_algorithm.rs asserts the real source still matches every constant, tool, capability, stage, function, primitive, bound, and exposure surface listed here, so this file always describes how the live agentic loop was produced.\"\n  generalization \"To make the Formal AI solve a new task in agentic mode, instantiate the eight ordered steps below: recognise the task class from the latest user turn, pin the canonical plan as named constants, classify whatever tools the agentic CLI advertised into capabilities by substring (so any CLI works), plan each step as a pure function of conversation history (the search → fetch → write → run → final state machine), observe tool errors and fall back deterministically, wire the planner into the OpenAI-compatible server behind the agent-mode and permission gates, grant the client-executed tool capabilities through an associative package, and execute the loop with an offline driver and corpus bounded by a hard turn cap — then pin it all with a CLI subcommand, an example, and integration tests.\"\nstep_recognise_task\n  record_type \"meta_step\"\n  order \"1\"\n  id \"recognise_task\"\n  title \"Recognise the agentic task from the latest user turn\"\n  detail \"The planner reads only the most recent user message (latest_user_text) and classifies it with is_formalization_task against a small closed keyword set (FORMALIZATION_KEYWORDS). A non-matching turn yields None, so the server falls through to its ordinary symbolic solver and agentic coding stays strictly opt-in.\"\n  seed_file \"src/agentic_coding/planner.rs\"\nstep_pin_constants\n  record_type \"meta_step\"\n  order \"2\"\n  id \"pin_constants\"\n  title \"Pin the canonical plan as named constants\"\n  detail \"Expose the task's fixed plan as stable constants — SEARCH_QUERY, CANONICAL_SOURCE_URL, and KB_PATH — so the recipe is data, not scattered string literals, and the grounding test can verify each is declared.\"\n  seed_file \"src/agentic_coding/planner.rs\"\nstep_classify_tools\n  record_type \"meta_step\"\n  order \"3\"\n  id \"classify_tools\"\n  title \"Classify advertised tools into capabilities by substring\"\n  detail \"classify_tool maps whatever tool names the agentic CLI advertised onto the Capability enum (Search/Fetch/Read/Write/Run) by substring, mirroring the naming conventions agentic CLIs use (web_search, web_fetch, read, write_file, run_command, bash, …). The planner therefore adapts to any subset of tools a given CLI exposes.\"\n  seed_file \"src/agentic_coding/planner.rs\"\nstep_plan_each_step\n  record_type \"meta_step\"\n  order \"4\"\n  id \"plan_each_step\"\n  title \"Plan each step as a pure function of conversation history\"\n  detail \"plan_chat_step is a deterministic state machine: web_search → web_fetch → write_file(formalize) → run_command(verify) → final. Each step is taken only if the conversation has no prior tool result for that capability and the CLI advertised a tool with it. Same history always yields the same plan; neural inference stays a NON-GOAL.\"\n  seed_file \"src/agentic_coding/planner.rs\"\nstep_understand_errors\n  record_type \"meta_step\"\n  order \"5\"\n  id \"understand_errors\"\n  title \"Understand tool errors and fall back deterministically\"\n  detail \"A fetch result that looks_like_error (error / failed / not found / 404) is not trusted as source text; the formalizer then falls back to the canonical synopsis so the loop still completes with a stable, all-nine-primitive knowledge base. This is the issue's `understand errors from tools` requirement.\"\n  seed_file \"src/agentic_coding/planner.rs\"\nstep_wire_server\n  record_type \"meta_step\"\n  order \"6\"\n  id \"wire_server\"\n  title \"Wire the planner into the OpenAI-compatible server behind two gates\"\n  detail \"create_chat_completion_with_solver refuses every tool unless agent_mode is opted in and the requested tools pass the permission gate; only then does it call plan_chat_step and turn the plan into a completion via chat_completion_from_plan — a ToolCalls plan becomes an assistant turn with finish_reason tool_calls, a Final plan becomes plain text with finish_reason stop.\"\n  seed_file \"src/protocol.rs\"\nstep_grant_capabilities\n  record_type \"meta_step\"\n  order \"7\"\n  id \"grant_capabilities\"\n  title \"Grant the client-executed tool capabilities through an associative package\"\n  detail \"default_associative_packages installs pkg_agentic_coding, a permission-only package granting the client-executed web_fetch, read, write_file, and run_command capabilities (web_search comes from the core package). agent_mode remains the real guard, so granting these by default enables no hidden autonomous action.\"\n  seed_file \"src/associative_package.rs\"\nstep_execute_loop\n  record_type \"meta_step\"\n  order \"8\"\n  id \"execute_loop\"\n  title \"Execute the loop with an offline driver and corpus, then expose it\"\n  detail \"run_agentic_task / run_agentic_task_in play an external agentic CLI: they advertise DRIVER_TOOLS, execute each emitted tool call (web_search/web_fetch against the offline corpus, write_file/run_command in a sandboxed AgentWorkspace), feed results back, and loop until finish_reason stop — bounded by MAX_TURNS. Expose it through a CLI subcommand, an example, and integration tests.\"\n  seed_file \"src/agentic_coding/driver.rs\"\nconstant_search_query\n  record_type \"meta_constant\"\n  constant \"SEARCH_QUERY\"\n  source_file \"src/agentic_coding/planner.rs\"\nconstant_canonical_source_url\n  record_type \"meta_constant\"\n  constant \"CANONICAL_SOURCE_URL\"\n  source_file \"src/agentic_coding/planner.rs\"\nconstant_kb_path\n  record_type \"meta_constant\"\n  constant \"KB_PATH\"\n  source_file \"src/agentic_coding/planner.rs\"\ntool_web_search\n  record_type \"meta_tool\"\n  tool \"web_search\"\n  capability \"Search\"\n  permission \"tool:web_search\"\n  permission_package \"pkg_formal_ai_core\"\ntool_web_fetch\n  record_type \"meta_tool\"\n  tool \"web_fetch\"\n  capability \"Fetch\"\n  permission \"tool:web_fetch\"\n  permission_package \"pkg_agentic_coding\"\ntool_write_file\n  record_type \"meta_tool\"\n  tool \"write_file\"\n  capability \"Write\"\n  permission \"tool:write_file\"\n  permission_package \"pkg_agentic_coding\"\ntool_run_command\n  record_type \"meta_tool\"\n  tool \"run_command\"\n  capability \"Run\"\n  permission \"tool:run_command\"\n  permission_package \"pkg_agentic_coding\"\nstage_search\n  record_type \"meta_stage\"\n  stage \"search\"\n  order \"1\"\nstage_fetch\n  record_type \"meta_stage\"\n  stage \"fetch\"\n  order \"2\"\nstage_write\n  record_type \"meta_stage\"\n  stage \"write\"\n  order \"3\"\nstage_run\n  record_type \"meta_stage\"\n  stage \"run\"\n  order \"4\"\nstage_final\n  record_type \"meta_stage\"\n  stage \"final\"\n  order \"5\"\nfn_plan_chat_step\n  record_type \"meta_function\"\n  function \"plan_chat_step\"\n  source_file \"src/agentic_coding/planner.rs\"\n  kind \"planner\"\nfn_classify_tool\n  record_type \"meta_function\"\n  function \"classify_tool\"\n  source_file \"src/agentic_coding/planner.rs\"\n  kind \"tool_classifier\"\nfn_is_formalization_task\n  record_type \"meta_function\"\n  function \"is_formalization_task\"\n  source_file \"src/agentic_coding/planner.rs\"\n  kind \"recogniser\"\nfn_looks_like_error\n  record_type \"meta_function\"\n  function \"looks_like_error\"\n  source_file \"src/agentic_coding/planner.rs\"\n  kind \"error_detector\"\nfn_final_answer\n  record_type \"meta_function\"\n  function \"final_answer\"\n  source_file \"src/agentic_coding/planner.rs\"\n  kind \"renderer\"\nfn_formalize_text_to_links\n  record_type \"meta_function\"\n  function \"formalize_text_to_links\"\n  source_file \"src/agentic_coding/formalize.rs\"\n  kind \"formalizer\"\nfn_coverage_line\n  record_type \"meta_function\"\n  function \"coverage_line\"\n  source_file \"src/agentic_coding/formalize.rs\"\n  kind \"reporter\"\nfn_create_chat_completion_with_solver\n  record_type \"meta_function\"\n  function \"create_chat_completion_with_solver\"\n  source_file \"src/protocol.rs\"\n  kind \"server_entrypoint\"\nfn_chat_completion_from_plan\n  record_type \"meta_function\"\n  function \"chat_completion_from_plan\"\n  source_file \"src/protocol.rs\"\n  kind \"plan_to_completion\"\nfn_run_agentic_task\n  record_type \"meta_function\"\n  function \"run_agentic_task\"\n  source_file \"src/agentic_coding/driver.rs\"\n  kind \"driver\"\nfn_run_agentic_task_in\n  record_type \"meta_function\"\n  function \"run_agentic_task_in\"\n  source_file \"src/agentic_coding/driver.rs\"\n  kind \"driver\"\nfn_execute_tool_call\n  record_type \"meta_function\"\n  function \"execute_tool_call\"\n  source_file \"src/agentic_coding/driver.rs\"\n  kind \"tool_executor\"\nfn_corpus_web_search\n  record_type \"meta_function\"\n  function \"web_search\"\n  source_file \"src/agentic_coding/corpus.rs\"\n  kind \"corpus\"\nfn_corpus_web_fetch\n  record_type \"meta_function\"\n  function \"web_fetch\"\n  source_file \"src/agentic_coding/corpus.rs\"\n  kind \"corpus\"\nprimitive_concept\n  record_type \"meta_primitive\"\n  primitive \"concept\"\n  order \"1\"\nprimitive_entity\n  record_type \"meta_primitive\"\n  primitive \"entity\"\n  order \"2\"\nprimitive_predicate\n  record_type \"meta_primitive\"\n  primitive \"predicate\"\n  order \"3\"\nprimitive_assertion\n  record_type \"meta_primitive\"\n  primitive \"assertion\"