[2026-07-19T11:19:37.338Z] [INFO]         "type": "tool_result",
[2026-07-19T11:19:37.338Z] [INFO]         "content": "30\tuse crate::solver::{SolverConfig, UniversalSolver};\n31\t\n32\t/// The tool set the driver advertises — the four capabilities the planner's recipe\n33\t/// relies on (`web_search` → `web_fetch` → `write_file` → `run_command`).\n34\tpub const DRIVER_TOOLS: [&str; 4] = [\"web_search\", \"web_fetch\", \"write_file\", \"run_command\"];\n35\t\n36\t/// A hard cap on agentic turns (server round-trips). The recipe needs five; the\n37\t/// cap is generous but finite so the loop can never run away.\n38\tconst MAX_TURNS: usize = 12;\n39\t\n40\t/// One executed tool call, recorded for the transcript.\n41\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n42\tpub struct DriverToolStep {\n43\t    /// The tool name the server requested.\n44\t    pub tool: String,\n45\t    /// The JSON-encoded arguments the server requested.\n46\t    pub arguments: String,\n47\t    /// The result the driver fed back as a `tool` message.\n48\t    pub result: String,\n49\t}\n50\t\n51\t/// The outcome of an agentic run.\n52\t#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]\n53\tpub struct DriverOutcome {\n54\t    /// The task the driver was asked to solve.\n55\t    pub task: String,\n56\t    /// Every tool call the driver executed, in order.\n57\t    pub steps: Vec<DriverToolStep>,\n58\t    /// The server's final assistant text (the knowledge base inline).\n59\t    pub final_answer: String,\n60\t    /// How many server round-trips the loop took.\n61\t    pub turns: usize,\n62\t    /// Whether the loop stopped at `MAX_TURNS` rather than a final answer.\n63\t    pub hit_turn_cap: bool,\n64\t}\n65\t\n66\timpl DriverOutcome {\n67\t    /// A human-readable transcript of the tool calls and how the loop ended.\n68\t    #[must_use]\n69\t    pub fn transcript(&self) -> String {\n70\t        let mut out = String::new();\n71\t        let _ = writeln!(out, \"task: {}\", self.task);\n72\t        let _ = writeln!(\n73\t            out,\n74\t            \"turns: {} (tool calls: {})\",\n75\t            self.turns,\n76\t            self.steps.len()\n77\t        );\n78\t        for (index, step) in self.steps.iter().enumerate() {\n79\t            let _ = writeln!(out, \"  [{}] {} {}\", index + 1, step.tool, step.arguments);\n80\t            let _ = writeln!(out, \"      -> {}\", preview(&step.result, 200));\n81\t        }\n82\t        if self.hit_turn_cap {\n83\t            let _ = writeln!(out, \"(stopped at the {MAX_TURNS}-turn safety cap)\");\n84\t        }\n85\t        out\n86\t    }\n87\t\n88\t    /// A stable, replayable JSON record of the whole agentic session — the task,\n89\t    /// the tools the CLI advertised, every executed tool call with its arguments\n90\t    /// and result, the turn count, and the final answer. This is the \"Agent CLI\n91\t    /// session that solved the task\" artifact: it is deterministic (no clock, no\n92\t    /// randomness, no network), so committing it to the repo documents exactly how\n93\t    /// Formal AI drove its own CLI to the solution.\n94\t    #[must_use]\n95\t    pub fn session_json(&self) -> Value {\n96\t        json!({\n97\t            \"task\": self.task,\n98\t            \"driver\": \"formal-ai in-repo agentic CLI\",\n99\t            \"server\": \"formal-ai OpenAI-compatible chat completions\",\n100\t            \"tools_advertised\": DRIVER_TOOLS,\n101\t            \"turns\": self.turns,\n102\t            \"hit_turn_cap\": self.hit_turn_cap,\n103\t            \"steps\": self.steps.iter().map(|step| json!({\n104\t                \"tool\": step.tool,\n105\t                \"arguments\": serde_json::from_str::<Value>(&step.arguments)\n106\t                    .unwrap_or_else(|_| Value::String(step.arguments.clone())),\n107\t                \"result\": step.result,\n108\t            })).collect::<Vec<_>>(),\n109\t            \"final_answer\": self.final_answer,\n110\t        })\n111\t    }\n112\t}\n113\t\n114\t/// Drive the agentic loop for `task` using a default sandbox workspace.\n115\t///\n116\t/// # Errors\n117\t///\n118\t/// Returns an [`AgentError`] if the isolated workspace cannot be created.\n119\tpub fn run_agentic_task(task: &str) -> Result<DriverOutcome, AgentError> {\n120\t    run_agentic_task_in(task, &AgentWorkspaceConfig::default())\n121\t}\n122\t\n123\t/// Drive the agentic loop for `task` using the given workspace `config`.\n124\t///\n125\t/// # Errors\n126\t///\n127\t/// Returns an [`AgentError`] if the isolated workspace cannot be created.\n128\tpub fn run_agentic_task_in(\n129\t    task: &str,\n130\t    config: &AgentWorkspaceConfig,\n131\t) -> Result<DriverOutcome, AgentError> {\n132\t    // Agent mode is the explicit opt-in the server's tool gate requires; without\n133\t    // it the server refuses every tool. The driver is that isolated execution\n134\t    // environment, so it opts in.\n135\t    let solver = UniversalSolver::new(SolverConfig {\n136\t        agent_mode: true,\n137\t        ..SolverConfig::default()\n138\t    });\n139\t    let tools = tool_definitions(&DRIVER_TOOLS);\n140\t    let mut workspace = AgentWorkspace::for_prompt(task, config)?;\n141\t    let mut messages = vec![ChatMessage::user(task)];\n142\t    let mut steps = Vec::new();\n143\t    let mut turns = 0usize;\n144\t\n145\t    loop {\n146\t        if turns >= MAX_TURNS {\n147\t            return Ok(DriverOutcome {\n148\t                task: task.to_owned(),\n149\t                steps,\n150\t                final_answer: String::new(),\n151\t                turns,\n152\t                hit_turn_cap: true,\n153\t            });\n154\t        }\n155\t        turns += 1;\n156\t\n157\t        let request = ChatCompletionRequest {\n158\t            model: None,\n159\t            messages: messages.clone(),\n160\t            temperature: None,\n161\t            stream: false,\n162\t            tools: tools.clone(),\n163\t            tool_choice: None,\n164\t            functions: Vec::new(),\n165\t            function_call: None,\n166\t            stream_options: None,\n167\t        };\n168\t        let completion = create_chat_completion_with_solver(&request, &solver);\n169\t        let Some(choice) = completion.choices.into_iter().next() else {\n170\t            return Ok(DriverOutcome {\n171\t                task: task.to_owned(),\n172\t                steps,\n173\t                final_answer: String::new(),\n174\t                turns,\n175\t                hit_turn_cap: false,\n176\t            });\n177\t        };\n178\t\n179\t        let requested_tools =\n180\t            choice.finish_reason == \"tool_calls\" && !choice.message.tool_calls.is_empty();\n181\t        if !requested_tools {\n182\t            return Ok(DriverOutcome {\n183\t                task: task.to_owned(),\n184\t                steps,\n185\t                final_answer: choice.message.content.plain_text(),\n186\t                turns,\n187\t                hit_turn_cap: false,\n188\t            });\n189\t        }\n190\t\n191\t        // Execute the requested tool calls, then append the assistant turn\n192\t        // followed by the `tool` results (order matters: the planner maps each\n193\t        // result's `tool_call_id` back to a *prior* assistant `tool_calls` turn).\n194\t        let assistant = choice.message;\n195\t        let mut results = Vec::with_capacity(assistant.tool_calls.len());\n196\t        for call in &assistant.tool_calls {\n197\t            let result = execute_tool_call(call, &mut workspace);\n198\t            steps.push(DriverToolStep {\n199\t                tool: call.function.name.clone(),\n200\t                arguments: call.function.arguments.clone(),\n201\t                result: result.clone(),\n202\t            });\n203\t            results.push(ChatMessage::tool_result(\n204\t                call.id.clone(),"
