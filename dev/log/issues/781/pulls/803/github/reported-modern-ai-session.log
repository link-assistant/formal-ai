[2026-07-19T12:19:44.389Z] [INFO]         "oldLines": 6,
[2026-07-19T12:19:44.389Z] [INFO]         "newStart": 48,
[2026-07-19T12:19:44.389Z] [INFO]         "newLines": 22,
[2026-07-19T12:19:44.389Z] [INFO]         "lines": [
[2026-07-19T12:19:44.389Z] [INFO]           "     assert_eq!(quantity_in(\"12 Volts\", \"V\"), None);",
[2026-07-19T12:19:44.389Z] [INFO]           " }",
[2026-07-19T12:19:44.389Z] [INFO]           " ",
[2026-07-19T12:19:44.389Z] [INFO]           "+/// Part numbers are alphanumeric runs that contain digits, and those digits are",
[2026-07-19T12:19:44.389Z] [INFO]           "+/// not measurements. This one is real: Acer's `A13-045N2A` ends in `2A`, which",
[2026-07-19T12:19:44.389Z] [INFO]           "+/// reads exactly like a 2-ampere rating and would have credited the part with a",
[2026-07-19T12:19:44.389Z] [INFO]           "+/// current its page never stated — enough to make a genuine adapter look",
[2026-07-19T12:19:44.389Z] [INFO]           "+/// underpowered and drop it out of the answer entirely.",
[2026-07-19T12:19:44.389Z] [INFO]           "+#[test]",
[2026-07-19T12:19:44.389Z] [INFO]           "+fn a_digit_inside_a_part_number_is_not_read_as_a_measurement() {",
[2026-07-19T12:19:44.389Z] [INFO]           "+    assert_eq!(quantity_in(\"Acer adapter A13-045N2A\", \"A\"), None);",
[2026-07-19T12:19:44.389Z] [INFO]           "+    assert_eq!(quantity_in(\"model X200V revision\", \"V\"), None);",
[2026-07-19T12:19:44.389Z] [INFO]           "+    assert_eq!(",
[2026-07-19T12:19:44.389Z] [INFO]           "+        quantity_in(\"A13-045N2A rated 2.31 A\", \"A\"),",
[2026-07-19T12:19:44.389Z] [INFO]           "+        Some(milli(2, 310)),",
[2026-07-19T12:19:44.389Z] [INFO]           "+        \"the real rating is still found once the part number is passed over\"",
[2026-07-19T12:19:44.389Z] [INFO]           "+    );",
[2026-07-19T12:19:44.389Z] [INFO]           "+}",
[2026-07-19T12:19:44.389Z] [INFO]           "+",
[2026-07-19T12:19:44.389Z] [INFO]           " /// Prices are written with digit groups, and specifications with decimals; both",
[2026-07-19T12:19:44.389Z] [INFO]           " /// have to survive the trip into fixed point.",
[2026-07-19T12:19:44.389Z] [INFO]           " #[test]"
[2026-07-19T12:19:44.389Z] [INFO]         ]
[2026-07-19T12:19:44.389Z] [INFO]       }
