[2026-07-19T11:19:53.068Z] [INFO]       {
[2026-07-19T11:19:53.068Z] [INFO]         "tool_use_id": "toolu_011YJ3JYYnzX6ZNYJX83M6pL",
[2026-07-19T11:19:53.068Z] [INFO]         "type": "tool_result",
[2026-07-19T11:19:53.068Z] [INFO]         "content": "1\t//! Multi-step web research for agentic clients (issue #687).\n2\t//!\n3\t//! Intent recognition is delegated to the same meaning-lexicon detector used by\n4\t//! the universal solver. This module only adds agentic sequencing (search, rank\n5\t//! a source, fetch, answer) and resolves a seed-declared contextual reference\n6\t//! against prior user turns. No natural-language vocabulary lives here.\n7\t\n8\tuse serde_json::json;\n9\t\n10\tuse super::planner::{\n11\t    fetch_arguments, plan_one, tool_for, AgenticPlan, Capability, PlannedToolCall, Progress,\n12\t};\n13\tuse crate::engine::FormalAiEngine;\n14\tuse crate::protocol::ChatMessage;\n15\tuse crate::seed::{self, Slot};\n16\t\n17\tpub(super) fn web_research_query_for(messages: &[ChatMessage]) -> Option<String> {\n18\t    let task = latest_user_text(messages)?;\n19\t    if let Some(query) = seed_research_subject(&task)\n20\t        .or_else(|| crate::solver_handlers::detect_web_search_query(&task))\n21\t    {\n22\t        return if is_context_reference(&query) {\n23\t            topic_from_history(messages)\n24\t        } else {\n25\t            Some(query)\n26\t        };\n27\t    }\n28\t\n29\t    // A punctuation-marked question that the local engine cannot answer is an\n30\t    // open-world lookup. Question words themselves remain seed data in the\n31\t    // shared detector; punctuation is script structure, not language vocabulary.\n32\t    let trimmed = task.trim();\n33\t    let asks_question = trimmed.ends_with(['?', '？', '؟', '¿']);\n34\t    let unresolved = matches!(\n35\t        FormalAiEngine.answer(&task).intent.as_str(),\n36\t        \"unknown\" | \"web_search\"\n37\t    );\n38\t    (asks_question && unresolved).then(|| trim_question_punctuation(&task))\n39\t}\n40\t\n41\t/// Extract the subject carried by a seed-declared research imperative. The\n42\t/// shared web detector deliberately rejects pronouns as standalone searches;\n43\t/// the agentic planner accepts them here because it can resolve them against\n44\t/// conversation history before creating a tool call.\n45\tfn seed_research_subject(task: &str) -> Option<String> {\n46\t    let normalized = crate::engine::normalize_prompt(task);\n47\t    seed::lexicon()\n48\t        .role_word_forms(seed::ROLE_WEB_SEARCH_IMPERATIVE_LEAD)\n49\t        .into_iter()\n50\t        .filter(|form| form.slot() == Slot::Prefix)\n51\t        .find_map(|form| {\n52\t            let prefix = crate::engine::normalize_prompt(form.before_slot());\n53\t            normalized\n54\t                .strip_prefix(&prefix)\n55\t                .map(trim_question_punctuation)\n56\t                .filter(|subject| !subject.is_empty())\n57\t        })\n58\t}\n59\t\n60\tpub(super) fn plan_web_research_step(\n61\t    messages: &[ChatMessage],\n62\t    tool_names: &[&str],\n63\t    query: &str,\n64\t) -> Option<AgenticPlan> {\n65\t    let progress = Progress::scan(messages);\n66\t    if progress.done(Capability::Fetch) {\n67\t        return Some(AgenticPlan::Final(final_answer(query, &progress)));\n68\t    }\n69\t    if progress.done(Capability::Search) {\n70\t        if let Some(tool) = tool_for(tool_names, Capability::Fetch) {\n71\t            if let Some(output) = progress.search_output.as_deref() {\n72\t                let calls = research_urls(output)\n73\t                    .into_iter()\n74\t                    .map(|url| PlannedToolCall {\n75\t                        tool: tool.to_owned(),\n76\t                        arguments: fetch_arguments(&url),\n77\t                    })\n78\t                    .collect::<Vec<_>>();\n79\t                if !calls.is_empty() {\n80\t                    return Some(AgenticPlan::ToolCalls(calls));\n81\t                }\n82\t            }\n83\t        }\n84\t        return Some(AgenticPlan::Final(final_answer(query, &progress)));\n85\t    }\n86\t    tool_for(tool_names, Capability::Search)\n87\t        .map(|tool| plan_one(tool, json!({ \"query\": query }).to_string()))\n88\t}\n89\t\n90\t/// Evidence at or below this many characters is already an answer, so it is\n91\t/// reported verbatim. Above it the fetch result is a whole web page — site\n92\t/// chrome, navigation and unrelated articles around the part that answers the\n93\t/// question — and must be extracted from rather than dumped (issue #771).\n94\tconst VERBATIM_EVIDENCE_LIMIT: usize = 600;\n95\t\n96\t/// How many sentences an extract keeps. Enough for a claim plus its immediate\n97\t/// qualification, short enough to stay an answer rather than a transcript.\n98\tconst EXTRACT_SENTENCES: usize = 3;\n99\t\n100\tfn final_answer(query: &str, progress: &Progress) -> String {\n101\t    if !progress.fetched_pages.is_empty() {\n102\t        return progress\n103\t            .fetched_pages\n104\t            .iter()\n105\t            .map(|(url, evidence)| {\n106\t                format!(\n107\t                    \"{}\\n\\n{}: {url}\",\n108\t                    extract_answer(query, evidence.trim()),\n109\t                    seed_text(\"web_research_source_label\")\n110\t                )\n111\t            })\n112\t            .collect::<Vec<_>>()\n113\t            .join(\"\\n\\n\");\n114\t    }\n115\t    let evidence = progress\n116\t        .fetched_text\n117\t        .as_deref()\n118\t        .or(progress.search_output.as_deref())\n119\t        .unwrap_or_default()\n120\t        .trim();\n121\t    if evidence.is_empty() {\n122\t        return render_seed_text(\"web_research_no_content\", \"query\", query);\n123\t    }\n124\t    let source = progress\n125\t        .search_output\n126\t        .as_deref()\n127\t        .and_then(preferred_url)\n128\t        .map_or_else(String::new, |url| {\n129\t            format!(\"\\n\\n{}: {url}\", seed_text(\"web_research_source_label\"))\n130\t        });\n131\t    format!(\"{}{source}\", extract_answer(query, evidence))\n132\t}\n133\t\n134\t/// Reduce fetched evidence to the sentences that actually bear on `query`.\n135\t///\n136\t/// A fetch tool returns the whole page; answering with it verbatim is what made\n137\t/// issue #771's session unreadable. Sentences are scored by symbolic token\n138\t/// overlap with the query — the same non-neural similarity the ranker uses — and\n139\t/// the best few are returned in document order so the extract still reads as\n140\t/// prose. Scoring is deterministic and carries no natural-language vocabulary,\n141\t/// so it works in every supported language — see [`relevance`] for how the\n142\t/// space-less scripts are handled.\n143\tfn extract_answer(query: &str, evidence: &str) -> String {\n144\t    if evidence.chars().count() <= VERBATIM_EVIDENCE_LIMIT {\n145\t        return evidence.to_owned();\n146\t    }\n147\t    let sentences = crate::summarization::formalize(evidence);\n148\t    let mut scored: Vec<(usize, f32, &str)> = sentences\n149\t        .iter()\n150\t        .enumerate()\n151\t        .map(|(position, statement)| {\n152\t            (\n153\t                position,\n154\t                relevance(query, &statement.text),\n155\t                statement.text.as_str(),\n156\t            )\n157\t        })\n158\t        .filter(|(_, score, _)| *score > 0.0)\n159\t        .collect();\n160\t    if scored.is_empty() {\n161\t        // Nothing overlaps the query: fall back to the head of the document\n162\t        // rather than the whole of it, so the answer stays bounded either way.\n163\t        return truncate_chars(evidence, VERBATIM_EVIDENCE_LIMIT);\n164\t    }\n165\t    // Rank by relevance, keep the best few, then restore document order.\n166\t    scored.sort_by(|left, right| {\n167\t        right\n168\t            .1\n169\t            .partial_cmp(&left.1)\n170\t            .unwrap_or(std::cmp::Ordering::Equal)\n171\t            .then(left.0.cmp(&right.0))\n172\t    });\n173\t    scored.truncate(EXTRACT_SENTENCES);\n174\t    scored.sort_by_key(|(position, _, _)| *position);\n175\t    scored\n176\t        .iter()\n177\t        .map(|(_, _, text)| *text)\n178\t        .collect::<Vec<_>>()\n179\t        .join(\" \")\n180\t}\n181\t\n182\t/// How much `sentence` bears on `query`, in `0.0..=1.0`.\n183\t///\n184\t/// Bag-of-words cosine is the primary measure. It tokenizes on non-alphanumeric\n185\t/// boundaries, which is exactly right for the space-separated scripts but scores\n186\t/// every Chinese sentence 0.0: a run of Han characters with no spaces is a\n187\t/// single token, so query and sentence never share one. The codebase's existing\n188\t/// answer for that (see `coding::catalog::contains_cjk` and its callers) is to\n189\t/// match on characters rather than words, so that is the fallback here.\n190\tfn relevance(query: &str, sentence: &str) -> f32 {\n191\t    let cosine = crate::probability::symbolic_cosine_similarity(query, sentence);\n192\t    if cosine > 0.0 || !crate::coding::contains_cjk(query) {\n193\t        return cosine;\n194\t    }\n195\t    character_overlap(query, sentence)\n196\t}\n197\t\n198\t/// The fraction of the query's distinct ideographs that `sentence` also uses.\n199\t///\n200\t/// Punctuation and spacing are ignored, so the score reflects shared content\n201\t/// characters only. Common function characters inflate it slightly, which costs\n202\t/// nothing here because the score is only ever used to rank sentences of the\n203\t/// same document against each other.\n204\tfn character_overlap(query: &str, sentence: &str) -> f32 {\n205\t    let sentence: std::collections::BTreeSet<char> =\n206\t        sentence.chars().filter(|c| c.is_alphanumeric()).collect();\n207\t    let query: std::collections::BTreeSet<char> =\n208\t        query.chars().filter(|c| c.is_alphanumeric()).collect();\n209\t    if query.is_empty() {\n210\t        return 0.0;\n211\t    }\n212\t    let shared = query.iter().filter(|c| sentence.contains(c)).count();\n213\t    #[expect(\n214\t        clippy::cast_precision_loss,\n215\t        reason = \"character counts are far below f32's exact-integer range\"\n216\t    )]\n217\t    {\n218\t        shared as f32 / query.len() as f32\n219\t    }\n220\t}\n221\t\n222\t/// Truncate to at most `max` characters on a char boundary, appending an\n223\t/// ellipsis when shortened.\n224\tfn truncate_chars(value: &str, max: usize) -> String {\n225\t    let value = value.trim();\n226\t    if value.chars().count() <= max {\n227\t        return value.to_owned();\n228\t    }\n229\t    let head: String = value.chars().take(max.saturating_sub(1)).collect();\n230\t    format!(\"{}…\", head.trim_end())\n231\t}\n232\t\n233\tfn seed_text(key: &str) -> String {\n234\t    seed::agent_info()\n235\t        .remove(key)\n236\t        .unwrap_or_else(|| key.to_owned())\n237\t}\n238\t\n239\tfn render_seed_text(key: &str, name: &str, value: &str) -> String {\n240\t    let mut placeholder = String::with_capacity(name.len() + 2);\n241\t    placeholder.push('{');\n242\t    placeholder.push_str(name);\n243\t    placeholder.push('}');\n244\t    seed_text(key).replace(&placeholder, value)\n245\t}\n246\t\n247\t/// Rank URLs instead of blindly fetching the first search result. Government\n248\t/// and education hosts are authoritative for public facts; otherwise preserve\n249\t/// the search provider's ordering. The complete fetched URL is retained in the\n250\t/// final answer for auditability.\n251\tpub(super) fn preferred_url(text: &str) -> Option<String> {\n252\t    research_urls(text).into_iter().next()\n253\t}\n254\t\n255\t/// Bound the breadth of one research round while retaining independent sources.\n256\t/// The first authoritative host is moved to the front; the search provider's\n257\t/// ranking determines the remaining order. Three captures are enough to\n258\t/// triangulate a claim without turning a single question into an unbounded crawl.\n259\tconst MAX_RESEARCH_SOURCES: usize = 3;\n260\t\n261\tfn research_urls(text: &str) -> Vec<String> {\n262\t    let mut urls = urls_in(text);\n263\t    let mut seen = std::collections::BTreeSet::new();\n264\t    urls.retain(|url| seen.insert(url.clone()));\n265\t    if let Some(position) = urls.iter().position(|url| authoritative_host(url)) {\n266\t        urls.swap(0, position);\n267\t    }\n268\t    urls.truncate(MAX_RESEARCH_SOURCES);\n269\t    urls\n270\t}\n271\t\n272\tfn urls_in(text: &str) -> Vec<String> {\n273\t    text.split_whitespace()\n274\t        .filter(|token| token.starts_with(\"http://\") || token.starts_with(\"https://\"))\n275\t        .map(|token| {\n276\t            token\n277\t                .trim_end_matches(['.', ',', ';', ')', ']', '\"', '\\''])\n278\t                .to_owned()\n279\t        })\n280\t        .collect()\n281\t}\n282\t\n283\tfn authoritative_host(url: &str) -> bool {\n284\t    let host = url\n285\t        .split_once(\"://\")\n286\t        .map_or(url, |(_, rest)| rest)\n287\t        .split('/')\n288\t        .next()\n289\t        .unwrap_or_default()\n290\t        .split(':')\n291\t        .next()\n292\t        .unwrap_or_default()\n293\t        .to_ascii_lowercase();\n294\t    let mut labels = host.rsplit('.');\n295\t    let terminal = labels.next().unwrap_or_default();\n296\t    terminal == \"gov\"\n297\t        || terminal == \"edu\"\n298\t        || (terminal == \"uk\" && labels.next().is_some_and(|label| label == \"gov\"))\n299\t}\n300\t\n301\tfn is_context_reference(query: &str) -> bool {\n302\t    let normalized = crate::engine::normalize_prompt(query);\n303\t    seed::lexicon()\n304\t        .role_word_forms(seed::ROLE_NON_REFERENTIAL_SUBJECT)\n305\t        .into_iter()\n306\t        .any(|form| match form.slot() {\n307\t            Slot::Bare => crate::engine::normalize_prompt(&form.text) == normalized,\n308\t            Slot::Prefix => {\n309\t                normalized.starts_with(&crate::engine::normalize_prompt(form.before_slot()))\n310\t            }\n311\t            Slot::Suffix | Slot::Circumfix => false,\n312\t        })\n313\t}\n314\t\n315\tfn topic_from_history(messages: &[ChatMessage]) -> Option<String> {\n316\t    let latest = messages\n317\t        .iter()\n318\t        .rposition(|message| message.role.eq_ignore_ascii_case(\"user\"))?;\n319\t    messages[..latest]\n320\t        .iter()\n321\t        .enumerate()\n322\t        .rev()\n323\t        .find_map(|(index, message)| {\n324\t            if !message.role.eq_ignore_ascii_case(\"user\") {\n325\t                return None;\n326\t            }\n327\t            let text = message.content.plain_text();\n328\t            if super::report_issue::is_report_intent(&text)\n329\t                || is_conversation_meta_request(&text, &messages[..index])\n330\t            {\n331\t                return None;\n332\t            }\n333\t            let topic = crate::solver_handlers::detect_web_search_query(&text)\n334\t                .unwrap_or_else(|| trim_question_punctuation(&text));\n335\t            (!topic.trim().is_empty() && !is_context_reference(&topic)).then_some(topic)\n336\t        })\n337\t}\n338\t\n339\tfn is_conversation_meta_request(prompt: &str, preceding: &[ChatMessage]) -> bool {\n340\t    let history = preceding\n341\t        .iter()\n342\t        .filter_map(|message| {\n343\t            let text = message.content.plain_text();\n344\t            if text.trim().is_empty() {\n345\t                None\n346\t            } else if message.role.eq_ignore_ascii_case(\"user\") {\n347\t                Some(crate::ConversationTurn::user(text))\n348\t            } else if message.role.eq_ignore_ascii_case(\"assistant\") {\n349\t                Some(crate::ConversationTurn::assistant(text))\n350\t            } else {\n351\t                None\n352\t            }\n353\t        })\n354\t        .collect::<Vec<_>>();\n355\t    crate::solve_with_history(prompt, &history).intent == \"summarize_conversation\"\n356\t}\n357\t\n358\tfn trim_question_punctuation(text: &str) -> String {\n359\t    text.trim()\n360\t        .trim_end_matches(['?', '？', '؟', '¿', '.', '!', '。'])\n361\t        .trim()\n362\t        .to_owned()\n363\t}\n364\t\n365\tfn latest_user_text(messages: &[ChatMessage]) -> Option<String> {\n366\t    messages\n367\t        .iter()\n368\t        .rev()\n369\t        .find(|message| message.role.eq_ignore_ascii_case(\"user\"))\n370\t        .map(|message| message.content.user_request_text())\n371\t}\n372\t"
