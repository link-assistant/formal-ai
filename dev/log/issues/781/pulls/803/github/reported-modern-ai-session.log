[2026-07-19T11:54:46.458Z] [INFO]         "content": "28\t\n29\tfn answer_tool_calls(messages: &mut Vec<ChatMessage>, calls: &[PlannedToolCall], results: &[&str]) {\n30\t    assert_eq!(calls.len(), results.len());\n31\t    let call_prefix = messages.len();\n32\t    let protocol_calls = calls\n33\t        .iter()\n34\t        .enumerate()\n35\t        .map(|(index, call)| {\n36\t            ToolCall::function(\n37\t                format!(\"issue781_call_{call_prefix}_{index}\"),\n38\t                call.tool.clone(),\n39\t                call.arguments.clone(),\n40\t            )\n41\t        })\n42\t        .collect();\n43\t    messages.push(ChatMessage::assistant_tool_calls(protocol_calls));\n44\t    for (index, (call, result)) in calls.iter().zip(results).enumerate() {\n45\t        messages.push(ChatMessage::tool_result(\n46\t            format!(\"issue781_call_{call_prefix}_{index}\"),\n47\t            &call.tool,\n48\t            *result,\n49\t        ));\n50\t    }\n51\t}\n52\t\n53\t#[test]\n54\tfn compatibility_research_fetches_and_cites_independent_sources() {\n55\t    let mut messages = vec![ChatMessage::user(\n56\t        \"Найди мне совместимую зарядку для Acer Aspire 3 A325-45?\",\n57\t    )];\n58\t    let search = tool_calls(&messages);\n59\t    assert_eq!(search.len(), 1);\n60\t    assert_eq!(search[0].tool, \"websearch\");\n61\t    answer_tool_calls(\n62\t        &mut messages,\n63\t        &search,\n64\t        &[concat!(\n65\t            \"Acer specifications https://store.acer.com/a325-45 \",\n66\t            \"Connector evidence https://example.test/a325-45-adapter \",\n67\t            \"Candidate listing https://www.amazon.in/example/dp/TEST781\"\n68\t        )],\n69\t    );\n70\t\n71\t    let fetches = tool_calls(&messages);\n72\t    assert_eq!(\n73\t        fetches.len(),\n74\t        3,\n75\t        \"research must capture multiple independent sources before recommending a compatible item\"\n76\t    );\n77\t    assert!(fetches.iter().all(|call| call.tool == \"webfetch\"));\n78\t    assert_eq!(\n79\t        fetches\n80\t            .iter()\n81\t            .map(|call| arguments(call)[\"url\"].as_str().unwrap().to_owned())\n82\t            .collect::<Vec<_>>(),\n83\t        [\n84\t            \"https://store.acer.com/a325-45\",\n85\t            \"https://example.test/a325-45-adapter\",\n86\t            \"https://www.amazon.in/example/dp/TEST781\",\n87\t        ]\n88\t    );\n89\t\n90\t    answer_tool_calls(\n91\t        &mut messages,\n92\t        &fetches,\n93\t        &[\n94\t            \"The laptop is supplied with a 24 W adapter.\",\n95\t            \"The model uses 12 V, 2 A and a 3.5 x 1.35 mm center-positive plug.\",\n96\t            \"The candidate listing states 12 V, 2 A and a 3.5 x 1.35 mm plug.\",\n97\t        ],\n98\t    );\n99\t\n100\t    let answer = final_answer(&messages);\n101\t    for expected in [\n102\t        \"24 W\",\n103\t        \"center-positive\",\n104\t        \"candidate listing states 12 V\",\n105\t        \"https://store.acer.com/a325-45\",\n106\t        \"https://example.test/a325-45-adapter\",\n107\t        \"https://www.amazon.in/example/dp/TEST781\",\n108\t    ] {\n109\t        assert!(\n110\t            answer.contains(expected),\n111\t            \"missing {expected:?} in:\\n{answer}\"\n112\t        );\n113\t    }\n114\t}\n115\t"
