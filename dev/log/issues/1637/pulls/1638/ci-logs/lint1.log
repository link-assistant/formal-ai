##[start-action display=Start the sccache server;id=__self.__run_3]
##[group]Run set -euo pipefail
set -euo pipefail
if [ "${SCCACHE_INSTALL_OUTCOME:-}" = failure ]; then
  echo "::warning title=sccache install failed::The sccache download failed; this job builds without the compiler cache (issue #1569)."
fi
probe_log="$(mktemp)"
trap 'rm -f "$probe_log"' EXIT
sccache --start-server > "$probe_log" 2>&1 || true
# A successful compiler probe also accepts an already-running server.
if sccache rustc -vV >> "$probe_log" 2>&1; then
  echo "sccache compiler probe succeeded"
else
  echo "RUSTC_WRAPPER=" >> "$GITHUB_ENV"
  echo "::warning title=sccache unavailable::Compiler-cache probe failed; subsequent Cargo steps use the real compiler without cache (issue #1031)."
fi
sccache --show-stats >> "$probe_log" 2>&1 || echo "::warning::sccache statistics unavailable (issue #1031)."
# Read only the completed file; no cache process writes into this pipe.
# Cache errors can contain signed URLs, so redact their complete values.
head -c 65536 "$probe_log" | sed -E 's#https?://[^[:space:]]+#<cache-url-redacted>#g'
