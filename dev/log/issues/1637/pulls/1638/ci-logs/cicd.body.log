^[[36;1melse^[[0m
^[[36;1m  outcome='**miss** -- every dependency will be recompiled'^[[0m
^[[36;1mfi^[[0m
^[[36;1mif [ "${RESTORE_ONLY}" = 'true' ]; then mode='restore-only'; else mode='read-write'; fi^[[0m
^[[36;1m# A bullet rather than a table row: the action can run once or several^[[0m
^[[36;1m# times in a job, and a stray row with no header renders as raw text.^[[0m
^[[36;1mprintf -- '- cargo registry cache `%s` (%s): %s\n' \^[[0m
^[[36;1m  "${WANTED_KEY}" "${mode}" "${outcome}" >> "${GITHUB_STEP_SUMMARY}"^[[0m
^[[36;1m# Read straight from the process environment rather than mapping the^[[0m
^[[36;1m# `env` context into a step `env:`. A calling job exports its own^[[0m
^[[36;1m# `env:` block into every step it runs, this one included, and that^[[0m
^[[36;1m# path does not depend on which contexts a composite action can^[[0m
^[[36;1m# evaluate. (Written without expression syntax on purpose: Actions^[[0m
^[[36;1m# expands an expression anywhere in a `run:` block, shell comments^[[0m
^[[36;1m# included, which is what zizmor's template-injection audit reports.)^[[0m
^[[36;1mif [ -z "${MATCHED_KEY}" ] && [ "${FORMAL_AI_CI_VERBOSE:-false}" = 'true' ]; then^[[0m
