^[[36;1mfi^[[0m
^[[36;1msccache --show-stats >> "$probe_log" 2>&1 || echo "::warning::sccache statistics unavailable (issue #1031)."^[[0m
^[[36;1m# Read only the completed file; no cache process writes into this pipe.^[[0m
^[[36;1m# Cache errors can contain signed URLs, so redact their complete values.^[[0m
^[[36;1mhead -c 65536 "$probe_log" | sed -E 's#https?://[^[:space:]]+#<cache-url-redacted>#g'^[[0m
