##[start-action display=rustup toolchain install stable;id=__dtolnay_rust-toolchain.__run_4]
##[group]Run set -f  # split targets and components on commas and whitespace, without glob expansion
^[[36;1mset -f  # split targets and components on commas and whitespace, without glob expansion^[[0m
^[[36;1mflags=()^[[0m
^[[36;1mfor t in ${targets//,/ }; do flags+=(--target "$t"); done^[[0m
^[[36;1mfor c in ${components//,/ }; do flags+=(--component "$c"); done^[[0m
^[[36;1mif [[ $toolchain == nightly && -n $components ]]; then flags+=(--allow-downgrade); fi^[[0m
^[[36;1mlog=$(mktemp)^[[0m
^[[36;1mtrap 'rm -f "$log"' EXIT^[[0m
^[[36;1mfor attempt in 1 2 3 4 5; do^[[0m
^[[36;1m  if rustup toolchain install "$toolchain" "${flags[@]}" --profile minimal --no-self-update --force-non-host 2>&1 | tee "$log"; then^[[0m
^[[36;1m    break^[[0m
^[[36;1m  else^[[0m
^[[36;1m    status=$?^[[0m
^[[36;1m  fi^[[0m
^[[36;1m  if [[ $attempt == 5 ]] || ! grep -Fq 'checksum failed for ' "$log" \^[[0m
^[[36;1m      || ! grep -Fq 'this is likely due to an ongoing update of the official release server' "$log"; then^[[0m
^[[36;1m    exit "$status"^[[0m
^[[36;1m  fi^[[0m
^[[36;1m  echo "Retrying rustup toolchain install in 30 seconds (retry $attempt of 4)" >&2^[[0m
^[[36;1m  sleep 30^[[0m
^[[36;1mdone^[[0m
