^[[36;1mprobe_log="$(mktemp)"^[[0m
^[[36;1mtrap 'rm -f "$probe_log"' EXIT^[[0m
^[[36;1msccache --start-server > "$probe_log" 2>&1 || true^[[0m
^[[36;1m# A successful compiler probe also accepts an already-running server.^[[0m
^[[36;1mif sccache rustc -vV >> "$probe_log" 2>&1; then^[[0m
^[[36;1m  echo "sccache compiler probe succeeded"^[[0m
^[[36;1melse^[[0m
^[[36;1m  echo "RUSTC_WRAPPER=" >> "$GITHUB_ENV"^[[0m
