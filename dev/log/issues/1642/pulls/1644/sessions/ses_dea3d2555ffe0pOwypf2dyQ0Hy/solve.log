ss the request's first write verb\\n00006| //! is a seeded whole-file write (`file_whole_write_action`: create, write,\\n00007| //! save, new file, ... in every registered language), the target is read\\n00008| //! first, and an existing non-empty file is replaced only when the request\\n00009| //! consents to it (`file_overwrite_consent`); otherwise the plan declines with\\n00010| //! a seeded refusal naming the file. A request that declares the file it\\n00011| //! writes (a seeded `file_declared_noun` right before the path, no destination\\n00012| //! ahead of it, the content stated after it: `add file note.txt containing\\n00013| //! hello`) creates that file, whatever its verb. The per-shape guards\\n00014| //! (`names_an_addition`, the routed-write removal check) stay; this is the\\n00015| //! backstop. Twin of `js/agentic/literal_write_guard.mjs`.\\n00016| \\n00017| use super::general_planner::{GeneralChangePlan, GeneralPlanMode};\\n00018| use super::planner::{AgenticPlan, Capability, plan_one, tool_for};\\n00019| use super::write_request::{\\n00020|     Token, bare_surfaces, clean_cue_token, clean_path_token, first_action_cue_end,\\n00021|     first_action_cue_start, first_content_lead_end, looks_like_file_path, tokens,\\n00022| };\\n00023| use crate::protocol::ChatMessage;\\n00024| use crate::seed;\\n00025| \\n00026| const ROLE_WHOLE_WRITE: &str = \\\"file_whole_write_action\\\";\\n00027| const ROLE_OVERWRITE_CONSENT: &str = \\\"file_overwrite_consent\\\";\\n00028| const ROLE_DECLARED_NOUN: &str = \\\"file_declared_noun\\\";\\n00029| const REFUSAL: &str = \\\"general_change_existing_file_kept\\\";\\n00030| const UNNAMED: &str = \\\"general_change_target_unnamed\\\";\\n00031| \\n00032| /// Whether the request's first write verb names a file's whole new content,\\n00033| /// or the request consents to replacing it.\\n00034| pub(super) fn writes_whole_file(request: &str) -> bool {\\n00035|     let instruction = instruction_outside_quotes(request);\\n00036|     let lexicon = seed::lexicon();\\n00037|     if lexicon.mentions_role(\\n00038|         ROLE_OVERWRITE_CONSENT,\\n00039|         &crate::engine::normalize_prompt(&instruction),\\n00040|     ) {\\n00041|         return true;\\n00042|     }\\n00043|     if declares_file(\\n00044|         &instruction,\\n00045|         &super::positional_edit::unquoted_path_tokens(request),\\n00046|     ) {\\n00047|         return true;\\n00048|     }\\n00049|     let toks = tokens(&instruction);\\n00050|     let (Some(start), Some(end)) = (first_action_cue_start(&toks), first_action_cue_end(&toks))\\n00051|     else {\\n00052|         return false;\\n00053|     };\\n00054|     instruction.get(start..end).is_some_and(|verb| {\\n00055|         lexicon.mentions_role(ROLE_WHOLE_WRITE, &crate::engine::normalize_prompt(verb))\\n00056|     })\\n00057| }\\n00058| \\n00059| fn instruction_outside_quotes(request: &str) -> String {\\n00060|     let mut instruction = request.to_owned();\\n00061|     for span in crate::normal_markov::quoted_segment_spans(request)\\n00062|         .into_iter()\\n00063|         .rev()\\n00064|     {\\n00065|         instruction.replace_range(span.start..span.end, &\\\" \\\".repeat(span.end - span.start));\\n00066|     }\\n00067|     instruction\\n00068| }\\n00069| \\n00070| /// The requested edit action itself must own a whole-file operation.\\n00071| pub(super) fn whole_file_operation_at(\\n00072|     request: &str,\\n00073|     action_start: usize,\\n00074|     target: &str,\\n00075|     target_end: usize,\\n00076| ) -> bool {\\n00077|     let instruction = instruction_outside_quotes(request);\\n00078|     let action_tokens = tokens(&instruction);\\n00079|     if first_action_cue_start(&action_tokens).is_some_and(|first| first < action_start) {\\n00080|         return false;\\n00081|     }\\n00082|     let Some(action) = action_tokens\\n00083|         .iter()\\n00084|         .find(|token| token.start =[REDACTED] action_start)\\n00085|     else {\\n00086|         return false;\\n00087|     };\\n00088|     if declares_file(\\n00089|         &instruction,\\n00090|         &super::positional_edit::unquoted_path_tokens(request),\\n00091|     ) {\\n00092|         return true;\\n00093|     }\\n00094|     if seed::lexicon().mentions_role(\\n00095|         ROLE_WHOLE_WRITE,\\n00096|         &crate::engine::normalize_prompt(action.text),\\n00097|     ) {\\n00098|         return true;\\n00099|     }\\n00100|     let suffix: Vec<_> = super::positional_edit::unquoted_path_tokens(request)\\n00101|         .into_iter()\\n00102|         .filter(|token| token.start >= action_start)\\n00103|         .collect();\\n00104|     bare_surfaces(ROLE_OVERWRITE_CONSENT).iter().any(|cue| {\\n00105|         let prefix = tokens(cue);\\n00106|         if prefix.is_empty()\\n00107|             || prefix.len() > suffix.len()\\n00108|             || !prefix\\n00109|                 .iter()\\n00110|                 .zip(&suffix)\\n00111|                 .all(|(token, actual)| clean_cue_token(token.text) == clean_cue_token(actual.text))\\n00112|         {\\n00113|             return false;\\n00114|         }\\n00115|         let mut destination = prefix.len();\\n00116|         let word = suffix\\n00117|             .get(destination)\\n00118|             .map(|token| clean_cue_token(token.text))\\n00119|             .unwrap_or_default();\\n00120|         if bare_surfaces(\\\"request_function_word\\\").contains(&word)\\n00121|             && !bare_surfaces(\\\"file_edit_new_lead_cue\\\").contains(&word)\\n00122|         {\\n00123|             destination += 1;\\n00124|         }\\n00125|         if suffix.get(destination).is_some_and(|token| {\\n00126|             bare_surfaces(ROLE_DECLARED_NOUN).contains(&clean_cue_token(token.text))\\n00127|         }) {\\n00128|             destination += 1;\\n00129|         }\\n00130|         suffix\\n00131|             .get(destination)\\n00132|             .is_some_and(|token| token.end =[REDACTED] target_end && clean_path_token(token.text) == target)\\n00133|     })\\n00134| }\\n00135| \\n00136| /// Whether the request declares the file it writes.\\n00137| ///\\n00138| /// A path right after a seeded `file_declared_noun`, no destination or\\n00139| /// location cue ahead of that noun (`add 'x' to the file a.txt` edits it), and\\n00140| /// a content lead after the path (`new file: notes.txt, contents: hello`).\\n00141| fn declares_file(request: &str, toks: &[Token<'_>]) -> bool {\\n00142|     let nouns = bare_surfaces(ROLE_DECLARED_NOUN);\\n00143|     let mut cues = bare_surfaces(seed::ROLE_FILE_WRITE_DESTINATION_CUE);\\n00144|     cues.extend(bare_surfaces(seed::ROLE_FILE_WRITE_TARGET_CUE));\\n00145|     toks.iter().enumerate().skip(1).any(|(index, token)| {\\n00146|         looks_like_file_path(clean_path_token(token.text))\\n00147|             && nouns.contains(&clean_cue_token(toks[index - 1].text))\\n00148|             && !toks[..index - 1]\\n00149|                 .iter()\\n00150|                 .any(|before| cues.contains(&clean_cue_token(before.text)))\\n00151|             && request\\n00152|                 .get(token.end..)\\n00153|                 .is_some_and(|after| first_content_lead_end(&after.to_lowercase()).is_some())\\n00154|     })\\n00155| }\\n00156| \\n00157| /// The read of the target, or the refusal that keeps an existing file, ahead\\n00158| /// of a literal-file plan's writes; `None` when the plan may proceed.\\n00159| pub(super) fn guarded_step(\\n00160|     plan: &GeneralChangePlan,\\n00161|     messages: &[ChatMessage],\\n00162|     tool_names: &[&str],\\n00163| ) -> Option<AgenticPlan> {\\n00164|     if plan.mode != GeneralPlanMode::LiteralFile {\\n00165|         return None;\\n00166|     }\\n00167|     let language = crate::language::detect(&plan.goal).slug();\\n00168|     // A write never targets a path the request names only inside quoted text\\n00169|     // (PR #1188 G86).\\n00170|     if !names_as_destination(&plan.goal, &plan.target) {\\n00171|         let values = [(\\\"path\\\", plan.target.as_str())];\\n00172|         return seed::render_response(UNNAMED, language, &values)\\n00173|             .or_else(|| seed::render_response(UNNAMED, \\\"en\\\", &values))\\n00174|             .map(AgenticPlan::Final);\\n00175|     }\\n00176|     if writes_whole_file(&plan.goal) {\\n00177|         return None;\\n00178|     }\\n00179|     let read = tool_for(tool_names, Capability::Read)?;\\n00180|     let current_turn = &messages[super::planner::evidence_window_start(messages)..];\\n00181|     let Some(source) = super::module_function::read_source(current_turn, &plan.target) else {\\n00182|         return Some(plan_one(\\n00183|             read,\\n00184|             super::workspace_change::read_arguments(&plan.target),\\n00185|         ));\\n00186|     };\\n00187|     if source.trim().is_empty() || source == plan.content {\\n00188|         return None;\\n00189|     }\\n00190|     let values = [(\\\"path\\\", plan.target.as_str())];\\n00191|     seed::render_response(REFUSAL, language, &values)\\n00192|         .or_else(|| seed::render_response(REFUSAL, \\\"en\\\", &values))\\n00193|         .map(AgenticPlan::Final)\\n00194| }\\n00195| \\n00196| /// Whether `request` names `target` outside its quoted text.\\n00197| ///\\n00198| /// Or, naming no path outside it, quotes `target` whole (mirrors\\n00199| /// `namesAsDestination`).\\n00200| fn names_as_destination(request: &str, target: &str) -> bool {\\n00201|     let segments = crate::normal_markov::quoted_segment_spans(request);\\n00202|     let unquoted: Vec<&str> = tokens(request)\\n00203|         .iter()\\n00204|         .filter(|token| {\\n00205|             !segments\\n00206|                 .iter()\\n00207|                 .any(|segment| token.start < segment.end && token.end > segment.start)\\n00208|         })\\n00209|         .map(|token| clean_path_token(token.text))\\n00210|         .filter(|path| looks_like_file_path(path))\\n00211|         .collect();\\n00212|     unquoted.contains(&target)\\n00213|         || (unquoted.is_empty() && segments.iter().any(|segment| segment.text.trim() == target))\\n00214| }\\n00215| \\n00216| /// Whether a failed call is the guard's read of a target that does not exist\\n00217| /// yet, which the plan goes on to create.\\n00218| pub(super) fn is_guard_read(\\n00219|     plan: &GeneralChangePlan,\\n00220|     failed_path: Option<&str>,\\n00221|     capability: Capability,\\n00222| ) -> bool {\\n00223|     plan.mode == GeneralPlanMode::LiteralFile\\n00224|         && capability == Capability::Read\\n00225|         && failed_path == Some(plan.target.as_str())\\n00226|         && !writes_whole_file(&plan.goal)\\n00227| }\\n\\n(End of file - total 227 lines)\\n</file>\"}],\"tools\":[{\"type\":\"function\",\"function\":{\"name\":\"bash\",\"description\":\"Executes a given bash command in a persistent shell session with optional timeout, ensuring proper handling and security measures.\\n\\nBefore executing the command, please follow these steps:\\n\\n1. Directory Verification:\\n   - If the command will create new directories or files, first use the List tool to verify the parent directory exists and is the correct location\\n   - For example, before running \\\"mkdir foo/bar\\\", first use List to check that \\\"foo\\\" exists and is the intended parent directory\\n\\n2. Command Execution:\\n   - Always quote file paths that contain spaces with double quotes (e.g., cd \\\"path with spaces/file.txt\\\")\\n   - Examples of proper quoting:\\n     - cd \\\"/Users/name/My Documents\\\" (correct)\\n     - cd /Users/name/My Documents (incorrect - will fail)\\n     - python \\\"/path/with spaces/script.py\\\" (correct)\\n     - python /path/with spaces/script.py (incorrect - will fail)\\n   - After ensuring proper quoting, execute the command.\\n   - Capture the output of the command.\\n\\nUsage notes:\\n  - The command argument is required.\\n  - You can specify an optional timeout in millisecond