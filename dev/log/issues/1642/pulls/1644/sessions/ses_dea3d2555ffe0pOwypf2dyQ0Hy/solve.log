line-range-outside-file-hi\\n00511|     intent line_range_outside_file\\n00512|     language hi\\n00513|     text \\\"`{path}` में {count} पंक्तियाँ हैं, इसलिए ले जाने के लिए पंक्तियाँ {lines} नहीं हैं, और कुछ नहीं बदला गया।\\\"\\n00514|   response response-line-range-outside-file-zh\\n00515|     intent line_range_outside_file\\n00516|     language zh\\n00517|     text \\\"`{path}` 只有 {count} 行，没有可移动的第 {lines} 行，因此未做任何更改。\\\"\\n00518|   response response-line-range-outside-file-es\\n00519|     intent line_range_outside_file\\n00520|     language es\\n00521|     text \\\"`{path}` tiene {count} líneas, así que no tiene las líneas {lines} que mover, y no se cambió nada.\\\"\\n00522|   response response-coding-text-not-found-en\\n00523|     intent coding_text_not_found\\n00524|     language en\\n00525|     text \\\"`{old}` does not occur in `{path}`, so nothing was changed.\\\"\\n00526|   response response-coding-text-not-found-ru\\n00527|     intent coding_text_not_found\\n00528|     language ru\\n00529|     text \\\"`{old}` не встречается в `{path}`, поэтому ничего не изменено.\\\"\\n00530|   response response-coding-text-not-found-hi\\n00531|     intent coding_text_not_found\\n00532|     language hi\\n00533|     text \\\"`{old}` `{path}` में नहीं है, इसलिए कुछ नहीं बदला गया।\\\"\\n00534|   response response-coding-text-not-found-zh\\n00535|     intent coding_text_not_found\\n00536|     language zh\\n00537|     text \\\"`{path}` 中没有 `{old}`，因此未做任何更改。\\\"\\n00538|   response response-coding-text-not-found-es\\n00539|     intent coding_text_not_found\\n00540|     language es\\n00541|     text \\\"`{old}` no aparece en `{path}`, así que no se cambió nada.\\\"\\n00542|   response response-coding-text-already-replaced-en\\n00543|     intent coding_text_already_replaced\\n00544|     language en\\n00545|     text \\\"`{path}` already holds `{new}` and no `{old}`: the replacement is already made, and nothing changed.\\\"\\n00546|   response response-coding-text-already-replaced-ru\\n00547|     intent coding_text_already_replaced\\n00548|     language ru\\n00549|     text \\\"`{path}` уже содержит `{new}` и не содержит `{old}`: замена уже сделана, ничего не изменено.\\\"\\n00550|   response response-coding-text-already-replaced-hi\\n00551|     intent coding_text_already_replaced\\n00552|     language hi\\n00553|     text \\\"`{path}` में पहले से `{new}` है और `{old}` नहीं है: बदलाव पहले ही हो चुका है, कुछ नहीं बदला गया।\\\"\\n00554|   response response-coding-text-already-replaced-zh\\n00555|     intent coding_text_already_replaced\\n00556|     language zh\\n00557|     text \\\"`{path}` 已包含 `{new}` 且没有 `{old}`：替换早已完成，未做任何更改。\\\"\\n00558|   response response-coding-text-already-replaced-es\\n00559|     intent coding_text_already_replaced\\n00560|     language es\\n00561|     text \\\"`{path}` ya contiene `{new}` y no `{old}`: el reemplazo ya está hecho y no cambió nada.\\\"\\n00562|   response response-coding-text-replaced-unchecked-en\\n00563|     intent coding_text_replaced_unchecked\\n00564|     language en\\n00565|     text \\\"Replaced `{old}` with `{new}` in `{path}`; the edit tool reported no error.\\\"\\n00566|   response response-coding-text-replaced-unchecked-ru\\n00567|     intent coding_text_replaced_unchecked\\n00568|     language ru\\n00569|     text \\\"В `{path}` `{old}` заменено на `{new}`; инструмент правки не сообщил об ошибке.\\\"\\n00570|   response response-coding-text-replaced-unchecked-hi\\n00571|     intent coding_text_replaced_unchecked\\n00572|     language hi\\n00573|     text \\\"`{path}` में `{old}` को `{new}` से बदला गया; संपादन टूल ने कोई त्रुटि नहीं बताई।\\\"\\n00574|   response response-coding-text-replaced-unchecked-zh\\n00575|     intent coding_text_replaced_unchecked\\n00576|     language zh\\n00577|     text \\\"已在 `{path}` 中将 `{old}` 替换为 `{new}`；编辑工具未报告错误。\\\"\\n00578|   response response-coding-text-replaced-unchecked-es\\n00579|     intent coding_text_replaced_unchecked\\n00580|     language es\\n0