[2026-11-26T02:53:16.646Z] [INFO]       "output": "<file>\n00001| //! Mirrors the ordinary Read/full-content Write/independent Read additive protocol.\n00002| use crate::agentic_coding::code_task::{render_seeded_change, render_seeded_outcome};\n00003| use crate::agentic_coding::final_result::{FinalDisposition, FinalResult, record};\n00004| use crate::agentic_coding::general_planner::{\n00005|     owned_additive_literal_frame, owned_declared_create_frame,\n00006| };\n00007| use crate::agentic_coding::planner::{\n00008|     AgenticPlan, Capability, plan_one, tool_for, write_arguments,\n00009| };\n00010| use crate::agentic_coding::progress::Progress;\n00011| use crate::agentic_coding::workspace_change::read_arguments;\n00012| use crate::agentic_coding::write_request::{\n00013|     bare_surfaces, clean_cue_token, preferred_binding, tokens,\n00014| };\n00015| use crate::protocol::ChatMessage;\n00016| \n00017| fn refused(\n00018|     task: &str,\n00019|     target: &str,\n00020|     disposition: FinalDisposition,\n00021|     result: &mut Option<FinalResult>,\n00022| ) -> AgenticPlan {\n00023|     record(\n00024|         AgenticPlan::Final(\n00025|             render_seeded_outcome(\"file-addition-unverified\", task, target)\n00026|                 .unwrap_or_else(|| target.to_owned()),\n00027|         ),\n00028|         disposition,\n00029|         \"literal-addition-unverified\",\n00030|         result,\n00031|     )\n00032| }\n00033| \n00034| /// Mirrors planLiteralAdditionStep; no undeclared append field or provider capability is emitted.\n00035| pub(super) fn plan_literal_addition_step(\n00036|     task: &str,\n00037|     messages: &[ChatMessage],\n00038|     tool_names: &[&str],\n00039|     result: &mut Option<FinalResult>,\n00040| ) -> Option<AgenticPlan> {\n00041|     if owned_declared_create_frame(task).is_some() {\n00042|         return None;\n00043|     }\n00044|     let contract = super::general_planner::declared_addition_contract(task)?;\n00045|     let (target, content, position) = owned_additive_literal_frame(task)?;\n00046|     if contract != (target.clone(), content.clone()) {\n00047|         return None;\n00048|     }\n00049|     let Some(at_end) = position else {\n00050|         let words = tokens(task);\n00051|         let destination = preferred_binding(&words).is_some_and(|binding| {\n00052|             binding.cue_precedes\n00053|                 && binding.path == target\n00054|                 && bare_surfaces(\"file_declared_noun\")\n00055|                     .contains(&clean_cue_token(&task[binding.cue_start..binding.cue_end]))\n00056|                 && words.iter().any(|word| {\n00057|                     word.end <= binding.cue_start\n00058|                         && bare_surfaces(\"file_write_destination_cue\")\n00059|                             .contains(&clean_cue_token(word.text))\n00060|                 })\n00061|         });\n00062|         let progress = Progress::scan(messages);\n00063|         if destination\n00064|             && !progress.attempted_write_for(&target)\n00065|             && progress.source_read_for(&target).is_none()\n00066|             && let Some(read) = tool_for(tool_names, Capability::Read)\n00067|         {\n00068|             return Some(plan_one(read, read_arguments(&target)));\n00069|         }\n00070|         return Some(record(\n00071|             AgenticPlan::Final(\n00072|                 render_seeded_outcome(\"file-addition-position-unknown\", task, &target)\n00073|                     .unwrap_or_else(|| target.clone()),\n00074|             ),\n00075|             FinalDisposition::Gap,\n00076|             \"literal-addition-position-unknown\",\n00077|             result,\n00078|         ));\n00079|     };\n00080|     let (Some(read), Some(write)) = (\n00081|         tool_for(tool_names, Capability::Read),\n00082|         tool_for(tool_names, Capability::Write),\n00083|     ) else {\n00084|         return Some(refused(task, &target, FinalDisposition::Gap, result));\n00085|     };\n00086|     let progress = Progress::scan(messages);\n00087|     let written = progress.successful_write_content_for(&target);\n00088|     let before = if written.is_none() {\n00089|         progress.source_read_for(&target)\n00090|     } else {\n00091|         progress.source_read_before_latest_write_for(&target)\n00092|     };\n00093|     let Some(before) = before else {\n00094|         return Some(if written.is_none() {\n00095|             plan_one(read, read_arguments(&target))\n00096|         } else {\n00097|             refused(task, &target, FinalDisposition::Gap, result)\n00098|         });\n00099|     };\n00100|     let absent = before.absent;\n00101|     if !absent && (before.error.is_some() || !before.complete || before.source.is_none()) {\n00102|         return Some(refused(task, &target, FinalDisposition::Gap, result));\n00103|     }\n00104|     let source = if absent {\n00105|         \"\"\n00106|     } else {\n00107|         before.source.as_deref().unwrap_or_default()\n00108|     };\n00109|     let expected = if source.is_empty() {\n00110|         format!(\"{content}\\n\")\n00111|     } else if !at_end {\n00112|         format!(\"{content}\\n{source}\")\n00113|     } else {\n00114|         format!(\n00115|             \"{source}{}{content}\\n\",\n00116|             if source.ends_with('\\n') { \"\" } else { \"\\n\" }\n00117|         )\n00118|     };\n00119|     let Some(written) = written else {\n00120|         return Some(if progress.attempted_write_for(&target) {\n00121|             refused(task, &target, FinalDisposition::Failure, result)\n00122|         } else {\n00123|             plan_one(write, write_arguments(&target, &expected))\n00124|         });\n00125|     };\n00126|     if written != expected {\n00127|         return Some(refused(task, &target, FinalDisposition::Gap, result));\n00128|     }\n00129|     if !progress.attempted_read_after_latest_write_for(&target) {\n00130|         return Some(plan_one(read, read_arguments(&target)));\n00131|     }\n00132|     let after = progress.source_read_after_latest_write_for(&target);\n00133|     if !after.is_some_and(|after| {\n00134|         after.error.is_none()\n00135|             && after.complete\n00136|             && after.source.as_deref() == Some(expected.as_str())\n00137|     }) {\n00138|         return Some(refused(task, &target, FinalDisposition::Gap, result));\n00139|     }\n00140|     let intent = if at_end {\n00141|         \"file_edit_position_end\"\n00142|     } else {\n00143|         \"file_edit_position_start\"\n00144|     };\n00145|     Some(record(\n00146|         AgenticPlan::Final(\n00147|             render_seeded_change(intent, task, &target, &[(\"{new}\", &content)])\n00148|                 .unwrap_or_else(|| target.clone()),\n00149|         ),\n00150|         FinalDisposition::Finding,\n00151|         \"literal-addition-observed\",\n00152|         result,\n00153|     ))\n00154| }\n\n(End of file - total 154 lines)\n</file>",
