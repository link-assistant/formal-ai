laced-en\\n00403|     intent coding_texts_replaced\\n00404|     language en\\n00405|     text \\\"Made {count} replacements in `{path}`, in order: {pairs}; and observed the result.\\\"\\n00406|   response response-coding-texts-replaced-ru\\n00407|     intent coding_texts_replaced\\n00408|     language ru\\n00409|     text \\\"В `{path}` сделано замен по порядку: {count} ({pairs}); результат проверен.\\\"\\n00410|   response response-coding-texts-replaced-hi\\n00411|     intent coding_texts_replaced\\n00412|     language hi\\n00413|     text \\\"`{path}` में क्रम से {count} बदलाव किए गए: {pairs}; और परिणाम देखा गया।\\\"\\n00414|   response response-coding-texts-replaced-zh\\n00415|     intent coding_texts_replaced\\n00416|     language zh\\n00417|     text \\\"已在 `{path}` 中按顺序完成 {count} 处替换：{pairs}；并核对了结果。\\\"\\n00418|   response response-coding-texts-replaced-es\\n00419|     intent coding_texts_replaced\\n00420|     language es\\n00421|     text \\\"Se hicieron {count} reemplazos en `{path}`, en orden: {pairs}; y se observó el resultado.\\\"\\n00422|   response response-line-range-moved-end-en\\n00423|     intent line_range_moved_end\\n00424|     language en\\n00425|     text \\\"Moved lines {lines} of `{source}` to the end of `{path}` and observed the result.\\\"\\n00426|   response response-line-range-moved-end-ru\\n00427|     intent line_range_moved_end\\n00428|     language ru\\n00429|     text \\\"Перенёс строки {lines} из `{source}` в конец `{path}` и проверил результат.\\\"\\n00430|   response response-line-range-moved-end-hi\\n00431|     intent line_range_moved_end\\n00432|     language hi\\n00433|     text \\\"`{source}` की पंक्तियाँ {lines} `{path}` के अंत में ले जाईं और परिणाम देखा।\\\"\\n00434|   response response-line-range-moved-end-zh\\n00435|     intent line_range_moved_end\\n00436|     language zh\\n00437|     text \\\"已将 `{source}` 的第 {lines} 行移到 `{path}` 末尾，并核对了结果。\\\"\\n00438|   response response-line-range-moved-end-es\\n00439|     intent line_r