festEnd\"] = values(\"manifest-end\")\n00036|         .first()\n00037|         .map_or(Value::Null, |value| json!(value));\n00038|     policy[\"manifestTitle\"] = values(\"manifest-title\")\n00039|         .first()\n00040|         .map_or(Value::Null, |value| json!(value));\n00041|     policy[\"manifestNotice\"] = values(\"manifest-notice\")\n00042|         .first()\n00043|         .map_or(Value::Null, |value| json!(value));\n00044|     policy[\"manifestHeader\"] = values(\"manifest-header\")\n00045|         .first()\n00046|         .map_or(Value::Null, |value| json!(value));\n00047|     policy[\"manifestSeparator\"] = values(\"manifest-separator\")\n00048|         .first()\n00049|         .map_or(Value::Null, |value| json!(value));\n00050|     policy[\"manifestRow\"] = values(\"manifest-row\")\n00051|         .first()\n00052|         .map_or(Value::Null, |value| json!(value));\n00053|     policy[\"manifestAbsentVersion\"] = values(\"manifest-absent-version\")\n00054|         .first()\n00055|         .map_or(Value::Null, |value| json!(value));\n00056|     policy[\"manifestUnqualifiedTarget\"] = values(\"manifest-unqualified-target\")\n00057|         .first()\n00058|         .map_or(Value::Null, |value| json!(value));\n00059|     policy[\"sourceUsage\"] = json!({\"heading\":values(\"source-usage-heading\").first().cloned(),\"call\":values(\"source-usage-call\").first().cloned(),\"reference\":values(\"source-usage-reference\").first().cloned(),\"codeOpen\":values(\"source-usage-code-open\").first().cloned(),\"codeClose\":values(\"source-usage-code-close\").first().cloned()});\n00060|     Some(policy)\n00061| }\n00062| \n00063| pub(super) fn concept_words(text: &str) -> Vec<String> {\n00064|     let camel = regex::Regex::new(r\"([a-z0-9])([A-Z])\").expect(\"StaticConceptBoundary\");\n00065|     let words = regex::Regex::new(r\"[^\\p{L}\\p{N}]+\").expect(\"StaticConceptWords\");\n00066|     let normalized = camel.replace_all(text, \"$1 $2\").to_lowercase();\n00067|     words\n00068|         .split(&normalized)\n00069|         .filter(|word| !word.is_empty())\n00070|         .map(str::to_owned)\n00071|         .collect()\n00072| }\n00073| \n00074| pub(super) fn documentation_authority(\n00075|     task: &str,\n00076|     guide_path: &str,\n00077|     actions: &[String],\n00078|     preserve: &[String],\n00079|     negations: &[String],\n00080|     prefixes: &[String],\n00081|     require_target_mention: bool,\n00082|     require_preservation: bool,\n00083| ) -> Option<&'static str> {\n00084|     if quote_fault(task).is_some() {\n00085|         return Some(\"DocumentationActionUnowned\");\n00086|     }\n00087|     let mut masked = task.as_bytes().to_vec();\n00088|     for span in quoted_segment_spans(task) {\n00089|         for byte in &mut masked[span.start..span.end] {\n00090|             if !matches!(*byte, b'\\r' | b'\\n') {\n00091|                 *byte = b' ';\n00092|             }\n00093|         }\n00094|     }\n00095|     let masked = String::from_utf8(masked).expect(\"MaskedQuoteUtf8\");\n00096|     if require_preservation\n00097|         && !preserve\n00098|             .iter()\n00099|             .any(|cue| concept_words(&masked).contains(cue))\n00100|     {\n00101|         return None;\n00102|     }\n00103|     let mut mentioned = false;\n00104|     for clause in sentences(&masked) {\n00105|         if require_target_mention && !task[clause.span.clone()].contains(guide_path) {\n00106|             continue;\n00107|         }\n00108|         let words = concept_words(clause.text);\n00109|         for action in actions {\n00110|             let Some(index) = words.iter().position(|word| word == action) else {\n00111|                 continue;\n00112|             };\n00113|             mentioned = true;\n00114|             let before = words[..index].join(\" \");\n00115|             if negations.iter().any(|negation| {\n00116|                 format!(\" {before} \").contains(&format!(\" {} \", concept_words(negation).join(\" \")))\n00117|             }) {\n00118|                 return Some(\"NegatedDocumentationAction\");\n00119|             }\n00120|             if index == 0 || prefixes.contains(&before) {\n00121|                 return Some(\"owned\");\n00122|             }\n00123|         }\n00124|     }\n00125|     let raw = concept_words(task);\n00126|     (mentioned || actions.iter().any(|action| raw.contains(action)))\n00127|         .then_some(\"DocumentationActionUnowned\")\n00128| }\n00129| \n00130| fn property_text(value: &Value) -> Option<String> {\n00131|     match value {\n00132|         Value::String(text) => Some(text.clone()),\n00133|         Value::Bool(value) => Some(value.to_string()),\n00134|         _ => None,\n00135|     }\n00136| }\n00137| \n00138| fn manifest_declaration_request(task: &str) -> bool {\n00139|     let Some(policy) = source_documentation_policy() else {\n00140|         return false;\n00141|     };\n00142|     if quote_fault(task).is_some() {\n00143|         return false;\n00144|     }\n00145|     let mut masked = task.as_bytes().to_vec();\n00146|     for span in quoted_segment_spans(task) {\n00147|         for byte in &mut masked[span.start..span.end] {\n00148|             if !matches!(*byte, b'\\r' | b'\\n') {\n00149|                 *byte = b' ';\n00150|             }\n00151|         }\n00152|     }\n00153|     let masked = String::from_utf8(masked).expect(\"MaskedManifestRequestUtf8\");\n00154|     sentences(&masked).iter().any(|clause| {\n00155|         let words = concept_words(clause.text);\n00156|         let phrase = format!(\" {} \", words.join(\" \"));\n00157|         if policy[\"negations\"].as_array().is_some_and(|cues| {\n00158|             cues.iter()\n00159|                 .filter_map(Value::as_str)\n00160|                 .any(|cue| phrase.contains(&format!(\" {} \", concept_words(cue).join(\" \"))))\n00161|         }) {\n00162|             return false;\n00163|         }\n00164|         [\"dependencyCues\", \"versionCues\", \"sectionCues\"]\n00165|             .iter()\n00166|             .all(|key| {\n00167|                 policy[*key].as_array().is_some_and(|cues| {\n00168|                     cues.iter()\n00169|                         .filter_map(Value::as_str)\n00170|                         .any(|cue| words.iter().any(|word| word == cue))\n00171|                 })\n00172|             })\n00173|     })\n00174| }\n00175| \n00176| /// Bind one requested concept to a scalar source field; ambiguity remains unresolved.\n00177| // Literal named template slots are replaced below; these are not Rust format strings.\n00178| #[expect(\n00179|     clippy::literal_string_with_formatting_args,\n00180|     reason = \"literal_template_slots_are_not_format_strings\"\n00181| )]\n00182| pub(super) fn derive_source_documentation(\n00183|     task: &str,\n00184|     source_path: &str,\n00185|     source: &str,\n00186|     guide: &str,\n00187|     template: &str,\n00188| ) -> Value {\n00189|     let Ok(value) = observed_source_json(source) else {\n00190|         return json!({\"gap\":\"InvalidSourceJson\"});\n00191|     };\n00192|     let Some(object) = value.as_object() else {\n00193|         return json!({\"gap\":\"SourceObjectRequired\"});\n00194|     };\n00195|     let requested = concept_words(task);\n00196|     let bindings: Vec<_> = object\n00197|         .iter()\n00198|         .filter(|(key, value)| {\n00199|             let words = concept_words(key);\n00200|             !words.is_empty()\n00201|                 && words.iter().all(|word| requested.contains(word))\n00202|                 && property_text(value).is_some()\n00203|         })\n00204|         .collect();\n00205|     if manifest_declaration_request(task) {\n00206|         if !bindings.is_empty() {\n00207|             return json!({\"gap\":\"AmbiguousDocumentationBinding\"});\n00208|         }\n00209|         return derive_manifest_documentation(task, source_path, source, guide, None);\n00210|     }\n00211|     if bindings.len() != 1 {\n00212|         return json!({\"gap\":if bindings.is_empty() {\"MissingPropertyBinding\"} else {\"AmbiguousPropertyBinding\"}});\n00213|     }\n00214|     let (key, value) = bindings[0];\n00215|     let text = property_text(value).expect(\"ScalarBinding\");\n00216|     if text.contains(['\\r', '\\n', '`']) || source_path.contains(['\\r', '\\n', '`']) {\n00217|         return json!({\"gap\":\"UnsupportedDocumentationValue\"});\n00218|     }\n00219|     let paragraph = template\n00220|         .replace(\"{source}\", source_path)\n00221|         .replace(\"{concept}\", &concept_words(key).join(\" \"))\n00222|         .replace(\"{value}\", &text);\n00223|     let content = if guide.contains(&paragraph) {\n00224|         guide.to_owned()\n00225|     } else {\n00226|         format!(\n00227|             \"{}\\n\\n{paragraph}\\n\",\n00228|             guide.strip_suffix('\\n').unwrap_or(guide)\n00229|         )\n00230|     };\n00231|     json!({\"key\":key,\"value\":value,\"paragraph\":paragraph,\"sourceIdentity\":sha256_hex(source.as_bytes()),\"content\":content})\n00232| }\n00233| \n00234| /// Same read/candidate/edit/readback and no-op contract as the JavaScript route.\n00235| pub(super) fn plan_source_documentation_step(\n00236|     task: &str,\n00237|     messages: &[ChatMessage],\n00238|     tools: &[&str],\n00239|     work_item: Option<&str>,\n00240|     result: &mut Option<FinalResult>,\n00241| ) -> Option<AgenticPlan> {\n00242|     let policy = source_documentation_policy()?;\n00243|     let values = |name: &str| {\n00244|         policy[name]\n00245|             .as_array()\n00246|             .map(|items| {\n00247|                 items\n00248|                     .iter()\n00249|                     .filter_map(Value::as_str)\n00250|                     .map(str::to_owned)\n00251|                     .collect::<Vec<_>>()\n00252|             })\n00253|             .unwrap_or_default()\n00254|     };\n00255|     let template = policy[\"template\"].as_str()?;\n00256|     let paths = super::work_item_evidence::work_item_evidence_paths(task);\n00257|     let sources = paths\n00258|         .iter()\n00259|         .copied()\n00260|         .filter(|path| path.ends_with(\".json\"))\n00261|         .collect::<Vec<_>>();\n00262|     let guides = paths\n00263|         .iter()\n00264|         .copied()\n00265|         .filter(|path| path.ends_with(\".md\"))\n00266|         .collect::<Vec<_>>();\n00267|     if paths.len() != 2 || sources.len() != 1 || guides.len() != 1 {\n00268|         return None;\n00269|     }\n00270|     let source_path = sources[0];\n00271|     let target = guides[0];\n00272|     let authority = documentation_authority(\n00273|         task,\n00274|         target,\n00275|         &values(\"actions\"),\n00276|         &values(\"preserve\"),\n00277|         &values(\"negations\"),\n00278|         &values(\"prefixes\"),\n00279|         true,\n00280|         true,\n00281|     )?;\n00282|     Some(plan_observed_documentation(\n00283|         task,\n00284|         messages,\n00285|         tools,\n00286|         &json!({\"sources\":sources,\"target\":target,\"authority\":authority,\"workItem\":work_item}),\n00287|         |observed, guide| {\n00288|             observed\n00289|                 .first()\n00290|                 .and_then(|row| row[\"source\"].as_str())\n00291|                 .map_or_else(\n00292|                     || json!({\"gap\":\"EditPreconditionObservationMissing\"}),\n00293|                     |source| {\n00294|                         derive_source_documentation(task, source_path, source, guide, template)\n00295|                     },\n00296|                 )\n00297|         },\n00298|         result,\n00299|     ))\n00300| }\n00301| \n00302| #[cfg(test)]\n00303| #[path = \"../../tests/unit/agentic-coding/source_documentation.rs\"]\n00304| mod tests;\n\n(End of file - total 304 lines)\n</file>",
