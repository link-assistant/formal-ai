[2026-07-20T17:11:45.265Z] [INFO]       {
[2026-07-20T17:11:45.265Z] [INFO]         "tool_use_id": "toolu_011nR7riwyFna6F14hkRZsmy",
[2026-07-20T17:11:45.265Z] [INFO]         "type": "tool_result",
[2026-07-20T17:11:45.265Z] [INFO]         "content": "1\t//! Deterministically measure release work backed by committed Formal AI sessions.\n2\t//!\n3\t//! Run with `rust-script scripts/self-hosting-metric.rs --since <tag>`. A commit\n4\t//! is attributed only when it records both of these Git trailers:\n5\t//!\n6\t//! - `Formal-AI-Session: <session-id>`\n7\t//! - `Formal-AI-Evidence: <repo-relative-path>`\n8\t//!\n9\t//! The evidence must exist in that commit and contain both `formal-ai` and the\n10\t//! recorded session id. Changed lines are additions plus deletions reported by\n11\t//! `git show --numstat`; merge commits and binary files do not contribute.\n12\t\n13\t#![allow(dead_code)]\n14\t\n15\tuse std::env;\n16\tuse std::fs::{self, OpenOptions};\n17\tuse std::io::Write;\n18\tuse std::path::{Component, Path, PathBuf};\n19\tuse std::process::Command;\n20\t\n21\tconst SESSION_TRAILER: &str = \"Formal-AI-Session\";\n22\tconst EVIDENCE_TRAILER: &str = \"Formal-AI-Evidence\";\n23\tconst DEFAULT_LEDGER: &str = \"data/meta/self-hosting-ledger.lino\";\n24\tconst DEFAULT_TRAILING_WINDOW: usize = 3;\n25\t\n26\t#[derive(Clone, Debug, Eq, PartialEq)]\n27\tpub struct Measurement {\n28\t    pub self_authored_lines: u64,\n29\t    pub changed_lines: u64,\n30\t    pub self_authored_commits: u64,\n31\t    pub commits: u64,\n32\t    pub percentage_basis_points: u64,\n33\t}\n34\t\n35\t#[derive(Clone, Debug, Eq, PartialEq)]\n36\tpub struct ReleaseRow {\n37\t    pub tag: String,\n38\t    pub since: String,\n39\t    pub until: String,\n40\t    pub self_authored_lines: u64,\n41\t    pub changed_lines: u64,\n42\t    pub self_authored_commits: u64,\n43\t    pub commits: u64,\n44\t    pub percentage_basis_points: u64,\n45\t    pub trailing_window: usize,\n46\t    pub trailing_percentage_basis_points: u64,\n47\t}\n48\t\n49\tpub fn format_percentage(basis_points: u64) -> String {\n50\t    format!(\"{}.{:02}%\", basis_points / 100, basis_points % 100)\n51\t}\n52\t\n53\t/// How a malformed evidence record is treated.\n54\t///\n55\t/// Issue #810: the `Formal-AI-Evidence` gate (`evidence-check` in\n56\t/// `.github/workflows/release.yml`) was introduced in 39fdef91, *after* commit\n57\t/// 10e65ae2 had already merged with an evidence document that never spells out\n58\t/// its own `Formal-AI-Session` id. Because `record_release` measures\n59\t/// `<last tag>..HEAD`, that historical commit stayed inside the release range\n60\t/// forever, `Auto Release` aborted on it every single run (29737218421), and no\n61\t/// new tag could ever be cut to move the range past it — a permanent deadlock\n62\t/// that history cannot be edited out of.\n63\t///\n64\t/// So the two callers get different policies:\n65\t///\n66\t/// - `Strict` — the pull-request gate. New commits must be well formed, and a\n67\t///   malformed record is a hard error *before* it can reach the default branch.\n68\t/// - `Lenient` — release recording. A malformed record is reported on stderr and\n69\t///   the commit simply does not count as self-authored. The metric can only\n70\t///   under-report, never over-report, so the ratchet stays honest.\n71\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n72\tpub enum EvidencePolicy {\n73\t    Strict,\n74\t    Lenient,\n75\t}\n76\t\n77\tpub fn measure(repo: &Path, since: &str, until: &str) -> Result<Measurement, String> {\n78\t    measure_with_policy(repo, since, until, EvidencePolicy::Strict)\n79\t}\n80\t\n81\tpub fn measure_with_policy(\n82\t    repo: &Path,\n83\t    since: &str,\n84\t    until: &str,\n85\t    policy: EvidencePolicy,\n86\t) -> Result<Measurement, String> {\n87\t    let range = format!(\"{since}..{until}\");\n88\t    let output = git(repo, &[\"rev-list\", \"--reverse\", \"--no-merges\", &range])?;\n89\t    let commits = output\n90\t        .lines()\n91\t        .filter(|line| !line.is_empty())\n92\t        .collect::<Vec<_>>();\n93\t    let mut changed_lines = 0_u64;\n94\t    let mut self_authored_lines = 0_u64;\n95\t    let mut self_authored_commits = 0_u64;\n96\t\n97\t    for commit in &commits {\n98\t        let lines = changed_lines_for_commit(repo, commit)?;\n99\t        changed_lines = changed_lines\n100\t            .checked_add(lines)\n101\t            .ok_or_else(|| \"changed-line total overflowed u64\".to_owned())?;\n102\t        let attributed = match commit_has_formal_ai_evidence(repo, commit) {\n103\t            Ok(attributed) => attributed,\n104\t            Err(error) => match policy {\n105\t                EvidencePolicy::Strict => return Err(error),\n106\t                EvidencePolicy::Lenient => {\n107\t                    eprintln!(\"warning: not attributing {commit}: {error}\");\n108\t                    false\n109\t                }\n110\t            },\n111\t        };\n112\t        if attributed {\n113\t            self_authored_lines = self_authored_lines\n114\t                .checked_add(lines)\n115\t                .ok_or_else(|| \"self-authored line total overflowed u64\".to_owned())?;\n116\t            self_authored_commits += 1;\n117\t        }\n118\t    }\n119\t\n120\t    Ok(Measurement {\n121\t        self_authored_lines,\n122\t        changed_lines,\n123\t        self_authored_commits,\n124\t        commits: commits.len() as u64,\n125\t        percentage_basis_points: percentage_basis_points(self_authored_lines, changed_lines),\n126\t    })\n127\t}\n128\t\n129\tfn changed_lines_for_commit(repo: &Path, commit: &str) -> Result<u64, String> {\n130\t    let output = git(\n131\t        repo,\n132\t        &[\"show\", \"--format=\", \"--numstat\", \"--no-renames\", commit],\n133\t    )?;\n134\t    output.lines().try_fold(0_u64, |total, line| {\n135\t        let mut fields = line.split('\\t');\n136\t        let additions = fields.next().unwrap_or_default();\n137\t        let deletions = fields.next().unwrap_or_default();\n138\t        if additions == \"-\" || deletions == \"-\" {\n139\t            return Ok(total);\n140\t        }\n141\t        let additions = additions\n142\t            .parse::<u64>()\n143\t            .map_err(|error| format!(\"invalid numstat additions in {commit}: {error}\"))?;\n144\t        let deletions = deletions\n145\t            .parse::<u64>()\n146\t            .map_err(|error| format!(\"invalid numstat deletions in {commit}: {error}\"))?;\n147\t        total\n148\t            .checked_add(additions)\n149\t            .and_then(|sum| sum.checked_add(deletions))\n150\t            .ok_or_else(|| format!(\"changed-line count overflowed in {commit}\"))\n151\t    })\n152\t}\n153\t\n154\tfn commit_has_formal_ai_evidence(repo: &Path, commit: &str) -> Result<bool, String> {\n155\t    let sessions = trailer_values(repo, commit, SESSION_TRAILER)?;\n156\t    let evidence_paths = trailer_values(repo, commit, EVIDENCE_TRAILER)?;\n157\t    if sessions.is_empty() && evidence_paths.is_empty() {\n158\t        return Ok(false);\n159\t    }\n160\t    if sessions.is_empty() || evidence_paths.is_empty() {\n161\t        return Err(format!(\n162\t            \"commit {commit} must record both {SESSION_TRAILER} and {EVIDENCE_TRAILER}\"\n163\t        ));\n164\t    }\n165\t\n166\t    let mut evidence = Vec::with_capacity(evidence_paths.len());\n167\t    for path in evidence_paths {\n168\t        validate_evidence_path(&path)?;\n169\t        let object = format!(\"{commit}:{path}\");\n170\t        let content = git(repo, &[\"show\", &object])?;\n171\t        if !content.to_ascii_lowercase().contains(\"formal-ai\") {\n172\t            return Err(format!(\n173\t                \"evidence {path} in commit {commit} does not identify formal-ai\"\n174\t            ));\n175\t        }\n176\t        evidence.push((path, content));\n177\t    }\n178\t\n179\t    for session in sessions {\n180\t        if !evidence\n181\t            .iter()\n182\t            .any(|(_, content)| content.contains(&session))\n183\t        {\n184\t            return Err(format!(\n185\t                \"no committed {EVIDENCE_TRAILER} in {commit} records session {session}\"\n186\t            ));\n187\t        }\n188\t    }\n189\t    Ok(true)\n190\t}\n191\t\n192\t/// Collects `key: value` trailers from a commit message.\n193\t///\n194\t/// This deliberately scans the whole commit body instead of using git's\n195\t/// `%(trailers:key=...)` placeholder. Git only recognises the *last* paragraph\n196\t/// of a message as the trailer block, so a blank line between two trailers\n197\t/// makes every trailer above it invisible. Release commit\n198\t/// 59650f2b45ebebf29ed67d33c9a19c1e82e7c003 separated its `Formal-AI-Session`\n199\t/// and `Formal-AI-Evidence` trailers with a blank line, git reported only the\n200\t/// evidence trailer, and the resulting \"must record both\" error failed the\n201\t/// whole Auto Release job (issue #796).\n202\tfn trailer_values(repo: &Path, commit: &str, key: &str) -> Result<Vec<String>, String> {\n203\t    let body = git(repo, &[\"show\", \"-s\", \"--format=%B\", commit])?;\n204\t    let prefix = format!(\"{key}:\");\n205\t    Ok(body\n206\t        .lines()\n207\t        .filter_map(|line| {\n208\t            let line = line.trim();\n209\t            // Trailer keys are case-insensitive per `git interpret-trailers`.\n210\t            line.get(..prefix.len())\n211\t                .filter(|candidate| candidate.eq_ignore_ascii_case(&prefix))\n212\t                .map(|_| line[prefix.len()..].trim())\n213\t        })\n214\t        .filter(|value| !value.is_empty())\n215\t        .map(str::to_owned)\n216\t        .collect())\n217\t}\n218\t\n219\tfn validate_evidence_path(path: &str) -> Result<(), String> {\n220\t    let candidate = Path::new(path);\n221\t    if path.contains(':')\n222\t        || path.contains('\\n')\n223\t        || candidate.is_absolute()\n224\t        || candidate\n225\t            .components()\n226\t            .any(|component| !matches!(component, Component::Normal(_)))\n227\t    {\n228\t        return Err(format!(\n229\t            \"{EVIDENCE_TRAILER} must be a normal repo-relative path: {path}\"\n230\t        ));\n231\t    }\n232\t    Ok(())\n233\t}\n234\t\n235\tfn percentage_basis_points(numerator: u64, denominator: u64) -> u64 {\n236\t    if denominator == 0 {\n237\t        return 0;\n238\t    }\n239\t    let rounded =\n240\t        (u128::from(numerator) * 10_000 + u128::from(denominator) / 2) / u128::from(denominator);\n241\t    u64::try_from(rounded).expect(\"percentage basis points fit in u64\")\n242\t}\n243\t\n244\tpub fn record_release(\n245\t    repo: &Path,\n246\t    ledger: &Path,\n247\t    tag: &str,\n248\t    since: &str,\n249\t    until: &str,\n250\t    trailing_window: usize,\n251\t) -> Result<ReleaseRow, String> {\n252\t    if trailing_window == 0 {\n253\t        return Err(\"trailing window must be greater than zero\".to_owned());\n254\t    }\n255\t    let rows = read_release_rows(ledger)?;\n256\t    // Lenient on purpose: see `EvidencePolicy`. The pull-request gate is what\n257\t    // keeps new commits honest; a release must never be blocked by a commit\n258\t    // that is already immutable history.\n259\t    let measurement = measure_with_policy(repo, since, until, EvidencePolicy::Lenient)?;\n260\t    let until_commitish = format!(\"{until}^{{commit}}\");\n261\t    let canonical_until = git(repo, &[\"rev-parse\", &until_commitish])?\n262\t        .trim()\n263\t        .to_owned();\n264\t    let mut window_rows = rows\n265\t        .iter()\n266\t        .rev()\n267\t        .take(trailing_window.saturating_sub(1))\n268\t        .cloned()\n269\t        .collect::<Vec<_>>();\n270\t    window_rows.reverse();\n271\t    let mut row = ReleaseRow {\n272\t        tag: tag.to_owned(),\n273\t        since: since.to_owned(),\n274\t        until: canonical_until,\n275\t        self_authored_lines: measurement.self_authored_lines,\n276\t        changed_lines: measurement.changed_lines,\n277\t        self_authored_commits: measurement.self_authored_commits,\n278\t        commits: measurement.commits,\n279\t        percentage_basis_points: measurement.percentage_basis_points,\n280\t        trailing_window,\n281\t        trailing_percentage_basis_points: 0,\n282\t    };\n283\t    window_rows.push(row.clone());\n284\t    row.trailing_percentage_basis_points = weighted_percentage(&window_rows);\n285\t\n286\t    if let Some(existing) = rows.iter().find(|existing| existing.tag == tag) {\n287\t        if existing == &row {\n288\t            return Ok(existing.clone());\n289\t        }\n290\t        return Err(format!(\n291\t            \"release {tag} already has a different self-hosting ledger row\"\n292\t        ));\n293\t    }\n294\t    if let Some(previous) = rows.last() {\n295\t        if row.trailing_percentage_basis_points < previous.trailing_percentage_basis_points {\n296\t            return Err(format!(\n297\t                \"self-hosting ratchet would fall from {} to {} for {tag}\",\n298\t                format_percentage(previous.trailing_percentage_basis_points),\n299\t                format_percentage(row.trailing_percentage_basis_points)\n300\t            ));\n301\t        }\n302\t    }\n303\t    append_release_row(ledger, &row)?;\n304\t    Ok(row)\n305\t}\n306\t\n307\tfn weighted_percentage(rows: &[ReleaseRow]) -> u64 {\n308\t    let self_authored = rows.iter().map(|row| row.self_authored_lines).sum::<u64>();\n309\t    let changed = rows.iter().map(|row| row.changed_lines).sum::<u64>();\n310\t    percentage_basis_points(self_authored, changed)\n311\t}\n312\t\n313\tpub fn read_release_rows(ledger: &Path) -> Result<Vec<ReleaseRow>, String> {\n314\t    let text = fs::read_to_string(ledger)\n315\t        .map_err(|error| format!(\"could not read {}: {error}\", ledger.display()))?;\n316\t    let mut rows = Vec::new();\n317\t    let mut fields = Vec::new();\n318\t    for line in text.lines() {\n319\t        if line.trim() == \"release\" {\n320\t            if !fields.is_empty() {\n321\t                rows.push(parse_release_row(&fields)?);\n322\t                fields.clear();\n323\t            }\n324\t        } else if line.starts_with(\"    \") {\n325\t            fields.push(line.trim().to_owned());\n326\t        }\n327\t    }\n328\t    if !fields.is_empty() {\n329\t        rows.push(parse_release_row(&fields)?);\n330\t    }\n331\t    Ok(rows)\n332\t}\n333\t\n334\tfn parse_release_row(fields: &[String]) -> Result<ReleaseRow, String> {\n335\t    let value = |key: &str| -> Result<String, String> {\n336\t        let prefix = format!(\"{key} \\\"\");\n337\t        fields\n338\t            .iter()\n339\t            .find_map(|field| {\n340\t                field\n341\t                    .strip_prefix(&prefix)\n342\t                    .and_then(|value| value.strip_suffix('\"'))\n343\t                    .map(str::to_owned)\n344\t            })\n345\t            .ok_or_else(|| format!(\"release row is missing {key}\"))\n346\t    };\n347\t    let number = |key: &str| -> Result<u64, String> {\n348\t        value(key)?\n349\t            .parse::<u64>()\n350\t            .map_err(|error| format!(\"release row has invalid {key}: {error}\"))\n351\t    };\n352\t    Ok(ReleaseRow {\n353\t        tag: value(\"tag\")?,\n354\t        since: value(\"since\")?,\n355\t        until: value(\"until\")?,\n356\t        self_authored_lines: number(\"self_authored_lines\")?,\n357\t        changed_lines: number(\"changed_lines\")?,\n358\t        self_authored_commits: number(\"self_authored_commits\")?,\n359\t        commits: number(\"commits\")?,\n360\t        percentage_basis_points: number(\"percentage_basis_points\")?,\n361\t        trailing_window: usize::try_from(number(\"trailing_window\")?)\n362\t            .map_err(|_| \"trailing_window does not fit usize\".to_owned())?,\n363\t        trailing_percentage_basis_points: number(\"trailing_percentage_basis_points\")?,\n364\t    })\n365\t}\n366\t\n367\tfn append_release_row(ledger: &Path, row: &ReleaseRow) -> Result<(), String> {\n368\t    let mut file = OpenOptions::new()\n369\t        .append(true)\n370\t        .open(ledger)\n371\t        .map_err(|error| format!(\"could not append {}: {error}\", ledger.display()))?;\n372\t    writeln!(\n373\t        file,\n374\t        \"  release\\n    tag \\\"{}\\\"\\n    since \\\"{}\\\"\\n    until \\\"{}\\\"\\n    \\\n375\t         self_authored_lines \\\"{}\\\"\\n    changed_lines \\\"{}\\\"\\n    self_authored_commits \\\n376\t         \\\"{}\\\"\\n    commits \\\"{}\\\"\\n    percentage_basis_points \\\"{}\\\"\\n    trailing_window \\\n377\t         \\\"{}\\\"\\n    trailing_percentage_basis_points \\\"{}\\\"\",\n378\t        row.tag,\n379\t        row.since,\n380\t        row.until,\n381\t        row.self_authored_lines,\n382\t        row.changed_lines,\n383\t        row.self_authored_commits,\n384\t        row.commits,\n385\t        row.percentage_basis_points,\n386\t        row.trailing_window,\n387\t        row.trailing_percentage_basis_points,\n388\t    )\n389\t    .map_err(|error| format!(\"could not append {}: {error}\", ledger.display()))\n390\t}\n391\t\n392\tpub fn release_note_for_tag(ledger: &Path, tag: &str) -> Result<String, String> {\n393\t    let row = read_release_rows(ledger)?\n394\t        .into_iter()\n395\t        .find(|row| row.tag == tag)\n396\t        .ok_or_else(|| format!(\"self-hosting ledger has no release row for {tag}\"))?;\n397\t    Ok(format!(\n398\t        \"## Self-hosting\\n\\nFormal AI authored **{}** of this release ({} of {} changed lines). The \\\n399\t         {}-release trailing share is **{}**.\",\n400\t        format_percentage(row.percentage_basis_points),\n401\t        row.self_authored_lines,\n402\t        row.changed_lines,\n403\t        row.trailing_window,\n404\t        format_percentage(row.trailing_percentage_basis_points),\n405\t    ))\n406\t}\n407\t\n408\tfn git(repo: &Path, args: &[&str]) -> Result<String, String> {\n409\t    let output = Command::new(\"git\")\n410\t        .arg(\"-C\")\n411\t        .arg(repo)\n412\t        .args(args)\n413\t        .output()\n414\t        .map_err(|error| format!(\"could not run git {args:?}: {error}\"))?;\n415\t    if !output.status.success() {\n416\t        return Err(format!(\n417\t            \"git {args:?} failed: {}\",\n418\t            String::from_utf8_lossy(&output.stderr).trim()\n419\t        ));\n420\t    }\n421\t    String::from_utf8(output.stdout).map_err(|error| format!(\"git output was not UTF-8: {error}\"))\n422\t}\n423\t\n424\t#[derive(Debug)]\n425\tstruct Options {\n426\t    repo: PathBuf,\n427\t    since: String,\n428\t    until: String,\n429\t    ledger: PathBuf,\n430\t    record_release: Option<String>,\n431\t    trailing_window: usize,\n432\t}\n433\t\n434\tfn parse_options(args: impl IntoIterator<Item = String>) -> Result<Options, String> {\n435\t    let mut repo = PathBuf::from(\".\");\n436\t    let mut since = None;\n437\t    let mut until = \"HEAD\".to_owned();\n438\t    let mut ledger = PathBuf::from(DEFAULT_LEDGER);\n439\t    let mut record_release = None;\n440\t    let mut trailing_window = DEFAULT_TRAILING_WINDOW;\n441\t    let mut args = args.into_iter();\n442\t    while let Some(arg) = args.next() {\n443\t        let value = |args: &mut dyn Iterator<Item = String>| {\n444\t            args.next().ok_or_else(|| format!(\"{arg} requires a value\"))\n445\t        };\n446\t        match arg.as_str() {\n447\t            \"--repo\" => repo = PathBuf::from(value(&mut args)?),\n448\t            \"--since\" => since = Some(value(&mut args)?),\n449\t            \"--until\" => until = value(&mut args)?,\n450\t            \"--ledger\" => ledger = PathBuf::from(value(&mut args)?),\n451\t            \"--record-release\" => record_release = Some(value(&mut args)?),\n452\t            \"--trailing-window\" => {\n453\t                trailing_window = value(&mut args)?\n454\t                    .parse::<usize>()\n455\t                    .map_err(|error| format!(\"invalid --trailing-window: {error}\"))?;\n456\t            }\n457\t            \"--help\" | \"-h\" => {\n458\t                return Err(\n459\t                    \"usage: self-hosting-metric.rs --since <tag> [--until <rev>] \\\n460\t                     [--record-release <tag>] [--ledger <path>] [--repo <path>]\"\n461\t                        .to_owned(),\n462\t                );\n463\t            }\n464\t            _ => return Err(format!(\"unknown argument: {arg}\")),\n465\t        }\n466\t    }\n467\t    let since = since.ok_or_else(|| \"--since <tag> is required\".to_owned())?;\n468\t    let ledger = if ledger.is_absolute() {\n469\t        ledger\n470\t    } else {\n471\t        repo.join(ledger)\n472\t    };\n473\t    Ok(Options {\n474\t        repo,\n475\t        since,\n476\t        until,\n477\t        ledger,\n478\t        record_release,\n479\t        trailing_window,\n480\t    })\n481\t}\n482\t\n483\tfn run() -> Result<(), String> {\n484\t    let options = parse_options(env::args().skip(1))?;\n485\t    let measurement = if let Some(tag) = options.record_release {\n486\t        let row = record_release(\n487\t            &options.repo,\n488\t            &options.ledger,\n489\t            &tag,\n490\t            &options.since,\n491\t            &options.until,\n492\t            options.trailing_window,\n493\t        )?;\n494\t        Measurement {\n495\t            self_authored_lines: row.self_authored_lines,\n496\t            changed_lines: row.changed_lines,\n497\t            self_authored_commits: row.self_authored_commits,\n498\t            commits: row.commits,\n499\t            percentage_basis_points: row.percentage_basis_points,\n500\t        }\n501\t    } else {\n502\t        measure(&options.repo, &options.since, &options.until)?\n503\t    };\n504\t    println!(\n505\t        \"{} ({}/{} changed lines; {}/{} commits)\",\n506\t        format_percentage(measurement.percentage_basis_points),\n507\t        measurement.self_authored_lines,\n508\t        measurement.changed_lines,\n509\t        measurement.self_authored_commits,\n510\t        measurement.commits,\n511\t    );\n512\t    Ok(())\n513\t}\n514\t\n515\tfn main() {\n516\t    if let Err(error) = run() {\n517\t        eprintln!(\"self-hosting metric error: {error}\");\n518\t        std::process::exit(1);\n519\t    }\n520\t}\n521\t"
