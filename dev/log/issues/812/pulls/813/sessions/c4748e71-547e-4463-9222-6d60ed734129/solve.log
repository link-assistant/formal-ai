[2026-07-20T17:17:05.131Z] [INFO]         "content": "#!/usr/bin/env bash\nset -euo pipefail\n\nif command -v rust-script >/dev/null 2>&1; then\n  rust-script --version\n  exit 0\nfi\n\nattempts=\"${RUST_SCRIPT_INSTALL_ATTEMPTS:-3}\"\ndelay=\"${RUST_SCRIPT_INSTALL_RETRY_DELAY_SECONDS:-10}\"\n\nfor attempt in $(seq 1 \"$attempts\"); do\n  echo \"Installing rust-script (attempt ${attempt}/${attempts})\"\n  if cargo install rust-script --locked; then\n    rust-script --version\n    exit 0\n  fi\n\n  status=$?\n  if [ \"$attempt\" -eq \"$attempts\" ]; then\n    echo \"rust-script install failed after ${attempts} attempts\"\n    exit \"$status\"\n  fi\n\n  echo \"rust-script install failed with status ${status}; retrying in ${delay}s\"\n  sleep \"$delay\"\ndone\n======= check-secrets.sh\n     1\t#!/usr/bin/env bash\n     2\t# check-secrets.sh\n     3\t#\n     4\t# Scans the files a change touches for committed credentials, using secretlint\n     5\t# with the recommended preset (CI-CD-BEST-PRACTICES.md section 11 / issue #808).\n     6\t#\n     7\t# Usage:\n     8\t#   BASE_REF=main bash scripts/check-secrets.sh     # scan the diff vs BASE_REF\n     9\t#   bash scripts/check-secrets.sh --all             # scan every tracked file\n    10\t#   bash scripts/check-secrets.sh path/to/file ...  # scan specific files\n    11\t#\n    12\t# Exit code 0 = no secrets found; non-zero = secretlint reported a finding.\n    13\t#\n    14\t# Why the diff and not the whole tree\n    15\t# -----------------------------------\n    16\t# The js template runs `secretlint \"**/*\"`. Measured on this repository that\n    17\t# does not finish in a usable time: the glob walks the working tree (including\n    18\t# `target/` and ~150 MB of committed case-study logs) and the scan was still\n    19\t# running after 25 minutes locally. A gate that cannot be relied on to finish is\n    20\t# a new CI failure mode, which is the opposite of what issue #808 asks for.\n    21\t#\n    22\t# Scanning what the change touches keeps the gate fast and catches the case that\n    23\t# matters: a credential being *introduced*. Pre-existing files are not re-scanned\n    24\t# on every pull request; run `--all` (no timeout) to audit the whole tree.\n    25\t#\n    26\t# FORMAL_AI_SECRETS_DEBUG=1 prints the resolved file list before scanning.\n    27\tset -euo pipefail\n    28\t\n    29\tcd \"$(dirname \"$0\")/..\"\n    30\t\n    31\tdebug() {\n    32\t  if [ \"${FORMAL_AI_SECRETS_DEBUG:-0}\" = \"1\" ]; then\n    33\t    printf '[check-secrets] %s\\n' \"$1\" >&2\n    34\t  fi\n    35\t}\n    36\t\n    37\t# Captured third-party CI/agent logs kept verbatim as evidence. They are\n    38\t# reviewed when added and consist of redacted GitHub Actions output.\n    39\texclude() {\n    40\t  grep -zv -e '^docs/case-studies/.*\\.log$' -e '^dev/log/.*ci-logs/.*\\.log$' || true\n    41\t}\n    42\t\n    43\tfiles=()\n    44\tif [ \"${1:-}\" = \"--all\" ]; then\n    45\t  echo \"Scanning every tracked file (this is slow; there is no timeout here).\"\n    46\t  mapfile -d '' files < <(git ls-files -z | exclude)\n    47\telif [ \"$#\" -gt 0 ]; then\n    48\t  files=(\"$@\")\n    49\telif [ -n \"${BASE_REF:-}\" ]; then\n    50\t  base=\"origin/${BASE_REF}\"\n    51\t  git rev-parse --verify --quiet \"$base\" >/dev/null || base=\"${BASE_REF}\"\n    52\t  # A push event's `before` SHA is all-zeroes for a new branch, and is unknown\n    53\t  # to this clone after a force-push. Fall back to the previous commit rather\n    54\t  # than failing the job on something that is not a secret problem.\n    55\t  if ! git rev-parse --verify --quiet \"${base}^{commit}\" >/dev/null; then\n    56\t    echo \"Base ref '${BASE_REF}' does not resolve here; falling back to HEAD~1\"\n    57\t    base=\"HEAD~1\"\n    58\t  fi\n    59\t  merge_base=\"$(git merge-base \"$base\" HEAD)\"\n    60\t  echo \"Scanning files changed in ${merge_base}..HEAD\"\n    61\t  # -z for paths with spaces; ACMRT drops deletions, which have nothing to scan.\n    62\t  mapfile -d '' files < <(git diff --name-only --diff-filter=ACMRT -z \"$merge_base\" HEAD | exclude)\n    63\telse\n    64\t  echo \"Scanning uncommitted and untracked changes\"\n    65\t  mapfile -d '' files < <(\n    66\t    { git diff --name-only --diff-filter=ACMRT -z HEAD; git ls-files -z --others --exclude-standard; } | exclude\n    67\t  )\n    68\tfi\n    69\t\n    70\tif [ \"${#files[@]}\" -eq 0 ]; then\n    71\t  echo \"No files to scan.\"\n    72\t  exit 0\n    73\tfi\n    74\t\n    75\techo \"Scanning ${#files[@]} file(s) for secrets...\"\n    76\tfor f in \"${files[@]}\"; do\n    77\t  debug \"$f\"\n    78\tdone\n    79\t\n    80\tprintf '%s\\0' \"${files[@]}\" |\n    81\t  xargs -0 npx --yes \\\n    82\t    -p secretlint \\\n    83\t    -p @secretlint/secretlint-rule-preset-recommend \\\n    84\t    secretlint\n    85\t\n    86\techo \"No secrets found.\"",
