[2026-07-20T17:14:48.341Z] [INFO]         "content": "949\t      contents: write\n950\t      packages: write\n951\t    steps:\n952\t      - uses: actions/checkout@v6\n953\t        with:\n954\t          fetch-depth: 0\n955\t          token: ${{ secrets.GITHUB_TOKEN }}\n956\t\n957\t      - name: Setup Rust\n958\t        uses: dtolnay/rust-toolchain@stable\n959\t\n960\t      - name: Install rust-script\n961\t        run: bash scripts/install-rust-script.sh\n962\t\n963\t      - name: Configure git\n964\t        run: rust-script scripts/git-config.rs\n965\t\n966\t      - name: Version and commit\n967\t        id: version\n968\t        env:\n969\t          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n970\t          DESCRIPTION: ${{ github.event.inputs.description }}\n971\t        run: rust-script scripts/version-and-commit.rs --bump-type \"${{ github.event.inputs.bump_type }}\" --description \"${{ github.event.inputs.description }}\"\n972\t\n973\t      - name: Build release\n974\t        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n975\t        run: cargo build --release\n976\t\n977\t      - name: Publish to Crates.io\n978\t        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n979\t        id: publish-crate\n980\t        env:\n981\t          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n982\t          CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n983\t        run: rust-script scripts/publish-crate.rs\n984\t\n985\t      - name: Wait for Crate availability on Crates.io\n986\t        if: |\n987\t          (steps.version.outputs.version_committed == 'true' ||\n988\t            steps.version.outputs.already_released == 'true') &&\n989\t          steps.publish-crate.outputs.publish_result == 'success'\n990\t        run: rust-script scripts/wait-for-crate.rs --release-version \"${{ steps.version.outputs.new_version }}\"\n991\t\n992\t      - name: Smoke test the published crate\n993\t        if: |\n994\t          (steps.version.outputs.version_committed == 'true' ||\n995\t            steps.version.outputs.already_released == 'true') &&\n996\t          steps.publish-crate.outputs.publish_result == 'success'\n997\t        run: scripts/smoke-test-published-crate.sh \"${{ steps.version.outputs.new_version }}\"\n998\t\n999\t      # See the auto-release job: the Docker build below needs headroom that\n1000\t      # `Build release` has already consumed.\n1001\t      - name: Free up runner disk space\n1002\t        if: |\n1003\t          (steps.version.outputs.version_committed == 'true' ||\n1004\t            steps.version.outputs.already_released == 'true') &&\n1005\t          steps.publish-crate.outputs.publish_result == 'success'\n1006\t        run: bash scripts/free-runner-disk.sh\n1007\t\n1008\t      - name: Log in to GitHub Container Registry\n1009\t        if: |\n1010\t          (steps.version.outputs.version_committed == 'true' ||\n1011\t            steps.version.outputs.already_released == 'true') &&\n1012\t          steps.publish-crate.outputs.publish_result == 'success'\n1013\t        uses: docker/login-action@v4\n1014\t        with:\n1015\t          registry: ghcr.io\n1016\t          username: ${{ github.actor }}\n1017\t          password: ${{ secrets.GITHUB_TOKEN }}\n1018\t\n1019\t      - name: Set up Docker Buildx\n1020\t        if: |\n1021\t          (steps.version.outputs.version_committed == 'true' ||\n1022\t            steps.version.outputs.already_released == 'true') &&\n1023\t          steps.publish-crate.outputs.publish_result == 'success'\n1024\t        uses: ./.github/actions/setup-buildx-resilient\n1025\t\n1026\t      - name: Extract GHCR Docker metadata\n1027\t        if: |\n1028\t          (steps.version.outputs.version_committed == 'true' ||\n1029\t            steps.version.outputs.already_released == 'true') &&\n1030\t          steps.publish-crate.outputs.publish_result == 'success'\n1031\t        id: ghcr-meta\n1032\t        uses: docker/metadata-action@v6\n1033\t        with:\n1034\t          images: ${{ env.GHCR_IMAGE }}\n1035\t          tags: |\n1036\t            type=raw,value=latest\n1037\t            type=raw,value=${{ steps.version.outputs.new_version }}\n1038\t          labels: |\n1039\t            org.opencontainers.image.version=${{ steps.version.outputs.new_version }}\n1040\t\n1041\t      - name: Publish Docker image to GHCR\n1042\t        if: |\n1043\t          (steps.version.outputs.version_committed == 'true' ||\n1044\t            steps.version.outputs.already_released == 'true') &&\n1045\t          steps.publish-crate.outputs.publish_result == 'success'\n1046\t        uses: docker/build-push-action@v7\n1047\t        with:\n1048\t          context: .\n1049\t          push: true\n1050\t          tags: ${{ steps.ghcr-meta.outputs.tags }}\n1051\t          labels: ${{ steps.ghcr-meta.outputs.labels }}\n1052\t\n1053\t      - name: Configure Docker Hub publishing\n1054\t        if: |\n1055\t          (steps.version.outputs.version_committed == 'true' ||\n1056\t            steps.version.outputs.already_released == 'true') &&\n1057\t          steps.publish-crate.outputs.publish_result == 'success'\n1058\t        id: dockerhub\n1059\t        run: |\n1060\t          disable_dockerhub() {\n1061\t            echo \"enabled=false\" >> \"$GITHUB_OUTPUT\"\n1062\t            echo \"$1\"\n1063\t          }\n1064\t\n1065\t          if [ -z \"$DOCKERHUB_IMAGE\" ]; then\n1066\t            disable_dockerhub \"Docker Hub publishing disabled: DOCKERHUB_IMAGE repository variable is not set\"\n1067\t            exit 0\n1068\t          fi\n1069\t\n1070\t          if [ ! -f Dockerfile ]; then\n1071\t            disable_dockerhub \"Docker Hub publishing disabled: Dockerfile was not found at repository root\"\n1072\t            exit 0\n1073\t          fi\n1074\t\n1075\t          if [ -z \"$DOCKERHUB_USERNAME\" ] || [ -z \"$DOCKERHUB_TOKEN\" ]; then\n1076\t            echo \"::error::Docker Hub publishing requires DOCKERHUB_USERNAME and DOCKERHUB_TOKEN\"\n1077\t            echo \"Set DOCKERHUB_USERNAME as a repository variable or secret, and DOCKERHUB_TOKEN as a secret.\"\n1078\t            exit 1\n1079\t          fi\n1080\t\n1081\t          echo \"enabled=true\" >> \"$GITHUB_OUTPUT\"\n1082\t          echo \"docker_hub_url=https://hub.docker.com/r/${DOCKERHUB_IMAGE}\" >> \"$GITHUB_OUTPUT\"\n1083\t\n1084\t      - name: Log in to Docker Hub\n1085\t        if: steps.dockerhub.outputs.enabled == 'true'\n1086\t        uses: docker/login-action@v4\n1087\t        with:\n1088\t          username: ${{ env.DOCKERHUB_USERNAME }}\n1089\t          password: ${{ env.DOCKERHUB_TOKEN }}\n1090\t\n1091\t      - name: Extract Docker metadata\n1092\t        if: steps.dockerhub.outputs.enabled == 'true'\n1093\t        id: docker-meta\n1094\t        uses: docker/metadata-action@v6\n1095\t        with:\n1096\t          images: ${{ env.DOCKERHUB_IMAGE }}\n1097\t          tags: |\n1098\t            type=raw,value=latest\n1099\t            type=raw,value=${{ steps.version.outputs.new_version }}\n1100\t          labels: |\n1101\t            org.opencontainers.image.version=${{ steps.version.outputs.new_version }}\n1102\t\n1103\t      - name: Publish Docker image to Docker Hub\n1104\t        if: steps.dockerhub.outputs.enabled == 'true'\n1105\t        uses: docker/build-push-action@v7\n1106\t        with:\n1107\t          context: .\n1108\t          push: true\n1109\t          tags: ${{ steps.docker-meta.outputs.tags }}\n1110\t          labels: ${{ steps.docker-meta.outputs.labels }}\n1111\t\n1112\t      - name: Create GitHub Release\n1113\t        if: |\n1114\t          (steps.version.outputs.version_committed == 'true' ||\n1115\t            steps.version.outputs.already_released == 'true') &&\n1116\t          steps.publish-crate.outputs.publish_result == 'success'\n1117\t        env:\n1118\t          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n1119\t          GHCR_URL: https://github.com/${{ github.repository }}/pkgs/container/formal-ai\n1120\t          DOCKER_HUB_URL: ${{ steps.dockerhub.outputs.docker_hub_url }}\n1121\t        run: |\n1122\t          release_args=(\n1123\t            --release-version \"${{ steps.version.outputs.new_version }}\"\n1124\t            --repository \"${{ github.repository }}\"\n1125\t            --self-hosting-ledger data/meta/self-hosting-ledger.lino\n1126\t          )\n1127\t          release_args+=(--ghcr-url \"$GHCR_URL\")\n1128\t          if [ -n \"$DOCKER_HUB_URL\" ]; then\n1129\t            release_args+=(--docker-hub-url \"$DOCKER_HUB_URL\")\n1130\t          fi\n1131\t          rust-script scripts/create-github-release.rs \"${release_args[@]}\"\n1132\t\n1133\t      - name: Resolve Pages deploy ref\n1134\t        id: release_pages_ref\n1135\t        if: always()\n1136\t        run: |\n1137\t          sha=\"$(git rev-parse HEAD)\"\n1138\t          version=\"$(sed -n 's/^version[[:space:]]*=[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p' Cargo.toml | head -n 1)\"\n1139\t          if [ -z \"$version\" ]; then\n1140\t            echo \"::error file=Cargo.toml::Could not read formal-ai version from Cargo.toml\"\n1141\t            exit 1\n1142\t          fi\n1143\t          echo \"sha=${sha}\" >> \"$GITHUB_OUTPUT\"\n1144\t          echo \"version=${version}\" >> \"$GITHUB_OUTPUT\"\n1145\t          echo \"Pages deploy ref: ${sha} (formal-ai ${version})\"\n1146\t\n1147\t  # === MANUAL CHANGELOG PR ===\n1148\t  changelog-pr:\n1149\t    name: Create Changelog PR\n1150\t    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changelog-pr'\n1151\t    runs-on: ubuntu-latest\n1152\t    timeout-minutes: 10\n1153\t    permissions:\n1154\t      contents: write\n1155\t      pull-requests: write\n1156\t    steps:\n1157\t      - uses: actions/checkout@v6\n1158\t        with:\n1159\t          fetch-depth: 0\n1160\t\n1161\t      - name: Setup Rust\n1162\t        uses: dtolnay/rust-toolchain@stable\n1163\t\n1164\t      - name: Install rust-script\n1165\t        run: bash scripts/install-rust-script.sh\n1166\t\n1167\t      - name: Create changelog fragment\n1168\t        env:\n1169\t          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n1170\t          DESCRIPTION: ${{ github.event.inputs.description }}\n1171\t        run: rust-script scripts/create-changelog-fragment.rs --bump-type \"${{ github.event.inputs.bump_type }}\" --description \"${{ github.event.inputs.description }}\"\n1172\t\n1173\t      - name: Create Pull Request\n1174\t        uses: peter-evans/create-pull-request@v8\n1175\t        with:\n1176\t          token: ${{ secrets.GITHUB_TOKEN }}\n1177\t          commit-message: 'chore: add changelog for manual ${{ github.event.inputs.bump_type }} release'\n1178\t          branch: changelog-manual-release-${{ github.run_id }}\n1179\t          delete-branch: true\n1180\t          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\n1181\t          body: |\n1182\t            ## Manual Release Request\n1183\t\n1184\t            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\n1185\t\n1186\t            ### Release Details\n1187\t            - **Type:** ${{ github.event.inputs.bump_type }}\n1188\t            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\n1189\t            - **Triggered by:** @${{ github.actor }}\n1190\t\n1191\t            ### Next Steps\n1192\t            1. Review the changelog fragment in this PR\n1193\t            2. Merge this PR to main\n1194\t            3. The automated release workflow will publish to crates.io and create a GitHub release\n1195\t\n1196\t  # === E2E TESTS (LOCAL) ===\n1197\t  # Serve src/web with a local HTTP server and run Playwright tests against it.\n1198\t  # Runs on every PR so regressions are caught before merge.\n1199\t  test-e2e-local:\n1200\t    name: E2E Tests (local web app)\n1201\t    runs-on: ubuntu-latest\n1202\t    timeout-minutes: 15\n1203\t    needs: [detect-changes]\n1204\t    if: |\n1205\t      !cancelled() && (\n1206\t        github.event_name == 'push' ||\n1207\t        github.event_name == 'workflow_dispatch' ||\n1208\t        needs.detect-changes.outputs.any-code-changed == 'true'\n1209\t      )\n1210\t    steps:\n1211\t      - uses: actions/checkout@v6\n1212\t\n1213\t      - name: Setup Bun\n1214\t        uses: oven-sh/setup-bun@v2\n1215\t        with:\n1216\t          bun-version-file: .bun-version\n1217\t          # Avoid racing lint/agent E2E for setup-bun's shared executable key.\n1218\t          no-cache: true\n1219\t\n1220\t      - name: Setup Node.js\n1221\t        uses: actions/setup-node@v6\n1222\t        with:\n1223\t          node-version: '24.x'\n1224\t          cache: npm\n1225\t          cache-dependency-path: tests/e2e/package-lock.json\n1226\t\n1227\t      - name: Install web bundle dependencies\n1228\t        run: bun install --frozen-lockfile\n1229\t\n1230\t      - name: Build web vendor bundle\n1231\t        run: bun run build:web\n1232\t\n1233\t      - name: Install Playwright and dependencies\n1234\t        run: |\n1235\t          cd tests/e2e\n1236\t          npm ci\n1237\t\n1238\t      - name: Install Playwright browsers\n1239\t        run: |\n1240\t          cd tests/e2e\n1241\t          npx playwright install --with-deps chromium\n1242\t\n1243\t      - name: Sync data/seed into src/web/seed (deployment mirror)\n1244\t        run: scripts/sync-seed.sh\n1245\t\n1246\t      - name: Run local e2e tests\n1247\t        run: |\n1248\t          cd tests/e2e\n1249\t          npx playwright test --config=playwright.local.config.js\n1250\t\n1251\t      - name: Upload Playwright report on failure\n1252\t        if: failure()\n1253\t        uses: actions/upload-artifact@v7\n1254\t        with:\n1255\t          name: playwright-report-local\n1256\t          path: tests/e2e/playwright-report/\n1257\t          retention-days: 7\n1258\t\n1259\t      # The issue-347 spec regenerates the /download preview images and full-page\n1260\t      # captures on every run (proving the screenshots can be produced in CI).\n1261\t      # Publish them as an artifact so reviewers can compare against the committed\n1262\t      # baselines without running the suite locally.\n1263\t      - name: Upload generated /download screenshots\n1264\t        if: always()\n1265\t        uses: actions/upload-artifact@v7\n1266\t        with:\n1267\t          name: download-page-screenshots\n1268\t          path: |\n1269\t            docs/screenshots/issue-347/\n1270\t            src/web/download/assets/app-preview*.png\n1271\t          retention-days: 14\n1272\t\n1273\t  # === E2E: Agent CLI ↔ formal-ai OpenAI-compatible server ===\n1274\t  # Boot `formal-ai serve`, drive it with the real `@link-assistant/agent` CLI\n1275\t  # (talking over its OpenAI-compatible endpoint) and prove the CLI writes the\n1276\t  # requested Links Notation file end-to-end. This is the maintainer's\n1277\t  # requirement for issue #538: no hardcoded meaning answers, no deferral —\n1278\t  # the real toolchain must produce the enriched meaning on every commit.\n1279\t  test-agent-cli-e2e:\n1280\t    name: E2E Tests (agent CLI ↔ formal-ai)\n1281\t    runs-on: ubuntu-latest\n1282\t    timeout-minutes: 20\n1283\t    needs: [detect-changes]\n1284\t    if: |\n1285\t      !cancelled() && (\n1286\t        github.event_name == 'push' ||\n1287\t        github.event_name == 'workflow_dispatch' ||\n1288\t        needs.detect-changes.outputs.any-code-changed == 'true' ||\n1289\t        needs.detect-changes.outputs.rs-changed == 'true' ||\n1290\t        needs.detect-changes.outputs.toml-changed == 'true' ||\n1291\t        needs.detect-changes.outputs.workflow-changed == 'true'\n1292\t      )\n1293\t    steps:\n1294\t      - uses: actions/checkout@v6\n1295\t\n1296\t      - name: Setup Rust\n1297\t        uses: dtolnay/rust-toolchain@stable\n1298\t\n1299\t      - name: Cache cargo registry\n1300\t        uses: actions/cache@v5\n1301\t        with:\n1302\t          path: |\n1303\t            ~/.cargo/registry\n1304\t            ~/.cargo/git\n1305\t            target\n1306\t          key: ${{ runner.os }}-cargo-agentcli-e2e-${{ hashFiles('**/Cargo.lock') }}\n1307\t          restore-keys: |\n1308\t            ${{ runner.os }}-cargo-agentcli-e2e-\n1309\t            ${{ runner.os }}-cargo-\n1310\t\n1311\t      - name: Setup Bun\n1312\t        uses: oven-sh/setup-bun@v2\n1313\t        with:\n1314\t          bun-version-file: .bun-version\n1315\t          # Avoid racing lint/local E2E for setup-bun's shared executable key.\n1316\t          no-cache: true\n1317\t\n1318\t      - name: Install @link-assistant/agent CLI\n1319\t        # The E2E script talks to formal-ai through the same CLI users install\n1320\t        # locally. `bun add -g` puts the `agent` binary on PATH under\n1321\t        # ~/.bun/bin — the script's default AGENT=\"agent\" picks it up.\n1322\t        run: |\n1323\t          bun add -g @link-assistant/agent\n1324\t          echo \"$HOME/.bun/bin\" >> $GITHUB_PATH\n1325\t\n1326\t      - name: Install external agent CLIs\n1327\t        # OpenCode provides the second issue-715 learning harness. Issue #781\n1328\t        # additionally proves the same research loop through Claude Code's\n1329\t        # Anthropic transport and Codex's Responses transport, so all clients\n1330\t        # are mandatory and their E2E scripts fail rather than skip if missing.\n1331\t        run: bun add -g opencode-ai @anthropic-ai/claude-code @openai/codex\n1332\t\n1333\t      - name: Build formal-ai (release)\n1334\t        # The E2E script runs against target/release/formal-ai — that's the\n1335\t        # binary users invoke as `formal-ai serve`. Release mode also matches\n1336\t        # the local-dev instructions in the case study.\n1337\t        run: cargo build --release --bin formal-ai\n1338\t\n1339\t      # Each recipe axis of issue #538 is driven live through the real Agent CLI\n1340\t      # against the real formal-ai server — no in-repo simulation. Every step\n1341\t      # boots the server, drives the CLI with a *differently worded* request, and\n1342\t      # asserts the CLI exits 0, wrote the expected file, the file carries the\n1343\t      # requirement's canary string, and the loop walked ≥MIN_POSTS chat rounds.\n1344\t      # Running all three (two meaning concepts + one non-lexeme diagram axis)\n1345\t      # proves the recipe generalises live, not just for the tomato answer.\n1346\t      - name: Run agent CLI E2E — tomato meaning (search → fetch → write → verify)\n1347\t        # Distinct port per step to avoid collisions if a runner is shared.\n1348\t        # Canary: the Russian plural `томаты`, previously missing from `томат`.\n1349\t        env:\n1350\t          PORT: 8768\n1351\t          EXPECT_FILE: meanings-tomato-detail.lino\n1352\t          EXPECT_TEXT: томаты\n1353\t        run: experiments/agent_cli_e2e/run_agent_cli.sh\n1354\t\n1355\t      - name: Run agent CLI E2E — potato meaning (different wording, same recipe)\n1356\t        # A differently-worded request routed to a different concept proves the\n1357\t        # recipe is general, not pattern-matched to the tomato phrasing.\n1358\t        env:\n1359\t          PORT: 8769\n1360\t          TASK: \"Please make the potato word and meaning richer — record the singular/plural of each surface, add the missing plural form potatoes, and keep it grounded in Wikidata.\"\n1361\t          EXPECT_FILE: meanings-potato-detail.lino\n1362\t          EXPECT_TEXT: potatoes\n1363\t        run: experiments/agent_cli_e2e/run_agent_cli.sh\n1364\t\n1365\t      - name: Run agent CLI E2E — generated diagrams (non-lexeme axis, no web step)\n1366\t        # A no-web recipe (write → verify → final = 3 rounds) driven by the same\n1367\t        # CLI, proving the loop generalises beyond the meaning-detail axis.\n1368\t        env:\n1369\t          PORT: 8770\n1370\t          TASK: \"Generate the mermaid diagrams of our agentic recipes, split into parts, as a visual overview of how Formal AI drives its own tools.\"\n1371\t          EXPECT_FILE: agentic-recipes.md\n1372\t          EXPECT_TEXT: flowchart\n1373\t          MIN_POSTS: 3\n1374\t        run: experiments/agent_cli_e2e/run_agent_cli.sh\n1375\t\n1376\t      - name: Run agent CLI E2E — self-inspection CST/AST census (no web step)\n1377\t        # A self-referential no-web recipe (write → verify → final = 3 rounds): the\n1378\t        # server parses a real module of its own meta algorithm through the\n1379\t        # meta-language links network and writes the abstract-syntax node census,\n1380\t        # proving the loop can reason about itself over the live Agent CLI.\n1381\t        env:\n1382\t          PORT: 8771\n1383\t          TASK: \"Store the CST/AST of our Rust meta algorithm in our data so the system can reason about itself: parse the planner module and record its abstract-syntax node census in Links Notation.\"\n1384\t          EXPECT_FILE: self-ast.lino\n1385\t          EXPECT_TEXT: named_node_count\n1386\t          MIN_POSTS: 3\n1387\t        run: experiments/agent_cli_e2e/run_agent_cli.sh\n1388\t\n1389\t      - name: \"Run agent CLI E2E — learn-from-source directive (issue #499, no web step)\"\n1390\t        # The user directive from issue #499 — \"here you can learn the trending\n1391\t        # topics from Google Trends\" — is itself the task. It routes through the\n1392\t        # seed learning_sources registry into the same write → verify → final\n1393\t        # learning recipe, proving one teaching directive drives the Agent CLI,\n1394\t        # not just a chat reply. Canary: the human-gated marker in the report.\n1395\t        env:\n1396\t          PORT: 8772\n1397\t          TASK: \"Here you can learn the trending topics from Google Trends: https://trends.google.com/trending/rss?geo=US\"\n1398\t          EXPECT_FILE: google-trends-learning.lino"
