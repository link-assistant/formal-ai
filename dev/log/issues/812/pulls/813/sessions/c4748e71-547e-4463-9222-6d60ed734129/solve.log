[2026-07-20T17:14:41.078Z] [INFO] {
[2026-07-20T17:14:41.078Z] [INFO]   "type": "user",
[2026-07-20T17:14:41.078Z] [INFO]   "message": {
[2026-07-20T17:14:41.078Z] [INFO]     "role": "user",
[2026-07-20T17:14:41.078Z] [INFO]     "content": [
[2026-07-20T17:14:41.078Z] [INFO]       {
[2026-07-20T17:14:41.078Z] [INFO]         "tool_use_id": "toolu_01YZPAJYLGcPHsL6EDWHzmV6",
[2026-07-20T17:14:41.078Z] [INFO]         "type": "tool_result",
[2026-07-20T17:14:41.078Z] [INFO]         "content": "1\tname: CI/CD Pipeline\n2\t\n3\ton:\n4\t  push:\n5\t    branches:\n6\t      - main\n7\t  pull_request:\n8\t    types: [opened, synchronize, reopened]\n9\t  workflow_dispatch:\n10\t    inputs:\n11\t      release_mode:\n12\t        description: 'Manual release mode'\n13\t        required: true\n14\t        type: choice\n15\t        default: 'instant'\n16\t        options:\n17\t          - instant\n18\t          - changelog-pr\n19\t      bump_type:\n20\t        description: 'Version bump type'\n21\t        required: true\n22\t        type: choice\n23\t        options:\n24\t          - patch\n25\t          - minor\n26\t          - major\n27\t      description:\n28\t        description: 'Release description (optional)'\n29\t        required: false\n30\t        type: string\n31\t\n32\tpermissions:\n33\t  contents: read\n34\t\n35\tconcurrency:\n36\t  group: ${{ github.workflow }}-${{ github.ref }}\n37\t  # Cancel superseded runs on PR branches to save CI minutes, but never cancel a\n38\t  # run on main: that branch drives the release pipeline (crates.io publish, tag\n39\t  # creation, desktop builds, Pages deploy), and cancelling it mid-flight can\n40\t  # leave a release half-published. desktop-release.yml uses cancel-in-progress:\n41\t  # false for the same reason (issue #479).\n42\t  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n43\t\n44\tenv:\n45\t  GIT_CONFIG_COUNT: '1'\n46\t  GIT_CONFIG_KEY_0: init.defaultBranch\n47\t  GIT_CONFIG_VALUE_0: main\n48\t  CARGO_NET_RETRY: '10'\n49\t  CARGO_HTTP_MULTIPLEXING: 'false'\n50\t  CARGO_TERM_COLOR: always\n51\t  RUSTFLAGS: -Dwarnings\n52\t  # Support both CARGO_REGISTRY_TOKEN (cargo's native env var) and CARGO_TOKEN (for backwards compatibility)\n53\t  CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n54\t  CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n55\t  # Default prepared Docker image published by releases for single-line bot startup.\n56\t  GHCR_IMAGE: ghcr.io/${{ github.repository }}\n57\t  # Optional: set repository variable DOCKERHUB_IMAGE to namespace/image to publish Docker Hub releases.\n58\t  DOCKERHUB_IMAGE: ${{ vars.DOCKERHUB_IMAGE }}\n59\t\n60\tjobs:\n61\t  # === DETECT CHANGES - determines which jobs should run ===\n62\t  detect-changes:\n63\t    name: Detect Changes\n64\t    runs-on: ubuntu-latest\n65\t    timeout-minutes: 5\n66\t    if: github.event_name != 'workflow_dispatch'\n67\t    outputs:\n68\t      rs-changed: ${{ steps.changes.outputs.rs-changed }}\n69\t      toml-changed: ${{ steps.changes.outputs.toml-changed }}\n70\t      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n71\t      workflow-changed: ${{ steps.changes.outputs.workflow-changed }}\n72\t      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n73\t    steps:\n74\t      - uses: actions/checkout@v6\n75\t        with:\n76\t          fetch-depth: 0\n77\t\n78\t      - name: Setup Rust\n79\t        uses: dtolnay/rust-toolchain@stable\n80\t\n81\t      - name: Install rust-script\n82\t        run: bash scripts/install-rust-script.sh\n83\t\n84\t      - name: Detect changes\n85\t        id: changes\n86\t        env:\n87\t          GITHUB_EVENT_NAME: ${{ github.event_name }}\n88\t          GITHUB_EVENT_BEFORE: ${{ github.event.before }}\n89\t        run: rust-script scripts/detect-code-changes.rs\n90\t\n91\t  # === CHANGELOG CHECK - only runs on PRs with code changes ===\n92\t  # Docs-only PRs (./docs folder, markdown files) don't require changelog fragments\n93\t  changelog:\n94\t    name: Changelog Fragment Check\n95\t    runs-on: ubuntu-latest\n96\t    timeout-minutes: 10\n97\t    needs: [detect-changes]\n98\t    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n99\t    steps:\n100\t      - uses: actions/checkout@v6\n101\t        with:\n102\t          fetch-depth: 0\n103\t\n104\t      - name: Setup Rust\n105\t        uses: dtolnay/rust-toolchain@stable\n106\t\n107\t      - name: Install rust-script\n108\t        run: bash scripts/install-rust-script.sh\n109\t\n110\t      - name: Check for changelog fragments\n111\t        env:\n112\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n113\t        run: rust-script scripts/check-changelog-fragment.rs\n114\t\n115\t  # === SELF-HOSTING EVIDENCE CHECK ===\n116\t  # Issue #808: run 29723467001 failed the whole Auto Release job with\n117\t  # \"no committed Formal-AI-Evidence in 10e65ae2 records session\n118\t  # issue-804-claude-20260720\". The invariant (CONTRIBUTING.md: every commit\n119\t  # carrying Formal-AI-Session must also carry a Formal-AI-Evidence file that\n120\t  # contains \"formal-ai\" and the exact session id) was only ever enforced at\n121\t  # release time, on main, after merge -- where nothing can be fixed without a\n122\t  # new PR. This job runs the *same* code path over the PR's own commits so a\n123\t  # violating commit is rejected before it can break a release.\n124\t  evidence-check:\n125\t    name: Self-Hosting Evidence Check\n126\t    runs-on: ubuntu-latest\n127\t    timeout-minutes: 10\n128\t    if: github.event_name == 'pull_request'\n129\t    steps:\n130\t      - uses: actions/checkout@v6\n131\t        with:\n132\t          fetch-depth: 0\n133\t\n134\t      - name: Setup Rust\n135\t        uses: dtolnay/rust-toolchain@stable\n136\t\n137\t      - name: Install rust-script\n138\t        run: bash scripts/install-rust-script.sh\n139\t\n140\t      - name: Validate Formal-AI trailers on this pull request\n141\t        env:\n142\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n143\t        run: |\n144\t          set -euo pipefail\n145\t          base=\"origin/${GITHUB_BASE_REF}\"\n146\t          merge_base=\"$(git merge-base \"$base\" HEAD)\"\n147\t          echo \"Validating commits in ${merge_base}..HEAD\"\n148\t          rust-script scripts/self-hosting-metric.rs --since \"$merge_base\" --until HEAD\n149\t\n150\t  # === DOCKER IMAGE CHECK ===\n151\t  # Issue #808: the Dockerfile was only ever built inside `auto-release` /\n152\t  # `manual-release`, i.e. after the crate had already been published to\n153\t  # crates.io. A broken Dockerfile therefore produced a half-finished release\n154\t  # (crate published, no image, no GitHub Release) and could not be caught\n155\t  # before merge. scripts/verify-docker-runtime.sh, which the image installs as\n156\t  # `verify-formal-ai-dind`, had no caller in CI at all. This job builds the\n157\t  # image without pushing and runs that verifier inside it, so both the build\n158\t  # and the runtime contract gate the pull request.\n159\t  docker-build:\n160\t    name: Docker Image Build & Runtime Check\n161\t    runs-on: ubuntu-latest\n162\t    # The image compiles the crate in a builder stage; 30 minutes is not enough\n163\t    # on a cold layer cache.\n164\t    timeout-minutes: 60\n165\t    needs: [detect-changes]\n166\t    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n167\t    steps:\n168\t      - uses: actions/checkout@v6\n169\t\n170\t      # Same \"No space left on device\" class of failure the release job guards\n171\t      # against (issue #523): a full release build inside the image on top of a\n172\t      # multi-GB DinD base image does not fit on a stock runner.\n173\t      - name: Free up runner disk space\n174\t        run: bash scripts/free-runner-disk.sh\n175\t\n176\t      - name: Set up Docker Buildx\n177\t        uses: ./.github/actions/setup-buildx-resilient\n178\t\n179\t      # load: true (not push) so the image stays local and the check works\n180\t      # unchanged for pull requests from forks, which have no registry\n181\t      # credentials. The GHA layer cache keeps the common case off a cold build.\n182\t      - name: Build image\n183\t        uses: docker/build-push-action@v7\n184\t        with:\n185\t          context: .\n186\t          push: false\n187\t          load: true\n188\t          tags: formal-ai:pr-check\n189\t          cache-from: type=gha\n190\t          cache-to: type=gha,mode=max\n191\t\n192\t      # --privileged is required: verify-docker-runtime.sh asserts that the\n193\t      # inner Docker daemon started by the DinD entrypoint is reachable, which\n194\t      # is the whole point of the dind image variant.\n195\t      - name: Verify image runtime contract\n196\t        run: |\n197\t          set -euo pipefail\n198\t          docker run --rm --privileged formal-ai:pr-check verify-formal-ai-dind\n199\t\n200\t  # === SECRETS SCAN ===\n201\t  # Issue #808 / R5 (CI-CD-BEST-PRACTICES.md section 11): no secrets scan\n202\t  # existed anywhere in this pipeline. secretlint is language-agnostic, so it\n203\t  # applies to a Rust repository unchanged; .secretlintrc.json selects the\n204\t  # recommended preset.\n205\t  #\n206\t  # Scoped to the files the change touches, not the whole tree: measured, a\n207\t  # full-tree `secretlint \"**/*\"` (what the js template runs) had not finished\n208\t  # after 25 minutes on this repository, because the glob walks `target/` and\n209\t  # ~150 MB of committed case-study logs. A gate that may not finish is itself a\n210\t  # new CI failure mode. Scanning the diff catches a credential being\n211\t  # *introduced*, which is the case that matters, and takes ~3 seconds; run\n212\t  # `bash scripts/check-secrets.sh --all` locally to audit everything.\n213\t  secrets-scan:\n214\t    name: Secrets Scan\n215\t    runs-on: ubuntu-latest\n216\t    timeout-minutes: 10\n217\t    needs: [detect-changes]\n218\t    if: |\n219\t      !cancelled() && (\n220\t        github.event_name == 'push' ||\n221\t        github.event_name == 'workflow_dispatch' ||\n222\t        needs.detect-changes.outputs.any-code-changed == 'true' ||\n223\t        needs.detect-changes.outputs.docs-changed == 'true' ||\n224\t        needs.detect-changes.outputs.workflow-changed == 'true'\n225\t      )\n226\t    steps:\n227\t      - uses: actions/checkout@v6\n228\t        with:\n229\t          # check-secrets.sh diffs against the base branch / previous commit.\n230\t          fetch-depth: 0\n231\t\n232\t      - name: Setup Node\n233\t        uses: actions/setup-node@v6\n234\t        with:\n235\t          node-version: 22\n236\t\n237\t      - name: Check for secrets\n238\t        env:\n239\t          # pull_request -> base branch; push -> the pre-push SHA;\n240\t          # workflow_dispatch has neither, so scan the tip commit.\n241\t          BASE_REF: ${{ github.base_ref || github.event.before || 'HEAD~1' }}\n242\t        run: bash scripts/check-secrets.sh\n243\t\n244\t  # === VERSION CHECK - prevents manual version modification in PRs ===\n245\t  # This ensures versions are only modified by the automated release pipeline\n246\t  version-check:\n247\t    name: Version Modification Check\n248\t    runs-on: ubuntu-latest\n249\t    timeout-minutes: 5\n250\t    if: github.event_name == 'pull_request'\n251\t    steps:\n252\t      - uses: actions/checkout@v6\n253\t        with:\n254\t          fetch-depth: 0\n255\t\n256\t      - name: Setup Rust\n257\t        uses: dtolnay/rust-toolchain@stable\n258\t\n259\t      - name: Install rust-script\n260\t        run: bash scripts/install-rust-script.sh\n261\t\n262\t      - name: Check for manual version changes\n263\t        env:\n264\t          GITHUB_EVENT_NAME: ${{ github.event_name }}\n265\t          GITHUB_HEAD_REF: ${{ github.head_ref }}\n266\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n267\t        run: rust-script scripts/check-version-modification.rs\n268\t\n269\t  # === LINT AND FORMAT CHECK ===\n270\t  # Lint runs independently of changelog check - it's a fast check that should always run\n271\t  # See: https://github.com/link-assistant/hive-mind/pull/1024 for why this dependency was removed\n272\t  lint:\n273\t    name: Lint and Format Check\n274\t    runs-on: ubuntu-latest\n275\t    timeout-minutes: 10\n276\t    needs: [detect-changes]\n277\t    # Note: a status-check function is required because detect-changes is skipped\n278\t    # on workflow_dispatch; without one the skipped dependency would cascade and\n279\t    # skip this job even though its condition covers workflow_dispatch.\n280\t    # See: https://github.com/actions/runner/issues/491\n281\t    if: |\n282\t      !cancelled() && (\n283\t        github.event_name == 'push' ||\n284\t        github.event_name == 'workflow_dispatch' ||\n285\t        needs.detect-changes.outputs.any-code-changed == 'true' ||\n286\t        needs.detect-changes.outputs.rs-changed == 'true' ||\n287\t        needs.detect-changes.outputs.toml-changed == 'true' ||\n288\t        needs.detect-changes.outputs.docs-changed == 'true' ||\n289\t        needs.detect-changes.outputs.workflow-changed == 'true'\n290\t      )\n291\t    steps:\n292\t      - uses: actions/checkout@v6\n293\t        with:\n294\t          fetch-depth: 0\n295\t\n296\t      # Issue #808 / R3: GitHub checks out refs/pull/N/merge, a merge preview\n297\t      # computed at the last sync -- commits pushed to the base branch since\n298\t      # then are NOT in it, so a pull request can be green against a base that\n299\t      # no longer exists. Adopted from the js template, which is the only one of\n300\t      # the three that ships this.\n301\t      - name: Simulate fresh merge with base branch (PR only)\n302\t        if: github.event_name == 'pull_request'\n303\t        env:\n304\t          BASE_REF: ${{ github.base_ref }}\n305\t        run: bash scripts/simulate-fresh-merge.sh\n306\t\n307\t      - name: Setup Rust\n308\t        uses: dtolnay/rust-toolchain@stable\n309\t        with:\n310\t          components: rustfmt, clippy\n311\t          targets: wasm32-unknown-unknown\n312\t\n313\t      - name: Setup Bun\n314\t        uses: oven-sh/setup-bun@v2\n315\t        with:\n316\t          bun-version-file: .bun-version\n317\t\n318\t      - name: Install rust-script\n319\t        run: bash scripts/install-rust-script.sh\n320\t\n321\t      - name: Cache cargo registry\n322\t        uses: actions/cache@v5\n323\t        with:\n324\t          path: |\n325\t            ~/.cargo/registry\n326\t            ~/.cargo/git\n327\t            target\n328\t          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}\n329\t          restore-keys: |\n330\t            ${{ runner.os }}-cargo-\n331\t\n332\t      - name: Check formatting\n333\t        run: cargo fmt --all -- --check\n334\t\n335\t      - name: Verify Cargo.lock is synchronized\n336\t        run: cargo metadata --locked --format-version 1 > /dev/null\n337\t\n338\t      - name: Run Clippy\n339\t        run: cargo clippy --all-targets --all-features\n340\t\n341\t      # rustdoc-only lints are not exercised by rustc, clippy, or doctests.\n342\t      # Build the same public API docs deployed by Pages before release so a\n343\t      # broken link cannot first surface after packages have been published.\n344\t      - name: Validate Rust API documentation\n345\t        env:\n346\t          RUSTDOCFLAGS: -D warnings\n347\t        run: cargo doc --no-deps --lib\n348\t\n349\t      # docs.rs builds with DOCS_RS set. Its transitive lindera-jieba build\n350\t      # script is currently broken in that mode (lindera/lindera#750), so the\n351\t      # published docs profile deliberately omits the optional meta-language\n352\t      # runtime while normal/default builds retain it. Exercise that exact\n353\t      # profile before a crate can be released.\n354\t      - name: Validate docs.rs dependency profile\n355\t        env:\n356\t          DOCS_RS: 1\n357\t          RUSTDOCFLAGS: -D warnings\n358\t        run: cargo doc --no-deps --lib --no-default-features\n359\t\n360\t      - name: Check semantic grounding\n361\t        run: cargo test --test unit semantic_grounding -- --nocapture\n362\t\n363\t      - name: Check file size limit\n364\t        env:\n365\t          FILE_SIZE_WARNING_BASE: ${{ github.event.pull_request.base.sha || github.event.before }}\n366\t        run: rust-script scripts/check-file-size.rs\n367\t\n368\t      - name: Check associative terminology\n369\t        run: rust-script scripts/check-associative-terminology.rs\n370\t\n371\t      # Issue #659 (R379): fail the build when src/ gains user-facing prose\n372\t      # string literals instead of sourcing them from data/seed/*.lino. The\n373\t      # committed allowlist (scripts/hardcoded-language-allowlist.txt) inventories\n374\t      # today's debt; new literals are blocked and migrated-away rows must be\n375\t      # pruned, so the debt only shrinks. See\n376\t      # docs/design/no-hardcoded-natural-language.md.\n377\t      - name: Check hardcoded natural language\n378\t        run: rust-script scripts/check-hardcoded-language.rs\n379\t\n380\t      - name: Check worker JS line budget\n381\t        run: rust-script scripts/check-worker-line-budget.rs\n382\t\n383\t      - name: Build Rust→WASM worker\n384\t        run: sh src/web/wasm-worker/build.sh\n385\t\n386\t      - name: Check wasm-worker size budget\n387\t        run: rust-script scripts/check-wasm-worker-size.rs\n388\t\n389\t      - name: Test release changelog collection\n390\t        run: rust-script --test scripts/version-and-commit.rs\n391\t\n392\t      - name: Test fragment release map regeneration\n393\t        run: node --test experiments/issue_738_fragment_release_map.test.mjs\n394\t\n395\t      - name: Check reconstructed changelog\n396\t        run: node experiments/issue_711_rebuild_changelog.mjs --check\n397\t\n398\t      - name: Install web bundle dependencies\n399\t        run: bun install --frozen-lockfile\n400\t\n401\t      - name: Build web vendor bundle\n402\t        run: bun run build:web\n403\t\n404\t      - name: Check web bundles are current\n405\t        run: git diff --exit-code -- src/web/vendor.bundle.js src/web/ocr.bundle.js src/web/app.js\n406\t\n407\t      - name: Setup Node\n408\t        uses: actions/setup-node@v6\n409\t        with:\n410\t          node-version: 22\n411\t          cache: npm\n412\t          cache-dependency-path: tests/e2e/package-lock.json\n413\t\n414\t      - name: Install web test dependencies\n415\t        run: npm ci --prefix tests/e2e\n416\t\n417\t      - name: Check i18n catalog coverage\n418\t        run: npm run --prefix tests/e2e check:i18n\n419\t\n420\t      - name: Check language change parity\n421\t        env:\n422\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n423\t        run: npm run --prefix tests/e2e check:language-parity\n424\t\n425\t      - name: Check language test coverage\n426\t        env:\n427\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n428\t        run: npm run --prefix tests/e2e check:language-test-coverage\n429\t\n430\t      - name: Check multilingual intent coverage\n431\t        run: npm run --prefix tests/e2e check:intent-coverage\n432\t\n433\t      - name: Check web app for hook TDZ ordering bugs\n434\t        run: npm run --prefix tests/e2e check:web-tdz\n435\t\n436\t      # Issue #511/#514: fail the build if src/web/app.js renders hardcoded\n437\t      # user-facing prose instead of routing it through the i18n catalog (t()).\n438\t      # This stops the per-tool permission / Services regression class from\n439\t      # silently re-appearing.\n440\t      - name: Check web app for hardcoded user-facing strings\n441\t        run: npm run --prefix tests/e2e check:web-hardcoded-ui\n442\t\n443\t      # The terminal-command trigger vocabulary lives in\n444\t      # data/seed/terminal-commands.lino; the JS worker loads the generated\n445\t      # src/web/seed deployment mirror through seed_loader.js. This fails on\n446\t      # worker wiring regressions or stale present mirrors, so the worker can\n447\t      # never silently re-hardcode trigger phrases that have moved into seed data.\n448\t      - name: Check terminal vocabulary worker seed wiring\n449\t        run: node experiments/issue-513-sync-worker-terminal.mjs --check\n450\t"
