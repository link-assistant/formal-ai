[2026-07-20T17:17:31.204Z] [INFO]       {
[2026-07-20T17:17:31.204Z] [INFO]         "tool_use_id": "toolu_01QGdFTvrb3cQe55KSUWJqo6",
[2026-07-20T17:17:31.204Z] [INFO]         "type": "tool_result",
[2026-07-20T17:17:31.204Z] [INFO]         "content": "--- check-secrets.sh: 27:set -euo pipefail \n--- desktop-release-resolve.sh: 52:set -euo pipefail \n--- free-runner-disk.sh: 16:set -euo pipefail \n--- install.sh: 30:set -eu \n--- reproduce-issue-538.sh: 26:set -euo pipefail \n--- simulate-fresh-merge.sh: 21:set -euo pipefail \n--- sync-seed.sh: 14:set -euo pipefail \n\n=== sync-seed.sh ===\n     1\t#!/usr/bin/env bash\n     2\t# Synchronise the canonical Links Notation seed (`data/seed/*.lino`) into the\n     3\t# static web demo (`src/web/seed/`). The web copy is a deploy artefact: the\n     4\t# canonical source of truth is `data/seed/`, shared by the Rust solver, CLI,\n     5\t# Telegram bot, HTTP server, and the browser worker.\n     6\t#\n     7\t# Run this script before serving the demo locally and as part of CI before the\n     8\t# GitHub Pages artefact is uploaded.\n     9\t#\n    10\t# Usage:\n    11\t#   scripts/sync-seed.sh         # copy data/seed/*.lino → src/web/seed/\n    12\t#   scripts/sync-seed.sh --check # exit 1 if the two trees diverge\n    13\t\n    14\tset -euo pipefail\n    15\t\n    16\tROOT_DIR=$(cd \"$(dirname \"$0\")/..\" && pwd)\n    17\tSRC_DIR=\"$ROOT_DIR/data/seed\"\n    18\tDEST_DIR=\"$ROOT_DIR/src/web/seed\"\n    19\t\n    20\tmode=\"copy\"\n    21\tif [[ \"${1-}\" == \"--check\" ]]; then\n    22\t  mode=\"check\"\n    23\tfi\n    24\t\n    25\tif [[ ! -d \"$SRC_DIR\" ]]; then\n    26\t  echo \"sync-seed: source directory not found: $SRC_DIR\" >&2\n    27\t  exit 1\n    28\tfi\n    29\t\n    30\tmkdir -p \"$DEST_DIR\"\n    31\t\n    32\tshopt -s nullglob\n    33\tsources=(\"$SRC_DIR\"/*.lino)\n    34\tshopt -u nullglob\n    35\t\n    36\tif [[ ${#sources[@]} -eq 0 ]]; then\n    37\t  echo \"sync-seed: no .lino files found in $SRC_DIR\" >&2\n    38\t  exit 1\n    39\tfi\n    40\t\n    41\tstatus=0\n    42\t\n    43\tfor src in \"${sources[@]}\"; do\n    44\t  name=$(basename \"$src\")\n    45\t  dest=\"$DEST_DIR/$name\"\n    46\t  if [[ \"$mode\" == \"check\" ]]; then\n    47\t    if [[ ! -f \"$dest\" ]] || ! cmp -s \"$src\" \"$dest\"; then\n    48\t      echo \"sync-seed: out of sync — $name\" >&2\n    49\t      status=1\n    50\t    fi\n    51\t  else\n    52\t    cp \"$src\" \"$dest\"\n    53\t    echo \"sync-seed: $name\"\n    54\t  fi\n    55\tdone\n    56\t\n    57\tif [[ \"$mode\" == \"check\" ]]; then\n    58\t  # Detect orphan files in the destination that no longer exist in source.\n    59\t  shopt -s nullglob\n    60\t  dests=(\"$DEST_DIR\"/*.lino)\n    61\t  shopt -u nullglob\n    62\t  for dst in \"${dests[@]}\"; do\n    63\t    name=$(basename \"$dst\")\n    64\t    if [[ ! -f \"$SRC_DIR/$name\" ]]; then\n    65\t      echo \"sync-seed: orphan in destination — $name\" >&2\n    66\t      status=1\n    67\t    fi\n    68\t  done\n    69\tfi\n    70\t\n    71\texit \"$status\"\n=== free-runner-disk.sh ===\n     1\t#!/usr/bin/env bash\n     2\t#\n     3\t# Reclaim disk on a hosted GitHub runner before a heavy build.\n     4\t#\n     5\t# The hosted ubuntu image ships with ~14 GB free on `/`, and pre-installed SDKs\n     6\t# we never touch (dotnet, Android, GHC, CodeQL) eat most of it. Jobs that build\n     7\t# the crate and then build the Docker image (which compiles the crate a second\n     8\t# time inside a large base image) exhaust `/` and take the whole runner down\n     9\t# with \"No space left on device\" — the runner cannot even flush its own diag\n    10\t# log, so the job dies with no failed step and no log to download.\n    11\t#\n    12\t# Seen in issue #523 (Pages job) and again in issue #736 (release jobs, runs\n    13\t# 29312084458 and 29485000765).\n    14\t#\n    15\t# Set RUNNER_DISK_DEBUG=1 for a per-directory breakdown of what was reclaimed.\n    16\tset -euo pipefail\n    17\t\n    18\t# Paths worth reclaiming, largest first. Each is optional: the runner image\n    19\t# changes over time and a missing path is not an error.\n    20\tDISPOSABLE_PATHS=(\n    21\t  /usr/share/dotnet\n    22\t  /usr/local/lib/android\n    23\t  /opt/ghc\n    24\t  /opt/hostedtoolcache/CodeQL\n    25\t)\n    26\t\n    27\tavail_kb() {\n    28\t  df --output=avail / | tail -n 1 | tr -d ' '\n    29\t}\n    30\t\n    31\tbefore_kb=\"$(avail_kb)\"\n    32\techo \"Disk usage before cleanup:\"\n    33\tdf -h /\n    34\t\n    35\tfor path in \"${DISPOSABLE_PATHS[@]}\"; do\n    36\t  if [ ! -e \"$path\" ]; then\n    37\t    echo \"  skip   ${path} (not present)\"\n    38\t    continue\n    39\t  fi\n    40\t  if [ \"${RUNNER_DISK_DEBUG:-0}\" = \"1\" ]; then\n    41\t    echo \"  remove ${path} ($(sudo du -sh \"$path\" 2>/dev/null | cut -f1 || echo '?'))\"\n    42\t  else\n    43\t    echo \"  remove ${path}\"\n    44\t  fi\n    45\t  # Best-effort: a path we cannot remove is not worth failing the release over.\n    46\t  sudo rm -rf \"$path\" || echo \"  WARNING: could not remove ${path}\"\n    47\tdone\n    48\t\n    49\techo \"  prune  dangling and unused docker images\"\n    50\tsudo docker image prune --all --force >/dev/null 2>&1 || true\n    51\t\n    52\tafter_kb=\"$(avail_kb)\"\n    53\techo \"Disk usage after cleanup:\"\n    54\tdf -h /\n    55\techo \"Reclaimed $(( (after_kb - before_kb) / 1024 )) MiB; $(( after_kb / 1024 )) MiB now available on /\"\n    56\t\n    57\t# Surface the \"we are still nearly full\" case loudly. This is a warning rather\n    58\t# than a failure: the build may still fit, and a hard threshold here would be a\n    59\t# guess. If a job dies with no logs, check for this annotation first.\n    60\tmin_mib=\"${RUNNER_DISK_MIN_MIB:-6144}\"\n    61\tif [ \"$(( after_kb / 1024 ))\" -lt \"$min_mib\" ]; then\n    62\t  echo \"::warning title=Low runner disk::Only $(( after_kb / 1024 )) MiB free on / after cleanup (want >= ${min_mib} MiB). A heavy Docker build may crash the runner with 'No space left on device'.\"\n    63\tfi",
[2026-07-20T17:17:31.204Z] [INFO]         "is_error": false
