[2026-07-20T19:01:56.583Z] [INFO]         "content": "1\tdiff --git a/.github/actionlint.yaml b/.github/actionlint.yaml\n2\tnew file mode 100644\n3\tindex 00000000..a5fc160a\n4\t--- /dev/null\n5\t+++ b/.github/actionlint.yaml\n6\t@@ -0,0 +1,11 @@\n7\t+# actionlint configuration.\n8\t+#\n9\t+# `macos-15-intel` and `windows-11-arm` are real GitHub-hosted runner labels\n10\t+# (both became generally available in 2025) but are newer than the label list\n11\t+# baked into actionlint's release binary, which reports them as unknown. They\n12\t+# are declared here so the workflow linter stays free of known-false findings --\n13\t+# a linter with permanent noise is a linter nobody reads (issue #812).\n14\t+self-hosted-runner:\n15\t+  labels:\n16\t+    - macos-15-intel\n17\t+    - windows-11-arm\n18\tdiff --git a/.github/workflows/desktop-release.yml b/.github/workflows/desktop-release.yml\n19\tindex 6e69d959..2fc6a3f5 100644\n20\t--- a/.github/workflows/desktop-release.yml\n21\t+++ b/.github/workflows/desktop-release.yml\n22\t@@ -171,6 +171,23 @@ jobs:\n23\t           # On pull requests there is no resolved tag: build the PR head, which\n24\t           # is the whole point of the dry run.\n25\t           ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}\n26\t+          # Quoted '0'/'1': GitHub's `&&`/`||` treat the number 0 as falsy, so an\n27\t+          # unquoted 0 here would silently select the other branch.\n28\t+          # 0 is needed by simulate-fresh-merge.sh, which merges origin/<base>.\n29\t+          fetch-depth: ${{ github.event_name == 'pull_request' && '0' || '1' }}\n30\t+\n31\t+      # Issue #812: `release.yml` simulates the fresh merge in `lint` and `test`,\n32\t+      # but this workflow -- the only one that packages the desktop app -- did\n33\t+      # not, so the packaging dry run validated the PR head against a merge\n34\t+      # preview that predates any commit pushed to the base branch since the last\n35\t+      # sync