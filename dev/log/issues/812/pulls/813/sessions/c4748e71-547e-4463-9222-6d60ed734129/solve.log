[2026-07-20T17:42:21.041Z] [INFO]           "+/// Issue #812: the size gate covered no CI definition at all, so",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// `.github/workflows/release.yml` reached 1824 lines -- past the 1500-line",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// ceiling the js pipeline template applies to its own workflows -- with CI",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// green throughout. A workflow nobody can read in one sitting is where",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// mis-ordered `needs:` and stale `if:` conditions hide, which is precisely the",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// class of defect this issue is about.",
[2026-07-20T17:42:21.041Z] [INFO]           "+///",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// The cap is deliberately set above today's worst file rather than below it: a",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// hard failure would block every unrelated pull request until `release.yml` is",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// split (a large, separate change), which is the same non-actionable-gate",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// mistake §4 of the issue analysis is about. The warning band starts at the",
[2026-07-20T17:42:21.041Z] [INFO]           "+/// template's ceiling, so the debt is visible on every run and cannot grow.",
[2026-07-20T17:42:21.041Z] [INFO]           "+const WORKFLOW_YAML_LIMIT: FileLimit = FileLimit {",
[2026-07-20T17:42:21.041Z] [INFO]           "+    extension: \"yml\",",
[2026-07-20T17:42:21.041Z] [INFO]           "+    max_lines: 2_000,",
[2026-07-20T17:42:21.041Z] [INFO]           "+    warn_lines: 1_500,",
[2026-07-20T17:42:21.041Z] [INFO]           "+    label: \"GitHub Actions workflow\",",
[2026-07-20T17:42:21.041Z] [INFO]           "+};",
[2026-07-20T17:42:21.041Z] [INFO]           " const EXCLUDE_PATTERNS: &[&str] = &[\"target\", \".git\", \"node_modules\"];",
[2026-07-20T17:42:21.041Z] [INFO]           " const EXCLUDE_PATH_FRAGMENTS: &[&str] = &[\"data/cache/wikidata/\", \"dev/log/\"];",
[2026-07-20T17:42:21.041Z] [INFO]           " "
[2026-07-20T17:42:21.041Z] [INFO]         ]
