[2026-07-20T17:16:24.146Z] [INFO]         "input": {
[2026-07-20T17:16:24.146Z] [INFO]           "command": "python3 - <<'EOF'\nimport subprocess,re\ndef git(*a):\n    r=subprocess.run([\"git\",*a],capture_output=True,text=True)\n    if r.returncode: raise RuntimeError(r.stderr[:200])\n    return r.stdout\nrows=[];cur=None\nfor line in open(\"data/meta/self-hosting-ledger.lino\"):\n    if line.strip()==\"release\":\n        cur={}; rows.append(cur); continue\n    m=re.match(r'\\s+(\\w+) \"(.*)\"\\s*$',line)\n    if m and cur is not None: cur[m.group(1)]=m.group(2)\n\nSESSION=\"formal-ai-session:\"; EVID=\"formal-ai-evidence:\"\ndef trailers(c,k):\n    return [l.strip()[len(k):].strip() for l in git(\"show\",\"-s\",\"--format=%B\",c).splitlines()\n            if l.strip()[:len(k)].lower()==k and l.strip()[len(k):].strip()]\ndef attributed(c):\n    s=trailers(c,SESSION); e=trailers(c,EVID)\n    if not s or not e: return False\n    ev=[]\n    for p in e:\n        try: ev.append(git(\"show\",f\"{c}:{p}\"))\n        except Exception: return False\n    if not all(\"formal-ai\" in v.lower() for v in ev): return False\n    return all(any(x in v for v in ev) for x in s)\nEXCL=(\"dev/log/\",)\nLOCK={\"Cargo.lock\",\"bun.lock\",\"desktop/bun.lock\",\"vscode/bun.lock\",\"package-lock.json\"}\ndef lines(c,excl):\n    t=0\n    for line in git(\"show\",\"--format=\",\"--numstat\",\"--no-renames\",c).splitlines():\n        f=line.split(\"\\t\")\n        if len(f)<3 or f[0]==\"-\" or f[1]==\"-\": continue\n        if excl and (f[2].startswith(EXCL) or f[2] in LOCK): continue\n        t+=int(f[0])+int(f[1])\n    return t\ndef bp(n,d): return (n*10000+d//2)//d if d else 0\n\nfor excl in (True,):\n    out=[]\n    for r in rows:\n        cs=[c for c in git(\"rev-list\",\"--reverse\",\"--no-merges\",f'{r[\"since\"]}..{r[\"until\"]}').split() if c]\n        tot=sa=0;nc=0\n        for c in cs:\n            n=lines(c,excl); tot+=n\n            if attributed(c): sa+=n; nc+=1\n        out.append((r[\"tag\"],sa,tot,nc,len(cs)))\n    # add pending v0.301.0\n    cs=[c for c in git(\"rev-list\",\"--reverse\",\"--no-merges\",\"v0.300.0..origin/main\").split() if c]\n    tot=sa=0;nc=0\n    for c in cs:\n        n=lines(c,excl); tot+=n\n        if attributed(c): sa+=n;nc+=1\n    out.append((\"v0.301.0\",sa,tot,nc,len(cs)))\n    print(f\"{'tag':10} {'self':>7} {'changed':>8} {'pct':>7} {'trail3':>8}\")\n    for i,(tag,sa,tot,nc,n) in enumerate(out):\n        w=out[max(0,i-2):i+1]\n        t3=bp(sum(x[1] for x in w),sum(x[2] for x in w))\n        print(f\"{tag:10} {sa:>7} {tot:>8} {bp(sa,tot)/100:>6.2f}% {t3/100:>7.2f}%   ({nc}/{n} commits)\")\nEOF",
