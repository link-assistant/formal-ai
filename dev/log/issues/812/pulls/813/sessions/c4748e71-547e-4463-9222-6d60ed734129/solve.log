[2026-07-20T17:29:54.375Z] [INFO]           "+            \"{captured} is captured output, not authored work\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+        );",
[2026-07-20T17:29:54.375Z] [INFO]           "+    }",
[2026-07-20T17:29:54.375Z] [INFO]           "+    for authored in [",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"scripts/self-hosting-metric.rs\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"dev/log/issues/812/pulls/813/analysis.md\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \".github/workflows/release.yml\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"logger.rs\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+    ] {",
[2026-07-20T17:29:54.375Z] [INFO]           "+        assert!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+            !metric_script::is_non_authored_path(authored),",
[2026-07-20T17:29:54.375Z] [INFO]           "+            \"{authored} is authored work\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+        );",
[2026-07-20T17:29:54.375Z] [INFO]           "+    }",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let repo = fixture_repo();",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::create_dir_all(repo.join(\"dev/log\")).expect(\"log directory must be created\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let bulk = \"captured line\\n\".repeat(5_000);",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(repo.join(\"dev/log/run.log\"), &bulk).expect(\"captured log must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(repo.join(\"human-code.txt\"), \"one authored line\\n\").expect(\"code must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    commit(&repo, \"human change carrying a captured log\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let measurement =",
[2026-07-20T17:29:54.375Z] [INFO]           "+        metric_script::measure(&repo, \"v1.0.0\", \"HEAD\").expect(\"measurement must succeed\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        measurement.changed_lines, 1,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"5000 lines of captured log must not enter the denominator\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::remove_dir_all(repo).expect(\"fixture directory must be removed\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+}",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// The exclusion above redefines what the ratio measures, so rows written before",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// it are not comparable with rows written after it. The ratchet and the",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// trailing window must therefore only ever look at rows of the same",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// `metric_version`; averaging two definitions would silently compare two",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// different quantities and re-create the #812 outage from the other direction.",
[2026-07-20T17:29:54.375Z] [INFO]           "+#[test]",
[2026-07-20T17:29:54.375Z] [INFO]           "+fn rows_from_an_older_measurement_epoch_are_never_compared() {",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let repo = fixture_repo();",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let ledger = repo.join(\"data/meta/self-hosting-ledger.lino\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    // A row in the shape written before issue #812: no `metric_version` field,",
[2026-07-20T17:29:54.375Z] [INFO]           "+    // and a share no epoch-2 row could plausibly reach.",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let mut legacy = fs::read_to_string(&ledger).expect(\"fixture ledger must be readable\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    legacy.push_str(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"  release\\n    tag \\\"v0.9.0\\\"\\n    since \\\"v0.8.0\\\"\\n    until \\\"v0.9.0\\\"\\n    \\",
[2026-07-20T17:29:54.375Z] [INFO]           "+         self_authored_lines \\\"9900\\\"\\n    changed_lines \\\"10000\\\"\\n    self_authored_commits \\",
[2026-07-20T17:29:54.375Z] [INFO]           "+         \\\"9\\\"\\n    commits \\\"10\\\"\\n    percentage_basis_points \\\"9900\\\"\\n    trailing_window \\",
[2026-07-20T17:29:54.375Z] [INFO]           "+         \\\"3\\\"\\n    trailing_percentage_basis_points \\\"9900\\\"\\n\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(&ledger, legacy).expect(\"legacy ledger must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        metric_script::read_release_rows(&ledger).expect(\"ledger must parse\")[0].metric_version,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        1,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"a row without the field predates issue #812 and is, by definition, epoch 1\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(repo.join(\"human-code.txt\"), \"human change\\n\").expect(\"code must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    commit(&repo, \"human change\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let row = metric_script::record_release(&repo, &ledger, \"v1.1.0\", \"v1.0.0\", \"HEAD\", 3)",
[2026-07-20T17:29:54.375Z] [INFO]           "+        .expect(\"a 99% epoch-1 row must not ratchet against an epoch-2 measurement\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(row.metric_version, 2);",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        row.trailing_percentage_basis_points, 0,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"the trailing window must average epoch-2 rows only\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::remove_dir_all(repo).expect(\"fixture directory must be removed\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+}",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// Issue #812, second root cause: the ratchet ran on `main`, after every",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// contributing commit was immutable, and the only way to move the measured",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// range forward -- cutting a tag -- was exactly what it blocked. Third outage of",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// that shape in a row (#796, #810, #812). Recording a release must report the",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// fall and ship; enforcement belongs to the pull-request gate.",
[2026-07-20T17:29:54.375Z] [INFO]           "+#[test]",
[2026-07-20T17:29:54.375Z] [INFO]           "+fn a_falling_ratchet_reports_at_release_time_instead_of_blocking_it() {",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let repo = fixture_repo();",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let ledger = repo.join(\"data/meta/self-hosting-ledger.lino\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::create_dir_all(repo.join(\"docs/evidence\")).expect(\"evidence directory must be created\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        repo.join(\"docs/evidence/session.txt\"),",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"formal-ai session fixture-session\\n\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+    )",
[2026-07-20T17:29:54.375Z] [INFO]           "+    .expect(\"session evidence must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    commit(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        &repo,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"formal ai change\\n\\nFormal-AI-Session: fixture-session\\nFormal-AI-Evidence: \\",
[2026-07-20T17:29:54.375Z] [INFO]           "+         docs/evidence/session.txt\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let first = metric_script::record_release(&repo, &ledger, \"v1.1.0\", \"v1.0.0\", \"HEAD\", 3)",
[2026-07-20T17:29:54.375Z] [INFO]           "+        .expect(\"the first release row must be recorded\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(first.trailing_percentage_basis_points, 10_000);",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(repo.join(\"human-code.txt\"), \"unattributed\\n\").expect(\"code must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    commit(&repo, \"human change\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        metric_script::record_release(&repo, &ledger, \"v1.2.0\", \"v1.1.0\", \"HEAD\", 3)",
[2026-07-20T17:29:54.375Z] [INFO]           "+            .expect_err(\"the enforcing policy must still reject a fall\")",
[2026-07-20T17:29:54.375Z] [INFO]           "+            .contains(\"ratchet\"),",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let reported = metric_script::record_release_with_policy(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        &repo,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        &ledger,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"v1.2.0\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"v1.1.0\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"HEAD\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+        3,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        metric_script::RatchetPolicy::Report,",
[2026-07-20T17:29:54.375Z] [INFO]           "+    )",
[2026-07-20T17:29:54.375Z] [INFO]           "+    .expect(\"a release must not be blocked by a fall it cannot fix\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert!(reported.trailing_percentage_basis_points < first.trailing_percentage_basis_points);",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        metric_script::read_release_rows(&ledger)",
[2026-07-20T17:29:54.375Z] [INFO]           "+            .expect(\"ledger must parse\")",
[2026-07-20T17:29:54.375Z] [INFO]           "+            .last()",
[2026-07-20T17:29:54.375Z] [INFO]           "+            .map(|row| row.tag.clone()),",
[2026-07-20T17:29:54.375Z] [INFO]           "+        Some(\"v1.2.0\".to_owned()),",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"the regression must be recorded honestly, not hidden behind a failing job\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::remove_dir_all(repo).expect(\"fixture directory must be removed\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+}",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// The pull-request gate is where a fall is still actionable. It must be",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// *differential* -- this branch against its base -- so that a regression already",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// merged into `main` cannot fail every unrelated pull request, which would just",
[2026-07-20T17:29:54.375Z] [INFO]           "+/// move the #812 deadlock to a new job.",
[2026-07-20T17:29:54.375Z] [INFO]           "+#[test]",
[2026-07-20T17:29:54.375Z] [INFO]           "+fn the_pull_request_gate_only_judges_the_branchs_own_delta() {",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let repo = fixture_repo();",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let ledger = repo.join(\"data/meta/self-hosting-ledger.lino\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::create_dir_all(repo.join(\"docs/evidence\")).expect(\"evidence directory must be created\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        repo.join(\"docs/evidence/session.txt\"),",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"formal-ai session fixture-session\\n\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+    )",
[2026-07-20T17:29:54.375Z] [INFO]           "+    .expect(\"session evidence must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    commit(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        &repo,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"formal ai change\\n\\nFormal-AI-Session: fixture-session\\nFormal-AI-Evidence: \\",
[2026-07-20T17:29:54.375Z] [INFO]           "+         docs/evidence/session.txt\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+    metric_script::record_release(&repo, &ledger, \"v1.1.0\", \"v1.0.0\", \"HEAD\", 3)",
[2026-07-20T17:29:54.375Z] [INFO]           "+        .expect(\"baseline release row must be recorded\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    git(&repo, &[\"tag\", \"v1.1.0\"]);",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    // A branch of attributed work: the projected share cannot fall.",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(repo.join(\"formal-ai-code.txt\"), \"generated\\n\").expect(\"code must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    commit(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        &repo,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"formal ai follow-up\\n\\nFormal-AI-Session: fixture-session\\nFormal-AI-Evidence: \\",
[2026-07-20T17:29:54.375Z] [INFO]           "+         docs/evidence/session.txt\",",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        metric_script::ratchet_check(&repo, &ledger, \"v1.1.0\", \"HEAD\", 3)",
[2026-07-20T17:29:54.375Z] [INFO]           "+            .expect(\"the ratchet check must run\"),",
[2026-07-20T17:29:54.375Z] [INFO]           "+        None,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"attributed work must never trip the gate\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    // A branch of unattributed work lowers the projection and is rejected while",
[2026-07-20T17:29:54.375Z] [INFO]           "+    // its commits can still be amended.",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::write(repo.join(\"human-code.txt\"), \"unattributed\\n\").expect(\"code must be written\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    commit(&repo, \"human change\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    let regression = metric_script::ratchet_check(&repo, &ledger, \"HEAD^\", \"HEAD\", 3)",
[2026-07-20T17:29:54.375Z] [INFO]           "+        .expect(\"the ratchet check must run\")",
[2026-07-20T17:29:54.375Z] [INFO]           "+        .expect(\"unattributed work must be reported against its own base\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        regression.contains(\"Formal-AI-Session\"),",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"the message must say how to fix it: {regression}\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    // An empty branch is always neutral, whatever main's own trend is.",
[2026-07-20T17:29:54.375Z] [INFO]           "+    assert_eq!(",
[2026-07-20T17:29:54.375Z] [INFO]           "+        metric_script::ratchet_check(&repo, &ledger, \"HEAD\", \"HEAD\", 3)",
[2026-07-20T17:29:54.375Z] [INFO]           "+            .expect(\"the ratchet check must run\"),",
[2026-07-20T17:29:54.375Z] [INFO]           "+        None,",
[2026-07-20T17:29:54.375Z] [INFO]           "+        \"a no-op branch must never be blocked by a pre-existing regression\"",
[2026-07-20T17:29:54.375Z] [INFO]           "+    );",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+    fs::remove_dir_all(repo).expect(\"fixture directory must be removed\");",
[2026-07-20T17:29:54.375Z] [INFO]           "+}",
[2026-07-20T17:29:54.375Z] [INFO]           "+",
[2026-07-20T17:29:54.375Z] [INFO]           "+#[test]",
[2026-07-20T17:29:54.375Z] [INFO]           " fn release_pipeline_and_ledger_remain_pinned_to_the_metric() {",
[2026-07-20T17:29:54.375Z] [INFO]           "     let root = Path::new(env!(\"CARGO_MANIFEST_DIR\"));",
[2026-07-20T17:29:54.375Z] [INFO]           "     let workflow = fs::read_to_string(root.join(\".github/workflows/release.yml\"))"
[2026-07-20T17:29:54.375Z] [INFO]         ]
[2026-07-20T17:29:54.375Z] [INFO]       }
[2026-07-20T17:29:54.375Z] [INFO]     ],
[2026-07-20T17:29:54.375Z] [INFO]     "userModified": false,
[2026-07-20T17:29:54.375Z] [INFO]     "replaceAll": false
[2026-07-20T17:29:54.375Z] [INFO]   }
[2026-07-20T17:29:54.375Z] [INFO] }
