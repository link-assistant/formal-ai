[2026-07-20T19:02:00.528Z] [INFO]         "type": "tool_result",
[2026-07-20T19:02:00.528Z] [INFO]         "content": "400\t         id: deployment\n401\tdiff --git a/scripts/check-file-size.rs b/scripts/check-file-size.rs\n402\tindex bb29933e..6d3770d7 100644\n403\t--- a/scripts/check-file-size.rs\n404\t+++ b/scripts/check-file-size.rs\n405\t@@ -35,6 +35,24 @@ const WORKER_JS_LIMIT: FileLimit = FileLimit {\n406\t     warn_lines: 1_400,\n407\t     label: \"Worker JavaScript\",\n408\t };\n409\t+/// Issue #812: the size gate covered no CI definition at all, so\n410\t+/// `.github/workflows/release.yml` reached 1824 lines -- past the 1500-line\n411\t+/// ceiling the js pipeline template applies to its own workflows -- with CI\n412\t+/// green throughout. A workflow nobody can read in one sitting is where\n413\t+/// mis-ordered `needs:` and stale `if:` conditions hide, which is precisely the\n414\t+/// class of defect this issue is about.\n415\t+///\n416\t+/// The cap is deliberately set above today's worst file rather than below it: a\n417\t+/// hard failure would block every unrelated pull request until `release.yml` is\n418\t+/// split (a large, separate change), which is the same non-actionable-gate\n419\t+/// mistake §4 of the issue analysis is about. The warning band starts at the\n420\t+/// template's ceiling, so the debt is visible on every run and cannot grow.\n421\t+const WORKFLOW_YAML_LIMIT: FileLimit = FileLimit {\n422\t+    extension: \"yml\",\n423\t+    max_lines: 2_000,\n424\t+    warn_lines: 1_500,\n425\t+    label: \"GitHub Actions workflow\",\n426\t+};\n427\t const EXCLUDE_PATTERNS: &[&str] = &[\"target\", \".git\", \"node_modules\"];\n428\t const EXCLUDE_PATH_FRAGMENTS: &[&str] = &[\"data/cache/wikidata/\", \"dev/log/\"];\n429\t \n430\t@@ -51,12 +69,16 @@ fn normalized_path(path: &Path) -> String {\n431\t         .replace(std::path::MAIN_SEPARATOR, \"/\")\n432\t }\n433\t \n434\t+/// Issue #812: `EXCLUDE_PATTERNS` are directory *names*, so they are matched per\n435\t+/// path component. A substring test hid every workflow from the gate --\n436\t+/// `.github/workflows/release.yml` contains `.git` -- and would likewise skip\n437\t+/// any path with `target` or `node_modules` inside a longer segment.\n438\t fn should_exclude(path: &Path) -> bool {\n439\t     let path_str = normalized_path(path);\n440\t \n441\t-    EXCLUDE_PATTERNS\n442\t-        .iter()\n443\t-        .any(|pattern| path_str.contains(pattern))\n444\t+    path_str\n445\t+        .split('/')\n446\t+        .any(|component| EXCLUDE_PATTERNS.contains(&component))\n447\t         || EXCLUDE_PATH_FRAGMENTS\n448\t             .iter()\n449\t             .any(|fragment| path_str.contains(fragment))\n450\t@@ -72,11 +94,30 @@ fn is_worker_js_path(path: &Path) -> bool {\n451\t         || (path_str.contains(\"/src/web/worker/\") && has_js_extension)\n452\t }\n453\t \n454\t+/// Only workflows this repository owns are measured. `docs/case-studies/**`\n455\t+/// holds verbatim copies of other projects' pipelines as evidence; reformatting\n456\t+/// them to fit our ceiling would destroy the thing they document.\n457\t+fn is_workflow_yaml_path(path: &Path) -> bool {\n458\t+    let path_str = normalized_path(path);\n459\t+    let has_yaml_extension = path\n460\t+        .extension()\n461\t+        .and_then(|extension| extension.to_str())\n462\t+        .is_some_and(|extension| {\n463\t+            extension.eq_ignore_ascii_case(\"yml\") || extension.eq_ignore_ascii_case(\"yaml\")\n464\t+        });\n465\t+\n466\t+    has_yaml_extension && (path_str.starts_with(\".github/\") || path_str.contains(\"/.github/\"))\n467\t+}\n468\t+\n469\t fn file_limit(path: &Path) -> Option<&'static FileLimit> {\n470\t     if is_worker_js_path(path) {\n471\t         return Some(&WORKER_JS_LIMIT);\n472\t     }\n473\t \n474\t+    if is_workflow_yaml_path(path) {\n475\t+        return Some(&WORKFLOW_YAML_LIMIT);\n476\t+    }\n477\t+\n478\t     let ext = path.extension().and_then(|ext| ext.to_str())?;\n479\t \n480\t     FILE_LIMITS.iter().find(|limit| limit.extension == ext)\n481\t@@ -345,7 +386,7 @@ fn print_embedded_data_violations(violations: &[EmbeddedDataFinding]) {\n482\t #[cfg(not(test))]\n483\t fn main() {\n484\t     println!(\n485\t-        \"\\nChecking configured file line limits for Rust, Links Notation, and worker JavaScript files...\\n\"\n486\t+        \"\\nChecking configured file line limits for Rust, Links Notation, worker JavaScript, and GitHub Actions workflow files...\\n\"\n487\t     );\n488\t \n489\t     let cwd = std::env::current_dir().expect(\"Failed to get current directory\");\n490\t@@ -583,6 +624,51 @@ mod tests {\n491\t         );\n492\t     }\n493\t \n494\t+    /// Issue #812: `.github/workflows/**` matched the `.git` exclusion as a\n495\t+    /// substring, so every workflow was invisible to this gate and\n496\t+    /// `release.yml` grew to 1824 lines with CI green.\n497\t+    #[test]\n498\t+    fn check_directory_measures_github_workflows() {\n499\t+        let repo = temp_dir(\"github-workflows\");\n500\t+        let workflows = repo.join(\".github/workflows\");\n501\t+        fs::create_dir_all(&workflows).unwrap();\n502\t+        write_file_with_lines(\n503\t+            &workflows.join(\"release.yml\"),\n504\t+            WORKFLOW_YAML_LIMIT.max_lines + 1,\n505\t+        );\n506\t+\n507\t+        let result = check_directory(&repo);\n508\t+\n509\t+        assert_eq!(\n510\t+            result.violations,\n511\t+            vec![Finding {\n512\t+                file: \".github/workflows/release.yml\".to_string(),\n513\t+                lines: WORKFLOW_YAML_LIMIT.max_lines + 1,\n514\t+                max_lines: WORKFLOW_YAML_LIMIT.max_lines,\n515\t+                warn_lines: WORKFLOW_YAML_LIMIT.warn_lines,\n516\t+                label: WORKFLOW_YAML_LIMIT.label,\n517\t+            }]\n518\t+        );\n519\t+    }\n520\t+\n521\t+    /// Case studies quote other projects' pipelines verbatim as evidence;\n522\t+    /// trimming them to our ceiling would destroy what they document.\n5