[2026-07-20T17:23:14.424Z] [INFO]         "content": "575\t}\n576\t\n577\t#[derive(Debug)]\n578\tstruct Options {\n579\t    repo: PathBuf,\n580\t    since: String,\n581\t    until: String,\n582\t    ledger: PathBuf,\n583\t    record_release: Option<String>,\n584\t    trailing_window: usize,\n585\t}\n586\t\n587\tfn parse_options(args: impl IntoIterator<Item = String>) -> Result<Options, String> {\n588\t    let mut repo = PathBuf::from(\".\");\n589\t    let mut since = None;\n590\t    let mut until = \"HEAD\".to_owned();\n591\t    let mut ledger = PathBuf::from(DEFAULT_LEDGER);\n592\t    let mut record_release = None;\n593\t    let mut trailing_window = DEFAULT_TRAILING_WINDOW;\n594\t    let mut args = args.into_iter();\n595\t    while let Some(arg) = args.next() {\n596\t        let value = |args: &mut dyn Iterator<Item = String>| {\n597\t            args.next().ok_or_else(|| format!(\"{arg} requires a value\"))\n598\t        };\n599\t        match arg.as_str() {\n600\t            \"--repo\" => repo = PathBuf::from(value(&mut args)?),\n601\t            \"--since\" => since = Some(value(&mut args)?),\n602\t            \"--until\" => until = value(&mut args)?,\n603\t            \"--ledger\" => ledger = PathBuf::from(value(&mut args)?),\n604\t            \"--record-release\" => record_release = Some(value(&mut args)?),\n605\t            \"--trailing-window\" => {\n606\t                trailing_window = value(&mut args)?\n607\t                    .parse::<usize>()\n608\t                    .map_err(|error| format!(\"invalid --trailing-window: {error}\"))?;\n609\t            }\n610\t            \"--help\" | \"-h\" => {\n611\t                return Err(\n612\t                    \"usage: self-hosting-metric.rs --since <tag> [--until <rev>] \\\n613\t                     [--record-release <tag>] [--ledger <path>] [--repo <path>]\"\n614\t                        .to_owned(),\n615\t                );\n616\t            }\n617\t            _ => return Err(format!(\"unknown argument: {arg}\")),\n618\t        }\n619\t    }\n620\t    let since = since.ok_or_else(|| \"--since <tag> is required\".to_owned())?;\n621\t    let ledger = if ledger.is_absolute() {\n622\t        ledger\n623\t    } else {\n624\t        repo.join(ledger)\n625\t    };\n626\t    Ok(Options {\n627\t        repo,\n628\t        since,\n629\t        until,\n630\t        ledger,\n631\t        record_release,\n632\t        trailing_window,\n633\t    })\n634\t}\n635\t\n636\tfn run() -> Result<(), String> {\n637\t    let options = parse_options(env::args().skip(1))?;\n638\t    let measurement = if let Some(tag) = options.record_release {\n639\t        let row = record_release(\n640\t            &options.repo,\n641\t            &options.ledger,\n642\t            &tag,\n643\t            &options.since,\n644\t            &options.until,\n645\t            options.trailing_window,\n646\t        )?;\n647\t        Measurement {\n648\t            self_authored_lines: row.self_authored_lines,\n649\t            changed_lines: row.changed_lines,\n650\t            self_authored_commits: row.self_authored_commits,\n651\t            commits: row.commits,\n652\t            percentage_basis_points: row.percentage_basis_points,\n653\t        }\n654\t    } else {\n655\t        measure(&options.repo, &options.since, &options.until)?\n656\t    };\n657\t    println!(\n658\t        \"{} ({}/{} changed lines; {}/{} commits)\",\n659\t        format_percentage(measurement.percentage_basis_points),\n660\t        measurement.self_authored_lines,\n661\t        measurement.changed_lines,\n662\t        measurement.self_authored_commits,\n663\t        measurement.commits,\n664\t    );\n665\t    Ok(())\n666\t}\n667\t\n668\tfn main() {\n669\t    if let Err(error) = run() {\n670\t        eprintln!(\"self-hosting metric error: {error}\");\n671\t        std::process::exit(1);\n672\t    }\n673\t}\n674\t"
