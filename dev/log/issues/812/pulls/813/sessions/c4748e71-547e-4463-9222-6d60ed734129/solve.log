[2026-07-20T17:13:38.434Z] [INFO]         "content": "1\t'use strict';\n2\t\n3\tconst { signAsync } = require('@electron/osx-sign');\n4\tconst { spawnSync } = require('node:child_process');\n5\tconst fs = require('node:fs');\n6\tconst path = require('node:path');\n7\t\n8\tfunction isDebugEnabled() {\n9\t  return process.env.FORMAL_AI_MACOS_SIGN_DEBUG === '1';\n10\t}\n11\t\n12\t// Diagnostics go to stderr, never stdout. electron-builder's own logger and\n13\t// electron-osx-sign's `debug` output both use stderr; interleaving there keeps\n14\t// the sign trace readable in GitHub Actions logs, and stderr is the stream that\n15\t// survives when electron-builder aborts the CLI on a signing error.\n16\t//\n17\t// Issue #810: run 29738571290 logged electron-builder's own \"executing custom\n18\t// sign\" line, so this module *was* resolved and invoked, yet not one\n19\t// `[adhoc-sign-mac]` line reached the CI log -- which is why we still cannot\n20\t// say whether `signingIgnoreRules()` ever saw the browser-runtime paths. The\n21\t// most likely culprit is `process.stderr.write()`: on a pipe (which is what\n22\t// GitHub Actions gives a child process) it is asynchronous and buffered, so\n23\t// anything still queued is lost when electron-builder aborts the process on a\n24\t// signing error. `fs.writeSync(2, ...)` cannot be lost that way.\n25\tfunction log(message) {\n26\t  try {\n27\t    fs.writeSync(2, `[adhoc-sign-mac] ${message}\\n`);\n28\t  } catch {\n29\t    process.stderr.write(`[adhoc-sign-mac] ${message}\\n`);\n30\t  }\n31\t}\n32\t\n33\tfunction debugLog(message) {\n34\t  if (isDebugEnabled()) {\n35\t    log(message);\n36\t  }\n37\t}\n38\t\n39\tfunction findAppPath(signOptions) {\n40\t  debugLog(`signOptions keys: ${Object.keys(signOptions).sort().join(', ')}`);\n41\t  debugLog(`cwd: ${process.cwd()}`);\n42\t  for (const field of ['app', 'appPath', 'path']) {\n43\t    debugLog(`candidate ${field}: ${JSON.stringify(signOptions[field] ?? null)}`);\n44\t  }\n45\t  for (const field of ['app', 'appPath', 'path']) {\n46\t    if (typeof signOptions[field] === 'string' && signOptions[field].endsWith('.app')) {\n47\t      return signOptions[field];\n48\t    }\n49\t  }\n50\t\n51\t  throw new Error(\n52\t    `Could not determine macOS app bundle path from signing options: ${Object.keys(signOptions)\n53\t      .sort()\n54\t      .join(', ')}`,\n55\t  );\n56\t}\n57\t\n58\tfunction isBundledBrowserRuntime(filePath, appPath) {\n59\t  const browserRuntime = path.join(\n60\t    path.resolve(appPath),\n61\t    'Contents',\n62\t    'Resources',\n63\t    'browser-runtime',\n64\t  );\n65\t  const relative = path.relative(browserRuntime, path.resolve(filePath));\n66\t  const bundled =\n67\t    relative === '' ||\n68\t    (!relative.startsWith(`..${path.sep}`) && relative !== '..' && !path.isAbsolute(relative));\n69\t  debugLog(\n70\t    `ignore ${bundled ? 'SKIP' : 'sign'} root=${browserRuntime} relative=${relative} path=${filePath}`,\n71\t  );\n72\t  return bundled;\n73\t}\n74\t\n75\t// Issue #808: @electron/osx-sign's `validateOptsIgnore()` is\n76\t//\n77\t//   function validateOptsIgnore (ignore) {\n78\t//     if (ignore && !(ignore instanceof Array)) { return [ignore] }\n79\t//   }\n80\t//\n81\t// -- it has no `return ignore` for the array case, so passing an **array**\n82\t// silently yields `undefined` and every ignore rule is discarded. That is why\n83\t// run 29731405782 signed `Contents/Resources/browser-runtime/...` anyway and\n84\t// died with \"unsealed contents present in the root directory of an embedded\n85\t// framework\", and why electron-builder's own `mac.signIgnore` (which it forwards\n86\t// as an array) never took effect either. We therefore hand the library a single\n87\t// predicate function, which it wraps into `[fn]` itself.\n88\tfunction signingIgnoreRules(signOptions) {\n89\t  const upstreamIgnore = signOptions.ignore\n90\t    ? Array.isArray(signOptions.ignore)\n91\t      ? signOptions.ignore\n92\t      : [signOptions.ignore]\n93\t    : [];\n94\t  const appPath = findAppPath(signOptions);\n95\t\n96\t  const matchers = [\n97\t    ...upstreamIgnore,\n98\t    (filePath) => isBundledBrowserRuntime(filePath, appPath),\n99\t  ];\n100\t\n101\t  // Issue #810: the per-file trace stays behind FORMAL_AI_MACOS_SIGN_DEBUG, but\n102\t  // these two counters are always reported (see the summary in the exported\n103\t  // hook). Run 29738571290 died on a browser-runtime path while the ignore rule\n104\t  // was supposedly installed, and we had no way to tell whether the predicate\n105\t  // was consulted at all -- \"considered=0\" and \"skipped=0\" mean very different\n106\t  // things, and one line of output distinguishes them.\n107\t  const stats = { considered: 0, skipped: 0 };\n108\t  const predicate = (filePath) => {\n109\t    stats.considered += 1;\n110\t    const ignored = matchers.some((matcher) =>\n111\t      typeof matcher === 'function' ? matcher(filePath) : Boolean(filePath.match(matcher)),\n112\t    );\n113\t    if (ignored) {\n114\t      stats.skipped += 1;\n115\t    }\n116\t    return ignored;\n117\t  };\n118\t  predicate.stats = stats;\n119\t  return predicate;\n120\t}\n121\t\n122\tfunction resolvePath(value) {\n123\t  return typeof value === 'string' && value.length > 0 ? path.resolve(value) : undefined;\n124\t}\n125\t\n126\tfunction normalizeSignatureFlags(signatureFlags) {\n127\t  if (Array.isArray(signatureFlags)) {\n128\t    return signatureFlags;\n129\t  }\n130\t  if (typeof signatureFlags === 'string') {\n131\t    return signatureFlags\n132\t      .split(',')\n133\t      .map((flag) => flag.trim())\n134\t      .filter(Boolean);\n135\t  }\n136\t  return [];\n137\t}\n138\t\n139\tfunction appendSignOptions(args, appFileOptions) {\n140\t  const requirements = appFileOptions.requirements;\n141\t  if (typeof requirements === 'string' && requirements.length > 0) {\n142\t    if (requirements.startsWith('=')) {\n143\t      args.push(`-r${requirements}`);\n144\t    } else {\n145\t      args.push('--requirements', requirements);\n146\t    }\n147\t  }\n148\t\n149\t  const optionFlags = normalizeSignatureFlags(appFileOptions.signatureFlags);\n150\t  if (appFileOptions.hardenedRuntime !== false) {\n151\t    optionFlags.push('runtime');\n152\t  }\n153\t  if (optionFlags.length > 0) {\n154\t    args.push('--options', [...new Set(optionFlags)].join(','));\n155\t  }\n156\t\n157\t  if (Array.isArray(appFileOptions.additionalArguments)) {\n158\t    args.push(...appFileOptions.additionalArguments);\n159\t  }\n160\t\n161\t  const entitlements = resolvePath(appFileOptions.entitlements);\n162\t  if (entitlements) {\n163\t    args.push('--entitlements', entitlements);\n164\t  }\n165\t}\n166\t\n167\tfunction runCodesign(args, action) {\n168\t  const result = spawnSync('/usr/bin/codesign', args, { encoding: 'utf8' });\n169\t\n170\t  if (result.error) {\n171\t    throw result.error;\n172\t  }\n173\t\n174\t  if (isDebugEnabled() || result.status !== 0) {\n175\t    if (result.stdout) {\n176\t      process.stdout.write(result.stdout);\n177\t    }\n178\t    if (result.stderr) {\n179\t      process.stderr.write(result.stderr);\n180\t    }\n181\t  }\n182\t\n183\t  if (result.status !== 0) {\n184\t    throw new Error(`codesign failed to ${action} (exit ${result.status})`);\n185\t  }\n186\t}\n187\t\n188\tmodule.exports = async function adhocSignMac(signOptions) {\n189\t  if (process.env.MACOS_ADHOC_SIGN !== '1') {\n190\t    throw new Error('Ad-hoc macOS signing must be enabled explicitly.');\n191\t  }\n192\t\n193\t  // One unconditional line. Run 29724500254 failed inside electron-osx-sign\n194\t  // while FORMAL_AI_MACOS_SIGN_DEBUG=1 was set, yet the log contained no\n195\t  // `[adhoc-sign-mac]` output at all, so we could not tell whether this hook\n196\t  // ever ran. This banner settles that question on every future run; the\n197\t  // per-file trace stays behind the env var and off by default.\n198\t  log(`hook entered (debug=${isDebugEnabled() ? 'on' : 'off'})`);\n199\t\n200\t  const upstreamOptionsForFile = signOptions.optionsForFile;\n201\t  const ignore = signingIgnoreRules(signOptions);\n202\t\n203\t  try {\n204\t    await signAsync({\n205\t      ...signOptions,\n206\t      // Playwright's Chrome for Testing bundle is separately signed upstream.\n207\t      // Treat it as an opaque resource: signing its framework aliases and files\n208\t      // as Electron children breaks the framework seal. The final app signing\n209\t      // below still includes the whole runtime in the app's resource envelope.\n210\t      ignore,\n211\t      identity: '-',\n212\t      identityValidation: false,\n213\t      provisioningProfile: undefined,\n214\t      timestamp: 'none',\n215\t      optionsForFile(filePath) {\n216\t        const fileOptions = upstreamOptionsForFile\n217\t          ? upstreamOptionsForFile(filePath)\n218\t          : {};\n219\t\n220\t        return {\n221\t          ...fileOptions,\n222\t          timestamp: 'none',\n223\t        };\n224\t      },\n225\t    });\n226\t  } finally {\n227\t    // Reported on success *and* on failure: when electron-builder aborts, this\n228\t    // is the line that says whether the ignore predicate was ever consulted.\n229\t    log(\n230\t      `ignore predicate: considered=${ignore.stats.considered} skipped=${ignore.stats.skipped}`,\n231\t    );\n232\t  }\n233\t\n234\t  const appPath = findAppPath(signOptions);\n235\t  const appFileOptions = upstreamOptionsForFile ? upstreamOptionsForFile(appPath) || {} : {};\n236\t  const sealArgs = ['--force', '--timestamp=none', '--sign', '-'];\n237\t  appendSignOptions(sealArgs, appFileOptions);\n238\t  sealArgs.push(appPath);\n239\t\n240\t  // electron-builder 26 can leave ad-hoc bundles without a resource seal.\n241\t  // Re-sign the final bundle so CI verifies the same CodeResources envelope\n242\t  // that Gatekeeper checks after users copy the app out of the DMG.\n243\t  runCodesign(sealArgs, 'seal the ad-hoc macOS app resource envelope');\n244\t  runCodesign(\n245\t    ['--verify', '--deep', '--strict', '--verbose=2', appPath],\n246\t    'verify the ad-hoc macOS app signature',\n247\t  );\n248\t};\n249\t\n250\tmodule.exports.isBundledBrowserRuntime = isBundledBrowserRuntime;\n251\tmodule.exports.signingIgnoreRules = signingIgnoreRules;\n252\t"
