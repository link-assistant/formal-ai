[2026-07-20T17:53:49.138Z] [INFO] {
[2026-07-20T17:53:49.138Z] [INFO]   "type": "user",
[2026-07-20T17:53:49.138Z] [INFO]   "message": {
[2026-07-20T17:53:49.138Z] [INFO]     "role": "user",
