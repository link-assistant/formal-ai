[2026-07-20T18:52:51.933Z] [INFO]           "+/// Issue #812: run 29767811026 reported `Test (ubuntu-latest)` as failed with",
[2026-07-20T18:52:51.933Z] [INFO]           "+/// every test passing -- the suite finished 1.1 s before `timeout-minutes: 15`",
[2026-07-20T18:52:51.933Z] [INFO]           "+/// killed the job. The budget must exceed the measured cost, and the step must",
[2026-07-20T18:52:51.933Z] [INFO]           "+/// say so out loud before the margin is eaten again.",
[2026-07-20T18:52:51.933Z] [INFO]           "+#[test]",
[2026-07-20T18:52:51.933Z] [INFO]           "+fn test_job_budget_exceeds_the_measured_suite_cost_and_warns_before_it_is_eaten() {",
[2026-07-20T18:52:51.933Z] [INFO]           "+    let workflow = release_workflow();",
[2026-07-20T18:52:51.933Z] [INFO]           "+    let test_job = job_block(&workflow, \"test\");",
[2026-07-20T18:52:51.933Z] [INFO]           "+",
[2026-07-20T18:52:51.933Z] [INFO]           "+    assert!(",
[2026-07-20T18:52:51.933Z] [INFO]           "+        test_job.contains(\"timeout-minutes: 25\"),",
[2026-07-20T18:52:51.933Z] [INFO]           "+        \"the test job budget must cover the ~14min measured cost (issue #812)\"",
[2026-07-20T18:52:51.933Z] [INFO]           "+    );",
[2026-07-20T18:52:51.933Z] [INFO]           "+    assert!(",
[2026-07-20T18:52:51.933Z] [INFO]           "+        test_job.contains(\"TEST_BUDGET_SECONDS: 1500\"),",
[2026-07-20T18:52:51.933Z] [INFO]           "+        \"the warning threshold must be derived from the declared budget, and \\",
[2026-07-20T18:52:51.933Z] [INFO]           "+         1500s is `timeout-minutes: 25` (issue #812)\"",
[2026-07-20T18:52:51.933Z] [INFO]           "+    );",
[2026-07-20T18:52:51.933Z] [INFO]           "+    assert!(",
[2026-07-20T18:52:51.933Z] [INFO]           "+        test_job.contains(\"::warning title=Test suite is approaching its timeout\"),",
[2026-07-20T18:52:51.933Z] [INFO]           "+        \"creeping back toward the cap must be visible in the run summary rather \\",
[2026-07-20T18:52:51.933Z] [INFO]           "+         than resurfacing as a mystery cancellation (issue #812)\"",
[2026-07-20T18:52:51.933Z] [INFO]           "+    );",
[2026-07-20T18:52:51.933Z] [INFO]           "+}",
[2026-07-20T18:52:51.933Z] [INFO]           "+",
