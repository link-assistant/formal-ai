[2026-07-20T17:16:29.240Z] [INFO]         "content": "1\tname: CI/CD Pipeline\n2\t\n3\ton:\n4\t  push:\n5\t    branches:\n6\t      - main\n7\t  pull_request:\n8\t    types: [opened, synchronize, reopened]\n9\t  workflow_dispatch:\n10\t    inputs:\n11\t      bump_type:\n12\t        description: 'Version bump type'\n13\t        required: true\n14\t        type: choice\n15\t        options:\n16\t          - patch\n17\t          - minor\n18\t          - major\n19\t      description:\n20\t        description: 'Release description (optional)'\n21\t        required: false\n22\t        type: string\n23\t\n24\tconcurrency:\n25\t  group: ${{ github.workflow }}-${{ github.ref }}\n26\t  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n27\t\n28\tenv:\n29\t  GIT_CONFIG_COUNT: '1'\n30\t  GIT_CONFIG_KEY_0: init.defaultBranch\n31\t  GIT_CONFIG_VALUE_0: main\n32\t\n33\tjobs:\n34\t  # === DETECT CHANGES - determines which jobs should run ===\n35\t  detect-changes:\n36\t    name: Detect Changes\n37\t    runs-on: ubuntu-latest\n38\t    timeout-minutes: 5\n39\t    if: github.event_name != 'workflow_dispatch'\n40\t    outputs:\n41\t      py-changed: ${{ steps.changes.outputs.py-changed }}\n42\t      tests-changed: ${{ steps.changes.outputs.tests-changed }}\n43\t      package-changed: ${{ steps.changes.outputs.package-changed }}\n44\t      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n45\t      workflow-changed: ${{ steps.changes.outputs.workflow-changed }}\n46\t      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n47\t    steps:\n48\t      - uses: actions/checkout@v6\n49\t        with:\n50\t          fetch-depth: 0\n51\t\n52\t      - name: Setup Python\n53\t        uses: actions/setup-python@v5\n54\t        with:\n55\t          python-version: '3.13'\n56\t\n57\t      - name: Detect Python layout\n58\t        id: python_layout\n59\t        run: |\n60\t          if [ -f pyproject.toml ]; then\n61\t            PYTHON_ROOT=\".\"\n62\t            MULTI_LANGUAGE=\"false\"\n63\t            echo \"root=.\" >> \"$GITHUB_OUTPUT\"\n64\t            echo \"multi_language=false\" >> \"$GITHUB_OUTPUT\"\n65\t          elif [ -f python/pyproject.toml ]; then\n66\t            PYTHON_ROOT=\"python\"\n67\t            MULTI_LANGUAGE=\"true\"\n68\t            echo \"root=python\" >> \"$GITHUB_OUTPUT\"\n69\t            echo \"multi_language=true\" >> \"$GITHUB_OUTPUT\"\n70\t          else\n71\t            echo \"::error::Could not find pyproject.toml at repo root or python/pyproject.toml\"\n72\t            exit 1\n73\t          fi\n74\t\n75\t          if [ \"$PYTHON_ROOT\" = \".\" ]; then\n76\t            echo \"dist_dir=dist\" >> \"$GITHUB_OUTPUT\"\n77\t          else\n78\t            echo \"dist_dir=$PYTHON_ROOT/dist\" >> \"$GITHUB_OUTPUT\"\n79\t          fi\n80\t          echo \"Detected Python layout: root=$PYTHON_ROOT, multi_language=$MULTI_LANGUAGE\"\n81\t\n82\t      - name: Detect changes\n83\t        id: changes\n84\t        env:\n85\t          GITHUB_EVENT_NAME: ${{ github.event_name }}\n86\t          GITHUB_BASE_SHA: ${{ github.event.pull_request.base.sha }}\n87\t          GITHUB_HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n88\t        run: python \"${{ steps.python_layout.outputs.root }}/scripts/detect_code_changes.py\"\n89\t\n90\t  # REQUIRED CI CHECKS - All must pass before release\n91\t  # These jobs ensure code quality and tests pass before any release\n92\t\n93\t  # === LINT AND FORMAT CHECK ===\n94\t  # Lint runs independently of changelog check - it's a fast check that should always run\n95\t  # See: https://github.com/link-assistant/hive-mind/pull/1024 for why this dependency was removed\n96\t  lint:\n97\t    name: Lint and Format Check\n98\t    runs-on: ubuntu-latest\n99\t    timeout-minutes: 20\n100\t    needs: [detect-changes]"
