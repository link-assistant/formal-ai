[2026-07-20T17:19:21.970Z] [INFO]           "+/// measured by `experiments/self_hosting_ratchet_replay/replay.py`), so the",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// published share described log volume rather than authored work — in both",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// directions. Version 2 excludes captured artifacts.",
[2026-07-20T17:19:21.970Z] [INFO]           "+///",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// Rows measured under different definitions are not comparable, so the ratchet",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// and the trailing window only ever look at rows of the *same* version. A",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// definition change therefore starts a new epoch instead of silently averaging",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// two different quantities.",
[2026-07-20T17:19:21.970Z] [INFO]           "+const METRIC_VERSION: u64 = 2;",
[2026-07-20T17:19:21.970Z] [INFO]           "+",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// File extensions whose content is captured, not authored: CI run logs, agent",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// transcripts, saved diffs and process output. Committing them is deliberate",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// (they are the evidence bundles this repository requires), but they are not",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// release work and must not move the metric.",
[2026-07-20T17:19:21.970Z] [INFO]           "+const CAPTURED_ARTIFACT_EXTENSIONS: &[&str] =",
[2026-07-20T17:19:21.970Z] [INFO]           "+    &[\"log\", \"jsonl\", \"diff\", \"patch\", \"stderr\", \"stdout\"];",
[2026-07-20T17:19:21.970Z] [INFO]           "+",
[2026-07-20T17:19:21.970Z] [INFO]           "+/// Dependency lockfiles: written by a package manager, never hand-authored.",
[2026-07-20T17:19:21.970Z] [INFO]           "+const LOCKFILE_NAMES: &[&str] = &[",
[2026-07-20T17:19:21.970Z] [INFO]           "+    \"Cargo.lock\",",
