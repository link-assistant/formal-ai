[2026-07-20T17:52:12.130Z] [INFO]         "type": "tool_result",
[2026-07-20T17:52:12.130Z] [INFO]         "content": "1\t#!/usr/bin/env bash\n2\t# simulate-fresh-merge.sh\n3\t#\n4\t# Simulates a fresh merge of the current PR branch with the latest base branch.\n5\t# This ensures CI checks run against the actual merge result, not a stale merge preview.\n6\t#\n7\t# Usage:\n8\t#   BASE_REF=main bash scripts/simulate-fresh-merge.sh\n9\t#\n10\t# Environment variables:\n11\t#   BASE_REF  The base branch to merge with (e.g. \"main\"). Required.\n12\t#\n13\t# Exit code 0 = merge succeeded or not needed; non-zero = merge conflict detected.\n14\t#\n15\t# Adopted verbatim from link-foundation/js-ai-driven-development-pipeline-template\n16\t# (issue #808 / R3). GitHub checks out `refs/pull/N/merge`, a merge preview\n17\t# computed when the PR was last synced -- it does NOT include commits pushed to\n18\t# the base branch afterwards. A PR can therefore be green against a base that no\n19\t# longer exists and break `main` on merge.\n20\t\n21\tset -euo pipefail\n22\t\n23\techo \"=== Synchronizing PR with latest $BASE_REF ===\"\n24\techo \"This prevents stale merge preview issues (a green PR that breaks main)\"\n25\techo \"\"\n26\t\n27\t# Configure git for merge\n28\tgit config user.email \"github-actions[bot]@users.noreply.github.com\"\n29\tgit config user.name \"github-actions[bot]\"\n30\t\n31\t# Fetch the latest base branch\n32\techo \"Fetching latest $BASE_REF...\"\n33\tgit fetch origin \"$BASE_REF\"\n34\t\n35\t# Get current and base branch info\n36\tCURRENT_SHA=$(git rev-parse HEAD)\n37\tBASE_SHA=$(git rev-parse \"origin/$BASE_REF\")\n38\t\n39\techo \"Current checkout (merge preview): $CURRENT_SHA\"\n40\techo \"Latest base branch ($BASE_REF): $BASE_SHA\"\n41\techo \"\"\n42\t\n43\t# Check if base branch has new commits not in the merge preview\n44\tBEHIND_COUNT=$(git rev-list --count HEAD..origin/$BASE_REF)\n45\t\n46\tif [ \"$BEHIND_COUNT\" -eq 0 ]; then\n47\t  echo \"Merge preview is up-to-date with $BASE_REF. No simulation needed.\"\n48\telse\n49\t  echo \"Base branch has $BEHIND_COUNT new commit(s) since PR was opened/synced.\"\n50\t  echo \"Simulating fresh merge to validate actual merge result...\"\n51\t  echo \"\"\n52\t\n53\t  # Attempt to merge the latest base branch\n54\t  if git merge origin/$BASE_REF --no-edit; then\n55\t    echo \"\"\n56\t    echo \"Fresh merge simulation successful!\"\n57\t    echo \"Checks will now run against the up-to-date merged state.\"\n58\t  else\n59\t    echo \"\"\n60\t    echo \"::error::Merge conflict detected! PR needs to be rebased/updated before it can be merged.\"\n61\t    echo \"The PR branch is out of sync with $BASE_REF and cannot be automatically merged.\"\n62\t    exit 1\n63\t  fi\n64\tfi\n65\techo \"\"\n66\t"
[2026-07-20T17:52:12.130Z] [INFO]       }
