[2026-07-20T17:23:31.668Z] [INFO]           " ",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// The trailing share a release cut at `until` would record.",
[2026-07-20T17:23:31.668Z] [INFO]           "+///",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// Same arithmetic `record_release_with_policy` performs, without writing",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// anything, so a pull request can be told what its merge would do to the",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// ratchet while its commits can still be amended.",
[2026-07-20T17:23:31.668Z] [INFO]           "+pub fn project_trailing_basis_points(",
[2026-07-20T17:23:31.668Z] [INFO]           "+    repo: &Path,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    ledger: &Path,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    since: &str,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    until: &str,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    trailing_window: usize,",
[2026-07-20T17:23:31.668Z] [INFO]           "+) -> Result<u64, String> {",
[2026-07-20T17:23:31.668Z] [INFO]           "+    if trailing_window == 0 {",
[2026-07-20T17:23:31.668Z] [INFO]           "+        return Err(\"trailing window must be greater than zero\".to_owned());",
[2026-07-20T17:23:31.668Z] [INFO]           "+    }",
[2026-07-20T17:23:31.668Z] [INFO]           "+    let measurement = measure_with_policy(repo, since, until, EvidencePolicy::Lenient)?;",
[2026-07-20T17:23:31.668Z] [INFO]           "+    let rows = read_release_rows(ledger)?;",
[2026-07-20T17:23:31.668Z] [INFO]           "+    let mut window_rows = rows",
[2026-07-20T17:23:31.668Z] [INFO]           "+        .iter()",
[2026-07-20T17:23:31.668Z] [INFO]           "+        .filter(|row| row.metric_version == METRIC_VERSION)",
[2026-07-20T17:23:31.668Z] [INFO]           "+        .rev()",
[2026-07-20T17:23:31.668Z] [INFO]           "+        .take(trailing_window.saturating_sub(1))",
[2026-07-20T17:23:31.668Z] [INFO]           "+        .cloned()",
[2026-07-20T17:23:31.668Z] [INFO]           "+        .collect::<Vec<_>>();",
[2026-07-20T17:23:31.668Z] [INFO]           "+    window_rows.reverse();",
[2026-07-20T17:23:31.668Z] [INFO]           "+    window_rows.push(ReleaseRow {",
[2026-07-20T17:23:31.668Z] [INFO]           "+        metric_version: METRIC_VERSION,",
[2026-07-20T17:23:31.668Z] [INFO]           "+        tag: String::new(),",
[2026-07-20T17:23:31.668Z] [INFO]           "+        since: since.to_owned(),",
[2026-07-20T17:23:31.668Z] [INFO]           "+        until: until.to_owned(),",
[2026-07-20T17:23:31.668Z] [INFO]           "+        self_authored_lines: measurement.self_authored_lines,",
[2026-07-20T17:23:31.668Z] [INFO]           "+        changed_lines: measurement.changed_lines,",
[2026-07-20T17:23:31.668Z] [INFO]           "+        self_authored_commits: measurement.self_authored_commits,",
[2026-07-20T17:23:31.668Z] [INFO]           "+        commits: measurement.commits,",
[2026-07-20T17:23:31.668Z] [INFO]           "+        percentage_basis_points: measurement.percentage_basis_points,",
[2026-07-20T17:23:31.668Z] [INFO]           "+        trailing_window,",
[2026-07-20T17:23:31.668Z] [INFO]           "+        trailing_percentage_basis_points: 0,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    });",
[2026-07-20T17:23:31.668Z] [INFO]           "+    Ok(weighted_percentage(&window_rows))",
[2026-07-20T17:23:31.668Z] [INFO]           "+}",
[2026-07-20T17:23:31.668Z] [INFO]           "+",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// Whether merging `head` would lower the share the next release records.",
[2026-07-20T17:23:31.668Z] [INFO]           "+///",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// The comparison is *differential*: the projection including `head` against the",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// projection for `base` alone. An absolute threshold would repeat the issue",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// #812 outage in a new place — a regression already merged into `main` would",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// then fail every subsequent pull request, none of which could fix it. A",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// pull request is only answerable for its own delta, and a no-op pull request",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// is always neutral.",
[2026-07-20T17:23:31.668Z] [INFO]           "+///",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// `since` is the last tag in the ledger, so the projected range is the one the",
[2026-07-20T17:23:31.668Z] [INFO]           "+/// release will actually measure. Returns the message when the share falls.",
[2026-07-20T17:23:31.668Z] [INFO]           "+pub fn ratchet_check(",
[2026-07-20T17:23:31.668Z] [INFO]           "+    repo: &Path,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    ledger: &Path,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    base: &str,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    head: &str,",
[2026-07-20T17:23:31.668Z] [INFO]           "+    trailing_window: usize,",
[2026-07-20T17:23:31.668Z] [INFO]           "+) -> Result<Option<String>, String> {",
[2026-07-20T17:23:31.668Z] [INFO]           "+    let Some(since) = read_release_rows(ledger)?.last().map(|row| row.tag.clone()) else {",
[2026-07-20T17:23:31.668Z] [INFO]           "+        // No release has ever been recorded: there is no ratchet to fall from.",
[2026-07-20T17:23:31.668Z] [INFO]           "+        return Ok(None);",
[2026-07-20T17:23:31.668Z] [INFO]           "+    };",
[2026-07-20T17:23:31.668Z] [INFO]           "+    let baseline = project_trailing_basis_points(repo, ledger, &since, base, trailing_window)?;",
[2026-07-20T17:23:31.668Z] [INFO]           "+    let candidate = project_trailing_basis_points(repo, ledger, &since, head, trailing_window)?;",
[2026-07-20T17:23:31.668Z] [INFO]           "+    if candidate >= baseline {",
[2026-07-20T17:23:31.668Z] [INFO]           "+        return Ok(None);",
[2026-07-20T17:23:31.668Z] [INFO]           "+    }",
[2026-07-20T17:23:31.668Z] [INFO]           "+    Ok(Some(format!(",
[2026-07-20T17:23:31.668Z] [INFO]           "+        \"merging this branch would lower the projected self-hosting share of the next release from \\",
[2026-07-20T17:23:31.668Z] [INFO]           "+         {} to {}; record Formal-AI-Session and Formal-AI-Evidence trailers on the commits that \\",
[2026-07-20T17:23:31.668Z] [INFO]           "+         Formal AI authored, or split unattributed work out of this branch\",",
[2026-07-20T17:23:31.668Z] [INFO]           "+        format_percentage(baseline),",
[2026-07-20T17:23:31.668Z] [INFO]           "+        format_percentage(candidate),",
[2026-07-20T17:23:31.668Z] [INFO]           "+    )))",
[2026-07-20T17:23:31.668Z] [INFO]           "+}",
[2026-07-20T17:23:31.668Z] [INFO]           "+",
[2026-07-20T17:23:31.668Z] [INFO]           " fn weighted_percentage(rows: &[ReleaseRow]) -> u64 {",
[2026-07-20T17:23:31.668Z] [INFO]           "     let self_authored = rows.iter().map(|row| row.self_authored_lines).sum::<u64>();",
[2026-07-20T17:23:31.668Z] [INFO]           "     let changed = rows.iter().map(|row| row.changed_lines).sum::<u64>();"
[2026-07-20T17:23:31.668Z] [INFO]         ]
[2026-07-20T17:23:31.668Z] [INFO]       }
