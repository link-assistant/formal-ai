[2026-07-20T17:18:42.962Z] [INFO]         "content": "1\t#[allow(clippy::duplicate_mod)]\n2\t#[path = \"../../../scripts/self-hosting-metric.rs\"]\n3\tmod metric_script;\n4\t\n5\tuse std::fs;\n6\tuse std::path::{Path, PathBuf};\n7\tuse std::process::Command;\n8\tuse std::time::{SystemTime, UNIX_EPOCH};\n9\t\n10\tuse links_notation::parse_lino;\n11\t\n12\tfn git(repo: &Path, args: &[&str]) -> String {\n13\t    let output = Command::new(\"git\")\n14\t        .arg(\"-C\")\n15\t        .arg(repo)\n16\t        .args(args)\n17\t        .output()\n18\t        .expect(\"git must run in the metric fixture\");\n19\t    assert!(\n20\t        output.status.success(),\n21\t        \"git {args:?} failed: {}\",\n22\t        String::from_utf8_lossy(&output.stderr)\n23\t    );\n24\t    String::from_utf8(output.stdout)\n25\t        .expect(\"git output must be UTF-8\")\n26\t        .trim()\n27\t        .to_owned()\n28\t}\n29\t\n30\tfn commit(repo: &Path, message: &str) {\n31\t    git(repo, &[\"add\", \".\"]);\n32\t    git(repo, &[\"commit\", \"-m\", message]);\n33\t}\n34\t\n35\tfn fixture_repo() -> PathBuf {\n36\t    let nonce = SystemTime::now()\n37\t        .duration_since(UNIX_EPOCH)\n38\t        .expect(\"clock must be after epoch\")\n39\t        .as_nanos();\n40\t    let repo = std::env::temp_dir().join(format!(\n41\t        \"formal-ai-self-hosting-metric-{}-{nonce}\",\n42\t        std::process::id()\n43\t    ));\n44\t    fs::create_dir_all(repo.join(\"data/meta\")).expect(\"fixture directory must be created\");\n45\t    git(&repo, &[\"init\", \"--quiet\"]);\n46\t    git(&repo, &[\"config\", \"user.name\", \"Metric Fixture\"]);\n47\t    git(&repo, &[\"config\", \"user.email\", \"metric@example.invalid\"]);\n48\t    fs::write(\n49\t        repo.join(\"data/meta/self-hosting-ledger.lino\"),\n50\t        \"self_hosting_ledger\\n  attribution_policy \\\"commit_trailers\\\"\\n  session_trailer \\\n51\t         \\\"Formal-AI-Session\\\"\\n  evidence_trailer \\\"Formal-AI-Evidence\\\"\\n  line_unit \\\n52\t         \\\"added_and_deleted\\\"\\n  default_trailing_window \\\"3\\\"\\n\",\n53\t    )\n54\t    .expect(\"fixture ledger must be written\");\n55\t    fs::write(repo.join(\"code.txt\"), \"base\\n\").expect(\"base file must be written\");\n56\t    commit(&repo, \"fixture baseline\");\n57\t    git(&repo, &[\"tag\", \"v1.0.0\"]);\n58\t    repo\n59\t}\n60\t\n61\t#[test]\n62\tfn recorded_formal_ai_evidence_drives_the_release_metric_and_ratchet() {\n63\t    let repo = fixture_repo();\n64\t    fs::create_dir_all(repo.join(\"docs/evidence\")).expect(\"evidence directory must be created\");\n65\t    fs::write(\n66\t        repo.join(\"docs/evidence/session.txt\"),\n67\t        \"formal-ai session fixture-session\\n\",\n68\t    )\n69\t    .expect(\"session evidence must be written\");\n70\t    fs::write(\n71\t        repo.join(\"formal-ai-code.txt\"),\n72\t        \"generated one\\ngenerated two\\n\",\n73\t    )\n74\t    .expect(\"generated code must be written\");\n75\t    commit(\n76\t        &repo,\n77\t        \"formal ai change\\n\\nFormal-AI-Session: fixture-session\\nFormal-AI-Evidence: \\\n78\t         docs/evidence/session.txt\",\n79\t    );\n80\t    fs::write(repo.join(\"human-code.txt\"), \"human change\\n\").expect(\"human code must be written\");\n81\t    commit(&repo, \"human change\");\n82\t\n83\t    let measurement =\n84\t        metric_script::measure(&repo, \"v1.0.0\", \"HEAD\").expect(\"fixture measurement must succeed\");\n85\t    assert_eq!(measurement.self_authored_lines, 3);\n86\t    assert_eq!(measurement.changed_lines, 4);\n87\t    assert_eq!(measurement.self_authored_commits, 1);\n88\t    assert_eq!(measurement.commits, 2);\n89\t    assert_eq!(measurement.percentage_basis_points, 7_500);\n90\t    assert_eq!(\n91\t        metric_script::format_percentage(measurement.percentage_basis_points),\n92\t        \"75.00%\"\n93\t    );\n94\t\n95\t    let ledger = repo.join(\"data/meta/self-hosting-ledger.lino\");\n96\t    let row = metric_script::record_release(&repo, &ledger, \"v1.1.0\", \"v1.0.0\", \"HEAD\", 3)\n97\t        .expect(\"the first release row must be recorded\");\n98\t    assert_eq!(row.percentage_basis_points, 7_500);\n99\t    assert_eq!(row.trailing_percentage_basis_points, 7_500);\n100\t    assert_eq!(\n101\t        metric_script::record_release(&repo, &ledger, \"v1.1.0\", \"v1.0.0\", \"HEAD\", 3,)\n102\t            .expect(\"recording the identical row must be idempotent\"),\n103\t        row\n104\t    );\n105\t    assert_eq!(\n106\t        metric_script::release_note_for_tag(&ledger, \"v1.1.0\")\n107\t            .expect(\"release note must be rendered\"),\n108\t        \"## Self-hosting\\n\\nFormal AI authored **75.00%** of this release \\\n109\t         (3 of 4 changed lines). The 3-release trailing share is **75.00%**.\"\n110\t    );\n111\t    let ledger_text = fs::read_to_string(&ledger).expect(\"fixture ledger must be readable\");\n112\t    parse_lino(ledger_text.trim()).expect(\"recorded ledger must be canonical Links Notation\");\n113\t\n114\t    fs::write(repo.join(\"second-human-change.txt\"), \"regression\\n\")\n115\t        .expect(\"second human change must be written\");\n116\t    commit(&repo, \"second human change\");\n117\t    let error = metric_script::record_release(&repo, &ledger, \"v1.2.0\", \"HEAD^\", \"HEAD\", 3)\n118\t        .expect_err(\"a falling trailing share must be rejected\");\n119\t    assert!(error.contains(\"ratchet\"), \"unexpected error: {error}\");\n120\t\n121\t    fs::remove_dir_all(repo).expect(\"fixture directory must be removed\");\n122\t}\n123\t\n124\t/// Regression for issue #796: release commit 59650f2b separated its two\n125\t/// trailers with a blank line. Git only treats the last paragraph of a message\n126\t/// as the trailer block, so `%(trailers:key=Formal-AI-Session)` returned\n127\t/// nothing, the metric reported \"must record both\", and Auto Release failed.\n128\t#[test]\n129\tfn trailers_are_recognized_even_when_separated_by_blank_lines() {\n130\t    let repo = fixture_repo();\n131\t    fs::create_dir_all(repo.join(\"docs/evidence\")).expect(\"evidence directory must be created\");\n132\t    fs::write(\n133\t        repo.join(\"docs/evidence/session.txt\"),\n134\t        \"formal-ai session spaced-session\\n\",\n135\t    )\n136\t    .expect(\"session evidence must be written\");\n137\t    fs::write(repo.join(\"formal-ai-code.txt\"), \"generated\\n\").expect(\"code must be written\");\n138\t    commit(\n139\t        &repo,\n140\t        \"formal ai change\\n\\nFormal-AI-Session: spaced-session\\n\\nFormal-AI-Evidence: \\\n141\t         docs/evidence/session.txt\",\n142\t    );\n143\t\n144\t    let measurement =\n145\t        metric_script::measure(&repo, \"v1.0.0\", \"HEAD\").expect(\"measurement must succeed\");\n146\t    assert_eq!(\n147\t        measurement.self_authored_commits, 1,\n148\t        \"a blank line between trailers must not hide the session trailer\"\n149\t    );\n150\t\n151\t    fs::remove_dir_all(repo).expect(\"fixture directory must be removed\");\n152\t}\n153\t\n154\t/// Issue #810: `Auto Release` (run 29737218421) died with \"no committed\n155\t/// Formal-AI-Evidence in 10e65ae2 records session issue-804-claude-20260720\".\n156\t/// The pull-request evidence gate only landed in 39fdef91, *after* that commit\n157\t/// merged, so the malformed record sat permanently inside every\n158\t/// `<last tag>..HEAD` release range: the release could not run, so no tag could\n159\t/// be cut, so the range could never move past it. Recording a release must\n160\t/// therefore degrade to \"not self-authored\" instead of aborting, while the\n161\t/// pull-request gate stays strict.\n162\t#[test]\n163\tfn a_malformed_historical_evidence_record_cannot_deadlock_a_release() {\n164\t    let repo = fixture_repo();\n165\t    fs::create_dir_all(repo.join(\"docs/evidence\")).expect(\"evidence directory must be created\");\n166\t    // Mentions formal-ai, but never names the session it claims to document --\n167\t    // exactly the shape of commit 10e65ae2.\n168\t    fs::write(\n169\t        repo.join(\"docs/evidence/analysis.md\"),\n170\t        \"formal-ai analysis without the session id\\n\",\n171\t    )\n172\t    .expect(\"evidence must be written\");\n173\t    fs::write(repo.join(\"code.txt\"), \"base\\nchanged\\n\").expect(\"code must be written\");\n174\t    commit(\n175\t        &repo,\n176\t        \"formal ai change\\n\\nFormal-AI-Session: orphan-session\\nFormal-AI-Evidence: \\\n177\t         docs/evidence/analysis.md\",\n178\t    );\n179\t\n180\t    let strict = metric_script::measure(&repo, \"v1.0.0\", \"HEAD\");\n181\t    assert!(\n182\t        strict.is_err(),\n183\t        \"the pull-request gate must still reject a malformed evidence record\"\n184\t    );\n185\t\n186\t    let row = metric_script::record_release(\n187\t        &repo,\n188\t        &repo.join(\"data/meta/self-hosting-ledger.lino\"),\n189\t        \"v1.1.0\",\n190\t        \"v1.0.0\",\n191\t        \"HEAD\",\n192\t        3,\n193\t    )\n194\t    .expect(\"a release must not be blocked by an immutable malformed commit\");\n195\t    assert_eq!(\n196\t        row.self_authored_commits, 0,\n197\t        \"an unverifiable commit must not be counted as self-authored\"\n198\t    );\n199\t    assert_eq!(\n200\t        row.commits, 1,\n201\t        \"the commit must still count toward total changed work\"\n202\t    );\n203\t\n204\t    fs::remove_dir_all(repo).expect(\"fixture directory must be removed\");\n205\t}\n206\t\n207\t#[test]\n208\tfn release_pipeline_and_ledger_remain_pinned_to_the_metric() {\n209\t    let root = Path::new(env!(\"CARGO_MANIFEST_DIR\"));\n210\t    let workflow = fs::read_to_string(root.join(\".github/workflows/release.yml\"))\n211\t        .expect(\"release workflow must be readable\");\n212\t    let version_script = fs::read_to_string(root.join(\"scripts/version-and-commit.rs\"))\n213\t        .expect(\"version script must be readable\");\n214\t    let release_script = fs::read_to_string(root.join(\"scripts/create-github-release.rs\"))\n215\t        .expect(\"release script must be readable\");\n216\t    let ledger = fs::read_to_string(root.join(\"data/meta/self-hosting-ledger.lino\"))\n217\t        .expect(\"self-hosting ledger must be readable\");\n218\t\n219\t    assert!(workflow.contains(\"--self-hosting-ledger\"));\n220\t    assert!(version_script.contains(\"self-hosting-metric.rs\"));\n221\t    assert!(release_script.contains(\"## Self-hosting\"));\n222\t    assert!(ledger.contains(\"tag \\\"v0.296.0\\\"\"));\n223\t    assert!(ledger.contains(\"percentage_basis_points \\\"0\\\"\"));\n224\t}\n225\t"
