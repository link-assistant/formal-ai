fferent definitions are not comparable, so the ratchet\n635\t+/// and the trailing window only ever look at rows of the *same* version. A\n636\t+/// definition change therefore starts a new epoch instead of silently averaging\n637\t+/// two different quantities.\n638\t+const METRIC_VERSION: u64 = 2;\n639\t+\n640\t+/// File extensions whose content is captured, not authored: CI run logs, agent\n641\t+/// transcripts, saved diffs and process output. Committing them is deliberate\n642\t+/// (they are the evidence bundles this repository requires), but they are not\n643\t+/// release work and must not move the metric.\n644\t+const CAPTURED_ARTIFACT_EXTENSIONS: &[&str] =\n645\t+    &[\"log\", \"jsonl\", \"diff\", \"patch\", \"stderr\", \"stdout\"];\n646\t+\n647\t+/// Dependency lockfiles: written by a package manager, never hand-authored.\n648\t+const LOCKFILE_NAMES: &[&str] = &[\n649\t+    \"Cargo.lock\",\n650\t+    \"bun.lock\",\n651\t+    \"package-lock.json\",\n652\t+    \"yarn.lock\",\n653\t+    \"pnpm-lock.yaml\",\n654\t+    \"poetry.lock\",\n655\t+    \"uv.lock\",\n656\t+];\n657\t+\n658\t #[derive(Clone, Debug, Eq, PartialEq)]\n659\t pub struct Measurement {\n660\t     pub self_authored_lines: u64,\n661\t@@ -34,6 +68,9 @@ pub struct Measurement {\n662\t \n663\t #[derive(Clone, Debug, Eq, PartialEq)]\n664\t pub struct ReleaseRow {\n665\t+    /// Measurement epoch this row was produced under; see [`METRIC_VERSION`].\n666\t+    /// Rows written before issue #812 carry no field and read back as `1`.\n667\t+    pub metric_version: u64,\n668\t     pub tag: String,\n669\t     pub since: String,\n670\t     pub until: String,\n671\t@@ -126,6 +163,26 @@ pub fn measure_with_policy(\n672\t     })\n673\t }\n674\t \n675\t+/// Whether a path holds captured output rather than authored work.\n676\t+///\n677\t+/// Applied symmetrically to the numerator and the denominator, so a commit that\n678\t+/// only files evidence contributes nothing either way and the share it reports\n679\t+/// is unchanged by how much log volume happened to be attached to it.\n680\t+pub fn is_non_authored_path(path: &str) -> bool {\n681\t+    // `git show --numstat` C-quotes any path with non-printable or non-ASCII\n682\t+    // bytes, so the raw field can arrive wrapped in double quotes.\n683\t+    let path = path.trim().trim_matches('\"');\n684\t+    let name = path.rsplit('/').next().unwrap_or(path);\n685\t+    if LOCKFILE_NAMES.contains(&name) {\n686\t+        return true;\n687\t+    }\n688\t+    name.rsplit_once('.').is_some_and(|(_, extension)| {\n689\t+        CAPTURED_ARTIFACT_EXTENSIONS\n690\t+            .iter()\n691\t+            .any(|candidate| extension.eq_ignore_ascii_case(candidate))\n692\t+    })\n693\t+}\n694\t+\n695\t fn changed_lines_for_commit(repo: &Path, commit: &str) -> Result<u64, String> {\n696\t     let output = git(\n697\t         repo,\n698\t@@ -135,9 +192,13 @@ fn changed_lines_for_commit(repo: &Path, commit: &str) -> Result<u64, String> {\n699\t         let mut fields = line.split('\\t');\n700\t         let additions = fields.next().unwrap_or_default();\n701\t         let deletions = fields.next().unwrap_or_default();\n702\t+        let path = fields.next().unwrap_or_default();\n703\t         if additions == \"-\" || deletions == \"-\" {\n704\t             return Ok(total);\n705\t         }\n706\t+        if is_non_authored_path(path) {\n707\t+            return Ok(total);\n708\t+        }\n709\t         let additions = additions\n710\t             .parse::<u64>()\n711\t             .map_err(|error| format!(\"invalid numstat additions in {commit}: {error}\"))?;\n712\t@@ -241,6 +302,32 @@ fn percentage_basis_points(numerator: u64, denominator: u64) -> u64 {\n713\t     u64::try_from(rounded).expect(\"percentage basis points fit in u64\")\n714\t }\n715\t \n716\t+/// What a falling trailing share does to the caller.\n717\t+///\n718\t+/// Issue #812: `Auto Release` on `main` died with \"self-hosting ratchet would\n719\t+/// fall from 32.68% to 18.24% for v0.301.0\" (run 29751001867, log line 23918).\n720\t+/// That check runs *after* every contributing commit is already immutable\n721\t+/// history on the default branch, so nothing anybody can do makes it pass, and\n722\t+/// the only way to move the measured range forward — cutting a tag — is exactly\n723\t+/// what it blocks. It is the same shape of permanent outage as issue #810's\n724\t+/// evidence deadlock, and the third release outage in a row (#796, #810, #812)\n725\t+/// caused by enforcing a policy where the policy is not actionable.\n726\t+///\n727\t+/// So enforcement moves to where a contributor can still act on it:\n728\t+///\n729\t+/// - `Enforce` — the pull-request gate (`Self-Hosting Evidence Check` in\n730\t+///   `.github/workflows/release.yml`, via `--check-ratchet`). A fall is a hard\n731\t+///   error while the commits that cause it can still be amended.\n732\t+/// - `Report` — release recording. The row is appended exactly as measured, the\n733\t+///   fall is announced on stderr and as a GitHub `::warning` annotation, and the\n734\t+///   release ships. The ledger records the regression honestly instead of\n735\t+///   hiding it behind a job that never completes.\n736\t+#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n737\t+pub enum RatchetPolicy {\n738\t+    Enforce,\n739\t+    Report,"
