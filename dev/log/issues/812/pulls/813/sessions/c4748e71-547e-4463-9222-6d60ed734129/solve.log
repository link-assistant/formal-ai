[2026-07-20T17:48:51.557Z] [INFO]         "content": "124\t  evidence-check:\n125\t    name: Self-Hosting Evidence Check\n126\t    runs-on: ubuntu-latest\n127\t    timeout-minutes: 10\n128\t    if: github.event_name == 'pull_request'\n129\t    steps:\n130\t      - uses: actions/checkout@v6\n131\t        with:\n132\t          fetch-depth: 0\n133\t\n134\t      - name: Setup Rust\n135\t        uses: dtolnay/rust-toolchain@stable\n136\t\n137\t      - name: Install rust-script\n138\t        run: bash scripts/install-rust-script.sh\n139\t\n140\t      - name: Validate Formal-AI trailers on this pull request\n141\t        env:\n142\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n143\t        run: |\n144\t          set -euo pipefail\n145\t          base=\"origin/${GITHUB_BASE_REF}\"\n146\t          merge_base=\"$(git merge-base \"$base\" HEAD)\"\n147\t          echo \"Validating commits in ${merge_base}..HEAD\"\n148\t          rust-script scripts/self-hosting-metric.rs --since \"$merge_base\" --until HEAD\n149\t\n150\t      # Issue #812: `Auto Release` died on main with \"self-hosting ratchet would\n151\t      # fall from 32.68% to 18.24% for v0.301.0\" -- after every contributing\n152\t      # commit was already immutable, and while the only way to move the measured\n153\t      # range forward (cutting a tag) was what it blocked. Enforcement belongs\n154\t      # here, where the commits can still be amended. The check is differential:\n155\t      # it compares the release share projected *with* this branch against the\n156\t      # one projected for the base alone, so a regression already on main cannot\n157\t      # block unrelated pull requests.\n158\t      - name: Check the self-hosting ratchet against the merge base\n159\t        env:\n160\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n161\t        run: |\n162\t          set -euo pipefail\n163\t          base=\"origin/${GITHUB_BASE_REF}\"\n164\t          rust-script scripts/self-hosting-metric.rs --check-ratchet \"$base\" --until HEAD\n165\t\n166\t  # === DOCKER IMAGE CHECK ===\n167\t  # Issue #808: the Dockerfile was only ever built inside `auto-release` /\n168\t  # `manual-release`, i.e. after the crate had already been published to\n169\t  # crates.io. A broken Dockerfile therefore produced a half-finished release\n170\t  # (crate published, no image, no GitHub Release) and could not be caught\n171\t  # before merge. scripts/verify-docker-runtime.sh, which the image installs as\n172\t  # `verify-formal-ai-dind`, had no caller in CI at all. This job builds the\n173\t  # image without pushing and runs that verifier inside it, so both the build\n174\t  # and the runtime contract gate the pull request.\n175\t  docker-build:\n176\t    name: Docker Image Build & Runtime Check\n177\t    runs-on: ubuntu-latest\n178\t    # The image compiles the crate in a builder stage; 30 minutes is not enough\n179\t    # on a cold layer cache.\n180\t    timeout-minutes: 60\n181\t    needs: [detect-changes]\n182\t    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n183\t    steps:"
