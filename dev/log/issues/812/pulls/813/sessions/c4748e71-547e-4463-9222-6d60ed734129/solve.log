[2026-07-20T17:52:46.749Z] [INFO]           "           # is the whole point of the dry run.",
[2026-07-20T17:52:46.749Z] [INFO]           "           ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}",
[2026-07-20T17:52:46.749Z] [INFO]           "+          # Quoted '0'/'1': GitHub's `&&`/`||` treat the number 0 as falsy, so an",
[2026-07-20T17:52:46.749Z] [INFO]           "+          # unquoted 0 here would silently select the other branch.",
[2026-07-20T17:52:46.749Z] [INFO]           "+          # 0 is needed by simulate-fresh-merge.sh, which merges origin/<base>.",
[2026-07-20T17:52:46.749Z] [INFO]           "+          fetch-depth: ${{ github.event_name == 'pull_request' && '0' || '1' }}",
[2026-07-20T17:52:46.749Z] [INFO]           " ",
[2026-07-20T17:52:46.749Z] [INFO]           "+      # Issue #812: `release.yml` simulates the fresh merge in `lint` and `test`,",
[2026-07-20T17:52:46.749Z] [INFO]           "+      # but this workflow -- the only one that packages the desktop app -- did",
[2026-07-20T17:52:46.749Z] [INFO]           "+      # not, so the packaging dry run validated the PR head against a merge",
[2026-07-20T17:52:46.749Z] [INFO]           "+      # preview that predates any commit pushed to the base branch since the last",
[2026-07-20T17:52:46.749Z] [INFO]           "+      # sync. A packaging break introduced by a concurrent main commit stayed",
[2026-07-20T17:52:46.749Z] [INFO]           "+      # invisible until after the merge, which is how desktop breakages have",
[2026-07-20T17:52:46.749Z] [INFO]           "+      # reached tags before.",
[2026-07-20T17:52:46.749Z] [INFO]           "+      - name: Simulate fresh merge with base branch (PR only)",
[2026-07-20T17:52:46.749Z] [INFO]           "+        if: github.event_name == 'pull_request'",
[2026-07-20T17:52:46.749Z] [INFO]           "+        env:",
[2026-07-20T17:52:46.749Z] [INFO]           "+          BASE_REF: ${{ github.base_ref }}",
[2026-07-20T17:52:46.749Z] [INFO]           "+        run: bash scripts/simulate-fresh-merge.sh",
[2026-07-20T17:52:46.749Z] [INFO]           "+",
[2026-07-20T17:52:46.749Z] [INFO]           "       - name: Install Rust toolchain",
[2026-07-20T17:52:46.749Z] [INFO]           "         uses: dtolnay/rust-toolchain@stable",
[2026-07-20T17:52:46.749Z] [INFO]           " "
[2026-07-20T17:52:46.749Z] [INFO]         ]
[2026-07-20T17:52:46.749Z] [INFO]       }
