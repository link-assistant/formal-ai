[2026-07-20T17:22:54.879Z] [INFO]         "content": "300\t    let rounded =\n301\t        (u128::from(numerator) * 10_000 + u128::from(denominator) / 2) / u128::from(denominator);\n302\t    u64::try_from(rounded).expect(\"percentage basis points fit in u64\")\n303\t}\n304\t\n305\t/// What a falling trailing share does to the caller.\n306\t///\n307\t/// Issue #812: `Auto Release` on `main` died with \"self-hosting ratchet would\n308\t/// fall from 32.68% to 18.24% for v0.301.0\" (run 29751001867, log line 23918).\n309\t/// That check runs *after* every contributing commit is already immutable\n310\t/// history on the default branch, so nothing anybody can do makes it pass, and\n311\t/// the only way to move the measured range forward — cutting a tag — is exactly\n312\t/// what it blocks. It is the same shape of permanent outage as issue #810's\n313\t/// evidence deadlock, and the third release outage in a row (#796, #810, #812)\n314\t/// caused by enforcing a policy where the policy is not actionable.\n315\t///\n316\t/// So enforcement moves to where a contributor can still act on it:\n317\t///\n318\t/// - `Enforce` — the pull-request gate (`Self-Hosting Evidence Check` in\n319\t///   `.github/workflows/release.yml`, via `--check-ratchet`). A fall is a hard\n320\t///   error while the commits that cause it can still be amended.\n321\t/// - `Report` — release recording. The row is appended exactly as measured, the\n322\t///   fall is announced on stderr and as a GitHub `::warning` annotation, and the\n323\t///   release ships. The ledger records the regression honestly instead of\n324\t///   hiding it behind a job that never completes.\n325\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n326\tpub enum RatchetPolicy {\n327\t    Enforce,\n328\t    Report,\n329\t}\n330\t\n331\tpub fn record_release(\n332\t    repo: &Path,\n333\t    ledger: &Path,\n334\t    tag: &str,\n335\t    since: &str,\n336\t    until: &str,\n337\t    trailing_window: usize,\n338\t) -> Result<ReleaseRow, String> {\n339\t    record_release_with_policy(\n340\t        repo,\n341\t        ledger,\n342\t        tag,\n343\t        since,\n344\t        until,\n345\t        trailing_window,\n346\t        RatchetPolicy::Enforce,\n347\t    )\n348\t}\n349\t\n350\tpub fn record_release_with_policy(\n351\t    repo: &Path,\n352\t    ledger: &Path,\n353\t    tag: &str,\n354\t    since: &str,\n355\t    until: &str,\n356\t    trailing_window: usize,\n357\t    ratchet: RatchetPolicy,\n358\t) -> Result<ReleaseRow, String> {\n359\t    if trailing_window == 0 {\n360\t        return Err(\"trailing window must be greater than zero\".to_owned());\n361\t    }\n362\t    let all_rows = read_release_rows(ledger)?;\n363\t    // Only rows measured under the current definition are comparable; see\n364\t    // `METRIC_VERSION`. Mixing epochs would average two different quantities.\n365\t    let rows = all_rows\n366\t        .iter()\n367\t        .filter(|row| row.metric_version == METRIC_VERSION)\n368\t        .cloned()\n369\t        .collect::<Vec<_>>();\n370\t    // Lenient on purpose: see `EvidencePolicy`. The pull-request gate is what\n371\t    // keeps new commits honest; a release must never be blocked by a commit\n372\t    // that is already immutable history.\n373\t    let measurement = measure_with_policy(repo, since, until, EvidencePolicy::Lenient)?;\n374\t    let until_commitish = format!(\"{until}^{{commit}}\");\n375\t    let canonical_until = git(repo, &[\"rev-parse\", &until_commitish])?\n376\t        .trim()\n377\t        .to_owned();\n378\t    let mut window_rows = rows\n379\t        .iter()\n380\t        .rev()\n381\t        .take(trailing_window.saturating_sub(1))\n382\t        .cloned()\n383\t        .collect::<Vec<_>>();\n384\t    window_rows.reverse();\n385\t    let mut row = ReleaseRow {\n386\t        metric_version: METRIC_VERSION,\n387\t        tag: tag.to_owned(),\n388\t        since: since.to_owned(),\n389\t        until: canonical_until,\n390\t        self_authored_lines: measurement.self_authored_lines,\n391\t        changed_lines: measurement.changed_lines,\n392\t        self_authored_commits: measurement.self_authored_commits,\n393\t        commits: measurement.commits,\n394\t        percentage_basis_points: measurement.percentage_basis_points,\n395\t        trailing_window,\n396\t        trailing_percentage_basis_points: 0,\n397\t    };\n398\t    window_rows.push(row.clone());\n399\t    row.trailing_percentage_basis_points = weighted_percentage(&window_rows);\n400\t\n401\t    // Idempotency is checked against the whole ledger, not just this epoch: a\n402\t    // tag must never be recorded twice, whatever definition produced it.\n403\t    if let Some(existing) = all_rows.iter().find(|existing| existing.tag == tag) {\n404\t        if existing == &row {\n405\t            return Ok(existing.clone());\n406\t        }\n407\t        return Err(format!(\n408\t            \"release {tag} already has a different self-hosting ledger row\"\n409\t        ));\n410\t    }\n411\t    if let Some(regression) = ratchet_regression(rows.last(), &row) {\n412\t        match ratchet {\n413\t            RatchetPolicy::Enforce => return Err(regression),\n414\t            RatchetPolicy::Report => {\n415\t                eprintln!(\"warning: {regression}\");\n416\t                println!(\"::warning title=Self-hosting ratchet fell::{regression}\");\n417\t            }\n418\t        }\n419\t    }\n420\t    append_release_row(ledger, &row)?;\n421\t    Ok(row)\n422\t}\n423\t\n424\t/// The ratchet message when `row` regresses against `previous`, else `None`.\n425\tfn ratchet_regression(previous: Option<&ReleaseRow>, row: &ReleaseRow) -> Option<String> {\n426\t    let previous = previous?;\n427\t    if row.trailing_percentage_basis_points >= previous.trailing_percentage_basis_points {\n428\t        return None;\n429\t    }\n430\t    Some(format!(\n431\t        \"self-hosting ratchet would fall from {} to {} for {}\",\n432\t        format_percentage(previous.trailing_percentage_basis_points),\n433\t        format_percentage(row.trailing_percentage_basis_points),\n434\t        row.tag\n435\t    ))\n436\t}\n437\t\n438\tfn weighted_percentage(rows: &[ReleaseRow]) -> u64 {\n439\t    let self_authored = rows.iter().map(|row| row.self_authored_lines).sum::<u64>();"
