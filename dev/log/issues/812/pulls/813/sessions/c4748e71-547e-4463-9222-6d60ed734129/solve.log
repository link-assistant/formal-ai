[2026-07-20T17:40:56.664Z] [INFO]           " # The script is wrapped in main() and only invoked on the final line so a",
[2026-07-20T17:40:56.664Z] [INFO]           " # truncated download (the classic curl|sh hazard) never executes a partial body.",
[2026-07-20T17:40:56.664Z] [INFO]           " #",
[2026-07-20T17:40:56.664Z] [INFO]           "-# Issue #812: this was the only script in the repository without `pipefail`,",
[2026-07-20T17:40:56.664Z] [INFO]           "-# so a failure in the left-hand side of any pipeline here (curl into a checksum",
[2026-07-20T17:40:56.664Z] [INFO]           "-# reader, for instance) was silently swallowed. Every other scripts/*.sh sets",
[2026-07-20T17:40:56.664Z] [INFO]           "-# the full strict mode; POSIX `sh` does not define `pipefail`, so switch to",
[2026-07-20T17:40:56.664Z] [INFO]           "-# bash, which the shebang already selects.",
[2026-07-20T17:40:56.664Z] [INFO]           "-set -euo pipefail",
[2026-07-20T17:40:56.664Z] [INFO]           "+# Issue #812 asked why this is the only script in the repository without",
[2026-07-20T17:40:56.664Z] [INFO]           "+# `pipefail`: because it is the only one that runs under `#!/usr/bin/env sh`.",
[2026-07-20T17:40:56.664Z] [INFO]           "+# `pipefail` is a bash/ksh extension, not POSIX, and `set -o pipefail` aborts",
[2026-07-20T17:40:56.664Z] [INFO]           "+# dash -- the `/bin/sh` on Debian and Ubuntu -- which is exactly the shell a",
[2026-07-20T17:40:56.664Z] [INFO]           "+# `curl … | sh` install lands in. Portability wins here; every pipeline below",
[2026-07-20T17:40:56.664Z] [INFO]           "+# is written so its exit status comes from the rightmost command deliberately.",
[2026-07-20T17:40:56.664Z] [INFO]           "+set -eu",
[2026-07-20T17:40:56.664Z] [INFO]           " ",
[2026-07-20T17:40:56.664Z] [INFO]           " REPO=\"link-assistant/formal-ai\"",
[2026-07-20T17:40:56.664Z] [INFO]           " API_LATEST=\"https://api.github.com/repos/${REPO}/releases/latest\""
