[2026-07-20T17:14:39.930Z] [INFO]           "command": "python3 - <<'EOF'\nimport subprocess\ndef git(*a): return subprocess.run([\"git\",*a],capture_output=True,text=True,check=True).stdout\nSESSION=\"formal-ai-session:\"; EVID=\"formal-ai-evidence:\"\ndef trailers(c,k):\n    out=[]\n    for line in git(\"show\",\"-s\",\"--format=%B\",c).splitlines():\n        line=line.strip()\n        if line[:len(k)].lower()==k:\n            v=line[len(k):].strip()\n            if v: out.append(v)\n    return out\ndef attributed(c):\n    s=trailers(c,SESSION); e=trailers(c,EVID)\n    if not s or not e: return False\n    ev=[]\n    for p in e:\n        try: ev.append(git(\"show\",f\"{c}:{p}\"))\n        except Exception: return False\n    return all(any(x in v for v in ev) for x in s) and all(\"formal-ai\" in v.lower() for v in ev)\n\nEXCLUDE_PREFIXES=(\"dev/log/\",)\nLOCKFILES={\"Cargo.lock\",\"bun.lock\",\"package-lock.json\",\"desktop/bun.lock\",\"vscode/bun.lock\"}\ndef lines(c, exclude):\n    t=0\n    for line in git(\"show\",\"--format=\",\"--numstat\",\"--no-renames\",c).splitlines():\n        f=line.split(\"\\t\")\n        if len(f)<3 or f[0]==\"-\" or f[1]==\"-\": continue\n        p=f[2]\n        if exclude and (p.startswith(EXCLUDE_PREFIXES) or p in LOCKFILES): continue\n        t+=int(f[0])+int(f[1])\n    return t\n\ndef measure(since,until,exclude):\n    cs=[c for c in git(\"rev-list\",\"--reverse\",\"--no-merges\",f\"{since}..{until}\").split() if c]\n    tot=sa=0; nc=0\n    for c in cs:\n        n=lines(c,exclude); tot+=n\n        if attributed(c): sa+=n; nc+=1\n    bp=(sa*10000+tot//2)//tot if tot else 0\n    return sa,tot,bp,nc,len(cs)\n\nfor exclude in (False,True):\n    print(\"=== exclude dev/log+lockfiles:\",exclude)\n    rows=[]\n    for since,until,tag in ((\"v0.299.0\",\"v0.300.0\",\"v0.300.0\"),(\"v0.298.1\",\"v0.299.0\",\"v0.299.0\"),(\"v0.300.0\",\"origin/main\",\"v0.301.0\")):\n        sa,tot,bp,nc,n=measure(since,until,exclude)\n        print(f\"  {tag}: {sa}/{tot} = {bp/100:.2f}%  ({nc}/{n} commits)\")\n        rows.append((tag,sa,tot))\n    # trailing window of 3 = last three\n    w=[r for r in rows if r[0] in (\"v0.299.0\",\"v0.300.0\",\"v0.301.0\")]\n    sa=sum(r[1] for r in w); tot=sum(r[2] for r in w)\n    print(f\"  trailing3(v0.301.0) = {(sa*10000+tot//2)//tot/100:.2f}%\")\nEOF",
