[2026-07-20T17:20:22.515Z] [INFO]         "lines": [
[2026-07-20T17:20:22.515Z] [INFO]           "             \"release {tag} already has a different self-hosting ledger row\"",
[2026-07-20T17:20:22.515Z] [INFO]           "         ));",
[2026-07-20T17:20:22.515Z] [INFO]           "     }",
[2026-07-20T17:20:22.515Z] [INFO]           "-    if let Some(previous) = rows.last() {",
[2026-07-20T17:20:22.515Z] [INFO]           "-        if row.trailing_percentage_basis_points < previous.trailing_percentage_basis_points {",
[2026-07-20T17:20:22.515Z] [INFO]           "-            return Err(format!(",
[2026-07-20T17:20:22.515Z] [INFO]           "-                \"self-hosting ratchet would fall from {} to {} for {tag}\",",
[2026-07-20T17:20:22.515Z] [INFO]           "-                format_percentage(previous.trailing_percentage_basis_points),",
[2026-07-20T17:20:22.515Z] [INFO]           "-                format_percentage(row.trailing_percentage_basis_points)",
[2026-07-20T17:20:22.515Z] [INFO]           "-            ));",
[2026-07-20T17:20:22.515Z] [INFO]           "+    if let Some(regression) = ratchet_regression(rows.last(), &row) {",
[2026-07-20T17:20:22.515Z] [INFO]           "+        match ratchet {",
[2026-07-20T17:20:22.515Z] [INFO]           "+            RatchetPolicy::Enforce => return Err(regression),",
[2026-07-20T17:20:22.515Z] [INFO]           "+            RatchetPolicy::Report => {",
[2026-07-20T17:20:22.515Z] [INFO]           "+                eprintln!(\"warning: {regression}\");",
[2026-07-20T17:20:22.515Z] [INFO]           "+                println!(\"::warning title=Self-hosting ratchet fell::{regression}\");",
[2026-07-20T17:20:22.515Z] [INFO]           "+            }",
[2026-07-20T17:20:22.515Z] [INFO]           "         }",
[2026-07-20T17:20:22.515Z] [INFO]           "     }",
[2026-07-20T17:20:22.515Z] [INFO]           "     append_release_row(ledger, &row)?;",
[2026-07-20T17:20:22.515Z] [INFO]           "     Ok(row)",
[2026-07-20T17:20:22.515Z] [INFO]           " }",
[2026-07-20T17:20:22.515Z] [INFO]           " ",
[2026-07-20T17:20:22.515Z] [INFO]           "+/// The ratchet message when `row` regresses against `previous`, else `None`.",
[2026-07-20T17:20:22.515Z] [INFO]           "+fn ratchet_regression(previous: Option<&ReleaseRow>, row: &ReleaseRow) -> Option<String> {",
[2026-07-20T17:20:22.515Z] [INFO]           "+    let previous = previous?;",
[2026-07-20T17:20:22.515Z] [INFO]           "+    if row.trailing_percentage_basis_points >= previous.trailing_percentage_basis_points {",
[2026-07-20T17:20:22.515Z] [INFO]           "+        return None;",
[2026-07-20T17:20:22.515Z] [INFO]           "+    }",
[2026-07-20T17:20:22.515Z] [INFO]           "+    Some(format!(",
[2026-07-20T17:20:22.515Z] [INFO]           "+        \"self-hosting ratchet would fall from {} to {} for {}\",",
[2026-07-20T17:20:22.515Z] [INFO]           "+        format_percentage(previous.trailing_percentage_basis_points),",
[2026-07-20T17:20:22.515Z] [INFO]           "+        format_percentage(row.trailing_percentage_basis_points),",
[2026-07-20T17:20:22.515Z] [INFO]           "+        row.tag",
[2026-07-20T17:20:22.515Z] [INFO]           "+    ))",
[2026-07-20T17:20:22.515Z] [INFO]           "+}",
[2026-07-20T17:20:22.515Z] [INFO]           "+",
[2026-07-20T17:20:22.515Z] [INFO]           " fn weighted_percentage(rows: &[ReleaseRow]) -> u64 {",
[2026-07-20T17:20:22.515Z] [INFO]           "     let self_authored = rows.iter().map(|row| row.self_authored_lines).sum::<u64>();",
[2026-07-20T17:20:22.515Z] [INFO]           "     let changed = rows.iter().map(|row| row.changed_lines).sum::<u64>();"
[2026-07-20T17:20:22.515Z] [INFO]         ]
[2026-07-20T17:20:22.515Z] [INFO]       }
