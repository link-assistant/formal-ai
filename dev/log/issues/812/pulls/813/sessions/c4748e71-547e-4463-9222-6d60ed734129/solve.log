-merge.sh\n72\t \n73\t       - name: Setup Node\n74\t         uses: actions/setup-node@v6\n75\t@@ -538,7 +568,11 @@ jobs:\n76\t           # filename (formal-ai-vscode-<version>.vsix) matches the release\n77\t           # version the /download and /vscode pages resolve.\n78\t           npm run package\n79\t-          vsix=\"$(ls formal-ai-vscode-*.vsix 2>/dev/null | head -n1)\"\n80\t+          # A glob, not `ls | head`: `ls` output is not safe to parse and its\n81\t+          # exit status is swallowed here (shellcheck SC2012).\n82\t+          shopt -s nullglob\n83\t+          vsix_files=(formal-ai-vscode-*.vsix)\n84\t+          vsix=\"${vsix_files[0]:-}\"\n85\t           [ -n \"$vsix\" ] || { echo \"::error::vsce package produced no .vsix\" >&2; exit 1; }\n86\t           echo \"vsix=$vsix\" >> \"$GITHUB_OUTPUT\"\n87\t           echo \"Packaged: $vsix\"\n88\t@@ -585,10 +619,15 @@ jobs:\n89\t   finalize:\n90\t     name: Publish SHA256SUMS.txt + provenance\n91\t     needs: [resolve, build, vscode]\n92\t-    # always() so a partial matrix (one arch failing under fail-fast:false) still\n93\t-    # publishes checksums for the arches that did build.\n94\t+    # !cancelled(), not always(): a partial matrix (one arch failing under\n95\t+    # fail-fast:false) must still publish checksums for the arches that did\n96\t+    # build, but a *cancelled* run must not. The upload below uses\n97\t+    # `gh release upload --clobber`, so under always() a run cancelled part-way\n98\t+    # -- by the concurrency group superseding it, or by hand -- would overwrite a\n99\t+    # complete SHA256SUMS.txt from an earlier successful run with a manifest\n100\t+    # covering whichever one or two arches happened to finish (issue #812).\n101\t     # Never on pull requests: there is no release to publish checksums to.\n102\t-    if: ${{ always() && github.event_name != 'pull_request' && needs.resolve.outputs.should_build == 'true' }}\n103\t+    if: ${{ !cancelled() && github.event_name != 'pull_request' && needs.resolve.outputs.should_build == 'true' }}\n104\t     runs-on: ubuntu-latest\n105\t     timeout-minutes: 10\n106\t     permissions:\n107\tdiff --git a/.github/workflows/release.yml b/.github/workflows/release.yml\n108\tindex dc2da7cf..a820646f 100644\n109\t--- a/.github/workflows/release.yml\n110\t+++ b/.github/workflows/release.yml\n111\t@@ -147,6 +147,22 @@ jobs:\n112\t           echo \"Validating commits in ${merge_base}..HEAD\"\n113\t           rust-script scripts/self-hosting-metric.rs --since \"$merge_base\" --until HEAD\n114\t \n115\t+      # Issue #812: `Auto Release` died on main with \"self-hosting ratchet would\n116\t+      # fall from 32.68% to 18.24% for v0.301.0\" -- after every contributing\n117\t+      # commit was already immutable, and while the only way to move the measured\n118\t+      # range forward (cutting a tag) was what it blocked. Enforcement belongs\n119\t+      # here, where the commits can still be amended. The check is differential:\n120\t+      # it compares the release share projected *with* this branch against the\n121\t+      # one projected for the base alone, so a regression already on main cannot\n122\t+      # block unrelated pull requests.\n123\t+      - name: Check the self-hosting ratchet against the merge base\n124\t+        env:\n125\t+          GITHUB_BASE_REF: ${{ github.base_ref }}\n126\t+        run: |\n127\t+          set -euo pipefail\n128\t+          base=\"origin/${GITHUB_BASE_REF}\"\n129\t+          rust-script scripts/self-hosting-metric.rs --check-ratchet \"$base\" --until HEAD\n130\t+\n131\t   # === DOCKER IMAGE CHECK ===\n132\t   # Issue #808: the Dockerfile was only ever built inside `auto-release` /\n133\t   # `manual-release`, i.e. after the crate had already been published to\n134\t@@ -272,7 +288,11 @@ jobs:\n135\t   lint:\n136\t     name: Lint and Format Check\n137\t     runs-on: ubuntu-latest\n138\t-    timeout-minutes: 10\n139\t+    # Issue #812: this job used to take ~3.3 minutes; it now takes 6.8-7.8 as\n140\t+    # checks accumulated (the last three `main` runs measured 6.7, 6.8, 7.8),\n141\t+    # which is 78% of the old 10-minute cap. Raised before it produces the same\n142\t+    # \"cancelled\" false failure that `test` did in run 29767811026.\n143\t+    timeout-minutes: 15\n144\t     needs: [detect-changes]\n145\t     # Note: a status-check function is required because detect-changes is skipped\n146\t     # on workflow_dispatch; without one the skipped dependency would cascade and\n147\t@@ -329,14 +349,57 @@ jobs:\n148\t           restore-keys: |\n149\t             ${{ runner.os }}-cargo-\n150\t \n151\t+      # Issue #812: nothing validated the workflow definitions themselves, so a\n152\t+      # mistyped `needs.<job>` reference, an undefined output or a malformed\n153\t+      # expression could only be discovered by pushing and watching it fail --\n154\t+      # and expression errors that evaluate to an empty string fail *open*,\n155\t+      # skipping the guarded step with a green check. actionlint type-checks\n156\t+      # `needs`/`steps`/`env` contexts and runs shellcheck over every `run:`\n157\t+      # block. Pinned by version; `.github/actionlint.yaml` declares the runner\n158\t+      # labels newer than this release knows about.\n159\t+      - name: Lint GitHub Actions workflows\n160\t+        env:\n161\t+          ACTIONLINT_VERSION: 1.7.7\n162\t+        run: |\n163\t+          set -euo pipefail\n164\t+          curl -fsSL \\\n165\t+            \"https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz\" \\\n166\t+            | tar xz -C /tmp actionlint\n167\t+          /tmp/actionlint -color\n168\t+\n169\t+      # actionlint only reaches shell embedded in `run:` blocks. The standalone\n170\t+      # scripts those blocks invoke -- install.sh, check-secrets.sh,\n171\t+      # simulate-fresh-merge.sh and the rest -- had no linter at all, which is\n172\t+      # where unquoted expansions and `cd` without a guard live (issue #812).\n173\t+      # `experiments/` is deliberately excluded: those are throwaway\n174\t+      # reproduction scripts, not shipped code.\n175\t+      - name: Lint shell scripts\n176\t+        run: |\n177\t+          set -euo pipefail\n178\t+          mapfile -t scripts < <(\n179\t+            git ls-files '*.sh' \\\n180\t+              | grep -v -e '^experiments/' -e '^dev/log/' -e '^docs/case-studies/'\n181\t+          )\n182\t+          if [ ${#scripts[@]} -eq 0 ]; then\n183\t+            echo \"::error::No shell scripts matched; the lint selector is broken\" >&2\n184\t+            exit 1\n185\t+          fi\n186\t+          printf 'Linting %s shell script(s)\\n' \"${#scripts[@]}\"\n187\t+          shellcheck --severity=warning \"${scripts[@]}\"\n188\t+\n189\t       - name: Check formatting\n190\t         run: cargo fmt --all -- --check\n191\t \n192\t       - name: Verify Cargo.lock is synchronized\n193\t         run: cargo metadata --locked --format-version 1 > /dev/null\n194\t \n195\t+      # `-D warnings` is required, not optional: every lint in `[lints.clippy]`\n196\t+      # of Cargo.toml is set to `warn`, so without it clippy printed findings\n197\t+      # and still exited 0 -- a green check over unreviewed lint debt\n198\t+      # (issue #812). The tree is clippy-clean at the time this was added, so\n199\t+      # this promotes existing behaviour rather than introducing new failures.\n200\t       - name: Run Clippy\n201\t-        run: cargo clippy --all-targets --all-features\n202\t+        run: cargo clippy --all-targets --all-features -- -D warnings\n203\t \n204\t       # rustdoc-only lints are not exercised by rustc, clippy, or doctests.\n205\t       # Build the same public API docs deployed by Pages before release so a\n206\t@@ -472,7 +535,26 @@ jobs:\n207\t       # this dependency-free job rather than being silently skipped inside it.\n208\t       - name: Run desktop library tests\n209\t         run: |\n210\t-          node --test $(ls desktop/scripts/*.test.mjs | grep -v '/web-tools.test.mjs$')\n211\t+          set -euo pipefail\n212\t+          # Issue #812: this was `node --test $(ls ... | grep -v ...)`. If the\n213\t+          # glob ever stopped matching, the substitution collapsed to nothing and\n214\t+          # `node --test` fell back to its own directory discovery -- a green\n215\t+          # step that ran none of these tests. Build the list explicitly and\n216\t+          # refuse to pass on an empty one.\n217\t+          shopt -s nullglob\n218\t+          tests=()\n219\t+          for test_file in desktop/scripts/*.test.mjs; do\n220\t+            case \"$test_file\" in\n221\t+              */web-tools.test.mjs) continue ;;\n222\t+            esac\n223\t+            tests+=(\"$test_file\")\n224\t+          done\n225\t+          if [ ${#tests[@]} -eq 0 ]; then\n226\t+            echo \"::error::No desktop library tests matched desktop/scripts/*.test.mjs\" >&2\n227\t+            exit 1\n228\t+          fi\n229\t+          printf 'Running %s test file(s)\\n' \"${#tests[@]}\"\n230\t+          node --test \"${tests[@]}\"\n231\t \n232\t   # === TEST ===\n233\t   # Test runs independently of the changelog check and gates on the change\n234\t@@ -487,7 +569,9 @@ jobs:\n235\t   test:\n236\t     name: Test (${{ matrix.os }})\n237\t     runs-on: ${{ matrix.os }}\n238\t-    timeout-minutes: 15\n239\t+    # 25 minutes, not 15: see the note on the \"Run tests\" step. Keep this in\n240\t+    # sync with TEST_BUDGET_SECONDS there.\n241\t+    timeout-minutes: 25\n242\t     needs: [detect-changes]\n243\t     # Note: a status-check function is required because detect-changes is skipped\n244\t     # on workflow_dispatch; without one the skipped dependency would cascade and\n245\t@@ -552,8 +636,34 @@ jobs:\n246\t       - name: Check self-AST census freshness\n247\t         run: cargo test --test unit self_ast_census -- --nocapture\n248\t \n249\t+      # Issue #812: run 29767811026 reported this job as *failed* although every\n250\t+      # test passed -- the suite finished at 18:43:50 and `timeout-minutes: 15`\n251\t+      # killed the job 1.1 s later, during teardown. Run 29749095334 on `main`\n252\t+      # had already done the same. GitHub surfaces a timeout as `cancelled`, so\n253\t+      # it reads as an infrastructure blip rather than \"the budget is exhausted\".\n254\t+      #\n255\t+      # The budget is not padding: checkout + the two data checks cost ~3m15s\n256\t+      # before a test runs, and the suite itself takes ~11m of which eight\n257\t+      # individual agentic/driver tests exceed 60 s each. 25 minutes reflects the\n258\t+      # measured cost with headroom; the timer below makes further creep visible\n259\t+      # in the run summary instead of surfacing as a mystery cancellation two\n260\t+      # months from now. Reducing those eight tests is real work, tracked\n261\t+      # separately -- inflating the cap silently is what this avoids.\n262\t       - name: Run tests\n263\t-        run: cargo test --all-features --verbose\n264\t+        env:\n265\t+          TEST_BUDGET_SECONDS: 1500\n266\t+          TEST_WARN_RATIO_PERCENT: 70\n267\t+        run: |\n268\t+          set -euo pipefail\n269\t+          started=$SECONDS\n270\t+          cargo test --all-features --verbose\n271\t+          elapsed=$((SECONDS - started))\n272\t+          threshold=$((TEST_BUDGET_SECONDS * TEST_WARN_RATIO_PERCENT / 100))\n273\t+          printf 'Test suite took %ss of the %ss job budget.\\n' \\\n274\t+            \"$elapsed\" \"$TEST_BUDGET_SECONDS\"\n275\t+          if [ \"$elapsed\" -ge \"$threshold\" ]; then\n276\t+            echo \"::warning title=Test suite is approaching its timeout::The suite took ${elapsed}s, at or above ${TEST_WARN_RATIO_PERCENT}% of the ${TEST_BUDGET_SECONDS}s budget. Speed up the slowest tests before the job starts reporting timeouts as cancellations.\"\n277\t+          fi\n278\t \n279\t       - name: Run doc tests\n280\t         run: cargo test --doc --verbose\n281\t@@ -563,7 +673,11 @@ jobs:\n282\t   coverage:\n283\t     name: Code Coverage\n284\t     runs-on: ubuntu-latest\n285\t-    timeout-minutes: 15\n286\t+    # Issue #812: the same margin problem as `test`, one run away from the same\n287\t+    # false failure. Measured on the last eight `main` runs: 11.2, 11.5, 11.4,\n288\t+    # 11.9, 12.6, 12.7, 13.5, 14.1 minutes -- the worst case used 94% of the old\n289\t+    # 15-minute cap. It instruments the same suite that takes ~11m unarmed.\n290\t+    timeout-minutes: 25\n291\t     needs: [detect-changes]\n292\t     if: |\n293\t       !cancelled() && (\n294\t@@ -674,14 +788,30 @@ jobs:\n295\t   # This job automatically bumps version based on fragments in changelog.d/\n296\t   auto-release:\n297\t     name: Auto Release\n298\t-    needs: [lint, test, build]\n299\t+    # Issue #812: this gated on `[lint, test, build]` only, so `Secrets Scan`\n300\t+    # and both E2E suites could be red on main and the crate, the Docker image\n301\t+    # and the GitHub Release would still publish -- a green release over a red\n302\t+    # pipeline. Every job that runs on a push to main now gates it.\n303\t+    needs: [lint, test, build, secrets-scan, test-e2e-local, test-agent-cli-e2e]\n304\t     # Note: !cancelled() keeps this consistent with the other jobs whose skipped\n305\t-    # dependencies must not cascade.\n306\t+    # dependencies must not cascade. The added gates accept 'skipped' for the\n307\t+    # same reason: a job that legitimately skipped itself (no relevant changes)\n308\t+    # must not block the release.\n309\t+    #\n310\t+    # They must NOT be written as `!= 'failure'`. A job killed by its own\n311\t+    # `timeout-minutes` is reported as **cancelled**, not failed -- run\n312\t+    # 29767811026 is the proof: `Test (ubuntu-latest)` hit the 15-minute cap and\n313\t+    # `needs.test.result` was 'cancelled'. Under `!= 'failure'` a timed-out\n314\t+    # secrets scan or E2E suite would have counted as \"not failing\" and released\n315\t+    # anyway. Enumerating the two acceptable results closes that (issue #812).\n316\t     if: |\n317\t       !cancelled() &&\n318\t       github.event_name == 'push' &&\n319\t       github.ref == 'refs/heads/main' &&\n320\t-      needs.build.result == 'success'\n321\t+      needs.build.result == 'success' &&\n322\t+      (needs.secrets-scan.result == 'success' || needs.secrets-scan.result == 'skipped') &&\n323\t+      (needs.test-e2e-local.result == 'success' || needs.test-e2e-local.result == 'skipped') &&\n324\t+      (needs.test-agent-cli-e2e.result == 'success' || needs.test-agent-cli-e2e.result == 'skipped')\n325\t     runs-on: ubuntu-latest\n326\t     timeout-minutes: 30\n327\t     outputs:\n328\t@@ -928,15 +1058,23 @@ jobs:\n329\t   # Manual release via workflow_dispatch - only after CI passes\n330\t   manual-release:\n331\t     name: Instant Release\n332\t-    needs: [lint, test, build]\n333\t+    # Issue #812: same gap as `auto-release` -- an instant release must not be\n334\t+    # able to publish past a failing secrets scan or E2E suite.\n335\t+    needs: [lint, test, build, secrets-scan, test-e2e-local, test-agent-cli-e2e]\n336\t     # Note: !cancelled() is required to evaluate the condition when dependencies\n337\t     # are skipped.\n338\t     # The build job ensures lint and test passed before this job runs.\n339\t+    # The added gates enumerate the acceptable results rather than excluding\n340\t+    # 'failure': a job killed by `timeout-minutes` reports as 'cancelled', which\n341\t+    # `!= 'failure'` would wave through. See the note on `auto-release`.\n342\t     if: |\n343\t       !cancelled() &&\n344\t       github.event_name == 'workflow_dispatch' &&\n345\t       github.event.inputs.release_mode == 'instant' &&\n346\t-      needs.build.result == 'success'\n347\t+      needs.build.result == 'success' &&\n348\t+      (needs.secrets-scan.result == 'success' || needs.secrets-scan.result == 'skipped') &&\n349\t+      (needs.test-e2e-local.result == 'success' || needs.test-e2e-local.result == 'skipped') &&\n350\t+      (needs.test-agent-cli-e2e.result == 'success' || needs.test-agent-cli-e2e.result == 'skipped')\n351\t     runs-on: ubuntu-latest\n352\t     timeout-minutes: 30\n353\t     outputs:\n354\t@@ -1260,8 +1398,12 @@ jobs:\n355\t       # captures on every run (proving the screenshots can be produced in CI).\n356\t       # Publish them as an artifact so reviewers can compare against the committed\n357\t       # baselines without running the suite locally.\n358\t+      # Issue #812: was `if: always()`. On a failed run the suite may never reach\n359\t+      # the capture spec, so \"no screenshots\" was indistinguishable from \"the\n360\t+      # captures broke\" -- and a failed run already has the report artifact\n361\t+      # uploaded by the step above. Running only on success makes the missing-file\n362\t+      # case below unambiguous.\n363\t       - name: Upload generated /download screenshots\n364\t-        if: always()\n365\t         uses: actions/upload-artifact@v7\n366\t         with:\n367\t           name: download-page-screenshots\n368\t@@ -1269,6 +1411,11 @@ jobs:\n369\t             docs/screenshots/issue-347/\n370\t             src/web/download/assets/app-preview*.png\n371\t           retention-days: 14\n372\t+          # Issue #812: `if: always()` plus the default `if-no-files-found: warn`\n373\t+          # means \"the spec produced no screenshots at all\" reads as a green\n374\t+          # step with a warning nobody sees. The whole point of this upload is\n375\t+          # to prove the captures can be produced in CI, so absence is an error.\n376\t+          if-no-files-found: error\n377\t \n378\t   # === E2E: Agent CLI ↔ formal-ai OpenAI-compatible server ===\n379\t   # Boot `formal-ai serve`, drive it with the real `@link-assistant/agent` CLI\n380\t@@ -1321,7 +1468,7 @@ jobs:\n381\t         # ~/.bun/bin — the script's default AGENT=\"agent\" picks it up.\n382\t         run: |\n383\t           bun add -g @link-assistant/agent\n384\t-          echo \"$HOME/.bun/bin\" >> $GITHUB_PATH\n385\t+          echo \"$HOME/.bun/bin\" >> \"$GITHUB_PATH\"\n386\t \n387\t       - name: Install external agent CLIs\n388\t         # OpenCode provides the second issue-715 learning harness. Issue #781\n389\t@@ -1736,6 +1883,11 @@ jobs:\n390\t         uses: actions/upload-pages-artifact@v5\n391\t         with:\n392\t           path: src/web\n393\t+          # Issue #812: without this, upload-artifact's default glob silently\n394\t+          # drops every dotfile, so `.well-known/`, `.nojekyll` and friends\n395\t+          # vanish from the deployed site while the job stays green. The rust\n396\t+          # template sets it for the same reason.\n397\t+          include-hidden-files: true\n398\t \n399\t       - name: Deploy Pages artifact\n400\t         id: deployment"
