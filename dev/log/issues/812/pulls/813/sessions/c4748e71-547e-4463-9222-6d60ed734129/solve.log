[2026-07-20T18:52:25.694Z] [INFO]           "+        run: |",
[2026-07-20T18:52:25.694Z] [INFO]           "+          set -euo pipefail",
[2026-07-20T18:52:25.694Z] [INFO]           "+          started=$SECONDS",
[2026-07-20T18:52:25.694Z] [INFO]           "+          cargo test --all-features --verbose",
[2026-07-20T18:52:25.694Z] [INFO]           "+          elapsed=$((SECONDS - started))",
[2026-07-20T18:52:25.694Z] [INFO]           "+          threshold=$((TEST_BUDGET_SECONDS * TEST_WARN_RATIO_PERCENT / 100))",
[2026-07-20T18:52:25.694Z] [INFO]           "+          printf 'Test suite took %ss of the %ss job budget.\\n' \\",
[2026-07-20T18:52:25.694Z] [INFO]           "+            \"$elapsed\" \"$TEST_BUDGET_SECONDS\"",
[2026-07-20T18:52:25.694Z] [INFO]           "+          if [ \"$elapsed\" -ge \"$threshold\" ]; then",
[2026-07-20T18:52:25.694Z] [INFO]           "+            echo \"::warning title=Test suite is approaching its timeout::The suite took ${elapsed}s, at or above ${TEST_WARN_RATIO_PERCENT}% of the ${TEST_BUDGET_SECONDS}s budget. Speed up the slowest tests before the job starts reporting timeouts as cancellations.\"",
[2026-07-20T18:52:25.694Z] [INFO]           "+          fi",
