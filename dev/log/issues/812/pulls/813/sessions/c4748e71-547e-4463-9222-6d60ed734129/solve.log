[2026-07-20T17:58:08.633Z] [INFO]           " ",
[2026-07-20T17:58:08.633Z] [INFO]           "+/// Issue #812: both release jobs gated on `[lint, test, build]` alone, so a red",
[2026-07-20T17:58:08.633Z] [INFO]           "+/// `Secrets Scan` or E2E suite on `main` did not stop the crate, the Docker",
[2026-07-20T17:58:08.633Z] [INFO]           "+/// image and the GitHub Release from publishing.",
[2026-07-20T17:58:08.633Z] [INFO]           " #[test]",
[2026-07-20T17:58:08.633Z] [INFO]           "+fn releases_do_not_publish_past_a_failing_secrets_scan_or_e2e_suite() {",
[2026-07-20T17:58:08.633Z] [INFO]           "+    let workflow = release_workflow();",
[2026-07-20T17:58:08.633Z] [INFO]           "+",
[2026-07-20T17:58:08.633Z] [INFO]           "+    for job_name in [\"auto-release\", \"manual-release\"] {",
[2026-07-20T17:58:08.633Z] [INFO]           "+        let job = job_block(&workflow, job_name);",
[2026-07-20T17:58:08.633Z] [INFO]           "+        let effective: String = job",
[2026-07-20T17:58:08.633Z] [INFO]           "+            .lines()",
[2026-07-20T17:58:08.633Z] [INFO]           "+            .filter(|line| !line.trim_start().starts_with('#'))",
[2026-07-20T17:58:08.633Z] [INFO]           "+            .collect::<Vec<_>>()",
[2026-07-20T17:58:08.633Z] [INFO]           "+            .join(\"\\n\");",
[2026-07-20T17:58:08.633Z] [INFO]           "+",
[2026-07-20T17:58:08.633Z] [INFO]           "+        for gate in [\"secrets-scan\", \"test-e2e-local\", \"test-agent-cli-e2e\"] {",
[2026-07-20T17:58:08.633Z] [INFO]           "+            assert!(",
[2026-07-20T17:58:08.633Z] [INFO]           "+                effective.contains(&format!(\"needs.{gate}.result != 'failure'\")),",
[2026-07-20T17:58:08.633Z] [INFO]           "+                \"{job_name} must not publish while {gate} is failing (issue #812)\"",
[2026-07-20T17:58:08.633Z] [INFO]           "+            );",
[2026-07-20T17:58:08.633Z] [INFO]           "+            assert!(",
[2026-07-20T17:58:08.633Z] [INFO]           "+                effective.contains(gate),",
[2026-07-20T17:58:08.633Z] [INFO]           "+                \"{job_name} must declare {gate} in needs: (issue #812)\"",
[2026-07-20T17:58:08.633Z] [INFO]           "+            );",
[2026-07-20T17:58:08.633Z] [INFO]           "+        }",
[2026-07-20T17:58:08.633Z] [INFO]           "+    }",
[2026-07-20T17:58:08.633Z] [INFO]           "+}",
[2026-07-20T17:58:08.633Z] [INFO]           "+",
[2026-07-20T17:58:08.633Z] [INFO]           "+/// Issue #812: nothing validated the pipeline definitions themselves, and",
[2026-07-20T17:58:08.633Z] [INFO]           "+/// `cargo clippy` ran without `-D warnings` while every lint in `[lints.clippy]`",
[2026-07-20T17:58:08.633Z] [INFO]           "+/// is set to `warn` -- so clippy printed findings and exited 0.",
[2026-07-20T17:58:08.633Z] [INFO]           "+#[test]",
[2026-07-20T17:58:08.633Z] [INFO]           "+fn lint_job_gates_on_workflow_shell_and_clippy_findings() {",
[2026-07-20T17:58:08.633Z] [INFO]           "+    let workflow = release_workflow();",
[2026-07-20T17:58:08.633Z] [INFO]           "+    let lint = job_block(&workflow, \"lint\");",
[2026-07-20T17:58:08.633Z] [INFO]           "+",
[2026-07-20T17:58:08.633Z] [INFO]           "+    assert!(",
[2026-07-20T17:58:08.633Z] [INFO]           "+        lint.contains(\"cargo clippy --all-targets --all-features -- -D warnings\"),",
[2026-07-20T17:58:08.633Z] [INFO]           "+        \"clippy must fail the job on findings, not just print them (issue #812)\"",
[2026-07-20T17:58:08.633Z] [INFO]           "+    );",
[2026-07-20T17:58:08.633Z] [INFO]           "+    assert!(",
[2026-07-20T17:58:08.633Z] [INFO]           "+        lint.contains(\"actionlint\"),",
[2026-07-20T17:58:08.633Z] [INFO]           "+        \"workflow definitions must be linted (issue #812)\"",
[2026-07-20T17:58:08.633Z] [INFO]           "+    );",
[2026-07-20T17:58:08.633Z] [INFO]           "+    assert!(",
[2026-07-20T17:58:08.633Z] [INFO]           "+        lint.contains(\"shellcheck --severity=warning\"),",
[2026-07-20T17:58:08.633Z] [INFO]           "+        \"standalone shell scripts must be linted (issue #812)\"",
[2026-07-20T17:58:08.633Z] [INFO]           "+    );",
[2026-07-20T17:58:08.633Z] [INFO]           "+}",
