[2026-07-20T17:52:46.749Z] [INFO]     "newString": "      - uses: actions/checkout@v6\n        with:\n          # On pull requests there is no resolved tag: build the PR head, which\n          # is the whole point of the dry run.\n          ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}\n          # Quoted '0'/'1': GitHub's `&&`/`||` treat the number 0 as falsy, so an\n          # unquoted 0 here would silently select the other branch.\n          # 0 is needed by simulate-fresh-merge.sh, which merges origin/<base>.\n          fetch-depth: ${{ github.event_name == 'pull_request' && '0' || '1' }}\n\n      # Issue #812: `release.yml` simulates the fresh merge in `lint` and `test`,\n      # but this workflow -- the only one that packages the desktop app -- did\n      # not, so the packaging dry run validated the PR head against a merge\n      # preview that predates any commit pushed to the base branch since the last\n      # sync. A packaging break introduced by a concurrent main commit stayed\n      # invisible until after the merge, which is how desktop breakages have\n      # reached tags before.\n      - name: Simulate fresh merge with base branch (PR only)\n        if: github.event_name == 'pull_request'\n        env:\n          BASE_REF: ${{ github.base_ref }}\n        run: bash scripts/simulate-fresh-merge.sh\n\n      - name: Install Rust toolchain",
[2026-07-20T17:52:46.749Z] [INFO]     "originalFile": "# Cross-platform desktop release (Linux, Windows, macOS) for formal-ai.\n#\n# Produces the exact assets the /download page (src/web/download) resolves from\n# the GitHub Releases API:\n#   formal-ai-desktop-macos-<arch>-<version>.{dmg,zip}\n#   formal-ai-desktop-windows-installer-<arch>-<version>.exe\n#   formal-ai-desktop-windows-portable-<arch>-<version>.exe\n#   formal-ai-desktop-linux-<arch>-<version>.{AppImage,deb,tar.gz}\n#   latest.yml, latest-mac.yml, latest-linux.yml, and *.blockmap updater metadata\n#   (Electron Builder emits x86_64/amd64 Linux x64 aliases; the build job\n#    normalizes them to x64 before checksums/uploads and rewrites update metadata.)\n# plus a consolidated SHA256SUMS.txt and BUILD-PROVENANCE.txt, and SLSA build\n# provenance attestations (verifiable with `gh attestation verify`).\n#\n# Triggers:\n#   * release: published     - fires for releases published manually (UI) or via\n#                              a PAT. NOTE: the automated `[Rust] x.y.z` releases\n#                              created by the CI/CD Pipeline use GITHUB_TOKEN, so\n#                              GitHub suppresses the `release` event for them\n#                              (recursion guard). The workflow_run trigger below\n#                              covers that case automatically.\n#   * workflow_run           - after the \"CI/CD Pipeline\" completes on main (with\n#                              ANY conclusion except cancelled/skipped -- the\n#                              release is published in an early job, so a later job\n#                              failing must not suppress the desktop build), build\n#                              desktop assets for the resolved release tag\n#                              (idempotent: skips when assets already exist).\n#   * workflow_dispatch      - manual rebuild for a specific (or latest) tag.\nname: Desktop Release\n\non:\n  workflow_dispatch:\n    inputs:\n      tag:\n        description: \"Release tag to build (e.g. v0.152.0). Leave blank for the latest release.\"\n        required: false\n        default: \"\"\n  release:\n    types: [published]\n  workflow_run:\n    workflows: [\"CI/CD Pipeline\"]\n    types: [completed]\n  # Issue #808: packaging and macOS signing used to run only after a release\n  # existed, so a desktop regression was always discovered post-merge -- which is\n  # exactly how the \"unsealed contents present in the root directory of an\n  # embedded framework\" codesign failure reached main. On pull requests the same\n  # build matrix runs in dry-run mode: everything up to and including the smoke\n  # tests, with every publishing step (attest, release upload, SHA256SUMS)\n  # skipped. Path-filtered so unrelated pull requests do not pay for six runners.\n  pull_request:\n    types: [opened, synchronize, reopened]\n    paths:\n      - 'desktop/**'\n      - 'vscode/**'\n      - '.github/workflows/desktop-release.yml'\n      - 'scripts/desktop-release-resolve.sh'\n      - 'scripts/install-node-dependencies.sh'\n      # The build job runs `cargo build --release --bin formal-ai` and bundles\n      # the result, so a Rust-only change can break desktop packaging while\n      # touching none of the paths above. Without these entries that breakage is\n      # a false negative on the pull request and only surfaces post-merge --\n      # precisely the failure mode issue #808 was filed for.\n      - 'src/**'\n      - 'Cargo.toml'\n      - 'Cargo.lock'\n\npermissions:\n  contents: read\n\nconcurrency:\n  # The workflow_run path (the automatic one) carries neither release.tag_name\n  # nor inputs.tag, so this fell through to the always-unique run_id and never\n  # actually deduped: concurrent runs for the same tag raced each other on\n  # `gh release upload --clobber` and on finalize's SHA256SUMS.txt. Key on the\n  # commit for that path, which is what resolve maps to a tag.\n  group: desktop-release-${{ github.event.pull_request.number || github.event.release.tag_name || github.event.inputs.tag || github.event.workflow_run.head_sha || github.run_id }}\n  # Release runs must never be cancelled mid-upload; pull-request dry runs are\n  # pure verification, so superseding pushes should cancel the stale six-runner\n  # matrix instead of queueing behind it.\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\nenv:\n  GIT_CONFIG_COUNT: '1'\n  GIT_CONFIG_KEY_0: init.defaultBranch\n  GIT_CONFIG_VALUE_0: main\n  CARGO_NET_RETRY: '10'\n  CARGO_HTTP_MULTIPLEXING: 'false'\n  RUSTFLAGS: -Dwarnings\n\njobs:\n  resolve:\n    name: Resolve target release\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      contents: read\n    # For workflow_run, continue after ANY completed main-branch pipeline except\n    # cancelled/skipped runs (issue #479). We intentionally do NOT gate on\n    # conclusion == 'success': the auto-release publishes the GitHub release in an\n    # EARLY pipeline job, so a LATER job failing (e.g. the E2E Pages probe timing\n    # out) still leaves a real, asset-less release that desktop assets must heal.\n    # Gating on full-pipeline green meant one unrelated late failure suppressed\n    # every desktop build -> \"Not available in latest release\". The actual\n    # decision to build is delegated to scripts/desktop-release-resolve.sh, whose\n    # idempotency guard skips when the resolved release already carries desktop\n    # assets, so running on a non-success conclusion is safe and self-healing.\n    # Pull requests resolve nothing: there is no release to heal and no tag to\n    # check out. The job is skipped and `build` admits the skipped dependency\n    # explicitly, so the packaging matrix still runs against the PR head.\n    if: >-\n      github.event_name != 'pull_request' &&\n      (github.event_name != 'workflow_run' ||\n      (github.event.workflow_run.head_branch == 'main' &&\n       github.event.workflow_run.conclusion != 'cancelled' &&\n       github.event.workflow_run.conclusion != 'skipped'))\n    outputs:\n      tag: ${{ steps.pick.outputs.tag }}\n      should_build: ${{ steps.pick.outputs.should_build }}\n    steps:\n      # Check out the repo so the resolve logic lives in a unit-tested script\n      # (scripts/desktop-release-resolve.sh) instead of being inlined here. The\n      # script only needs to *exist*; it queries the GitHub API for everything\n      # else, so checking out the default ref is sufficient.\n      - uses: actions/checkout@v6\n\n      - name: Resolve tag and whether desktop assets are needed\n        id: pick\n        env:\n          GH_TOKEN: ${{ github.token }}\n          EVENT: ${{ github.event_name }}\n          INPUT_TAG: ${{ github.event.inputs.tag }}\n          RELEASE_TAG: ${{ github.event.release.tag_name }}\n          REPO: ${{ github.repository }}\n          WORKFLOW_RUN_HEAD_SHA: ${{ github.event.workflow_run.head_sha }}\n        # Issue #479: the automated release tags a CHILD \"chore: release vX.Y.Z\"\n        # commit whose first parent is the completed CI head SHA, so matching the\n        # tag to the head SHA directly always failed and desktop assets were\n        # never built. desktop-release-resolve.sh resolves the latest release\n        # instead (with a defensive exact-SHA tier and an idempotency guard) and\n        # emits verbose ::group:: diagnostics for future debugging.\n        run: bash scripts/desktop-release-resolve.sh\n\n  build:\n    name: Build ${{ matrix.label }}\n    needs: resolve\n    # `resolve` is skipped on pull requests, and a skipped dependency would\n    # normally skip this job too -- hence the explicit `!cancelled()`.\n    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.resolve.outputs.should_build == 'true') }}\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n          - { os: ubuntu-latest,    ebflag: \"--linux\", label: \"linux-x64\",     binext: \"\" }\n          - { os: ubuntu-24.04-arm, ebflag: \"--linux\", label: \"linux-arm64\",   binext: \"\" }\n          - { os: macos-15-intel,   ebflag: \"--mac\",   label: \"macos-x64\",     binext: \"\" }\n          - { os: macos-14,         ebflag: \"--mac\",   label: \"macos-arm64\",   binext: \"\" }\n          - { os: windows-latest,   ebflag: \"--win\",   label: \"windows-x64\",   binext: \".exe\" }\n          - { os: windows-11-arm,   ebflag: \"--win\",   label: \"windows-arm64\", binext: \".exe\" }\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 30\n    permissions:\n      contents: write\n      id-token: write\n      attestations: write\n    defaults:\n      run:\n        shell: bash\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          # On pull requests there is no resolved tag: build the PR head, which\n          # is the whole point of the dry run.\n          ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}\n\n      - name: Install Rust toolchain\n        uses: dtolnay/rust-toolchain@stable\n\n      - name: Cache cargo\n        uses: actions/cache@v5\n        with:\n          path: |\n            ~/.cargo/registry\n            ~/.cargo/git\n            target\n          key: desktop-${{ matrix.label }}-cargo-${{ hashFiles('Cargo.lock', 'Cargo.toml') }}\n\n      - name: Build formal-ai binary (release)\n        run: cargo build --release --bin formal-ai\n\n      - name: Setup Node\n        uses: actions/setup-node@v6\n        with:\n          node-version: 22\n\n      - name: Install desktop dependencies\n        run: scripts/install-node-dependencies.sh desktop\n\n      - name: Prepare desktop resources (web + bundled binary + version sync)\n        working-directory: desktop\n        run: node scripts/prepare-resources.mjs\n\n      - name: Check macOS signing secrets\n        if: matrix.ebflag == '--mac'\n        id: mac_secrets\n        env:\n          MAC_CSC_LINK: ${{ secrets.MAC_CSC_LINK }}\n          MAC_CSC_KEY_PASSWORD: ${{ secrets.MAC_CSC_KEY_PASSWORD }}\n          APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}\n          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}\n          APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}\n        run: |\n          set -euo pipefail\n          missing=()\n          for name in MAC_CSC_LINK MAC_CSC_KEY_PASSWORD APPLE_API_KEY APPLE_API_KEY_ID APPLE_API_ISSUER; do\n            if [ -z \"${!name}\" ]; then\n              missing+=(\"$name\")\n            fi\n          done\n\n          if [ \"${#missing[@]}\" -gt 0 ]; then\n            echo \"has_secrets=false\" >> \"$GITHUB_OUTPUT\"\n            echo \"mode=adhoc\" >> \"$GITHUB_OUTPUT\"\n            echo \"::notice::macOS signing/notarization secrets are not configured: ${missing[*]}\"\n            echo \"Building ad-hoc signed macOS artifacts without notarization for direct testing.\"\n          else\n            echo \"has_secrets=true\" >> \"$GITHUB_OUTPUT\"\n            echo \"mode=signed\" >> \"$GITHUB_OUTPUT\"\n          fi\n\n      - name: Package desktop app (Linux/Windows)\n        if: matrix.ebflag != '--mac'\n        working-directory: desktop\n        env:\n          CSC_IDENTITY_AUTO_DISCOVERY: \"false\"\n        run: npx --no-install electron-builder ${{ matrix.ebflag }} --publish never\n\n      - name: Package desktop app (macOS signed)\n        if: matrix.ebflag == '--mac' && steps.mac_secrets.outputs.has_secrets == 'true'\n        working-directory: desktop\n        env:\n          CSC_LINK: ${{ secrets.MAC_CSC_LINK }}\n          CSC_KEY_PASSWORD: ${{ secrets.MAC_CSC_KEY_PASSWORD }}\n          APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}\n          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}\n          APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}\n          DEBUG: electron-builder,electron-notarize*\n        run: npx --no-install electron-builder ${{ matrix.ebflag }} --publish never\n\n      # Issue #479: electron-builder 26 changed macOS signing control flow. Its\n      # MacPackager.sign() now calls findSigningIdentity(), which returns null --\n      # skipping signing entirely and NEVER invoking the custom `mac.sign` hook --\n      # unless a real identity is found OR `mac.identity` is exactly \"-\" (ad-hoc).\n      # See packages/app-builder-lib/src/targets/mac/MacTargetHelper.ts: only the\n      # `qualifier === \"-\"` branch yields an Identity when no certificate exists.\n      # Without `-c.mac.identity=-` the produced .app had no _CodeSignature, so the\n      # pre-upload smoke test failed with \"missing its signed CodeResources\n      # envelope\" and macOS assets were never published. Passing identity=\"-\" makes\n      # electron-builder reach doSign(), which runs our ad-hoc hook (deep ad-hoc\n      # sign via @electron/osx-sign + an explicit root-bundle re-seal).\n      - name: Package desktop app (macOS ad-hoc)\n        if: matrix.ebflag == '--mac' && steps.mac_secrets.outputs.has_secrets != 'true'\n        working-directory: desktop\n        env:\n          CSC_IDENTITY_AUTO_DISCOVERY: \"false\"\n          MACOS_ADHOC_SIGN: \"1\"\n          # Issue #808: electron-builder's isSignAllowed() bails out with\n          # \"Current build is a part of pull request, code signing will be\n          # skipped\" whenever GITHUB_BASE_REF is set (builder-util\n          # `isPullRequest()`), so the pull-request dry run produced an unsigned\n          # .app with no CodeResources and the smoke test failed. The security\n          # warning attached to this flag is about *secret* certificates leaking\n          # to fork builds; this step only runs when no signing secrets exist and\n          # signs ad-hoc with identity `-`, so there is nothing to leak.\n          CSC_FOR_PULL_REQUEST: \"true\"\n          FORMAL_AI_MACOS_SIGN_DEBUG: \"1\"\n          DEBUG: electron-builder,electron-osx-sign*\n        run: npx --no-install electron-builder ${{ matrix.ebflag }} --publish never -c.mac.notarize=false -c.mac.identity=- -c.mac.sign=./scripts/adhoc-sign-mac.cjs\n\n      - name: Normalize desktop artifact names\n        working-directory: desktop\n        run: node scripts/normalize-artifacts.mjs\n\n      - name: Smoke test macOS release artifacts\n        if: matrix.ebflag == '--mac'\n        working-directory: desktop\n        env:\n          MACOS_BUILD_MODE: ${{ steps.mac_secrets.outputs.mode }}\n        run: |\n          set -euo pipefail\n          shopt -s nullglob\n\n          VERSION=\"$(node -p \"require('./package.json').version\")\"\n          case \"${{ matrix.label }}\" in\n            macos-x64) ARCH=\"x64\" ;;\n            macos-arm64) ARCH=\"arm64\" ;;\n            *)\n              echo \"::error::Unexpected macOS matrix label: ${{ matrix.label }}\"\n              exit 1\n              ;;\n          esac\n\n          required_macos_artifacts=(\n            \"release/formal-ai-desktop-macos-${ARCH}-${VERSION}.dmg\"\n            \"release/formal-ai-desktop-macos-${ARCH}-${VERSION}.zip\"\n          )\n          for artifact in \"${required_macos_artifacts[@]}\"; do\n            if [ ! -f \"$artifact\" ]; then\n              echo \"::error file=$artifact::Expected versioned macOS release artifact was not created.\"\n              ls -la release || true\n              exit 1\n            fi\n          done\n\n          for dmg in \"release/formal-ai-desktop-macos-${ARCH}-${VERSION}.dmg\"; do\n            echo \"Mounting DMG: $dmg\"\n            mount_dir=\"$(mktemp -d)\"\n            installed_app=\"$RUNNER_TEMP/formal-ai Desktop.app\"\n\n            hdiutil attach \"$dmg\" -mountpoint \"$mount_dir\" -nobrowse -readonly\n            mounted_app=\"$mount_dir/formal-ai Desktop.app\"\n\n            if [ ! -d \"$mounted_app\" ]; then\n              echo \"::error file=$dmg::Mounted DMG does not contain formal-ai Desktop.app.\"\n              find \"$mount_dir\" -maxdepth 2 -print\n              hdiutil detach \"$mount_dir\"\n              exit 1\n            fi\n\n            rm -rf \"$installed_app\"\n            ditto \"$mounted_app\" \"$installed_app\"\n            hdiutil detach \"$mount_dir\"\n\n            app_info=\"$installed_app/Contents/Info.plist\"\n            executable=\"$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' \"$app_info\")\"\n            bundle_id=\"$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \"$app_info\")\"\n\n            if [ \"$bundle_id\" != \"ai.formal.desktop\" ]; then\n              echo \"::error file=$dmg::Unexpected macOS app bundle identifier: $bundle_id\"\n              exit 1\n            fi\n\n            if [ ! -x \"$installed_app/Contents/MacOS/$executable\" ]; then\n              echo \"::error file=$dmg::Mounted app executable is missing or not executable.\"\n              find \"$installed_app/Contents\" -maxdepth 3 -print\n              exit 1\n            fi\n\n            if [ ! -f \"$installed_app/Contents/_CodeSignature/CodeResources\" ]; then\n              echo \"::error file=$dmg::Mounted app is missing its signed CodeResources envelope.\"\n              find \"$installed_app/Contents/_CodeSignature\" -maxdepth 1 -print 2>/dev/null || true\n              exit 1\n            fi\n\n            codesign --verify --deep --strict --verbose=2 \"$installed_app\"\n\n            if [ \"$MACOS_BUILD_MODE\" = \"signed\" ]; then\n              spctl --assess --type execute --verbose=4 \"$installed_app\"\n              xcrun stapler validate \"$installed_app\"\n            else\n              codesign --display --verbose=2 \"$installed_app\" 2>&1 | tee \"$RUNNER_TEMP/formal-ai-macos-codesign.txt\"\n              if ! grep -Fq 'Signature=adhoc' \"$RUNNER_TEMP/formal-ai-macos-codesign.txt\"; then\n                echo \"::error file=$dmg::Expected ad-hoc macOS signature for no-Apple-account build.\"\n                exit 1\n              fi\n            fi\n          done\n\n      # The macOS smoke test above is the only artifact verification this\n      # workflow had, so the four Linux/Windows targets were uploaded to the\n      # release with nothing checking that electron-builder actually produced\n      # them under the expected names. A rename or a partial package silently\n      # shipped. The deep checks are macOS-only by nature (hdiutil, codesign),\n      # but existence and non-emptiness are checkable everywhere.\n      - name: Smoke test Linux/Windows release artifacts\n        if: matrix.ebflag != '--mac'\n        shell: bash\n        working-directory: desktop\n        run: |\n          set -euo pipefail\n\n          VERSION=\"$(node -p \"require('./package.json').version\")\"\n          case \"${{ matrix.label }}\" in\n            linux-x64|linux-arm64)\n              ARCH=\"${{ matrix.label }}\"; ARCH=\"${ARCH#linux-}\"\n              required=(\n                \"release/formal-ai-desktop-linux-${ARCH}-${VERSION}.AppImage\"\n                \"release/formal-ai-desktop-linux-${ARCH}-${VERSION}.deb\"\n                \"release/formal-ai-desktop-linux-${ARCH}-${VERSION}.tar.gz\"\n              )\n              ;;\n            windows-x64|windows-arm64)\n              ARCH=\"${{ matrix.label }}\"; ARCH=\"${ARCH#windows-}\"\n              required=(\n                \"release/formal-ai-desktop-windows-installer-${ARCH}-${VERSION}.exe\"\n                \"release/formal-ai-desktop-windows-portable-${ARCH}-${VERSION}.exe\"\n              )\n              ;;\n            *)\n              echo \"::error::Unexpected matrix label for the Linux/Windows smoke test: ${{ matrix.label }}\"\n              exit 1\n              ;;\n          esac\n\n          failed=0\n          for artifact in \"${required[@]}\"; do\n            if [ ! -f \"$artifact\" ]; then\n              echo \"::error file=$artifact::Expected versioned release artifact was not created.\"\n              failed=1\n            elif [ ! -s \"$artifact\" ]; then\n              echo \"::error file=$artifact::Release artifact is empty.\"\n              failed=1\n            else\n              echo \"ok $artifact ($(wc -c < \"$artifact\") bytes)\"\n            fi\n          done\n          if [ \"$failed\" -ne 0 ]; then\n            ls -la release || true\n            exit 1\n          fi\n\n      - name: Collect artifacts and checksums\n        id: collect\n        working-directory: desktop\n        run: |\n          set -euo pipefail\n          files=()\n          for f in release/formal-ai-desktop-*; do\n            case \"$f\" in\n              *.dmg|*.zip|*.exe|*.AppImage|*.deb|*.tar.gz|*.blockmap) files+=(\"$f\") ;;\n            esac\n          done\n          for f in release/latest.yml release/latest-mac.yml release/latest-linux.yml; do\n            [ -f \"$f\" ] && files+=(\"$f\")\n          done\n          if [ ${#files[@]} -eq 0 ]; then\n            echo \"No desktop artifacts produced for ${{ matrix.label }}\" >&2\n            exit 1\n          fi\n          printf 'Artifacts:\\n'; printf '  %s\\n' \"${files[@]}\"\n          # Standard `sha256sum`-format lines with bare filenames so the\n          # in-browser verifier on the /download page can match by name.\n          node -e '\n            const fs = require(\"fs\"); const cp = require(\"crypto\"); const path = require(\"path\");\n            const dir = \"release\";\n            const re = /^(formal-ai-desktop-.*\\.(dmg|zip|exe|AppImage|deb|tar\\.gz|blockmap)|latest(-mac|-linux)?\\.yml)$/;\n            const names = fs.readdirSync(dir).filter((n) => re.test(n)).sort();\n            for (const n of names) {\n              const hash = cp.createHash(\"sha256\").update(fs.readFileSync(path.join(dir, n))).digest(\"hex\");\n              process.stdout.write(hash + \"  \" + n + \"\\n\");\n            }\n          ' > \"release/SHA256SUMS-${{ matrix.label }}.partial\"\n          cat \"release/SHA256SUMS-${{ matrix.label }}.partial\"\n\n      # Attest before publishing, not after: uploading first left the assets\n      # downloadable for the length of the attest step, and permanently so if\n      # attest failed, with `gh attestation verify` unable to vouch for them.\n      - name: Attest build provenance\n        # Dry run: a pull request has nothing to attest and no release to\n        # publish to. Everything above -- packaging, signing, smoke tests -- has\n        # already run, which is what catches desktop regressions before merge.\n        if: github.event_name != 'pull_request'\n        uses: actions/attest@v4\n        with:\n          # The released v4 checksum parser splits with the runner's native EOL,\n          # so it treats our intentionally portable LF manifest as one record on\n          # Windows. Digest the artifacts directly; keep the checksum fragment\n          # solely for the consolidated, user-facing SHA256SUMS.txt.\n          subject-path: |\n            desktop/release/formal-ai-desktop-*\n            desktop/release/latest*.yml\n\n      - name: Upload assets to release\n        if: github.event_name != 'pull_request'\n        working-directory: desktop\n        env:\n          GH_TOKEN: ${{ github.token }}\n          REPO: ${{ github.repository }}\n          TAG: ${{ needs.resolve.outputs.tag }}\n        run: |\n          set -euo pipefail\n          files=()\n          for f in release/formal-ai-desktop-*; do\n            case \"$f\" in\n              *.dmg|*.zip|*.exe|*.AppImage|*.deb|*.tar.gz|*.blockmap) files+=(\"$f\") ;;\n            esac\n          done\n          for f in release/latest.yml release/latest-mac.yml release/latest-linux.yml; do\n            [ -f \"$f\" ] && files+=(\"$f\")\n          done\n          gh release upload \"$TAG\" \"${files[@]}\" --repo \"$REPO\" --clobber\n\n      - name: Upload checksum fragment\n        uses: actions/upload-artifact@v7\n        with:\n          name: checksums-${{ matrix.label }}\n          path: desktop/release/SHA256SUMS-${{ matrix.label }}.partial\n          retention-days: 7\n\n  vscode:\n    name: Package VS Code extension (.vsix)\n    needs: resolve\n    # Same skipped-dependency handling as `build`; see the comment there.\n    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.resolve.outputs.should_build == 'true') }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 15\n    permissions:\n      contents: write\n      id-token: write\n      attestations: write\n    defaults:\n      run:\n        shell: bash\n    steps:\n      - uses: actions/checkout@v6\n        with:\n          # On pull requests there is no resolved tag: build the PR head, which\n          # is the whole point of the dry run.\n          ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}\n\n      - name: Setup Node\n        uses: actions/setup-node@v6\n        with:\n          node-version: 22\n\n      # No committed lockfile under vscode/ (the extension's only deps are the\n      # packaging dev-tools), so a plain install is used rather than `npm ci`.\n      - name: Install extension dependencies\n        run: scripts/install-node-dependencies.sh vscode\n\n      - name: Package the .vsix\n        id: package\n        working-directory: vscode\n        run: |\n          set -euo pipefail\n          # `vscode:prepublish` (prepare-resources.mjs) syncs the extension\n          # version from Cargo.toml and copies src/web + data/seed + desktop/lib\n          # into the package, so the .vsix is fully self-contained and its\n          # filename (formal-ai-vscode-<version>.vsix) matches the release\n          # version the /download and /vscode pages resolve.\n          npm run package\n          vsix=\"$(ls formal-ai-vscode-*.vsix 2>/dev/null | head -n1)\"\n          [ -n \"$vsix\" ] || { echo \"::error::vsce package produced no .vsix\" >&2; exit 1; }\n          echo \"vsix=$vsix\" >> \"$GITHUB_OUTPUT\"\n          echo \"Packaged: $vsix\"\n\n      - name: Collect .vsix checksum fragment\n        working-directory: vscode\n        run: |\n          set -euo pipefail\n          # Same `sha256sum`-format line (bare filename) as the desktop build job\n          # so the consolidated SHA256SUMS.txt covers the .vsix too, and both the\n          # /download verifier and install.sh can match it by name.\n          node -e '\n            const fs = require(\"fs\"); const cp = require(\"crypto\");\n            const n = fs.readdirSync(\".\").filter((f) => /^formal-ai-vscode-.*\\.vsix$/.test(f)).sort()[0];\n            if (!n) { process.exit(1); }\n            const hash = cp.createHash(\"sha256\").update(fs.readFileSync(n)).digest(\"hex\");\n            process.stdout.write(hash + \"  \" + n + \"\\n\");\n          ' > SHA256SUMS-vscode.partial\n          cat SHA256SUMS-vscode.partial\n\n      # Attest before publishing; see the same step in the desktop build job.\n      - name: Attest build provenance\n        if: github.event_name != 'pull_request'\n        uses: actions/attest@v4\n        with:\n          subject-path: vscode/formal-ai-vscode-*.vsix\n\n      - name: Upload .vsix to release\n        if: github.event_name != 'pull_request'\n        working-directory: vscode\n        env:\n          GH_TOKEN: ${{ github.token }}\n          REPO: ${{ github.repository }}\n          TAG: ${{ needs.resolve.outputs.tag }}\n        run: gh release upload \"$TAG\" \"${{ steps.package.outputs.vsix }}\" --repo \"$REPO\" --clobber\n\n      - name: Upload checksum fragment\n        uses: actions/upload-artifact@v7\n        with:\n          name: checksums-vscode\n          path: vscode/SHA256SUMS-vscode.partial\n          retention-days: 7\n\n  finalize:\n    name: Publish SHA256SUMS.txt + provenance\n    needs: [resolve, build, vscode]\n    # !cancelled(), not always(): a partial matrix (one arch failing under\n    # fail-fast:false) must still publish checksums for the arches that did\n    # build, but a *cancelled* run must not. The upload below uses\n    # `gh release upload --clobber`, so under always() a run cancelled part-way\n    # -- by the concurrency group superseding it, or by hand -- would overwrite a\n    # complete SHA256SUMS.txt from an earlier successful run with a manifest\n    # covering whichever one or two arches happened to finish (issue #812).\n    # Never on pull requests: there is no release to publish checksums to.\n    if: ${{ !cancelled() && github.event_name != 'pull_request' && needs.resolve.outputs.should_build == 'true' }}\n    runs-on: ubuntu-latest\n    timeout-minutes: 10\n    permissions:\n      actions: read\n      contents: write\n    steps:\n      - name: Download checksum fragments\n        uses: actions/download-artifact@v8\n        env:\n          # v8's bundled unzip dependency still calls Buffer(); suppress only\n          # that reviewed upstream diagnostic, never all Node warnings:\n          # https://github.com/actions/download-artifact/issues/484\n          NODE_OPTIONS: --disable-warning=DEP0005\n        with:\n          pattern: checksums-*\n          path: fragments\n          merge-multiple: true\n\n      - name: Build consolidated SHA256SUMS.txt and BUILD-PROVENANCE.txt\n        id: manifest\n        env:\n          GH_TOKEN: ${{ github.token }}\n          REPO: ${{ github.repository }}\n          TAG: ${{ needs.resolve.outputs.tag }}\n          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}\n        run: |\n          set -euo pipefail\n          shopt -s nullglob\n          parts=(fragments/*.partial)\n          if [ ${#parts[@]} -eq 0 ]; then\n            echo \"No checksum fragments were produced; nothing to finalize.\" >&2\n            exit 1\n          fi\n          # Deterministic order: concatenate fragments, sort by filename (field 2).\n          cat \"${parts[@]}\" | sort -k2 > SHA256SUMS.txt\n          echo \"=== SHA256SUMS.txt ===\"\n          cat SHA256SUMS.txt\n          commit=\"$(gh release view \"$TAG\" --repo \"$REPO\" --json targetCommitish --jq .targetCommitish || echo unknown)\"\n\n          # Report the builders that actually produced a fragment. Hardcoding the\n          # full matrix here claimed builds that never happened whenever an arch\n          # failed under fail-fast: false.\n          declare -A builder_of=(\n            [linux-x64]=\"ubuntu-latest\"\n            [linux-arm64]=\"ubuntu-24.04-arm\"\n            [macos-x64]=\"macos-15-intel\"\n            [macos-arm64]=\"macos-14\"\n            [windows-x64]=\"windows-latest\"\n            [windows-arm64]=\"windows-11-arm\"\n            [vscode]=\"ubuntu-latest\"\n          )\n          built=()\n          missing=()\n          for label in linux-x64 linux-arm64 macos-x64 macos-arm64 windows-x64 windows-arm64 vscode; do\n            if [ -f \"fragments/SHA256SUMS-${label}.partial\" ]; then\n              built+=(\"${builder_of[$label]} (${label})\")\n            else\n              missing+=(\"$label\")\n            fi\n          done\n\n          {\n            echo \"formal-ai Desktop build provenance\"\n            echo \"==================================\"\n            echo \"Repository : $REPO\"\n            echo \"Release tag: $TAG\"\n            echo \"Commitish  : $commit\"\n            echo \"Workflow   : Desktop Release\"\n            echo \"Run        : $RUN_URL\"\n            printf 'Builders   : %s\\n' \"${built[0]}\"\n            printf '             %s\\n' \"${built[@]:1}\"\n            if [ ${#missing[@]} -gt 0 ]; then\n              echo \"INCOMPLETE : no artifacts from: ${missing[*]}\"\n              echo \"             This release is missing those targets; the checksums\"\n              echo \"             below cover only the builders listed above.\"\n            fi\n            echo \"Signing    : macOS artifacts are ad-hoc signed (no Apple Developer ID).\"\n            echo \"Attestation: SLSA build provenance attached via actions/attest.\"\n            echo \"             Verify with: gh attestation verify <file> --repo $REPO\"\n            echo \"\"\n            # Deliberately not \"authoritative\": when `missing` is non-empty this\n            # manifest covers only part of the release, and calling it\n            # authoritative is exactly the false positive we are fixing.\n            echo \"SHA-256 checksums of the artifacts listed above (SHA256SUMS.txt is the machine-readable copy):\"\n            echo \"\"\n            cat SHA256SUMS.txt\n          } > BUILD-PROVENANCE.txt\n          echo \"=== BUILD-PROVENANCE.txt ===\"\n          cat BUILD-PROVENANCE.txt\n\n          # Still upload what we have (a partial manifest beats none), but never\n          # report success for it: a green run here means \"all desktop assets\n          # shipped\", and callers rely on that.\n          if [ ${#missing[@]} -gt 0 ]; then\n            echo \"incomplete=${missing[*]}\" >> \"$GITHUB_OUTPUT\"\n          fi\n\n      - name: Upload SHA256SUMS.txt and BUILD-PROVENANCE.txt to release\n        env:\n          GH_TOKEN: ${{ github.token }}\n          REPO: ${{ github.repository }}\n          TAG: ${{ needs.resolve.outputs.tag }}\n        run: |\n          set -euo pipefail\n          gh release upload \"$TAG\" SHA256SUMS.txt BUILD-PROVENANCE.txt --repo \"$REPO\" --clobber\n\n      # Runs after the upload so the partial manifest is still published for\n      # debugging, but the run ends red.\n      - name: Fail if any target produced no artifacts\n        if: ${{ steps.manifest.outputs.incomplete != '' }}\n        run: |\n          echo \"::error title=Incomplete desktop release::No artifacts from: ${{ steps.manifest.outputs.incomplete }}. SHA256SUMS.txt was published but covers only the targets that built.\"\n          exit 1\n",
