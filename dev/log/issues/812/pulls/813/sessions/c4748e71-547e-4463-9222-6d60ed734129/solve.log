[2026-07-20T18:50:14.051Z] [INFO]           "       needs.build.result == 'success' &&",
[2026-07-20T18:50:14.051Z] [INFO]           "-      needs.secrets-scan.result != 'failure' &&",
[2026-07-20T18:50:14.051Z] [INFO]           "-      needs.test-e2e-local.result != 'failure' &&",
[2026-07-20T18:50:14.051Z] [INFO]           "-      needs.test-agent-cli-e2e.result != 'failure'",
[2026-07-20T18:50:14.051Z] [INFO]           "+      (needs.secrets-scan.result == 'success' || needs.secrets-scan.result == 'skipped') &&",
[2026-07-20T18:50:14.051Z] [INFO]           "+      (needs.test-e2e-local.result == 'success' || needs.test-e2e-local.result == 'skipped') &&",
[2026-07-20T18:50:14.051Z] [INFO]           "+      (needs.test-agent-cli-e2e.result == 'success' || needs.test-agent-cli-e2e.result == 'skipped')",
[2026-07-20T18:50:14.051Z] [INFO]           "     runs-on: ubuntu-latest",
