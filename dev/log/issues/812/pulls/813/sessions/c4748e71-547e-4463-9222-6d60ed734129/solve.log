[2026-07-20T17:15:09.213Z] [INFO]     "content": [
[2026-07-20T17:15:09.213Z] [INFO]       {
[2026-07-20T17:15:09.213Z] [INFO]         "tool_use_id": "toolu_01FW9w47PKjYb7Pr2z25UXNN",
[2026-07-20T17:15:09.213Z] [INFO]         "type": "tool_result",
[2026-07-20T17:15:09.213Z] [INFO]         "content": "1\t# Cross-platform desktop release (Linux, Windows, macOS) for formal-ai.\n2\t#\n3\t# Produces the exact assets the /download page (src/web/download) resolves from\n4\t# the GitHub Releases API:\n5\t#   formal-ai-desktop-macos-<arch>-<version>.{dmg,zip}\n6\t#   formal-ai-desktop-windows-installer-<arch>-<version>.exe\n7\t#   formal-ai-desktop-windows-portable-<arch>-<version>.exe\n8\t#   formal-ai-desktop-linux-<arch>-<version>.{AppImage,deb,tar.gz}\n9\t#   latest.yml, latest-mac.yml, latest-linux.yml, and *.blockmap updater metadata\n10\t#   (Electron Builder emits x86_64/amd64 Linux x64 aliases; the build job\n11\t#    normalizes them to x64 before checksums/uploads and rewrites update metadata.)\n12\t# plus a consolidated SHA256SUMS.txt and BUILD-PROVENANCE.txt, and SLSA build\n13\t# provenance attestations (verifiable with `gh attestation verify`).\n14\t#\n15\t# Triggers:\n16\t#   * release: published     - fires for releases published manually (UI) or via\n17\t#                              a PAT. NOTE: the automated `[Rust] x.y.z` releases\n18\t#                              created by the CI/CD Pipeline use GITHUB_TOKEN, so\n19\t#                              GitHub suppresses the `release` event for them\n20\t#                              (recursion guard). The workflow_run trigger below\n21\t#                              covers that case automatically.\n22\t#   * workflow_run           - after the \"CI/CD Pipeline\" completes on main (with\n23\t#                              ANY conclusion except cancelled/skipped -- the\n24\t#                              release is published in an early job, so a later job\n25\t#                              failing must not suppress the desktop build), build\n26\t#                              desktop assets for the resolved release tag\n27\t#                              (idempotent: skips when assets already exist).\n28\t#   * workflow_dispatch      - manual rebuild for a specific (or latest) tag.\n29\tname: Desktop Release\n30\t\n31\ton:\n32\t  workflow_dispatch:\n33\t    inputs:\n34\t      tag:\n35\t        description: \"Release tag to build (e.g. v0.152.0). Leave blank for the latest release.\"\n36\t        required: false\n37\t        default: \"\"\n38\t  release:\n39\t    types: [published]\n40\t  workflow_run:\n41\t    workflows: [\"CI/CD Pipeline\"]\n42\t    types: [completed]\n43\t  # Issue #808: packaging and macOS signing used to run only after a release\n44\t  # existed, so a desktop regression was always discovered post-merge -- which is\n45\t  # exactly how the \"unsealed contents present in the root directory of an\n46\t  # embedded framework\" codesign failure reached main. On pull requests the same\n47\t  # build matrix runs in dry-run mode: everything up to and including the smoke\n48\t  # tests, with every publishing step (attest, release upload, SHA256SUMS)\n49\t  # skipped. Path-filtered so unrelated pull requests do not pay for six runners.\n50\t  pull_request:\n51\t    types: [opened, synchronize, reopened]\n52\t    paths:\n53\t      - 'desktop/**'\n54\t      - 'vscode/**'\n55\t      - '.github/workflows/desktop-release.yml'\n56\t      - 'scripts/desktop-release-resolve.sh'\n57\t      - 'scripts/install-node-dependencies.sh'\n58\t      # The build job runs `cargo build --release --bin formal-ai` and bundles\n59\t      # the result, so a Rust-only change can break desktop packaging while\n60\t      # touching none of the paths above. Without these entries that breakage is\n61\t      # a false negative on the pull request and only surfaces post-merge --\n62\t      # precisely the failure mode issue #808 was filed for.\n63\t      - 'src/**'\n64\t      - 'Cargo.toml'\n65\t      - 'Cargo.lock'\n66\t\n67\tpermissions:\n68\t  contents: read\n69\t\n70\tconcurrency:\n71\t  # The workflow_run path (the automatic one) carries neither release.tag_name\n72\t  # nor inputs.tag, so this fell through to the always-unique run_id and never\n73\t  # actually deduped: concurrent runs for the same tag raced each other on\n74\t  # `gh release upload --clobber` and on finalize's SHA256SUMS.txt. Key on the\n75\t  # commit for that path, which is what resolve maps to a tag.\n76\t  group: desktop-release-${{ github.event.pull_request.number || github.event.release.tag_name || github.event.inputs.tag || github.event.workflow_run.head_sha || github.run_id }}\n77\t  # Release runs must never be cancelled mid-upload; pull-request dry runs are\n78\t  # pure verification, so superseding pushes should cancel the stale six-runner\n79\t  # matrix instead of queueing behind it.\n80\t  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n81\t\n82\tenv:\n83\t  GIT_CONFIG_COUNT: '1'\n84\t  GIT_CONFIG_KEY_0: init.defaultBranch\n85\t  GIT_CONFIG_VALUE_0: main\n86\t  CARGO_NET_RETRY: '10'\n87\t  CARGO_HTTP_MULTIPLEXING: 'false'\n88\t  RUSTFLAGS: -Dwarnings\n89\t\n90\tjobs:\n91\t  resolve:\n92\t    name: Resolve target release\n93\t    runs-on: ubuntu-latest\n94\t    timeout-minutes: 10\n95\t    permissions:\n96\t      contents: read\n97\t    # For workflow_run, continue after ANY completed main-branch pipeline except\n98\t    # cancelled/skipped runs (issue #479). We intentionally do NOT gate on\n99\t    # conclusion == 'success': the auto-release publishes the GitHub release in an\n100\t    # EARLY pipeline job, so a LATER job failing (e.g. the E2E Pages probe timing\n101\t    # out) still leaves a real, asset-less release that desktop assets must heal.\n102\t    # Gating on full-pipeline green meant one unrelated late failure suppressed\n103\t    # every desktop build -> \"Not available in latest release\". The actual\n104\t    # decision to build is delegated to scripts/desktop-release-resolve.sh, whose\n105\t    # idempotency guard skips when the resolved release already carries desktop\n106\t    # assets, so running on a non-success conclusion is safe and self-healing.\n107\t    # Pull requests resolve nothing: there is no release to heal and no tag to\n108\t    # check out. The job is skipped and `build` admits the skipped dependency\n109\t    # explicitly, so the packaging matrix still runs against the PR head.\n110\t    if: >-\n111\t      github.event_name != 'pull_request' &&\n112\t      (github.event_name != 'workflow_run' ||\n113\t      (github.event.workflow_run.head_branch == 'main' &&\n114\t       github.event.workflow_run.conclusion != 'cancelled' &&\n115\t       github.event.workflow_run.conclusion != 'skipped'))\n116\t    outputs:\n117\t      tag: ${{ steps.pick.outputs.tag }}\n118\t      should_build: ${{ steps.pick.outputs.should_build }}\n119\t    steps:\n120\t      # Check out the repo so the resolve logic lives in a unit-tested script\n121\t      # (scripts/desktop-release-resolve.sh) instead of being inlined here. The\n122\t      # script only needs to *exist*; it queries the GitHub API for everything\n123\t      # else, so checking out the default ref is sufficient.\n124\t      - uses: actions/checkout@v6\n125\t\n126\t      - name: Resolve tag and whether desktop assets are needed\n127\t        id: pick\n128\t        env:\n129\t          GH_TOKEN: ${{ github.token }}\n130\t          EVENT: ${{ github.event_name }}\n131\t          INPUT_TAG: ${{ github.event.inputs.tag }}\n132\t          RELEASE_TAG: ${{ github.event.release.tag_name }}\n133\t          REPO: ${{ github.repository }}\n134\t          WORKFLOW_RUN_HEAD_SHA: ${{ github.event.workflow_run.head_sha }}\n135\t        # Issue #479: the automated release tags a CHILD \"chore: release vX.Y.Z\"\n136\t        # commit whose first parent is the completed CI head SHA, so matching the\n137\t        # tag to the head SHA directly always failed and desktop assets were\n138\t        # never built. desktop-release-resolve.sh resolves the latest release\n139\t        # instead (with a defensive exact-SHA tier and an idempotency guard) and\n140\t        # emits verbose ::group:: diagnostics for future debugging.\n141\t        run: bash scripts/desktop-release-resolve.sh\n142\t\n143\t  build:\n144\t    name: Build ${{ matrix.label }}\n145\t    needs: resolve\n146\t    # `resolve` is skipped on pull requests, and a skipped dependency would\n147\t    # normally skip this job too -- hence the explicit `!cancelled()`.\n148\t    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.resolve.outputs.should_build == 'true') }}\n149\t    strategy:\n150\t      fail-fast: false\n151\t      matrix:\n152\t        include:\n153\t          - { os: ubuntu-latest,    ebflag: \"--linux\", label: \"linux-x64\",     binext: \"\" }\n154\t          - { os: ubuntu-24.04-arm, ebflag: \"--linux\", label: \"linux-arm64\",   binext: \"\" }\n155\t          - { os: macos-15-intel,   ebflag: \"--mac\",   label: \"macos-x64\",     binext: \"\" }\n156\t          - { os: macos-14,         ebflag: \"--mac\",   label: \"macos-arm64\",   binext: \"\" }\n157\t          - { os: windows-latest,   ebflag: \"--win\",   label: \"windows-x64\",   binext: \".exe\" }\n158\t          - { os: windows-11-arm,   ebflag: \"--win\",   label: \"windows-arm64\", binext: \".exe\" }\n159\t    runs-on: ${{ matrix.os }}\n160\t    timeout-minutes: 30\n161\t    permissions:\n162\t      contents: write\n163\t      id-token: write\n164\t      attestations: write\n165\t    defaults:\n166\t      run:\n167\t        shell: bash\n168\t    steps:\n169\t      - uses: actions/checkout@v6\n170\t        with:\n171\t          # On pull requests there is no resolved tag: build the PR head, which\n172\t          # is the whole point of the dry run.\n173\t          ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}\n174\t\n175\t      - name: Install Rust toolchain\n176\t        uses: dtolnay/rust-toolchain@stable\n177\t\n178\t      - name: Cache cargo\n179\t        uses: actions/cache@v5\n180\t        with:\n181\t          path: |\n182\t            ~/.cargo/registry\n183\t            ~/.cargo/git\n184\t            target\n185\t          key: desktop-${{ matrix.label }}-cargo-${{ hashFiles('Cargo.lock', 'Cargo.toml') }}\n186\t\n187\t      - name: Build formal-ai binary (release)\n188\t        run: cargo build --release --bin formal-ai\n189\t\n190\t      - name: Setup Node\n191\t        uses: actions/setup-node@v6\n192\t        with:\n193\t          node-version: 22\n194\t\n195\t      - name: Install desktop dependencies\n196\t        run: scripts/install-node-dependencies.sh desktop\n197\t\n198\t      - name: Prepare desktop resources (web + bundled binary + version sync)\n199\t        working-directory: desktop\n200\t        run: node scripts/prepare-resources.mjs\n201\t\n202\t      - name: Check macOS signing secrets\n203\t        if: matrix.ebflag == '--mac'\n204\t        id: mac_secrets\n205\t        env:\n206\t          MAC_CSC_LINK: ${{ secrets.MAC_CSC_LINK }}\n207\t          MAC_CSC_KEY_PASSWORD: ${{ secrets.MAC_CSC_KEY_PASSWORD }}\n208\t          APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}\n209\t          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}\n210\t          APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}\n211\t        run: |\n212\t          set -euo pipefail\n213\t          missing=()\n214\t          for name in MAC_CSC_LINK MAC_CSC_KEY_PASSWORD APPLE_API_KEY APPLE_API_KEY_ID APPLE_API_ISSUER; do\n215\t            if [ -z \"${!name}\" ]; then\n216\t              missing+=(\"$name\")\n217\t            fi\n218\t          done\n219\t\n220\t          if [ \"${#missing[@]}\" -gt 0 ]; then\n221\t            echo \"has_secrets=false\" >> \"$GITHUB_OUTPUT\"\n222\t            echo \"mode=adhoc\" >> \"$GITHUB_OUTPUT\"\n223\t            echo \"::notice::macOS signing/notarization secrets are not configured: ${missing[*]}\"\n224\t            echo \"Building ad-hoc signed macOS artifacts without notarization for direct testing.\"\n225\t          else\n226\t            echo \"has_secrets=true\" >> \"$GITHUB_OUTPUT\"\n227\t            echo \"mode=signed\" >> \"$GITHUB_OUTPUT\"\n228\t          fi\n229\t\n230\t      - name: Package desktop app (Linux/Windows)\n231\t        if: matrix.ebflag != '--mac'\n232\t        working-directory: desktop\n233\t        env:\n234\t          CSC_IDENTITY_AUTO_DISCOVERY: \"false\"\n235\t        run: npx --no-install electron-builder ${{ matrix.ebflag }} --publish never\n236\t\n237\t      - name: Package desktop app (macOS signed)\n238\t        if: matrix.ebflag == '--mac' && steps.mac_secrets.outputs.has_secrets == 'true'\n239\t        working-directory: desktop\n240\t        env:\n241\t          CSC_LINK: ${{ secrets.MAC_CSC_LINK }}\n242\t          CSC_KEY_PASSWORD: ${{ secrets.MAC_CSC_KEY_PASSWORD }}\n243\t          APPLE_API_KEY: ${{ secrets.APPLE_API_KEY }}\n244\t          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}\n245\t          APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}\n246\t          DEBUG: electron-builder,electron-notarize*\n247\t        run: npx --no-install electron-builder ${{ matrix.ebflag }} --publish never\n248\t\n249\t      # Issue #479: electron-builder 26 changed macOS signing control flow. Its\n250\t      # MacPackager.sign() now calls findSigningIdentity(), which returns null --\n251\t      # skipping signing entirely and NEVER invoking the custom `mac.sign` hook --\n252\t      # unless a real identity is found OR `mac.identity` is exactly \"-\" (ad-hoc).\n253\t      # See packages/app-builder-lib/src/targets/mac/MacTargetHelper.ts: only the\n254\t      # `qualifier === \"-\"` branch yields an Identity when no certificate exists.\n255\t      # Without `-c.mac.identity=-` the produced .app had no _CodeSignature, so the\n256\t      # pre-upload smoke test failed with \"missing its signed CodeResources\n257\t      # envelope\" and macOS assets were never published. Passing identity=\"-\" makes\n258\t      # electron-builder reach doSign(), which runs our ad-hoc hook (deep ad-hoc\n259\t      # sign via @electron/osx-sign + an explicit root-bundle re-seal).\n260\t      - name: Package desktop app (macOS ad-hoc)\n261\t        if: matrix.ebflag == '--mac' && steps.mac_secrets.outputs.has_secrets != 'true'\n262\t        working-directory: desktop\n263\t        env:\n264\t          CSC_IDENTITY_AUTO_DISCOVERY: \"false\"\n265\t          MACOS_ADHOC_SIGN: \"1\"\n266\t          # Issue #808: electron-builder's isSignAllowed() bails out with\n267\t          # \"Current build is a part of pull request, code signing will be\n268\t          # skipped\" whenever GITHUB_BASE_REF is set (builder-util\n269\t          # `isPullRequest()`), so the pull-request dry run produced an unsigned\n270\t          # .app with no CodeResources and the smoke test failed. The security\n271\t          # warning attached to this flag is about *secret* certificates leaking\n272\t          # to fork builds; this step only runs when no signing secrets exist and\n273\t          # signs ad-hoc with identity `-`, so there is nothing to leak.\n274\t          CSC_FOR_PULL_REQUEST: \"true\"\n275\t          FORMAL_AI_MACOS_SIGN_DEBUG: \"1\"\n276\t          DEBUG: electron-builder,electron-osx-sign*\n277\t        run: npx --no-install electron-builder ${{ matrix.ebflag }} --publish never -c.mac.notarize=false -c.mac.identity=- -c.mac.sign=./scripts/adhoc-sign-mac.cjs\n278\t\n279\t      - name: Normalize desktop artifact names\n280\t        working-directory: desktop\n281\t        run: node scripts/normalize-artifacts.mjs\n282\t\n283\t      - name: Smoke test macOS release artifacts\n284\t        if: matrix.ebflag == '--mac'\n285\t        working-directory: desktop\n286\t        env:\n287\t          MACOS_BUILD_MODE: ${{ steps.mac_secrets.outputs.mode }}\n288\t        run: |\n289\t          set -euo pipefail\n290\t          shopt -s nullglob\n291\t\n292\t          VERSION=\"$(node -p \"require('./package.json').version\")\"\n293\t          case \"${{ matrix.label }}\" in\n294\t            macos-x64) ARCH=\"x64\" ;;\n295\t            macos-arm64) ARCH=\"arm64\" ;;\n296\t            *)\n297\t              echo \"::error::Unexpected macOS matrix label: ${{ matrix.label }}\"\n298\t              exit 1\n299\t              ;;\n300\t          esac\n301\t\n302\t          required_macos_artifacts=(\n303\t            \"release/formal-ai-desktop-macos-${ARCH}-${VERSION}.dmg\"\n304\t            \"release/formal-ai-desktop-macos-${ARCH}-${VERSION}.zip\"\n305\t          )\n306\t          for artifact in \"${required_macos_artifacts[@]}\"; do\n307\t            if [ ! -f \"$artifact\" ]; then\n308\t              echo \"::error file=$artifact::Expected versioned macOS release artifact was not created.\"\n309\t              ls -la release || true\n310\t              exit 1\n311\t            fi\n312\t          done\n313\t\n314\t          for dmg in \"release/formal-ai-desktop-macos-${ARCH}-${VERSION}.dmg\"; do\n315\t            echo \"Mounting DMG: $dmg\"\n316\t            mount_dir=\"$(mktemp -d)\"\n317\t            installed_app=\"$RUNNER_TEMP/formal-ai Desktop.app\"\n318\t\n319\t            hdiutil attach \"$dmg\" -mountpoint \"$mount_dir\" -nobrowse -readonly\n320\t            mounted_app=\"$mount_dir/formal-ai Desktop.app\"\n321\t\n322\t            if [ ! -d \"$mounted_app\" ]; then\n323\t              echo \"::error file=$dmg::Mounted DMG does not contain formal-ai Desktop.app.\"\n324\t              find \"$mount_dir\" -maxdepth 2 -print\n325\t              hdiutil detach \"$mount_dir\"\n326\t              exit 1\n327\t            fi\n328\t\n329\t            rm -rf \"$installed_app\"\n330\t            ditto \"$mounted_app\" \"$installed_app\"\n331\t            hdiutil detach \"$mount_dir\"\n332\t\n333\t            app_info=\"$installed_app/Contents/Info.plist\"\n334\t            executable=\"$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' \"$app_info\")\"\n335\t            bundle_id=\"$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \"$app_info\")\"\n336\t\n337\t            if [ \"$bundle_id\" != \"ai.formal.desktop\" ]; then\n338\t              echo \"::error file=$dmg::Unexpected macOS app bundle identifier: $bundle_id\"\n339\t              exit 1\n340\t            fi\n341\t\n342\t            if [ ! -x \"$installed_app/Contents/MacOS/$executable\" ]; then\n343\t              echo \"::error file=$dmg::Mounted app executable is missing or not executable.\"\n344\t              find \"$installed_app/Contents\" -maxdepth 3 -print\n345\t              exit 1\n346\t            fi\n347\t\n348\t            if [ ! -f \"$installed_app/Contents/_CodeSignature/CodeResources\" ]; then\n349\t              echo \"::error file=$dmg::Mounted app is missing its signed CodeResources envelope.\"\n350\t              find \"$installed_app/Contents/_CodeSignature\" -maxdepth 1 -print 2>/dev/null || true\n351\t              exit 1\n352\t            fi\n353\t\n354\t            codesign --verify --deep --strict --verbose=2 \"$installed_app\"\n355\t\n356\t            if [ \"$MACOS_BUILD_MODE\" = \"signed\" ]; then\n357\t              spctl --assess --type execute --verbose=4 \"$installed_app\"\n358\t              xcrun stapler validate \"$installed_app\"\n359\t            else\n360\t              codesign --display --verbose=2 \"$installed_app\" 2>&1 | tee \"$RUNNER_TEMP/formal-ai-macos-codesign.txt\"\n361\t              if ! grep -Fq 'Signature=adhoc' \"$RUNNER_TEMP/formal-ai-macos-codesign.txt\"; then\n362\t                echo \"::error file=$dmg::Expected ad-hoc macOS signature for no-Apple-account build.\"\n363\t                exit 1\n364\t              fi\n365\t            fi\n366\t          done\n367\t\n368\t      # The macOS smoke test above is the only artifact verification this\n369\t      # workflow had, so the four Linux/Windows targets were uploaded to the\n370\t      # release with nothing checking that electron-builder actually produced\n371\t      # them under the expected names. A rename or a partial package silently\n372\t      # shipped. The deep checks are macOS-only by nature (hdiutil, codesign),\n373\t      # but existence and non-emptiness are checkable everywhere.\n374\t      - name: Smoke test Linux/Windows release artifacts\n375\t        if: matrix.ebflag != '--mac'\n376\t        shell: bash\n377\t        working-directory: desktop\n378\t        run: |\n379\t          set -euo pipefail\n380\t\n381\t          VERSION=\"$(node -p \"require('./package.json').version\")\"\n382\t          case \"${{ matrix.label }}\" in\n383\t            linux-x64|linux-arm64)\n384\t              ARCH=\"${{ matrix.label }}\"; ARCH=\"${ARCH#linux-}\"\n385\t              required=(\n386\t                \"release/formal-ai-desktop-linux-${ARCH}-${VERSION}.AppImage\"\n387\t                \"release/formal-ai-desktop-linux-${ARCH}-${VERSION}.deb\"\n388\t                \"release/formal-ai-desktop-linux-${ARCH}-${VERSION}.tar.gz\"\n389\t              )\n390\t              ;;\n391\t            windows-x64|windows-arm64)\n392\t              ARCH=\"${{ matrix.label }}\"; ARCH=\"${ARCH#windows-}\"\n393\t              required=(\n394\t                \"release/formal-ai-desktop-windows-installer-${ARCH}-${VERSION}.exe\"\n395\t                \"release/formal-ai-desktop-windows-portable-${ARCH}-${VERSION}.exe\"\n396\t              )\n397\t              ;;\n398\t            *)\n399\t              echo \"::error::Unexpected matrix label for the Linux/Windows smoke test: ${{ matrix.label }}\"\n400\t              exit 1\n401\t              ;;\n402\t          esac\n403\t\n404\t          failed=0\n405\t          for artifact in \"${required[@]}\"; do\n406\t            if [ ! -f \"$artifact\" ]; then\n407\t              echo \"::error file=$artifact::Expected versioned release artifact was not created.\"\n408\t              failed=1\n409\t            elif [ ! -s \"$artifact\" ]; then\n410\t              echo \"::error file=$artifact::Release artifact is empty.\"\n411\t              failed=1\n412\t            else\n413\t              echo \"ok $artifact ($(wc -c < \"$artifact\") bytes)\"\n414\t            fi\n415\t          done\n416\t          if [ \"$failed\" -ne 0 ]; then\n417\t            ls -la release || true\n418\t            exit 1\n419\t          fi\n420\t\n421\t      - name: Collect artifacts and checksums\n422\t        id: collect\n423\t        working-directory: desktop\n424\t        run: |\n425\t          set -euo pipefail\n426\t          files=()\n427\t          for f in release/formal-ai-desktop-*; do\n428\t            case \"$f\" in\n429\t              *.dmg|*.zip|*.exe|*.AppImage|*.deb|*.tar.gz|*.blockmap) files+=(\"$f\") ;;\n430\t            esac\n431\t          done\n432\t          for f in release/latest.yml release/latest-mac.yml release/latest-linux.yml; do\n433\t            [ -f \"$f\" ] && files+=(\"$f\")\n434\t          done\n435\t          if [ ${#files[@]} -eq 0 ]; then\n436\t            echo \"No desktop artifacts produced for ${{ matrix.label }}\" >&2\n437\t            exit 1\n438\t          fi\n439\t          printf 'Artifacts:\\n'; printf '  %s\\n' \"${files[@]}\"\n440\t          # Standard `sha256sum`-format lines with bare filenames so the\n441\t          # in-browser verifier on the /download page can match by name.\n442\t          node -e '\n443\t            const fs = require(\"fs\"); const cp = require(\"crypto\"); const path = require(\"path\");\n444\t            const dir = \"release\";\n445\t            const re = /^(formal-ai-desktop-.*\\.(dmg|zip|exe|AppImage|deb|tar\\.gz|blockmap)|latest(-mac|-linux)?\\.yml)$/;\n446\t            const names = fs.readdirSync(dir).filter((n) => re.test(n)).sort();\n447\t            for (const n of names) {\n448\t              const hash = cp.createHash(\"sha256\").update(fs.readFileSync(path.join(dir, n))).digest(\"hex\");\n449\t              process.stdout.write(hash + \"  \" + n + \"\\n\");\n450\t            }\n451\t          ' > \"release/SHA256SUMS-${{ matrix.label }}.partial\"\n452\t          cat \"release/SHA256SUMS-${{ matrix.label }}.partial\"\n453\t\n454\t      # Attest before publishing, not after: uploading first left the assets\n455\t      # downloadable for the length of the attest step, and permanently so if\n456\t      # attest failed, with `gh attestation verify` unable to vouch for them.\n457\t      - name: Attest build provenance\n458\t        # Dry run: a pull request has nothing to attest and no release to\n459\t        # publish to. Everything above -- packaging, signing, smoke tests -- has\n460\t        # already run, which is what catches desktop regressions before merge.\n461\t        if: github.event_name != 'pull_request'\n462\t        uses: actions/attest@v4\n463\t        with:\n464\t          # The released v4 checksum parser splits with the runner's native EOL,\n465\t          # so it treats our intentionally portable LF manifest as one record on\n466\t          # Windows. Digest the artifacts directly; keep the checksum fragment\n467\t          # solely for the consolidated, user-facing SHA256SUMS.txt.\n468\t          subject-path: |\n469\t            desktop/release/formal-ai-desktop-*\n470\t            desktop/release/latest*.yml\n471\t\n472\t      - name: Upload assets to release\n473\t        if: github.event_name != 'pull_request'\n474\t        working-directory: desktop\n475\t        env:\n476\t          GH_TOKEN: ${{ github.token }}\n477\t          REPO: ${{ github.repository }}\n478\t          TAG: ${{ needs.resolve.outputs.tag }}\n479\t        run: |\n480\t          set -euo pipefail\n481\t          files=()\n482\t          for f in release/formal-ai-desktop-*; do\n483\t            case \"$f\" in\n484\t              *.dmg|*.zip|*.exe|*.AppImage|*.deb|*.tar.gz|*.blockmap) files+=(\"$f\") ;;\n485\t            esac\n486\t          done\n487\t          for f in release/latest.yml release/latest-mac.yml release/latest-linux.yml; do\n488\t            [ -f \"$f\" ] && files+=(\"$f\")\n489\t          done\n490\t          gh release upload \"$TAG\" \"${files[@]}\" --repo \"$REPO\" --clobber\n491\t\n492\t      - name: Upload checksum fragment\n493\t        uses: actions/upload-artifact@v7\n494\t        with:\n495\t          name: checksums-${{ matrix.label }}\n496\t          path: desktop/release/SHA256SUMS-${{ matrix.label }}.partial\n497\t          retention-days: 7\n498\t\n499\t  vscode:\n500\t    name: Package VS Code extension (.vsix)\n501\t    needs: resolve\n502\t    # Same skipped-dependency handling as `build`; see the comment there.\n503\t    if: ${{ !cancelled() && (github.event_name == 'pull_request' || needs.resolve.outputs.should_build == 'true') }}\n504\t    runs-on: ubuntu-latest\n505\t    timeout-minutes: 15\n506\t    permissions:\n507\t      contents: write\n508\t      id-token: write\n509\t      attestations: write\n510\t    defaults:\n511\t      run:\n512\t        shell: bash\n513\t    steps:\n514\t      - uses: actions/checkout@v6\n515\t        with:\n516\t          # On pull requests there is no resolved tag: build the PR head, which\n517\t          # is the whole point of the dry run.\n518\t          ref: ${{ github.event_name != 'pull_request' && needs.resolve.outputs.tag || '' }}\n519\t\n520\t      - name: Setup Node\n521\t        uses: actions/setup-node@v6\n522\t        with:\n523\t          node-version: 22\n524\t\n525\t      # No committed lockfile under vscode/ (the extension's only deps are the\n526\t      # packaging dev-tools), so a plain install is used rather than `npm ci`.\n527\t      - name: Install extension dependencies\n528\t        run: scripts/install-node-dependencies.sh vscode\n529\t\n530\t      - name: Package the .vsix\n531\t        id: package\n532\t        working-directory: vscode\n533\t        run: |\n534\t          set -euo pipefail\n535\t          # `vscode:prepublish` (prepare-resources.mjs) syncs the extension\n536\t          # version from Cargo.toml and copies src/web + data/seed + desktop/lib\n537\t          # into the package, so the .vsix is fully self-contained and its\n538\t          # filename (formal-ai-vscode-<version>.vsix) matches the release\n539\t          # version the /download and /vscode pages resolve.\n540\t          npm run package\n541\t          vsix=\"$(ls formal-ai-vscode-*.vsix 2>/dev/null | head -n1)\"\n542\t          [ -n \"$vsix\" ] || { echo \"::error::vsce package produced no .vsix\" >&2; exit 1; }\n543\t          echo \"vsix=$vsix\" >> \"$GITHUB_OUTPUT\"\n544\t          echo \"Packaged: $vsix\"\n545\t\n546\t      - name: Collect .vsix checksum fragment\n547\t        working-directory: vscode\n548\t        run: |\n549\t          set -euo pipefail\n550\t          # Same `sha256sum`-format line (bare filename) as the desktop build job\n551\t          # so the consolidated SHA256SUMS.txt covers the .vsix too, and both the\n552\t          # /download verifier and install.sh can match it by name.\n553\t          node -e '\n554\t            const fs = require(\"fs\"); const cp = require(\"crypto\");\n555\t            const n = fs.readdirSync(\".\").filter((f) => /^formal-ai-vscode-.*\\.vsix$/.test(f)).sort()[0];\n556\t            if (!n) { process.exit(1); }\n557\t            const hash = cp.createHash(\"sha256\").update(fs.readFileSync(n)).digest(\"hex\");\n558\t            process.stdout.write(hash + \"  \" + n + \"\\n\");\n559\t          ' > SHA256SUMS-vscode.partial\n560\t          cat SHA256SUMS-vscode.partial\n561\t\n562\t      # Attest before publishing; see the same step in the desktop build job.\n563\t      - name: Attest build provenance\n564\t        if: github.event_name != 'pull_request'\n565\t        uses: actions/attest@v4\n566\t        with:\n567\t          subject-path: vscode/formal-ai-vscode-*.vsix\n568\t\n569\t      - name: Upload .vsix to release\n570\t        if: github.event_name != 'pull_request'\n571\t        working-directory: vscode\n572\t        env:\n573\t          GH_TOKEN: ${{ github.token }}\n574\t          REPO: ${{ github.repository }}\n575\t          TAG: ${{ needs.resolve.outputs.tag }}\n576\t        run: gh release upload \"$TAG\" \"${{ steps.package.outputs.vsix }}\" --repo \"$REPO\" --clobber\n577\t\n578\t      - name: Upload checksum fragment\n579\t        uses: actions/upload-artifact@v7\n580\t        with:\n581\t          name: checksums-vscode\n582\t          path: vscode/SHA256SUMS-vscode.partial\n583\t          retention-days: 7\n584\t\n585\t  finalize:\n586\t    name: Publish SHA256SUMS.txt + provenance\n587\t    needs: [resolve, build, vscode]\n588\t    # always() so a partial matrix (one arch failing under fail-fast:false) still\n589\t    # publishes checksums for the arches that did build.\n590\t    # Never on pull requests: there is no release to publish checksums to.\n591\t    if: ${{ always() && github.event_name != 'pull_request' && needs.resolve.outputs.should_build == 'true' }}\n592\t    runs-on: ubuntu-latest\n593\t    timeout-minutes: 10\n594\t    permissions:\n595\t      actions: read\n596\t      contents: write\n597\t    steps:\n598\t      - name: Download checksum fragments\n599\t        uses: actions/download-artifact@v8\n600\t        env:\n601\t          # v8's bundled unzip dependency still calls Buffer(); suppress only\n602\t          # that reviewed upstream diagnostic, never all Node warnings:\n603\t          # https://github.com/actions/download-artifact/issues/484\n604\t          NODE_OPTIONS: --disable-warning=DEP0005\n605\t        with:\n606\t          pattern: checksums-*\n607\t          path: fragments\n608\t          merge-multiple: true\n609\t\n610\t      - name: Build consolidated SHA256SUMS.txt and BUILD-PROVENANCE.txt\n611\t        id: manifest\n612\t        env:\n613\t          GH_TOKEN: ${{ github.token }}\n614\t          REPO: ${{ github.repository }}\n615\t          TAG: ${{ needs.resolve.outputs.tag }}\n616\t          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}\n617\t        run: |\n618\t          set -euo pipefail\n619\t          shopt -s nullglob\n620\t          parts=(fragments/*.partial)\n621\t          if [ ${#parts[@]} -eq 0 ]; then\n622\t            echo \"No checksum fragments were produced; nothing to finalize.\" >&2\n623\t            exit 1\n624\t          fi\n625\t          # Deterministic order: concatenate fragments, sort by filename (field 2).\n626\t          cat \"${parts[@]}\" | sort -k2 > SHA256SUMS.txt\n627\t          echo \"=== SHA256SUMS.txt ===\"\n628\t          cat SHA256SUMS.txt\n629\t          commit=\"$(gh release view \"$TAG\" --repo \"$REPO\" --json targetCommitish --jq .targetCommitish || echo unknown)\"\n630\t\n631\t          # Report the builders that actually produced a fragment. Hardcoding the\n632\t          # full matrix here claimed builds that never happened whenever an arch\n633\t          # failed under fail-fast: false.\n634\t          declare -A builder_of=(\n635\t            [linux-x64]=\"ubuntu-latest\"\n636\t            [linux-arm64]=\"ubuntu-24.04-arm\"\n637\t            [macos-x64]=\"macos-15-intel\"\n638\t            [macos-arm64]=\"macos-14\"\n639\t            [windows-x64]=\"windows-latest\"\n640\t            [windows-arm64]=\"windows-11-arm\"\n641\t            [vscode]=\"ubuntu-latest\"\n642\t          )\n643\t          built=()\n644\t          missing=()\n645\t          for label in linux-x64 linux-arm64 macos-x64 macos-arm64 windows-x64 windows-arm64 vscode; do\n646\t            if [ -f \"fragments/SHA256SUMS-${label}.partial\" ]; then\n647\t              built+=(\"${builder_of[$label]} (${label})\")\n648\t            else\n649\t              missing+=(\"$label\")\n650\t            fi\n651\t          done\n652\t\n653\t          {\n654\t            echo \"formal-ai Desktop build provenance\"\n655\t            echo \"==================================\"\n656\t            echo \"Repository : $REPO\"\n657\t            echo \"Release tag: $TAG\"\n658\t            echo \"Commitish  : $commit\"\n659\t            echo \"Workflow   : Desktop Release\"\n660\t            echo \"Run        : $RUN_URL\"\n661\t            printf 'Builders   : %s\\n' \"${built[0]}\"\n662\t            printf '             %s\\n' \"${built[@]:1}\"\n663\t            if [ ${#missing[@]} -gt 0 ]; then\n664\t              echo \"INCOMPLETE : no artifacts from: ${missing[*]}\"\n665\t              echo \"             This release is missing those targets; the checksums\"\n666\t              echo \"             below cover only the builders listed above.\"\n667\t            fi\n668\t            echo \"Signing    : macOS artifacts are ad-hoc signed (no Apple Developer ID).\"\n669\t            echo \"Attestation: SLSA build provenance attached via actions/attest.\"\n670\t            echo \"             Verify with: gh attestation verify <file> --repo $REPO\"\n671\t            echo \"\"\n672\t            # Deliberately not \"authoritative\": when `missing` is non-empty this\n673\t            # manifest covers only part of the release, and calling it\n674\t            # authoritative is exactly the false positive we are fixing.\n675\t            echo \"SHA-256 checksums of the artifacts listed above (SHA256SUMS.txt is the machine-readable copy):\"\n676\t            echo \"\"\n677\t            cat SHA256SUMS.txt\n678\t          } > BUILD-PROVENANCE.txt\n679\t          echo \"=== BUILD-PROVENANCE.txt ===\"\n680\t          cat BUILD-PROVENANCE.txt\n681\t\n682\t          # Still upload what we have (a partial manifest beats none), but never\n683\t          # report success for it: a green run here means \"all desktop assets\n684\t          # shipped\", and callers rely on that.\n685\t          if [ ${#missing[@]} -gt 0 ]; then\n686\t            echo \"incomplete=${missing[*]}\" >> \"$GITHUB_OUTPUT\"\n687\t          fi\n688\t\n689\t      - name: Upload SHA256SUMS.txt and BUILD-PROVENANCE.txt to release\n690\t        env:\n691\t          GH_TOKEN: ${{ github.token }}\n692\t          REPO: ${{ github.repository }}\n693\t          TAG: ${{ needs.resolve.outputs.tag }}\n694\t        run: |\n695\t          set -euo pipefail\n696\t          gh release upload \"$TAG\" SHA256SUMS.txt BUILD-PROVENANCE.txt --repo \"$REPO\" --clobber\n697\t\n698\t      # Runs after the upload so the partial manifest is still published for\n699\t      # debugging, but the run ends red.\n700\t      - name: Fail if any target produced no artifacts\n701\t        if: ${{ steps.manifest.outputs.incomplete != '' }}\n702\t        run: |\n703\t          echo \"::error title=Incomplete desktop release::No artifacts from: ${{ steps.manifest.outputs.incomplete }}. SHA256SUMS.txt was published but covers only the targets that built.\"\n704\t          exit 1\n705\t"
