[2026-07-20T17:50:42.943Z] [INFO]         "content": "210\t      # is the whole point of the dind image variant.\n211\t      - name: Verify image runtime contract\n212\t        run: |\n213\t          set -euo pipefail\n214\t          docker run --rm --privileged formal-ai:pr-check verify-formal-ai-dind\n215\t\n216\t  # === SECRETS SCAN ===\n217\t  # Issue #808 / R5 (CI-CD-BEST-PRACTICES.md section 11): no secrets scan\n218\t  # existed anywhere in this pipeline. secretlint is language-agnostic, so it\n219\t  # applies to a Rust repository unchanged; .secretlintrc.json selects the\n220\t  # recommended preset.\n221\t  #\n222\t  # Scoped to the files the change touches, not the whole tree: measured, a\n223\t  # full-tree `secretlint \"**/*\"` (what the js template runs) had not finished\n224\t  # after 25 minutes on this repository, because the glob walks `target/` and\n225\t  # ~150 MB of committed case-study logs. A gate that may not finish is itself a\n226\t  # new CI failure mode. Scanning the diff catches a credential being\n227\t  # *introduced*, which is the case that matters, and takes ~3 seconds; run\n228\t  # `bash scripts/check-secrets.sh --all` locally to audit everything.\n229\t  secrets-scan:\n230\t    name: Secrets Scan\n231\t    runs-on: ubuntu-latest\n232\t    timeout-minutes: 10\n233\t    needs: [detect-changes]\n234\t    if: |\n235\t      !cancelled() && (\n236\t        github.event_name == 'push' ||\n237\t        github.event_name == 'workflow_dispatch' ||\n238\t        needs.detect-changes.outputs.any-code-changed == 'true' ||\n239\t        needs.detect-changes.outputs.docs-changed == 'true' ||\n240\t        needs.detect-changes.outputs.workflow-changed == 'true'\n241\t      )\n242\t    steps:\n243\t      - uses: actions/checkout@v6\n244\t        with:\n245\t          # check-secrets.sh diffs against the base branch / previous commit.\n246\t          fetch-depth: 0\n247\t\n248\t      - name: Setup Node\n249\t        uses: actions/setup-node@v6\n250\t        with:\n251\t          node-version: 22\n252\t\n253\t      - name: Check for secrets\n254\t        env:\n255\t          # pull_request -> base branch; push -> the pre-push SHA;\n256\t          # workflow_dispatch has neither, so scan the tip commit.\n257\t          BASE_REF: ${{ github.base_ref || github.event.before || 'HEAD~1' }}\n258\t        run: bash scripts/check-secrets.sh\n259\t\n260\t  # === VERSION CHECK - prevents manual version modification in PRs ===\n261\t  # This ensures versions are only modified by the automated release pipeline\n262\t  version-check:\n263\t    name: Version Modification Check\n264\t    runs-on: ubuntu-latest\n265\t    timeout-minutes: 5\n266\t    if: github.event_name == 'pull_request'\n267\t    steps:\n268\t      - uses: actions/checkout@v6\n269\t        with:\n270\t          fetch-depth: 0\n271\t"
