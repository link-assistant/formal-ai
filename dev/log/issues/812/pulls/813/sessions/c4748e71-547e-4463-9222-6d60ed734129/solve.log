EPO\" --json tagName --jq .tagName 2>/dev/null || true\n}\n=== callers ===\n.github/workflows/desktop-release.yml:56:      - 'scripts/desktop-release-resolve.sh'\n.github/workflows/desktop-release.yml:104:    # decision to build is delegated to scripts/desktop-release-resolve.sh, whose\n.github/workflows/desktop-release.yml:121:      # (scripts/desktop-release-resolve.sh) instead of being inlined here. The\n.github/workflows/desktop-release.yml:138:        # never built. desktop-release-resolve.sh resolves the latest release\n.github/workflows/desktop-release.yml:141:        run: bash scripts/desktop-release-resolve.sh",
