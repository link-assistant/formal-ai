[2026-07-20T17:15:37.931Z] [INFO]         "content": "1\tname: CI/CD Pipeline\n2\t\n3\ton:\n4\t  push:\n5\t    branches:\n6\t      - main\n7\t  pull_request:\n8\t    types: [opened, synchronize, reopened]\n9\t  workflow_dispatch:\n10\t    inputs:\n11\t      release_mode:\n12\t        description: 'Manual release mode'\n13\t        required: true\n14\t        type: choice\n15\t        default: 'instant'\n16\t        options:\n17\t          - instant\n18\t          - changelog-pr\n19\t      bump_type:\n20\t        description: 'Version bump type'\n21\t        required: true\n22\t        type: choice\n23\t        options:\n24\t          - patch\n25\t          - minor\n26\t          - major\n27\t      description:\n28\t        description: 'Release description (optional)'\n29\t        required: false\n30\t        type: string\n31\t\n32\t# Least-privilege default for every job; jobs that need more escalate explicitly.\n33\tpermissions:\n34\t  contents: read\n35\t\n36\tconcurrency:\n37\t  group: ${{ github.workflow }}-${{ github.ref }}\n38\t  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}\n39\t\n40\tenv:\n41\t  CARGO_TERM_COLOR: always\n42\t  RUSTFLAGS: -Dwarnings\n43\t  # Provide Git's initial branch before actions/checkout runs git init so\n44\t  # Git 2.54+ does not emit the upcoming Git 3.0 default-branch hint.\n45\t  GIT_CONFIG_COUNT: '1'\n46\t  GIT_CONFIG_KEY_0: init.defaultBranch\n47\t  GIT_CONFIG_VALUE_0: main\n48\t  # Harden Cargo registry index and crate downloads against transient network\n49\t  # flakes on GitHub-hosted runners, including curl HTTP/2 framing failures.\n50\t  CARGO_NET_RETRY: '10'\n51\t  CARGO_HTTP_MULTIPLEXING: 'false'\n52\t  # Support both CARGO_REGISTRY_TOKEN (cargo's native env var) and CARGO_TOKEN (for backwards compatibility)\n53\t  CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n54\t  CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n55\t  # Optional: set repository variable DOCKERHUB_IMAGE to namespace/image to publish Docker Hub releases.\n56\t  DOCKERHUB_IMAGE: ${{ vars.DOCKERHUB_IMAGE }}\n57\t\n58\tjobs:\n59\t  # === DETECT CHANGES - determines which jobs should run ===\n60\t  detect-changes:\n61\t    name: Detect Changes\n62\t    runs-on: ubuntu-latest\n63\t    timeout-minutes: 5\n64\t    if: github.event_name != 'workflow_dispatch'\n65\t    outputs:\n66\t      rs-changed: ${{ steps.changes.outputs.rs-changed }}\n67\t      toml-changed: ${{ steps.changes.outputs.toml-changed }}\n68\t      docs-changed: ${{ steps.changes.outputs.docs-changed }}\n69\t      workflow-changed: ${{ steps.changes.outputs.workflow-changed }}\n70\t      any-code-changed: ${{ steps.changes.outputs.any-code-changed }}\n71\t    steps:\n72\t      - uses: actions/checkout@v6\n73\t        with:\n74\t          fetch-depth: 0\n75\t\n76\t      - name: Setup Rust\n77\t        uses: dtolnay/rust-toolchain@stable\n78\t\n79\t      - name: Install rust-script\n80\t        run: ./scripts/install-rust-script.sh\n81\t\n82\t      - name: Detect changes\n83\t        id: changes\n84\t        env:\n85\t          GITHUB_EVENT_NAME: ${{ github.event_name }}\n86\t        run: rust-script scripts/detect-code-changes.rs\n87\t\n88\t  # === CHANGELOG CHECK - only runs on PRs with code changes ===\n89\t  # Docs-only PRs (./docs folder, markdown files) don't require changelog fragments\n90\t  changelog:\n91\t    name: Changelog Fragment Check\n92\t    runs-on: ubuntu-latest\n93\t    timeout-minutes: 10\n94\t    needs: [detect-changes]\n95\t    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n96\t    steps:\n97\t      - uses: actions/checkout@v6\n98\t        with:\n99\t          fetch-depth: 0\n100\t\n101\t      - name: Setup Rust\n102\t        uses: dtolnay/rust-toolchain@stable\n103\t\n104\t      - name: Install rust-script\n105\t        run: ./scripts/install-rust-script.sh\n106\t\n107\t      - name: Check for changelog fragments\n108\t        env:\n109\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n110\t        run: rust-script scripts/check-changelog-fragment.rs\n111\t\n112\t  # === VERSION CHECK - prevents manual version modification in PRs ===\n113\t  # This ensures versions are only modified by the automated release pipeline\n114\t  version-check:\n115\t    name: Version Modification Check\n116\t    runs-on: ubuntu-latest\n117\t    timeout-minutes: 5\n118\t    if: github.event_name == 'pull_request'\n119\t    steps:\n120\t      - uses: actions/checkout@v6\n121\t        with:\n122\t          fetch-depth: 0\n123\t\n124\t      - name: Setup Rust\n125\t        uses: dtolnay/rust-toolchain@stable\n126\t\n127\t      - name: Install rust-script\n128\t        run: ./scripts/install-rust-script.sh\n129\t\n130\t      - name: Check for manual version changes\n131\t        env:\n132\t          GITHUB_EVENT_NAME: ${{ github.event_name }}\n133\t          GITHUB_HEAD_REF: ${{ github.head_ref }}\n134\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n135\t        run: rust-script scripts/check-version-modification.rs\n136\t\n137\t  # === SECRETS SCAN ===\n138\t  # Language-agnostic credential scan; runs via npx so no Node dependency is committed.\n139\t  secrets-scan:\n140\t    name: Secrets Scan\n141\t    runs-on: ubuntu-latest\n142\t    timeout-minutes: 10\n143\t    steps:\n144\t      - uses: actions/checkout@v6\n145\t\n146\t      - name: Run secretlint\n147\t        run: npx --yes -p secretlint -p @secretlint/secretlint-rule-preset-recommend secretlint --secretlintignore .gitignore \"**/*\"\n148\t\n149\t  # === FRESH MERGE SIMULATION ===\n150\t  # Catches semantic merge conflicts: a pull request that is green in isolation but\n151\t  # breaks the base branch once merged into its current tip.\n152\t  fresh-merge:\n153\t    name: Fresh Merge Simulation\n154\t    runs-on: ubuntu-latest\n155\t    timeout-minutes: 30\n156\t    needs: [detect-changes]\n157\t    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n158\t    steps:\n159\t      - uses: actions/checkout@v6\n160\t        with:\n161\t          fetch-depth: 0\n162\t\n163\t      - name: Setup Rust\n164\t        uses: dtolnay/rust-toolchain@stable\n165\t        with:\n166\t          components: rustfmt, clippy\n167\t\n168\t      - name: Cache cargo registry\n169\t        uses: actions/cache@v5\n170\t        with:\n171\t          path: |\n172\t            ~/.cargo/registry\n173\t            ~/.cargo/git\n174\t            target\n175\t          key: ${{ runner.os }}-cargo-fresh-merge-${{ hashFiles('**/Cargo.lock') }}\n176\t          restore-keys: |\n177\t            ${{ runner.os }}-cargo-fresh-merge-\n178\t\n179\t      - name: Simulate fresh merge with base branch\n180\t        env:\n181\t          GITHUB_BASE_REF: ${{ github.base_ref }}\n182\t        run: bash scripts/simulate-fresh-merge.sh\n183\t\n184\t  # === DOCKER IMAGE BUILD CHECK ===\n185\t  # Builds the image at pull-request stage without pushing, so a Dockerfile\n186\t  # regression fails the pull request instead of producing a half-finished release\n187\t  # (crate published, image missing). push: false also works for fork pull requests\n188\t  # that have no registry credentials.\n189\t  docker-build:\n190\t    name: Docker Image Build Check\n191\t    runs-on: ubuntu-latest\n192\t    # The image compiles the crate from scratch; 30 minutes is not enough cold.\n193\t    timeout-minutes: 60\n194\t    needs: [detect-changes]\n195\t    if: github.event_name == 'pull_request' && needs.detect-changes.outputs.any-code-changed == 'true'\n196\t    steps:\n197\t      - uses: actions/checkout@v6\n198\t\n199\t      - name: Check for Dockerfile\n200\t        id: dockerfile\n201\t        run: |\n202\t          if [ -f Dockerfile ]; then\n203\t            echo \"exists=true\" >> \"$GITHUB_OUTPUT\"\n204\t          else\n205\t            echo \"exists=false\" >> \"$GITHUB_OUTPUT\"\n206\t            echo \"No Dockerfile at repository root; skipping image build check.\"\n207\t          fi\n208\t\n209\t      - name: Set up Docker Buildx\n210\t        if: steps.dockerfile.outputs.exists == 'true'\n211\t        uses: docker/setup-buildx-action@v4\n212\t\n213\t      - name: Build image (no push)\n214\t        if: steps.dockerfile.outputs.exists == 'true'\n215\t        uses: docker/build-push-action@v7\n216\t        with:\n217\t          context: .\n218\t          push: false\n219\t          load: true\n220\t          tags: app:pr-check\n221\t          cache-from: type=gha\n222\t          cache-to: type=gha,mode=max\n223\t\n224\t  # === CARGO.LOCK GUARD ===\n225\t  # Binary crates must commit Cargo.lock so CI and release jobs resolve the same\n226\t  # dependency graph every run. This also prevents cache keys based on\n227\t  # hashFiles('**/Cargo.lock') from silently degrading to the empty hash.\n228\t  cargo-lock:\n229\t    name: Cargo.lock Guard\n230\t    runs-on: ubuntu-latest\n231\t    timeout-minutes: 5\n232\t    needs: [detect-changes]\n233\t    if: |\n234\t      !cancelled() && (\n235\t        github.event_name == 'push' ||\n236\t        github.event_name == 'workflow_dispatch' ||\n237\t        needs.detect-changes.outputs.rs-changed == 'true' ||\n238\t        needs.detect-changes.outputs.toml-changed == 'true' ||\n239\t        needs.detect-changes.outputs.docs-changed == 'true' ||\n240\t        needs.detect-changes.outputs.workflow-changed == 'true' ||\n241\t        needs.detect-changes.outputs.any-code-changed == 'true'\n242\t      )\n243\t    steps:\n244\t      - uses: actions/checkout@v6\n245\t\n246\t      - name: Setup Rust\n247\t        uses: dtolnay/rust-toolchain@stable\n248\t\n249\t      - name: Install rust-script\n250\t        run: ./scripts/install-rust-script.sh\n251\t\n252\t      - name: Check committed Cargo.lock for binary crates\n253\t        run: rust-script scripts/check-cargo-lock.rs\n254\t\n255\t  # === LINT AND FORMAT CHECK ===\n256\t  # Lint runs independently of changelog check - it's a fast check that should always run\n257\t  # See: https://github.com/link-assistant/hive-mind/pull/1024 for why this dependency was removed\n258\t  lint:\n259\t    name: Lint and Format Check\n260\t    runs-on: ubuntu-latest\n261\t    timeout-minutes: 10\n262\t    needs: [detect-changes, cargo-lock]\n263\t    # Note: !cancelled() is required because detect-changes is skipped on workflow_dispatch,\n264\t    # and without it, this job would also be skipped even though its condition includes workflow_dispatch.\n265\t    # See: https://github.com/actions/runner/issues/491\n266\t    if: |\n267\t      !cancelled() && (\n268\t        needs.cargo-lock.result == 'success' && (\n269\t          github.event_name == 'push' ||\n270\t          github.event_name == 'workflow_dispatch' ||\n271\t          needs.detect-changes.outputs.rs-changed == 'true' ||\n272\t          needs.detect-changes.outputs.toml-changed == 'true' ||\n273\t          needs.detect-changes.outputs.docs-changed == 'true' ||\n274\t          needs.detect-changes.outputs.workflow-changed == 'true'\n275\t        )\n276\t      )\n277\t    steps:\n278\t      - uses: actions/checkout@v6\n279\t        with:\n280\t          fetch-depth: 0\n281\t\n282\t      - name: Setup Rust\n283\t        uses: dtolnay/rust-toolchain@stable\n284\t        with:\n285\t          components: rustfmt, clippy\n286\t\n287\t      - name: Install rust-script\n288\t        run: ./scripts/install-rust-script.sh\n289\t\n290\t      - name: Cache cargo registry\n291\t        uses: actions/cache@v5\n292\t        with:\n293\t          path: |\n294\t            ~/.cargo/registry\n295\t            ~/.cargo/git\n296\t            target\n297\t          key: ${{ runner.os }}-cargo-lint-${{ hashFiles('**/Cargo.lock') }}\n298\t          restore-keys: |\n299\t            ${{ runner.os }}-cargo-lint-\n300\t\n301\t      - name: Check formatting\n302\t        run: cargo fmt --all -- --check\n303\t\n304\t      - name: Run Clippy\n305\t        run: cargo clippy --all-targets --all-features\n306\t\n307\t      # Warning-band annotations are limited to files this pull request changed,\n308\t      # so unchanged files stop repeating the same warning on every run.\n309\t      # The 1000-line hard limit still applies to the whole repository.\n310\t      - name: Collect changed files\n311\t        id: changed-files\n312\t        env:\n313\t          BASE_SHA: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || github.event.before }}\n314\t        run: |\n315\t          {\n316\t            echo 'files<<CHANGED_FILES_EOF'\n317\t            if [ -n \"$BASE_SHA\" ] && git cat-file -e \"$BASE_SHA^{commit}\" 2>/dev/null; then\n318\t              git diff --name-only \"$BASE_SHA\" HEAD\n319\t            else\n320\t              # No usable base (e.g. workflow_dispatch): fall back to annotating every warning.\n321\t              git ls-files\n322\t            fi\n323\t            echo 'CHANGED_FILES_EOF'\n324\t          } >> \"$GITHUB_OUTPUT\"\n325\t\n326\t      - name: Build documentation\n327\t        # Fail-closed rustdoc gate: rustdoc-only lints (for example\n328\t        # rustdoc::private_intra_doc_links) are not reported by clippy or\n329\t        # `cargo test --doc`, so they must be caught here, before release,\n330\t        # instead of in the post-release deploy-docs job.\n331\t        env:\n332\t          RUSTDOCFLAGS: -D warnings\n333\t        run: cargo doc --no-deps --all-features\n334\t\n335\t      - name: Check file size limit\n336\t        env:\n337\t          CHANGED_FILES: ${{ steps.changed-files.outputs.files }}\n338\t        run: rust-script scripts/check-file-size.rs\n339\t\n340\t  # === TEST ===\n341\t  # Test runs independently of changelog check and only for code-affecting changes\n342\t  test:\n343\t    name: Test (${{ matrix.os }})\n344\t    runs-on: ${{ matrix.os }}\n345\t    timeout-minutes: 20\n346\t    needs: [detect-changes, cargo-lock]\n347\t    # Note: !cancelled() is required because detect-changes is skipped on workflow_dispatch,\n348\t    # and without it, this job would also be skipped even though its condition includes workflow_dispatch.\n349\t    # See: https://github.com/actions/runner/issues/491\n350\t    if: |\n351\t      !cancelled() && (\n352\t        needs.cargo-lock.result == 'success' && (\n353\t          github.event_name == 'push' ||\n354\t          github.event_name == 'workflow_dispatch' ||\n355\t          needs.detect-changes.outputs.any-code-changed == 'true' ||\n356\t          needs.detect-changes.outputs.rs-changed == 'true' ||\n357\t          needs.detect-changes.outputs.toml-changed == 'true' ||\n358\t          needs.detect-changes.outputs.workflow-changed == 'true'\n359\t        )\n360\t      )\n361\t    strategy:\n362\t      fail-fast: false\n363\t      matrix:\n364\t        os: [ubuntu-latest, macos-latest, windows-latest]\n365\t    steps:\n366\t      - uses: actions/checkout@v6\n367\t\n368\t      - name: Setup Rust\n369\t        uses: dtolnay/rust-toolchain@stable\n370\t\n371\t      - name: Cache cargo registry on Windows\n372\t        if: runner.os == 'Windows'\n373\t        uses: actions/cache@v5\n374\t        with:\n375\t          path: |\n376\t            ~/.cargo/registry\n377\t            ~/.cargo/git\n378\t          key: ${{ runner.os }}-cargo-test-registry-${{ hashFiles('**/Cargo.lock') }}\n379\t          restore-keys: |\n380\t            ${{ runner.os }}-cargo-test-registry-\n381\t\n382\t      - name: Cache cargo registry and target on Unix\n383\t        if: runner.os != 'Windows'\n384\t        uses: actions/cache@v5\n385\t        with:\n386\t          path: |\n387\t            ~/.cargo/registry\n388\t            ~/.cargo/git\n389\t            target\n390\t          key: ${{ runner.os }}-cargo-test-${{ hashFiles('**/Cargo.lock') }}\n391\t          restore-keys: |\n392\t            ${{ runner.os }}-cargo-test-\n393\t\n394\t      - name: Run tests\n395\t        run: cargo test --all-features --verbose\n396\t\n397\t      - name: Run doc tests\n398\t        run: cargo test --doc --verbose\n399\t\n400\t  # === CODE COVERAGE ===\n401\t  # Generate and upload code coverage using cargo-llvm-cov\n402\t  coverage:\n403\t    name: Code Coverage\n404\t    runs-on: ubuntu-latest\n405\t    timeout-minutes: 15\n406\t    needs: [detect-changes, cargo-lock]\n407\t    env:\n408\t      CODECOV_TOKEN: ${{ secrets.CODECOV_TOKEN }}\n409\t    if: |\n410\t      !cancelled() && (\n411\t        needs.cargo-lock.result == 'success' && (\n412\t          github.event_name == 'push' ||\n413\t          github.event_name == 'workflow_dispatch' ||\n414\t          needs.detect-changes.outputs.rs-changed == 'true' ||\n415\t          needs.detect-changes.outputs.toml-changed == 'true'\n416\t        )\n417\t      )\n418\t    steps:\n419\t      - uses: actions/checkout@v6\n420\t\n421\t      - name: Setup Rust\n422\t        uses: dtolnay/rust-toolchain@stable\n423\t        with:\n424\t          components: llvm-tools-preview\n425\t\n426\t      - name: Cache cargo registry\n427\t        uses: actions/cache@v5\n428\t        with:\n429\t          path: |\n430\t            ~/.cargo/registry\n431\t            ~/.cargo/git\n432\t            target\n433\t          key: ${{ runner.os }}-cargo-coverage-${{ hashFiles('**/Cargo.lock') }}\n434\t          restore-keys: |\n435\t            ${{ runner.os }}-cargo-coverage-\n436\t\n437\t      - name: Install cargo-llvm-cov\n438\t        uses: taiki-e/install-action@cargo-llvm-cov\n439\t\n440\t      - name: Generate code coverage\n441\t        run: cargo llvm-cov --all-features --lcov --output-path lcov.info\n442\t\n443\t      - name: Upload coverage to Codecov\n444\t        if: env.CODECOV_TOKEN != ''\n445\t        uses: codecov/codecov-action@v7\n446\t        with:\n447\t          token: ${{ env.CODECOV_TOKEN }}\n448\t          files: lcov.info\n449\t          disable_search: true\n450\t          fail_ci_if_error: true\n451\t\n452\t      - name: Report skipped Codecov upload\n453\t        if: env.CODECOV_TOKEN == ''\n454\t        run: echo \"::notice::Skipping Codecov upload because CODECOV_TOKEN is not configured\"\n455\t\n456\t  # === BUILD ===\n457\t  # Build package - only runs if lint and test pass\n458\t  build:\n459\t    name: Build Package\n460\t    runs-on: ubuntu-latest\n461\t    timeout-minutes: 10\n462\t    needs: [lint, test]\n463\t    if: ${{ !cancelled() && needs.lint.result == 'success' && needs.test.result == 'success' }}\n464\t    steps:\n465\t      - uses: actions/checkout@v6\n466\t\n467\t      - name: Setup Rust\n468\t        uses: dtolnay/rust-toolchain@stable\n469\t\n470\t      - name: Install rust-script\n471\t        run: ./scripts/install-rust-script.sh\n472\t\n473\t      - name: Cache cargo registry\n474\t        uses: actions/cache@v5\n475\t        with:\n476\t          path: |\n477\t            ~/.cargo/registry\n478\t            ~/.cargo/git\n479\t            target\n480\t          key: ${{ runner.os }}-cargo-build-${{ hashFiles('**/Cargo.lock') }}\n481\t          restore-keys: |\n482\t            ${{ runner.os }}-cargo-build-\n483\t\n484\t      - name: Build release\n485\t        run: cargo build --release --verbose\n486\t\n487\t      - name: Check package\n488\t        run: cargo package --list --allow-dirty\n489\t\n490\t      - name: Check crate package size\n491\t        run: rust-script scripts/check-crate-size.rs\n492\t\n493\t  # === AUTO RELEASE ===\n494\t  # Automatic release on push to main using changelog fragments\n495\t  # This job automatically bumps version based on fragments in changelog.d/\n496\t  auto-release:\n497\t    name: Auto Release\n498\t    needs: [lint, test, build]\n499\t    # Note: !cancelled() ensures consistent behavior with other jobs that depend on skipped jobs.\n500\t    if: |\n501\t      !cancelled() &&\n502\t      github.event_name == 'push' &&\n503\t      github.ref == 'refs/heads/main' &&\n504\t      needs.build.result == 'success'\n505\t    runs-on: ubuntu-latest\n506\t    timeout-minutes: 30\n507\t    env:\n508\t      DOCKERHUB_USERNAME: ${{ vars.DOCKERHUB_USERNAME || secrets.DOCKERHUB_USERNAME }}\n509\t      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n510\t    permissions:\n511\t      contents: write\n512\t    steps:\n513\t      - uses: actions/checkout@v6\n514\t        with:\n515\t          fetch-depth: 0\n516\t          token: ${{ secrets.GITHUB_TOKEN }}\n517\t\n518\t      - name: Setup Rust\n519\t        uses: dtolnay/rust-toolchain@stable\n520\t\n521\t      - name: Install rust-script\n522\t        run: ./scripts/install-rust-script.sh\n523\t\n524\t      - name: Configure git\n525\t        run: rust-script scripts/git-config.rs\n526\t\n527\t      - name: Determine bump type from changelog fragments\n528\t        id: bump_type\n529\t        run: rust-script scripts/get-bump-type.rs\n530\t\n531\t      - name: Check if version already released or no fragments\n532\t        id: check\n533\t        env:\n534\t          HAS_FRAGMENTS: ${{ steps.bump_type.outputs.has_fragments }}\n535\t          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n536\t        run: rust-script scripts/check-release-needed.rs\n537\t\n538\t      - name: Collect changelog and bump version\n539\t        id: version\n540\t        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.skip_bump != 'true'\n541\t        run: |\n542\t          rust-script scripts/version-and-commit.rs \\\n543\t            --bump-type \"${{ steps.bump_type.outputs.bump_type }}\"\n544\t\n545\t      - name: Get current version\n546\t        id: current_version\n547\t        if: steps.check.outputs.should_release == 'true'\n548\t        run: rust-script scripts/get-version.rs\n549\t\n550\t      - name: Build release\n551\t        if: steps.check.outputs.should_release == 'true'\n552\t        run: cargo build --release\n553\t\n554\t      - name: Check crate package size\n555\t        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.crate_published != 'true'\n556\t        run: rust-script scripts/check-crate-size.rs\n557\t\n558\t      - name: Publish to Crates.io\n559\t        if: steps.check.outputs.should_release == 'true' && steps.check.outputs.crate_published != 'true'\n560\t        id: publish-crate\n561\t        env:\n562\t          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n563\t          CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n564\t        run: rust-script scripts/publish-crate.rs\n565\t\n566\t      - name: Wait for Crate availability on Crates.io\n567\t        if: |\n568\t          steps.check.outputs.should_release == 'true' && (\n569\t            steps.check.outputs.crate_published == 'true' ||\n570\t            steps.publish-crate.outputs.publish_result == 'success'\n571\t          )\n572\t        run: rust-script scripts/wait-for-crate.rs --release-version \"${{ steps.current_version.outputs.version }}\"\n573\t\n574\t      - name: Smoke-test published crate\n575\t        if: |\n576\t          steps.check.outputs.should_release == 'true' && (\n577\t            steps.check.outputs.crate_published == 'true' ||\n578\t            steps.publish-crate.outputs.publish_result == 'success'\n579\t          )\n580\t        run: rust-script scripts/smoke-test-published-crate.rs --release-version \"${{ steps.current_version.outputs.version }}\"\n581\t\n582\t      - name: Configure Docker Hub publishing\n583\t        if: |\n584\t          steps.check.outputs.should_release == 'true' && (\n585\t            steps.check.outputs.crate_published == 'true' ||\n586\t            steps.publish-crate.outputs.publish_result == 'success'\n587\t          )\n588\t        id: dockerhub\n589\t        run: |\n590\t          disable_dockerhub() {\n591\t            echo \"enabled=false\" >> \"$GITHUB_OUTPUT\"\n592\t            echo \"$1\"\n593\t          }\n594\t\n595\t          if [ -z \"$DOCKERHUB_IMAGE\" ]; then\n596\t            disable_dockerhub \"Docker Hub publishing disabled: DOCKERHUB_IMAGE repository variable is not set\"\n597\t            exit 0\n598\t          fi\n599\t\n600\t          if [ ! -f Dockerfile ]; then\n601\t            disable_dockerhub \"Docker Hub publishing disabled: Dockerfile was not found at repository root\"\n602\t            exit 0\n603\t          fi\n604\t\n605\t          if [ -z \"$DOCKERHUB_USERNAME\" ] || [ -z \"$DOCKERHUB_TOKEN\" ]; then\n606\t            echo \"::error::Docker Hub publishing requires DOCKERHUB_USERNAME and DOCKERHUB_TOKEN\"\n607\t            echo \"Set DOCKERHUB_USERNAME as a repository variable or secret, and DOCKERHUB_TOKEN as a secret.\"\n608\t            exit 1\n609\t          fi\n610\t\n611\t          echo \"enabled=true\" >> \"$GITHUB_OUTPUT\"\n612\t          echo \"docker_hub_url=https://hub.docker.com/r/${DOCKERHUB_IMAGE}\" >> \"$GITHUB_OUTPUT\"\n613\t\n614\t      - name: Log in to Docker Hub\n615\t        if: steps.dockerhub.outputs.enabled == 'true'\n616\t        uses: docker/login-action@v4\n617\t        with:\n618\t          username: ${{ env.DOCKERHUB_USERNAME }}\n619\t          password: ${{ env.DOCKERHUB_TOKEN }}\n620\t\n621\t      # Resilient buildx boot: pre-pull the pinned BuildKit image with retries\n622\t      # and a pull-through registry-mirror fallback so a transient Docker Hub\n623\t      # outage at boot does not take the publish job down. See issue #69 and\n624\t      # docs/case-studies/issue-69/README.md.\n625\t      - name: Set up Docker Buildx\n626\t        if: steps.dockerhub.outputs.enabled == 'true'\n627\t        uses: ./.github/actions/setup-buildx-resilient\n628\t\n629\t      - name: Extract Docker metadata\n630\t        if: steps.dockerhub.outputs.enabled == 'true'\n631\t        id: docker-meta\n632\t        uses: docker/metadata-action@v6\n633\t        with:\n634\t          images: ${{ env.DOCKERHUB_IMAGE }}\n635\t          tags: |\n636\t            type=raw,value=latest\n637\t            type=raw,value=${{ steps.current_version.outputs.version }}\n638\t          labels: |\n639\t            org.opencontainers.image.version=${{ steps.current_version.outputs.version }}\n640\t\n641\t      - name: Publish Docker image to Docker Hub\n642\t        if: steps.dockerhub.outputs.enabled == 'true'\n643\t        uses: docker/build-push-action@v7\n644\t        with:\n645\t          context: .\n646\t          push: true\n647\t          tags: ${{ steps.docker-meta.outputs.tags }}\n648\t          labels: ${{ steps.docker-meta.outputs.labels }}\n649\t\n650\t      - name: Create GitHub Release\n651\t        if: |\n652\t          steps.check.outputs.should_release == 'true' && (\n653\t            steps.check.outputs.crate_published == 'true' ||\n654\t            steps.publish-crate.outputs.publish_result == 'success'\n655\t          )\n656\t        env:\n657\t          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n658\t          DOCKER_HUB_URL: ${{ steps.dockerhub.outputs.docker_hub_url }}\n659\t        run: |\n660\t          # Use new_version from version-and-commit when available (tag-checked), else fall back to Cargo.toml version\n661\t          RELEASE_VERSION=\"${{ steps.version.outputs.new_version }}\"\n662\t          if [ -z \"$RELEASE_VERSION\" ]; then\n663\t            RELEASE_VERSION=\"${{ steps.current_version.outputs.version }}\"\n664\t          fi\n665\t\n666\t          release_args=(\n667\t            --release-version \"$RELEASE_VERSION\"\n668\t            --repository \"${{ github.repository }}\"\n669\t          )\n670\t          if [ -n \"$DOCKER_HUB_URL\" ]; then\n671\t            release_args+=(--docker-hub-url \"$DOCKER_HUB_URL\")\n672\t          fi\n673\t          rust-script scripts/create-github-release.rs \"${release_args[@]}\"\n674\t\n675\t  # === MANUAL INSTANT RELEASE ===\n676\t  # Manual release via workflow_dispatch - only after CI passes\n677\t  manual-release:\n678\t    name: Instant Release\n679\t    needs: [lint, test, build]\n680\t    # Note: !cancelled() is required to evaluate the condition when dependencies may be skipped.\n681\t    # The build job ensures lint and test passed before this job runs.\n682\t    if: |\n683\t      !cancelled() &&\n684\t      github.event_name == 'workflow_dispatch' &&\n685\t      github.event.inputs.release_mode == 'instant' &&\n686\t      needs.build.result == 'success'\n687\t    runs-on: ubuntu-latest\n688\t    timeout-minutes: 30\n689\t    env:\n690\t      DOCKERHUB_USERNAME: ${{ vars.DOCKERHUB_USERNAME || secrets.DOCKERHUB_USERNAME }}\n691\t      DOCKERHUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}\n692\t    permissions:\n693\t      contents: write\n694\t    steps:\n695\t      - uses: actions/checkout@v6\n696\t        with:\n697\t          fetch-depth: 0\n698\t          token: ${{ secrets.GITHUB_TOKEN }}\n699\t\n700\t      - name: Setup Rust\n701\t        uses: dtolnay/rust-toolchain@stable\n702\t\n703\t      - name: Install rust-script\n704\t        run: ./scripts/install-rust-script.sh\n705\t\n706\t      - name: Configure git\n707\t        run: rust-script scripts/git-config.rs\n708\t\n709\t      - name: Collect changelog fragments\n710\t        run: rust-script scripts/collect-changelog.rs\n711\t\n712\t      - name: Version and commit\n713\t        id: version\n714\t        env:\n715\t          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n716\t          DESCRIPTION: ${{ github.event.inputs.description }}\n717\t        run: rust-script scripts/version-and-commit.rs --bump-type \"${{ github.event.inputs.bump_type }}\" --description \"${{ github.event.inputs.description }}\"\n718\t\n719\t      - name: Build release\n720\t        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n721\t        run: cargo build --release\n722\t\n723\t      - name: Check crate package size\n724\t        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n725\t        run: rust-script scripts/check-crate-size.rs\n726\t\n727\t      - name: Publish to Crates.io\n728\t        if: steps.version.outputs.version_committed == 'true' || steps.version.outputs.already_released == 'true'\n729\t        id: publish-crate\n730\t        env:\n731\t          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN || secrets.CARGO_TOKEN }}\n732\t          CARGO_TOKEN: ${{ secrets.CARGO_TOKEN }}\n733\t        run: rust-script scripts/publish-crate.rs\n734\t\n735\t      - name: Wait for Crate availability on Crates.io\n736\t        if: |\n737\t          (steps.version.outputs.version_committed == 'true' ||\n738\t            steps.version.outputs.already_released == 'true') &&\n739\t          steps.publish-crate.outputs.publish_result == 'success'\n740\t        run: rust-script scripts/wait-for-crate.rs --release-version \"${{ steps.version.outputs.new_version }}\"\n741\t\n742\t      - name: Smoke-test published crate\n743\t        if: |\n744\t          (steps.version.outputs.version_committed == 'true' ||\n745\t            steps.version.outputs.already_released == 'true') &&\n746\t          steps.publish-crate.outputs.publish_result == 'success'\n747\t        run: rust-script scripts/smoke-test-published-crate.rs --release-version \"${{ steps.version.outputs.new_version }}\"\n748\t\n749\t      - name: Configure Docker Hub publishing\n750\t        if: |\n751\t          (steps.version.outputs.version_committed == 'true' ||\n752\t            steps.version.outputs.already_released == 'true') &&\n753\t          steps.publish-crate.outputs.publish_result == 'success'\n754\t        id: dockerhub\n755\t        run: |\n756\t          disable_dockerhub() {\n757\t            echo \"enabled=false\" >> \"$GITHUB_OUTPUT\"\n758\t            echo \"$1\"\n759\t          }\n760\t\n761\t          if [ -z \"$DOCKERHUB_IMAGE\" ]; then\n762\t            disable_dockerhub \"Docker Hub publishing disabled: DOCKERHUB_IMAGE repository variable is not set\"\n763\t            exit 0\n764\t          fi\n765\t\n766\t          if [ ! -f Dockerfile ]; then\n767\t            disable_dockerhub \"Docker Hub publishing disabled: Dockerfile was not found at repository root\"\n768\t            exit 0\n769\t          fi\n770\t\n771\t          if [ -z \"$DOCKERHUB_USERNAME\" ] || [ -z \"$DOCKERHUB_TOKEN\" ]; then\n772\t            echo \"::error::Docker Hub publishing requires DOCKERHUB_USERNAME and DOCKERHUB_TOKEN\"\n773\t            echo \"Set DOCKERHUB_USERNAME as a repository variable or secret, and DOCKERHUB_TOKEN as a secret.\"\n774\t            exit 1\n775\t          fi\n776\t\n777\t          echo \"enabled=true\" >> \"$GITHUB_OUTPUT\"\n778\t          echo \"docker_hub_url=https://hub.docker.com/r/${DOCKERHUB_IMAGE}\" >> \"$GITHUB_OUTPUT\"\n779\t\n780\t      - name: Log in to Docker Hub\n781\t        if: steps.dockerhub.outputs.enabled == 'true'\n782\t        uses: docker/login-action@v4\n783\t        with:\n784\t          username: ${{ env.DOCKERHUB_USERNAME }}\n785\t          password: ${{ env.DOCKERHUB_TOKEN }}\n786\t\n787\t      # Resilient buildx boot: pre-pull the pinned BuildKit image with retries\n788\t      # and a pull-through registry-mirror fallback so a transient Docker Hub\n789\t      # outage at boot does not take the publish job down. See issue #69 and\n790\t      # docs/case-studies/issue-69/README.md.\n791\t      - name: Set up Docker Buildx\n792\t        if: steps.dockerhub.outputs.enabled == 'true'\n793\t        uses: ./.github/actions/setup-buildx-resilient\n794\t\n795\t      - name: Extract Docker metadata\n796\t        if: steps.dockerhub.outputs.enabled == 'true'\n797\t        id: docker-meta\n798\t        uses: docker/metadata-action@v6\n799\t        with:\n800\t          images: ${{ env.DOCKERHUB_IMAGE }}\n801\t          tags: |\n802\t            type=raw,value=latest\n803\t            type=raw,value=${{ steps.version.outputs.new_version }}\n804\t          labels: |\n805\t            org.opencontainers.image.version=${{ steps.version.outputs.new_version }}\n806\t\n807\t      - name: Publish Docker image to Docker Hub\n808\t        if: steps.dockerhub.outputs.enabled == 'true'\n809\t        uses: docker/build-push-action@v7\n810\t        with:\n811\t          context: .\n812\t          push: true\n813\t          tags: ${{ steps.docker-meta.outputs.tags }}\n814\t          labels: ${{ steps.docker-meta.outputs.labels }}\n815\t\n816\t      - name: Create GitHub Release\n817\t        if: |\n818\t          (steps.version.outputs.version_committed == 'true' ||\n819\t            steps.version.outputs.already_released == 'true') &&\n820\t          steps.publish-crate.outputs.publish_result == 'success'\n821\t        env:\n822\t          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n823\t          DOCKER_HUB_URL: ${{ steps.dockerhub.outputs.docker_hub_url }}\n824\t        run: |\n825\t          release_args=(\n826\t            --release-version \"${{ steps.version.outputs.new_version }}\"\n827\t            --repository \"${{ github.repository }}\"\n828\t          )\n829\t          if [ -n \"$DOCKER_HUB_URL\" ]; then\n830\t            release_args+=(--docker-hub-url \"$DOCKER_HUB_URL\")\n831\t          fi\n832\t          rust-script scripts/create-github-release.rs \"${release_args[@]}\"\n833\t\n834\t  # === MANUAL CHANGELOG PR ===\n835\t  changelog-pr:\n836\t    name: Create Changelog PR\n837\t    if: github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'changelog-pr'\n838\t    runs-on: ubuntu-latest\n839\t    timeout-minutes: 10\n840\t    permissions:\n841\t      contents: write\n842\t      pull-requests: write\n843\t    steps:\n844\t      - uses: actions/checkout@v6\n845\t        with:\n846\t          fetch-depth: 0\n847\t\n848\t      - name: Setup Rust\n849\t        uses: dtolnay/rust-toolchain@stable\n850\t\n851\t      - name: Install rust-script\n852\t        run: ./scripts/install-rust-script.sh\n853\t\n854\t      - name: Create changelog fragment\n855\t        env:\n856\t          BUMP_TYPE: ${{ github.event.inputs.bump_type }}\n857\t          DESCRIPTION: ${{ github.event.inputs.description }}\n858\t        run: rust-script scripts/create-changelog-fragment.rs --bump-type \"${{ github.event.inputs.bump_type }}\" --description \"${{ github.event.inputs.description }}\"\n859\t\n860\t      - name: Create Pull Request\n861\t        uses: peter-evans/create-pull-request@v8\n862\t        with:\n863\t          token: ${{ secrets.GITHUB_TOKEN }}\n864\t          commit-message: 'chore: add changelog for manual ${{ github.event.inputs.bump_type }} release'\n865\t          branch: changelog-manual-release-${{ github.run_id }}\n866\t          delete-branch: true\n867\t          title: 'chore: manual ${{ github.event.inputs.bump_type }} release'\n868\t          body: |\n869\t            ## Manual Release Request\n870\t\n871\t            This PR was created by a manual workflow trigger to prepare a **${{ github.event.inputs.bump_type }}** release.\n872\t\n873\t            ### Release Details\n874\t            - **Type:** ${{ github.event.inputs.bump_type }}\n875\t            - **Description:** ${{ github.event.inputs.description || 'Manual release' }}\n876\t            - **Triggered by:** @${{ github.actor }}\n877\t\n878\t            ### Next Steps\n879\t            1. Review the changelog fragment in this PR\n880\t            2. Merge this PR to main\n881\t            3. The automated release workflow will publish to crates.io and create a GitHub release\n882\t\n883\t  # === DEPLOY DOCUMENTATION ===\n884\t  # Deploy Rust API documentation to GitHub Pages after a successful package build.\n885\t  # Keep this independent from package/GitHub release publication so the website\n886\t  # still updates when the release path fails. Use the official Pages artifact\n887\t  # deployment path so repositories configured with \"GitHub Actions\" as their\n888\t  # Pages source fail this job if Pages cannot deploy.\n889\t  #\n890\t  # One-time setup: in the repository's Settings -> Pages, set Source to\n891\t  # \"GitHub Actions\". Without this, the first run fails on actions/deploy-pages\n892\t  # with \"Get Pages site failed\" / \"Failed to create deployment\". This cannot be\n893\t  # configured from a workflow. See README.md \"Deploying API documentation\".\n894\t  deploy-docs:\n895\t    name: Deploy Rust Documentation\n896\t    needs: [build]\n897\t    if: |\n898\t      !cancelled() &&\n899\t      needs.build.result == 'success' && (\n900\t        (github.event_name == 'push' && github.ref == 'refs/heads/main') ||\n901\t        (github.event_name == 'workflow_dispatch' && github.event.inputs.release_mode == 'instant')\n902\t      )\n903\t    runs-on: ubuntu-latest\n904\t    timeout-minutes: 15\n905\t    permissions:\n906\t      contents: read\n907\t      pages: write\n908\t      id-token: write\n909\t    environment:\n910\t      name: github-pages\n911\t      url: ${{ steps.deployment.outputs.page_url }}\n912\t    steps:\n913\t      - uses: actions/checkout@v6\n914\t        with:\n915\t          ref: main\n916\t\n917\t      - name: Setup Rust\n918\t        uses: dtolnay/rust-toolchain@stable\n919\t\n920\t      - name: Build documentation\n921\t        # Defense in depth: same fail-closed flags as the lint job's gate.\n922\t        env:\n923\t          RUSTDOCFLAGS: -D warnings\n924\t        run: cargo doc --no-deps --all-features\n925\t\n926\t      - name: Generate Pages root index\n927\t        run: |\n928\t          # rustdoc emits target/doc/<crate>/index.html but no root index.html,\n929\t          # which makes the GitHub Pages root URL return 404. Redirect the root\n930\t          # to the crate docs directory that rustdoc generated.\n931\t          crate=$(cargo metadata --no-deps --format-version 1 \\\n932\t            | python3 -c 'import json,sys; print(json.load(sys.stdin)[\"packages\"][0][\"name\"].replace(\"-\",\"_\"))')\n933\t          printf '<!doctype html><meta http-equiv=\"refresh\" content=\"0; url=%s/index.html\">\\n' \"$crate\" \\\n934\t            > target/doc/index.html\n935\t          touch target/doc/.nojekyll\n936\t\n937\t      - name: Configure GitHub Pages\n938\t        uses: actions/configure-pages@v6\n939\t\n940\t      - name: Verify site tree\n941\t        run: find target/doc -maxdepth 2 -print\n942\t\n943\t      - name: Upload GitHub Pages artifact\n944\t        uses: actions/upload-pages-artifact@v5\n945\t        with:\n946\t          path: target/doc\n947\t          include-hidden-files: true\n948\t\n949\t      - name: Deploy to GitHub Pages\n950\t        id: deployment\n951\t        uses: actions/deploy-pages@v5\n952\t"
