on\n00144|     /// declarations are flatter than their Chat Completions equivalents; custom\n00145|     /// declarations carry their own input format. Issues #468 and #859.\n00146|     #[serde(default, skip_serializing_if = \"Vec::is_empty\")]\n00147|     pub tools: Vec<Value>,\n00148|     #[serde(default, skip_serializing_if = \"Option::is_none\")]\n00149|     pub tool_choice: Option<Value>,\n00150| }\n00151| \n00152| impl ResponsesRequest {\n00153|     /// Translate the Responses envelope into the shared [`ChatCompletionRequest`]\n00154|     /// so the agentic planner (issue #468) drives `/v1/responses` exactly as it\n00155|     /// drives `/v1/chat/completions`. `instructions` becomes a leading `system`\n00156|     /// message; `input` items become chat messages, with function/custom call\n00157|     /// items mapped to assistant `tool_calls` and matching output items to `tool`\n00158|     /// results (so the planner can track progress); advertised `tools` /\n00159|     /// `tool_choice` pass straight through (the planner reads names from either the\n00160|     /// flat Responses shape or the nested Chat shape).\n00161|     #[must_use]\n00162|     pub fn to_chat_completion_request(&self) -> ChatCompletionRequest {\n00163|         let mut messages = responses_input::messages(&self.input);\n00164|         if let Some(instructions) = self.instructions.as_deref()\n00165|             && !instructions.trim().is_empty()\n00166|         {\n00167|             messages.insert(0, ChatMessage::new(\"system\", instructions.trim()));\n00168|         }\n00169|         ChatCompletionRequest {\n00170|             model: self.model.clone(),\n00171|             messages,\n00172|             temperature: self.temperature,\n00173|             stream: false,\n00174|             tools: self.tools.clone(),\n00175|             tool_choice: self.tool_choice.clone(),\n00176|             functions: Vec::new(),\n00177|             function_call: None,\n00178|             output_standard: None,\n00179|             lexical_density: None,\n00180|             response_format: None,\n00181|             stream_options: None,\n00182|         }\n00183|     }\n00184| }\n00185| \n00186| #[must_use]\n00187| pub fn create_chat_completion(request: &ChatCompletionRequest) -> ChatCompletion {\n00188|     create_chat_completion_with_solver(request, &UniversalSolver::default())\n00189| }\n00190| \n00191| #[must_use]\n00192| pub fn create_chat_completion_with_solver(\n00193|     request: &ChatCompletionRequest,\n00194|     solver: &UniversalSolver,\n00195| ) -> ChatCompletion {\n00196|     create_chat_completion_with_solver_and_memory(request, solver, &[])\n00197| }\n00198| \n00199| /// The unprojected planner path. `protocol::cnl` wraps it so every Chat,\n00200| /// Anthropic and Gemini completion receives the selected output projection.\n00201| fn create_unprojected_chat_completion(\n00202|     request: &ChatCompletionRequest,\n00203|     solver: &UniversalSolver,\n00204|     memory_events: &[MemoryEvent],\n00205|     forced_client_functions: bool,\n00206| ) -> ChatCompletion {\n00207|     let (prompt, history) = chat_prompt_and_history(&request.messages);\n00208|     if forced_client_functions\n00209|         && let Some(completion) = client_functions::client_function_completion(request, &prompt)\n00210|     {\n00211|         return completion;\n00212|     }\n00213|     let context = request_context::RequestContext::new(&request.messages);\n00214|     let solver = &context.solver(solver);\n00215| \n00216|     if let Some(mut symbolic_answer) =\n00217|         answer_from_memory_if_requested(&prompt, &history, memory_events)\n00218|     {\n00219|         apply_retained_amendments(&prompt, &mut symbolic_answer, memory_events);\n00220|         return chat_completion_from_symbolic(request, &prompt, symbolic_answer);\n00221|     }\n00222| \n00223|     match agentic_outcome(request, solver.config.agent_mode) {\n00224|         AgenticOutcome::Refused(answer) => {\n00225|             return chat_completion_from_symbolic(request, &prompt, answer);\n00226|         }\n00227|         AgenticOutcome::Planned(plan) => {\n00228|             return chat_completion_from_plan(request, &prompt, plan, memory_events);\n00229|         }\n00230|         AgenticOutcome::Fallthrough => {}\n00231|     }\n00232| \n00233|     if let Some(answer) = context.answer() {\n00234|         return chat_completion_from_symbolic(request, &prompt, answer);\n00235|     }\n00236|     // Standing requirements are injected into the solving context itself (as if\n00237|     // the user restated them), not appended after the fact.\n00238|     let mut symbolic_answer =\n00239|         structured_output::answer_from_source(request.response_format.as_ref(), true, &prompt)\n00240|             .unwrap_or_else(|| {\n00241|                 solve_with_standing_requirements(solver, &prompt, &history, memory_events)\n00242|             });\n00243|     if let Some(plan) = command_reroute_plan(request, solver.config.agent_mode, &symbolic_answer) {\n00244|         return chat_completion_from_plan(request, &prompt, plan, memory_events);\n00245|     }\n00246|     cnl::strip_notice_for_envelope(&context, solver, &mut symbolic_answer);\n00247|     chat_completion_from_symbolic(request, &prompt, symbolic_answer)\n00248| }\n00249| \n00250| fn command_reroute_plan(\n00251|     request: &ChatCompletionRequest,\n00252|     agent_mode: bool,\n00253|     symbolic_answer: &SymbolicAnswer,\n00254| ) -> Option<AgenticPlan> {\n00255|     if !agent_mode || !request.requests_tool_execution() {\n00256|         return None;\n00257|     }\n00258|     let owned_names = request.requested_tool_names();\n00259|     let tool_names: Vec<&str> = owned_names.iter().map(String::as_str).collect();\n00260|     plan_symbolic_command_reroute(&request.messages, &tool_names, symbolic_answer)\n00261| }\n00262| \n00263| /// The deterministic agentic decision for a tool-bearing request. Shared by every\n00264| /// OpenAI-shaped surface — `/v1/chat/completions`, `/v1/messages`, and\n00265| /// `/v1/responses` — so the issue #468 agentic loop behaves identically across all\n00266| /// three. Pure and deterministic: same `request` + `agent_mode` ⇒ same outcome.\n00267| enum AgenticOutcome {\n00268|     /// Tools were requested but refused — either agent mode is off (the real\n00269|     /// guard) or a requested tool failed the per-tool permission gate.\n00270|     Refused(SymbolicAnswer),\n00271|     /// The planner produced the next deterministic step (`tool_calls` or final).\n00272|     Planned(AgenticPlan),\n00273|     /// Not an agentic request — no tools were requested, or the task is not one\n00274|     /// the planner recognises — so the caller should answer symbolically.\n00275|     Fallthrough,\n00276| }\n00277| \n00278| /// Decide the [`AgenticOutcome`] for `request` under the given `agent_mode`,\n00279| /// applying the two gates (agent mode, then per-tool permissions) before letting\n00280| /// [`plan_chat_step`] drive the loop. An unrecognised task yields\n00281| /// [`AgenticOutcome::Fallthrough`] so ordinary chat stays untouched.\n00282| fn agentic_outcome(request: &ChatCompletionRequest, agent_mode: bool) -> AgenticOutcome {\n00283|     let trace = crate::cli_env::flag_enabled(\"FORMAL_AI_TRACE_REQUESTS\");\n00284|     let phase = crate::dialog_log::structured_log::request_phases(trace);\n00285|     if !request.requests_tool_execution() {\n00286|         if agent_mode\n00287|             && let Some(plan) = crate::agentic_coding::plan_text_report_flow(&request.messages)\n00288|         {\n00289|             return AgenticOutcome::Planned(plan);\n00290|         }\n00291|         // A client that speaks no function calling can still ground a file\n00292|         // read: `aider` puts the file's bytes in the conversation itself\n00293|         // (issue #671). Answering from what is already here needs no tool, so\n00294|         // it belongs on this side of the gate — but