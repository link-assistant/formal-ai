rch_query_for_task(task))?;\\n00417|     Some(format!(\\\"rg -n {}\\\", shell_quote(&query)))\\n00418| }\\n00419| \\n00420| /// The call the routed capability is made with.\\n00421| ///\\n00422| /// A lowering builds the command for the capability it lowered *from*, so\\n00423| /// `list_dir` lowered to the shell still runs `ls` and code navigation lowered\\n00424| /// to the shell still greps -- the shape #758 asked for, now stated by the row's\\n00425| /// `fallback` field rather than by a Rust cascade.\\n00426| fn routed_arguments(\\n00427|     capability: Capability,\\n00428|     lowered_from: Option<&str>,\\n00429|     task: &str,\\n00430| ) -> Option<String> {\\n00431|     if capability == Capability::Run {\\n00432|         let preferred = lowered_from\\n00433|             .and_then(|slug| {\\n00434|                 ROUTED_CAPABILITIES\\n00435|                     .iter()\\n00436|                     .find(|(name, _)| *name == slug)\\n00437|                     .map(|(_, capability)| *capability)\\n00438|             })\\n00439|             .unwrap_or(Capability::Run);\\n00440|         let command = shell_fallback(preferred, task)\\n00441|             .or_else(|| super::shell_command::shell_command_for_task(task))\\n00442|             .or_else(|| lowered_search_command(preferred, task))?;\\n00443|         return Some(json!({ \\\"command\\\": command }).to_string());\\n00444|     }\\n00445|     match capability {\\n00446|         Capability::Fetch => {\\n00447|             let url = crate::capability_routing::first_url(task)?;\\n00448|             Some(super::planner::fetch_arguments(&url))\\n00449|         }\\n00450|         Capability::Search => {\\n00451|             let query = super::stated_request::request_blocks(task)\\n00452|                 .into_iter()\\n00453|                 .find_map(super::web_research::open_web_query_for_block)\\n00454|                 .unwrap_or_else(|| {\\n00455|                     crate::solver_handlers::web_search_intent::cl