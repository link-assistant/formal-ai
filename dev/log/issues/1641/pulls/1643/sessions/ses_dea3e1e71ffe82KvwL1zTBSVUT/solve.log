e::protocol::ChatMessage;\\n00009| use crate::seed;\\n00010| \\n00011| #[path = \\\"capability_router/tool_classification.rs\\\"]\\n00012| mod tool_classification;\\n00013| \\n00014| pub(super) use tool_classification::{\\n00015|     classify_tool, is_workspace_creation_tool, shell_command_tool, tool_for,\\n00016|     workspace_creation_tool,\\n00017| };\\n00018| \\n00019| /// Protocol-native research tools a provider executes on its own servers.\\n00020| const HOSTED_RESEARCH_TOOLS: [&str; 5] = [\\n00021|     \\\"web_search\\\",\\n00022|     \\\"web_fetch\\\",\\n00023|     \\\"web_search_preview\\\",\\n00024|     \\\"file_search\\\",\\n00025|     \\\"computer_use_preview\\\",\\n00026| ];\\n00027| \\n00028| /// Whether `name` is a protocol-native research tool the provider itself runs.\\n00029| pub(super) fn is_hosted_research_tool(name: &str) -> bool {\\n00030|     HOSTED_RESEARCH_TOOLS\\n00031|         .iter()\\n00032|         .any(|hosted| hosted.eq_ignore_ascii_case(name))\\n00033| }\\n00034| \\n00035| /// Where in the planner a routed request is answered.\\n00036| ///\\n00037| /// The decision table speaks about every request, but not at the same moment\\n00038| /// about all of them. A request whose effect lands in the *workspace*, or whose\\n00039| /// object is a URL, a path, a container or a literal, names something the\\n00040| /// research routers cannot know better -- and letting them claim it on the\\n00041| /// strength of the sentence's shape is precisely the #745 and #758 defect. Such\\n00042| /// a request is answered before them. Everything else -- a bare term the open\\n00043| /// web has to answer -- is the research routers' own subject, and the table\\n00044| /// answers it only once they have declined, so a multi-turn research recipe is\\n00045| /// never cut short by a single search.\\n00046| #[derive(Debug, Clone, Copy, PartialEq, Eq)]\\n00047| pub(super) enum RoutingStage {\\n00048|     /// Before the research routers: the workspace and the named objects.\\n00049|     NamedOrLocal,\\n00050|     /// After them: a bare term whose answer is on the open web.\\n00051|     OpenWeb,\\n00052| }\\n00053| \\n00054| /// Whether the request names a filesystem container and asks nothing of it.\\n00055| ///\\n00056| /// `acts` appends `retrieve` to every request, because a request that evidences\\n00057| /// no narrower act is a retrieval -- which is the right default for an object\\n00058| /// the request *named*, and the wrong one for a container it merely mentioned.\\n00059| /// \\\"Execute everything in the workspace\\\" names a workspace and asks for no act\\n00060| /// the seed knows, and answering it with a bare `ls` is passing prose through\\n00061| /// as a command (issue #907). A retrieval the request *asked for* in the\\n00062| /// seed's own words -- \\\"busca X en mi escritorio\\\", \\\"… में खोजिए\\\" -- is not\\n00063| /// that case, however little else the sentence names: the #840 ladder's hi/es\\n00064| /// folder nodes must reach the same `list_dir` lowering the English node does\\n00065| /// (plan 10 leaf 21).\\n00066| fn names_a_container_without_an_act(task: &str) -> bool {\\n00067|     use crate::capability_routing::{Act, ObjectType, acts, evidences_retrieve_act, object_type};\\n00068|     object_type(task).first().copied() == Some(ObjectType::PathScope)\\n00069|         && acts(task) == [Act::Retrieve]\\n00070|         && !evidences_retrieve_act(task)\\n00071| }\\n00072| \\n00073| /// Which stage a request belongs to, read from the derivations rather than from\\n00074| /// the capability the table happens to name.\\n00075| fn stage_of(task: &str) -> RoutingStage {\\n00076|     use crate::capability_routing::{Locus, ObjectType, locus, object_type};\\n00077|     let highest = object_type(task).first().copied().unwrap_or_default();\\n00078|     let named = matches!(\\n00079|         highest,\\n00080|         ObjectType::Url\\n00081|             | ObjectType::Path\\n00082|             | ObjectType::PathScope\\n00083|             | ObjectType::QuotedContent\\n00084|             | ObjectType::Pattern\\n00085|             | ObjectType::PathSet\\n00086|             | ObjectType::TaskList\\n00087|             | ObjectType::Delegation\\n00088|     );\\n00089|     if named || locus(task) == Locus::Workspace {\\n00090|         RoutingStage::NamedOrLocal\\n00091|     } else {\\n00092|         RoutingStage::OpenWeb\\n00093|     }\\n00094| }\\n00095| \\n00096| /// The capability slugs `data/seed/capability-routing.lino` names, paired with\\n00097| /// the client capability that answers each. A slug with no pairing here is one\\n00098| /// the decision table routes to but no advertised tool provides -- the calendar,\\n00099| /// the response-language demonstration, the measurement lookup -- and the table\\n00100| /// reports an honest gap for it rather than a tool call.\\n00101| ///\\n00102| /// Plan 10 leaf 11: the seven request-side cue families joined this table, so\\n00103| /// every capability the seed registry declares is decided by a\\n00104| /// `(object, act, locus)` row and none by a memorized phrase.\\n00105| /// Capabilities that only observe the workspace: a request naming a mutating\\n00106| /// shell intent is never answered by one of them.\\n00107| const OBSERVING_SLUGS: [&str; 4] = [\\\"read_many\\\", \\\"list_dir\\\", \\\"glob\\\", \\\"grep\\\"];\\n00108| \\n00109| const ROUTED_CAPABILITIES: [(&str, Capability); 12] = [\\n00110|     (\\\"web_fetch\\\", Capability::Fetch),\\n00111|     (\\\"web_search\\\", Capability::Search),\\n00112|     (\\\"read_file\\\", Capability::Read),\\n00113|     (\\\"write_file\\\", Capability::Write),\\n00114|     (\\\"list_dir\\\", Capability::ListDir),\\n00115|     (\\\"grep\\\", Capability::Grep),\\n00116|     (\\\"shell\\\", Capability::Run),\\n00117|     (\\\"glob\\\", Capability::Glob),\\n00118|     (\\\"read_many\\\", Capability::ReadMany),\\n00119|     (\\\"multi_edit\\\", Capability::MultiEdit),\\n00120|     (\\\"todo\\\", Capability::Todo),\\n00121|     (\\\"subagent\\\", Capability::Subagent),\\n00122| ];\\n00123| \\n00124| /// Route one request through the decision table of\\n00125| /// `data/seed/capability-routing.lino` (issue #1138 B10, plan 10 leaves 9-11).\\n00126| ///\\n00127| /// Since leaf 11 this is the only request-side capability decision there is:\\n00128| /// the 280 memorized cue phrases and the `task_matches` phrase scan are gone,\\n00129| /// and every capability the seed registry declares is chosen by an\\n00130| /// `(object, act, locus)` row. A triple with no row returns [`None`] and the\\n00131| /// older routes see the request, which is how a class with no row yet stays\\n00132| /// visible instead of silently guessed.\\n00133| ///\\n00134| /// Only the capabilities a tool can actually satisfy are advertised to\\n00135| /// [`crate::capability_routing::route`], so a row naming a capability this\\n00136| /// client has no tool for produces an honest gap there rather than a tool call\\n00137| /// here.\\n00138| pub(super) fn plan_routed_capability_step(\\n00139|     task: &str,\\n00140|     messages: &[ChatMessage],\\n00141|     tool_names: &[&str],\\n00142|     stage: RoutingStage,\\n00143| ) -> Option<AgenticPlan> {\\n00144|     plan_routed_capability_step_in(task, messages, tool_names, stage, &[])\\n00145| }\\n00146| \\n00147| /// The capability slugs the retired cue arm used to decide, by slug.\\n00148| ///\\n00149| /// Plan 10 leaf 11: the phrases are gone, but these seven rows have to be\\n00150| /// decided at the arm's old position -- ahead of the shell cascade and the\\n00151| /// file-read fallback -- because each of their rows names a specialized tool\\n00152| /// with a `fallback shell`, and a request the table sends to an advertised\\n00153| /// `grep_search`, `list_directory`, `glob`, `read_many_files`, `multi_edit`,\\n00154| /// `todo_write` or `task` must not be answered by the shell lowering the same\\n00155| /// row declares (issue #758's specialized-first policy, now carried by the\\n00156| /// rows' `fallback` fields and this position instead of a phrase scan).\\n00157| const NAMED_CAPABILITY_SLUGS: [&str; 7] = [\\n00158|     \\\"grep\\\",\\n00159|     \\\"glob\\\",\\n00160|     \\\"list_dir\\\",\\n00161|     \\\"read_many\\\",\\n00162|     \\\"multi_edit\\\",\\n00163|     \\\"todo\\\",\\n00164|     \\\"subagent\\\",\\n00165| ];\\n00166| \\n00167| /// The seven named capabilities, decided by the table at the position the cue\\n00168| /// arm held: after the routes that read the conversation, before the shell\\n00169| /// cascade that would otherwise lower the same request to `bash`.\\n00170| pub(super) fn plan_named_capability_step(\\n00171|     task: &str,\\n00172|     messages: &[ChatMessage],\\n00173|     tool_names: &[&str],\\n00174| ) -> Option<AgenticPlan> {\\n00175|     plan_routed_capability_step_in(\\n00176|         task,\\n00177|         messages,\\n00178|         tool_names,\\n00179|         RoutingStage::NamedOrLocal,\\n00180|         &NAMED_CAPABILITY_SLUGS,\\n00181|     )\\n00182| }\\n00183| \\n00184| fn plan_routed_capability_step_in(\\n00185|     task: &str,\\n00186|     messages: &[ChatMessage],\\n00187|     tool_names: &[&str],\\n00188|     stage: RoutingStage,\\n00189|     only: &[&str],\\n00190| ) -> Option<AgenticPlan> {\\n00191|     // The capability belongs to the stated request, not to a later harness\\n00192|     // block that only places the worker. Every agentic research route uses the\\n00193|     // same block boundary; applying the table to the whole envelope let \\\"work\\n00194|     // only in this checkout\\\" turn a live exchange-rate query into a local\\n00195|     // directory request (issue #1066).\\n00196|     let routed_task = super::stated_request::request_blocks(task)\\n00197|         .into_iter()\\n00198|         .next()\\n00199|         .unwrap_or(task);\\n00200|     let first_block = routed_task;\\n00201|     // A sentence that merely governs commands is the caller's framing, not\\n00202|     // the work: the task sentence after it states the request, and a policy\\n00203|     // sentence's own nouns (\\\"files\\\", \\\"workspace\\\") must not name a capability\\n00204|     // for the turn (issue #907's policy class -- the same sentence filter the\\n00205|     // shell route's reader applies). A prompt that is all policy keeps its\\n00206|     // whole shape, so the boundary below still declines it as governed.\\n00207|     let policy_free_request = super::shell_command_policy::sentence_spans(routed_task)\\n00208|         .into_iter()\\n00209|         .filter(|sentence| !super::shell_command_policy::states_a_command_policy(sentence))\\n00210|         .collect::<Vec<_>>()\\n00211|         .join(\\\" \\\");\\n00212|     let routed_task: &str = if policy_free_request.is_empty() {\\n00213|         routed_task\\n00214|     } else {\\n00215|         &policy_free_request\\n00216|     };\\n00217|     if !crate::capability_routing::table_routing_enabled() || stage_of(routed_task) != stage {\\n00218|         return None;\\n00219|     }\\n00220|     // A prompt that dictates a shell command verbatim (`execute cp a.txt b.txt`)\\n00221|     // is not a request whose operands the table may re-read: it belongs to the\\n00222|     // shell cascade's passthrough, so the planner must not lower it through a\\n00223|     // capability row first (issue #749).\\n00224|     if super::shell_command::explicit_passthrough_command(routed_task).is_some() {\\n00225|         return None;\\n00226|     }\\n00227|     // At the open-web position every route that reads the conversation and the\\n00228|     // workspace has declined, and a request that never named the open web is\\n00229|     // one the symbolic engine should still answer. \\\"What is Links Notation?\\\"\\n00230|     // is not a search just because nothing above claimed it (issue #989): the\\n00231|     // seed's concept lookup resolves it, so the engine speaks; a computation\\n00232|     // (\\\"What is 480 divided by 15?\\\") is held the same way. A definition the\\n00233|     // seed's own lookup leaves unresolved is the honest unknown that only a\\n00234|     // trusted external source answers, whatever language asks it -- \\\"Что\\n00235|     // такое фуфломицин?\\\" searched in the ladder's committed baseline -- and a\\n00236|     // current-fact request the table itself routed to `(bare_term, retrieve,\\n00237|     // web)` (\\\"Verify the current exchange rate between the euro and the yen\\\",\\n00238|     // the news class) is that same admission in the table's own words (plan\\n00239|     // 10 leaf 21, issue #840). A measurement the table honestly gaps is still\\n00240|     // refused below by its own outcome, never downgraded to a search.\\n00241|     let engine_answerable_concept = crate::concepts::extract_concept_query(routed_task).is_some()\\n00242|         && !super::web_research::concept_lookup_leaves_unknown(routed_task);\\n00243|     // The concept half above answers definitions; the fact store answers\\n00244|     // questions its records name -- \\\"What is the capital of France?\\\" is the\\n00245|     // solver's own `fact_lookup` row, not a search (issue #1138: the gate\\n00246|     // read only the concept lookup, so a fact the engine owned leaked to the\\n00247|     // open web as soon as no concept matched).\\n00248|     let engine_answerable_fact = crate::solver_handlers::fact_store_resolves(routed_task);\\n00249|     // The catalog half: a request the code catalog itself can template is a\\n00250|     // write the coding routes own. Deferring code creation to the typed recipe\\n00251|     // path leaves such a request to the solver, and when the table answered it\\n00252|     // instead, \\\"Write a hello world program in Python.\\\" over a full toolset\\n00253|     // became a web search for the whole sentence (issue #907) -- the boundary\\n00254|     // is the catalog, because the recipe path also composes programs no\\n00255|     // contract pins.\\n00256|     let engine_answerable_program = super::code_artifact::catalog_claims(routed_task);\\n00257|     // The dialogue half: \\\"hi\\\" or \\\"thanks\\\" on its own is an exchange the engine\\n00258|     // answers in the reply, not a bare term for the open web.\\n00259|     let engine_answerable_dialogue = crate::capability_routing::is_dialogue_utterance(routed_task);\\n00260|     if stage == RoutingStage::OpenWeb\\n00261|         && !crate::capability_routing::names_open_web(routed_task)\\n00262|         && (engine_answerable_concept\\n00263|             || engine_answerable_fact\\n00264|             || engine_answerable_program\\n00265|             || engine_answerable_dialogue)\\n00266|     {\\n00267|         return None;\\n00268|     }\\n00269|     let advertised: Vec<&str> = ROUTED_CAPABILITIES\\n00270|         .iter()\\n00271|         .filter(|(_, capability)| tool_for(tool_names, *capability).is_some())\\n00272|         .map(|(slug, _)| *slug)\\n00273|         .collect();\\n00274|     let (slug, lowered_from) = match crate::capability_routing::route(routed_task, &advertised) {\\n00275|         RoutingOutcome::Routed { capability } => (capability, None),\\n00276|         RoutingOutcome::Lowered {\\n00277|             preferred,\\n00278|             capability,\\n00279|         } => (capability, Some(preferred)),\\n00280|         RoutingOutcome::HonestGap { .. } | RoutingOutcome::Ask { .. } => return None,\\n00281|     };\\n00282|     // A positional restriction reads the capability the row *decided on* -- the\\n00283|     // preferred one when the row lowered, the row's own otherwise. A shell\\n00284|     // outcome reached without a named preferred capability (a shell row) is\\n00285|     // never a named-capability decision and stays out of the restricted call.\\n00286|     let decided = lowered_from.as_deref().unwrap_or(&slug);\\n00287|     if !only.is_empty() && !only.contains(&decided) {\\n00288|         return None;\\n00289|     }\\n00290|     let capability = ROUTED_CAPABILITIES\\n00291|         .iter()\\n00292|         .find(|(name, _)| *name == slug)\\n00293|         .map(|(_, capability)| *capability)?;\\n00294|     if names_a_container_without_an_act(routed_task) {\\n00295|         return None;\\n00296|     }\\n00297|     // A batch read is a request to *read*. A request the shell-intent\\n00298|     // vocabulary recognizes as mutating — a requesting sentence names the\\n00299|     // cue of an intent that declares an effect, whether or not the operands\\n00300|     // resolve safely enough to build the command — is not a batch read, and\\n00301|     // this arm must not answer it, not even from the latest turn's result:\\n00302|     // a mutating request is carried out as the verified recipe its seed\\n00303|     // intent declares (issues #824 and #944), and the table may not end a\\n00304|     // recipe already under way (issue #781). The boundary is the seed's own\\n00305|     // cue and effect declarations, so every mutating intent in every\\n00306|     // language the vocabulary covers defers here without being named in\\n00307|     // Rust, while a genuine batch read (\\\"read all of these files: a.txt and\\n00308|     // b.md\\\") names no mutating cue and keeps its route (issue #1021:\\n00309|     // \\\"copy a.txt to b.txt\\\" planned `cat`, and a traversal the safety rule\\n00310|     // refused answered as a one-file cat of the operand that survived).\\n00311|     // Every observing capability defers the same way: \\\"Create a directory\\n00312|     // named src.\\\" routed to `list_dir` on the word \\\"directory\\\" and answered\\n00313|     // with a listing instead of `mkdir src` (PR #1188 dogfooding). A run\\n00314|     // defers too: \\\"Rename the file a to b\\\" is the shell arm's verified recipe,\\n00315|     // never a bare `mv` (PR #1188 G24).\\n00316|     if (capability == Capability::ReadMany\\n00317|         || capability == Capability::Run\\n00318|         || OBSERVING_SLUGS.contains(&decided))\\n00319|         && super::shell_command::names_mutating_shell_intent(routed_task)\\n00320|     {\\n00321|         return None;\\n00322|     }\\n00323|     // ReadMany requires structural Read operands from the full original request.\\n00324|     if decided == \\\"read_many\\\" && routed_read_many_paths(task).is_empty() {\\n00325|         return None;\\n00326|     }\\n00327|     if super::tool_result::has_latest_turn_result(messages) {\\n00328|         return super::tool_result::latest_turn_answer(messages, tool_names, task)\\n00329|             .map(AgenticPlan::Final);\\n00330|     }\\n00331|     // A sentence that *governs* commands is not one that requests one: \\\"Never\\n00332|     // run chmod on files outside the workspace\\\" names a workspace and a file and\\n00333|     // asks for neither (issues #907, #916). The shell route already draws this\\n00334|     // boundary and it is drawn here for the same capabilities, not a second way.\\n00335|     if capability == Capability::Run\\n00336|         && super::shell_command_policy::governs_commands_rather_than_requesting_one(routed_task)\\n00337|     {\\n00338|         return None;\\n00339|     }\\n00340|     // A lowering to the generic listing yields to a more specific shell intent:\\n00341|     // \\\"What is current directory?\\\" asks *where the session is*, not what the\\n00342|     // place holds, and the seed's shell-intent vocabulary answers that with\\n00343|     // `pwd` (issue #989) — a question the container row's `ls` cannot. The\\n00344|     // #907 rule above keeps containers the request merely mentioned out of\\n00345|     // the table; this one keeps the session's own place out of it too, and\\n00346|     // lets every genuine listing (\\\"show me the files in the folder\\\") through,\\n00347|     // because only an intent the vocabulary resolves *differently* defers.\\n00348|     if capability == Capability::Run\\n00349|         && low