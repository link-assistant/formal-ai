&prompt, symbolic_answer)\\n00594| }\\n00595| \\n00596| /// Build a Responses object from a deterministic [`AgenticPlan`] — the Responses\\n00597| /// mirror of [`chat_completion_from_plan`]. A [`AgenticPlan::ToolCalls`] plan emits\\n00598| /// native function/custom call output items (using the same stable `call` ids as\\n00599| /// the chat surface); a [`AgenticPlan::Final`] plan emits an assistant message.\\n00600| fn response_from_plan(\\n00601|     request: &ResponsesRequest,\\n00602|     prompt: &str,\\n00603|     plan: AgenticPlan,\\n00604|     memory_events: &[MemoryEvent],\\n00605| ) -> ResponseObject {\\n00606|     let model = resolved_request_model(request.model.as_deref());\\n00607|     let input_tokens = responses_input_tokens(request);\\n00608|     let message_count = request.to_chat_completion_request().messages.len();\\n00609|     // The Responses surface carries the same client prose in its own shape, so\\n00610|     // the declaration is read from the chat projection rather than parsed twice.\\n00611|     let workspace = client_working_directory(&request.to_chat_completion_request().messages);\\n00612| \\n00613|     let plan = crate::protocol_call_validation::bind_plan(\\n00614|         plan,\\n00615|         &request.tools,\\n00616|         &request.to_chat_completion_request().messages,\\n00617|         prompt,\\n00618|         workspace.as_deref(),\\n00619|     );\\n00620|     let mut evidence_links = Vec::new();\\n00621|     let (output, output_tokens) = match plan {\\n00622|         AgenticPlan::ToolCalls(calls) => {\\n00623|             let narration = tool_action_narration(prompt, &calls);\\n00624|             let mut items = Vec::with_capacity(calls.len().saturating_add(1));\\n00625|             let mut output_tokens = estimate_tokens(&narration);\\n00626|             items.push(ResponseOutputItem::Message(ResponseOutputMessage {\\n00627|                 id: stable_id(\\\"msg\\\", &narration),\\n00628|                 kind: String::from(\\\"message\\\"),\\n00629|                 role: String::from(\\\"assistant\\\"),\\n00630|                 content: vec![ResponseOutputContent {\\n00631|                     kind: String::from(\\\"output_text\\\"),\\n00632|                     text: narration,\\n00633|                     refusal: None,\\n00634|                 }],\\n00635|                 thinking_steps: Vec::new(),\\n00636|             }));\\n00637|             for (index, call) in calls.into_iter().enumerate() {\\n00638|                 let tool = call.tool;\\n00639|                 let planned_arguments = call.arguments;\\n00640|                 let seed = format!(\\\"{prompt}|{message_count}|{index}|{tool}|{planned_arguments}\\\");\\n00641|                 let custom_tool = is_custom_response_tool(&request.tools, &tool);\\n00642|                 let arguments = response_arguments_for_tool(\\n00643|                     &request.tools,\\n00644|                     &tool,\\n00645|                     planned_arguments.clone(),\\n00646|                     prompt,\\n00647|                     workspace.as_deref(),\\n00648|                 );\\n00649|                 if request\\n00650|                     .tools\\n00651|                     .iter()\\n00652|                     .any(|definition| is_hosted_tool_definition(definition, &tool))\\n00653|                     && tool == \\\"web_search\\\"\\n00654|                 {\\n00655|                     output_tokens = output_tokens.saturating_add(\\n00656|                         estimate_tokens(&tool).saturating_add(estimate_tokens(&arguments)),\\n00657|                     );\\n00658|                     let query = serde_json::from_str::<Value>(&arguments)\\n00659|                         .ok()\\n00660|                         .and_then(|value| {\\n00661|                             value\\n00662|                                 .get(\\\"query\\\")\\n00663|                                 .and_then(Value::as_str)\\n00664|                                 .map(str::to_owned)\\n00665|                         })\\n00666|                         .unwrap_or_else(|| prompt.to_owned());\\n00667|                     items.push(ResponseOutputItem::WebSearchCall(\\n00668|                         ResponseWebSearchToolCall {\\n00669|                             id: stable_id(\\\"ws\\\", &seed),\\n00670|                             kind: String::from(\\\"web_search_call\\\"),\\n00671|                             status: String::from(\\\"completed\\\"),\\n00672|                             action: ResponseWebSearchAction {\\n00673|                                 kind: String::from(\\\"search\\\"),\\n00674|                                 queries: vec![query.clone()],\\n00675|                                 query,\\n00676|                             },\\n00677|                         },\\n00678|                     ));\\n00679|                 } else if custom_tool {\\n00680|                     let input =\\n00681|                         custom_response_tool_input(&request.tools, &tool, planned_arguments);\\n00682|                     output_tokens = output_tokens.saturating_add(\\n00683|                         estimate_tokens(&tool).saturating_add(estimate_tokens(&input)),\\n00684|                     );\\n00685|                     items.push(ResponseOutputItem::CustomToolCall(ResponseCustomToolCall {\\n00686|                         id: stable_id(\\\"ctc\\\", &seed),\\n00687|                         kind: custom_tool_call_kind(),\\n00688|                         call_id: stable_id(\\\"call\\\", &seed),\\n00689|                         name: tool,\\n00690|                         input,\\n00691|                     }));\\n00692|                 } else {\\n00693|                     output_tokens = output_tokens.saturating_add(\\n00694|                         estimate_tokens(&tool).saturating_add(estimate_tokens(&arguments)),\\n00695|                     );\\n00696|                     let (name, namespace) = response_tool_call_identity(&request.tools, &tool);\\n00697|                     items.push(ResponseOutputItem::FunctionCall(ResponseFunctionToolCall {\\n00698|                         id: stable_id(\\\"fc\\\", &seed),\\n00699|                         kind: function_call_kind(),\\n00700|                         call_id: stable_id(\\\"call\\\", &seed),\\n00701|                         name,\\n00702|                         namespace,\\n00703|                         arguments,\\n00704|                         status: String::from(\\\"completed\\\"),\\n00705|                     }));\\n00706|                 }\\n00707|             }\\n00708|             (items, output_tokens)\\n00709|         }\\n00710|         AgenticPlan::Final(answer) => {\\n00711|             // Issue #1559 §5: applied amendments are listed in the trace and\\n00712|             // as evidence links, never appended to the published answer.\\n00713|             let composed = request_context::compose_final(\\n00714|                 &request.to_chat_completion_request().messages,\\n00715|                 &answer,\\n00716|                 applied_amendment_steps(prompt, memory_events),\\n00717|             );\\n00718|             let answer = composed.answer;\\n00719|             let output_tokens = estimate_tokens(&answer);\\n00720|             let steps = composed.thinking_steps;\\n00721|             evidence_links = steps.iter().map(|step| step.source_event.clone()).collect();\\n00722|             let message = ResponseOutputItem::Message(ResponseOutputMessage {\\n00723|                 id: stable_id(\\\"msg\\\", &answer),\\n00724|                 kind: String::from(\\\"message\\\"),\\n00725|                 role: String::from(\\\"assistant\\\"),\\n00726|                 content: vec![ResponseOutputContent {\\n00727|                     kind: String::from(\\\"output_text\\\"),\\n00728|                     refusal: None,\\n00729|                     text: answer,\\n00730|                 }],\\n00731|     