38| mod responses_input;\n00039| mod structured_output;\n00040| mod structured_schema;\n00041| mod tokens;\n00042| pub(crate) use cnl::create_adapted_chat_completion;\n00043| pub use cnl::create_chat_completion_with_solver_and_memory;\n00044| use output::response_from_symbolic;\n00045| pub use output::*;\n00046| use recording::response_prompt;\n00047| pub use recording::{\n00048|     chat_exchange_to_record, chat_tool_executions, messages_exchange_to_record,\n00049|     responses_exchange_to_record,\n00050| };\n00051| pub(crate) use recording::{chat_message_to_turn, chat_prompt_and_history};\n00052| use tokens::{message_input_tokens, response_timestamp, responses_input_tokens};\n00053| \n00054| fn resolved_request_model(model: Option<&str>) -> String {\n00055|     crate::seed::resolve_model_id(model)\n00056| }\n00057| \n00058| /// OpenAI-compatible `stream_options` field.\n00059| #[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Serialize, Deserialize)]\n00060| pub struct StreamOptions {\n00061|     #[serde(default)]\n00062|     pub include_usage: bool,\n00063| }\n00064| \n00065| impl ChatCompletionRequest {\n00066|     #[must_use]\n00067|     pub fn requests_tool_execution(&self) -> bool {\n00068|         if self\n00069|             .tool_choice\n00070|             .as_ref()\n00071|             .is_some_and(is_tool_choice_request)\n00072|             || self\n00073|                 .function_call\n00074|                 .as_ref()\n00075|                 .is_some_and(is_tool_choice_request)\n00076|         {\n00077|             return true;\n00078|         }\n00079| \n00080|         let tool_calls_disabled = self\n00081|             .tool_choice\n00082|             .as_ref()\n00083|             .is_some_and(matches_tool_choice_none);\n00084|         let function_calls_disabled = self\n00085|             .function_call\n00086|             .as_ref()\n00087|             .is_some_and(matches_tool_choice_none);\n00088| \n00089|         (!self.tools.is_empty() && !tool