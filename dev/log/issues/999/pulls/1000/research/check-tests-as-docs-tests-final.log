[2026-08-11T19:12:48Z INFO  rust_script] input: File("check-tests-as-docs", "/tmp/gh-issue-solver-1786471194109/scripts/check-tests-as-docs.rs", "#!/usr/bin/env rust-script\n//! Burn-down lint: behavioural tests must read like documentation.\n//!\n//! Issue #960 (R234-2, <https://github.com/link-assistant/formal-ai/pull/234#issuecomment-4528554549>):\n//! \"I don't see in tests exact examples of answers, only contains and not\n//! contains. I need more detailed examples so tests are like docs, give exact\n//! variations. So the answer should be one of multiple possibilities, and it\n//! should be as explicit as possible, so it will be easy to understand how the\n//! system works only by looking at each concrete test. ... I want the same style\n//! to be demanded for all other tests, we need a test or CI/CD rule that will\n//! guarantee it.\"\n//!\n//! A test that only asserts `response.answer.contains(\"formal AI\")` documents a\n//! substring, not an answer: a reader cannot tell what the system actually\n//! says. This lint finds every test that asserts on an engine answer and\n//! requires at least one **exact-answer** assertion alongside the loose ones:\n//!\n//!   * `assert_eq!(response.answer, \"…\")` — the single exact answer, or\n//!   * membership in an explicit list of exact answers, e.g.\n//!     `assert!(EXPECTED_ANSWERS.contains(&response.answer.as_str()), …)` —\n//!     \"one of multiple possibilities\", spelled out.\n//!\n//! Loose `contains` / `!contains` assertions stay; the requirement is \"in\n//! addition to\", not \"instead of\".\n//!\n//! Today's debt is inventoried in an explicit allowlist\n//! (`scripts/tests-as-docs-allowlist.txt`), like the R379 hardcoded-language\n//! burn-down. The check fails when:\n//!   * a behavioural test without an exact-answer assertion is **not** in the\n//!     allowlist (new loose-only tests are blocked immediately), or\n//!   * an allowlist row no longer matches a loose-only test (stale rows must be\n//!     pruned as tests are made explicit, so the debt only shrinks).\n//!\n//! Usage:\n//!   rust-script scripts/check-tests-as-docs.rs           # check (CI/local)\n//!   rust-script scripts/check-tests-as-docs.rs --write   # regenerate allowlist\n//!\n//! Run the inline unit tests with:\n//!   rust-script --test scripts/check-tests-as-docs.rs\n//!\n//! ```cargo\n//! [dependencies]\n//! walkdir = \"2\"\n//! ```\n\nuse std::collections::BTreeSet;\nuse std::fs;\nuse std::path::Path;\n#[cfg(not(test))]\nuse std::process::exit;\nuse walkdir::WalkDir;\n\n/// Relative path of the committed allowlist, from the repository root.\n#[cfg_attr(test, allow(dead_code))]\nconst ALLOWLIST_PATH: &str = \"scripts/tests-as-docs-allowlist.txt\";\n\n/// Directory scanned for behavioural tests.\n#[cfg_attr(test, allow(dead_code))]\nconst SCAN_DIR: &str = \"tests\";\n\n/// `tests/source/` is a checked-in copy of `src/` used by the source-placement\n/// guard, not a test suite of its own.\n#[cfg_attr(test, allow(dead_code))]\nconst SKIP_PATH_FRAGMENTS: &[&str] = &[\"tests/source/\", \"tests/fixtures/\", \"tests/e2e/node_modules\"];\n\nconst ALLOWLIST_HEADER: &str = \"\\\n# Tests-as-docs allowlist (R234-2 burn-down).\n#\n# Generated by scripts/check-tests-as-docs.rs. Each row is a behavioural test\n# that asserts on an engine answer using only loose assertions (contains /\n# !contains) without ever showing the exact answer text a reader could learn\n# the system's behaviour from.\n#\n# Format (tab-separated): <relative-path>\\\\t<test-fn-name>\n#   * Rows are sorted for a stable, review-friendly diff.\n#\n# DO NOT add rows by hand to silence the check. Instead make the test explicit:\n#   assert_eq!(response.answer, \\\"…\\\");                       // one exact answer\n#   assert!(EXPECTED.contains(&response.answer.as_str()), …); // one of several\n# and delete its row. Regenerate after a legitimate migration with:\n#   rust-script scripts/check-tests-as-docs.rs --write\n\";\n\n/// A behavioural test that never shows an exact answer.\n#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]\nstruct Entry {\n    file: String,\n    test: String,\n}\n\nimpl Entry {\n    fn to_row(&self) -> String {\n        format!(\"{}\\t{}\", self.file, self.test)\n    }\n\n    fn from_row(row: &str) -> Option<Self> {\n        let (file, test) = row.split_once('\\t')?;\n        if file.is_empty() || test.is_empty() {\n            return None;\n        }\n        Some(Self {\n            file: file.to_string(),\n            test: test.to_string(),\n        })\n    }\n}\n\n/// One `#[test] fn` with its body text.\n#[derive(Debug, Clone, PartialEq, Eq)]\nstruct TestFunction {\n    name: String,\n    body: String,\n}\n\n#[cfg_attr(test, allow(dead_code))]\nfn normalized_path(path: &Path) -> String {\n    path.to_string_lossy()\n        .replace(std::path::MAIN_SEPARATOR, \"/\")\n}\n\n/// Extract every `#[test]`-annotated function together with its body.\n///\n/// Brace counting is deliberately simple: it is a lint over ordinary test code,\n/// not a Rust parser. Braces inside string literals are ignored so a test that\n/// asserts on JSON text does not truncate the body.\nfn test_functions(source: &str) -> Vec<TestFunction> {\n    let bytes: Vec<char> = source.chars().collect();\n    let mut functions = Vec::new();\n    let mut index = 0;\n\n    while let Some(found) = source[index..].find(\"#[test]\") {\n        let attribute_at = index + found;\n        let Some(fn_at) = source[attribute_at..].find(\"fn \") else {\n            break;\n        };\n        let fn_at = attribute_at + fn_at + \"fn \".len();\n        let name: String = source[fn_at..]\n            .chars()\n            .take_while(|character| character.is_alphanumeric() || *character == '_')\n            .collect();\n        let Some(open_at) = source[fn_at..].find('{') else {\n            break;\n        };\n        let open_at = fn_at + open_at;\n        let start = source[..open_at].chars().count();\n        let mut depth = 0_usize;\n        let mut position = start;\n        let mut in_string = false;\n        let mut escaped = false;\n        let mut end = bytes.len();\n\n        while position < bytes.len() {\n            let character = bytes[position];\n            if in_string {\n                if escaped {\n                    escaped = false;\n                } else if character == '\\\\' {\n                    escaped = true;\n                } else if character == '\"' {\n                    in_string = false;\n                }\n            } else if character == '\"' {\n                in_string = true;\n            } else if character == '{' {\n                depth += 1;\n            } else if character == '}' {\n                depth -= 1;\n                if depth == 0 {\n                    end = position;\n                    break;\n                }\n            }\n            position += 1;\n        }\n\n        let body: String = bytes[start..end.min(bytes.len())].iter().collect();\n        index = attribute_at + \"#[test]\".len();\n        if !name.is_empty() {\n            index = index.max(fn_at + name.len());\n            functions.push(TestFunction { name, body });\n        }\n    }\n\n    functions\n}\n\n/// Strip `//` line comments so a commented-out `assert_eq!` never counts as\n/// evidence and prose in a doc comment never triggers the lint.\nfn strip_line_comments(body: &str) -> String {\n    body.lines()\n        .map(|line| match line.find(\"//\") {\n            Some(at) if line[..at].matches('\"').count() % 2 == 0 => &line[..at],\n            _ => line,\n        })\n        .collect::<Vec<_>>()\n        .join(\"\\n\")\n}\n\n/// Does this test assert on an engine answer at all?\nfn asserts_on_answer(body: &str) -> bool {\n    body.contains(\".answer\")\n}\n\n/// Does this test show the exact answer text a reader can learn from?\n///\n/// Two accepted forms, both from R234-2: a single exact answer\n/// (`assert_eq!(response.answer, \"…\")`) or an explicit list of exact\n/// possibilities the answer must be one of.\nfn has_exact_answer_assertion(body: &str) -> bool {\n    body.split(\"assert_eq!\").skip(1).any(|argument| {\n        let head = argument.split(\");\").next().unwrap_or(argument);\n        head.contains(\".answer\")\n    }) || body.split(\".contains(\").skip(1).any(|argument| {\n        let head = argument.split(')').next().unwrap_or(argument);\n        // `EXPECTED.contains(&response.answer …)` — membership of the whole\n        // answer in an explicit list, not `answer.contains(\"substring\")`.\n        head.contains(\".answer\")\n    })\n}\n\nfn scan_file(relative_path: &str, source: &str) -> Vec<Entry> {\n    test_functions(source)\n        .into_iter()\n        .filter_map(|function| {\n            let body = strip_line_comments(&function.body);\n            (asserts_on_answer(&body) && !has_exact_answer_assertion(&body)).then(|| Entry {\n                file: relative_path.to_string(),\n                test: function.name,\n            })\n        })\n        .collect()\n}\n\n#[cfg_attr(test, allow(dead_code))]\nfn scan_directory(root: &Path) -> BTreeSet<Entry> {\n    let mut entries = BTreeSet::new();\n\n    for entry in WalkDir::new(root.join(SCAN_DIR))\n        .into_iter()\n        .filter_map(std::result::Result::ok)\n        .filter(|entry| entry.file_type().is_file())\n    {\n        let path = entry.path();\n        if path.extension().and_then(|extension| extension.to_str()) != Some(\"rs\") {\n            continue;\n        }\n        let relative = normalized_path(path.strip_prefix(root).unwrap_or(path));\n        if SKIP_PATH_FRAGMENTS\n            .iter()\n            .any(|fragment| relative.contains(fragment))\n        {\n            continue;\n        }\n        let Ok(source) = fs::read_to_string(path) else {\n            continue;\n        };\n        entries.extend(scan_file(&relative, &source));\n    }\n\n    entries\n}\n\nfn parse_allowlist(content: &str) -> BTreeSet<Entry> {\n    content\n        .lines()\n        .map(str::trim_end)\n        .filter(|line| !line.is_empty() && !line.starts_with('#'))\n        .filter_map(Entry::from_row)\n        .collect()\n}\n\nfn render_allowlist(entries: &BTreeSet<Entry>) -> String {\n    let mut rendered = String::from(ALLOWLIST_HEADER);\n    for entry in entries {\n        rendered.push_str(&entry.to_row());\n        rendered.push('\\n');\n    }\n    rendered\n}\n\n#[derive(Debug, Default, PartialEq, Eq)]\nstruct Diff {\n    /// Loose-only tests missing from the allowlist: new debt.\n    added: Vec<Entry>,\n    /// Allowlist rows with no matching loose-only test: stale debt.\n    stale: Vec<Entry>,\n}\n\nimpl Diff {\n    const fn is_clean(&self) -> bool {\n        self.added.is_empty() && self.stale.is_empty()\n    }\n}\n\nfn diff(found: &BTreeSet<Entry>, allowlisted: &BTreeSet<Entry>) -> Diff {\n    Diff {\n        added: found.difference(allowlisted).cloned().collect(),\n        stale: allowlisted.difference(found).cloned().collect(),\n    }\n}\n\n#[cfg(not(test))]\nfn main() {\n    let root = std::env::current_dir().expect(\"Failed to get current directory\");\n    let write = std::env::args().any(|argument| argument == \"--write\");\n    let found = scan_directory(&root);\n\n    if write {\n        fs::write(root.join(ALLOWLIST_PATH), render_allowlist(&found))\n            .expect(\"allowlist should be writable\");\n        println!(\"Wrote {} rows to {ALLOWLIST_PATH}\", found.len());\n        exit(0);\n    }\n\n    println!(\"\\nChecking behavioural tests show exact example answers (R234-2)...\\n\");\n\n    let allowlisted = fs::read_to_string(root.join(ALLOWLIST_PATH))\n        .map(|content| parse_allowlist(&content))\n        .unwrap_or_default();\n    let difference = diff(&found, &allowlisted);\n\n    if !difference.added.is_empty() {\n        println!(\"Behavioural tests asserting on an answer without showing it:\\n\");\n        for entry in &difference.added {\n            println!(\"  {}::{}\", entry.file, entry.test);\n        }\n        println!(\n            \"\\nTests are documentation: show the exact answer, or the explicit list of answers it\\n\\\n             must be one of, in addition to any contains/!contains assertions.\\n\\\n               assert_eq!(response.answer, \\\"…\\\");\\n\\\n               assert!(EXPECTED.contains(&response.answer.as_str()), \\\"…\\\");\\n\"\n        );\n    }\n\n    if !difference.stale.is_empty() {\n        println!(\"Stale allowlist rows (these tests are explicit now — prune them):\\n\");\n        for entry in &difference.stale {\n            println!(\"  {}::{}\", entry.file, entry.test);\n        }\n        println!(\"\\nRegenerate with: rust-script scripts/check-tests-as-docs.rs --write\\n\");\n    }\n\n    if difference.is_clean() {\n        println!(\n            \"All {} behavioural tests outside the burn-down allowlist show exact answers\\n\",\n            found.len()\n        );\n        exit(0);\n    }\n    exit(1);\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    const LOOSE_TEST: &str = r#\"\n#[test]\nfn reported_russian_name_question_is_answered() {\n    let response = FormalAiEngine.answer(\"Как твое имя?\");\n    assert!(response.answer.contains(\"formal AI\"));\n    assert!(!response.answer.contains(\"Claude\"));\n}\n\"#;\n\n    const EXACT_TEST: &str = r#\"\n#[test]\nfn assistant_name_answer_is_shown_verbatim() {\n    let response = FormalAiEngine.answer(\"What is your name?\");\n    assert_eq!(response.answer, \"I am formal AI.\");\n    assert!(response.answer.contains(\"formal AI\"));\n}\n\"#;\n\n    const ONE_OF_TEST: &str = r#\"\n#[test]\nfn assistant_name_answer_is_one_of_the_documented_variations() {\n    const EXPECTED: &[&str] = &[\"I am formal AI.\", \"My name is formal AI.\"];\n    let response = FormalAiEngine.answer(\"What is your name?\");\n    assert!(\n        EXPECTED.contains(&response.answer.as_str()),\n        \"got: {}\",\n        response.answer,\n    );\n}\n\"#;\n\n    /// The exact failure R234-2 names: a test whose only evidence is a\n    /// substring tells a reader nothing about what the system replies.\n    #[test]\n    fn loose_only_test_is_flagged() {\n        assert_eq!(\n            scan_file(\"tests/unit/assistant_name.rs\", LOOSE_TEST),\n            vec![Entry {\n                file: \"tests/unit/assistant_name.rs\".to_string(),\n                test: \"reported_russian_name_question_is_answered\".to_string(),\n            }]\n        );\n    }\n\n    #[test]\n    fn exact_answer_assertion_passes() {\n        assert_eq!(scan_file(\"tests/unit/assistant_name.rs\", EXACT_TEST), vec![]);\n    }\n\n    /// \"The answer should be one of multiple possibilities\" — an explicit list\n    /// of exact answers is as documentary as a single one.\n    #[test]\n    fn membership_in_an_explicit_answer_list_passes() {\n        assert_eq!(\n            scan_file(\"tests/unit/assistant_name.rs\", ONE_OF_TEST),\n            vec![]\n        );\n    }\n\n    /// Tests that never touch an answer (data shape, parsing, CI wiring) are\n    /// out of scope; this lint is about documented behaviour.\n    #[test]\n    fn tests_that_do_not_assert_on_answers_are_ignored() {\n        let source = r#\"\n#[test]\nfn roles_registry_is_sorted() {\n    assert!(is_sorted(&roles()));\n}\n\"#;\n\n        assert_eq!(scan_file(\"tests/unit/roles.rs\", source), vec![]);\n    }\n\n    #[test]\n    fn commented_out_exact_assertion_does_not_count() {\n        let source = r#\"\n#[test]\nfn name_is_answered() {\n    let response = engine.answer(\"hi\");\n    // assert_eq!(response.answer, \"I am formal AI.\");\n    assert!(response.answer.contains(\"formal\"));\n}\n\"#;\n\n        assert_eq!(\n            scan_file(\"tests/unit/x.rs\", source),\n            vec![Entry {\n                file: \"tests/unit/x.rs\".to_string(),\n                test: \"name_is_answered\".to_string(),\n            }]\n        );\n    }\n\n    #[test]\n    fn braces_inside_string_literals_do_not_truncate_a_body() {\n        let source = r#\"\n#[test]\nfn json_answer_is_exact() {\n    let response = engine.answer(\"hi\");\n    let shape = \"{\\\"answer\\\": 1}\";\n    assert_eq!(response.answer, shape);\n}\n\"#;\n\n        assert_eq!(scan_file(\"tests/unit/x.rs\", source), vec![]);\n    }\n\n    #[test]\n    fn all_test_functions_in_a_file_are_scanned() {\n        let source = format!(\"{LOOSE_TEST}{EXACT_TEST}\");\n\n        let names: Vec<String> = test_functions(&source)\n            .into_iter()\n            .map(|function| function.name)\n            .collect();\n\n        assert_eq!(\n            names,\n            vec![\n                \"reported_russian_name_question_is_answered\".to_string(),\n                \"assistant_name_answer_is_shown_verbatim\".to_string(),\n            ]\n        );\n    }\n\n    #[test]\n    fn new_debt_and_stale_rows_are_reported_separately() {\n        let found: BTreeSet<Entry> = [Entry {\n            file: \"tests/unit/a.rs\".to_string(),\n            test: \"loose\".to_string(),\n        }]\n        .into_iter()\n        .collect();\n        let allowlisted: BTreeSet<Entry> = [Entry {\n            file: \"tests/unit/b.rs\".to_string(),\n            test: \"fixed\".to_string(),\n        }]\n        .into_iter()\n        .collect();\n\n        let difference = diff(&found, &allowlisted);\n\n        assert_eq!(\n            difference.added,\n            vec![Entry {\n                file: \"tests/unit/a.rs\".to_string(),\n                test: \"loose\".to_string(),\n            }]\n        );\n        assert_eq!(\n            difference.stale,\n            vec![Entry {\n                file: \"tests/unit/b.rs\".to_string(),\n                test: \"fixed\".to_string(),\n            }]\n        );\n        assert!(!difference.is_clean());\n    }\n\n    #[test]\n    fn allowlist_round_trips() {\n        let entries: BTreeSet<Entry> = [Entry {\n            file: \"tests/unit/a.rs\".to_string(),\n            test: \"loose\".to_string(),\n        }]\n        .into_iter()\n        .collect();\n\n        assert_eq!(parse_allowlist(&render_allowlist(&entries)), entries);\n    }\n}\n", "/tmp/gh-issue-solver-1786471194109/scripts")
