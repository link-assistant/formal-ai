{
  "name": "formal-ai-desktop",
  "version": "0.297.2",
  "private": true,
  "description": "Cross-platform desktop wrapper for formal-ai",
  "homepage": "https://link-assistant.github.io/formal-ai/",
  "author": {
    "name": "link-assistant",
    "email": "link-assistant@users.noreply.github.com"
  },
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "prebuild": "node scripts/prepare-resources.mjs",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/tool-router.test.mjs scripts/web-tools.test.mjs scripts/memory-sync.test.mjs scripts/service-control.test.mjs scripts/local-server.test.mjs scripts/agent-provider.test.mjs scripts/command-runner.test.mjs scripts/engine-manager.test.mjs scripts/docker-detect.test.mjs scripts/data-migration.test.mjs scripts/auto-update.test.mjs scripts/vscode-install.test.mjs scripts/dreaming.test.mjs scripts/issue-756.test.mjs scripts/adhoc-sign-mac.test.cjs scripts/prepare-resources.test.mjs scripts/prefetch-builder-toolsets.test.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@link-assistant/web-capture": "^1.11.2",
    "@link-assistant/web-search": "^0.11.1",
    "agent-commander": "^0.10.1",
    "command-stream": "1.5.0",
    "electron-updater": "^6.8.9",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.17.0"
  },
  "command-stream//": "blocked: https://github.com/advisories/GHSA-vfj7-8cjw-p6xm (1.6.0+ and 2.0.0 depend on shelljs, whose fast-glob > micromatch > braces chain has no patched release; 1.5.0 is the newest that audits clean)",
  "browser-commander//": "blocked: https://github.com/link-assistant/web-capture/issues/160 (0.21+ launches the installed Chrome over CDP by default; web-capture 1.11.2 does not pass launch: 'engine', so 0.20.0 is the newest override it runs on)",
  "@kreuzberg/html-to-markdown-node//": "blocked: https://github.com/xberg-io/html-to-markdown/issues/459 (every release after 3.5.5, through 3.7.2, declares linux musl optional packages that npm does not have)",
  "overrides": {
    "@link-assistant/web-capture": {
      "@kreuzberg/html-to-markdown-node": "3.5.5",
      "browser-commander": "0.20.0",
      "puppeteer": "^25.12.0",
      "puppeteer-core": "^25.12.0",
      "qs": "^6.16.0"
    },
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "ai.formal.desktop",
    "productName": "formal-ai Desktop",
    "electronUpdaterCompatibility": ">=2.16",
    "publish": {
      "provider": "github",
      "owner": "link-assistant",
      "repo": "formal-ai",
      "releaseType": "release"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "package.json",
      "dist-web/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "browser-runtime",
        "to": "browser-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "maintainer": "link-assistant <link-assistant@users.noreply.github.com>",
      "artifactName": "formal-ai-desktop-linux-${arch}-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "formal-ai-desktop-macos-${arch}-${version}.${ext}",
      "hardenedRuntime": true,
      "signIgnore": [
        "/Contents/Resources/browser-runtime/"
      ],
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "formal-ai-desktop-windows-installer-${arch}-${version}.${ext}"
    },
    "portable": {
      "artifactName": "formal-ai-desktop-windows-portable-${arch}-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller": true,
    "node-pty": true,
    "puppeteer": true
  }
}
